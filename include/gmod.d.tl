--- Enumerations used by Global.GetRenderTargetEx to determine the byte format of each pixel in the Render Target.
global type E_IMAGE_FORMAT = number
---
global IMAGE_FORMAT_DEFAULT: E_IMAGE_FORMAT = -1
--- Red, Green, Blue, Alpha, 8 bit per pixel.
global IMAGE_FORMAT_RGBA8888: E_IMAGE_FORMAT = 0
--- Probably legacy format. Alpha, Red, Green, Blue, 8 bit per pixel.
global IMAGE_FORMAT_ABGR8888: E_IMAGE_FORMAT = 1
--- Red, Green, Blue, 8 bit per pixel.
global IMAGE_FORMAT_RGB888: E_IMAGE_FORMAT = 2
--- Legacy format. Blue, Green, Red order, 8 bit per pixel.
global IMAGE_FORMAT_BGR888: E_IMAGE_FORMAT = 3
--- Red, Green, Blue, 5 bit per pixel for Red and Blue channels, 6 bits for Green. Effectively uses less video memory.
global IMAGE_FORMAT_RGB565: E_IMAGE_FORMAT = 4
--- `IMAGE_FORMAT_RGBA8888` with different byte order. Legacy format.
global IMAGE_FORMAT_ARGB8888: E_IMAGE_FORMAT = 11
--- `IMAGE_FORMAT_RGBA8888` with different byte order. Legacy format.
global IMAGE_FORMAT_BGRA8888: E_IMAGE_FORMAT = 12
--- RGBA, but 16 bits per pixel. Was meant to be used for "Integer mode" for HDR. Probably legacy format.
global IMAGE_FORMAT_RGBA16161616: E_IMAGE_FORMAT = 25
--- RGBA, but floating point 16 bits per pixel. Is used for "Float mode" HDR.
global IMAGE_FORMAT_RGBA16161616F: E_IMAGE_FORMAT = 24

--- Unlike Enums/BUTTON_CODE, these enums are abstracted to allow the user to bind actions to any key they might prefer.
--- Keybinds using these actions work with two console commands, one starting with a plus and one with a minus symbol. A key press or release will call either the plus or minus command, adding or removing the corresponding enum in the current CUserCmd.
--- Enumerations used by:
--- * Player:KeyDown
--- * Player:KeyDownLast
--- * Player:KeyPressed
--- * Player:KeyReleased
--- * CMoveData:AddKey
--- * CMoveData:GetButtons
--- * CMoveData:GetOldButtons
--- * CMoveData:KeyDown
--- * CMoveData:KeyPressed
--- * CMoveData:KeyReleased
--- * CMoveData:KeyWasDown
--- * CMoveData:SetButtons
--- * CMoveData:SetOldButtons
--- * CUserCmd:GetButtons
--- * CUserCmd:KeyDown
--- * CUserCmd:RemoveKey
--- * CUserCmd:SetButtons
--- * GM:KeyPress
--- * GM:KeyRelease
global type E_IN = number
--- +attack bound key ( Default: Left Mouse Button )
global IN_ATTACK: E_IN = 1
--- +jump bound key ( Default: Space )
global IN_JUMP: E_IN = 2
--- +duck bound key ( Default: CTRL )
global IN_DUCK: E_IN = 4
--- +forward bound key ( Default: W )
global IN_FORWARD: E_IN = 8
--- +back bound key ( Default: S )
global IN_BACK: E_IN = 16
--- +use bound key ( Default: E )
global IN_USE: E_IN = 32
global IN_CANCEL: E_IN = 64
--- +left bound key ( Look left )
global IN_LEFT: E_IN = 128
--- +right bound key ( Look right )
global IN_RIGHT: E_IN = 256
--- +moveleft bound key ( Default: A )
global IN_MOVELEFT: E_IN = 512
--- +moveright bound key ( Default: D )
global IN_MOVERIGHT: E_IN = 1024
--- +attack2 bound key ( Default: Right Mouse Button )
global IN_ATTACK2: E_IN = 2048
global IN_RUN: E_IN = 4096
--- +reload bound key ( Default: R )
global IN_RELOAD: E_IN = 8192
--- +alt1 bound key
global IN_ALT1: E_IN = 16384
--- +alt2 bound key
global IN_ALT2: E_IN = 32768
--- +showscores bound key ( Default: Tab )
global IN_SCORE: E_IN = 65536
--- +speed bound key ( Default: Shift )
global IN_SPEED: E_IN = 131072
--- +walk bound key ( Slow walk )
global IN_WALK: E_IN = 262144
--- +zoom bound key ( Suit Zoom )
global IN_ZOOM: E_IN = 524288
--- For use in weapons. Set in the physgun when scrolling an object away from you.
global IN_WEAPON1: E_IN = 1048576
--- For use in weapons. Set in the physgun when scrolling an object towards you.
global IN_WEAPON2: E_IN = 2097152
global IN_BULLRUSH: E_IN = 4194304
--- +grenade1 bound key
global IN_GRENADE1: E_IN = 8388608
--- +grenade2 bound key
global IN_GRENADE2: E_IN = 16777216

--- Enumerations used by input.IsButtonDown.
--- It's also part of the Enums/BUTTON_CODE.
global type E_JOYSTICK = number
global JOYSTICK_FIRST: E_JOYSTICK = 114

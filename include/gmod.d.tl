    --- An Global.AccessorFunc that returns true if palette is shown, false if not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L9)
    -- @return --- Return true if shown, false if not.
    GetPalette: function(self): boolean

    --- Returns the color as a normalized Vector.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L328-L333)
    -- @return --- A vector representing the color of the DColorMixer, each value being in range of 0 to 1. Alpha is not included.
    GetVector: function(self): GVector

    --- An Global.AccessorFunc that returns true if the wangs are shown, false if not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L11)
    -- @return --- Return true if shown, false if not.
    GetWangs: function(self): boolean

    --- An Global.AccessorFunc that show/hide the alpha bar in DColorMixer
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L166-L173)
    -- @param show --- Show / Hide the alpha bar
    SetAlphaBar: function(self, show: boolean)

    --- Sets the base color of the DColorCube part of the DColorMixer.
    --- See also DColorCube:SetBaseRGB
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L252-L255)
    -- @param clr --- Color
    SetBaseColor: function(self, clr: table)

    --- An Global.AccessorFunc that sets the color of the DColorMixer. See also DColorMixer:GetColor
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L13)
    -- @param color --- The color to set. See Global.Color
    SetColor: function(self, color: table)

    --- An Global.AccessorFunc that sets the ConVar name for the alpha channel of the color.
    --- See also:
    --- * DColorMixer:SetConVarR - For the red channel
    --- * DColorMixer:SetConVarG - For the green channel
    --- * DColorMixer:SetConVarB - For the blue channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L198-L202)
    -- @param convar --- The ConVar name for the alpha channel of the color
    SetConVarA: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the blue channel of the color.
    --- See also:
    --- * DColorMixer:SetConVarR - For the red channel
    --- * DColorMixer:SetConVarG - For the green channel
    --- * DColorMixer:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L193-L196)
    -- @param convar --- The ConVar name for the blue channel of the color
    SetConVarB: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the green channel of the color.
    --- See also:
    --- * DColorMixer:SetConVarR - For the red channel
    --- * DColorMixer:SetConVarB - For the blue channel
    --- * DColorMixer:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L188-L191)
    -- @param convar --- The ConVar name for the green channel of the color
    SetConVarG: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the red channel of the color.
    --- See also:
    --- * DColorMixer:SetConVarG - For the green channel
    --- * DColorMixer:SetConVarB - For the blue channel
    --- * DColorMixer:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L183-L186)
    -- @param convar --- The ConVar name for the red channel of the color
    SetConVarR: function(self, convar: string)

    --- Sets the label's text to show.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L144-L156)
    -- @param text --- Set to non empty string to show the label and its text.
    --- Give it an empty string or nothing and the label will be hidden.
    SetLabel: function(self, text: string)

    --- Show or hide the palette panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L158-L164)
    -- @param enabled --- Show or hide the palette panel?
    SetPalette: function(self, enabled: boolean)

    --- Sets the color of DColorMixer from a Vector. Alpha is not included.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L246-L250)
    -- @param vec --- The color to set. It is expected that the vector will have values be from 0 to 1. (i.e. be normalized)
    SetVector: function(self, vec: GVector)

    --- Show / Hide the colors indicators in DColorMixer
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L175-L181)
    -- @param show --- Show / Hide the colors indicators
    SetWangs: function(self, show: boolean)

    --- **INTERNAL**:
    --- Use DColorMixer:SetColor instead!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L277-L311)
    -- @param clr ---
    UpdateColor: function(self, clr: table)

    --- **INTERNAL**:
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L257-L264)
    -- @param cvar --- The ConVar name
    -- @param part --- The color part to set the cvar to. "r", "g", "b" or "a".
    -- @param clr --- The Color
    UpdateConVar: function(self, cvar: string, part: string, clr: table)

    --- **INTERNAL**:
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L266-L275)
    -- @param clr --- The Color
    UpdateConVars: function(self, clr: table)

    --- sets the default color of the element to the currently selected color
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L204-L222)
    UpdateDefaultColor: function(self)

    --- Called when the player changes the color of the DColorMixer. Meant to be overridden.
    --- **BUG**: The returned color will not have the color metatable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L313-L315)
    -- @param col --- The new color. See Color
    ValueChanged: function(self, col: table)
end

--- The DColorCube allows a user to select saturation and value but not hue. Uses HSV colors
global interface DColorCube is DSlider
    --- An Global.AccessorFunc that returns the base Color set by DColorCube:SetBaseRGB.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L5)
    -- @return --- A Color
    GetBaseRGB: function(self): table

    --- An Global.AccessorFunc that returns the color cube's default color. By default, it is set to white. (255 255 255 RGB)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L7)
    -- @return --- The default Color.
    GetDefaultColor: function(self): table

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that returns the value set by DColorCube:SetHue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L4)
    -- @return ---
    GetHue: function(self): number

    --- An Global.AccessorFunc that returns the color cube's current set color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L6)
    -- @return --- The set color, uses Color.
    GetRGB: function(self): table

    --- Function which is called when the color cube slider is moved (through user input). Meant to be overridden.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L89-L93)
    -- @param color --- The new color, uses Color.
    OnUserChanged: function(self, color: table)

    --- Sets the color to whatever DColorCube:GetDefaultColor returns
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L43-L48)
    ResetToDefaultValue: function(self)

    --- An Global.AccessorFunc that sets the base color and the color used to draw the color cube panel itself.
    --- **NOTE**: Calling this when using a color that isn't 100% saturated and valued (Global.HSVToColor with saturation and value set to 1) causes the color cube to look inaccurate compared to the color that's returned by methods like DColorCube:GetRGB and DColorCube:OnUserChanged. You should use DColorCube:SetColor instead
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L107-L112)
    -- @param color --- The base color to set, uses Color.
    SetBaseRGB: function(self, color: table)

    --- Sets the base color of the color cube and updates the slider position.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L95-L105)
    -- @param color --- The color to set, uses Color.
    SetColor: function(self, color: table)

    --- An Global.AccessorFunc that sets the color cube's default color. This value will be used to reset to on middle mouse click of the color cube's draggable slider.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L7)
    -- @param  --- The new default Color.
    SetDefaultColor: function(self, _: table)

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that appears to do nothing and unused.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L4)
    -- @param hue ---
    SetHue: function(self, hue: number)

    --- **INTERNAL**:
    --- An Global.AccessorFunc that used internally to set the real "output" color of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L6)
    -- @param clr --- A Color
    SetRGB: function(self, clr: table)

    --- **INTERNAL**:
    --- Updates the color cube RGB based on the given x and y position and returns its arguments. Similar to DColorCube:UpdateColor.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L65-L72)
    -- @param x --- The x position to sample color from/the percentage of saturation to remove from the color (ranges from 0.0 to 1.0).
    -- @param y --- The y position to sample color from/the percentage of brightness or value to remove from the color (ranges from 0.0 to 1.0).
    -- @return --- The given x position.
    -- @return --- The given y position.
    TranslateValues: function(self, x: number, y: number): number, number

    --- **INTERNAL**:
    --- Updates the color cube RGB based on the given x and y position. Similar to DColorCube:TranslateValues.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcube.lua#L74-L87)
    -- @param x --- The x position to set color to/the percentage of saturation to remove from the color (ranges from 0.0 to 1.0).
    -- @param y --- The y position to set color to/the percentage of brightness or value to remove from the color (ranges from 0.0 to 1.0).
    UpdateColor: function(self, x: number, y: number)
end

--- The **DColorCombo** allows the user to choose color, without alpha,
--- using DColorMixer or DColorPalette in a tabbed view.
global interface DColorCombo is DPropertySheet
    --- **INTERNAL**:
    --- Called internally to create panels necessary for this panel to work.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcombo.lua#L14-L55)
    BuildControls: function(self)

    --- An Global.AccessorFunc that returns the color of the DColorCombo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcombo.lua#L4)
    -- @return --- A Color
    GetColor: function(self): table

    --- Returns true if the panel is currently being edited
    --- More of a internal method, it technically should only ever work (i.e. return true) inside DColorCombo:OnValueChanged.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcombo.lua#L57-L61)
    -- @return ---
    IsEditing: function(self): boolean

    --- Called when the value (color) of this panel was changed. For override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcombo.lua#L63-L67)
    -- @param newcol ---
    OnValueChanged: function(self, newcol: table)

    --- An Global.AccessorFunc that returns the color of this panel. See also DColorCombo:GetColor
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorcombo.lua#L69-L75)
    -- @param clr --- A Color.
    SetColor: function(self, clr: table)
end

--- Colorful buttons. Used internally by DColorPalette.
global interface DColorButton is DLabel
    --- An Global.AccessorFunc that returns the color of the button
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L9)
    -- @return --- The Color of the button
    GetColor: function(self): table

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that returns value set by DColorButton:SetDrawBorder. See that page for more info.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L6)
    -- @return --- Value set by DColorButton:SetDrawBorder.
    GetDrawBorder: function(self): boolean

    --- An Global.AccessorFunc that returns the unique ID set by DColorButton:SetID.
    --- Used internally by DColorPalette
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L10)
    -- @return --- The unique ID of the button
    GetID: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that is an alias of Panel:IsSelected.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L7)
    -- @return ---
    GetSelected: function(self): boolean

    --- Returns whether the DColorButton is currently being pressed (the user is holding it down).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L24-L28)
    -- @return ---
    IsDown: function(self): boolean

    --- Sets the color of the DColorButton.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L30-L41)
    -- @param color --- A Color to set the color as
    -- @param noTooltip --- If true, the tooltip will not be reset to display the selected color.
    --SetColor: function(self, color: table, noTooltip: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that does absolutely nothing at all. Default value is automatically set to true.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L6)
    -- @param draw --- Does nothing.
    SetDrawBorder: function(self, draw: boolean)

    --- An Global.AccessorFunc that is used internally by DColorPalette to detect which button is which.
    --- Pairs with DColorButton:GetID
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorbutton.lua#L10)
    -- @param id --- A unique ID to give this button
    SetID: function(self, id: number)
end

--- The **DCheckBoxLabel** is a DCheckBox with a DLabel next to it.
--- It allows you to get a boolean value from the user (true/false - yes/no)
global interface DCheckBoxLabel is DPanel
    --- Gets the checked state of the checkbox. This calls the checkbox's DCheckBox:GetChecked function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L114-L116)
    -- @return --- Whether the box is checked or not.
    GetChecked: function(self): boolean

    --- An Global.AccessorFunc that gets the indentation of the element on the X axis. See also DCheckBoxLabel:SetIndent
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L81)
    -- @return --- How much the content is moved to the right in pixels
    GetIndent: function(self): number

    --- Called when the "checked" state is changed. This is meant to be Overriden
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L179-L183)
    -- @param bVal --- Whether the checkbox is checked or unchecked.
    OnChange: function(self, bVal: boolean)

    --- Sets the color of the DCheckBoxLabel's text to the bright text color defined in the skin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L98-L100)
    -- @param bright --- true makes the text bright.
    SetBright: function(self, bright: boolean)

    --- Sets the checked state of the checkbox. Does not call DCheckBoxLabel:OnChange or Panel:ConVarChanged, unlike DCheckBoxLabel:SetValue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L110-L112)
    -- @param checked --- Whether the box should be checked or not.
    SetChecked: function(self, checked: boolean)

    --- Sets the console variable to be set when the checked state of the DCheckBoxLabel changes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L102-L104)
    -- @param convar --- The name of the convar to set
    SetConVar: function(self, convar: string)

    --- Sets the text of the DCheckBoxLabel to be dark colored in accordance with the currently active Derma skin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L94-L96)
    -- @param darkify --- True to be dark, false to be default
    SetDark: function(self, darkify: boolean)

    --- Sets the font of the text part of the DCheckBoxLabel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L156-L161)
    -- @param font --- Font name
    SetFont: function(self, font: string)

    --- An Global.AccessorFunc that sets the indentation of the element on the X axis.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L81)
    -- @param ident --- How much in pixels to move the content to the right
    SetIndent: function(self, ident: number)

    --- Sets the text color for the DCheckBoxLabel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L134-L138)
    -- @param color --- The text color. Uses the Color.
    SetTextColor: function(self, color: table)

    --- Sets the checked state of the checkbox, and calls DCheckBoxLabel:OnChange and the checkbox's Panel:ConVarChanged methods.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L106-L108)
    -- @param checked --- Whether the box should be checked or not (1 or 0 can also be used).
    SetValue: function(self, checked: boolean)

    --- Sizes the panel to the size of the internal DLabel and DButton
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L140-L147)
    SizeToContents: function(self)

    --- Toggles the checked state of the DCheckBoxLabel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L118-L120)
    Toggle: function(self)
end

--- The DCheckBox is a checkbox. It allows you to get a boolean value from the user (true/false - yes/no)
global interface DCheckBox is DButton
    --- Calls DCheckBox:Toggle
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L39-L43)
    DoClick: function(self)

    --- An Global.AccessorFunc that gets the checked state of the checkbox.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L4)
    -- @return --- Whether the box is checked or not.
    GetChecked: function(self): boolean

    --- Returns whether the state of the checkbox is being edited. This means whether the user is currently clicking (mouse-down) on the checkbox, and applies to both the left and right mouse buttons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L19-L21)
    -- @return --- Whether the checkbox is being clicked.
    IsEditing: function(self): boolean

    --- Called when the "checked" state is changed. This is for Overriding
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L51-L55)
    -- @param bVal --- Whether the CheckBox is checked or not.
    OnChange: function(self, bVal: boolean)

    --- An Global.AccessorFunc that sets the checked state of the checkbox. Does not call the checkbox's DCheckBox:OnChange and Panel:ConVarChanged methods, unlike DCheckBox:SetValue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L4)
    -- @param checked --- Whether the box should be checked or not.
    SetChecked: function(self, checked: boolean)

    --- Sets the checked state of the checkbox, and calls the checkbox's DCheckBox:OnChange and Panel:ConVarChanged methods.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L23-L37)
    -- @param checked --- Whether the box should be checked or not.
    SetValue: function(self, checked: boolean)

    --- Toggles the checked state of the checkbox, and calls the checkbox's DCheckBox:OnChange and Panel:ConVarChanged methods. DCheckBox:DoClick is an alias of this function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcheckbox.lua#L45-L49)
    Toggle: function(self)
end

--- A host for multiple DCollapsibleCategory panels.

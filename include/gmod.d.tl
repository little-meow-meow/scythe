--- Bit flags used by Global.GetRenderTargetEx. Information taken from [VTF (Valve Texture Format) - Texture flags](https://developer.valvesoftware.com/wiki/Valve_Texture_Format#Texture_flags)
--- **WARNING**: These enumerations do not exist in game and are listed here only for reference
global type E_TEXTUREFLAGS = number
--- Low quality, "pixel art" texture filtering.
global TEXTUREFLAGS_POINTSAMPLE: E_TEXTUREFLAGS = 1
--- Medium quality texture filtering.
global TEXTUREFLAGS_TRILINEAR: E_TEXTUREFLAGS = 2
--- Clamp S coordinates.
global TEXTUREFLAGS_CLAMPS: E_TEXTUREFLAGS = 4
--- Clamp T coordinates.
global TEXTUREFLAGS_CLAMPT: E_TEXTUREFLAGS = 8
--- High quality texture filtering.
global TEXTUREFLAGS_ANISOTROPIC: E_TEXTUREFLAGS = 16
--- Used in skyboxes. Makes sure edges are seamless.
global TEXTUREFLAGS_HINT_DXT5: E_TEXTUREFLAGS = 32
--- Purpose unknown.
global TEXTUREFLAGS_PWL_CORRECTED: E_TEXTUREFLAGS = 64
--- Texture is a normal map.
global TEXTUREFLAGS_NORMAL: E_TEXTUREFLAGS = 128
--- Render largest mipmap only. (Does not delete existing mipmaps, just disables them.)
global TEXTUREFLAGS_NOMIP: E_TEXTUREFLAGS = 256
--- Not affected by texture resolution settings.
global TEXTUREFLAGS_NOLOD: E_TEXTUREFLAGS = 512
--- No Minimum Mipmap
global TEXTUREFLAGS_ALL_MIPS: E_TEXTUREFLAGS = 1024
--- Texture is an procedural texture (code can modify it).
global TEXTUREFLAGS_PROCEDURAL: E_TEXTUREFLAGS = 2048
--- One bit alpha channel used.
global TEXTUREFLAGS_ONEBITALPHA: E_TEXTUREFLAGS = 4096
--- Eight bit alpha channel used.
global TEXTUREFLAGS_EIGHTBITALPHA: E_TEXTUREFLAGS = 8192
--- Texture is an environment map.
global TEXTUREFLAGS_ENVMAP: E_TEXTUREFLAGS = 16384
--- Texture is a render target.
global TEXTUREFLAGS_RENDERTARGET: E_TEXTUREFLAGS = 32768
--- Texture is a depth render target.
global TEXTUREFLAGS_DEPTHRENDERTARGET: E_TEXTUREFLAGS = 65536
global TEXTUREFLAGS_NODEBUGOVERRIDE: E_TEXTUREFLAGS = 131072
global TEXTUREFLAGS_SINGLECOPY: E_TEXTUREFLAGS = 262144
--- @deprecated
--- **DEPRECATED**:
--- Aka TEXTUREFLAGS_UNUSED_00080000
global TEXTUREFLAGS_STAGING_MEMORY: E_TEXTUREFLAGS = 524288
--- @deprecated
--- **DEPRECATED**:
--- Immediately destroy this texture when its reference count hits zero.
--- Aka TEXTUREFLAGS_UNUSED_00100000
global TEXTUREFLAGS_IMMEDIATE_CLEANUP: E_TEXTUREFLAGS = 1048576
--- @deprecated
--- **DEPRECATED**:
--- Aka TEXTUREFLAGS_UNUSED_00200000
global TEXTUREFLAGS_IGNORE_PICMIP: E_TEXTUREFLAGS = 2097152
global TEXTUREFLAGS_UNUSED_00400000: E_TEXTUREFLAGS = 4194304
--- Do not buffer for Video Processing, generally render distance.
global TEXTUREFLAGS_NODEPTHBUFFER: E_TEXTUREFLAGS = 8388608
global TEXTUREFLAGS_UNUSED_01000000: E_TEXTUREFLAGS = 16777216

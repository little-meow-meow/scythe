--- Water that is moving (may not work)
global MASK_CURRENT: E_MASK = 16515072
--- Anything that blocks corpse movement
global MASK_DEADSOLID: E_MASK = 65547
--- Anything that blocks NPC movement
global MASK_NPCSOLID: E_MASK = 33701899
--- Anything that blocks NPC movement, except other NPCs
global MASK_NPCSOLID_BRUSHONLY: E_MASK = 147467
--- The world entity
global MASK_NPCWORLDSTATIC: E_MASK = 131083
--- Anything that blocks lighting
global MASK_OPAQUE: E_MASK = 16513
--- Anything that blocks lighting, including NPCs
global MASK_OPAQUE_AND_NPCS: E_MASK = 33570945
--- Anything that blocks player movement
global MASK_PLAYERSOLID: E_MASK = 33636363
--- World + Brushes + Player Clips
global MASK_PLAYERSOLID_BRUSHONLY: E_MASK = 81931
--- Anything that stops a bullet (including hitboxes)
global MASK_SHOT: E_MASK = 1174421507
--- Anything that stops a bullet (excluding hitboxes)
global MASK_SHOT_HULL: E_MASK = 100679691
--- Solids except for grates
global MASK_SHOT_PORTAL: E_MASK = 33570819
--- Anything that is (normally) solid
global MASK_SOLID: E_MASK = 33570827
--- World + Brushes
global MASK_SOLID_BRUSHONLY: E_MASK = 16395
--- Things that split area portals
global MASK_SPLITAREAPORTAL: E_MASK = 48
--- Anything that blocks line of sight for players
global MASK_VISIBLE: E_MASK = 24705
--- Anything that blocks line of sight for players, including NPCs
global MASK_VISIBLE_AND_NPCS: E_MASK = 33579137
--- Anything that has water-like physics

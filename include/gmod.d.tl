--- Enumerations used by Entity:SetCollisionGroup, Entity:GetCollisionGroup and Traces.
global type E_COLLISION_GROUP = number
--- Normal
global COLLISION_GROUP_NONE: E_COLLISION_GROUP = 0
--- Collides with nothing but world and static stuff
global COLLISION_GROUP_DEBRIS: E_COLLISION_GROUP = 1
--- Same as debris, but hits triggers. Useful for an item that can be shot, but doesn't collide.
global COLLISION_GROUP_DEBRIS_TRIGGER: E_COLLISION_GROUP = 2
--- Collides with everything except other interactive debris or debris
global COLLISION_GROUP_INTERACTIVE_DEBRIS: E_COLLISION_GROUP = 3
--- Collides with everything except interactive debris or debris
global COLLISION_GROUP_INTERACTIVE: E_COLLISION_GROUP = 4
--- Used by players, but NOT for movement collision. Does not collide with COLLISION_GROUP_PASSABLE_DOOR and COLLISION_GROUP_PUSHAWAY
global COLLISION_GROUP_PLAYER: E_COLLISION_GROUP = 5
--- NPCs can see straight through an Entity with this applied.
global COLLISION_GROUP_BREAKABLE_GLASS: E_COLLISION_GROUP = 6
--- Used by driveable vehicles. Always collides against COLLISION_GROUP_VEHICLE_CLIP
global COLLISION_GROUP_VEHICLE: E_COLLISION_GROUP = 7
--- For HL2, same as Collision_Group_Player, for TF2, this filters out other players and CBaseObjects
global COLLISION_GROUP_PLAYER_MOVEMENT: E_COLLISION_GROUP = 8
--- Generic NPC group
global COLLISION_GROUP_NPC: E_COLLISION_GROUP = 9
--- Doesn't collide with anything, no traces
global COLLISION_GROUP_IN_VEHICLE: E_COLLISION_GROUP = 10
--- Doesn't collide with players and vehicles
global COLLISION_GROUP_WEAPON: E_COLLISION_GROUP = 11
--- Only collides with vehicles
global COLLISION_GROUP_VEHICLE_CLIP: E_COLLISION_GROUP = 12
--- Set on projectiles. Does not collide with other projectiles.
global COLLISION_GROUP_PROJECTILE: E_COLLISION_GROUP = 13
--- Blocks entities not permitted to get near moving doors
global COLLISION_GROUP_DOOR_BLOCKER: E_COLLISION_GROUP = 14
--- Lets the Player through, nothing else.
global COLLISION_GROUP_PASSABLE_DOOR: E_COLLISION_GROUP = 15
--- Things that are dissolving are in this group
global COLLISION_GROUP_DISSOLVING: E_COLLISION_GROUP = 16
--- Nonsolid on client and server, pushaway in player code
global COLLISION_GROUP_PUSHAWAY: E_COLLISION_GROUP = 17
--- Used so NPCs in scripts ignore the player
global COLLISION_GROUP_NPC_ACTOR: E_COLLISION_GROUP = 18
--- Used for NPCs in scripts that should not collide with each other
global COLLISION_GROUP_NPC_SCRIPTED: E_COLLISION_GROUP = 19
--- Doesn't collide with players/props
global COLLISION_GROUP_WORLD: E_COLLISION_GROUP = 20
--- Amount of COLLISION_GROUP_ enumerations
global LAST_SHARED_COLLISION_GROUP: E_COLLISION_GROUP = 21
--- Half-Life 2 exclusive collision group, acts similarly to `COLLISION_GROUP_PROJECTILE` but is also ignored by player movement.
global COLLISION_GROUP_HL2_SPIT: E_COLLISION_GROUP = 22


-- @param startIndex --- Which index to start from. Optional.
-- @param endIndex --- Which index to end at. Optional, even if you set StartIndex.
-- @return --- Output values
global function unpack(tbl: table, startIndex?: number, endIndex?: number): any...
end

--- Returns the current asynchronous in-game time. This will not be synced with the players current clock allowing you to get Global.CurTime without interference from Prediction.
-- @return --- The asynchronous in-game time.
global function UnPredictedCurTime(): number
end


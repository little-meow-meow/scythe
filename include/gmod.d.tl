--- Texture is a SSBump. (SSB)
global TEXTUREFLAGS_SSBUMP: E_TEXTUREFLAGS = 134217728
global TEXTUREFLAGS_UNUSED_10000000: E_TEXTUREFLAGS = 268435456
--- Clamp to border colour on all texture coordinates
global TEXTUREFLAGS_BORDER: E_TEXTUREFLAGS = 536870912

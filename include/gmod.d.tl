--- Things that are solid
global CONTENTS_SOLID: E_CONTENTS = 1
--- Glass
global CONTENTS_WINDOW: E_CONTENTS = 2
global CONTENTS_AUX: E_CONTENTS = 4
--- Bullets go through, solids don't
global CONTENTS_GRATE: E_CONTENTS = 8
global CONTENTS_SLIME: E_CONTENTS = 16
--- Hits world but not skybox
global CONTENTS_WATER: E_CONTENTS = 32
--- Things that block line of sight
global CONTENTS_BLOCKLOS: E_CONTENTS = 64
--- Things that block light
global CONTENTS_OPAQUE: E_CONTENTS = 128
global CONTENTS_TESTFOGVOLUME: E_CONTENTS = 256
global CONTENTS_TEAM4: E_CONTENTS = 512
global CONTENTS_TEAM3: E_CONTENTS = 1024
global CONTENTS_TEAM1: E_CONTENTS = 2048
global CONTENTS_TEAM2: E_CONTENTS = 4096
global CONTENTS_IGNORE_NODRAW_OPAQUE: E_CONTENTS = 8192
global CONTENTS_MOVEABLE: E_CONTENTS = 16384
global CONTENTS_AREAPORTAL: E_CONTENTS = 32768
global CONTENTS_PLAYERCLIP: E_CONTENTS = 65536
global CONTENTS_MONSTERCLIP: E_CONTENTS = 131072
global CONTENTS_CURRENT_0: E_CONTENTS = 262144
global CONTENTS_CURRENT_180: E_CONTENTS = 1048576
global CONTENTS_CURRENT_270: E_CONTENTS = 2097152
global CONTENTS_CURRENT_90: E_CONTENTS = 524288
global CONTENTS_CURRENT_DOWN: E_CONTENTS = 8388608
global CONTENTS_CURRENT_UP: E_CONTENTS = 4194304
--- Includes, among other things, client-side ragdolls and prop gibs
global CONTENTS_DEBRIS: E_CONTENTS = 67108864
global CONTENTS_DETAIL: E_CONTENTS = 134217728
--- Hitbox
global CONTENTS_HITBOX: E_CONTENTS = 1073741824
--- Ladder
global CONTENTS_LADDER: E_CONTENTS = 536870912
--- NPCs
global CONTENTS_MONSTER: E_CONTENTS = 33554432
global CONTENTS_ORIGIN: E_CONTENTS = 16777216
--- Hits world but not skybox
global CONTENTS_TRANSLUCENT: E_CONTENTS = 268435456
--- Last visible contents enumeration
global LAST_VISIBLE_CONTENTS: E_CONTENTS = 128
--- Sum of all the visible contents enumerations
global ALL_VISIBLE_CONTENTS: E_CONTENTS = 255


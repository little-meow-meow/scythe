    --- Returns if the panel is valid and not marked for deletion.
    -- @return --- True if the object is valid.
    IsValid: function(self): boolean

    --- Returns if the panel is visible. This will **NOT** take into account visibility of the parent.
    -- @return --- `true` if the panel ls visible, `false` otherwise.
    IsVisible: function(self): boolean

    --- Returns if a panel allows world clicking set by Panel:SetWorldClicker.
    -- @return --- If the panel allows world clicking.
    IsWorldClicker: function(self): boolean

    --- Remove the focus from the panel.
    KillFocus: function(self)

    --- Redefines the panel object's Panel:SetPos method to operate using frame-by-frame linear interpolation (Global.Lerp). When the panel's position is changed, it will move to the target position at the speed defined. You can undo this with Panel:DisableLerp.
    --- Unlike the other panel animation functions, such as Panel:MoveTo, this animation method will not operate whilst the game is paused. This is because it relies on Global.FrameTime.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L338-L354)
    -- @param speed --- The speed at which to move the panel. This is affected by the value of `easeOut`. Recommended values are:
    --- * **0.1 - 10** when `easeOut` is `false`.
    --- * **0.1 - 1** when `easeOut` is `true`.
    -- @param easeOut --- This causes the panel object to 'jump' at the target, slowing as it approaches. This affects the `speed` value significantly, see above.
    LerpPositions: function(self, speed: number, easeOut: boolean)

    --- @deprecated
    --- **DEPRECATED**: No longer does anything.
    --- **INTERNAL**:
    --- Similar to Panel:LoadControlsFromString but loads controls from a file.
    -- @param path --- The path to load the controls from.
    LoadControlsFromFile: function(self, path: string)

    --- @deprecated
    --- **DEPRECATED**: No longer does anything.
    --- **INTERNAL**:
    --- Loads controls(positions, etc) from given data. This is what the default options menu uses.
    -- @param data --- The data to load controls from. Format unknown.
    LoadControlsFromString: function(self, data: string)

    --- Loads a .gwen file (created by GWEN Designer) and calls Panel:LoadGWENString with the contents of the loaded file.
    --- Used to load panel controls from a file.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L126-L133)
    -- @param filename --- The file to open. The path is relative to garrysmod/garrysmod/.
    -- @param path --- The path used to look up the file.
    --- * "GAME" Structured like base folder (garrysmod/), searches all the mounted content (main folder, addons, mounted games etc)
    --- * "LUA" or "lsv" - All Lua folders (lua/) including gamesmodes and addons
    --- * "DATA" Data folder (garrysmod/data)
    --- * "MOD" Strictly the game folder (garrysmod/), ignores mounting.
    LoadGWENFile: function(self, filename: string, path: string)

    --- Loads controls for the panel from a JSON string.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L138-L146)
    -- @param str --- JSON string containing information about controls to create.
    LoadGWENString: function(self, str: string)

    --- Sets a new image to be loaded by a TGAImage.
    -- @param imageName --- The file path.
    -- @param strPath --- The PATH to search in. See File Search Paths.
    --- This isn't used internally.
    LoadTGAImage: function(self, imageName: string, strPath: string)

    --- Returns the cursor position local to the position of the panel (usually the upper-left corner).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L540-L542)
    -- @return --- The x coordinate
    -- @return --- The y coordinate
    LocalCursorPos: function(self): number, number

    --- Takes X and Y coordinates relative to the panel and returns their corresponding positions relative to the screen.
    --- See also Panel:ScreenToLocal.
    --- **WARNING**: This function uses a cached value for the screen position of the panel, computed at the end of the last VGUI Think/Layout pass, so inaccurate results may be returned if the panel or any of its ancestors have been re-positioned outside of PANEL:Think or PANEL:PerformLayout within the last frame.
    --- **NOTE**: If the panel uses Panel:Dock, this function will return 0, 0 when the panel was created. The position will be updated in the next frame.
    -- @param posX --- The X coordinate of the position on the panel to translate.
    -- @param posY --- The Y coordinate of the position on the panel to translate.
    -- @return --- The X coordinate relative to the screen.
    -- @return --- The Y coordinate relative to the screen.
    LocalToScreen: function(self, posX: number, posY: number): number, number

    --- Focuses the panel and enables it to receive input.
    --- This automatically calls Panel:SetMouseInputEnabled and Panel:SetKeyboardInputEnabled and sets them to `true`.
    --- **NOTE**: Panels derived from Panel will not work properly with this function. Due to this, any children will not be intractable with keyboard. Derive from EditablePanel instead.
    --- For non gui related mouse focus, you can use gui.EnableScreenClicker.
    MakePopup: function(self)

    --- Allows the panel to receive mouse input even if the mouse cursor is outside the bounds of the panel.
    -- @param doCapture --- Set to true to enable, set to false to disable.
    MouseCapture: function(self, doCapture: boolean)

    --- Places the panel above the passed panel with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L137-L137)
    -- @param panel --- Panel to position relatively to.
    -- @param offset --- The align offset.
    MoveAbove: function(self, panel: GPanel, offset: number)

    --- Places the panel below the passed panel with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L138-L138)
    -- @param panel --- Panel to position relatively to.
    -- @param offset --- The align offset.
    MoveBelow: function(self, panel: GPanel, offset: number)

    --- Moves the panel by the specified coordinates using animation.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L286-L292)
    -- @param moveX --- The number of pixels to move by in the horizontal (x) direction.
    -- @param moveY --- The number of pixels to move by in the vertical (y) direction.
    -- @param time --- The time (in seconds) in which to perform the animation.
    -- @param delay --- The delay (in seconds) before the animation begins.
    -- @param ease --- The easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    -- @param callback --- The function to be called once the animation is complete.
    --- <callback>
    --- <arg type="table" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    MoveBy: function(self, moveX: number, moveY: number, time: number, delay: number, ease: number, callback: function)

    --- Places the panel left to the passed panel with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L140-L140)
    -- @param panel --- Panel to position relatively to.
    -- @param offset --- The align offset.
    MoveLeftOf: function(self, panel: GPanel, offset: number)

    --- Places the panel right to the passed panel with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L139-L139)
    -- @param panel --- Panel to position relatively to.
    -- @param offset --- The align offset.
    MoveRightOf: function(self, panel: GPanel, offset: number)

    --- Moves the panel to the specified position using animation.
    --- **NOTE**: Setting the ease argument to 0 will result in the animation happening instantly, this applies to all MoveTo/SizeTo functions
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L146-L157)
    -- @param posX --- The target x coordinate of the panel.
    -- @param posY --- The target y coordinate of the panel.
    -- @param time --- The time to perform the animation within.
    -- @param delay --- The delay before the animation starts.
    -- @param ease --- The easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    -- @param callback --- The function to be called once the animation finishes.
    --- <callback>
    --- <arg type="table" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    MoveTo: function(self, posX: number, posY: number, time: number, delay: number, ease: number, callback: function)

    --- Moves this panel object in front of the specified sibling (child of the same parent) in the render order, and shuffles up the Z-positions of siblings now behind.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L544-L565)
    -- @param siblingPanel --- The panel to move this one in front of. Must be a child of the same parent panel.
    -- @return --- `false` if the passed panel is not a sibling, otherwise `nil`.
    MoveToAfter: function(self, siblingPanel: GPanel): boolean

    --- Moves the panel object behind all other panels on screen. If the panel has been made a pop-up with Panel:MakePopup, it will still draw in front of any panels that haven't.
    MoveToBack: function(self)

    --- Moves this panel object behind the specified sibling (child of the same parent) in the render order, and shuffles up the Panel:SetZPos of siblings now in front.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L567-L588)
    -- @param siblingPanel --- The panel to move this one behind. Must be a child of the same parent panel.
    -- @return --- `false` if the passed panel is not a sibling, otherwise `nil`.
    MoveToBefore: function(self, siblingPanel: GPanel): boolean

    --- Moves the panel in front of all other panels on screen. Unless the panel has been made a pop-up using Panel:MakePopup, it will still draw behind any that have.
    MoveToFront: function(self)

    --- Creates a new animation for the panel object.
    --- Methods that use this function:
    --- * Panel:MoveTo
    --- * Panel:SizeTo
    --- * Panel:SlideUp
    --- * Panel:SlideDown
    --- * Panel:ColorTo
    --- * Panel:AlphaTo
    --- * Panel:MoveBy
    --- * Panel:LerpPositions
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L102-L136)
    -- @param length --- The length of the animation in seconds.
    -- @param delay --- The delay before the animation starts.
    -- @param ease --- The power/index to use for easing.
    --- * Positive values greater than 1 will ease in; the higher the number, the sharper the curve's gradient (less linear).
    --- * A value of 1 removes all easing.
    --- * Positive values between 0 and 1 ease out; values closer to 0 increase the curve's gradient (less linear).
    --- * A value of 0 will break the animation and should be avoided.
    --- * Any value less than zero will ease in/out; the value has no effect on the gradient.
    -- @param callback --- The function to be called when the animation ends.
    --- <callback>
    --- <arg type="table" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    -- @return --- Partially filled Structures/AnimationData with the following members:
    --- * number **EndTime** - Equal to `length` and `delay` arguments added together, plus either the Global.SysTime if there is no other animation queued or the end time of the last animation in the queue.
    --- * number **StartTime** - Equal to the `delay` argument, plus either the Global.SysTime if there is no other animation queued or the end time of the last animation in the queue.
    --- * number **Ease** - Equal to the `ease` argument.
    --- * function **OnEnd** - Equal to the `callback` argument.
    NewAnimation: function(self, length: number, delay: number, ease: number, callback: function): table

    --- **INTERNAL**:
    -- @param objectName ---
    NewObject: function(self, objectName: string)

    --- **INTERNAL**:
    -- @param objectName ---
    -- @param callbackName ---
    NewObjectCallback: function(self, objectName: string, callbackName: string)

    --- Sets whether this panel's drawings should be clipped within the parent panel's bounds.
    --- See render.SetScissorRect if you wish to set the clipping rect instead.
    --- **NOTE**: This only disabled clipping for the Paint Related functions (as far as i can tell at the current moment, more testing should be done) so things like the text of a DLabel will still be clipped to the parent.
    --- To fully disable the clipping of any children see Global.DisableClipping.
    -- @param disableClipping --- Whether to disable clipping or not. `true` to disable clipping, `false` to enable clipping.
    NoClipping: function(self, disableClipping: boolean)

    --- Returns the number of children of the panel object that are selected. This is equivalent to calling Panel:IsSelected on all child objects and counting the number of returns that are `true`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L207-L221)
    -- @return --- The number of child objects that are currently selected. This does not include the parent object you are calling the method from.
    NumSelectedChildren: function(self): number

    --- Instructs a HTML control to download and parse a HTML script using the passed URL.
    --- This function can only be used on [HTML](HTML) panel and its derivatives.
    -- @param URL --- URL to open. It has to start or be one of the following:
    --- * `http://`
    --- * `https://`
    --- * `asset://`
    --- * `about:blank`
    --- * `chrome://credits/`
    OpenURL: function(self, URL: string)

    --- Paints a ghost copy of the panel at the given position.
    --- **WARNING**: This function sets Z pos of panel's children (PANEL:SetZPos). It also briefly unparents and reparents the panel.
    -- @param posX --- The x coordinate to draw the panel from.
    -- @param posY --- The y coordinate to draw the panel from.
    PaintAt: function(self, posX: number, posY: number)

    --- Paints the panel at its current position. To use this you must call Panel:SetPaintedManually(true).
    -- @param unclamp --- If set, overrides panels' clipping so that it can render fully when its size is larger than the game's resolution.
    PaintManual: function(self, unclamp: boolean)

    --- Set to true by the dragndrop system when the panel is being drawn for the drag'n'drop.
    PaintingDragging: boolean

    --- Parents the panel to the HUD.
    --- Makes it invisible on the escape-menu and disables controls.
    ParentToHUD: function(self)

    --- @deprecated
    --- **DEPRECATED**: Due to privacy concerns, this function has been disabled
    --- Only works for TextEntries.
    --- Pastes the contents of the clipboard into the TextEntry.
    --- **NOTE**: Tab characters will be dropped from the pasted text
    Paste: function(self)

    --- Sets the width and position of a DLabel and places the passed panel object directly to the right of it. Returns the `y` value of the bottom of the tallest object. The panel on which this method is run is not relevant; only the passed objects are affected.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L262-L275)
    -- @param lblWidth --- The width to set the label to.
    -- @param x --- The horizontal (x) position at which to place the label.
    -- @param y --- The vertical (y) position at which to place the label.
    -- @param lbl --- The label to resize and position.
    -- @param panelObj --- The panel object to place to the right of the label.
    -- @return --- The distance from the top of the parent panel to the bottom of the tallest object (the `y` position plus the height of the label or passed panel, depending on which is tallest).
    PositionLabel: function(self, lblWidth: number, x: number, y: number, lbl: GPanel, panelObj: GPanel): number

    --- **INTERNAL**:
    --- Installs Lua defined functions into the panel.
    Prepare: function(self)

    --- Enables the queue for panel animations. If enabled, the next new animation will begin after all current animations have ended. This must be called before Panel:NewAnimation to work, and only applies to the next new animation. If you want to queue many, you must call this before each.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L84-L88)
    Queue: function(self)

    --- Causes a SpawnIcon to rebuild its model image.
    RebuildSpawnIcon: function(self)

    --- Re-renders a spawn icon with customized cam data.
    --- Global.PositionSpawnIcon can be used to easily calculate the necessary camera parameters.
    --- **NOTE**: This function does **not** accept the standard Structures/CamData.
    -- @param data --- A four-membered table containing the information needed to re-render:
    --- * Vector cam_pos - The relative camera position the model is viewed from.
    --- * Angle cam_ang - The camera angle the model is viewed from.
    --- * number cam_fov - The camera's field of view (FOV).
    --- * Entity ent - The entity object of the model.
    --- See the example below for how to retrieve these values.
    RebuildSpawnIconEx: function(self, data: table)

    --- Allows the panel to receive drag and drop events. Can be called multiple times with different names to receive multiple different draggable panel events.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L315-L324)
    -- @param name --- Name of DnD panels to receive. This is set on the drag'n'drop-able panels via  Panel:Droppable
    -- @param func --- This function is called whenever a panel with valid name is hovering above and dropped on this panel.
    --- <callback>
    --- <arg type="Panel" name="pnl">The receiver panel</arg>
    --- <arg type="table" name="tbl">A table of panels dropped onto receiver panel</arg>
    --- <arg type="boolean" name="dropped">False if hovering over, true if dropped onto</arg>
    --- <arg type="number" name="menuIndex">Index of clicked menu item from third argument of Panel:Receiver</arg>
    --- <arg type="number" name="x">Cursor pos, relative to the receiver</arg>
    --- <arg type="number" name="y">Cursor pos, relative to the receiver</arg>
    --- </callback>
    -- @param menu --- A table of strings that will act as a menu if drag'n'drop was performed with a right click
    Receiver: function(self, name: string, func: function, menu: table)

    --- Refreshes the HTML panel's current page.
    -- @param ignoreCache --- If true, the refresh will ignore cached content similar to "ctrl+f5" in most browsers.
    Refresh: function(self, ignoreCache: boolean)

    --- Marks a panel for deletion so it will be deleted on the next frame.
    --- This will not mark child panels for deletion this frame, but they will be marked and deleted in the next frame.
    --- See also Panel:IsMarkedForDeletion
    --- Will automatically call Panel:InvalidateParent.
    Remove: function(self)

    --- Attempts to obtain focus for this panel.
    RequestFocus: function(self)

    --- Resets all text fades in a RichText element made with Panel:InsertFade.
    -- @param hold --- True to reset fades, false otherwise.
    -- @param expiredOnly --- Any value equating to `true` will reset fades only on text segments that are completely faded out.
    -- @param newSustain --- The new sustain value of each faded text segment. Set to -1 to keep the old sustain value.
    ResetAllFades: function(self, hold: boolean, expiredOnly: boolean, newSustain: number)

    --- Executes a string as JavaScript code on a web document panel.
    --- **NOTE**: This function does **NOT** allow you to pass variables from JavaScript (JS) to Lua context.
    --- If you wish to pass/return values from JS to Lua, you may want to use DHTML:AddFunction function to accomplish that job.
    --- **NOTE**: The Awesomium web renderer automatically delays the code execution if the document is not ready, but the Chromium web renderer does not!
    --- This means that with Chromium, you cannot JavaScript run code immediatly after calling Panel:SetHTML or Panel:OpenURL. You should wait for the events HTML:OnDocumentReady or HTML:OnFinishLoadingDocument to be triggered before proceeding, otherwise you may manipulate an empty / incomplete document.
    -- @param js --- Specify JavaScript code to be executed.
    RunJavascript: function(self, js: string)

    --- Saves the current state (caret position and the text inside) of a TextEntry as an undo state.
    --- See also Panel:Undo.
    SaveUndoState: function(self)

    --- Translates global screen coordinate to coordinates relative to the panel.
    --- See also Panel:LocalToScreen.
    --- **WARNING**: This function uses a cached value for the screen position of the panel, computed at the end of the last VGUI Think/Layout pass, so inaccurate results may be returned if the panel or any of its ancestors have been re-positioned outside of PANEL:Think or PANEL:PerformLayout within the last frame.
    -- @param screenX --- The x coordinate of the screen position to be translated.
    -- @param screenY --- The y coordinate of the screed position be to translated.
    -- @return --- Relativeposition X
    -- @return --- Relativeposition Y
    ScreenToLocal: function(self, screenX: number, screenY: number): number, number

    --- Selects all items within a panel or object. For text-based objects, selects all text.
    --- **NOTE**: Only works on RichText and TextEntry and their derived panels by default (such as DTextEntry), and on any panel that manually reimplemented this method.
    SelectAll: function(self)

    --- If called on a TextEntry, clicking the text entry for the first time will automatically select all of the text ready to be copied by the user.
    SelectAllOnFocus: function(self)

    --- @deprecated
    --- **DEPRECATED**: Duplicate of Panel:SelectAll.
    --- Selects all the text in a panel object. Will not select non-text items; for this, use Panel:SelectAll.
    -- @param resetCursorPos --- Reset cursor pos?
    SelectAllText: function(self, resetCursorPos: boolean)

    --- Deselects all items in a panel object. For text-based objects, this will deselect all text.
    --- **NOTE**: Only works on RichText and TextEntry and their derived panels by default (such as DTextEntry), and on any panel that manually reimplemented this method.
    SelectNone: function(self)

    --- Sets the achievement to be displayed by AchievementIcon.
    -- @param id --- Achievement number ID
    SetAchievement: function(self, id: number)

    --- Configures a TextEntry to allow user to type characters that are not included in the US-ASCII (7-bit ASCII) character set.
    --- Characters not included in US-ASCII are multi-byte characters in UTF-8. They can be accented characters, non-Latin characters and special characters.
    -- @param allowed --- Set to true in order not to restrict input characters.
    SetAllowNonAsciiCharacters: function(self, allowed: boolean)

    --- Sets the alpha multiplier for the panel
    -- @param alpha --- The alpha value in the range of 0-255.
    SetAlpha: function(self, alpha: number)

    --- Enables or disables animations for the panel object by overriding the PANEL:AnimationThink hook to nil and back.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L65-L76)
    -- @param enable --- Whether to enable or disable animations.
    SetAnimationEnabled: function(self, enable: boolean)

    --- Sets whenever the panel should be removed if the parent was removed.
    -- @param autoDelete --- Whenever to delete if the parent was removed or not.
    SetAutoDelete: function(self, autoDelete: boolean)

    --- Sets the background color of a panel such as a RichText, Label, DColorCube or the base Panel.
    --- For many panels, such as DLabel and Panel, you must use Panel:SetPaintBackgroundEnabled( true ) for the background to appear.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the PANEL:ApplySchemeSettings hook, so you may want to set the color in that hook instead.
    --- See Panel:SetFGColor for the foreground color.
    --- **NOTE**: This doesn't apply to all VGUI elements and its function varies between them
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L32-L40)
    -- @param r or color --- The red channel of the color, or a Color. If you pass the latter, the following three arguments are ignored.
    -- @param g --- The green channel of the color.
    -- @param b --- The blue channel of the color.
    -- @param a --- The alpha channel of the color.
    SetBGColor: function(self, r_or_color: number, g: number, b: number, a: number)

    --- **INTERNAL**:
    --- Sets the background color of the panel.
    -- @param r --- The red channel of the color.
    -- @param g --- The green channel of the color.
    -- @param b --- The blue channel of the color.
    -- @param a --- The alpha channel of the color.
    SetBGColorEx: function(self, r: number, g: number, b: number, a: number)

    --- Sets the position of the caret (or text cursor) in a text-based panel object.
    -- @param offset --- Caret position/offset from the start of text. A value of `0` places the caret before the first character.
    SetCaretPos: function(self, offset: number)

    --- **WARNING**: This function does not exist on all panels
    --- **WARNING**: This function cannot interact with serverside convars unless you are host
    --- **NOTE**: Blocked convars will not work with this, see Blocked ConCommands
    --- Sets this panel's convar. When the convar changes this panel will update automatically.
    --- For developer implementation, see Global.Derma_Install_Convar_Functions.
    -- @param convar --- The console variable to check.
    SetConVar: function(self, convar: string)

    --- Sets the alignment of the contents.
    --- **NOTE**: This function only works on Label panels and its derivatives.
    --- **NOTE**: This function doesnt work, if Panel:SetWrap is true.
    -- @param alignment --- The direction of the content, based on the number pad.
    --- ``: **bottom-left**
    --- ``: **bottom-center**
    --- ``: **bottom-right**
    --- ``: **middle-left**
    --- ``: **center**
    --- ``: **middle-right**
    --- ``: **top-left**
    --- ``: **top-center**
    --- ``: **top-right**
    SetContentAlignment: function(self, alignment: number)

    --- Stores a string in the named cookie using Panel:GetCookieName as prefix.
    --- You can also retrieve and modify this cookie by using the cookie. Cookies are stored in this format:
    --- ```
    --- panelCookieName.cookieName
    --- ```
    --- **WARNING**: The panel's cookie name MUST be set for this function to work. See Panel:SetCookieName.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L226-L233)
    -- @param cookieName --- The unique name used to retrieve the cookie later.
    -- @param value --- The value to store in the cookie. This can be retrieved later as a string or number.
    SetCookie: function(self, cookieName: string, value: string)

    --- Sets the panel's cookie name. Calls PANEL:LoadCookies if defined.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L187-L197)
    -- @param name --- The panel's cookie name. Used as prefix for Panel:SetCookie, therefore should be a unique value.
    SetCookieName: function(self, name: string)

    --- Sets the appearance of the cursor. You can find a list of all available cursors with image previews [here](https://wiki.facepunch.com/gmod/Cursors).
    -- @param cursor --- The cursor to be set. Can be one of the following:
    --- * [arrow](https://wiki.facepunch.com/gmod/Cursors#:~:text=arrow)
    --- * [beam](https://wiki.facepunch.com/gmod/Cursors#:~:text=beam)
    --- * [hourglass](https://wiki.facepunch.com/gmod/Cursors#:~:text=hourglass)
    --- * [waitarrow](https://wiki.facepunch.com/gmod/Cursors#:~:text=waitarrow)
    --- * [crosshair](https://wiki.facepunch.com/gmod/Cursors#:~:text=crosshair)
    --- * [up](https://wiki.facepunch.com/gmod/Cursors#:~:text=up)
    --- * [sizenwse](https://wiki.facepunch.com/gmod/Cursors#:~:text=sizenwse)
    --- * [sizenesw](https://wiki.facepunch.com/gmod/Cursors#:~:text=sizenesw)
    --- * [sizewe](https://wiki.facepunch.com/gmod/Cursors#:~:text=sizewe)
    --- * [sizens](https://wiki.facepunch.com/gmod/Cursors#:~:text=sizens)
    --- * [sizeall](https://wiki.facepunch.com/gmod/Cursors#:~:text=sizeall)
    --- * [no](https://wiki.facepunch.com/gmod/Cursors#:~:text=no)
    --- * [hand](https://wiki.facepunch.com/gmod/Cursors#:~:text=hand)
    --- * [blank](https://wiki.facepunch.com/gmod/Cursors#:~:text=blank)
    --- Set to anything else to set it to "none", the default fallback. Do note that a value of "none" does not, as one might assume, result in no cursor being drawn - hiding the cursor requires a value of "blank" instead.
    SetCursor: function(self, cursor: string)

    --- Sets the drag parent.
    --- Drag parent means that when we start to drag this panel, we'll really start dragging the defined parent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L331-L333)
    -- @param parent --- The panel to set as drag parent.
    SetDragParent: function(self, parent: GPanel)

    --- Sets the visibility of the language selection box when typing in non-English mode.
    --- See Panel:SetDrawLanguageIDAtLeft for a function that changes the position of the language selection box.
    -- @param visible --- true to make it visible, false to hide it.
    SetDrawLanguageID: function(self, visible: boolean)

    --- Sets where to draw the language selection box.
    --- See Panel:SetDrawLanguageID for a function that hides or shows the language selection box.
    -- @param left --- true = left, false = right
    SetDrawLanguageIDAtLeft: function(self, left: boolean)

    --- Makes the panel render in front of all others, including the spawn menu and main menu.
    --- Priority is given based on the last call, so of two panels that call this method, the second will draw in front of the first.
    --- **NOTE**: This only makes the panel **draw** above other panels. If there's another panel that would have otherwise covered it, users will not be able to interact with it.
    --- Completely disregards PANEL:ParentToHUD.
    --- **WARNING**: This does not work when using PANEL:SetPaintedManually or PANEL:PaintAt.
    -- @param drawOnTop --- Whether or not to draw the panel in front of all others.
    SetDrawOnTop: function(self, drawOnTop: boolean)

    --- Sets the target area for dropping when an object is being dragged around this panel using the dragndrop.
    --- This draws a target box of the specified size and position, until Panel:DragHoverEnd is called. It uses Panel:DrawDragHover to draw this area.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L468-L485)
    -- @param x --- The x coordinate of the top-left corner of the drop area.
    -- @param y --- The y coordinate of the top-left corner of the drop area.
    -- @param width --- The width of the drop area.
    -- @param height --- The height of the drop area.
    SetDropTarget: function(self, x: number, y: number, width: number, height: number)

    --- Sets the enabled state of a panel object that supports being disabled, such as a DButton or DTextEntry.
    --- Disabled panels cannot be interacted with, and have a different appearance to indicate this.
    --- See Panel:IsEnabled for a function that retrieves the "enabled" state of a panel.
    -- @param enable --- Whether to enable or disable the panel object.
    SetEnabled: function(self, enable: boolean)

    --- Adds a shadow falling to the bottom right corner of the panel's text.
    --- **NOTE**: This works only on  panels that derive from Label.
    -- @param distance --- The distance of the shadow from the panel.
    -- @param Color --- The color of the shadow. Uses the Color.
    SetExpensiveShadow: function(self, distance: number, Color: table)

    --- Sets the foreground color of a panel.
    --- For a Label or RichText, this is the color of its text.
    --- This function calls Panel:SetFGColorEx internally.
    --- Please note that for most panels the engine will overwrite the foreground and background colors a frame after panel creation via the PANEL:ApplySchemeSettings hook, so you may want to set the color in that hook instead.
    --- See Panel:SetBGColor for the background color.
    --- **NOTE**: This doesn't apply to all VGUI elements (such as DLabel) and its function varies between them
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L18-L26)
    -- @param r or color --- The red channel of the color, or a Color. If you pass the latter, the following three arguments are ignored.
    -- @param g --- The green channel of the color.
    -- @param b --- The blue channel of the color.
    -- @param a --- The alpha channel of the color.
    SetFGColor: function(self, r_or_color: number, g: number, b: number, a: number)

    --- **INTERNAL**:
    --- Sets the foreground color of the panel.
    --- For labels, this is the color of their text.
    -- @param r --- The red channel of the color.
    -- @param g --- The green channel of the color.
    -- @param b --- The blue channel of the color.
    -- @param a --- The alpha channel of the color.
    SetFGColorEx: function(self, r: number, g: number, b: number, a: number)

    --- Sets the panel that owns this FocusNavGroup to be the root in the focus traversal hierarchy. This function will only work on EditablePanel class panels and its derivatives.
    --- **NOTE**: Child panels that should be part of the tab navigation need Panel:SetTabPosition called on them.
    -- @param state ---
    SetFocusTopLevel: function(self, state: boolean)

    --- Sets the font used to render this panel's text. This works for Label, TextEntry and RichText, but it's a better idea to use their local `SetFont` (DTextEntry:SetFont, DLabel:SetFont) methods when available.
    --- To retrieve the font used by a panel, call Panel:GetFont.
    -- @param fontName --- The name of the font.
    --- See here for a list of existing fonts.
    --- Alternatively, use surface.CreateFont to create your own custom font.
    SetFontInternal: function(self, fontName: string)

    --- Allows you to set HTML code within a panel.
    -- @param HTML --- The HTML code to set.
    SetHTML: function(self, HTML: string)

    --- Sets the height of the panel.
    --- Calls PANEL:OnSizeChanged and marks this panel for layout (Panel:InvalidateLayout).
    --- Automatically rounds the height down
    --- See also Panel:SetSize.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L45-L47)
    -- @param height --- The height to be set.
    SetHeight: function(self, height: number)

    --- @deprecated
    --- **DEPRECATED**: Alias of Panel:SetKeyboardInputEnabled
    --- Enables or disables the keyboard input for the panel.
    -- @param keyboardInput --- Whether to enable or disable keyboard input.
    SetKeyBoardInputEnabled: function(self, keyboardInput: boolean)

    --- Allows or disallows the panel to receive keyboard focus and input. This is recursively applied to all children.
    -- @param enable --- Whether keyboard input should be enabled for this panel.
    SetKeyboardInputEnabled: function(self, enable: boolean)

    --- Sets the height of a single line of a RichText panel.
    -- @return height --- The new line height. Values below zero mean no override.
    SetLineHeight: function(self): number

    --- Sets the maximum character count this panel should have.
    --- This function will only work on RichText and TextEntry panels and their derivatives.
    -- @param maxChar --- The new maximum amount of characters this panel is allowed to contain.
    SetMaximumCharCount: function(self, maxChar: number)

    --- Sets the minimum dimensions of the panel or object.
    --- You can restrict either or both values.
    --- Calling the function without arguments will remove the minimum size.
    -- @param minW --- The minimum width of the object.
    -- @param minH --- The minimum height of the object.
    SetMinimumSize: function(self, minW: number, minH: number)

    --- Sets the model to be displayed by SpawnIcon.
    --- **NOTE**: This must be called after setting size if you wish to use a different size spawnicon
    -- @param ModelPath --- The path of the model to set
    -- @param skin --- The skin to set
    -- @param bodygroups --- The body groups to set. Each single-digit number in the string represents a separate bodygroup, **This argument must be 9 characters in total**.
    --SetModel: function(self, ModelPath: string, skin: number, bodygroups: string)

    --- Enables or disables the mouse input for the panel.
    --- **NOTE**: Panels parented to the context menu will not be clickable unless Panel:SetKeyboardInputEnabled is enabled or Panel:MakePopup has been called. If you want the panel to have mouse input but you do not want to prevent players from moving, set Panel:SetKeyboardInputEnabled to false immediately after calling Panel:MakePopup.
    -- @param mouseInput --- Whenever to enable or disable mouse input.
    SetMouseInputEnabled: function(self, mouseInput: boolean)

    --- Enables or disables the multi-line functionality of TextEntry panel and its derivatives.
    -- @param multiline --- Whether to enable multiline or not.
    SetMultiline: function(self, multiline: boolean)

    --- Sets the internal name of the panel. Can be retrieved with Panel:GetName.
    -- @param name --- The new name of the panel.
    SetName: function(self, name: string)



    --- Sets whether the default background of the panel should be drawn or not. It's color is usually set by Panel:SetBGColor.
    -- @param paintBackground --- Whether to draw the background or not.
    SetPaintBackgroundEnabled: function(self, paintBackground: boolean)

    --- Sets whether the default border of the panel should be drawn or not.
    -- @param paintBorder --- Whether to draw the border or not.
    SetPaintBorderEnabled: function(self, paintBorder: boolean)

    --- Enables or disables painting of the panel manually with Panel:PaintManual.
    -- @param paintedManually --- True if the panel should be painted manually.
    SetPaintedManually: function(self, paintedManually: boolean)

    --- Sets the parent of the panel.
    --- **NOTE**: Panels parented to the context menu will not be clickable unless Panel:SetMouseInputEnabled and Panel:SetKeyboardInputEnabled are both true or Panel:MakePopup has been called. If you want the panel to have mouse input but you do not want to prevent players from moving, set Panel:SetKeyboardInputEnabled to false immediately after calling Panel:MakePopup.
    -- @param parent --- The new parent of the panel.
    SetParent: function(self, parent: GPanel)

    --- Used by AvatarImage to load an avatar for given player.
    -- @param player --- The player to use avatar of.
    -- @param size --- The size of the avatar to use. Acceptable sizes are `32`, `64`, `184`. Non matching sizes will be clamped down to the highest valid number.
    SetPlayer: function(self, player: GPlayer, size: number)

    --- If this panel object has been made a popup with Panel:MakePopup, this method will prevent it from drawing in front of other panels when it receives input focus.
    -- @param stayAtBack --- If `true`, the popup panel will not draw in front of others when it gets focus, for example when it is clicked.
    SetPopupStayAtBack: function(self, stayAtBack: boolean)

    --- Sets the position of the panel's top left corner.
    --- This will trigger PANEL:PerformLayout. You should avoid calling this function in PANEL:PerformLayout to avoid infinite loops.
    --- See also Panel:SetX and Panel:SetY.
    --- **NOTE**: If you wish to position and re-size panels without much guesswork and have them look good on different screen resolutions, you may find Panel:Dock useful
    -- @param posX --- The x coordinate of the position.
    -- @param posY --- The y coordinate of the position.
    SetPos: function(self, posX: number, posY: number)

    --- Sets whenever the panel should be rendered in a screenshot. (`jpeg` or `screenshot` commands, Camera SWEP)
    -- @param renderInScreenshot --- Whether to render in the screenshot or not.
    SetRenderInScreenshots: function(self, renderInScreenshot: boolean)

    --- Sets whether the panel object can be selected or not (like icons in the Spawn Menu, holding ``). If enabled, this will affect the function of a DButton whilst `` is pressed. Panel:SetSelected can be used to select/deselect the object.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L23-L27)
    -- @param selectable --- Whether the panel object should be selectable or not.
    SetSelectable: function(self, selectable: boolean)

    --- Sets the selected state of a selectable panel object. This functionality is set with Panel:SetSelectable and checked with Panel:IsSelectable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L47-L57)
    -- @param selected --- Whether the object should be selected or deselected. Panel:IsSelected can be used to determine the selected state of the object.
    SetSelected: function(self, selected: boolean)

    --- Enables the panel object for selection (much like the spawn menu).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L10-L15)
    -- @param set --- Whether to enable selection.
    SetSelectionCanvas: function(self, set: boolean)

    --- Sets the size of the panel.
    --- Calls PANEL:OnSizeChanged and marks this panel for layout (Panel:InvalidateLayout).
    --- Automatically rounds the width and height down
    --- See also Panel:SetWidth and Panel:SetHeight.
    --- **NOTE**: If you wish to position and re-size panels without much guesswork and have them look good on different screen resolutions, you may find Panel:Dock useful
    -- @param width --- The width of the panel.
    -- @param height --- The height of the panel.
    SetSize: function(self, width: number, height: number)

    --- Sets the derma skin that the panel object will use, and refreshes all panels with derma.RefreshSkins.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L364-L373)
    -- @param skinName --- The name of the skin to use. The default derma skin is `Default`.
    SetSkin: function(self, skinName: string)

    --- Sets the `.png` image to be displayed on a  SpawnIcon or the panel it is based on - ModelImage.
    --- Only `.png` images can be used with this function.
    -- @param icon --- A path to the .png material, for example one of the Silkicons shipped with the game.
    SetSpawnIcon: function(self, icon: string)

    --- Used by AvatarImage panels to load an avatar by its 64-bit Steam ID (community ID).
    -- @param steamid --- The 64bit SteamID of the player to load avatar of
    -- @param size --- The size of the avatar to use. Acceptable sizes are 32, 64, 184.
    SetSteamID: function(self, steamid: string, size: number)

    --- When TAB is pressed, the next selectable panel in the number sequence is selected.
    --- **NOTE**: This function requires Panel:SetFocusTopLevel to be called on the parent panel for tab navigation to work.
    -- @param position ---
    SetTabPosition: function(self, position: number)

    --- Sets height of a panel. An alias of Panel:SetHeight.
    -- @param height --- Desired height to set
    SetTall: function(self, height: number)

    --- Removes the panel after given time in seconds.
    --- **NOTE**: This function will not work if PANEL:AnimationThink is overridden, unless Panel:AnimationThinkInternal is called every frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L10-L15)
    -- @param delay --- Delay in seconds after which the panel should be removed.
    SetTerm: function(self, delay: number)

    --- Sets the text value of a panel object containing text, such as a Label, TextEntry or  RichText and their derivatives, such as DLabel, DTextEntry or DButton.
    --- **WARNING**: When used on a Label or its derivatives ( DLabel and DButton ), it will automatically call Panel:InvalidateLayout, meaning that you should avoid running this function every frame on these panels to avoid unnecessary performance loss.
    --- **WARNING**: Label & its derivatives has hard length limit, maximum 1023 ascii characters.
    -- @param text --- The text value to set.
    SetText: function(self, text: string)

    --- Makes TextEntry's text be replaced by `*` characters, just like a password-entry text field would.
    -- @param  --- Whether to have the text be hidden.
    SetTextHidden: function(self, _: boolean)

    --- Sets the left and top text margins of a text-based panel object, such as a DButton or DLabel.
    -- @param insetX --- The left margin for the text, in pixels. This will only affect centered text if the margin is greater than its x-coordinate.
    -- @param insetY --- The top margin for the text, in pixels.
    SetTextInset: function(self, insetX: number, insetY: number)

    --- Sets text selection colors of a RichText element.
    -- @param textColor --- The Global.Color to set for selected text.
    -- @param backgroundColor --- The Global.Color to set for selected text background.
    SetTextSelectionColors: function(self, textColor: table, backgroundColor: table)

    --- Sets the height of a RichText element to accommodate the text inside.
    --- **NOTE**: This function internally relies on Panel:GetNumLines, so it should be called at least a couple frames after modifying the text using Panel:AppendText
    SetToFullHeight: function(self)

    --- Sets the tooltip to be displayed when a player hovers over the panel object with their cursor.
    --- By default, DTooltip will be used. Panel:SetTooltipPanelOverride can be used to override the tooltip panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L301-L303)
    -- @param str --- The text to be displayed in the tooltip. Set `nil` to disable it.
    SetTooltip: function(self, str: string)

    --- Sets the tooltip delay. (time between hovering over the panel, and the tooltip showing up)
    --- Can be retrieved with Panel:GetTooltipDelay.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L323-L325)
    -- @param tooltip --- The tooltip delay to set.
    SetTooltipDelay: function(self, tooltip: number)

    --- Sets the panel to be displayed as contents of a DTooltip when a player hovers over the panel object with their cursor. See Panel:SetTooltipPanelOverride if you are looking to override DTooltip itself.
    --- **NOTE**: Panel:SetTooltip will override this functionality.
    --- **WARNING**: Calling this from PANEL:OnCursorEntered is too late! The tooltip will not be displayed or be updated.
    --- Given panel or the previously set one will **NOT** be automatically removed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L309-L312)
    -- @param tooltipPanel --- The panel to use as the tooltip.
    SetTooltipPanel: function(self, tooltipPanel: GPanel)

    --- Sets the panel class to be created instead of DTooltip when the player hovers over this panel and a tooltip needs creating.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L316-L318)
    -- @param override --- The panel class to override the default DTooltip. The new panel class must have the following methods:
    --- * SetText - If you are using Panel:SetTooltip.
    --- * SetContents - If you are using Panel:SetTooltipPanel.
    --- * OpenForPanel - A "hook" type function that gets called shortly after creation (and after the above 2) to open and position the tooltip. You can see this logic in `lua/includes/util/tooltips.lua`.
    SetTooltipPanelOverride: function(self, override: string)

    --- Sets the URL of a link-based panel such as DLabelURL.
    -- @param url --- The URL to set. It **must** begin with either `http://` or `https://`.
    SetURL: function(self, url: string)

    --- Sets the underlined font for use by clickable text in a RichText. See also Panel:InsertClickableTextStart
    --- This function will only work on RichText panels.
    -- @param fontName --- The name of the font.
    --- See here for a list of existing fonts.
    --- Alternatively, use surface.CreateFont to create your own custom font.
    SetUnderlineFont: function(self, fontName: string)

    --- Sets the visibility of the vertical scrollbar.
    --- Works for RichText and TextEntry.
    -- @param display --- True to display the vertical text scroll bar, false to hide it.
    SetVerticalScrollbarEnabled: function(self, display: boolean)

    --- Sets the "visibility" of the panel.
    -- @param visible --- The visibility of the panel.
    SetVisible: function(self, visible: boolean)

    --- Sets width of a panel. An alias of Panel:SetWidth.
    -- @param width --- Desired width to set
    SetWide: function(self, width: number)

    --- Sets the width of the panel.
    --- Calls PANEL:OnSizeChanged and marks this panel for layout (Panel:InvalidateLayout).
    --- Automatically rounds the width down
    --- See also Panel:SetSize.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L53-L55)
    -- @param width --- The new width of the panel.
    SetWidth: function(self, width: number)

    --- This makes it so that when you're hovering over this panel you can "click" on the world. Your weapon aim (and its viewmodel) will follow the cursor. This is primarily used for the Sandbox context menu.
    -- @param enable --- Whether to enable or disable the feature for this panel.
    SetWorldClicker: function(self, enable: boolean)

    --- Sets whether text wrapping should be enabled or disabled on Label and DLabel panels.
    --- Use DLabel:SetAutoStretchVertical to automatically correct vertical size; Panel:SizeToContents will not set the correct height.
    -- @param wrap --- `True` to enable text wrapping, `false` otherwise.
    SetWrap: function(self, wrap: boolean)

    --- Sets the X position of the panel.
    --- Uses Panel:SetPos internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L70-L72)
    -- @param x --- The X coordinate of the position.
    SetX: function(self, x: number)

    --- Sets the Y position of the panel.
    --- Uses Panel:SetPos internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L73-L75)
    -- @param y --- The Y coordinate of the position.
    SetY: function(self, y: number)

    --- Sets the panels z position which determines the rendering order.
    --- Panels with lower z positions appear behind panels with higher z positions.
    --- This also controls in which order panels docked with Panel:Dock appears.
    -- @param zIndex --- The z position of the panel.
    --- Can't be lower than -32768 or higher than 32767.
    SetZPos: function(self, zIndex: number)

    --- Makes a panel visible.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L602-L604)
    Show: function(self)

    --- Uses animation to resize the panel to the specified size.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L182-L197)
    -- @param sizeW --- The target width of the panel. Use -1 to retain the current width.
    -- @param sizeH --- The target height of the panel. Use -1 to retain the current height.
    -- @param time --- The time to perform the animation within.
    -- @param delay --- The delay before the animation starts.
    -- @param ease --- Easing of the start and/or end speed of the animation. See Panel:NewAnimation for how this works.
    -- @param callback --- The function to be called once the animation finishes.
    --- <callback>
    --- <arg type="table" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    SizeTo: function(self, sizeW: number, sizeH: number, time: number, delay: number, ease: number, callback: function)

    --- Resizes the panel to fit the bounds of its children.
    --- **NOTE**: Your panel must have its layout updated (Panel:InvalidateLayout) for this function to work properly.
    --- **NOTE**: The sizeW and sizeH parameters are false by default. Therefore, calling this function with no arguments will result in a no-op.
    -- @param sizeW --- Resize with width of the panel.
    -- @param sizeH --- Resize the height of the panel.
    SizeToChildren: function(self, sizeW: boolean, sizeH: boolean)

    --- Resizes the panel so that its width and height fit all of the content inside.
    --- **NOTE**: Only works on Label derived panels such as DLabel by default, and on any panel that manually implemented the Panel:SizeToContents method, such as DNumberWang and DImage.
    --- **WARNING**: You must call this function **AFTER** setting text/font, adjusting child panels or otherwise altering the panel.
    SizeToContents: function(self)

    --- Resizes the panel object's width to accommodate all child objects/contents.
    --- Only works on Label derived panels such as DLabel by default, and on any panel that manually implemented Panel:GetContentSize method.
    --- **NOTE**: You must call this function **AFTER** setting text/font or adjusting child panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L342-L349)
    -- @param addVal --- The number of extra pixels to add to the width. Can be a negative number, to reduce the width.
    SizeToContentsX: function(self, addVal: number)

    --- Resizes the panel object's height to accommodate all child objects/contents.
    --- Only works on Label derived panels such as DLabel by default, and on any panel that manually implemented Panel:GetContentSize method.
    --- **NOTE**: You must call this function **AFTER** setting text/font or adjusting child panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L330-L337)
    -- @param addVal --- The number of extra pixels to add to the height.
    SizeToContentsY: function(self, addVal: number)

    --- Slides the panel in from above.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L216-L224)
    -- @param Length --- Time to complete the animation.
    SlideDown: function(self, Length: number)

    --- Slides the panel out to the top.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L202-L211)
    -- @param Length --- Time to complete the animation.
    SlideUp: function(self, Length: number)

    --- Begins a box selection, enables mouse capture for the panel object, and sets the start point of the selection box to the mouse cursor's position, relative to this object. For this to work, either the object or its parent must be enabled as a selection canvas. This is set using Panel:SetSelectionCanvas.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L134-L160)
    StartBoxSelection: function(self)

    --- Stops all panel animations by clearing its animation list. This also clears all delayed animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L78-L82)
    Stop: function(self)

    --- Stops the loading of the HTML panel's current page.
    StopLoading: function(self)

    --- Resizes the panel object's height so that its bottom is aligned with the top of the passed panel. An offset greater than zero will reduce the panel's height to leave a gap between it and the passed panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L146-L146)
    -- @param tgtPanel --- The panel to align the bottom of this one with.
    -- @param offset --- The gap to leave between this and the passed panel. Negative values will cause the panel's height to increase, forming an overlap.
    StretchBottomTo: function(self, tgtPanel: GPanel, offset: number)

    --- Resizes the panel object's width so that its right edge is aligned with the left of the passed panel. An offset greater than zero will reduce the panel's width to leave a gap between it and the passed panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L145-L145)
    -- @param tgtPanel --- The panel to align the right edge of this one with.
    -- @param offset --- The gap to leave between this and the passed panel. Negative values will cause the panel's width to increase, forming an overlap.
    StretchRightTo: function(self, tgtPanel: GPanel, offset: number)

    --- Sets the dimensions of the panel to fill its parent. It will only stretch in directions that aren't nil.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L80-L103)
    -- @param offsetLeft --- The left offset to the parent.
    -- @param offsetTop --- The top offset to the parent.
    -- @param offsetRight --- The right offset to the parent.
    -- @param offsetBottom --- The bottom offset to the parent.
    StretchToParent: function(self, offsetLeft: number, offsetTop: number, offsetRight: number, offsetBottom: number)

    --- Toggles the selected state of a selectable panel object. This functionality is set with Panel:SetSelectable and checked with Panel:IsSelectable. To check whether the object is selected or not, Panel:IsSelected is used.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L29-L33)
    ToggleSelection: function(self)

    --- Toggles the visibility of a panel and all its children.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L418-L420)
    ToggleVisible: function(self)

    --- Restores the last saved state (caret position and the text inside) of a TextEntry. Should act identically to pressing CTRL+Z in a TextEntry.
    --- See also Panel:SaveUndoState.
    Undo: function(self)

    --- Recursively deselects this panel object and all of its children. This will cascade to all child objects at every level below the parent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L35-L43)
    UnselectAll: function(self)

    --- Forcibly updates the panels' HTML Material, similar to when Paint is called on it.
    --- This is only useful if the panel is not normally visible, i.e the panel exists purely for its HTML Material.
    --- **NOTE**: Only works on with panels that have a HTML Material. See Panel:GetHTMLMaterial for more details.
    --- **NOTE**: A good place to call this is in the GM:PreRender hook
    UpdateHTMLTexture: function(self)

    --- @deprecated
    --- **DEPRECATED**: Use Panel:IsValid instead.
    --- Returns if a given panel is valid or not.
    -- @return --- Whether the panel is valid or not, true being it is, false being it isn't.
    Valid: function(self): boolean
end


--- This is a list of all methods only available for NPCs. It is also possible to call Entity functions on NPCs.
global interface GNPC is GEntity
    where self:IsNPC()
    --- Makes the NPC like, hate, feel neutral towards, or fear the entity in question. If you want to setup relationship towards a certain entity `class`, use NPC:AddRelationship.
    --- **NOTE**: NPCs do not see NextBots by default. This can be fixed by adding the FL_OBJECT flag to the NextBot.
    -- @param target --- The entity for the relationship to be applied to.
    -- @param disposition --- A Enums/D representing the relationship type.
    -- @param priority --- How strong the relationship is. Higher values mean higher priority over relationships with lower priority.
    AddEntityRelationship: function(self, target: GEntity, disposition: number, priority: number)

    --- Changes how an NPC feels towards another NPC.  If you want to setup relationship towards a certain `entity`, use NPC:AddEntityRelationship.
    --- **WARNING**: Avoid using this in GM:OnEntityCreated to prevent crashing due to infinite loops. This function may create an entity with given class and delete it immediately after.
    -- @param relationstring --- A string representing how the relationship should be set up.
    --- Should be formatted as `"npc_class `Enums/D` numberPriority"`.
    AddRelationship: function(self, relationstring: string)

    --- Advances the NPC on its path to the next waypoint.
    --- **WARNING**: Calling this on an NPC without any route will result in an instant crash.
    AdvancePath: function(self)

    --- Force an NPC to play their Alert sound.
    AlertSound: function(self)

    --- Executes any movement the current sequence may have.
    -- @param interval --- This is a good place to use Entity:GetAnimTimeInterval.
    -- @param target ---
    -- @return --- `true` if any movement was performed.
    AutoMovement: function(self, interval: number, target: GEntity): boolean

    --- Become a ragdoll and remove the entity. Internally handles serverside/clientside ragdoll creation, momentum calculation, triggering ragdoll creation hooks / events and cloning entity's bone transforms to the created ragdoll.
    -- @param info --- Damage info passed from an onkilled event
    -- @return --- The created serverside ragdoll, nil if failed or a clientside ragdoll created.
    BecomeRagdoll: function(self, info: GCTakeDamageInfo): GEntity

    --- Adds a capability to the NPC.
    -- @param capabilities --- Capabilities to add, see Enums/CAP.
    CapabilitiesAdd: function(self, capabilities: E_CAP)

    --- Removes all of Capabilities the NPC has.
    CapabilitiesClear: function(self)

    --- Returns the NPC's capabilities along the ones defined on its weapon.
    -- @return --- The capabilities as a bitflag.
    --- See Enums/CAP
    CapabilitiesGet: function(self): E_CAP

    --- Checks whether the NPC has the specified capabilities.
    -- @param capabilities --- Capabilities to check, see Enums/CAP.
    CapabilitiesHas: function(self, capabilities: E_CAP)

    --- Remove a certain capability.
    -- @param capabilities --- Capabilities to remove, see Enums/CAP
    CapabilitiesRemove: function(self, capabilities: number)

    --- Returns the NPC relationship class. This is mostly used to tell NPCs who should be attacking who.
    --- Do not confuse with Entity:GetClass!
    -- @return --- See Enums/CLASS
    Classify: function(self): E_CLASS

    --- Resets the NPC:GetBlockingEntity.
    ClearBlockingEntity: function(self)

    --- Clears out the specified Enums/COND on this NPC.
    -- @param condition --- The Enums/COND to clear out.
    ClearCondition: function(self, condition: number)

    --- Clears the Enemy from the NPC's memory, effectively forgetting it until met again with either the NPC vision or with NPC:UpdateEnemyMemory.
    -- @param enemy --- The enemy to mark
    ClearEnemyMemory: function(self, enemy: GEntity)

    --- Clears the NPC's current expression which can be set with NPC:SetExpression.
    ClearExpression: function(self)

    --- Clears the current NPC goal or target.
    ClearGoal: function(self)

    --- Stops the current schedule that the NPC is doing.
    ClearSchedule: function(self)

    --- Returns the ID of a given condition by name. Opposite of NPC:ConditionName.
    --- This is useful for custom conditions defined by engine NPCs, such as `COND_ZOMBIE_RELEASECRAB` for zombies, and `COND_COMBINE_ON_FIRE` for Combine Soldiers.
    -- @param conditionName --- The condition name.
    -- @return --- The condition ID, see Enums/COND. Custom conditions will have a "randomly" assigned IDs, which will change with each game session.
    ConditionID: function(self, conditionName: string): number

    --- Translates condition ID to a string. For the opposite process, see NPC:ConditionID.
    -- @param cond --- The NPCs condition ID, see Enums/COND
    -- @return --- A human understandable string equivalent of that condition.
    ConditionName: function(self, cond: number): string

    --- Returns the way the NPC "feels" about a given entity. See NPC:AddEntityRelationship.
    --- **NOTE**: For `ai` type entities, this will return ENTITY:GetRelationship. If it returns `nil` or for engine NPCs, this will return whatever was last set by NPC:AddEntityRelationship. As a last resort, engine will decide on the disposition based on this NPC's NPC:Classify.
    -- @param ent --- The entity to test our disposition towards.
    -- @return --- The NPCs disposition, see Enums/D.
    -- @return --- The NPCs disposition priority.
    Disposition: function(self, ent: GEntity): E_D, number

    --- Forces the NPC to drop the specified weapon.
    -- @param weapon --- Weapon to be dropped. If unset, will default to the currently equipped weapon.
    -- @param target --- If set, launches the weapon at given position. There is a limit to how far it is willing to throw the weapon. Overrides velocity argument.
    -- @param velocity --- If set and previous argument is unset, launches the weapon with given velocity. If the velocity is higher than 400, it will be clamped to 400.
    DropWeapon: function(self, weapon: GWeapon, target: GVector, velocity: GVector)

    --- Makes an NPC exit a scripted sequence, if one is playing.
    ExitScriptedSequence: function(self)

    --- Force an NPC to play its Fear sound.
    FearSound: function(self)

    --- Force an NPC to play its FoundEnemy sound.
    FoundEnemySound: function(self)

    --- Returns the weapon the NPC is currently carrying, or NULL.
    -- @return --- The NPCs current weapon
    GetActiveWeapon: function(self): GEntity

    --- Returns the NPC's current activity.
    -- @return --- Current activity, see Enums/ACT.
    GetActivity: function(self): number

    --- Returns the aim vector of the NPC. NPC alternative of Player:GetAimVector.
    --- **NOTE**: If the NPC has both NPC:GetEnemy and NPC:GetActiveWeapon, engine will automatically call ENTITY:GetAttackSpread to add random spread degrees to the return value.
    -- @return --- The aim direction of the NPC, usually a noisy direction to it's NPC:GetEnemy. This will default to Entity:GetForward when there's no enemy. Thus, NPC:GetCurrentWeaponProficiency will be used.
    GetAimVector: function(self): GVector

    --- Returns the activity to be played when the NPC arrives at its goal
    -- @return --- The arrival activity. See Enums/ACT.
    GetArrivalActivity: function(self): number

    --- Returns the direction from the NPC origin to its current navigational destination.
    -- @return --- The arrival direction.
    GetArrivalDirection: function(self): GVector

    --- Returns NPC arrival distance, set by NPC:SetArrivalDistance.
    -- @return dist --- The current arrival distance.
    GetArrivalDistance: function(self): number

    --- Returns the sequence to be played when the NPC arrives at its goal.
    -- @return --- Sequence ID to be played, or -1 if there's no sequence.
    GetArrivalSequence: function(self): number

    --- Returns NPC arrival speed, set by NPC:SetArrivalSpeed.
    -- @return speed --- The current arrival peed.
    GetArrivalSpeed: function(self): number

    --- Returns the most dangerous/closest sound hint based on the NPCs location and the types of sounds it can sense.
    -- @param types --- The types of sounds to choose from. See SOUND_ enums
    -- @return --- A table with SoundHintData structure or `nil` if no sound hints are nearby.
    GetBestSoundHint: function(self, types: number): table

    --- Returns the entity blocking the NPC along its path.
    -- @return --- Blocking entity
    GetBlockingEntity: function(self): GEntity

    --- Returns the goal type for current navigation path.
    -- @return --- The goal type. See Enums/GOALTYPE.
    GetCurGoalType: function(self): number

    --- Gets the NPC's current waypoint position (where NPC is currently moving towards), if any is available.
    -- @return --- The position of the current NPC waypoint.
    GetCurWaypointPos: function(self): GVector

    --- Returns the NPC's current schedule.
    -- @return --- The NPCs schedule, see Enums/SCHED or -1 if we failed for some reason
    GetCurrentSchedule: function(self): number

    --- Returns how proficient (skilled) an NPC is with its current weapon.
    -- @return --- NPC's proficiency for current weapon. See Enums/WEAPON_PROFICIENCY.
    GetCurrentWeaponProficiency: function(self): number

    --- Returns the entity that this NPC is trying to fight.
    --- **BUG**: [This returns nil if the NPC has no enemy. You should use Global.IsValid (which accounts for nil and NULL) on the return to verify validity of the enemy.](https://github.com/Facepunch/garrysmod-issues/issues/3132
    -- @return --- Enemy NPC.
    GetEnemy: function(self): GNPC

    --- Returns the first time an NPC's enemy was seen by the NPC.
    -- @param enemy --- The enemy to check.
    -- @return time --- First time the given enemy was seen.
    GetEnemyFirstTimeSeen: function(self, enemy: GEntity): number

    --- Returns the last known position of an NPC's enemy.
    --- Similar to NPC:GetEnemyLastSeenPos, but the known position will be a few seconds ahead of the last seen position.
    -- @param enemy --- The enemy to check.
    -- @return pos --- The last known position.
    GetEnemyLastKnownPos: function(self, enemy: GEntity): GVector

    --- Returns the last seen position of an NPC's enemy.
    --- Similar to NPC:GetEnemyLastKnownPos, but the known position will be a few seconds ahead of the last seen position.
    -- @param enemy --- The enemy to check.
    -- @return pos --- The last seen position.
    GetEnemyLastSeenPos: function(self, enemy: GEntity): GVector

    --- Returns the last time an NPC's enemy was seen by the NPC.
    -- @param enemy --- The enemy to check.
    -- @return time --- Last time the given enemy was seen.
    GetEnemyLastTimeSeen: function(self, enemy: GEntity): number

    --- Returns the expression file the NPC is currently playing.
    -- @return m_iszExpressionScene --- The file path of the expression.
    GetExpression: function(self): string

    --- Returns the eye direction of the NPC.
    -- @return --- The eye direction.
    GetEyeDirection: function(self): GVector

    --- Returns the Field Of View of the NPC. See NPC:SetFOV.
    -- @return fov --- The FOV for the NPC in degrees.
    GetFOV: function(self): number

    --- Returns the position we are trying to reach, if any.
    -- @return --- The position we are trying to reach.
    GetGoalPos: function(self): GVector

    --- Returns the entity we are trying to reach, if any.
    -- @return --- The entity we are trying to reach, or `NULL`.
    GetGoalTarget: function(self): GEntity

    --- Returns the 2D head direction of the NPC.
    -- @return --- The head direction.
    GetHeadDirection: function(self): GVector

    --- Returns NPCs hull type set by NPC:SetHullType.
    -- @return --- Hull type, see Enums/HULL
    GetHullType: function(self): number

    --- Returns the ideal activity the NPC currently wants to achieve.
    --- **NOTE**: By default, base NPCs will automatically attempt to play a sequence bound to the ideal activity. To prevent ideal activity from overriding NPC's active sequence, set this to `ACT_DO_NOT_DISTURB`.
    -- @return --- The ideal activity. Enums/ACT.
    GetIdealActivity: function(self): number

    --- Returns the ideal move acceleration of the NPC.
    -- @return --- The ideal move acceleration.
    GetIdealMoveAcceleration: function(self): number

    --- Returns the ideal move speed of the NPC.
    -- @return --- The ideal move speed.
    GetIdealMoveSpeed: function(self): number

    --- Returns the ideal sequence the NPC currently wants to achieve.
    -- @return --- The ideal sequence, specific to the NPCs model.
    GetIdealSequence: function(self): number

    --- Returns the ideal yaw (left right rotation) for this NPC at this moment.
    -- @return --- The ideal yaw.
    GetIdealYaw: function(self): number

    --- Returns all known enemies this NPC has.
    --- See also NPC:GetKnownEnemyCount
    -- @return --- Table of entities that this NPC knows as enemies.
    GetKnownEnemies: function(self): table

    --- Returns known enemy count of this NPC.
    --- See also NPC:GetKnownEnemies
    -- @return --- Amount of entities that this NPC knows as enemies.
    GetKnownEnemyCount: function(self): number

    --- Returns the last registered or memorized position of the NPC. When using scheduling, the NPC will focus on navigating to the last position via nodes.
    --- See NPC:SetLastPosition.
    -- @return position --- Where the NPC's last position was set to.
    GetLastPosition: function(self): GVector

    --- Returns Global.CurTime based time since this NPC last received damage from given enemy. The last damage time is set when NPC:MarkTookDamageFromEnemy is called.
    -- @param enemy --- The enemy to test. Defaults to currently active enemy (NPC:GetEnemy)
    -- @return --- Time since this NPC last received damage from given enemy.
    GetLastTimeTookDamageFromEnemy: function(self, enemy: GEntity): number

    --- Returns NPCs max view distance. An NPC will not be able to see enemies outside of this distance.
    -- @return dist --- The maximum distance the NPC can see at.
    GetMaxLookDistance: function(self): number

    --- Returns how far should the NPC look ahead in its route.
    -- @return --- How far the NPC checks ahead of its route.
    GetMinMoveCheckDist: function(self): number

    --- Returns how far before the NPC can come to a complete stop.
    -- @param minResult  --- The minimum value that will be returned by this function.
    -- @return --- The minimum stop distance.
    GetMinMoveStopDist: function(self, minResult_: number): number

    --- Returns the movement delay for given NPC.
    --- See NPC:SetMoveDelay.
    -- @return --- The movement delay.
    GetMoveDelay: function(self): number

    --- Returns the current timestep the internal NPC motor is working on.
    -- @return --- The current timestep.
    GetMoveInterval: function(self): number

    --- Returns the current move velocity of the NPC.
    -- @return --- The current move velocity of the NPC.
    GetMoveVelocity: function(self): GVector

    --- Returns the NPC's current movement activity.
    -- @return --- Current NPC movement activity, see Enums/ACT.
    GetMovementActivity: function(self): number

    --- Returns the index of the sequence the NPC uses to move.
    -- @return --- The movement sequence index
    GetMovementSequence: function(self): number

    --- Returns the NPC's state.
    -- @return --- The NPC's current state, see Enums/NPC_STATE.
    GetNPCState: function(self): number

    --- Returns the NPC's navigation type.
    -- @return --- The nav type. See Enums/NAV.
    GetNavType: function(self): number

    --- Returns the nearest member of the squad the NPC is in.
    -- @return nearest_member --- The nearest member of the squad the NPC is in.
    GetNearestSquadMember: function(self): GNPC

    --- Gets the NPC's next waypoint position, where NPC will be moving after reaching current waypoint, if any is available.
    -- @return --- The position of the next NPC waypoint.
    GetNextWaypointPos: function(self): GVector

    --- Returns the distance the NPC is from Target Goal.
    -- @return --- The number of hammer units the NPC is away from the Goal.
    GetPathDistanceToGoal: function(self): number

    --- Returns the amount of time it will take for the NPC to get to its Target Goal.
    -- @return --- The amount of time to get to the target goal.
    GetPathTimeToGoal: function(self): number

    --- Returns the shooting position of the NPC, i.e. where their bullets would come from, etc.
    --- If the NPC does not overwrite this, it will return Entity:GetPos.
    -- @return --- The NPC's shooting position.
    GetShootPos: function(self): GVector

    --- Returns the current squad name of the NPC, as set via NPC:SetSquad.
    -- @return name --- The new squad name to set.
    GetSquad: function(self): string

    --- Returns NPC step height.
    -- @return height --- The current step height.
    GetStepHeight: function(self): number

    --- Returns the NPC's current target set by NPC:SetTarget.
    --- **BUG**: [This returns nil if the NPC has no target. You should use Global.IsValid (which accounts for nil and NULL) on the return to verify validity of the target.](https://github.com/Facepunch/garrysmod-issues/issues/3132
    -- @return --- Target entity
    GetTarget: function(self): GEntity

    --- Returns the status of the current task.
    -- @return --- The status. See Enums/TASKSTATUS.
    GetTaskStatus: function(self): number

    --- Returns Global.CurTime based time since the enemy was reacquired, meaning it is currently in Line of Sight of the NPC.
    -- @param enemy --- The enemy to test. Defaults to currently active enemy (NPC:GetEnemy)
    -- @return --- Time enemy was last reacquired.
    GetTimeEnemyLastReacquired: function(self, enemy: GEntity): number

    --- Returns the view offset of the NPC. Set by NPC:SetViewOffset.
    -- @return --- The view offset of the NPC.
    GetViewOffset: function(self): GVector

    --- Returns a specific weapon the NPC owns.
    -- @param class --- A classname of the weapon to try to get.
    -- @return wep --- The weapon for the specified class, or NULL of the NPC doesn't have given weapon.
    GetWeapon: function(self, class: string): GWeapon

    --- Returns a table of the NPC's weapons.
    -- @return --- A list of the weapons the NPC currently has.
    GetWeapons: function(self): {GWeapon}

    --- Used to give a weapon to an already spawned NPC.
    -- @param weapon --- Class name of the weapon to equip to the NPC.
    -- @return --- The weapon entity given to the NPC.
    Give: function(self, weapon: string): GWeapon

    --- Returns whether or not the NPC has the given condition.
    -- @param condition --- The condition index, see Enums/COND.
    -- @return --- True if the NPC has the given condition, false otherwise.
    HasCondition: function(self, condition: number): boolean

    --- Polls the enemy memory to check if the given entity has eluded us or not.
    -- @param enemy --- The enemy to test.
    -- @return eluded --- If the enemy has eluded us.
    HasEnemyEluded: function(self, enemy: GEntity): boolean

    --- Polls the enemy memory to check if the NPC has any memory of given enemy.
    -- @param enemy --- The entity to test.
    -- @return eluded --- If we have any memory on given enemy.
    HasEnemyMemory: function(self, enemy: GEntity): boolean

    --- Returns true if the current navigation has an obstacle, this is different from NPC:GetBlockingEntity, this is for virtual navigation obstacles put by AI's local navigation system to prevent movement to the marked area, forcing NPC to steer around, [for example](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/hl2/npc_playercompanion.cpp#L2897).
    -- @return --- `true` if the current navigation has an obstacle.
    HasObstacles: function(self): boolean

    --- Force an NPC to play their Idle sound.
    IdleSound: function(self)

    --- Makes the NPC ignore given entity/enemy until given time.
    -- @param enemy --- The enemy to ignore.
    -- @param until --- How long to ignore the enemy for. This will be compared to Global.CurTime, so your value should be based on it.
    IgnoreEnemyUntil: function(self, enemy: GEntity, _until: number)

    --- Returns whether the NPC is currently crouching or not. Citizens and Combine Soldiers are capable of this behavior by default.
    -- @return --- Whether the NPC is currently crouching.
    IsCrouching: function(self): boolean

    --- Returns whether the current navigational waypoint is the final one.
    -- @return --- Whether the current navigational waypoint is the final one.
    IsCurWaypointGoal: function(self): boolean

    --- Returns whether or not the NPC is performing the given schedule.
    -- @param schedule --- The schedule number, see Enums/SCHED.
    -- @return --- True if the NPC is performing the given schedule, false otherwise.
    IsCurrentSchedule: function(self, schedule: number): boolean

    --- Returns whether the NPC is facing their ideal yaw. See NPC:SetIdealYaw, NPC:GetIdealYaw and NPC:SetIdealYawAndUpdate.
    -- @return --- Whether the NPC is facing their ideal yaw.
    IsFacingIdealYaw: function(self): boolean

    --- Returns whether the NPC has an active goal.
    -- @return act --- Whether the NPC has an active goal or not.
    IsGoalActive: function(self): boolean

    --- Tests whether a position or an NPC is in the view cone of the NPC.
    -- @param position --- The position to test.
    -- @return --- If the given position is in the view cone.
    IsInViewCone: function(self, position: GVector): boolean

    --- Tests whether a position or an NPC is in the view cone of the NPC.
    -- @param ent --- The entity to test. Will use the entity's position.
    -- @return --- If the given position is in the view cone.
    IsInViewCone: function(self, ent: GEntity): boolean

    --- Returns if the current movement is locked on the Yaw axis.
    -- @return --- Whether the movement is yaw locked or not.
    IsMoveYawLocked: function(self): boolean

    --- Returns whether the NPC is moving or not.
    -- @return --- Whether the NPC is moving or not.
    IsMoving: function(self): boolean

    --- Checks if the NPC is running an **ai_goal**. ( e.g. An npc_citizen NPC following the Player. )
    -- @return --- Returns true if running an ai_goal, otherwise returns false.
    IsRunningBehavior: function(self): boolean

    --- Returns whether the current NPC is the leader of the squad it is in.
    -- @return is_leader --- Whether the NPC is the leader of the squad or not.
    IsSquadLeader: function(self): boolean

    --- Returns the "forgettable" status for a given enemy, as set by NPC:SetUnforgettable, or by internal logic of engine NPCs.
    -- @param enemy --- Enemy entity to check.
    -- @return --- Whether the given enemy is unforgettable (`true`) or not.
    IsUnforgettable: function(self, enemy: GEntity): boolean

    --- Returns true if the entity was remembered as unreachable. The memory is updated automatically from following engine tasks if they failed:
    --- * TASK_GET_CHASE_PATH_TO_ENEMY
    --- * TASK_GET_PATH_TO_ENEMY_LKP
    --- * TASK_GET_PATH_TO_INTERACTION_PARTNER
    --- * TASK_ANTLIONGUARD_GET_CHASE_PATH_ENEMY_TOLERANCE
    --- * SCHED_FAIL_ESTABLISH_LINE_OF_FIRE - Combine NPCs, also when failing to change their enemy
    -- @param testEntity --- The entity to test.
    -- @return --- If the entity is reachable or not.
    IsUnreachable: function(self, testEntity: GEntity): boolean

    --- Force an NPC to play their LostEnemy sound.
    LostEnemySound: function(self)

    --- Tries to achieve our ideal animation state, playing any transition sequences that we need to play to get there.
    MaintainActivity: function(self)

    --- Causes the NPC to temporarily forget the current enemy and switch on to a better one.
    -- @param enemy --- The enemy to mark
    MarkEnemyAsEluded: function(self, enemy: GEntity)

    --- Marks the NPC as took damage from given entity.
    --- See also NPC:GetLastTimeTookDamageFromEnemy.
    -- @param enemy --- The enemy to mark. Defaults to currently active enemy (NPC:GetEnemy)
    MarkTookDamageFromEnemy: function(self, enemy: GEntity)

    --- Executes a climb move.
    --- Related functions are NPC:MoveClimbStart and NPC:MoveClimbStop.
    -- @param destination --- The destination of the climb.
    -- @param dir --- The direction of the climb.
    -- @param distance --- The distance.
    -- @param yaw --- The yaw angle.
    -- @param left --- Amount of climb nodes left?
    -- @return --- The result. See Enums/AIMR.
    MoveClimbExec: function(self, destination: GVector, dir: GVector, distance: number, yaw: number, left: number): E_AIMR

    --- Starts a climb move.
    --- Related functions are NPC:MoveClimbExec and NPC:MoveClimbStop.
    -- @param destination --- The destination of the climb.
    -- @param dir --- The direction of the climb.
    -- @param distance --- The distance.
    -- @param yaw --- The yaw angle.
    MoveClimbStart: function(self, destination: GVector, dir: GVector, distance: number, yaw: number)

    --- Stops a climb move.
    --- Related functions are NPC:MoveClimbExec and NPC:MoveClimbStart.
    MoveClimbStop: function(self)

    --- Similar to other `NPC:Move*` functions, invokes internal code to move the NPC to a given location.
    --- Meant to be used within ENTITY:OverrideMove.
    -- @param pos --- The position we want to reach.
    -- @param targetEntity --- Used to test whether we hit the move target when deciding success.
    -- @param yaw --- Target Yaw angle at the end of the move. -1 to keep original yaw.
    -- @param asFarAsCan --- Whether to move as far as possible.
    -- @param testZ --- Also test the Z axis of the target position and NPC position to decide success.
    -- @return --- Whether the movement succeeded or not.
    --- `AIMotorMoveResult_t` enum:
    --- * AIM_FAILED = 0
    --- * AIM_SUCCESS = 1
    --- * AIM_PARTIAL_HIT_NPC = 2
    --- * AIM_PARTIAL_HIT_WORLD = 3
    --- * AIM_PARTIAL_HIT_TARGET = 4
    MoveGroundStep: function(self, pos: GVector, targetEntity: GEntity, yaw: number, asFarAsCan: boolean, testZ: boolean): number

    --- Executes a jump move.
    --- Related functions are NPC:MoveJumpStart and NPC:MoveJumpStop.
    -- @return --- The result. See Enums/AIMR.
    MoveJumpExec: function(self): E_AIMR

    --- Starts a jump move.
    --- Related functions are NPC:MoveJumpExec and NPC:MoveJumpStop.
    -- @param vel --- The jump velocity.
    MoveJumpStart: function(self, vel: GVector)

    --- Stops a jump move.
    --- Related functions are NPC:MoveJumpExec and NPC:MoveJumpStart.
    -- @return --- The result. See Enums/AIMR.
    MoveJumpStop: function(self): E_AIMR

    --- Makes the NPC walk toward the given position. The NPC will return to the player after amount of time set by **player_squad_autosummon_time** ConVar.
    --- Only works on Citizens (npc_citizen) and is a part of the Half-Life 2 squad system.
    --- The NPC **must** be in the player's squad for this to work.
    -- @param position --- The target position for the NPC to walk to.
    MoveOrder: function(self, position: GVector)

    --- Pauses the NPC movement?
    --- Related functions are NPC:MoveStart, NPC:MoveStop and NPC:ResetMoveCalc.
    MovePause: function(self)

    --- Starts NPC movement?
    --- Related functions are NPC:MoveStop, NPC:MovePause and NPC:ResetMoveCalc.
    MoveStart: function(self)

    --- Stops the NPC movement?
    --- Related functions are NPC:MoveStart, NPC:MovePause and NPC:ResetMoveCalc.
    MoveStop: function(self)

    --- Picks random node around given vector, around specified length, using dir as search direction start. Works similarly to NPC:NavSetRandomGoal, but you can decide any position you want as a search starting point rather than your NPC.
    -- @param pos --- The origin to calculate a path from.
    -- @param length --- The target length of the path to calculate.
    -- @param dir --- The direction in which to look for a new path end goal.
    -- @return --- Whether path generation was successful or not.
    NavSetGoal: function(self, pos: GVector, length: number, dir: GVector): boolean

    --- Creates a path to closest node at given position. This won't actually force the NPC to move.
    --- **NOTE**: This will call either NPC:TaskComplete or NPC:TaskFail for the current schedule and task, forcing the current task to progress to next task or fail.
    --- See also NPC:NavSetRandomGoal.
    -- @param pos --- The position to calculate a path to.
    -- @return --- Whether path generation was successful or not.
    NavSetGoalPos: function(self, pos: GVector): boolean

    --- Set the goal target for an NPC.
    --- This will call either NPC:TaskComplete or NPC:TaskFail for the current schedule and task, forcing the current task to progress to next task or fail.
    -- @param target --- The targeted entity to set the goal to.
    -- @param offset --- The offset to apply to the targeted entity's position.
    -- @return --- Whether path generation was successful or not
    NavSetGoalTarget: function(self, target: GEntity, offset: GVector): boolean

    --- Creates a random path of specified minimum length between a closest start node and random node in the specified direction. This won't actually force the NPC to move.
    -- @param minPathLength --- Minimum length of path in units
    -- @param dir --- Unit vector pointing in the direction of the target random node
    -- @return --- Whether path generation was successful or not
    NavSetRandomGoal: function(self, minPathLength: number, dir: GVector): boolean

    --- Sets a goal in x, y offsets for the NPC to wander to
    -- @param xOffset --- X offset
    -- @param yOffset --- Y offset
    -- @return --- Whether path generation was successful or not
    NavSetWanderGoal: function(self, xOffset: number, yOffset: number): boolean

    --- Forces the NPC to pickup an existing weapon entity. The NPC will not pick up the weapon if they already own a weapon of given type, or if the NPC could not normally have this weapon in their inventory.
    -- @param wep --- The weapon to try to pick up.
    -- @return result --- Whether the NPC succeeded in picking up the weapon or not.
    PickupWeapon: function(self, wep: GWeapon): boolean

    --- Forces the NPC to play a sentence from scripts/sentences.txt
    -- @param sentence --- The sentence string to speak.
    -- @param delay --- Delay in seconds until the sentence starts playing.
    -- @param volume --- The volume of the sentence, from 0 to 1.
    -- @return --- Returns the sentence index, -1 if the sentence couldn't be played.
    PlaySentence: function(self, sentence: string, delay: number, volume: number): number

    --- Makes the NPC remember an entity or an enemy as unreachable, for a specified amount of time. Use NPC:IsUnreachable to check if an entity is still unreachable.
    -- @param ent --- The entity to mark as unreachable.
    -- @param time --- For how long to remember the entity as unreachable. Negative values will act as `3` seconds.
    RememberUnreachable: function(self, ent: GEntity, time: number)

    --- Removes conditions to ignore for the this NPC.
    -- @param conditions --- Ignore conditions to remove, see Enums/COND. If omitted, removes all ignore conditions.
    RemoveIgnoreConditions: function(self, conditions: table)

    --- Resets the ideal activity of the NPC. See also NPC:SetIdealActivity.
    -- @param act --- The new activity. See Enums/ACT.
    ResetIdealActivity: function(self, act: number)

    --- Resets all the movement calculations.
    --- Related functions are NPC:MoveStart, NPC:MovePause and NPC:MoveStop.
    ResetMoveCalc: function(self)

    --- Starts an engine task.
    --- Used internally by the ai_task.
    -- @param taskID --- The task ID, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    -- @param taskData --- The task data.
    RunEngineTask: function(self, taskID: number, taskData: number)

    --- Forces the NPC to switch to a specific weapon the NPC owns. See NPC:GetWeapons.
    -- @param weapon --- A classname of the weapon or a Weapon entity to switch to.
    SelectWeapon: function(self, weapon: string|GWeapon)

    --- Stops any sounds (speech) the NPC is currently palying.
    --- Equivalent to `Entity:EmitSound( "AI_BaseNPC.SentenceStop" )`
    SentenceStop: function(self)

    --- Sets the NPC's current activity.
    -- @param act --- The new activity to set, see Enums/ACT.
    SetActivity: function(self, act: number)

    ---
    -- @param act --- See Enums/ACT.
    SetArrivalActivity: function(self, act: number)

    --- Sets the direction from the NPC origin to its current navigational destination.
    -- @param dir --- The new arrival direction.
    SetArrivalDirection: function(self, dir: GVector)

    --- Sets the distance to goal at which the NPC should stop moving and continue to other business such as doing the rest of their tasks in a schedule.
    -- @param dist --- The distance to goal that is close enough for the NPC
    SetArrivalDistance: function(self, dist: number)

    --- Sets the sequence to be played when the NPC arrives at its goal.
    -- @param seq --- See Entity:LookupSequence.
    SetArrivalSequence: function(self, seq: number)

    --- Sets the arrival speed? of the NPC
    -- @param speed --- The new arrival speed
    SetArrivalSpeed: function(self, speed: number)

    --- Sets an NPC condition.
    -- @param condition --- The condition index, see Enums/COND.
    SetCondition: function(self, condition: E_COND)

    --- Sets the weapon proficiency of an NPC (how skilled an NPC is with its current weapon).
    -- @param proficiency --- The proficiency for the NPC's current weapon. See Enums/WEAPON_PROFICIENCY.
    SetCurrentWeaponProficiency: function(self, proficiency: number)

    --- Sets the target for an NPC.
    -- @param enemy --- The enemy that the NPC should target
    -- @param newenemy --- Calls NPC:SetCondition(COND.NEW_ENEMY) if the new enemy is valid and not equal to the last enemy.
    SetEnemy: function(self, enemy: GEntity, newenemy: boolean)

    --- Sets the NPC's .vcd expression. Similar to Entity:PlayScene except the scene is looped until it's interrupted by default NPC behavior or NPC:ClearExpression.
    -- @param m_iszExpressionScene --- The expression filepath.
    -- @return flDuration --- Default duration of assigned expression, in seconds.
    SetExpression: function(self, m_iszExpressionScene: string): number

    --- Sets the Field Of View of the NPC, for use with such functions as NPC:IsInViewCone. it is also used internally by the NPC for enemy detection, etc.
    -- @param fov --- The new FOV for the NPC in degrees.
    SetFOV: function(self, fov: number)

    --- Forces given NPC to crouch, if it is able to do so. Only Citizens and Combine Soldiers can by default.
    -- @param force --- Whether to force the NPC to crouch or not. `false` clears the "force crouch" flag, but does not guarantee to force the NPC to stand back up.
    SetForceCrouch: function(self, force: boolean)

    --- Updates the NPC's hull and physics hull in order to match its model scale. Entity:SetModelScale seems to take care of this regardless.
    SetHullSizeNormal: function(self)

    --- Sets the hull type for the NPC.
    -- @param hullType --- Hull type. See Enums/HULL
    SetHullType: function(self, hullType: number)

    --- Sets the ideal activity the NPC currently wants to achieve. This is most useful for custom SNPCs.
    -- @param  --- The ideal activity to set. Enums/ACT.
    SetIdealActivity: function(self, _: number)

    --- Sets the ideal sequence the NPC currently wants to achieve. This is most useful for custom SNPCs.
    -- @param sequenceId --- The ideal sequence to set. Entity:LookupSequence.
    SetIdealSequence: function(self, sequenceId: number)

    --- Sets the ideal yaw angle (left-right rotation) for the NPC. Does not actually force the NPC to start turning in that direction. See NPC:UpdateYaw, NPC:GetIdealYaw and NPC:SetIdealYawAndUpdate.
    -- @param angle --- The aim direction to set, the `yaw` component.
    SetIdealYaw: function(self, angle: number)

    --- Sets the ideal yaw angle (left-right rotation) for the NPC and forces them to turn to that angle.
    -- @param angle --- The aim direction to set, the `yaw` component.
    -- @param speed --- The turn speed. Special values are:
    --- * `-1` - Calculate automatically
    --- * `-2` - Keep the previous yaw speed
    SetIdealYawAndUpdate: function(self, angle: number, speed: number)

    --- Sets conditions to ignore, which would normally interrupt an Engine-based schedule. Specified conditions will still be set, will call ENTITY:OnCondition and can be returned by NPC:HasCondition, but they will no longer interrupt the Engine schedule.
    -- @param conditions --- Conditions to ignore, see Enums/COND. The table must be sequential, numerical and values must correspond to condition enums.
    -- @param size --- Number of conditions to include in the ignored conditions table. Set this to the size of ignored conditions table to ignore all specified conditions.
    SetIgnoreConditions: function(self, conditions: table, size: number)

    --- Sets the last registered or memorized position for this NPC. When using scheduling, the NPC will focus on navigating to the last position via nodes.
    --- **NOTE**: The navigation requires ground nodes to function properly, otherwise the NPC could only navigate in a small area. (https://developer.valvesoftware.com/wiki/Info_node)
    -- @param position --- Where the NPC's last position will be set.
    SetLastPosition: function(self, position: GVector)

    --- Sets NPC's max view distance. An NPC will not be able to see enemies outside of this distance.
    -- @param dist --- New maximum distance the NPC can see at. Default is 2048 and 6000 for long range NPCs such as the sniper.
    SetMaxLookDistance: function(self, dist: number)

    --- Sets how long to try rebuilding path before failing task.
    -- @param time --- How long to try rebuilding path before failing task
    SetMaxRouteRebuildTime: function(self, time: number)

    --- Sets the movement delay for given NPC.
    --- See NPC:GetMoveDelay.
    -- @param delay --- The amount of time in seconds to delay movement by.
    SetMoveDelay: function(self, delay: number)

    --- Sets the timestep the internal NPC motor is working on.
    -- @param time --- The new timestep.
    SetMoveInterval: function(self, time: number)

    --- Sets the move velocity of the NPC
    -- @param vel --- The new movement velocity.
    SetMoveVelocity: function(self, vel: GVector)

    --- Sets whether the current movement should locked on the Yaw axis or not.
    -- @param lock --- Whether the movement should yaw locked or not.
    SetMoveYawLocked: function(self, lock: boolean)

    --- Sets the activity the NPC uses when it moves.
    -- @param activity --- The movement activity, see Enums/ACT.
    SetMovementActivity: function(self, activity: number)

    --- Sets the sequence the NPC navigation path uses for speed calculation. Doesn't seem to have any visible effect on NPC movement or actively playing sequence.
    --- To be able to use this, first set NPC:SetIdealActivity to `ACT_DO_NOT_DISTURB`, set this to any sequence with root motion data and call Entity:SetSequence on your desired sequence. As long as your NPC's NPC:GetMovementSequence has root motion data, your NPC will move to navigation point even though your NPC's Entity:GetSequence doesn't have any motion.
    -- @param sequenceId --- The movement sequence index
    SetMovementSequence: function(self, sequenceId: number)

    --- Sets the state the NPC is in to help it decide on a ideal schedule.
    -- @param state --- New NPC state, see Enums/NPC_STATE
    SetNPCState: function(self, state: number)

    --- Sets the navigation type of the NPC.
    -- @param navtype --- The new nav type. See Enums/NAV.
    SetNavType: function(self, navtype: number)

    --- Sets the NPC's current schedule.
    -- @param schedule --- The NPC schedule, see Enums/SCHED.
    SetSchedule: function(self, schedule: number)

    --- Assigns the NPC to a new squad. A squad can have up to 16 NPCs. NPCs in a single squad should be friendly to each other.
    --- See also ai.GetSquadMembers and NPC:GetSquad.
    --- NPCs within the same squad are meant to function more effectively, tactics wise.
    -- @param name --- The new squad name to set. Do not provide this argument to reset the squad.
    SetSquad: function(self, name: string)

    --- Sets the SNPC step height.
    --- **NOTE**: This only works for scripted NPCs.
    -- @param height --- The new step height. Default is 18 Hammer Units.
    SetStepHeight: function(self, height: number)

    --- Sets the NPC's target. This is used in some engine schedules.
    -- @param entity --- The target of the NPC.
    SetTarget: function(self, entity: GEntity)

    --- Sets the status of the current task.
    -- @param status --- The status. See Enums/TASKSTATUS.
    SetTaskStatus: function(self, status: number)

    --- Sets given entity as an unforgettable enemy. The state can be retrieved via NPC:IsUnforgettable.
    -- @param enemy --- The enemy entity to set.
    -- @param set --- The entity to set.
    SetUnforgettable: function(self, enemy: GEntity, set: boolean)

    --- Sets the view offset of the NPC. Player alternative of Player:SetViewOffset.
    --- This affects NPC's NPC:GetShootPos.
    -- @param  --- The view offset to set.
    SetViewOffset: function(self, _: GVector)

    --- Forces the NPC to start an engine task, this has different results for every NPC.
    -- @param task --- The id of the task to start, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    -- @param taskData --- The task data as a float, not all tasks make use of it.
    StartEngineTask: function(self, task: number, taskData: number)

    --- Resets the NPC's movement animation and velocity. Does not actually stop the NPC from moving.
    -- @param immediate --- Whether to stop moving even when currently active goal doesn't want us to.
    StopMoving: function(self, immediate: boolean)

    --- Cancels NPC:MoveOrder basically.
    --- Only works on Citizens (npc_citizen) and is a part of the Half-Life 2 squad system.
    --- The NPC **must** be in the player's squad for this to work.
    -- @param target --- Must be a player, does nothing otherwise.
    TargetOrder: function(self, target: GEntity)

    --- Marks the current NPC task as completed.
    --- This is meant to be used alongside NPC:TaskFail to complete or fail custom Lua defined tasks. (Schedule:AddTask)
    TaskComplete: function(self)

    --- Marks the current NPC task as failed.
    --- This is meant to be used alongside NPC:TaskComplete to complete or fail custom Lua defined tasks. (Schedule:AddTask)
    -- @param failReason --- Fail reason to be passed onto ENTITY:OnTaskFailed. The fail reason can also be seen when the NPC's `ent_text` is active.
    TaskFail: function(self, failReason: string)

    --- Force the NPC to update information on the supplied enemy, as if it had line of sight to it.
    -- @param enemy --- The enemy to update.
    -- @param pos --- The last known position of the enemy.
    UpdateEnemyMemory: function(self, enemy: GEntity, pos: GVector)

    --- Updates the turn activity. Basically applies the turn animations depending on the current turn yaw.
    UpdateTurnActivity: function(self)

    --- Forces the NPC to turn to their ideal yaw angle. See NPC:SetIdealYaw and NPC:SetIdealYawAndUpdate.
    -- @param speed --- The turn speed. Special values are:
    --- * `-1` - Calculate automatically
    --- * `-2` - Keep the previous yaw speed
    UpdateYaw: function(self, speed: number)

    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    -- @return --- If we succeeded setting the behavior.
    UseActBusyBehavior: function(self): boolean

    --- Enables the AI's [Assault Behavior](https://developer.valvesoftware.com/wiki/Assault "Assault Behavior") when an `ai_goal_assault` is set for this SENT.
    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    -- @return --- Whether the action succeeded.
    UseAssaultBehavior: function(self): boolean

    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    -- @return --- If we succeeded setting the behavior.
    UseFollowBehavior: function(self): boolean

    --- Orders the SNPC to control any nearby `func_tank`s looking for an NPC to operate itself, if available.
    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    -- @return --- Whether the action succeeded.
    UseFuncTankBehavior: function(self): boolean

    --- Enables the AI's [Lead Behavior](https://developer.valvesoftware.com/wiki/ai_goal_lead "Lead Behavior") when an `ai_goal_lead` is set for this SENT.
    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    -- @return --- Whether the action succeeded.
    UseLeadBehavior: function(self): boolean

    --- Undoes the other `Use*Behavior` functions.
    --- **NOTE**: This function only works on `ai` type [SENTs](Scripted_Entities).
    UseNoBehavior: function(self)
end


--- NextBots are a new system to create NPCs in the Source Engine, utilizing the more powerful navmesh system for navigation over the old node based system.
--- This page lists all possible functions usable with NextBots.
--- See NextBot NPC Creation for more information on how to create NextBot NPCs.
global interface GNextBot is GEntity
    where self:IsNextBot()
    --- Become a ragdoll and remove the entity.
    -- @param info --- Damage info passed from an onkilled event
    -- @return --- The created ragdoll, if any.
    BecomeRagdoll: function(self, info: GCTakeDamageInfo): GEntity

    --- Should only be called in NEXTBOT:BodyUpdate. This sets the `move_x` and `move_y` pose parameters of the bot to fit how they're currently moving, sets the animation speed (Entity:GetPlaybackRate) to suit the ground speed, and calls Entity:FrameAdvance.
    --- **BUG**: [This function might cause crashes with some activities.](https://github.com/Facepunch/garrysmod-issues/issues/3420
    BodyMoveXY: function(self)

    --- Clears this bot's last known area. See NextBot:GetLastKnownArea.
    ClearLastKnownArea: function(self)

    --- Like NextBot:FindSpots but only returns a vector.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_nextbot/sv_nextbot.lua#L201)
    -- @param type --- Either `"random"`, `"near"`, `"far"`.
    -- @param options --- This table should contain the search info.
    --- * string type - The type (Only `hiding` for now)
    --- * Vector pos - the position to search.
    --- * number radius - the radius to search.
    --- * number stepup - the highest step to step up.
    --- * number stepdown - the highest we can step down without being hurt.
    -- @return --- If it finds a spot it will return a vector. If not it will return nil.
    FindSpot: function(self, type: string, options: table): GVector

    --- Returns a table of hiding spots.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_nextbot/sv_nextbot.lua#L189)
    -- @param specs --- This table should contain the search info.
    --- * string type - The type (optional, only `hiding` supported)
    --- * Vector pos - the position to search.
    --- * number radius - the radius to search.
    --- * number stepup - the highest step to step up.
    --- * number stepdown - the highest we can step down without being hurt.
    -- @return --- An unsorted table of tables containing:
    --- * Vector vector - The position of the hiding spot
    --- * number distance - the distance to that position
    FindSpots: function(self, specs: table): table

    --- Returns the currently running activity
    -- @return --- The current activity
    GetActivity: function(self): number

    --- Returns the Field of View of the Nextbot NPC, used for its vision functionality, such as NextBot:IsAbleToSee.
    -- @return fov --- The current FOV of the nextbot
    GetFOV: function(self): number

    --- Returns this bots last known area. See also NextBot:ClearLastKnownArea.
    -- @return --- The last area the bot is known to have been in.
    GetLastKnownArea: function(self): GCNavArea

    --- Returns the maximum range the nextbot can see other nextbots/players at. See NextBot:IsAbleToSee.
    -- @return --- The current vision range
    GetMaxVisionRange: function(self): number

    --- Returns squared distance to an entity or a position.
    --- See also NextBot:GetRangeTo.
    -- @param to --- The position to measure distance to. Can be an entity.
    -- @return --- The squared distance
    GetRangeSquaredTo: function(self, to: GVector): number

    --- Returns the distance to an entity or position.
    --- See also NextBot:GetRangeSquaredTo.
    -- @param to --- The position to measure distance to. Can be an entity.
    -- @return --- The distance
    GetRangeTo: function(self, to: GVector): number

    --- Returns the solid mask for given NextBot.
    -- @return --- The solid mask, see Enums/CONTENTS and Enums/MASK
    GetSolidMask: function(self): number

    --- Called from Lua when the NPC is stuck. This should only be called from the behaviour coroutine - so if you want to override this function and do something special that yields - then go for it.
    --- You should always call self.loco:ClearStuck() in this function to reset the stuck status - so it knows it's unstuck. See CLuaLocomotion:ClearStuck.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_nextbot/sv_nextbot.lua#L265)
    HandleStuck: function(self)

    --- Returns if the Nextbot NPC can see the give entity or not.
    --- **WARNING**: Using this function creates the nextbot vision interface which will cause a significant performance hit!
    -- @param ent --- The entity to test if we can see
    -- @param useFOV --- Whether to use the Field of View of the Nextbot
    -- @return --- If the nextbot can see or not
    IsAbleToSee: function(self, ent: GEntity, useFOV: number): boolean

    --- To be called in the behaviour coroutine only! Will yield until the bot has reached the goal or is stuck
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_nextbot/sv_nextbot.lua#L299)
    -- @param pos --- The position we want to get to
    -- @param options --- A table containing a bunch of tweakable options.
    --- * number lookahead - Minimum look ahead distance.
    --- * number tolerance - How close we must be to the goal before it can be considered complete.
    --- * boolean draw - Draw the path. Only visible on listen servers and single player.
    --- * number maxage - Maximum age of the path before it times out.
    --- * number repath - Rebuilds the path after this number of seconds.
    -- @return --- Either `"failed"`, `"stuck"`, `"timeout"` or `"ok"` - depending on how the NPC got on
    MoveToPos: function(self, pos: GVector, options: table): string

    --- To be called in the behaviour coroutine only! Plays an animation sequence and waits for it to end before returning.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_nextbot/sv_nextbot.lua#L298-L317)
    -- @param name --- The sequence name
    -- @param speed --- Playback Rate of that sequence
    PlaySequenceAndWait: function(self, name: string, speed: number)

    --- Sets the Field of View for the Nextbot NPC, used for its vision functionality, such as NextBot:IsAbleToSee.
    -- @param fov --- The new FOV
    SetFOV: function(self, fov: number)

    --- Sets the maximum range the nextbot can see other nextbots/players at. See NextBot:IsAbleToSee.
    -- @param range --- The new vision range to set.
    SetMaxVisionRange: function(self, range: number)

    --- Sets the solid mask for given NextBot.
    --- The default solid mask of a NextBot is MASK_NPCSOLID.
    -- @param mask --- The new mask, see Enums/CONTENTS and Enums/MASK
    SetSolidMask: function(self, mask: number)

    --- Start doing an activity (animation).
    --- This function may not produce the desired result if Entity:SetModel has not yet been called on the nextbot entity
    -- @param activity --- One of the Enums/ACT
    StartActivity: function(self, activity: number)
end


--- Object containing parsed markup for later rendering. Created by markup.Parse.
global interface GMarkupObject
    --- Draws the computed markupobject to the screen. See markup.Parse.
    -- @param xOffset --- The X coordinate on the screen.
    -- @param yOffset --- The Y coordinate on the screen.
    -- @param xAlign --- The alignment of the x coordinate within the text using Enums/TEXT_ALIGN
    -- @param yAlign --- The alignment of the y coordinate within the text using Enums/TEXT_ALIGN
    -- @param alphaoverride --- Sets the alpha of all drawn objects to this value.
    -- @param textAlign --- The alignment of the text horizontally using Enums/TEXT_ALIGN
    Draw: function(self, xOffset: number, yOffset: number, xAlign: number, yAlign: number, alphaoverride: number, textAlign: number)

    --- Gets computed the height of the markupobject.
    -- @return Height --- The computed height.
    GetHeight: function(self): number

    --- Gets maximum width for this markup object as defined in markup.Parse.
    -- @return maxWidth --- The max width.
    GetMaxWidth: function(self): number

    --- Gets computed the width of the markupobject.
    -- @return Width --- The computed width.
    GetWidth: function(self): number

    --- Gets computed the width and height of the markupobject.
    -- @return --- The computed width.
    -- @return --- The computed height.
    Size: function(self): number, number
end


--- This is returned from video.Record.
global interface GIVideoWriter
    --- Adds the current framebuffer to the video stream.
    -- @param frameTime --- Usually set to what Global.FrameTime is, or simply 1/fps.
    -- @param downsample --- If true it will downsample the whole screenspace to the videos width and height, otherwise it will just record from the top left corner to the given width and height and therefore not the whole screen.
    AddFrame: function(self, frameTime: number, downsample: boolean)

    --- Ends the video recording and dumps it to disk.
    Finish: function(self)

    --- Returns the height of the video stream.
    -- @return --- height
    Height: function(self): number

    --- Sets whether to record sound or not.
    -- @param record --- Record.
    SetRecordSound: function(self, record: boolean)

    --- Returns the width of the video stream.
    -- @return --- width
    Width: function(self): number
end


--- An object representing game texture, such as those loaded from a `.vtf` file.
--- Do not confuse with IMaterial. Materials use textures. Game uses materials.
--- Returned by IMaterial:GetTexture
global interface GITexture
    --- Invokes the generator of the texture. Reloads file based textures from disk and clears render target textures.
    Download: function(self)

    --- Returns the color of the specified pixel, only works for textures created from PNG files.
    --- **BUG**: [The returned color will not have the color metatable.](https://github.com/Facepunch/garrysmod-issues/issues/2407
    -- @param x --- The X coordinate.
    -- @param y --- The Y coordinate.
    -- @return --- The color of the pixel as a Color.
    GetColor: function(self, x: number, y: number): GColor

    --- Returns the true unmodified height of the texture.
    -- @return --- height
    GetMappingHeight: function(self): number

    --- Returns the true unmodified width of the texture.
    -- @return --- width
    GetMappingWidth: function(self): number

    --- Returns the name of the texture, in most cases the path.
    -- @return --- name
    GetName: function(self): string

    --- Returns the number of animation frames in this texture.
    -- @return --- The number of animation frames in this texture.
    GetNumAnimationFrames: function(self): number

    --- Returns the modified height of the texture, this value may be affected by mipmapping and other factors.
    -- @return --- height
    Height: function(self): number

    --- Returns whenever the texture is valid. (i.e. was loaded successfully or not)
    --- **NOTE**: The "error" texture is a valid texture, and therefore this function will return false when used on it. Use ITexture:IsErrorTexture, instead.
    -- @return --- Whether the texture was loaded successfully or not.
    IsError: function(self): boolean

    --- Returns whenever the texture is the error texture (pink and black checkerboard pattern).
    -- @return --- Whether the texture is the error texture or not.
    IsErrorTexture: function(self): boolean

    --- Returns the modified width of the texture, this value may be affected by mipmapping and other factors.
    -- @return --- width
    Width: function(self): number
end


--- The object used in the saverestore, mainly in saverestore.AddSaveHook.
--- It allows you to write blocks directly into the save game files used by Half-Life 2 save system when such save is being saved.
global interface GISave
    --- Ends current data block started with ISave:StartBlock and returns to the parent block.
    --- To avoid all sorts of errors, you **must** end all blocks you start.
    EndBlock: function(self)

    --- Starts a new block of data that you can write to inside current block. Blocks **must** be ended with ISave:EndBlock.
    -- @param name --- Name of the new block. Used for determining which block is which, returned by IRestore:StartBlock during game load.
    StartBlock: function(self, name: string)

    --- Writes an Angle to the save object.
    -- @param ang --- The angle to write.
    WriteAngle: function(self, ang: GAngle)

    --- Writes a boolean to the save object.
    -- @param bool --- The boolean to write.
    WriteBool: function(self, bool: boolean)

    --- Writes an Entity to the save object.
    -- @param ent --- The entity to write.
    WriteEntity: function(self, ent: GEntity)

    --- Writes a floating point number to the save object.
    -- @param float --- The floating point number to write.
    WriteFloat: function(self, float: number)

    --- Writes an integer number to the save object.
    -- @param int --- The integer number to write.
    WriteInt: function(self, int: number)

    --- Writes a **null terminated** string to the save object.
    -- @param str --- The string to write.
    WriteString: function(self, str: string)

    --- Writes a Vector to the save object.
    -- @param vec --- The vector to write.
    WriteVector: function(self, vec: GVector)
end


--- The object used in the saverestore, mainly in saverestore.AddRestoreHook.
--- It allows you to read blocks directly from the save game files used by Half-Life 2 save system when such save is loaded.
global interface GIRestore
    --- Ends current data block started with IRestore:StartBlock and returns to the parent block.
    --- To avoid all sorts of errors, you **must** end all blocks you start.
    EndBlock: function(self)

    --- Reads next bytes from the restore object as an Angle.
    -- @return --- The angle that has been read
    ReadAngle: function(self): GAngle

    --- Reads next bytes from the restore object as a boolean.
    -- @return --- The boolean that has been read
    ReadBool: function(self): boolean

    --- Reads next bytes from the restore object as an Entity.
    -- @return --- The entity that has been read.
    ReadEntity: function(self): GEntity

    --- Reads next bytes from the restore object as a floating point number.
    -- @return --- The read floating point number.
    ReadFloat: function(self): number

    --- Reads next bytes from the restore object as an integer number.
    -- @return --- The read integer number.
    ReadInt: function(self): number

    --- Reads next bytes from the restore object as a string.
    -- @return --- The read string.
    ReadString: function(self): string

    --- Reads next bytes from the restore object as a Vector.
    -- @return --- The read vector.
    ReadVector: function(self): GVector

    --- Loads next block of data to be read inside current block. Blocks **must** be ended with IRestore:EndBlock.
    -- @return --- The name of the next data block to be read.
    StartBlock: function(self): string
end


--- Renderable mesh object, can be used to create models on the fly.
--- The only way to create your own IMesh object is to call Global.Mesh.
--- **NOTE**: IMeshes only respond to one projected texture.
--- See the render.RenderFlashlights function and example that solves this problem.
global interface GIMesh
    --- Builds the mesh from a table mesh vertexes.
    --- When modifying a previously built mesh, your new mesh must match the vertex count!
    --- See Global.Mesh and util.GetModelMeshes for examples.
    --- **WARNING**: IMesh appears to have a limit of 65535 vertices. You should split your mesh into multiple meshes when above this limit.
    --- Exceeding the limit may lead to undefined rendering behavior.
    -- @param vertexes --- A table consisting of Structures/MeshVertexs.
    BuildFromTriangles: function(self, vertexes: table)

    --- Deletes the mesh and frees the memory used by it.
    Destroy: function(self)

    --- Renders the mesh with the active matrix.
    Draw: function(self)

    --- Returns whether this IMesh is valid or not.
    -- @return --- Whether this IMesh is valid or not.
    IsValid: function(self): boolean
end


--- A Material object. It represents a game material, similarly to how a `.vmt` file does, which are in fact loaded into an **IMaterial** object.
--- In most cases the game works with materials as far as file paths go. Materials then point to different ITextures (`.vtf` files) they might be using.
--- They are not the same and cannot be interchanged.
--- A material object can be created with Global.Material or Global.CreateMaterial.
global interface GIMaterial
    --- Returns the color of the specified pixel of the `$basetexture`, only works for materials created from PNG files.
    --- Basically identical to ITexture:GetColor used on IMaterial:GetTexture`( "$basetexture" )`.
    -- @param x --- The X coordinate.
    -- @param y --- The Y coordinate.
    -- @return --- The color of the pixel as a Color.
    GetColor: function(self, x: number, y: number): GColor

    --- Returns the specified material value as a float, or nil if the value is not set.
    -- @param materialFloat --- The name of the material value.
    -- @return --- float
    GetFloat: function(self, materialFloat: string): number

    --- Returns the specified material value as a int, rounds the value if its a float, or nil if the value is not set.
    --- **NOTE**: Please note that certain material flags such as `$model` are stored in the `$flags` variable and cannot be directly retrieved with this function. See the full list here: Material Flags
    -- @param materialInt --- The name of the material integer.
    -- @return --- The retrieved value as an integer
    GetInt: function(self, materialInt: string): number

    --- Gets all the key values defined for the material.
    -- @return --- The material's key values.
    GetKeyValues: function(self): {string:any}

    --- Returns the specified material matrix as a int, or nil if the value is not set or is not a matrix.
    -- @param materialMatrix --- The name of the material matrix.
    -- @return --- matrix
    GetMatrix: function(self, materialMatrix: string): GVMatrix

    --- Returns the name of the material, in most cases the path.
    -- @return --- Material name/path
    GetName: function(self): string

    --- Returns the name of the materials shader.
    --- **BUG**: [This function does not work serverside on Linux SRCDS and always returns `shader_error`.](https://github.com/Facepunch/garrysmod-issues/issues/3256
    --- This bug is fixed on `dev` beta and in the next update.
    -- @return --- Name of the currently loaded shader for this material, or `shader_error` if the material has no loaded shader.
    --- It is not guaranteed to be in any specific capitalization, so case insensitive checks are advised.
    GetShader: function(self): string

    --- Returns the specified material string, or nil if the value is not set or if the value can not be converted to a string.
    -- @param materialString --- The name of the material string.
    -- @return --- The value as a string
    GetString: function(self, materialString: string): string

    --- Returns an ITexture based on the passed shader parameter.
    -- @param param --- The [shader parameter](https://developer.valvesoftware.com/wiki/Category:List_of_Shader_Parameters) to retrieve. This should normally be `$basetexture`.
    -- @return --- The value of the shader parameter. Returns nothing if the param doesn't exist.
    GetTexture: function(self, param: string): GITexture

    --- Returns the specified material vector, or nil if the value is not set.
    --- See also IMaterial:GetVectorLinear
    -- @param materialVector --- The name of the material vector.
    -- @return --- The color vector
    GetVector: function(self, materialVector: string): GVector

    --- Returns the specified material vector as a 4 component vector.
    -- @param name --- The name of the material vector to retrieve.
    -- @return x --- The x component of the vector.
    -- @return y --- The y component of the vector.
    -- @return z --- The z component of the vector.
    -- @return w --- The w component of the vector.
    GetVector4D: function(self, name: string): number, number, number, number

    --- Returns the specified material linear color vector, or nil if the value is not set.
    --- See https://en.wikipedia.org/wiki/Gamma_correction
    --- See also IMaterial:GetVector
    -- @param materialVector --- The name of the material vector.
    -- @return --- The linear color vector
    GetVectorLinear: function(self, materialVector: string): GVector

    --- Returns the height of the member texture set for `$basetexture`.
    -- @return --- Height of the base texture.
    Height: function(self): number

    --- Returns whenever the material is valid, i.e. whether it was not loaded successfully from disk or not.
    -- @return --- Is this material the error material? (___error)
    IsError: function(self): boolean

    --- Recomputes the material's snapshot. This needs to be called if you have changed variables on your material and it isn't changing.
    --- Be careful though - this function is slow - so try to call it only when needed!
    Recompute: function(self)



    --- Sets the specified material float to the specified float, does nothing on a type mismatch.
    -- @param materialFloat --- The name of the material float.
    -- @param float --- The new float value.
    SetFloat: function(self, materialFloat: string, float: number)

    --- Sets the specified material value to the specified int, does nothing on a type mismatch.
    --- **NOTE**: Please note that certain material flags such as `$model` are stored in the `$flags` variable and cannot be directly set with this function. See the full list here: Material Flags
    -- @param materialInt --- The name of the material int.
    -- @param int --- The new int value.
    SetInt: function(self, materialInt: string, int: number)

    --- Sets the specified material value to the specified matrix, does nothing on a type mismatch.
    -- @param materialMatrix --- The name of the material int.
    -- @param matrix --- The new matrix.
    SetMatrix: function(self, materialMatrix: string, matrix: GVMatrix)

    --- @deprecated
    --- **DEPRECATED**: This function does nothing
    --- The functionality of this function was removed due to the amount of crashes it caused.
    -- @param shaderName --- Name of the shader
    SetShader: function(self, shaderName: string)

    --- Sets the specified material value to the specified string, does nothing on a type mismatch.
    -- @param materialString --- The name of the material string.
    -- @param string --- The new string.
    SetString: function(self, materialString: string, string: string)

    --- Sets the specified material texture to the specified texture, does nothing on a type mismatch.
    -- @param materialTexture --- The name of the keyvalue on the material to store the texture on.
    -- @param texture --- The new texture. This can also be a string, the name of the new texture.
    SetTexture: function(self, materialTexture: string, texture: GITexture)

    --- Unsets the value for the specified material value.
    -- @param materialValueName --- The name of the material value to be unset.
    SetUndefined: function(self, materialValueName: string)

    --- Sets the specified material vector to the specified vector, does nothing on a type mismatch.
    -- @param MaterialVector --- The name of the material vector.
    -- @param vec --- The new vector.
    SetVector: function(self, MaterialVector: string, vec: GVector)

    --- Sets the specified material vector to the specified 4 component vector, does nothing on a type mismatch.
    -- @param name --- The name of the material vector.
    -- @param x --- The x component of the new vector.
    -- @param y --- The y component of the new vector.
    -- @param z --- The z component of the new vector.
    -- @param w --- The w component of the new vector.
    SetVector4D: function(self, name: string, x: number, y: number, z: number, w: number)

    --- Returns the width of the member texture set for `$basetexture`.
    -- @return --- Width of the base texture.
    Width: function(self): number
end


--- A sound channel returned by a callback of sound.PlayURL and sound.PlayFile.
global interface GIGModAudioChannel
    --- Enables or disables looping of audio channel, requires noblock flag.
    -- @param enable --- Enable or disable looping of this audio channel.
    EnableLooping: function(self, enable: boolean)

    --- Computes the [DFT (discrete Fourier transform)](https://en.wikipedia.org/wiki/Discrete_Fourier_transform) of the sound channel.
    --- The size parameter specifies the number of consecutive audio samples to use as the input to the DFT and is restricted to a power of two. A [Hann window](https://en.wikipedia.org/wiki/Hann_function) is applied to the input data.
    --- The computed DFT has the same number of frequency bins as the number of samples. Only half of this DFT is returned, since [the DFT magnitudes are symmetric for real input data](https://en.wikipedia.org/wiki/Discrete_Fourier_transform#The_real-input_DFT). The magnitudes of the DFT (values from 0 to 1) are used to fill the output table, starting at index 1.
    --- **Visualization protip:** For a size N DFT, bin k (1-indexed) corresponds to a frequency of (k - 1) / N * sampleRate.
    --- **Visualization protip:** Sound energy is proportional to the square of the magnitudes. Adding magnitudes together makes no sense physically, but adding energies does.
    --- **Visualization protip:** The human ear works on a logarithmic amplitude scale. You can convert to [decibels](https://en.wikipedia.org/wiki/Decibel) by taking 20 * math.log10 of frequency magnitudes, or 10 * math.log10 of energy. The decibel values will range from -infinity to 0.
    -- @param tbl --- The table to output the DFT magnitudes (numbers between 0 and 1) into. Indices start from 1.
    -- @param size --- The number of samples to use. See Enums/FFT
    -- @return --- The number of frequency bins that have been filled in the output table.
    FFT: function(self, tbl: {number}, size: E_FFT): number

    --- Returns 3D cone of the sound channel. See IGModAudioChannel:Set3DCone.
    -- @return --- The angle of the inside projection cone in degrees.
    -- @return --- The angle of the outside projection cone in degrees.
    -- @return --- The delta-volume outside the outer projection cone.
    Get3DCone: function(self): number, number, number

    --- Returns if the sound channel is currently in 3D mode or not. This value will be affected by IGModAudioChannel:Set3DEnabled.
    -- @return --- Is currently 3D or not.
    Get3DEnabled: function(self): boolean

    --- Returns 3D fade distances of a sound channel.
    -- @return --- The minimum distance. The channel's volume is at maximum when the listener is within this distance
    -- @return --- The maximum distance. The channel's volume stops decreasing when the listener is beyond this distance
    Get3DFadeDistance: function(self): number, number

    --- Returns the average bit rate of the sound channel.
    -- @return --- The average bit rate of the sound channel.
    GetAverageBitRate: function(self): number

    --- Retrieves the number of bits per sample of the sound channel.
    --- Doesn't work for mp3 and ogg files.
    -- @return --- Number of bits per sample, or 0 if unknown.
    GetBitsPerSample: function(self): number

    --- Returns the buffered time of the sound channel in seconds, for online streaming sound channels. (sound.PlayURL)
    --- For offline channels this will be equivalent to IGModAudioChannel:GetLength.
    -- @return --- The current buffered time of the stream, in seconds.
    GetBufferedTime: function(self): number

    --- Returns the filename for the sound channel.
    -- @return --- The file name. This will not be always what you have put into the sound.PlayURL as first argument.
    GetFileName: function(self): string

    --- Returns the length of sound played by the sound channel in seconds.
    -- @return --- The length of the sound. This value seems to be less then 0 for continuous radio streams.
    GetLength: function(self): number

    --- Returns the right and left levels of sound played by the sound channel.
    -- @return --- The left sound level. The value is between 0 and 1.
    -- @return --- The right sound level. The value is between 0 and 1.
    GetLevel: function(self): number, number

    --- Gets the relative volume of the left and right channels.
    -- @return pan --- Relative volume between the left and right channels. `-1` means only in left channel, `0` is center and `1` is only in the right channel. `0` by default.
    GetPan: function(self): number

    --- Returns the playback rate of the sound channel.
    -- @return --- The current playback rate of the sound channel
    GetPlaybackRate: function(self): number

    --- Returns position of the sound channel
    -- @return --- The position of the sound channel, previously set by IGModAudioChannel:SetPos
    GetPos: function(self): GVector

    --- Returns the sample rate for currently playing sound.
    -- @return --- The sample rate in Hz. This should always be 44100.
    GetSamplingRate: function(self): number

    --- Returns the state of a sound channel
    -- @return --- The state of the sound channel, see Enums/GMOD_CHANNEL
    GetState: function(self): number

    --- Retrieves HTTP headers from a bass stream channel created by sound.PlayURL, if available.
    --- Of special interest here are headers such as `icy-name`, `icy-br`, `ice-audio-info`, `icy-genre`.
    -- @return info --- A list of HTTP headers or `nil` if no information is available.
    --- Example output:
    --- ```
    --- ... other headers
    --- [7]	=	ice-audio-info: channels=2;samplerate=44100;bitrate=128
    --- [8]	=	icy-genre: lounge
    --- [9]	=	icy-name: RTFM Lounge
    --- ... other headers
    --- ```
    GetTagsHTTP: function(self): {string}

    --- Retrieves the ID3 version 1 info from a bass channel created by sound.PlayFile or sound.PlayURL, if available.
    --- ID3v2 is not supported.
    -- @return info --- A table containing the information, or `nil` if no information is available.
    --- The table will always have the following keys, filled out based on what is available:
    --- `album`, `artist`, `comment`, `genre`, `id`, `title`, `year`
    GetTagsID3: function(self): table

    --- Retrieves `.m4a` media info, from a bass channel created by sound.PlayURL or sound.PlayFile, if available.
    -- @return info --- A list of available information in no particular order, or `nil` if no information is available.
    GetTagsMP4: function(self): {string}

    --- Retrieves ICY metadata from a bass stream channel created by sound.PlayURL, if available.
    -- @return info --- The meta information, or `nil` if no information is available.
    --- Example output: `StreamTitle='MUSIC NAME HERE';`
    GetTagsMeta: function(self): string

    --- Retrieves OGG media info tag, from a bass channel created by sound.PlayURL or sound.PlayFile, if available.
    -- @return info --- A list of available information in no particular order, or `nil` if no information is available.
    --- Example output:
    --- ```
    --- [0]	=	Author=MY AUTHIOR
    --- [1]	=	Title=MY TITLE
    --- ... other data if available
    --- ```
    GetTagsOGG: function(self): {string}

    --- Retrieves OGG Vendor tag, usually containing the application that created the file, from a bass channel created by sound.PlayURL or sound.PlayFile, if available.
    -- @return info --- The OGG vendor tag, or `nil` if no information is available.
    GetTagsVendor: function(self): string

    --- Retrieves `.WMA` media info, from a bass channel created by sound.PlayURL or sound.PlayFile, if available.
    -- @return info --- A list of available information in no particular order, or `nil` if no information is available.
    GetTagsWMA: function(self): {string}

    --- Returns the current time of the sound channel in seconds
    -- @return --- The current time of the stream
    GetTime: function(self): number

    --- Returns volume of a sound channel
    -- @return --- The volume of the sound channel
    GetVolume: function(self): number

    --- Returns if the sound channel is in 3D mode or not.
    -- @return --- Is 3D or not.
    Is3D: function(self): boolean

    --- Returns whether the audio stream is block streamed or not.
    -- @return --- Is the audio stream block streamed or not.
    IsBlockStreamed: function(self): boolean

    --- Returns if the sound channel is looping or not.
    -- @return --- Is looping or not.
    IsLooping: function(self): boolean

    --- Returns if the sound channel is streamed from the Internet or not.
    -- @return --- Is online or not.
    IsOnline: function(self): boolean

    --- Returns if the sound channel is valid or not.
    -- @return --- Is the sound channel valid or not
    IsValid: function(self): boolean

    --- Pauses the stream. It can be started again using IGModAudioChannel:Play
    Pause: function(self)

    --- Starts playing the stream.
    Play: function(self)

    --- Sets 3D cone of the sound channel.
    -- @param innerAngle --- The angle of the inside projection cone in degrees.
    --- Range is from 0 (no cone) to 360 (sphere), -1 = leave current.
    -- @param outerAngle --- The angle of the outside projection cone in degrees.
    --- Range is from 0 (no cone) to 360 (sphere), -1 = leave current.
    -- @param outerVolume --- The delta-volume outside the outer projection cone.
    --- Range is from 0 (silent) to 1 (same as inside the cone), less than 0 = leave current.
    Set3DCone: function(self, innerAngle: number, outerAngle: number, outerVolume: number)

    --- Sets the 3D mode of the channel. This will affect IGModAudioChannel:Get3DEnabled but not IGModAudioChannel:Is3D.
    --- This feature **requires** the channel to be initially created in 3D mode, i.e. IGModAudioChannel:Is3D should return true or this function will do nothing.
    -- @param enable --- true to enable, false to disable 3D.
    Set3DEnabled: function(self, enable: boolean)

    --- Sets 3D fade distances of a sound channel.
    -- @param min --- The minimum distance. The channel's volume is at maximum when the listener is within this distance.
    --- 0 or less = leave current.
    -- @param max --- The maximum distance. The channel's volume stops decreasing when the listener is beyond this distance.
    --- 0 or less = leave current.
    Set3DFadeDistance: function(self, min: number, max: number)

    --- Sets the relative volume of the left and right channels.
    -- @param pan --- Relative volume between the left and right channels. `-1` means only in left channel, `0` is center (default) and `1` is only in the right channel. Fractional values are supported.
    SetPan: function(self, pan: number)

    --- Sets the playback rate of the sound channel. May not work with high values for radio streams.
    -- @param rate --- Playback rate to set to. 1 is normal speed, 0.5 is half the normal speed, etc.
    SetPlaybackRate: function(self, rate: number)

    --- Sets position of sound channel in case the sound channel has a 3d option set.
    -- @param pos --- The position to put the sound into
    -- @param dir --- The direction of the sound
    SetPos: function(self, pos: GVector, dir: GVector)

    --- Sets the sound channel to specified time ( Rewind to that position of the song ). Does not work on online radio streams.
    --- Streamed sounds must have "noblock" parameter for this to work and IGModAudioChannel:IsBlockStreamed must return false.
    --- **NOTE**: Streamed sounds can only have their time set to up to the current IGModAudioChannel:GetBufferedTime.
    -- @param secs --- The time to set the stream to, in seconds.
    -- @param dont_decode --- Set to true to skip decoding to set time, and instead just seek to it which is faster. Certain streams do not support seeking and have to decode to the given position.
    SetTime: function(self, secs: number, dont_decode: boolean)

    --- Sets the volume of a sound channel
    -- @param volume --- Volume to set. 1 meaning 100% volume, 0.5 is 50% and 3 is 300%, etc.
    SetVolume: function(self, volume: number)

    --- Stop the stream. It can be started again using IGModAudioChannel:Play.
    --- **BUG**: [Calling this invalidates the IGModAudioChannel object rendering it unusable for further functions.](https://github.com/Facepunch/garrysmod-issues/issues/1497
    Stop: function(self)
end


--- This is the file object. It used used primarily to read or write binary data from files.
--- The default endianness is little-endian. To use big-endian you will need to provide your own functions to read and write shorts and longs.
--- The object is returned by file.Open.
global interface GFile
    --- Dumps the file changes to disk and closes the file handle which makes the handle useless.
    Close: function(self)

    --- Returns whether the File object has reached the end of file or not.
    -- @return --- Whether the file has reached end or not.
    EndOfFile: function(self): boolean

    --- Dumps the file changes to disk and saves the file.
    Flush: function(self)

    --- Reads the specified amount of chars and returns them as a binary string.
    -- @param length --- Reads the specified amount of chars. If not set, will read the entire file.
    -- @return data ---
    Read: function(self, length: number): string

    --- Reads one byte of the file and returns whether that byte was not 0.
    -- @return --- val
    ReadBool: function(self): boolean

    --- Reads one unsigned 8-bit integer from the file.
    -- @return --- The unsigned 8-bit integer from the file.
    ReadByte: function(self): number

    --- Reads an 8-byte little-endian IEEE-754 floating point double from the file.
    -- @return --- The double-precision floating point value read from the file.
    ReadDouble: function(self): number

    --- Reads an IEEE 754 little-endian 4-byte float from the file.
    -- @return --- The read value
    ReadFloat: function(self): number

    --- Returns the contents of the file from the current position up until the end of the current line.
    --- **NOTE**: This function will look specifically for `Line Feed` characters `\n` and will **completely ignore `Carriage Return` characters** `\r`.
    --- It will also stop at a `\0` or `NULL` character, but will add a new line instead.
    --- This function will not return more than 8192 characters. The return value will include the `\n` character.
    -- @return --- The string of data from the read line.
    ReadLine: function(self): string

    --- Reads a signed little-endian 32-bit integer from the file.
    -- @return --- A signed 32-bit integer
    ReadLong: function(self): number

    --- Reads a signed little-endian 16-bit integer from the file.
    -- @return --- int16
    ReadShort: function(self): number

    --- Reads an unsigned 64-bit integer from the file.
    -- @return --- An unsigned 64-bit integer.
    --- **NOTE**: Since Lua cannot store full 64-bit integers, this function returns a string. It is mainly aimed at usage with Player:SteamID64.
    ReadUInt64: function(self): string

    --- Reads an unsigned little-endian 32-bit integer from the file.
    -- @return --- An unsigned 32-bit integer
    ReadULong: function(self): number

    --- Reads an unsigned little-endian 16-bit integer from the file.
    -- @return --- The 16-bit integer
    ReadUShort: function(self): number

    --- Sets the file pointer to the specified position.
    -- @param pos --- Pointer position, in bytes.
    Seek: function(self, pos: number)

    --- Returns the size of the file in bytes.
    -- @return size ---
    Size: function(self): number

    --- Moves the file pointer by the specified amount of chars.
    -- @param amount --- The amount of chars to skip, can be negative to skip backwards.
    -- @return --- amount
    Skip: function(self, amount: number): number

    --- Returns the current position of the file pointer.
    -- @return --- pos
    Tell: function(self): number

    --- Writes the given string into the file.
    -- @param data --- Binary data to write to the file.
    Write: function(self, data: string)

    --- Writes a boolean value to the file as one **byte**.
    -- @param bool --- The bool to be written to the file.
    WriteBool: function(self, bool: boolean)

    --- Write an 8-bit unsigned integer to the file.
    -- @param uint8 --- The 8-bit unsigned integer to be written to the file.
    WriteByte: function(self, uint8: number)

    --- Writes an 8-byte little-endian IEEE-754 floating point double to the file.
    -- @param double --- The double to be written to the file.
    WriteDouble: function(self, double: number)

    --- Writes an IEEE 754 little-endian 4-byte float to the file.
    -- @param float --- The float to be written to the file.
    WriteFloat: function(self, float: number)

    --- Writes a signed little-endian 32-bit integer to the file.
    -- @param int32 --- The 32-bit signed integer to be written to the file.
    WriteLong: function(self, int32: number)

    --- Writes a signed little-endian 16-bit integer to the file.
    -- @param int16 --- The 16-bit signed integer to be written to the file.
    WriteShort: function(self, int16: number)

    --- Writes an unsigned 64-bit integer to the file.
    -- @param uint64 --- The unsigned 64-bit integer to be written to the file.
    --- **NOTE**: Since Lua cannot store full 64-bit integers, this function takes a string. It is mainly aimed at usage with Player:SteamID64.
    WriteUInt64: function(self, uint64: string)

    --- Writes an unsigned little-endian 32-bit integer to the file.
    -- @param uint32 --- The unsigned 32-bit integer to be written to the file.
    WriteULong: function(self, uint32: number)

    --- Writes an unsigned little-endian 16-bit integer to the file.
    -- @param uint16 --- The unsigned 16-bit integer to the file.
    WriteUShort: function(self, uint16: number)
end


--- A class used to store the player inputs, such as mouse movement, view angles, Enums/IN buttons pressed and analog movement, the data from this class is then transfered to a CMoveData during actual movement simulation.
--- Can be modified during GM:CreateMove, GM:StartCommand and used in read only with GM:SetupMove and Player:GetCurrentCommand.
global interface GCUserCmd
    --- Adds a single key to the active buttons bitflag. See also CUserCmd:SetButtons.
    -- @param key --- Key to add, see Enums/IN.
    AddKey: function(self, key: number)

    --- Removes all keys from the command.
    --- **NOTE**: If you are looking to affect player movement, you may need to use CUserCmd:ClearMovement instead of clearing the buttons.
    ClearButtons: function(self)

    --- Clears the movement from the command.
    --- See also CUserCmd:SetForwardMove, CUserCmd:SetSideMove and  CUserCmd:SetUpMove.
    ClearMovement: function(self)

    --- Returns an increasing number representing the index of the user cmd.
    --- **WARNING**: The value returned is occasionally 0 inside GM:CreateMove and GM:StartCommand. It is advised to check for a non-zero value if you wish to get the correct number.
    -- @return --- The command number
    CommandNumber: function(self): number

    --- Returns a bitflag indicating which buttons are pressed.
    -- @return --- Pressed buttons, see Enums/IN
    GetButtons: function(self): number

    --- The speed the client wishes to move forward with, negative if the clients wants to move backwards.
    -- @return --- The desired speed
    GetForwardMove: function(self): number

    --- Gets the current impulse from the client, usually 0. [See impulses list](https://developer.valvesoftware.com/wiki/Impulse) and some GMod specific impulses.
    -- @return --- The impulse
    GetImpulse: function(self): number

    --- Returns the scroll delta as whole number.
    -- @return --- Scroll delta
    GetMouseWheel: function(self): number

    --- Returns the delta of the angular horizontal mouse movement of the player.
    -- @return --- xDelta
    GetMouseX: function(self): number

    --- Returns the delta of the angular vertical mouse movement of the player.
    -- @return --- yDelta
    GetMouseY: function(self): number

    --- The speed the client wishes to move sideways with, positive if it wants to move right, negative if it wants to move left.
    -- @return --- requestSpeed
    GetSideMove: function(self): number

    --- The speed the client wishes to move up with, negative if the clients wants to move down.
    -- @return --- requestSpeed
    GetUpMove: function(self): number

    --- Gets the direction the player is looking in.
    -- @return --- The direction the player is looking in.
    GetViewAngles: function(self): GAngle

    --- When players are not sending usercommands to the server (often due to lag), their last usercommand will be executed multiple times as a backup. This function returns true if that is happening.
    --- This will never return true clientside.
    -- @return --- isForced
    IsForced: function(self): boolean

    --- Returns true if the specified button(s) is pressed.
    -- @param key --- Bitflag representing which button to check, see Enums/IN.
    -- @return --- Is key down or not
    KeyDown: function(self, key: number): boolean

    --- Removes a key bit from the current key bitflag.
    --- For movement you will want to use CUserCmd:SetForwardMove, CUserCmd:SetUpMove and CUserCmd:SetSideMove.
    -- @param button --- Bitflag to be removed from the key bitflag, see Enums/IN.
    RemoveKey: function(self, button: number)

    --- Forces the associated player to select a weapon. This is used internally in the default HL2 weapon selection HUD.
    --- This may not work immediately if the current command is in prediction. Use input.SelectWeapon to switch the weapon from the client when the next available command can do so.
    --- **NOTE**: This is the ideal function to use to create a custom weapon selection HUD, as it allows prediction to run properly for WEAPON:Deploy and GM:PlayerSwitchWeapon
    -- @param weapon --- The weapon entity to select.
    SelectWeapon: function(self, weapon: GWeapon)

    --- Sets the buttons as a bitflag. See also CUserCmd:GetButtons.
    --- **NOTE**: If you are looking to affect player movement, you may need to use CUserCmd:SetForwardMove instead of setting the keys.
    -- @param buttons --- Bitflag representing which buttons are "down", see Enums/IN.
    SetButtons: function(self, buttons: number)

    --- Sets speed the client wishes to move forward with, negative if the clients wants to move backwards.
    --- See also CUserCmd:ClearMovement, CUserCmd:SetSideMove and CUserCmd:SetUpMove.
    -- @param speed --- The new speed to request. The client will not be able to move faster than their set walk/sprint speed.
    SetForwardMove: function(self, speed: number)

    --- Sets the impulse command to be sent to the server.
    --- Here are a few examples of impulse numbers:
    --- - `100` toggles their flashlight
    --- - `101` gives the player all Half-Life 2 weapons with `sv_cheats` set to `1`
    --- - `200` toggles holstering / restoring the current weapon
    --- When holstered, the `EF_NODRAW` flag is set on the active weapon.
    --- - `154` toggles noclip
    --- [See full list](https://developer.valvesoftware.com/wiki/Impulse)
    -- @param impulse --- The impulse to send.
    SetImpulse: function(self, impulse: number)

    --- Sets the scroll delta.
    -- @param speed --- The scroll delta.
    SetMouseWheel: function(self, speed: number)

    --- Sets the delta of the angular horizontal mouse movement of the player.
    --- See also CUserCmd:SetMouseY.
    -- @param speed --- Angular horizontal move delta.
    SetMouseX: function(self, speed: number)

    --- Sets the delta of the angular vertical mouse movement of the player.
    --- See also CUserCmd:SetMouseX.
    -- @param speed --- Angular vertical move delta.
    SetMouseY: function(self, speed: number)

    --- Sets speed the client wishes to move sidewards with, positive to move right, negative to move left.
    --- See also CUserCmd:SetForwardMove and  CUserCmd:SetUpMove.
    -- @param speed --- The new speed to request.
    SetSideMove: function(self, speed: number)

    --- Sets speed the client wishes to move upwards with, negative to move down.
    --- See also CUserCmd:SetSideMove and  CUserCmd:SetForwardMove.
    --- **NOTE**: This function does **not** move the client up/down ladders. To force ladder movement, consider CUserCMD:SetButtons and use IN_FORWARD from Enums/IN.
    -- @param speed --- The new speed to request.
    SetUpMove: function(self, speed: number)

    --- Sets the direction the client wants to move in.
    --- **NOTE**: For human players, the pitch (vertical) angle should be clamped to +/- 89° to prevent the player's view from glitching.
    --- **NOTE**: For fake clients (those created with player.CreateNextBot), this functionally dictates the 'move angles' of the bot. This typically functions separately from the colloquial view angles. This can be utilized by CUserCmd:SetForwardMove and its related functions.
    -- @param viewAngle --- New view angles.
    SetViewAngles: function(self, viewAngle: GAngle)

    --- Returns tick count since joining the server.
    --- **NOTE**: This will always return 0 for bots.
    --- **NOTE**: Returns 0 clientside during prediction calls. If you are trying to use CUserCmd:Set*() on the client in a movement or command hook, keep doing so till TickCount returns a non-zero number to maintain prediction.
    -- @return --- The amount of ticks passed since joining the server.
    TickCount: function(self): number
end


--- A class used to store and modify all the data concerning a damage event.
--- An empty CTakeDamageInfo object can be created with Global.DamageInfo
--- List of hooks that this object is passed to:
--- * ENTITY:OnTakeDamage
--- * GM:DoPlayerDeath
--- * GM:EntityTakeDamage
--- * GM:PostEntityTakeDamage
--- * GM:OnDamagedByExplosion
--- * GM:ScaleNPCDamage
--- * GM:ScalePlayerDamage
--- * NEXTBOT:OnInjured
--- * NEXTBOT:OnKilled
--- * NEXTBOT:OnOtherKilled
--- List of functions that use this object:
--- * util.BlastDamageInfo
--- * Entity:TakeDamageInfo
--- * Entity:TakePhysicsDamage
--- * Entity:DispatchTraceAttack
global interface GCTakeDamageInfo
    --- Increases the damage by damageIncrease.
    -- @param damageIncrease --- The damage to add.
    AddDamage: function(self, damageIncrease: number)

    --- Returns the ammo type used by the weapon that inflicted the damage.
    -- @return --- Ammo type ID
    GetAmmoType: function(self): number

    --- Returns the attacker ( character who originated the attack ), for example a player or an NPC that shot the weapon.
    -- @return --- The attacker
    GetAttacker: function(self): GEntity

    --- Returns the initial unmodified by skill level ( game.GetSkillLevel ) damage.
    -- @return --- baseDamage
    GetBaseDamage: function(self): number

    --- Returns the total damage.
    -- @return --- damage
    GetDamage: function(self): number

    --- Gets the current bonus damage.
    -- @return --- Bonus damage
    GetDamageBonus: function(self): number

    --- Gets the custom damage type. This is used by Day of Defeat: Source and Team Fortress 2 for extended damage info, but isn't used in Garry's Mod by default.
    -- @return --- The custom damage type
    GetDamageCustom: function(self): number

    --- Returns a vector representing the damage force.
    --- Can be set with CTakeDamageInfo:SetDamageForce.
    -- @return --- The damage force
    GetDamageForce: function(self): GVector

    --- Returns the position where the damage was or is going to be applied to.
    --- Can be set using CTakeDamageInfo:SetDamagePosition.
    -- @return --- The damage position
    GetDamagePosition: function(self): GVector

    --- Returns a bitflag which indicates the damage type(s) of the damage.
    --- Consider using CTakeDamageInfo:IsDamageType instead. Value returned by this function can contain multiple damage types.
    -- @return --- Damage type(s), a combination of Enums/DMG
    GetDamageType: function(self): E_DMG

    --- Returns the inflictor of the damage. This is not necessarily a weapon.
    --- For hitscan weapons this is the weapon.
    --- For projectile weapons this is the projectile.
    --- For a more reliable method of getting the weapon that damaged an entity, use CTakeDamageInfo:GetWeapon or GetAttacker with GetActiveWeapon.
    -- @return --- The inflictor entity.
    GetInflictor: function(self): GEntity

    --- Returns the maximum damage. See CTakeDamageInfo:SetMaxDamage
    -- @return --- maxDmg
    GetMaxDamage: function(self): number

    --- Returns the initial, unmodified position where the damage occured.
    -- @return --- position
    GetReportedPosition: function(self): GVector

    --- Returns the inflicting weapon of the damage event, if there is any.
    --- This is not necessarily a Weapon entity, but it is very likely to be one.
    --- See CTakeDamageInfo:GetInflictor for the actual entity that did the damage.
    -- @return --- The damage-inflicting weapon or NULL.
    GetWeapon: function(self): GEntity

    --- Returns true if the damage was caused by a bullet.
    -- @return --- isBulletDmg
    IsBulletDamage: function(self): boolean

    --- Returns whenever the damageinfo contains the damage type specified.
    -- @param dmgType --- Damage type to test. See Enums/DMG.
    -- @return --- Whether this damage contains specified damage type or not
    IsDamageType: function(self, dmgType: E_DMG): boolean

    --- Returns whenever the damageinfo contains explosion damage.
    -- @return --- isExplDamage
    IsExplosionDamage: function(self): boolean

    --- Returns whenever the damageinfo contains fall damage.
    -- @return --- isFallDmg
    IsFallDamage: function(self): boolean

    --- Scales the damage by the given value.
    -- @param scale --- Value to scale the damage with.
    ScaleDamage: function(self, scale: number)

    --- Changes the ammo type used by the weapon that inflicted the damage.
    -- @param ammoType --- Ammo type ID
    SetAmmoType: function(self, ammoType: number)

    --- Sets the attacker ( character who originated the attack ) of the damage, for example a player or an NPC.
    -- @param ent --- The entity to be set as the attacker.
    SetAttacker: function(self, ent: GEntity)

    --- Sets the initial unmodified by skill level ( game.GetSkillLevel ) damage. This function will not update or touch CTakeDamageInfo:GetDamage.
    -- @param  --- baseDamage
    SetBaseDamage: function(self, _: number)

    --- Sets the amount of damage.
    -- @param damage --- The value to set the absolute damage to.
    SetDamage: function(self, damage: number)

    --- Sets the bonus damage. Bonus damage isn't automatically applied, so this will have no outer effect by default.
    -- @param damage --- The extra damage to be added.
    SetDamageBonus: function(self, damage: number)

    --- Sets the custom damage type. This is used by Day of Defeat: Source and Team Fortress 2 for extended damage info, but isn't used in Garry's Mod by default.
    -- @param DamageType --- Any integer - can be based on your own custom enums.
    SetDamageCustom: function(self, DamageType: number)

    --- Sets the directional force of the damage.
    --- **NOTE**: This function only affects entities using the VPHYSICS movetype. This means players and most NPCs won't receive the force vector you provide as knockback.
    --- If the entity taking damage is using the WALK or STEP movetypes, the damage force is instead automatically calculated. It will push the entity away from the inflictor's Entity:WorldSpaceCenter, scaling the push by a calculated value involving the total amount of damage and the size of the entity. [Source](https://github.com/ValveSoftware/source-sdk-2013/blob/0565403b153dfcde602f6f58d8f4d13483696a13/src/game/server/baseentity.cpp#L1525)
    --- To disable knockback entirely, see [EFL_NO_DAMAGE_FORCES](https://wiki.facepunch.com/gmod/Enums/EFL#EFL_NO_DAMAGE_FORCES) or use the workaround example below.
    -- @param force --- The vector to set the force to.
    SetDamageForce: function(self, force: GVector)

    --- Sets the position of where the damage gets applied to.
    -- @param pos --- The position where the damage will be applied.
    SetDamagePosition: function(self, pos: GVector)

    --- Sets the damage type.
    -- @param type --- The damage type, see Enums/DMG.
    SetDamageType: function(self, type: E_DMG)

    --- Sets the inflictor of the damage for example a weapon.
    --- For hitscan/bullet weapons this should the weapon.
    --- For projectile (rocket launchers, grenades, etc) weapons this should be the projectile and CTakeDamageInfo:SetWeapon should be the weapon.
    -- @param inflictor --- The new inflictor.
    SetInflictor: function(self, inflictor: GEntity)

    --- Sets the maximum damage this damage event can cause.
    -- @param maxDamage --- Maximum damage value.
    SetMaxDamage: function(self, maxDamage: number)

    --- Sets the origin of the damage.
    -- @param pos --- The location of where the damage is originating
    SetReportedPosition: function(self, pos: GVector)

    --- Sets the damage-inflicting weapon of the damage event.
    --- This should be a Weapon entity, not a projectile. See also CTakeDamageInfo:SetInflictor.
    -- @param  --- The damage-inflicting weapon or NULL.
    SetWeapon: function(self, _: GEntity)

    --- Subtracts the specified amount from the damage.
    -- @param damage --- Value to subtract.
    SubtractDamage: function(self, damage: number)
end


--- CSoundPatch class.
--- Created with Global.CreateSound
global interface GCSoundPatch
    --- Adjust the pitch, also known as the speed at which the sound is being played.
    --- Appears to only work while the sound is being played. See also CSoundPatch:PlayEx.
    --- This invokes GM:EntityEmitSound.
    -- @param pitch --- The pitch can range from 0-255. Where 100 is the original pitch.
    -- @param deltaTime --- The time to fade from previous to the new pitch.
    ChangePitch: function(self, pitch: number, deltaTime: number)

    --- Adjusts the volume of the sound played.
    --- Appears to only work while the sound is being played. See also CSoundPatch:PlayEx.
    -- @param volume --- The volume ranges from 0 to 1.
    -- @param deltaTime --- Time to fade the volume from previous to new value from.
    ChangeVolume: function(self, volume: number, deltaTime: number)

    --- Fades out the volume of the sound from the current volume to 0 in the given amount of seconds.
    -- @param seconds --- Fade time.
    FadeOut: function(self, seconds: number)

    --- Returns the DSP (Digital Signal Processor) effect ID for the sound.
    -- @return dspEffectId --- The numerical ID for the DSP effect currently enabled on the sound.
    --- For a list of the available IDs and their meaning, see DSP Presets.
    GetDSP: function(self): number

    --- Returns the current pitch.
    -- @return --- The current pitch, can range from 0-255.
    GetPitch: function(self): number

    --- Returns the current sound level.
    -- @return --- The current sound level, see Enums/SNDLVL.
    GetSoundLevel: function(self): number

    --- Returns the current volume.
    -- @return --- The current volume, ranging from 0 to 1.
    GetVolume: function(self): number

    --- Returns whenever the sound is being played.
    -- @return --- Is playing or not
    IsPlaying: function(self): boolean

    --- Starts to play the sound. This will reset the sound's volume and pitch to their default values. See CSoundPatch:PlayEx
    Play: function(self)

    --- Same as CSoundPatch:Play but with 2 extra arguments allowing to set volume and pitch directly.
    -- @param volume --- The volume ranges from 0 to 1.
    -- @param pitch --- The pitch can range from 0-255.
    PlayEx: function(self, volume: number, pitch: number)

    --- Sets the DSP (Digital Signal Processor) effect for the sound.
    --- Similar to Player:SetDSP but for individual sounds.
    -- @param dspEffectId --- The numerical ID for the DSP effect to be enabled on the sound.
    --- For a list of the available IDs and their meaning, see DSP Presets.
    SetDSP: function(self, dspEffectId: number)

    --- Sets the sound level in decibel.
    -- @param level --- The sound level in decibel. See Enums/SNDLVL
    SetSoundLevel: function(self, level: number)

    --- Stops the sound from being played.
    --- **BUG**: [This will not work if the entity attached to this sound patch (specified by Global.CreateSound) is invalid.](https://github.com/Facepunch/garrysmod-issues/issues/3260
    Stop: function(self)
end


--- CSEnt is a client-side only entity which can be created with Global.ClientsideModel, Global.ClientsideRagdoll and Global.ClientsideScene.
--- Its base class is Entity so it inherits all of the client and shared functions used by Entity.
global interface GCSEnt is GEntity
    --- Removes the clientside entity
    Remove: function(self)
end


--- List of all possible functions to manipulate Recipient Filters. Can be created with Global.RecipientFilter.
global interface GCRecipientFilter
    where true
    --- Adds all players to the recipient filter.
    AddAllPlayers: function(self)

    --- Adds all players that are in the same [PAS (Potentially Audible Set)](https://developer.valvesoftware.com/wiki/PAS "PAS - Valve Developer Community") as this position.
    -- @param pos --- A position that players may be able to hear, usually the position of an entity the sound is playing played from.
    AddPAS: function(self, pos: GVector)

    --- Adds all players that are in the same [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community") as this position.
    -- @param Position --- PVS position that players may be able to see.
    AddPVS: function(self, Position: GVector)

    --- Adds a player to the recipient filter
    -- @param Player --- Player to add to the recipient filter.
    AddPlayer: function(self, Player: GPlayer)

    --- Adds players to the recipient filter from a given table or another recipient filter.
    -- @param input --- The filter to add players from. This can also be a sequential table of players. Non player entities or duplicate players will be ignored.
    --AddPlayers: function(self, input: GCRecipientFilter|{GPlayer})

    --- Adds all players that are on the given team to the filter.
    -- @param teamid --- Team index to add players from.
    AddRecipientsByTeam: function(self, teamid: number)

    --- Returns the number of valid players in the recipient filter.
    -- @return --- Number of valid players in the recipient filter.
    GetCount: function(self): number

    --- Returns a table of all valid players currently in the recipient filter.
    -- @return --- A table of all valid players currently in the recipient filter.
    GetPlayers: function(self): {GPlayer}

    --- Removes all players from the recipient filter.
    RemoveAllPlayers: function(self)

    --- Remove players from this recipient filter that are **NOT** present in a given table or recipient filter.
    -- @param input --- The filter that contains a list of players to test against. Players **NOT** in the given filter will be removed from this filter.
    --- This can also be a sequential table of players. Non player entities will be ignored.
    RemoveMismatchedPlayers: function(self, input: GCRecipientFilter)

    --- Removes all players from the filter that are in [PAS (Potentially Audible Set)](https://developer.valvesoftware.com/wiki/PAS "PAS - Valve Developer Community") for given position.
    -- @param position --- The position to test
    RemovePAS: function(self, position: GVector)

    --- Removes all players that can see this [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community") from the recipient filter.
    -- @param pos --- Position that players may be able to see.
    RemovePVS: function(self, pos: GVector)

    --- Removes the player from the recipient filter.
    -- @param Player --- The player that should be in the recipient filter if you call this function.
    RemovePlayer: function(self, Player: GPlayer)

    --- Remove players from this recipient filter that are present in a given table or recipient filter.
    -- @param input --- The filter that contains a list of players to remove. This can also be a sequential table of players. Non player entities will be ignored. If a player in the given table/filter is not present in this filter, it is ignored.
    RemovePlayers: function(self, input: GCRecipientFilter)

    --- Removes all players that are on the given team from the filter.
    -- @param teamid --- Team index to remove players from.
    RemoveRecipientsByTeam: function(self, teamid: number)

    --- Removes all players that are not on the given team from the filter.
    -- @param teamid --- Team index.
    RemoveRecipientsNotOnTeam: function(self, teamid: number)
end


--- An object returned by Global.CreateConVar, Global.CreateClientConVar (which uses Global.CreateConVar internally), and Global.GetConVar.
--- It represents a console variable. See this page for more information.
global interface GConVar
    --- Tries to convert the current string value of a ConVar to a boolean.
    -- @return --- The boolean value of the console variable. If the variable is numeric and not 0, the result will be `true`. Otherwise the result will be `false`.
    GetBool: function(self): boolean

    --- Returns the default value of the ConVar
    -- @return --- The default value of the console variable.
    GetDefault: function(self): string

    --- Returns the Enums/FCVAR flags of the ConVar
    -- @return flag --- The bitflag. See Enums/FCVAR
    GetFlags: function(self): number

    --- Attempts to convert the ConVar value to a float
    -- @return --- The float value of the console variable.
    --- If the value cannot be converted to a float, it will return 0.
    GetFloat: function(self): number

    --- Returns the help text assigned to that convar.
    -- @return --- The help text
    GetHelpText: function(self): string

    --- Attempts to convert the ConVar value to a integer.
    -- @return --- The integer value of the console variable.
    --- If it fails to convert to an integer, it will return 0.
    --- All float/decimal values will be rounded down. ( With math.floor )
    GetInt: function(self): number

    --- Returns the maximum value of the ConVar
    -- @return --- The maximum value of the ConVar
    GetMax: function(self): number

    --- Returns the minimum value of the ConVar
    -- @return --- The minimum value of the ConVar
    GetMin: function(self): number

    --- Returns the name of the ConVar.
    -- @return --- The name of the console variable.
    GetName: function(self): string

    --- Returns the current ConVar value as a string.
    -- @return --- The current console variable value as a string.
    GetString: function(self): string

    --- Returns whether the specified flag is set on the ConVar
    -- @param flag --- The Enums/FCVAR flag to test
    -- @return --- Whether the flag is set or not
    IsFlagSet: function(self, flag: number): boolean

    --- Reverts ConVar to its default value
    --- **NOTE**: This can only be ran on ConVars created from within Lua.
    Revert: function(self)

    --- Sets a ConVar's value to 1 or 0 based on the input boolean. This can only be ran on ConVars created from within Lua.
    -- @param value --- Value to set the ConVar to.
    SetBool: function(self, value: boolean)

    --- Sets a ConVar's value to the input number.
    --- **NOTE**: This can only be ran on ConVars created from within Lua.
    -- @param value --- Value to set the ConVar to.
    SetFloat: function(self, value: number)

    --- Sets a ConVar's value to the input number after converting it to an integer.
    --- **NOTE**: This can only be ran on ConVars created from within Lua.
    -- @param value --- Value to set the ConVar to.
    SetInt: function(self, value: number)

    --- Sets a ConVar's value to the input string. This can only be ran on ConVars created from within Lua.
    -- @param value --- Value to set the ConVar to.
    SetString: function(self, value: string)
end


--- List of all possible functions to manipulate colors.
--- Colors are implemented in Lua thus Global.type(color) == "table" and Global.TypeID(color) == TYPE_TABLE.
--- For type checking use Global.IsColor.
--- Created by Global.Color, Global.HSVToColor, and Global.HSLToColor.
--- | Type                | Name  | Description                       |
--- | ------------------- | ----- | --------------------------------- |
--- | number | **r** | The red component of the color.   |
--- | number | **g** | The green component of the color. |
--- | number | **b** | The blue component of the color.  |
--- | number | **a** | The alpha component of the color. |
global interface GColor
    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model), adds given value to the "blackness" and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetBlackness & COLOR:SetBlackness
    -- @param blackness --- The "blackness" value to add in range [0, 1]
    AddBlackness: function(self, blackness: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), adds given value to the [brightness also known as "value"](https://en.wikipedia.org/wiki/Brightness) and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetBrightness & COLOR:SetBrightness
    --- This is useful to quickly change the saturation of the color without changing hue or luminance, allowing for things like easy theming.
    -- @param saturation --- The brightness value to add in range [0, 1]
    AddBrightness: function(self, saturation: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), adds given value to the [hue](https://en.wikipedia.org/wiki/Hue) and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetHue & COLOR:SetHue
    --- This is useful to quickly change the hue of the color without changing saturation or luminance, allowing for things like easy theming.
    -- @param hue --- The hue value to add in degrees [0, 360).
    AddHue: function(self, hue: number)

    --- Converts a Color into [HSL color space](https://en.wikipedia.org/wiki/HSL_and_HSV), adds given value to the ["lightness"](https://en.wikipedia.org/wiki/Lightness) and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetLightness & COLOR:SetLightness
    --- This is useful to quickly change the lightness of the color without changing hue or saturation, allowing for things like easy theming.
    -- @param lightness --- The lightness value to add in range [0, 1]
    AddLightness: function(self, lightness: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), adds given value to the [saturation](https://en.wikipedia.org/wiki/Colorfulness) and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetSaturation & COLOR:SetSaturation
    --- This is useful to quickly change the saturation of the color without changing hue or luminance, allowing for things like easy theming.
    -- @param saturation --- The saturation value to add in range [0, 1]
    AddSaturation: function(self, saturation: number)

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model), adds given value to the "whiteness" and converts it back into an RGB color.
    --- A slightly more efficient combination of COLOR:GetWhiteness & COLOR:SetWhiteness
    -- @param whiteness --- The "whiteness" value to add in range [0, 1]
    AddWhiteness: function(self, whiteness: number)

    --- Returns a copy of this color, usually so it can be safely modified later without affecting the original color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L183-L187)
    -- @return --- The copy of the given color, safe to modify.
    Copy: function(self): GColor

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model) and returns the "blackness" of the color.
    --- See COLOR:ToHWB if you want to get all 3 components.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L349-L354)
    -- @return blackness --- Blackness of the color in range [0, 1]
    GetBlackness: function(self): number

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV) and returns the [brightness also known as "value"](https://en.wikipedia.org/wiki/Brightness).
    --- See COLOR:ToHSV if you want to get all 3 components.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L277-L282)
    -- @return brightness --- Brightness in range [0, 1]
    GetBrightness: function(self): number

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV) and returns the [hue](https://en.wikipedia.org/wiki/Hue).
    --- See COLOR:ToHSV if you want to get all 3 components.
    -- @return hue --- The hue in degrees [0, 360).
    GetHue: function(self): number

    --- Converts a Color into [HSL color space](https://en.wikipedia.org/wiki/HSL_and_HSV) and returns the ["lightness"](https://en.wikipedia.org/wiki/Lightness) of the color.
    --- See COLOR:ToHSL if you want to get all 3 components.
    -- @return lightness --- Lightness in range [0, 1]
    GetLightness: function(self): number

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV) and returns the [saturation](https://en.wikipedia.org/wiki/Colorfulness).
    --- See COLOR:ToHSV if you want to get all 3 components.
    -- @return saturation --- Saturation in range [0, 1]
    GetSaturation: function(self): number

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model) and returns the "whiteness" of the color.
    --- See COLOR:ToHWB if you want to get all 3 components.
    -- @return whiteness --- Whiteness of the color in range [0, 1]
    GetWhiteness: function(self): number

    --- Performs linear interpolation between this and given colors.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L183-L192)
    -- @param target --- The target color to interpolate towards.
    -- @param fraction --- The interpolation fraction. `0` means fully original color, `0.5` means in the middle between the 2 colors, `1` means fully target color, etc.
    -- @return --- The result of linear interpolation.
    Lerp: function(self, target: GColor, fraction: number): GColor

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model), sets the "blackness" and converts it back into an RGB color.
    -- @param blackness --- The new "blackness" value in range [0, 1]
    SetBlackness: function(self, blackness: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), sets the [brightness also known as "value"](https://en.wikipedia.org/wiki/Brightness) and converts it back into an RGB color.
    --- This is useful to quickly change the brightness of the color without changing hue or saturation, allowing for things like easy theming.
    -- @param saturation --- The new brightness value in range [0, 1]
    SetBrightness: function(self, saturation: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), sets the [hue](https://en.wikipedia.org/wiki/Hue) and converts it back into an RGB color.
    --- This is useful to quickly change the hue of the color without changing saturation or luminance, allowing for things like easy theming.
    -- @param hue --- The new hue value in degrees [0, 360).
    SetHue: function(self, hue: number)

    --- Converts a Color into [HSL color space](https://en.wikipedia.org/wiki/HSL_and_HSV), sets the ["lightness"](https://en.wikipedia.org/wiki/Lightness) and converts it back into an RGB color.
    --- This is useful to quickly change the lightness of the color without changing hue or saturation, allowing for things like easy theming.
    -- @param lightness --- The new lightness value in range [0, 1]
    SetLightness: function(self, lightness: number)

    --- Converts a Color into [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV), sets the [saturation](https://en.wikipedia.org/wiki/Colorfulness) and converts it back into an RGB color.
    --- This is useful to quickly change the saturation of the color without changing hue or luminance, allowing for things like easy theming.
    -- @param saturation --- The new saturation value in range [0, 1]
    SetSaturation: function(self, saturation: number)

    --- Sets the red, green, blue, and alpha of the color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L94-L101)
    -- @param r --- The red component
    -- @param g --- The green component
    -- @param b --- The blue component
    -- @param a --- The alpha component
    SetUnpacked: function(self, r: number, g: number, b: number, a: number)

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model), sets the "whiteness" and converts it back into an RGB color.
    -- @param whiteness --- The new "whiteness" value in range [0, 1]
    SetWhiteness: function(self, whiteness: number)

    --- Converts a Color into [HSL color space](https://en.wikipedia.org/wiki/HSL_and_HSV) .
    --- This calls Global.ColorToHSL internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L140-L144)
    -- @return --- The hue in degrees [0, 360).
    -- @return --- The saturation in the range [0, 1].
    -- @return --- The lightness in the range [0, 1].
    ToHSL: function(self): number, number, number

    --- Encodes a RGB Color into the [HSV color space](https://en.wikipedia.org/wiki/HSL_and_HSV).
    --- This function uses Global.ColorToHSV internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L149-L153)
    -- @return hue --- Hue in degrees in range [0, 360)
    -- @return saturation --- Saturation in range [0, 1]
    -- @return brightness --- Brightness in range [0, 1]
    ToHSV: function(self): number, number, number

    --- Converts a Color into [HWB color space](https://en.wikipedia.org/wiki/HWB_color_model). See Global.HWBToColor for more info.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L158-L163)
    -- @return hue --- The hue in degrees [0, 360).
    -- @return whiteness --- The whiteness in the range [0, 1].
    -- @return blackness --- The blacknessin the range [0, 1].
    ToHWB: function(self): number, number, number

    --- Converts a Color to its hexadecimal representation.
    -- @param  --- Whether to forcibly omit the alpha channel from the output.
    -- @return --- The hexadecimal representation of the color. (`#RRGGBBAA`)
    --- If the alpha channel is `255`, it will be omitted from the output (`#RRGGBB`)
    ToHex: function(self, _: boolean): string

    --- Returns the color as a table (an array or a list) with four elements.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L103-L107)
    -- @return --- The table with elements 1 = r, 2 = g, 3 = b, 4 = a,( `{ r, g, b, a }` )
    ToTable: function(self): {number}

    --- Translates the Color into a Vector, losing the alpha channel.
    --- This will also range the values from 0 - 255 to 0 - 1
    --- r / 255 -> x
    --- g / 255 -> y
    --- b / 255 -> z
    --- This is the opposite of Vector:ToColor
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L168-L172)
    -- @return --- The created Vector
    ToVector: function(self): GVector

    --- Returns the red, green, blue, and alpha of the color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/color.lua#L177-L181)
    -- @return --- Red
    -- @return --- Green
    -- @return --- Blue
    -- @return --- Alpha
    Unpack: function(self): number, number, number, number
end


--- This object represents a .pcf ( Orange Box ) particle system. Created by Entity:CreateParticleEffect and Global.CreateParticleSystem.
global interface GCNewParticleEffect
    --- Adds a control point to the particle system.
    --- **NOTE**: This function will not work if the CNewParticleEffect:GetOwner entity is not valid
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param ent --- The entity to attach the control point to.
    -- @param partAttachment --- See Enums/PATTACH.
    -- @param entAttachment --- The attachment name on the entity to attach the particle system to
    -- @param offset --- The offset from the Entity:GetPos of the entity we are attaching this CP to.
    AddControlPoint: function(self, cpID: number, ent: GEntity, partAttachment: number, entAttachment: string, offset: GVector)

    ---
    -- @return ---
    GetAutoUpdateBBox: function(self): boolean

    --- Returns the name of the particle effect this system is set to emit.
    -- @return --- The name of the particle effect.
    GetEffectName: function(self): string

    --- Returns the highest control point number for given particle system.
    -- @return --- The highest control point number for given particle system, 0 to 63.
    GetHighestControlPoint: function(self): boolean

    --- Returns the owner of the particle system, the entity the particle system is attached to.
    -- @return --- The owner of the particle system.
    GetOwner: function(self): GEntity

    --- Returns the bounding box of the particle effect, including all the particles it emitted.
    -- @return --- Mins of the bounding box.
    -- @return --- Maxs of the bounding box.
    GetRenderBounds: function(self): GVector, GVector

    --- Returns whether the particle system simulation was paused by CNewParticleEffect:SetShouldSimulate.
    -- @return --- Whether the simulation is running (`true`) or not (`false`).
    GetShouldSimulate: function(self): boolean

    --- Returns whether the particle system has finished emitting particles or not.
    -- @return --- Whether the particle system has finished emitting particles or not.
    IsFinished: function(self): boolean

    --- Returns whether the particle system is valid or not.
    -- @return --- Whether the particle system is valid or not.
    IsValid: function(self): boolean

    --- Returns whether the particle system is intended to be used on a view model?
    -- @return ---
    IsViewModelEffect: function(self): boolean

    --- Forces the particle system to render using current rendering context.
    --- Can be used to render the particle system in vgui panels, etc.
    --- Used in conjunction with CNewParticleEffect:SetShouldDraw.
    Render: function(self)

    --- Forces the particle system to restart emitting particles.
    Restart: function(self)

    --- Sets a value for given control point.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param value --- The value to set for given control point.
    SetControlPoint: function(self, cpID: number, value: GVector)

    --- Sets an entity to given control point for particle to use.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param parent --- The entity to set.
    SetControlPointEntity: function(self, cpID: number, parent: GEntity)

    --- Sets the forward direction for given control point.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param forward --- The forward direction for given control point
    SetControlPointForwardVector: function(self, cpID: number, forward: GVector)

    --- Sets the orientation for given control point.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param forward --- The forward direction for given control point.
    --- This can also be an Angle, in which case the other 2 arguments are not used.
    -- @param right --- The right direction for given control point
    -- @param up --- The up direction for given control point
    SetControlPointOrientation: function(self, cpID: number, forward: GVector, right: GVector, up: GVector)

    --- Essentially makes child control point follow the parent control point.
    -- @param childID --- The child control point ID, 0 to 63.
    -- @param parentID --- The parent control point ID, 0 to 63.
    SetControlPointParent: function(self, childID: number, parentID: number)

    --- Sets the right direction for given control point.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param right --- The right direction for given control point.
    SetControlPointRightVector: function(self, cpID: number, right: GVector)

    --- Sets the upward direction for given control point.
    -- @param cpID --- The control point ID, 0 to 63.
    -- @param upward --- The upward direction for given control point
    SetControlPointUpVector: function(self, cpID: number, upward: GVector)

    --- Set whether this particle effect is a view model effect or not. This will have an effect on attachment positioning and other things.
    -- @param isViewModel --- Whether this particle effect is a view model effect or not.
    SetIsViewModelEffect: function(self, isViewModel: boolean)

    --- Forces the particle system to stop automatically rendering.
    --- Used in conjunction with CNewParticleEffect:Render.
    -- @param should --- Whether to automatically draw the particle effect or not.
    SetShouldDraw: function(self, should: boolean)

    --- Sets whether the particle system should continue simulation or not. If simulation is paused, all currently active particles will be frozen in place.
    -- @param simulate --- Whether the simulation should run (`true`) or not (`false`).
    SetShouldSimulate: function(self, simulate: boolean)

    --- Sets the sort origin for given particle system. This is used as a helper to determine which particles are in front of which.
    -- @param origin --- The new sort origin.
    SetSortOrigin: function(self, origin: GVector)

    --- Starts the particle emission.
    -- @param infiniteOnly ---
    StartEmission: function(self, infiniteOnly: boolean)

    --- Stops the particle emission.
    -- @param infiniteOnly ---
    -- @param removeAllParticles ---
    -- @param wakeOnStop ---
    StopEmission: function(self, infiniteOnly: boolean, removeAllParticles: boolean, wakeOnStop: boolean)

    --- Stops particle emission and destroys all particles instantly. Also detaches the particle effect from the entity it was attached to.
    --- **NOTE**: This function will work identically to CNewParticleEffect:StopEmission( false, true ) if  CNewParticleEffect:GetOwner entity is not valid.
    --- Consider using CNewParticleEffect:StopEmission( false, true ) instead, which has same effect, but doesn't require owner entity, and does't detach the particle system from its entity.
    StopEmissionAndDestroyImmediately: function(self)
end


--- An object that represents a ladder for Nextbots.
global interface GCNavLadder
    --- Connects this ladder to a CNavArea with a one way connection. ( From this ladder to the target area ).
    --- See CNavArea:ConnectTo for making the connection from area to ladder.
    -- @param area --- The area this ladder leads to.
    ConnectTo: function(self, area: GCNavArea)

    --- Disconnects this ladder from given area in a single direction.
    -- @param area --- The CNavArea this to disconnect from.
    Disconnect: function(self, area: GCNavArea)

    --- Returns the bottom most position of the ladder.
    -- @return --- The bottom most position of the ladder.
    GetBottom: function(self): GVector

    --- Returns the bottom area of the CNavLadder.
    -- @return ---
    GetBottomArea: function(self): GCNavArea

    --- Returns this CNavLadders unique ID.
    -- @return --- The unique ID.
    GetID: function(self): number

    --- Returns the length of the ladder.
    -- @return --- The length of the ladder.
    GetLength: function(self): number

    --- Returns the direction of this CNavLadder. ( The direction in which players back will be facing if they are looking directly at the ladder )
    -- @return --- The direction of this CNavLadder.
    GetNormal: function(self): GVector

    --- Returns the world position based on given height relative to the ladder.
    -- @param height --- The Z position in world space coordinates.
    -- @return --- The closest point on the ladder to that height.
    GetPosAtHeight: function(self, height: number): GVector

    --- Returns the topmost position of the ladder.
    -- @return --- The topmost position of the ladder.
    GetTop: function(self): GVector

    --- Returns the top behind CNavArea of the CNavLadder.
    -- @return --- The top behind CNavArea of the CNavLadder.
    GetTopBehindArea: function(self): GCNavArea

    --- Returns the top forward CNavArea of the CNavLadder.
    -- @return --- The top forward CNavArea of the CNavLadder.
    GetTopForwardArea: function(self): GCNavArea

    --- Returns the top left CNavArea of the CNavLadder.
    -- @return --- The top left CNavArea of the CNavLadder.
    GetTopLeftArea: function(self): GCNavArea

    --- Returns the top right CNavArea of the CNavLadder.
    -- @return --- The top right CNavArea of the CNavLadder.
    GetTopRightArea: function(self): GCNavArea

    --- Returns the width of the ladder in Hammer Units.
    -- @return --- The width of the ladder in Hammer Units.
    GetWidth: function(self): number

    --- Returns whether this CNavLadder has an outgoing ( one or two way ) connection **to** given CNavArea in given direction.
    -- @param navArea --- The CNavArea to test against.
    -- @param navDirType --- The direction, in which to look for the connection. See Enums/NavDir
    -- @return --- Whether this CNavLadder has an outgoing ( one or two way ) connection **to** given CNavArea in given direction.
    IsConnectedAtSide: function(self, navArea: GCNavArea, navDirType: number): boolean

    --- Returns whether this CNavLadder is valid or not.
    -- @return --- Whether this CNavLadder is valid or not.
    IsValid: function(self): boolean

    --- Removes the given nav ladder.
    Remove: function(self)

    --- Sets the bottom area of the CNavLadder.
    -- @param area ---
    SetBottomArea: function(self, area: GCNavArea)

    --- Sets the top behind area of the CNavLadder.
    -- @param area ---
    SetTopBehindArea: function(self, area: GCNavArea)

    --- Sets the top forward area of the CNavLadder.
    -- @param area ---
    SetTopForwardArea: function(self, area: GCNavArea)

    --- Sets the top left area of the CNavLadder.
    -- @param area ---
    SetTopLeftArea: function(self, area: GCNavArea)

    --- Sets the top right area of the CNavLadder.
    -- @param area ---
    SetTopRightArea: function(self, area: GCNavArea)
end


--- An object returned by navmesh functions.
global interface GCNavArea
    --- Adds given attributes to given CNavArea. See CNavArea:HasAttributes and CNavArea:SetAttributes.
    -- @param attribs --- The attributes to add, as a bitflag. See Enums/NAV_MESH.
    AddAttributes: function(self, attribs: number)

    --- Adds a hiding spot onto this nav area.
    --- There's a limit of 255 hiding spots per area.
    -- @param pos --- The position on the nav area
    -- @param flags --- Flags describing what kind of hiding spot this is.
    --- * 0 = None (Not recommended)
    --- * 1 = In Cover/basically a hiding spot, in a corner with good hard cover nearby
    --- * 2 = good sniper spot, had at least one decent sniping corridor
    --- * 4 = perfect sniper spot, can see either very far, or a large area, or both
    --- * 8 = exposed, spot in the open, usually on a ledge or cliff
    --- Values over 255 will be clamped.
    AddHidingSpot: function(self, pos: GVector, flags: number)

    --- Adds this CNavArea to the closed list, a list of areas that have been checked by A* pathfinding algorithm.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    AddToClosedList: function(self)

    --- Adds this CNavArea to the Open List.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    AddToOpenList: function(self)

    --- Clears the open and closed lists for a new search.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    ClearSearchLists: function(self)

    --- Returns the height difference between the edges of two connected navareas.
    -- @param navarea ---
    -- @return --- The height change
    ComputeAdjacentConnectionHeightChange: function(self, navarea: GCNavArea): number

    --- Returns the Enums/NavDir direction that the given vector faces on this CNavArea.
    -- @param pos --- The position to compute direction towards.
    -- @return --- The direction the vector is in relation to this CNavArea. See Enums/NavDir.
    ComputeDirection: function(self, pos: GVector): number

    --- Returns the height difference on the Z axis of the two CNavAreas. This is calculated from the center most point on both CNavAreas.
    -- @param navArea --- The nav area to test against.
    -- @return --- The ground height change.
    ComputeGroundHeightChange: function(self, navArea: GCNavArea): number

    --- Connects this CNavArea to another CNavArea or CNavLadder with a one way connection. ( From this area to the target )
    --- See CNavLadder:ConnectTo for making the connection from ladder to area.
    -- @param area --- The CNavArea or CNavLadder this area leads to.
    ConnectTo: function(self, area: GCNavArea)

    --- Returns true if this CNavArea contains the given vector.
    -- @param pos --- The position to test.
    -- @return --- True if the vector was inside and false otherwise.
    Contains: function(self, pos: GVector): boolean

    --- Disconnects this nav area from given area or ladder. (Only disconnects one way)
    -- @param area --- The CNavArea or CNavLadder this to disconnect from.
    Disconnect: function(self, area: GCNavArea)

    --- Draws this navarea on debug overlay.
    Draw: function(self)

    --- Draws the hiding spots on debug overlay. This includes sniper/exposed spots too!
    DrawSpots: function(self)

    --- Returns a list of all the CNavAreas that have a (one and two way) connection **from** this CNavArea and their pre-computed distances.
    --- If an area has a one-way incoming connection to this CNavArea, then it will **not** be returned from this function, use CNavArea:GetIncomingConnectionDistances to get all one-way incoming connections.
    -- @param dir --- If set, will only return areas in the specified direction. See Enums/NavDir.
    -- @return --- A list of tables in the following format:
    --- * CNavArea **area** - the area that is connected to this area.
    --- * number **dist** - Distance from the area to this area.
    --- * number **dir** - Direction in which the area is in relative to this area.
    GetAdjacentAreaDistances: function(self, dir: number): table

    --- Returns a list of all the CNavAreas that have a  (one and two way) connection **from** this CNavArea.
    --- If an area has a one-way incoming connection to this CNavArea, then it will **not** be returned from this function, use CNavArea:GetIncomingConnections to get all one-way incoming connections.
    --- See CNavArea:GetAdjacentAreasAtSide for a function that only returns areas from one side/direction.
    -- @return --- A list of all CNavArea that have a (one and two way) connection **from** this CNavArea.
    --- Returns an empty table if this area has no outgoing connections to any other areas.
    GetAdjacentAreas: function(self): table

    --- Returns a table of all the CNavAreas that have a ( one and two way ) connection **from** this CNavArea in given direction.
    --- If an area has a one-way incoming connection to this CNavArea, then it will **not** be returned from this function, use CNavArea:GetIncomingConnections to get all incoming connections.
    --- See CNavArea:GetAdjacentAreas for a function that returns all areas from all sides/directions.
    -- @param navDir --- The direction, in which to look for CNavAreas, see Enums/NavDir.
    -- @return --- A table of all CNavArea that have a ( one and two way ) connection **from** this CNavArea in given direction.
    --- Returns an empty table if this area has no outgoing connections to any other areas in given direction.
    GetAdjacentAreasAtSide: function(self, navDir: number): table

    --- Returns the amount of CNavAreas that have a connection ( one and two way ) **from** this CNavArea.
    --- See CNavArea:GetAdjacentCountAtSide for a function that only returns area count from one side/direction.
    -- @return --- The amount of CNavAreas that have a connection ( one and two way ) **from** this CNavArea.
    GetAdjacentCount: function(self): number

    --- Returns the amount of CNavAreas that have a connection ( one or two way ) **from** this CNavArea in given direction.
    --- See CNavArea:GetAdjacentCount for a function that returns CNavArea count from/in all sides/directions.
    -- @param navDir --- The direction, in which to look for CNavAreas, see Enums/NavDir.
    -- @return --- The amount of CNavAreas that have a connection ( one or two way ) **from** this CNavArea in given direction.
    GetAdjacentCountAtSide: function(self, navDir: number): number

    --- Returns the attribute mask for the given CNavArea.
    -- @return --- Attribute mask for this CNavArea, see Enums/NAV_MESH for the specific flags.
    --- **NOTE**: A navmesh that was generated with nav_quicksave set to 1 will have all CNavAreas attribute masks set to 0
    GetAttributes: function(self): number

    --- Returns the center most vector point for the given CNavArea.
    -- @return --- The center vector.
    GetCenter: function(self): GVector

    --- Returns the closest point of this Nav Area from the given position.
    -- @param pos --- The given position, can be outside of the Nav Area bounds.
    -- @return --- The closest position on this Nav Area.
    GetClosestPointOnArea: function(self, pos: GVector): GVector

    --- Returns the vector position of the corner for the given CNavArea.
    -- @param cornerid --- The target corner to get the position of, takes Enums/NavCorner.
    -- @return --- The corner position.
    GetCorner: function(self, cornerid: number): GVector

    --- Returns the cost from starting area this area when pathfinding. Set by CNavArea:SetCostSoFar.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- The cost so far.
    GetCostSoFar: function(self): number

    --- Returns a table of very bad hiding spots in this area.
    --- See also CNavArea:GetHidingSpots.
    -- @return --- A table of Vectors
    GetExposedSpots: function(self): table

    --- Returns size info about the nav area.
    -- @return --- Returns a table containing the following keys:
    --- * Vector hi|
    --- * Vector lo|
    --- * number SizeX|
    --- * number SizeY|
    --- * number SizeZ|
    GetExtentInfo: function(self): table

    --- Returns a table of good hiding spots in this area.
    --- See also CNavArea:GetExposedSpots.
    -- @param type --- The type of spots to include.
    --- * 0 = None (Not recommended)
    --- * 1 = In Cover/basically a hiding spot, in a corner with good hard cover nearby
    --- * 2 = good sniper spot, had at least one decent sniping corridor
    --- * 4 = perfect sniper spot, can see either very far, or a large area, or both
    --- * 8 = exposed, spot in the open, usually on a ledge or cliff, same as GetExposedSpots
    --- * Values over 255 and below 0 will be clamped.
    -- @return --- A table of Vectors
    GetHidingSpots: function(self, type: number): table

    --- Returns this CNavAreas unique ID.
    -- @return --- The unique ID.
    GetID: function(self): number

    --- Returns a table of all the CNavAreas that have a one-way connection **to** this CNavArea and their pre-computed distances.
    --- If a CNavArea has a two-way connection **to or from** this CNavArea then it will not be returned from this function, use CNavArea:GetAdjacentAreaDistances to get outgoing (one and two way) connections.
    -- @param dir --- If set, will only return areas in the specified direction. See Enums/NavDir.
    -- @return --- A list of tables in the following format:
    --- * CNavArea **area** - the area that is connected to this area.
    --- * number **dist** - Distance from the area to this area.
    --- * number **dir** - Direction in which the area is in relative to this area.
    GetIncomingConnectionDistances: function(self, dir: number): table

    --- Returns a table of all the CNavAreas that have a one-way connection **to** this CNavArea.
    --- If a CNavArea has a two-way connection **to or from** this CNavArea then it will not be returned from this function, use CNavArea:GetAdjacentAreas to get outgoing ( one and two way ) connections.
    --- See CNavArea:GetIncomingConnectionsAtSide for a function that returns one-way incoming connections from  only one side/direction.
    -- @return --- A table of all CNavAreas with one-way connection **to** this CNavArea.
    --- Returns an empty table if there are no one-way incoming connections **to** this CNavArea.
    GetIncomingConnections: function(self): {GCNavArea}

    --- Returns a table of all the CNavAreas that have a one-way connection **to** this CNavArea from given direction.
    --- If a CNavArea has a two-way connection **to or from** this CNavArea then it will not be returned from this function, use CNavArea:GetAdjacentAreas to get outgoing ( one and two way ) connections.
    --- See CNavArea:GetIncomingConnections for a function that returns one-way incoming connections from  all sides/directions.
    -- @param navDir --- The direction, from which to look for CNavAreas, see Enums/NavDir.
    -- @return --- A table of all CNavAreas with one-way connection **to** this CNavArea from given direction.
    --- Returns an empty table if there are no one-way incoming connections **to** this CNavArea from given direction.
    GetIncomingConnectionsAtSide: function(self, navDir: number): table

    --- Returns all CNavLadders that have a ( one or two way ) connection **from** this CNavArea.
    --- See CNavArea:GetLaddersAtSide for a function that only returns CNavLadders in given direction.
    -- @return --- The CNavLadders that have a ( one or two way ) connection **from** this CNavArea.
    GetLadders: function(self): {GCNavLadder}

    --- Returns all CNavLadders that have a ( one or two way ) connection **from** ( one and two way ) this CNavArea in given direction.
    --- See CNavArea:GetLadders for a function that returns CNavLadder from/in all sides/directions.
    -- @param navDir --- The direction, in which to look for CNavLadders.
    --- 0 = Up ( LadderDirectionType::LADDER_UP )
    --- 1 = Down ( LadderDirectionType::LADDER_DOWN )
    -- @return --- The CNavLadders that have a ( one or two way ) connection **from** this CNavArea in given direction.
    GetLaddersAtSide: function(self, navDir: number): table

    --- Returns the parent CNavArea
    -- @return --- The parent CNavArea
    GetParent: function(self): GCNavArea

    --- Returns how this CNavArea is connected to its parent.
    -- @return --- See Enums/NavTraverseType
    GetParentHow: function(self): number

    --- Returns the Place of the nav area.
    -- @return --- The place of the nav area, or no value if it doesn't have a place set.
    GetPlace: function(self): string

    --- Returns a random CNavArea that has an outgoing ( one or two way ) connection **from** this CNavArea in given direction.
    -- @param navDir --- The direction, in which to look for CNavAreas, see Enums/NavDir.
    -- @return --- The random CNavArea that has an outgoing ( one or two way ) connection **from** this CNavArea in given direction, if any.
    GetRandomAdjacentAreaAtSide: function(self, navDir: number): GCNavArea

    --- Returns a random point on the nav area.
    -- @return --- The random point on the nav area.
    GetRandomPoint: function(self): GVector

    --- Returns the width this Nav Area.
    -- @return ---
    GetSizeX: function(self): number

    --- Returns the height of this Nav Area.
    -- @return ---
    GetSizeY: function(self): number

    --- Returns all possible path segments through a CNavArea, and the dangerous spots to look at as we traverse that path segment.
    -- @return encounters --- A sequential list of spot encounters in the following format:
    --- * CNavArea **from** - What CNavArea the path segment is coming from
    --- * Vector **from_pos** - Origin position of the path segment
    --- * number **from_dir** - Source Enums/NavDir direction of the path segment
    --- * CNavArea **to** - What CNavArea the path segment is going towards
    --- * Vector **to_pos** - Target position of the path segment
    --- * number **to_dir** - Target Enums/NavDir direction of the path segment
    --- * table **spots** - List of spots to look at, a sequential list of the following structures:
    --- * Vector **pos** - Position of the spot
    --- * table **flags** - Type of spot this is
    --- * CNavArea **area** - The nav area the spot belongs to
    GetSpotEncounters: function(self): table

    --- Returns the total cost when passing from starting area to the goal area through this node. Set by CNavArea:SetTotalCost.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- The total cost
    GetTotalCost: function(self): number

    --- Returns all CNavAreas that are visible from this CNavArea.
    -- @return areas --- A sequential table containing all CNavAreas that are visible from this CNavArea.
    GetVisibleAreas: function(self): table

    --- Returns the elevation of this Nav Area at the given position.
    -- @param pos --- The position to get the elevation from, the z value from this position is ignored and only the X and Y values are used to this task.
    -- @return --- The elevation.
    GetZ: function(self, pos: GVector): number

    --- Returns true if the given CNavArea has this attribute flag set.
    -- @param attribs --- Attribute mask to check for, see Enums/NAV_MESH
    -- @return --- True if the CNavArea matches the given mask. False otherwise.
    HasAttributes: function(self, attribs: number): boolean

    --- Returns whether the nav area is blocked or not, i.e. whether it can be walked through or not.
    -- @param teamID --- The team ID to test, -2 = any team.
    --- Only 2 actual teams are available, 0 and 1.
    -- @param ignoreNavBlockers --- Whether to ignore [func_nav_blocker](https://developer.valvesoftware.com/wiki/Func_nav_blocker) entities.
    -- @return --- Whether the area is blocked or not
    IsBlocked: function(self, teamID: number, ignoreNavBlockers: boolean): boolean

    --- Returns whether this node is in the Closed List.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- Whether this node is in the Closed List.
    IsClosed: function(self): boolean

    --- Returns whether this CNavArea can completely (i.e. all corners of this area can see all corners of the given area) see the given CNavArea.
    -- @param area --- The CNavArea to test.
    -- @return --- Whether the given area is visible from this area
    IsCompletelyVisible: function(self, area: GCNavArea): boolean

    --- Returns whether this CNavArea has an outgoing ( one or two way ) connection **to** given CNavArea.
    --- See CNavArea:IsConnectedAtSide for a function that only checks for outgoing connections in one direction.
    -- @param navArea --- The CNavArea to test against.
    -- @return --- Whether this CNavArea has an outgoing ( one or two way ) connection **to** given CNavArea.
    IsConnected: function(self, navArea: GCNavArea): boolean

    --- Returns whether this CNavArea has an outgoing ( one or two way ) connection **to** given CNavArea in given direction.
    --- See CNavArea:IsConnected for a function that checks all sides.
    -- @param navArea --- The CNavArea to test against.
    -- @param navDirType --- The direction, in which to look for the connection. See Enums/NavDir
    -- @return --- Whether this CNavArea has an outgoing ( one or two way ) connection **to** given CNavArea in given direction.
    IsConnectedAtSide: function(self, navArea: GCNavArea, navDirType: number): boolean

    --- Returns whether this Nav Area is in the same plane as the given one.
    -- @param navArea --- The Nav Area to test.
    -- @return --- Whether we're coplanar or not.
    IsCoplanar: function(self, navArea: GCNavArea): boolean

    --- Returns whether the CNavArea would damage if traversed, as set by CNavArea:MarkAsDamaging.
    -- @return --- Whether the area is damaging or not
    IsDamaging: function(self): boolean

    --- Returns whether this Nav Area is flat within the tolerance of the **nav_coplanar_slope_limit_displacement** and **nav_coplanar_slope_limit** convars.
    -- @return --- Whether this CNavArea is mostly flat.
    IsFlat: function(self): boolean

    --- Returns whether this area is in the Open List.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- Whether this area is in the Open List.
    IsOpen: function(self): boolean

    --- Returns whether the Open List is empty or not.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- Whether the Open List is empty or not.
    IsOpenListEmpty: function(self): boolean

    --- Returns if this position overlaps the Nav Area within the given tolerance.
    -- @param pos --- The overlapping position to test.
    -- @param tolerance --- The tolerance of the overlapping, set to 0 for no tolerance.
    -- @return --- Whether the given position overlaps the Nav Area or not.
    IsOverlapping: function(self, pos: GVector, tolerance: number): boolean

    --- Returns true if this CNavArea is overlapping the given CNavArea.
    -- @param navArea --- The CNavArea to test against.
    -- @return --- True if the given CNavArea overlaps this CNavArea at any point.
    IsOverlappingArea: function(self, navArea: GCNavArea): boolean

    --- Returns whether this CNavArea can see given position.
    -- @param pos --- The position to test.
    -- @param ignoreEnt --- If set, the given entity will be ignored when doing LOS tests
    -- @return --- Whether the given position is visible from this area
    IsPartiallyVisible: function(self, pos: GVector, ignoreEnt: GEntity): boolean

    --- Returns whether this CNavArea can potentially see the given CNavArea.
    -- @param area --- The CNavArea to test.
    -- @return --- Whether the given area is visible from this area
    IsPotentiallyVisible: function(self, area: GCNavArea): boolean

    --- Returns if we're shaped like a square.
    -- @return --- If we're a square or not.
    IsRoughlySquare: function(self): boolean

    --- Whether this Nav Area is placed underwater.
    -- @return --- Whether we're underwater or not.
    IsUnderwater: function(self): boolean

    --- Returns whether this CNavArea is valid or not.
    -- @return --- Whether this CNavArea is valid or not.
    IsValid: function(self): boolean

    --- Returns whether we can be seen from the given position.
    -- @param pos --- The position to check.
    -- @return --- Whether we can be seen or not.
    -- @return --- If we can be seen, this is returned with either the center or one of the corners of the Nav Area.
    IsVisible: function(self, pos: GVector): boolean, GVector

    --- Marks the area as blocked and unable to be traversed. See CNavArea:IsBlocked and CNavArea:MarkAsUnblocked.
    -- @param teamID --- TeamID to mark the area as blocked for. `-2` means all teams. Only 2 valid teamIDs are supported: `0` and `1`.
    MarkAsBlocked: function(self, teamID: number)

    --- Marks the area as damaging if traversed, for example when, for example having poisonous or no atmosphere, or a temporary fire present. See CNavArea:IsDamaging.
    -- @param duration --- For how long the area should stay marked as damaging. Multiple calls will overwrite the previous value.
    MarkAsDamaging: function(self, duration: number)

    --- Unblocked this area if it was previously blocked by CNavArea:MarkAsBlocked.
    -- @param teamID --- TeamID to unblock the area for. `-2` means all teams. Only 2 valid teamIDs are supported: `0` and `1`.
    MarkAsUnblocked: function(self, teamID: number)

    --- Drops a corner or all corners of a CNavArea to the ground below it.
    -- @param corner --- The corner(s) to drop, uses Enums/NavCorner
    PlaceOnGround: function(self, corner: number)

    --- Removes a CNavArea from the Open List with the lowest cost to traverse to from the starting node, and returns it.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @return --- The CNavArea from the Open List with the lowest cost to traverse to from the starting node.
    PopOpenList: function(self): GCNavArea

    --- Removes the given nav area.
    Remove: function(self)

    --- Removes given attributes from given CNavArea. See also CNavArea:SetAttributes.
    -- @param attribs --- The attributes to remove, as a bitflag. See Enums/NAV_MESH.
    RemoveAttributes: function(self, attribs: number)

    --- @deprecated
    --- **DEPRECATED**: Does nothing
    --- Removes this node from the Closed List.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    RemoveFromClosedList: function(self)

    --- Sets the attributes for given CNavArea. See CNavArea:HasAttributes.
    -- @param attribs --- The attributes to set, as a bitflag. See Enums/NAV_MESH.
    SetAttributes: function(self, attribs: number)

    --- Sets the position of a corner of a nav area.
    -- @param corner --- The corner to set, uses Enums/NavCorner
    -- @param position --- The new position to set.
    SetCorner: function(self, corner: number, position: GVector)

    --- Sets the cost from starting area this area when pathfinding.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @param cost --- The cost so far
    SetCostSoFar: function(self, cost: number)

    --- Sets the new parent of this CNavArea.
    -- @param parent --- The new parent to set
    -- @param how --- How we get from parent to us using Enums/NavTraverseType
    SetParent: function(self, parent: GCNavArea, how: number)

    --- Sets the Place of the nav area.
    --- There is a limit of 256 unique places per `.nav` file.
    -- @param place --- Set to `""` to remove place from the nav area. There's a limit of 255 characters.
    -- @return --- Returns true of operation succeeded, false otherwise.
    SetPlace: function(self, place: string): boolean

    --- Sets the total cost when passing from starting area to the goal area through this node.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    -- @param cost --- The total cost of the path to set.
    --- Must be above or equal 0.
    SetTotalCost: function(self, cost: number)

    --- Moves this open list to appropriate position based on its CNavArea:GetTotalCost compared to the total cost of other areas in the open list.
    --- Used in pathfinding via the [A* algorithm](https://en.wikipedia.org/wiki/A*_search_algorithm).
    --- More information can be found on the Simple Pathfinding page.
    UpdateOnOpenList: function(self)
end


--- A class used to store the inputs from CUserCmd and other information related to the current movement simulation, such as velocity, position and so on.
--- This can only be accessed during GM:SetupMove , GM:Move , GM:PlayerTick and GM:FinishMove.
global interface GCMoveData
    --- Adds keys to the move data, as if player pressed them.
    -- @param keys --- Keys to add, see Enums/IN
    AddKey: function(self, keys: number)

    --- Gets the aim angle. Seems to be same as CMoveData:GetAngles.
    -- @return --- Aiming angle
    GetAbsMoveAngles: function(self): GAngle

    --- Gets the aim angle. On client is the same as Entity:GetAngles.
    -- @return --- Aiming angle
    GetAngles: function(self): GAngle

    --- Gets which buttons are down
    -- @return --- An integer representing which buttons are down, see Enums/IN
    GetButtons: function(self): number

    --- Returns the center of the player movement constraint. See CMoveData:SetConstraintCenter.
    -- @return pos --- The constraint origin.
    GetConstraintCenter: function(self): GVector

    --- Returns the radius that constrains the players movement. See CMoveData:SetConstraintRadius.
    -- @return --- The constraint radius
    GetConstraintRadius: function(self): number

    --- Returns the player movement constraint speed scale. See CMoveData:SetConstraintSpeedScale.
    -- @return --- The constraint speed scale
    GetConstraintSpeedScale: function(self): number

    --- Returns the width (distance from the edge of the radius, inward) where the actual movement constraint functions.
    -- @return --- The constraint width
    GetConstraintWidth: function(self): number

    --- Returns an internal player movement variable `m_outWishVel`.
    -- @return idealVel ---
    GetFinalIdealVelocity: function(self): GVector

    --- Returns an internal player movement variable `m_outJumpVel`.
    -- @return jumpVel ---
    GetFinalJumpVelocity: function(self): GVector

    --- Returns an internal player movement variable `m_outStepHeight`.
    -- @return stepHeight ---
    GetFinalStepHeight: function(self): number

    --- Returns the players forward speed.
    -- @return --- speed
    GetForwardSpeed: function(self): number

    --- Gets the number passed to "impulse" console command
    -- @return --- The impulse
    GetImpulseCommand: function(self): number

    --- Returns the maximum client speed of the player
    -- @return --- The maximum client speed
    GetMaxClientSpeed: function(self): number

    --- Returns the maximum speed of the player.
    -- @return --- The maximum speed
    GetMaxSpeed: function(self): number

    --- Returns the angle the player is moving at. For more info, see CMoveData:SetMoveAngles.
    -- @return --- The move direction
    GetMoveAngles: function(self): GAngle

    --- Gets the aim angle. Only works clientside, server returns same as CMoveData:GetAngles.
    -- @return --- The aim angle
    GetOldAngles: function(self): GAngle

    --- Get which buttons were down last frame
    -- @return --- An integer representing which buttons were down, see Enums/IN
    GetOldButtons: function(self): number

    --- Gets the player's position.
    -- @return --- The player's position.
    GetOrigin: function(self): GVector

    --- Returns the strafe speed of the player.
    -- @return --- speed
    GetSideSpeed: function(self): number

    --- Returns the vertical speed of the player. ( Z axis of CMoveData:GetVelocity )
    -- @return --- Vertical speed
    GetUpSpeed: function(self): number

    --- Gets the players velocity.
    --- **BUG**: [This will return Vector(0,0,0) sometimes when walking on props.](https://github.com/Facepunch/garrysmod-issues/issues/3413
    -- @return --- The players velocity
    GetVelocity: function(self): GVector

    --- Returns whether the key is down or not
    -- @param key --- The key to test, see Enums/IN
    -- @return --- Is the key down or not
    KeyDown: function(self, key: number): boolean

    --- Returns whether the key was pressed. If you want to check if the key is held down, try CMoveData:KeyDown
    -- @param key --- The key to test, see Enums/IN
    -- @return --- Was the key pressed or not.
    KeyPressed: function(self, key: number): boolean

    --- Returns whether the key was released
    -- @param key --- A key to test, see Enums/IN
    -- @return --- Was the key released or not.
    KeyReleased: function(self, key: number): boolean

    --- Returns whether the key was down or not.
    --- Unlike CMoveData:KeyDown, it will return false if CMoveData:KeyPressed is true and it will return true if CMoveData:KeyReleased is true.
    -- @param key --- The key to test, see Enums/IN
    -- @return --- Was the key down or not
    KeyWasDown: function(self, key: number): boolean

    --- Sets absolute move angles.( ? ) Doesn't seem to do anything.
    -- @param ang --- New absolute move angles
    SetAbsMoveAngles: function(self, ang: GAngle)

    --- Sets angles.
    --- **BUG**: [This function does nothing.](https://github.com/Facepunch/garrysmod-issues/issues/2382
    -- @param ang --- The angles.
    SetAngles: function(self, ang: GAngle)

    --- Sets the pressed buttons on the move data
    -- @param buttons --- A number representing which buttons are down, see Enums/IN
    SetButtons: function(self, buttons: number)

    --- Sets the center of the player movement constraint. See CMoveData:SetConstraintRadius.
    -- @param pos --- The constraint origin.
    SetConstraintCenter: function(self, pos: GVector)

    --- Sets the radius that constrains the players movement.
    --- Works with conjunction of:
    --- * CMoveData:SetConstraintWidth
    --- * CMoveData:SetConstraintSpeedScale
    --- * CMoveData:SetConstraintCenter
    -- @param radius --- The new constraint radius
    SetConstraintRadius: function(self, radius: number)

    --- Sets the player movement constraint speed scale. This will be applied to the player within the constraint radius when approaching its edge.
    -- @param  --- The constraint speed scale
    SetConstraintSpeedScale: function(self, _: number)

    --- Sets  the width (distance from the edge of the radius, inward) where the actual movement constraint functions.
    -- @param  --- The constraint width
    SetConstraintWidth: function(self, _: number)

    --- Sets an internal player movement variable `m_outWishVel`.
    -- @param idealVel ---
    SetFinalIdealVelocity: function(self, idealVel: GVector)

    --- Sets an internal player movement variable `m_outJumpVel`.
    -- @param jumpVel ---
    SetFinalJumpVelocity: function(self, jumpVel: GVector)

    --- Sets an internal player movement variable `m_outStepHeight`.
    -- @param stepHeight ---
    SetFinalStepHeight: function(self, stepHeight: number)

    --- Sets players forward speed.
    -- @param speed --- New forward speed
    SetForwardSpeed: function(self, speed: number)

    --- Sets the impulse command. This isn't actually utilised in the engine anywhere.
    -- @param impulse --- The impulse to set
    SetImpulseCommand: function(self, impulse: number)

    --- Sets the maximum player speed. Player won't be able to run or sprint faster then this value.
    --- This also automatically sets CMoveData:SetMaxSpeed when used in the GM:SetupMove hook. You must set it manually in the GM:Move hook.
    --- This must be called on both client and server to avoid prediction errors.
    --- This will **not** reduce speed in air.
    --- **NOTE**: Setting this to 0 will not make the player stationary. It won't do anything.
    -- @param maxSpeed --- The new maximum speed
    SetMaxClientSpeed: function(self, maxSpeed: number)

    --- Sets the maximum speed of the player. This must match with CMoveData:SetMaxClientSpeed both, on server and client.
    --- Doesn't seem to be doing anything on it's own, use CMoveData:SetMaxClientSpeed instead.
    -- @param maxSpeed --- The new maximum speed
    SetMaxSpeed: function(self, maxSpeed: number)

    --- Sets the serverside move angles, making the movement keys act as if player was facing that direction.
    --- This function is predicted, and should be called shared with matching data on client and server.
    -- @param dir --- The aim direction.
    SetMoveAngles: function(self, dir: GAngle)

    --- Sets old aim angles. ( ? ) Doesn't seem to be doing anything.
    -- @param aimAng --- The old angles
    SetOldAngles: function(self, aimAng: GAngle)

    --- Sets the 'old' pressed buttons on the move data. These buttons are used to work out which buttons have been released, which have just been pressed and which are being held down.
    -- @param buttons --- A number representing which buttons were down, see Enums/IN
    SetOldButtons: function(self, buttons: number)

    --- Sets the players position.
    -- @param pos --- The position
    SetOrigin: function(self, pos: GVector)

    --- Sets players strafe speed.
    -- @param speed --- Strafe speed
    SetSideSpeed: function(self, speed: number)

    --- Sets vertical speed of the player. ( Z axis of CMoveData:SetVelocity )
    -- @param speed --- Vertical speed to set
    SetUpSpeed: function(self, speed: number)

    --- Sets the player's velocity
    -- @param velocity --- The velocity to set
    SetVelocity: function(self, velocity: GVector)
end


--- List of all possible functions available for Lua particles. This is the object returned by the CLuaEmitter:Add function.
global interface GCLuaParticle
    --- Returns the air resistance of the particle.
    -- @return --- The air resistance of the particle
    GetAirResistance: function(self): number

    --- Returns the angular velocity of the particle
    -- @return --- The angular velocity of the particle
    GetAngleVelocity: function(self): GAngle

    --- Returns the current orientation of the particle.
    -- @return --- The angles of the particle
    GetAngles: function(self): GAngle

    --- Returns the 'bounciness' of the particle.
    -- @return --- The 'bounciness' of the particle
    --- 2 means it will gain 100% of its previous velocity,
    --- 1 means it will not lose velocity,
    --- 0.5 means it will lose half of its velocity with each bounce.
    GetBounce: function(self): number

    --- Returns the color of the particle.
    -- @return --- Red part of the color
    -- @return --- Green part of the color
    -- @return --- Blue part of the color
    GetColor: function(self): number, number, number

    --- Returns the amount of time in seconds after which the particle will be destroyed.
    -- @return --- The amount of time in seconds after which the particle will be destroyed
    GetDieTime: function(self): number

    --- Returns the alpha value that the particle will reach on its death.
    -- @return --- The alpha value the particle will fade to
    GetEndAlpha: function(self): number

    --- Returns the length that the particle will reach on its death.
    -- @return --- The length the particle will reach
    GetEndLength: function(self): number

    --- Returns the size that the particle will reach on its death.
    -- @return --- The size the particle will reach
    GetEndSize: function(self): number

    --- Returns the gravity of the particle.
    -- @return --- The gravity of the particle.
    GetGravity: function(self): GVector

    --- Returns the 'life time' of the particle, how long the particle existed since its creation.
    --- This value will always be between 0 and CLuaParticle:GetDieTime.
    --- It changes automatically as time goes.
    --- It can be manipulated using CLuaParticle:SetLifeTime.
    --- If the life time of the particle will be more than CLuaParticle:GetDieTime, it will be removed.
    -- @return --- How long the particle existed, in seconds.
    GetLifeTime: function(self): number

    --- Returns the current material of the particle.
    -- @return mat --- The material.
    GetMaterial: function(self): GIMaterial

    --- Returns the absolute position of the particle.
    -- @return --- The absolute position of the particle.
    GetPos: function(self): GVector

    --- Returns the current rotation of the particle in radians, this should only be used for 2D particles.
    -- @return --- The current rotation of the particle in radians
    GetRoll: function(self): number

    --- Returns the current rotation speed of the particle in radians, this should only be used for 2D particles.
    -- @return --- The current rotation speed of the particle in radians
    GetRollDelta: function(self): number

    --- Returns the alpha value which the particle has when it's created.
    -- @return --- The alpha value which the particle has when it's created.
    GetStartAlpha: function(self): number

    --- Returns the length which the particle has when it's created.
    -- @return --- The length which the particle has when it's created.
    GetStartLength: function(self): number

    --- Returns the size which the particle has when it's created.
    -- @return --- The size which the particle has when it's created.
    GetStartSize: function(self): number

    --- Returns the current velocity of the particle.
    -- @return --- The current velocity of the particle.
    GetVelocity: function(self): GVector

    --- Sets the air resistance of the the particle.
    -- @param airResistance --- New air resistance.
    SetAirResistance: function(self, airResistance: number)

    --- Sets the angular velocity of the the particle.
    -- @param angVel --- New angular velocity.
    SetAngleVelocity: function(self, angVel: GAngle)

    --- Sets the angles of the particle.
    -- @param ang --- New angle.
    SetAngles: function(self, ang: GAngle)

    --- Sets the 'bounciness' of the the particle.
    -- @param bounce --- New 'bounciness' of the particle
    --- 2 means it will gain 100% of its previous velocity,
    --- 1 means it will not lose velocity,
    --- 0.5 means it will lose half of its velocity with each bounce.
    SetBounce: function(self, bounce: number)

    --- Sets the whether the particle should collide with the world or not.
    -- @param shouldCollide --- Whether the particle should collide with the world or not
    SetCollide: function(self, shouldCollide: boolean)

    --- Sets the function that gets called whenever the particle collides with the world.
    -- @param collideFunc --- The collision callback.
    --- <callback>
    --- <arg type="CLuaParticle" name="particle">The particle itself</arg>
    --- <arg type="Vector" name="hitPos">Position of the collision</arg>
    --- <arg type="Vector" name="hitNormal">Direction of the collision, perpendicular to the hit surface</arg>
    --- </callback>
    SetCollideCallback: function(self, collideFunc: function)

    --- Sets the color of the particle.
    -- @param r --- The red component.
    -- @param g --- The green component.
    -- @param b --- The blue component.
    SetColor: function(self, r: number, g: number, b: number)

    --- Sets the time where the particle will be removed.
    -- @param dieTime --- The new die time.
    SetDieTime: function(self, dieTime: number)

    --- Sets the alpha value of the particle that it will reach when it dies.
    -- @param endAlpha --- The new alpha value of the particle that it will reach when it dies.
    SetEndAlpha: function(self, endAlpha: number)

    --- Sets the length of the particle that it will reach when it dies.
    -- @param endLength --- The new length of the particle that it will reach when it dies.
    SetEndLength: function(self, endLength: number)

    --- Sets the size of the particle that it will reach when it dies.
    -- @param endSize --- The new size of the particle that it will reach when it dies.
    SetEndSize: function(self, endSize: number)

    --- Sets the directional gravity aka. acceleration of the particle.
    -- @param gravity --- The directional gravity.
    SetGravity: function(self, gravity: GVector)

    --- Sets the 'life time' of the particle, how long the particle existed since its creation.
    --- This value should always be between 0 and CLuaParticle:GetDieTime.
    --- It changes automatically as time goes.
    --- If the life time of the particle will be more than CLuaParticle:GetDieTime, it will be removed.
    -- @param lifeTime --- The new life time of the particle.
    SetLifeTime: function(self, lifeTime: number)

    --- Sets whether the particle should be affected by lighting.
    -- @param useLighting --- Whether the particle should be affected by lighting.
    SetLighting: function(self, useLighting: boolean)

    --- Sets the material of the particle.
    -- @param mat --- The new material to set. Can also be a string.
    SetMaterial: function(self, mat: GIMaterial)

    --- Sets when the particles think function should be called next, this uses the synchronized server time returned by Global.CurTime.
    -- @param nextThink --- Next think time.
    SetNextThink: function(self, nextThink: number)

    --- Sets the absolute position of the particle.
    -- @param pos --- The new particle position.
    SetPos: function(self, pos: GVector)

    --- Sets the roll of the particle in radians. This should only be used for 2D particles.
    -- @param roll --- The new rotation of the particle in radians.
    SetRoll: function(self, roll: number)

    --- Sets the rotation speed of the particle in radians. This should only be used for 2D particles.
    -- @param rollDelta --- The new rotation speed of the particle in radians.
    SetRollDelta: function(self, rollDelta: number)

    --- Sets the initial alpha value of the particle.
    -- @param startAlpha --- Initial alpha.
    SetStartAlpha: function(self, startAlpha: number)

    --- Sets the initial length value of the particle.
    -- @param startLength --- Initial length.
    SetStartLength: function(self, startLength: number)

    --- Sets the initial size value of the particle.
    -- @param startSize --- Initial size.
    SetStartSize: function(self, startSize: number)

    --- Sets the think function of the particle.
    -- @param thinkFunc --- Think function.
    --- <callback>
    --- <arg type="CLuaParticle" name="particle">The particle the think hook is set on</arg>
    --- </callback>
    SetThinkFunction: function(self, thinkFunc: function)

    --- Sets the velocity of the particle.
    -- @param vel --- The new velocity of the particle.
    SetVelocity: function(self, vel: GVector)

    --- Scales the velocity based on the particle speed.
    -- @param doScale --- Use velocity scaling.
    SetVelocityScale: function(self, doScale: boolean)
end


--- This class is essentially what controls a NextBot NPC. You can access it in a NextBot NPC by using **self.loco** variable.
global interface GCLuaLocomotion
    --- Moves the NextBot incrementally closer to the provided goal location.
    --- Each time this function is called, the NextBot moves towards the goal position passed as an argument by the amount previously set by CLuaLocomotion:SetDesiredSpeed.
    --- To achieve smooth movement, this function must be called frequently.
    --- This is commonly accomplished by calling it in the ENTITY:Think hook.
    -- @param goal --- The vector we want to get to.
    -- @param goalWeight --- How influential the movement should be, in case of this function being called multiple times in between physical movements of the entity.
    --- If unsure then set this to `1`.
    Approach: function(self, goal: GVector, goalWeight: number)

    --- Removes the stuck status from the bot
    ClearStuck: function(self)

    --- Sets the direction we want to face
    -- @param goal --- The vector we want to face
    FaceTowards: function(self, goal: GVector)

    --- Returns the acceleration speed
    -- @return --- Current acceleration speed
    GetAcceleration: function(self): number

    --- Returns whether the Nextbot is allowed to avoid obstacles or not.
    -- @return allowed --- Whether this bot is allowed to try to avoid obstacles.
    GetAvoidAllowed: function(self): boolean

    --- Returns whether the Nextbot is allowed to climb or not.
    -- @return allowed --- Whether this bot is allowed to climb.
    GetClimbAllowed: function(self): boolean

    --- Returns the current acceleration as a vector
    -- @return --- Current acceleration
    GetCurrentAcceleration: function(self): GVector

    --- Gets the height the bot is scared to fall from
    -- @return --- Current death drop height
    GetDeathDropHeight: function(self): number

    --- Gets the deceleration speed
    -- @return --- Current deceleration speed
    GetDeceleration: function(self): number

    --- Returns the desired movement speed set by CLuaLocomotion:SetDesiredSpeed
    -- @return --- The desired movement speed.
    GetDesiredSpeed: function(self): number

    --- Returns the locomotion's gravity.
    -- @return gravity --- The gravity.
    GetGravity: function(self): number

    --- Return unit vector in XY plane describing our direction of motion - even if we are currently not moving
    -- @return --- A vector representing the X and Y movement
    GetGroundMotionVector: function(self): GVector

    --- Returns the current ground normal.
    -- @return --- The current ground normal.
    GetGroundNormal: function(self): GVector

    --- Returns whether the Nextbot is allowed to jump gaps or not.
    -- @return allowed --- Whether this bot is allowed to jump gaps.
    GetJumpGapsAllowed: function(self): boolean

    --- Gets the height of the bot's jump
    -- @return --- Current jump height
    GetJumpHeight: function(self): number

    --- Returns maximum jump height of this CLuaLocomotion.
    -- @return --- The maximum jump height.
    GetMaxJumpHeight: function(self): number

    --- Returns the max rate at which the NextBot can visually rotate.
    -- @return --- Maximum yaw rate
    GetMaxYawRate: function(self): number

    --- Returns the NextBot this locomotion is associated with.
    -- @return --- The nextbot
    GetNextBot: function(self): GNextBot

    --- Gets the max height the bot can step up
    -- @return --- Current step height
    GetStepHeight: function(self): number

    --- Returns the current movement velocity as a vector
    -- @return --- Current velocity
    GetVelocity: function(self): GVector

    --- Returns whether this CLuaLocomotion can reach and/or traverse/move in given CNavArea.
    -- @param area --- The area to test
    -- @return --- Whether this CLuaLocomotion can traverse given CNavArea.
    IsAreaTraversable: function(self, area: GCNavArea): boolean

    --- Returns true if we're trying to move.
    -- @return --- Whether we're trying to move or not.
    IsAttemptingToMove: function(self): boolean

    --- Returns true of the locomotion engine is jumping or climbing
    -- @return --- Whether we're climbing or jumping or not
    IsClimbingOrJumping: function(self): boolean

    --- Returns whether the nextbot this locomotion is attached to is on ground or not.
    -- @return --- Whether the nextbot is on ground or not.
    IsOnGround: function(self): boolean

    --- Returns true if we're stuck
    -- @return --- Whether we're stuck or not
    IsStuck: function(self): boolean

    --- Returns whether or not the target in question is on a ladder or not.
    -- @return --- If the target is on a ladder or not.
    IsUsingLadder: function(self): boolean

    --- Makes the bot jump. It must be on ground (Entity:IsOnGround) and its model must have `ACT_JUMP` activity.
    -- @param act --- The activity to use as the jumping animation.
    Jump: function(self, act: number)

    --- Makes the bot jump across a gap. The bot must be on ground (Entity:IsOnGround) and its model must have `ACT_JUMP` activity.
    -- @param landingGoal ---
    -- @param landingForward ---
    JumpAcrossGap: function(self, landingGoal: GVector, landingForward: GVector)

    --- Sets the acceleration speed
    -- @param speed --- Speed acceleration
    SetAcceleration: function(self, speed: number)

    --- Sets whether the Nextbot is allowed try to to avoid obstacles or not. This is used during path generation. Works similarly to `nb_allow_avoiding` convar. By default bots are allowed to try to avoid obstacles.
    -- @param allowed --- Whether this bot should be allowed to try to avoid obstacles.
    SetAvoidAllowed: function(self, allowed: boolean)

    --- Sets whether the Nextbot is allowed to climb or not. This is used during path generation. Works similarly to `nb_allow_climbing` convar. By default bots are allowed to climb.
    -- @param allowed --- Whether this bot should be allowed to climb.
    SetClimbAllowed: function(self, allowed: boolean)

    --- Sets the height the bot is scared to fall from.
    -- @param height --- Height
    SetDeathDropHeight: function(self, height: number)

    --- Sets the deceleration speed.
    -- @param deceleration --- New deceleration speed.
    SetDeceleration: function(self, deceleration: number)

    --- Sets how far the NextBot will need to move each time CLuaLocomotion:Approach is called to move at given speed.
    --- The default amount is 0. This means the bot will not move if this value has not been set.
    -- @param speed --- The new desired speed
    SetDesiredSpeed: function(self, speed: number)

    --- Sets the locomotion's gravity.
    --- **NOTE**: With values 0 or below, or even lower positive values, the nextbot will start to drift sideways, use CLuaLocomotion:SetVelocity to counteract this.
    -- @param gravity --- New gravity to set.
    SetGravity: function(self, gravity: number)

    --- Sets whether the Nextbot is allowed to jump gaps or not. This is used during path generation. Works similarly to `nb_allow_gap_jumping` convar. By default bots are allowed to jump gaps.
    -- @param allowed --- Whether this bot should be allowed to jump gaps.
    SetJumpGapsAllowed: function(self, allowed: boolean)

    --- Sets the height of the bot's jump
    -- @param height --- Height
    SetJumpHeight: function(self, height: number)

    --- Sets the max rate at which the NextBot can visually rotate. This will not affect moving or pathing.
    -- @param yawRate --- Desired new maximum yaw rate
    SetMaxYawRate: function(self, yawRate: number)

    --- Sets the max height the bot can step up
    -- @param height --- Height
    SetStepHeight: function(self, height: number)

    --- Sets the current movement velocity
    -- @param velocity ---
    SetVelocity: function(self, velocity: GVector)
end


--- List of all possible functions available for LuaEmitters. This is the object returned by the Global.ParticleEmitter function.
global interface GCLuaEmitter
    --- Creates a new CLuaParticle with the given material and position.
    -- @param material --- The particles material. Can also be an IMaterial.
    -- @param position --- The position to spawn the particle on.
    -- @return --- The created particle, if any.
    Add: function(self, material: string, position: GVector): GCLuaParticle

    --- Manually renders all particles the emitter has created.
    Draw: function(self)

    --- Removes the emitter, making it no longer usable from Lua. If particles remain, the emitter will be removed when all particles die.
    Finish: function(self)

    --- Returns the amount of active particles of this emitter.
    -- @return --- The amount of active particles of this emitter
    GetNumActiveParticles: function(self): number

    --- Returns the position of this emitter. This is set when creating the emitter with Global.ParticleEmitter.
    -- @return --- Position of this particle emitter.
    GetPos: function(self): GVector

    --- Returns whether this emitter is 3D or not. This is set when creating the emitter with Global.ParticleEmitter.
    -- @return --- Whether this emitter is 3D or not.
    Is3D: function(self): boolean

    --- Returns whether this CLuaEmitter is valid or not.
    -- @return --- Whether this CLuaEmitter is valid or not.
    IsValid: function(self): boolean

    --- Sets the bounding box for this emitter.
    --- Usually the bounding box is automatically determined by the particles, but this function overrides it.
    -- @param mins --- The minimum position of the box
    -- @param maxs --- The maximum position of the box
    SetBBox: function(self, mins: GVector, maxs: GVector)

    --- This function sets the the distance between the render camera and the emitter at which the particles should start fading and at which distance fade ends ( alpha becomes 0 ).
    -- @param distanceMin --- Min distance where the alpha becomes 0.
    -- @param distanceMax --- Max distance where the alpha starts fading.
    SetNearClip: function(self, distanceMin: number, distanceMax: number)

    --- Prevents all particles of the emitter from automatically drawing.
    -- @param noDraw --- Whether we should draw the particles ( false ) or not ( true )
    SetNoDraw: function(self, noDraw: boolean)

    --- The function name has not much in common with its actual function, it applies a radius to every particles that affects the building of the bounding box, as it, usually is constructed by the particle that has the lowest x, y and z and the highest x, y and z, this function just adds/subtracts the radius and inflates the bounding box.
    -- @param radius --- Particle radius.
    SetParticleCullRadius: function(self, radius: number)

    --- Sets the position of the particle emitter.
    -- @param position --- New position.
    SetPos: function(self, position: GVector)
end


--- List of all possible functions available for effect data. This is the object returned by the EffectData function and is required for util.Effect function.
global interface GCEffectData
    --- Returns the angles of the effect.
    -- @return --- The angles of the effect
    GetAngles: function(self): GAngle

    --- Returns the attachment ID for the effect.
    -- @return --- The attachment ID of the effect.
    GetAttachment: function(self): number

    --- Returns byte which represents the color of the effect.
    -- @return --- The color of the effect
    GetColor: function(self): number

    --- Returns the damage type of the effect
    -- @return --- Damage type of the effect, see Enums/DMG
    GetDamageType: function(self): number

    --- Returns the entity index of the entity set for the effect.
    -- @return --- The entity index of the entity set for the effect.
    GetEntIndex: function(self): number

    --- Returns the entity assigned to the effect.
    -- @return --- The entity assigned to the effect
    GetEntity: function(self): GEntity

    --- Returns the flags of the effect.
    -- @return --- The flags of the effect.
    GetFlags: function(self): number

    --- Returns the hit box ID of the effect.
    -- @return --- The hit box ID of the effect.
    GetHitBox: function(self): number

    --- Returns the magnitude of the effect.
    -- @return --- The magnitude of the effect.
    GetMagnitude: function(self): number

    --- Returns the material ID of the effect.
    -- @return --- The material ID of the effect.
    GetMaterialIndex: function(self): number

    --- Returns the normalized direction vector of the effect.
    -- @return --- The normalized direction vector of the effect.
    GetNormal: function(self): GVector

    --- Returns the origin position of the effect.
    -- @return --- The origin position of the effect.
    GetOrigin: function(self): GVector

    --- Returns the radius of the effect.
    -- @return --- The radius of the effect.
    GetRadius: function(self): number

    --- Returns the scale of the effect.
    -- @return --- The scale of the effect
    GetScale: function(self): number

    --- Returns the start position of the effect.
    -- @return --- The start position of the effect
    GetStart: function(self): GVector

    --- Returns the surface property index of the effect. See util.GetSurfaceData for more details about what they are.
    --- See CEffectData:SetSurfaceProp for details about limitations of this function.
    -- @return --- The surface property index of the effect.
    GetSurfaceProp: function(self): number

    --- Sets the angles of the effect.
    -- @param ang --- The new angles to be set.
    SetAngles: function(self, ang: GAngle)

    --- Sets the attachment id of the effect to be created with this effect data.
    --- **NOTE**: This is internally stored as an integer, but only the first 5 bits will be networked, effectively limiting this function to 0-31 range.
    -- @param attachment --- New attachment ID of the effect.
    SetAttachment: function(self, attachment: number)

    --- Sets the "color" of the effect.
    --- All this does is provide an addition 8 bits of data for the effect to use. What this will actually do will vary from effect to effect, depending on how a specific effect uses this given data, if at all.
    --- **NOTE**: Internally stored as an integer, but only first 8 bits are networked, effectively limiting this function to 0-255 range.
    -- @param color --- Color represented by a byte.
    SetColor: function(self, color: number)

    --- Sets the damage type of the effect to be created with this effect data.
    -- @param damageType --- Damage type, see Enums/DMG.
    SetDamageType: function(self, damageType: number)

    --- Sets the entity of the effect via its index.
    -- @param entIndex --- The entity index to be set.
    SetEntIndex: function(self, entIndex: number)

    --- Sets the entity of the effect to be created with this effect data.
    -- @param entity --- Entity of the effect, mostly used for parenting.
    SetEntity: function(self, entity: GEntity)

    --- Sets the flags for the effect. What flags do depends entirely on the effect. See Default Effects.
    --- **NOTE**: Internally stored as an integer, but only first 8 bits are networked, effectively limiting this function to `0-255` range.
    -- @param flags --- The flags of the effect. Each effect has their own flags.
    SetFlags: function(self, flags: number)

    --- Sets the hit box index of the effect. Used by various effects for various purposes.
    --- **NOTE**: Internally stored as an integer, but only first 11 bits are networked, effectively limiting this function to 0-2047 range.
    -- @param hitBoxIndex --- The hit box index of the effect, for example from Structures/TraceResult#HitBox
    SetHitBox: function(self, hitBoxIndex: number)

    --- Sets the magnitude of the effect.
    --- **NOTE**: Internally stored as a float with 12 bit precision for networking purposes, limited to range of 0-1023.
    -- @param magnitude --- The magnitude of the effect.
    SetMagnitude: function(self, magnitude: number)

    --- Sets the material index of the effect.
    --- **NOTE**: Internally stored as an integer, but only first 12 bits are networked, effectively limiting this function to 0-4095 range.
    -- @param materialIndex --- The material index of the effect.
    SetMaterialIndex: function(self, materialIndex: number)

    --- Sets the normalized (length=1) direction vector of the effect to be created with this effect data. This **must** be a normalized vector for networking purposes.
    -- @param normal --- The normalized direction vector of the effect.
    SetNormal: function(self, normal: GVector)

    --- Sets the origin of the effect to be created with this effect data.
    --- **NOTE**: Limited to world bounds (+-16386 on every axis) and has horrible networking precision. (17 bit float per component)
    -- @param origin --- Origin of the effect.
    SetOrigin: function(self, origin: GVector)

    --- Sets the radius of the effect to be created with this effect data.
    --- **NOTE**: Internally stored as a float, but networked as a 10bit float, and is clamped to 0-1023 range.
    -- @param radius --- Radius of the effect.
    SetRadius: function(self, radius: number)

    --- Sets the scale of the effect to be created with this effect data.
    -- @param scale --- Scale of the effect.
    SetScale: function(self, scale: number)

    --- Sets the start of the effect to be created with this effect data.
    --- **NOTE**: Limited to world bounds (+-16386 on every axis) and has horrible networking precision. (17 bit float per component)
    -- @param start --- Start of the effect.
    SetStart: function(self, start: GVector)

    --- Sets the surface property index of the effect. See util.GetSurfaceData for more details about what they are.
    --- **NOTE**: Internally stored as an integer, but only first 8 bits are networked, effectively limiting this function to `-1`-`254` range. (Yes, that's not a mistake, `-1` signifying an invalid value.)
    -- @param surfaceProperties --- The surface property index of the effect.
    SetSurfaceProp: function(self, surfaceProperties: number)
end


--- This is the object passed to usermessage.Hook when a message is received. It contains each value stored in the message in sequential order. You should read values from it in the order you wrote them.
--- @deprecated
--- **DEPRECATED**: You should be using net instead
global interface Gbf_read
    --- Reads and returns an angle object from the bitstream.
    -- @return --- The read angle
    ReadAngle: function(self): GAngle

    --- Reads 1 bit and returns a bool representing the bit.
    -- @return --- bit
    ReadBool: function(self): boolean

    --- Reads a signed char and returns a number from -127 to 127 representing the ascii value of that char.
    -- @return --- asciiVal
    ReadChar: function(self): number

    --- Reads a short representing an entity index and returns the matching entity handle.
    -- @return --- ent
    ReadEntity: function(self): GEntity

    --- Reads a 4 byte float from the bitstream and returns it.
    -- @return --- float
    ReadFloat: function(self): number

    --- Reads a 4 byte long from the bitstream and returns it.
    -- @return --- int
    ReadLong: function(self): number

    --- Reads a 2 byte short from the bitstream and returns it.
    -- @return --- short
    ReadShort: function(self): number

    --- Reads a null terminated string from the bitstream.
    -- @return --- str
    ReadString: function(self): string

    --- Reads a special encoded vector from the bitstream and returns it, this function is not suitable to send normals.
    -- @return --- vec
    ReadVector: function(self): GVector

    --- Reads a special encoded vector normal from the bitstream and returns it, this function is not suitable to send vectors that represent a position.
    -- @return --- normal
    ReadVectorNormal: function(self): GVector

    --- Rewinds the bitstream so it can be read again.
    Reset: function(self)
end





--- Table structure that describes a Source Engine ammo type.
--- See game.AddAmmoType and game.GetAmmoData.
global record S_AmmoData
    --- Damage type using Enums/DMG.
    --- Related function is game.GetAmmoDamageType.
    dmgtype: E_DMG

    --- The force of the ammo.
    --- Related function is game.GetAmmoForce.
    force: number

    --- The maximum water splash size.
    maxsplash: number

    --- The minimum water splash size.
    minsplash: number

    --- Name of the ammo.
    --- Related functions are game.GetAmmoName and game.GetAmmoID.
    name: string

    --- The damage dealt to NPCs.
    --- Related function is game.GetAmmoNPCDamage.
    --- Can also be a string with the name of a convar. The value will automatically update with the convar's.
    npcdmg: number

    --- The damage dealt to players.
    --- Related function is game.GetAmmoPlayerDamage.
    --- Can also be a string with the name of a convar. The value will automatically update with the convar's.
    plydmg: number

    --- Tracer type using Enums/TRACER.
    tracer: E_TRACER

    --- Maximum amount of ammo of this type the player should be able to carry in reserve. `-2` makes this ammo type infinite.
    --- Related function is game.GetAmmoMax.
    --- Can also be a string with the name of a convar. The value will automatically update with the convar's.
    --- **WARNING**: `gmod_maxammo` convar will override this value if set to above 0, **which it is by default**.
    maxcarry: number

    --- Flags for the ammo type using Enums/AMMO.
    flags: E_AMMO

end
--- Table used by various functions, such as Entity:GetAttachment.
global record S_AngPos
    --- An Angle object.
    Ang: GAngle

    --- An Vector object.
    Pos: GVector

    --- The bone ID the attachment point is parented to.
    Bone: number

end
--- Table used by panel animation methods, primarily Panel:AnimationThinkInternal, and returned by Panel:NewAnimation.
global record S_AnimationData
    --- The system time value returned by Global.SysTime when the animation starts/will start.
    StartTime: number

    --- The system time value returned by Global.SysTime when the animation ends/will end.
    EndTime: number

    --- The ease in/out level of the animation.
    Ease: number

    --- The callback function that will be called upon completion of the animation.
    --- <callback>
    --- <arg type="table" name="animData">This structure.</arg>
    --- <arg type="Panel" name="tgtPanel">The panel the animation was run on.</arg>
    --- </callback>
    OnEnd: function

    --- The `think` function called every frame that will animate the panel object. This varies based on the animation. You can create a custom function for this if you aren't using the stock panel methods.
    --- <callback>
    --- <arg type="table" name="animData">This structure.</arg>
    --- <arg type="Panel" name="tgtPanel">The panel the animation is being run on.</arg>
    --- </callback>
    --- <arg type="number" name="fraction">The progress fraction of the animation, between 0 and 1. The change rate of this number will not be linear if you are easing.</arg>
    Think: function

    --- The target position, or target translation of the panel object. Used by Panel:MoveTo and Panel:MoveBy respectively.
    Pos: GVector

    --- The position of the panel object when the animation started. Used by Panel:MoveTo and Panel:MoveBy.
    StartPos: GVector

    --- Whether to resize the panel horizontally or not. Only used by Panel:SizeTo.
    SizeX: boolean

    --- Whether to resize the panel vertically or not. Only used by Panel:SizeTo.
    SizeY: boolean

    --- The target size of the panel object. Only used by Panel:SizeTo.
    Size: GVector

    --- The size of the panel object when the animation started. Only used by Panel:SizeTo.
    StartSize: GVector

    --- The target colour of the panel object. Only used by Panel:ColorTo.
    Color: GColor

    --- The colour of the panel object when the animation started. Only used by Panel:ColorTo.
    StartColor: GColor

    --- The target alpha (0-255) of the panel object. Only used by Panel:AlphaTo.
    Alpha: number

    --- The alpha (0-255) of the panel object when the animation started. Only used by Panel:AlphaTo.
    StartAlpha: number

    --- The speed to use for transitions when using linear interpolation (Lerp) animations. Only used by Panel:LerpPositions.
    Speed: number

    --- Whether or not to use easing to make the panel 'jump' at its target, slowing as it approaches. Only used by Panel:LerpPositions.
    UseGravity: boolean

end
--- Table returned by Entity:GetAttachments.
global record S_AttachmentData
    --- Index of the attachment.
    id: number

    --- Name of the attachment.
    name: string

end
--- Table structure used as balloon spawn data. Default values are applied when the trace hits nothing. This data is required for correctly spawning the balloon.
--- See MakeBalloon.
global record S_BalloonData
    --- Where the balloon will spawn.
    Pos: GVector

    --- The balloon’s model.
    Model: string

    --- The balloon’s skin.
    Skin: number

end
--- The tables that make up the values of the table returned by Entity:GetBodyGroups.
global record S_BodyGroupData
    --- The Body Group's ID.
    --- Body Group IDs start at `0`.
    id: number

    --- The name of the Body Group.
    name: string

    --- The number of Sub Models in this Body Group, and the length of the `submodels` table.
    num: number

    --- A table of the names of the Sub Models within this Body Group.
    --- Sub Model IDs start at `0`.
    submodels: {string}

end
--- A table structure representing a single bone's orientation when its mesh is in its baseline (or "bind") pose before any animation is played.
--- This structure does not contain the bone ID for the bone it represents and instead relies on the structure's index within the table returned by util.GetModelMeshes to identify the bone it corresponds to.
global record S_BoneBindPose
    --- The bone ID of this bone's parent bone.
    parent: number

    --- A VMatrix containing this bone's position and rotation in local space relative to the model's origin.
    matrix: GVMatrix

end
--- Structure used for storing/restoring bone manipulations.
--- Data is stored from Entity:GetManipulateBoneScale, Entity:GetManipulateBoneAngles, and Entity:GetManipulateBonePosition.
--- Data is restored using Entity:ManipulateBoneScale, Entity:ManipulateBoneAngles, and Entity:ManipulateBonePosition.
--- The function duplicator.DoBoneManipulator and Structures/EntityCopyData use a table
--- containing a BoneManipulationData structure for each bone (that has manipulations applied) with the bone ID as the struct index in the table.
--- Fields **s**, **a**, and **p** are set if they don't equal **Vector( 1, 1, 1 )**, **Angle( 0, 0, 0 )**, and **Vector( 0, 0, 0 )** respectively.
global record S_BoneManipulationData
    --- The entity's scale manipulation of the bone.
    s: GVector

    --- The entity's angle manipulation of the bone.
    a: GAngle

    --- The entity's position manipulation of the given bone.
    p: GVector

end
--- A table structure representing the amount that a bone's transformation VMatrix should affect its vertex.
--- A single vertex may have multiple BoneWeight structures affecting it, but each BoneWeight structure belongs to only one vertex.
--- Added to the Structures/MeshVertex by util.GetModelMeshes.
--- To find a bone's transformation VMatrix, see Entity:GetBoneMatrix.
global record S_BoneWeight
    --- The ID of the bone affecting the vertex.
    bone: number

    --- A percentage between `0` and `1` indicating how much influence this bone's VMatrix should have on the the vertex.
    weight: number

end
--- Tables used for bullets see Entity:FireBullets and GM:EntityFireBullets.
global record S_Bullet
    --- The entity that should be reported as attacker. (eg. a player)
    --- By default this would be set to the entity Entity:FireBullets is called on.
    Attacker: GEntity

    --- The entity that should be reported as inflictor eg. a weapon or something similar.
    --- Also defines CTakeDamageInfo:GetWeapon for Weapon.
    Inflictor: GEntity

    --- Function to be called **after** the bullet was fired but **before** the damage is applied (the callback is called even if no damage is applied).
    --- <callback>
    --- <arg type="Entity" name="attacker"></arg>
    --- <arg type="table" name="tr">See Structures/TraceResult</arg>
    --- <arg type="CTakeDamageInfo" name="dmgInfo"></arg>
    --- <ret type="table">
    --- The return value can be a table with following keys:
    --- * boolean effects - `false` to not do any of the effects.
    --- * boolean damage - `false` to not do any damage.
    --- </ret>
    --- </callback>
    Callback: function

    --- The damage dealt by the bullet.
    --- If set to `0`, it means the damage should be calculated from the ammo type's ConVars if  the ammo type has `AMMO_INTERPRET_PLRDAMAGE_AS_DAMAGE_TO_PLAYER` flag set.
    --- See Structures/AmmoData.
    Damage: number

    --- The force of the bullets.
    Force: number

    --- Maximum distance the bullet can travel.
    Distance: number

    --- The hull size of the bullet
    HullSize: number

    --- The amount of bullets to fire.
    Num: number

    --- Show tracer for every x bullets.
    Tracer: number

    --- The ammunition name.
    AmmoType: string

    --- The tracer name. You can find a list of default effects here.
    TracerName: string

    --- The fire direction.
    Dir: GVector

    --- The spread, only x and y are needed.
    Spread: GVector

    --- The position to fire the bullets from.
    Src: GVector

    --- The entity that the bullet will ignore when it will be shot.
    IgnoreEntity: GEntity

end
--- Table structure used GM:CalcView and GM:CalcVehicleView hook.
global record S_CamData
    --- The camera's position.
    origin: GVector

    --- The camera's angles.
    angles: GAngle

    --- The camera's FOV.
    fov: number

    --- Distance to near clipping plane.
    znear: number

    --- Distance to far clipping plane.
    zfar: number

    --- Set true to draw local players player model.
    drawviewer: boolean

    --- If set, enables orthographic mode. The table has following arguments:
    --- * number left.
    --- * number right.
    --- * number top.
    --- * number bottom.
    --- Each describes where their border starts, (`left`+`right`) and (`top`+`bottom`) should equal `0` to center on the view position.
    ortho: table

end
--- Passed as argument of ENTITY:PhysicsCollide, EFFECT:PhysicsCollide and used with Entity:AddCallback.
--- **NOTE**: Sometimes, the value of `Speed` can be different from getting the length calculated from `OurOldVelocity`, even though they should be the same, or close to same. It's recommended to do `OurOldVelocity:Length()` instead.
--- ```
--- function ENT:PhysicsCollide( colData, collider )
--- -- you may get two completely different values, and the second one should be more accurate.
--- print(colData.Speed)
--- print(colData.OurOldVelocity:Length())
--- end
--- ```
global record S_CollisionData
    --- The collision position.
    HitPos: GVector

    --- The other collision entity.
    HitEntity: GEntity

    --- The entity's velocity before the collision.
    OurOldVelocity: GVector

    --- Other entity's physics object.
    HitObject: GPhysObj

    --- Time since the last collision with the `HitEntity`.
    DeltaTime: number

    --- Speed of the other entity before the collision.
    TheirOldVelocity: GVector

    --- The speed of the entity before the collision.
    Speed: number

    --- Normal of the surface that hit the other entity.
    HitNormal: GVector

    --- Entity's physics object.
    PhysObject: GPhysObj

    --- Surface Property ID of `this` entity.
    OurSurfaceProps: number

    --- Surface Property ID of the entity we collided with.
    TheirSurfaceProps: number

    --- The speed at which the impact happened.
    HitSpeed: GVector

    --- Our new velocity after the impact.
    OurNewVelocity: GVector

    --- The new velocity after the impact of the entity we collided with.
    TheirNewVelocity: GVector

    --- Old angular velocity of this entity.
    OurOldAngularVelocity: GVector

    --- Old angular velocity of the entity we collided with.
    TheirOldAngularVelocity: GVector

end
--- Table created by the Global.Color function and used in various situations.
global record S_Color
    --- The red channel.
    r: number

    --- The green channel.
    g: number

    --- The blue channel.
    b: number

    --- The alpha channel.
    a: number

end
--- Table that maintains information on the creation menu tabs. Each key of the table represents the name of the tab. See spawnmenu.AddCreationTab and spawnmenu.GetCreationTabs.
global record S_CreationMenus
    --- The function used to generate the content of the tab.
    --- <callback>
    --- <ret type="Panel" name="content">A container panel that holds all of the content for the new tab.</ret>
    --- </callback>
    Function: function

    --- The icon material that will accompany the title of the tab.
    Icon: string

    --- The order in which a tab will be displayed relative to the other tabs.
    Order: number

    --- The tooltip to be shown with the tab.
    Tooltip: string

end
--- Table returned by os.date and used by os.time.
global record S_DateData
    --- Day of the month
    day: number

    --- Hour
    hour: number

    --- Daylight saving enabled
    isdst: boolean

    --- Minute
    min: number

    --- Month
    --- January: 1, December: 12
    month: number

    --- Second
    sec: number

    --- Day of the week
    --- Sunday: 1, Saturday: 7
    wday: number

    --- Day of the year
    yday: number

    --- Year
    year: number

end
--- Table returned by debug.getinfo.
--- **NOTE**: If a filter is applied to debug.getinfo, some members may not exist!
--- For functions defined in C/C++, the following members will always have the given values:
--- * what = "C"
--- * source = "[C]"
--- * nparams = 0
--- * isvararg = true
--- * namewhat = ""
--- * short_src = "[C]"
--- * linedefined = -1
--- * currentline = -1
--- * lastlinedefined = -1
global record S_DebugInfo
    --- Reference to the function that was passed in. If a stack level was specified, this will be the function at that stack level. 0 = debug.getinfo, 1 = function that called debug.getinfo, etc.
    --- **Option: f**
    func: function

    --- The line where the function definiton starts (where "function" is located).
    --- **Option: S**
    linedefined: number

    --- The line the function definition ended (where "end" is located).
    --- **Option: S**
    lastlinedefined: number

    --- The path to the file where the passed function is defined prepended by an @ (ex. "@lua/autorun/mytestfile.lua"). This will be the Global.CompileString or Global.RunString identifier if the function wasn't defined in a file, also prepended by an @.
    --- **Option: S**
    source: string

    --- The shortened name of the source (without the @). May be truncated if the source path is long.
    --- **Option: S**
    short_src: string

    --- The language used. Either "Lua" or "C".
    --- **Option: S**
    what: string

    --- The current line. This will be -1 if the code is not executed from a file.
    --- **Option: l** (lowercase L)
    currentline: number

    --- The function name. This will be nil if the name cannot be found. Only works if stack level is passed rather than function pointer.
    --- **Option: n**
    name: string

    --- The function "type". This will be "global", "local", "method", "field". Can also be an empty string if the function name could not be found. Only works if stack level is passed rather than function pointer.
    --- **Option: n**
    namewhat: string

    --- Whether the function is variadic (has a `...` argument).
    --- **Option: u**
    isvararg: boolean

    --- The number of arguments the function uses excluding varargs.
    --- **Option: u**
    nparams: number

    --- Upvalue count. Max index that can be used with debug.getupvalue. C functions can have upvalues but they cannot be accessed from Lua.
    --- **Option: u**
    nups: number

    --- A table of all the active lines in the function - that is, lines with code that actually does something (not blank lines or lines with comments only).
    --- The table keys will be line numbers, and their values will all be true. Lines that are inactive are simply not included in the table - they have the value nil.
    --- It doesn't check for activeline in subfunctions.
    --- **Option: L**
    activelines: table

end
--- Structure for Global.DynamicLight.
--- All members are case insensitive.
--- **NOTE**: This is an actual class named **dlight_t**, not a table.
global record S_DynamicLight
    --- The brightness of the light.
    brightness: number

    --- Fade out speed.
    --- Here's a formula for calculating Decay for your light: 1000 / fadeOutTimeInSeconds. For example setting decay to 1000 would fade out the light in 1 second, 2000 - 0.5 seconds.
    decay: number

    --- Time after which light will be removed.
    --- This is relative to Global.CurTime. If you put in a value that is less than or equal to Global.CurTime, the light will not behave properly.
    --- Note, that it does not affect fading out. Light will be removed regardless of it being fully faded out or not.
    dietime: number

    --- The light direction. Used with **InnerAngle** and **OuterAngle**.
    dir: GVector

    --- The closer this is to zero, the smoother the light will be. Requires **Dir** and **OuterAngle** to be set.
    innerangle: number

    --- The angle of the Dynamic Light. Requires **Dir** to be set.
    outerangle: number

    --- The entity index the light belongs to. Set automatically by Global.DynamicLight. Probably don't touch it.
    key: number

    --- Minimum light
    minlight: number

    --- Don't light the world. Has no effect for elights since they never light the world.
    noworld: boolean

    --- Don't light models
    nomodel: boolean

    --- Position of the light
    pos: GVector

    --- Radius of the light
    size: number

    --- Flicker style, see [this page](https://developer.valvesoftware.com/wiki/Light_dynamic#Appearances) for examples.
    style: number

    --- The blue part of the color
    b: number

    --- The green part of the color
    g: number

    --- The red part of the color
    r: number

end
--- Information about the ENT structure, which represents a Scripted Entity class definition.
--- To learn more about scripted entities, see this page.
--- See also ENTITY Hooks for a list of events scripted entities can have. See Custom Entity Fields for a list of events and fields all entities can have.
--- While some of the fields may be serverside or clientside only, it is recommended to provide them on both so addons could use their values.
--- **NOTE**: Values defined in ENT table can't be changed per instance. Initialize default values in ENTITY:Initialize or other hook.
global record S_ENT is GEntity
    --- The base entity to derive from. This **must** be a valid Lua entity
    Base: string

    --- Type of the entity. This **must** be one of these:
    --- * **anim**
    --- * **brush**
    --- * **point**
    --- * **ai**
    --- * **nextbot**
    --- * **filter**
    --- See Scripted Entities for a more detailed explanation of what each one is.
    Type: string

    --- The class name of the entity (File or folder name of your entity).
    --- **This is set automatically _after_ the entity file is loaded.**
    ClassName: string

    --- If set, overrides the classname of the SWEP.
    ClassNameOverride: string

    --- The folder from where the entity was loaded. This should always be "entity/ent_myentity", regardless whether your entity is stored as a file, or multiple files in a folder. **This is set automatically _before_ the entity file is loaded.**
    Folder: string

    --- Set this to true if your entity has animations. You should also apply changes to the ENTITY:Think function from the example on that page.
    AutomaticFrameAdvance: boolean

    --- Spawnmenu category to put the entity into
    Category: string

    --- Whether this entity should be displayed and is spawnable in the spawn menu
    Spawnable: boolean

    --- Whether the entity supports Editing. See Editable Entities for more info.
    Editable: boolean

    --- Whether or not only admins can spawn the entity from their spawn menu
    AdminOnly: boolean

    --- Nice name of the entity to appear in the spawn menu
    PrintName: string

    --- The author of the entity
    Author: string

    --- The contacts of the entity creator
    Contact: string

    --- The purpose of the entity creation
    Purpose: string

    --- How to use your entity
    Instructions: string

    --- The entity's render group, see Enums/RENDERGROUP. If unset, the engine will decide the render group based on the entity's model.
    RenderGroup: number

    --- If set and `RenderGroup` is not, will switch the render group to RENDERGROUP_BOTH when appropriate.
    --- Basically, when the default render group of the entity's model is opaque, ENTITY:DrawTranslucent will still be called, for example to render effects and such. This is preferable to forcing translucent models to render in the opaque pass by setting `RenderGroup` to `RENDERGROUP_BOTH` at all times, causing graphical issues.
    WantsTranslucency: boolean

    --- Disable the ability for players to duplicate this entity.
    DisableDuplicator: boolean

    --- Sets the spawnmenu content icon type for the entity, used by spawnmenu in the Sandbox-derived gamemodes.
    --- See spawnmenu.AddContentType for more information.
    ScriptedEntityType: string

    --- If set, overrides the icon path to be displayed in the Spawnmenu for this entity.
    --- Like many functions, this expects a path relative to the `materials/` folder, do not include `materials/` in the provided string.
    IconOverride: string

    --- If set, a bitflag for the physics solidity of the entity. See Enums/CONTENTS.
    --- Can be used to make the entity pass though certain otherwise solid meshes, such as grates, or special clip brushes.
    --- **NOTE**: This only works for `nextbot`, `anim` and `ai` type SENTs.
    PhysicsSolidMask: number

    --- For `anim` type entities, if set, enables physics collision sounds.
    PhysicsSounds: boolean
    --- Called when another entity fires an event to this entity.
    -- @param inputName --- The name of the input that was triggered.
    -- @param activator --- The initial cause for the input getting triggered. (e.g. the player who pushed a button)
    -- @param caller --- The entity that directly triggered the input. (e.g. the button that was pushed)
    -- @param param --- The input parameter.
    -- @return --- Should we suppress the default action for this input?
    --- Returning `true` for unknown inputs will also prevent the game complaining about the unknown input in console with `developer 2`.
    AcceptInput: function(inputName: string, activator: GEntity, caller: GEntity, param: string): boolean

    --- A helper function for creating Scripted Entities.
    --- Similar to ENTITY:AddOutputFromKeyValue, call it from ENTITY:AcceptInput and it'll return true if it successfully added an output from the passed input data.
    -- @param name --- The input name from ENTITY:AcceptInput.
    -- @param data --- The input data from ENTITY:AcceptInput.
    -- @return --- Whether any outputs were added or not.
    AddOutputFromAcceptInput: function(name: string, data: string): boolean

    --- A helper function for creating Scripted Entities.
    --- Call it from ENTITY:KeyValue and it'll return true if it successfully added an output from the passed KV pair.
    -- @param key --- The key-value key.
    -- @param value --- The key-value value.
    -- @return --- Whether any outputs were added or not.
    AddOutputFromKeyValue: function(key: string, value: string): boolean

    --- Called whenever the entity's position changes. A callback for when an entity's angle changes is available via Entity:AddCallback.
    --- Like ENTITY:RenderOverride, this hook works on any entity (scripted or not) it is applied on.
    --- **NOTE**: If EFL_DIRTY_ABSTRANSFORM is set on the entity, this will be called serverside only; otherwise, this will be called clientside only. This means serverside calls of Entity:SetPos without the EFL_DIRTY_ABSTRANSFORM flag enabled (most cases) will be called clientside only.
    --- **NOTE**: The give concommand will call this hook serverside only upon entity spawn.
    -- @param pos --- The entity's actual position. May differ from Entity:GetPos
    -- @param ang --- The entity's actual angles. May differ from Entity:GetAngles
    -- @return --- New position
    -- @return --- New angles
    CalcAbsolutePosition: function(pos: GVector, ang: GAngle): GVector, GAngle

    --- Called by the Sandbox gamemode from the default implementation of GM:CanEditVariable.
    -- @param ply --- The player is trying to edit a variable on this entity.
    -- @return --- `true` to allow the edit, `false` to disallow.
    CanEditVariables: function(ply: GPlayer): boolean

    --- Controls if a property can be used on this entity or not.
    --- This hook will only work in Sandbox derived gamemodes that do not have GM:CanProperty overridden.
    --- **NOTE**: This hook will work on ALL entities, not just the scripted ones (SENTs)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/shared.lua#L239-L241)
    -- @param ply --- Player, that tried to use the property
    -- @param property --- Class of the property that is tried to use, for example - bonemanipulate
    -- @return --- Return false to disallow using that property, return true to allow.
    --- You must return a value. Not returning anything can cause unexpected results.
    CanProperty: function(ply: GPlayer, property: string): boolean

    --- Controls if a tool can be used on this entity or not.
    --- This hook will only work in Sandbox derived gamemodes that do not have SANDBOX:CanTool overridden.
    --- **NOTE**: This hook will work on ALL entities, not just the scripted ones (SENTs)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/shared.lua#L73)
    -- @param ply --- Player, that tried to use the tool
    -- @param tr --- The trace of the tool. See TraceResult.
    -- @param toolname --- Class of the tool that is tried to use, for example - `weld`
    -- @param tool --- The tool mode table the player currently has selected.
    -- @param button --- The tool button pressed.
    --- * 1 - left click
    --- * 2 - right click
    --- * 3 - reload
    -- @return --- Return `false` to disallow using that tool on this entity, return `true` to allow.
    CanTool: function(ply: GPlayer, tr: table, toolname: string, tool: table, button: number): boolean

    --- **INTERNAL**:
    --- Called just before ENTITY:Initialize for "ai" type entities only.
    CreateSchedulesInternal: function()

    --- Called so the entity can override the bullet impact effects it makes. This is called when the entity itself fires bullets via Entity:FireBullets, not when it gets hit.
    --- **NOTE**: This hook only works for the `anim` type entities.
    -- @param tr --- A Structures/TraceResult from the bullet's start point to the impact point
    -- @param damageType --- The damage type of bullet. See Enums/DMG
    -- @return --- Return true to not do the default thing - which is to call `UTIL_ImpactTrace` in C++
    DoImpactEffect: function(tr: table, damageType: number): boolean

    --- Called by the default `base_ai` SNPC, checking whether `ENT.bDoingEngineSchedule` is set by ENTITY:StartEngineSchedule..
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L193)
    -- @return ENT.bDoingEngineSchedule ---
    DoingEngineSchedule: function(): boolean

    --- Runs a Lua schedule. Runs tasks inside the schedule.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L63)
    -- @param sched --- The schedule to run.
    DoSchedule: function(sched: table)

    --- Called if and when the entity should be drawn opaquely, based on the Entity:GetRenderGroup of the entity.
    --- See Structures/ENT and Enums/RENDERGROUP for more information.
    --- See also ENTITY:DrawTranslucent.
    --- **NOTE**: This function will not called if the entity's render bounds are not in player's view. See Entity:SetRenderBounds.
    -- @param flags --- The bit flags from Enums/STUDIO
    Draw: function(flags: number)

    --- Called when the entity should be drawn translucently. If your scripted entity has a translucent model, it will be invisible unless it is drawn here.
    --- See ENTITY:Draw for the opaque rendering alternative to this hook.
    -- @param flags --- The bit flags from Enums/STUDIO
    DrawTranslucent: function(flags: number)

    --- Called when the entity stops touching another entity.
    --- See ENTITY:StartTouch and ENTITY:Touch for related hooks.
    --- **WARNING**: This only works for **brush** entities and for entities that have Entity:SetTrigger set to true.
    -- @param entity --- The entity that we no longer touch.
    EndTouch: function(entity: GEntity)

    --- Called whenever an engine schedule is finished; either the last task within the engine schedule has been finished or the schedule has been interrupted by an interrupt condition.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    --- **NOTE**: This hook isn't called when the engine schedule is failed, the schedule is cleared with NPC:ClearSchedule or NPC:SetSchedule has been called.
    EngineScheduleFinish: function()

    --- Called when an NPC's expression has finished.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/init.lua#L94)
    -- @param strExp --- The path of the expression.
    ExpressionFinished: function(strExp: string)

    --- Called before firing clientside animation events, such as muzzle flashes or shell ejections.
    --- See ENTITY:HandleAnimEvent for the serverside version.
    --- **NOTE**: This hook only works on "anim", "nextbot" and "ai" type entities.
    -- @param pos --- Position of the effect
    -- @param ang --- Angle of the effect
    -- @param event --- The event ID of happened even. See [this page](http://developer.valvesoftware.com/wiki/Animation_Events). Only event IDs above 5000 will appear in this hook. (Are considered the "new" system in-engine)
    -- @param name --- Name of the event
    -- @return --- Return true to disable the effect
    FireAnimationEvent: function(pos: GVector, ang: GAngle, event: number, name: string): boolean

    --- Called to determine how good an NPC is at using a particular weapon.
    --- **NOTE**: "ai" base only
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/init.lua#L135)
    -- @param wep --- The weapon being used by the NPC.
    -- @param target --- The target the NPC is attacking
    -- @return --- The number of degrees of inaccuracy in the NPC's attack.
    GetAttackSpread: function(wep: GWeapon, target: GNPC): number

    --- Called when scripted NPC needs to check how he "feels" against another entity, such as when NPC:Disposition is called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/init.lua#L84)
    -- @param ent --- The entity in question
    -- @return --- How our scripter NPC "feels" towards the entity in question. See Enums/D. Not returning any value will make NPC:Disposition return the default disposition for this SNPC's given `m_iClass` by the engine.
    GetRelationship: function(ent: GEntity): E_D

    --- Specify a mesh that should be rendered instead of this SENT's model.
    --- **NOTE**: You should not be creating or modifying an IMesh in this hook. [Reference](https://github.com/Facepunch/garrysmod-issues/issues/6411#issuecomment-3070608549)
    -- @return --- A table containing the following keys:
    --- * IMesh Mesh - (Required) The mesh to render instead of the default model
    --- * IMaterial Material - (Required) The material to render the mesh with.
    --- * VMatrix Matrix - (Optional) - Render matrix override (mesh position, angles, etc)
    GetRenderMesh: function(): table

    --- Called when the shadow needs to be recomputed. Allows shadow angles to be customized. This only works for `anim` type entities.
    -- @param type --- Type of the shadow this entity uses. Possible values:
    --- * 0 - No shadow
    --- * 1 - Simple 'blob' shadow
    --- * 2 - Render To Texture shadow (updates only when necessary)
    --- * 3 - Dynamic RTT - updates always
    --- * 4 - Render to Depth Texture
    -- @return dir --- The new shadow direction to use.
    GetShadowCastDirection: function(type: number): GVector

    --- Called every second to poll the sound hint interests of this SNPC. This is used in conjunction with other sound hint functions, such as sound.EmitHint and NPC:GetBestSoundHint.
    --- **NOTE**: This hook only exists for `ai` type SENTs
    -- @return types --- A bitflag representing which sound types this NPC wants to react to.  See SOUND_ enums.
    GetSoundInterests: function(): number

    --- Called by GM:GravGunPickupAllowed on ALL entites in Sandbox-derived  gamemodes and acts as an override.
    -- @param ply --- The player aiming at us
    -- @return --- Return true to allow the entity to be picked up
    GravGunPickupAllowed: function(ply: GPlayer): boolean

    --- Called when this entity is about to be punted with the gravity gun (primary fire).
    --- Only works in Sandbox derived gamemodes and only if GM:GravGunPunt is not overridden.
    -- @param ply --- The player pressing left-click with the gravity gun at an entity
    -- @return --- Return true or false to enable or disable punting respectively.
    GravGunPunt: function(ply: GPlayer): boolean

    --- Called before firing serverside animation events, such as weapon reload, drawing and holstering for NPCs, scripted sequences, etc.
    --- See ENTITY:FireAnimationEvent for the clientside version.
    --- **NOTE**: This hook only works on "anim", "ai" and "nextbot" type entities.
    -- @param event --- The ID of the event. See [this page](http://developer.valvesoftware.com/wiki/Animation_Events) for a list of default events, and see util.GetAnimEventNameByID for a helper function in handing custom events.
    -- @param eventTime --- The absolute time this event occurred using Global.CurTime.
    -- @param cycle --- The frame this event occurred as a number between 0 and 1.
    -- @param type --- Event type. See [the Source SDK](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/shared/eventlist.h#L14-L23).
    -- @param options --- Name or options of this event.
    -- @return --- Return true to mark the event as handled.
    HandleAnimEvent: function(event: number, eventTime: number, cycle: number, type: number, options: string): boolean

    --- Called when a bullet trace hits this entity and allows you to override the default behavior by returning true.
    -- @param traceResult --- The trace that hit this entity as a Structures/TraceResult.
    -- @param damageType --- The damage bits associated with the trace, see Enums/DMG
    -- @param customImpactName --- The effect name to override the impact effect with.
    --- Possible arguments are ImpactJeep, AirboatGunImpact, HelicopterImpact, ImpactGunship.
    -- @return --- Return true to override the default impact effects.
    ImpactTrace: function(traceResult: table, damageType: number, customImpactName: string): boolean

    --- Called when the entity is created. This is called when you Entity:Spawn the custom entity.
    --- This is called **after** ENTITY:SetupDataTables and GM:OnEntityCreated.
    Initialize: function()

    --- Called when deciding if the Scripted NPC should be able to perform a certain jump or not.
    --- **NOTE**: This is only called for "ai" type entities
    -- @param startPos --- Start of the jump
    -- @param apex --- Apex point of the jump
    -- @param endPos --- The landing position
    -- @return --- Return true if this jump should be allowed to be performed, false otherwise.
    --- Not returning anything, or returning a non boolean will perform the [default action](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc_movement.cpp#L319).
    IsJumpLegal: function(startPos: GVector, apex: GVector, endPos: GVector): boolean

    --- Called when the engine sets a value for this scripted entity.
    --- This hook is called **before** ENTITY:Initialize when the key-values are set by the map.
    --- Otherwise this hook will be called whenever Entity:SetKeyValue is called on the entity.
    --- See GM:EntityKeyValue for a hook that works for all entities.
    --- See WEAPON:KeyValue for a hook that works for scripted weapons.
    -- @param key --- The key that was affected.
    -- @param value --- The new value.
    -- @return --- Return true to suppress this KeyValue or return false or nothing to apply this key value.
    KeyValue: function(key: string, value: string): boolean

    --- Start the next task in specific Lua schedule.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L108)
    -- @param sched --- The schedule to start next task in.
    NextTask: function(sched: table)

    --- Called when the currently active weapon of the SNPC changes.
    --- **NOTE**: This hook only works on `ai` type entities.
    -- @param old --- The previous active weapon.
    -- @param new --- The new active weapon.
    OnChangeActiveWeapon: function(old: GWeapon, new: GWeapon)

    --- Called when the NPC has changed its activity.
    --- **NOTE**: This hook only works for `ai` type entities.
    -- @param act --- The new activity. See Enums/ACT.
    OnChangeActivity: function(act: number)

    --- Called each time the NPC updates its condition.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @param conditionID --- The ID of condition. See NPC:ConditionName.
    OnCondition: function(conditionID: number)

    --- Called on any entity after it has been created by the duplicator and before any bone/entity modifiers have been applied.
    --- This hook is called after ENTITY:Initialize and before ENTITY:PostEntityPaste.
    -- @param entTable --- The stored data about the original entity that was duplicated. This would typically contain the Entity:GetTable fields that are serializalble. See Structures/EntityCopyData.
    OnDuplicated: function(entTable: table)

    --- Called after duplicator finishes saving the entity, allowing you to modify the save data.
    --- This is called after ENTITY:PostEntityCopy.
    -- @param data --- The save Structures/EntityCopyData that you can modify.
    OnEntityCopyTableFinish: function(data: table)

    --- Called when the SNPC completes its movement to its destination.
    --- **NOTE**: This hook only works on `ai` type entities.
    OnMovementComplete: function()

    --- Called when the SNPC failed to move to its destination.
    --- **NOTE**: This hook only works on `ai` type entities.
    OnMovementFailed: function()

    --- Called when the entity is reloaded by the lua auto-refresh system, i.e. when the developer edits the lua file for the entity while the game is running.
    OnReloaded: function()

    --- Called when the entity is about to be removed.
    --- See also Entity:CallOnRemove, which can even be used on engine (non-Lua) entities.
    --- <example>
    --- <description>Create an explosion when the entity will be removed. To create an entity, you can read ents.Create.</description>
    --- <code>
    --- function ENT:OnRemove()
    --- local explosion = ents.Create( "env_explosion" ) -- The explosion entity
    --- explosion:SetPos( self:GetPos() ) -- Put the position of the explosion at the position of the entity
    --- explosion:Spawn() -- Spawn the explosion
    --- explosion:SetKeyValue( "iMagnitude", "50" ) -- the magnitude of the explosion
    --- explosion:Fire( "Explode", 0, 0 ) -- explode
    --- end
    --- </code>
    --- </example>
    -- @param fullUpdate --- Whether the removal is happening due to a full update clientside.
    --- The entity may or **may not** be recreated immediately after, depending on whether it is in the local player's [PVS](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community"). (See Entity:IsDormant)
    OnRemove: function(fullUpdate: boolean)

    --- Called when the entity is reloaded from a Source Engine save (not the Sandbox saves or dupes) or on a changelevel (for example Half-Life 2 campaign level transitions).
    --- For the duplicator callbacks, see ENTITY:OnDuplicated.
    OnRestore: function()

    --- Called by the engine when NPC's state changes.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    -- @param oldState --- The old state. See Enums/NPC_STATE.
    -- @param newState --- The new state. See Enums/NPC_STATE.
    OnStateChange: function(oldState: number, newState: number)

    --- Called when the entity is taking damage.
    --- **WARNING**: Calling Entity:TakeDamage, Entity:TakeDamageInfo, Entity:DispatchTraceAttack, or Player:TraceHullAttack (if the entity is hit) in this hook on the victim entity can cause infinite loops since the hook will be called again. Make sure to setup recursion safeguards like the example below.
    --- **NOTE**: This hook is only called for `ai`, `nextbot` and `anim` type entities.
    -- @param damage --- The damage to be applied to the entity.
    -- @return --- How much damage the entity took. Basically `> 0` means took damage, `0` means did not take damage.
    OnTakeDamage: function(damage: GCTakeDamageInfo): number

    --- Called from the engine when TaskComplete is called.
    --- This allows us to move onto the next task - even when TaskComplete was called from an engine side task.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    OnTaskComplete: function()

    --- Called when a task this NPC was running has failed for whatever reason.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @param failCode --- The fail code for the task. It will be a [FAIL_ enum](https://github.com/ValveSoftware/source-sdk-2013/blob/0d8dceea4310fde5706b3ce1c70609d72a38efdf/sp/src/game/server/ai_task.h#L26) or a generated code for a custom string. (second argument)
    -- @param failReason --- If set, a custom reason for the failure.
    OnTaskFailed: function(failCode: number, failReason: string)

    --- Called to completely override NPC movement. This can be used for example for flying NPCs.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    -- @param interval --- Time interval for the movement, in seconds. Usually time since last movement.
    -- @return --- Return `true` to disable the default movement code.
    OverrideMove: function(interval: number): boolean

    --- Called to completely override the direction NPC will be facing during navigation.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    --- **NOTE**: This hook is called by the default movement hook. Returning `true` inside ENTITY:OverrideMove will prevent engine from calling this hook.
    -- @param interval --- Time interval for the movement, in seconds. Usually time since last movement.
    -- @param AILMG --- Extra data for the movement. A table containing the following data:
    --- * boolean hasTraced - The result if a forward probing trace has been done
    --- * number expectedDist = `speed*interval` - The distance expected to move this think
    --- * number flags - [AILMG flags](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_movetypes.h#L113)
    --- * number maxDist = NPC:GetPathDistanceToGoal - The distance maximum distance intended to travel in path length
    --- * number navType - Enums/NAV
    --- * number speed - Entity:GetSequenceGroundSpeed Note these need not always agree with `target`
    --- * Entity moveTarget = `m_hGoalEnt` - Target entity as goal.
    --- * Vector dir - The step direction, towards `target`
    --- * Vector facing - The direction NPC's body will turn during movement.
    --- * Vector target = NPC:GetCurWaypointPos - Current waypoint in world coordinates.
    -- @return --- Return `true` to disable the default movement facing code.
    OverrideMoveFacing: function(interval: number, AILMG: table): boolean

    --- Polls whenever the entity should trigger the brush.
    --- **WARNING**: This hook is broken and will not work without code below
    -- @param ent --- The entity that is about to trigger.
    -- @return --- Should trigger or not.
    PassesTriggerFilters: function(ent: GEntity): boolean

    --- Called when the entity collides with anything via [physics objects](PhysObj). The [move type](Enums/MOVETYPE) and [solid mode](Enums/SOLID) must be `VPHYSICS` for the hook to be called.
    --- This hook only works for `anim` type entities.
    --- This is different from ENTITY:Touch.
    --- **NOTE**: If you want to use this hook on default/engine/non-Lua entities (like `prop_physics`), use Entity:AddCallback instead! This page describes a hook for Lua scripted entities
    -- @param colData --- Information regarding the collision. See Structures/CollisionData.
    -- @param collider --- The physics object that collided.
    PhysicsCollide: function(colData: table, collider: GPhysObj)

    --- Called from the Entity's motion controller to simulate physics.
    --- This will only be called after using Entity:StartMotionController on a scripted entity of `anim` type.
    --- **NOTE**: This hook can work on the CLIENT if you call Entity:StartMotionController and use Entity:AddToMotionController on the physics objects you want to control
    --- **WARNING**: Do not use functions such as PhysObj:EnableCollisions or PhysObj:EnableGravity in this hook as they're very likely to crash your game. You may want to use ENTITY:PhysicsUpdate instead.
    -- @param phys --- The physics object of the entity.
    -- @param deltaTime --- Time since the last call.
    -- @return --- Angular force. The 3rd argument must be above SIM_NOTHING.
    -- @return --- Linear force. The 3rd argument must be above SIM_NOTHING.
    -- @return --- One of the Enums/SIM.
    PhysicsSimulate: function(phys: GPhysObj, deltaTime: number): GVector, GVector, number

    --- Called whenever a physics object of this entity is updated.
    --- This hook won't be called if the Entity's PhysObj goes asleep, or doesn't exist.
    -- @param phys --- The physics object of the entity.
    PhysicsUpdate: function(phys: GPhysObj)

    --- Called after the duplicator finished copying the entity.
    --- See also ENTITY:PreEntityCopy, ENTITY:PostEntityPaste and ENTITY:OnEntityCopyTableFinish.
    PostEntityCopy: function()

    --- Called after the duplicator pastes the entity, after the bone/entity modifiers have been applied to the entity.
    --- This hook is called after ENTITY:OnDuplicated. See also ENTITY:PreEntityCopy.
    -- @param ply --- The player who pasted the entity.
    --- **WARNING**: This may not be a valid player in some circumstances. For example, when a save is loaded from the main menu, this hook will be called before the player is spawned. This argument will be a NULL entity in that case.
    -- @param ent --- The entity itself. Same as `self` within the function context.
    -- @param createdEntities --- All entities that are within the placed dupe.
    --- **NOTE**: The keys of each value in this table are the original entity indexes when the duplication was created. This can be utilized to restore entity references that don't get saved in duplications.
    PostEntityPaste: function(ply: GPlayer, ent: GEntity, createdEntities: table)

    --- Called before the duplicator copies the entity.
    --- If you are looking for a way to make the duplicator spawn another entity when duplicated. (For example, you duplicate a `prop_physics`, but you want the duplicator to spawn `prop_physics_my`), you should add `prop_physics.ClassOverride = "prop_physics_my"`. The duplication table should be also stored on that `prop_physics`, not on `prop_physics_my`.
    --- See also ENTITY:PostEntityCopy.
    PreEntityCopy: function()

    --- Called instead of the engine drawing function of the entity. This hook works on any entity (scripted or not) it is applied on.
    --- This does not work on "physgun_beam", use GM:DrawPhysgunBeam instead.
    --- **BUG**: [Drawing a viewmodel in this function will cause GM:PreDrawViewModel, WEAPON:PreDrawViewModel, WEAPON:ViewModelDrawn, GM:PostDrawViewModel, and WEAPON:PostDrawViewModel to be called twice.](https://github.com/Facepunch/garrysmod-issues/issues/3292
    --- **BUG**: [This is called before PrePlayerDraw for players. If this function exists at all on a player, their worldmodel will always be rendered regardless of PrePlayerDraw's return.](https://github.com/Facepunch/garrysmod-issues/issues/3299
    -- @param flags --- The STUDIO_ flags for this render operation.
    RenderOverride: function(flags: number)

    --- Called from the engine every [m_flNextDecisionTime](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc.cpp#L3943C10-L3943C30) in seconds. This interval changes depending on NPC's [Efficiency](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc.cpp#L3093). Returning `true` inside this hook will allow [CAI_BaseNPC::MaintainSchedule](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc_schedule.cpp#L562) to also be called.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L5)
    -- @return --- `true` to run engine schedules
    RunAI: function(): boolean

    --- Called when an engine task is ran on the entity.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @param taskID --- The task ID, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    -- @param taskData --- The task data.
    -- @return --- true to prevent default action
    RunEngineTask: function(taskID: number, taskData: number): boolean

    --- Called every think on running task.
    --- The actual task function should tell us when the task is finished.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L138)
    -- @param task --- The task to run
    RunTask: function(task: table)

    --- Called whenever a Lua schedule is finished or ENTITY:StartEngineSchedule is called. Clears out schedule and task data stored within NPC's table.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L80)
    ScheduleFinished: function()

    --- Set the schedule we should be playing right now. Allows the NPC to start either a Lua schedule or an engine schedule. Despite sharing the same name as `CAI_BaseNPC::SelectSchedule()`, this isn't hooked to that function; this is called by Lua's ENTITY:RunAI, doesn't return an engine function, returning an engine function doesn't help and doesn't make the NPC start an engine schedule. To alter initial engine schedule, it is recommended to use ENTITY:TranslateSchedule.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L39)
    SelectSchedule: function()

    --- Toggles automatic frame advancing for animated sequences on an entity.
    --- This has the same effect as setting the ``ENT.AutomaticFrameAdvance`` property. (See Structures/ENT)
    -- @param enable --- Whether or not to set automatic frame advancing.
    SetAutomaticFrameAdvance: function(enable: boolean)

    --- Sets the current task, to be used in a Lua schedule.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L93)
    -- @param task --- The task to set.
    SetTask: function(task: table)

    --- Called when the entity should set up its  Data Tables.
    --- This is a much better option than using Set/Get Networked Values.
    --- This hook is called after GM:OnEntityCreated and GM:NetworkEntityCreated.
    SetupDataTables: function()

    --- This is the spawn function. It's called when a player spawns the entity from the spawnmenu.
    --- If you want to make your SENT spawnable you need this function to properly create the entity.
    --- **WARNING**: Unlike other ENTITY functions, the "self" parameter of this function is not an entity but rather the table used to generate the SENT. This table is equivalent to scripted_ents.GetStored("ent_name").
    -- @param ply --- The player that is spawning this SENT
    -- @param tr --- A Structures/TraceResult from player eyes to their aim position
    -- @param ClassName --- The classname of your entity
    SpawnFunction: function(ply: GPlayer, tr: table, ClassName: string)

    --- Called by the engine only whenever NPC:SetSchedule is called.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @param scheduleID --- Schedule ID to start. See Enums/SCHED
    StartEngineSchedule: function(scheduleID: number)

    --- Called when an engine task has been started on the entity.
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @param taskID --- Task ID to start, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    -- @param TaskData --- Task data
    -- @return --- true to stop default action
    StartEngineTask: function(taskID: number, TaskData: number): boolean

    --- Starts a schedule previously created by ai_schedule.New.
    --- Not to be confused with ENTITY:StartEngineSchedule or NPC:SetSchedule which start an Engine-based schedule.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L50)
    -- @param sched --- Schedule to start.
    StartSchedule: function(sched: GSchedule)

    --- Called once when a LUA schedule has started a task.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/schedules.lua#L129)
    -- @param task --- The task to start, created by ai_task.New.
    StartTask: function(task: GTask)

    --- Called when the entity starts touching another entity.
    --- See ENTITY:Touch and ENTITY:EndTouch for related hooks.
    --- **WARNING**: This only works for **brush** entities and for entities that have Entity:SetTrigger set to true.
    -- @param entity --- The entity that we started touching for the first time.
    StartTouch: function(entity: GEntity)

    --- Used to store an output so it can be triggered with ENTITY:TriggerOutput.
    --- Outputs compiled into a map are passed to entities as key/value pairs through ENTITY:KeyValue.
    --- TriggerOutput will do nothing if this function has not been called first.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_entity/outputs.lua#L10-L28)
    -- @param name --- Name of output to store
    -- @param info --- Output info
    StoreOutput: function(name: string, info: string)

    --- Returns true if the current running Task is finished.
    --- Tasks finish whenever NPC:TaskComplete is called, which sets `TASKSTATUS_COMPLETE` for all NPCs, also sets `self.bTaskComplete` for `ai` type [SENTs](Scripted_Entities).
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @return --- Is the current running Task is finished or not.
    TaskFinished: function(): boolean

    --- Returns how many seconds we've been doing this current task
    --- **NOTE**: This hook only exists for `ai` type [SENTs](Scripted_Entities).
    -- @return --- How many seconds we've been doing this current task
    TaskTime: function(): number

    --- Allows you to override trace result when a trace hits the entity.
    --- Your entity **must** have Entity:EnableCustomCollisions enabled for this hook to work.
    --- Your entity must also be otherwise "hit-able" with a trace, so it should have SOLID_OBB or SOLID_VPHYSICS be set (as an example), and it must have its collision bounds be set accordingly.
    --- **NOTE**: This hook is called for `anim` type only.
    -- @param startpos --- Start position of the trace.
    -- @param delta --- Offset from startpos to the endpos of the trace.
    -- @param isbox --- Is the trace a hull trace?
    -- @param extents --- Size of the hull trace, with the center of the Bounding Box being `0, 0, 0`, so mins are `-extents`, and maxs are `extents`.
    -- @param mask --- The Enums/CONTENTS mask.
    -- @return --- Returning a `table` will allow you to override trace results. Table should contain the following keys: (All keys fallback to the original trace value)
    --- * Vector `HitPos` - The new hit position of the trace.
    --- * number `Fraction` - A number from `0` to `1`, describing how far the trace went from its origin point, `1` = did not hit.
    --- * Could be calculated like so : `Fraction = ( startpos + delta ):Length() / myCustomHitPos:Length()`
    --- * Vector `Normal` - A unit vector (length=1) describing the direction perpendicular to the hit surface.
    --- Returning `true` will allow "normal" collisions to happen for `SOLID_VPHYSICS` and `SOLID_OBB` entities.
    --- Returning `nothing` or `false` allows the trace to ignore the entity completely.
    TestCollision: function(startpos: GVector, delta: GVector, isbox: boolean, extents: GVector, mask: number): table

    --- Called every frame on the client.
    --- Called about 5-6 times per second on the server.
    --- **NOTE**: You may need to call Entity:Spawn to get this hook to run server side.
    --- You can force it to run at servers tickrate using the example below.
    -- @return --- Return `true` if you used Entity:NextThink to override the next execution time. Otherwise it will be reset to `CurTime() + 0.2`.
    Think: function(): boolean

    --- Called every tick for every entity being "touched". Touching is usually detected via AABB intersection checks using entity's collision bounds.
    --- Entities like triggers would be using the touch hooks for their function.
    --- See Entity:PhysicsCollide for physics based collision events.
    --- See also ENTITY:StartTouch and ENTITY:EndTouch.
    --- **NOTE**: For physics enabled entities, this hook will **not** be ran while the entity's physics is asleep. See PhysObj:Wake.
    -- @param entity --- The entity that touched it.
    Touch: function(entity: GEntity)

    --- Called by the engine to alter NPC activities, if desired by the NPC.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    -- @param oldAct --- The activity to translate.
    -- @return newAct --- The activity that should override the incoming activity.
    --- Not returning anything, or returning a non value will perform the [default action](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc.cpp#L5976).
    TranslateActivity: function(oldAct: E_ACT): E_ACT

    --- Called by the engine to alter NPC's final position to reach its enemy or target. This is called twice for `GOALTYPE_PATHCORNER`; first is for the first path_corner and second for the next connected path_corner.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    -- @param target --- The enemy being chased or the path_corner in query.
    -- @param currentGoal --- The target's origin.
    -- @return --- The actual point that NPC will move to reach its enemy or target. For the path to get updated, the new move path must be away from the current NPC:GetGoalPos by 120 units.
    --- Not returning anything, or returning a non vector will perform the [default action](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_basenpc_schedule.cpp#L4251).
    TranslateNavGoal: function(target: GNPC|GEntity, currentGoal: GVector): GVector

    --- Called by the engine to alter NPC schedules, if desired by the NPC.
    --- **NOTE**: This hook only exists for `ai` type SENTs.
    -- @param schedule --- The schedule to translate. See Enums/SCHED.
    -- @return --- The schedule that should override the incoming schedule.
    --- Not returning anything, or returning a non value will perform the [default action](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/ai_default.cpp#L253).
    TranslateSchedule: function(schedule: E_SCHED): E_SCHED

    --- Triggers all outputs stored using ENTITY:StoreOutput.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_entity/outputs.lua#L105-L123)
    -- @param output --- Name of output to fire
    -- @param activator --- Activator entity
    -- @param data --- The data to give to the output.
    TriggerOutput: function(output: string, activator: GEntity, data: string)

    --- Called whenever the transmit state should be updated.
    -- @return --- Transmit state to set, see Enums/TRANSMIT.
    UpdateTransmitState: function(): number

    --- Called when an entity "uses" this entity, for example a player pressing their `+use` key (default ``) on this entity.
    --- To change how often the hook is called, see Entity:SetUseType.
    --- **NOTE**: This hook only works for `nextbot`, `ai` and `anim` scripted entity types.
    -- @param activator --- The entity that caused this input. This will usually be the player who pressed their use key.
    -- @param caller --- The entity responsible for the input. This will typically be the same as `activator` unless some other entity is acting as a proxy.
    -- @param useType --- Use type, see Enums/USE.
    -- @param value --- Any passed value.
    --Use: function(activator: GEntity, caller: GEntity, useType: E_USE, value: number)
end
--- Passed as argument of GM:EntityEmitSound.
global record S_EmitSoundInfo
    --- The file path of the played sound.
    --- Sounds prefixed with ) tell the sound engine that it is a spatial sound; this allows the sound to emit from a specific location within the world.
    --- Sounds prefixed with ^ tell the sound engine that it is a distance based sound. The left channel of the .wav is the 'near' sound that will play when the sound originates close to you, and the right channel is the 'far' sound that will play when the sound originates far from you.
    SoundName: string

    --- The original file path or soundscript name.
    --- Even if the SoundName value is changed, the OriginalSoundName value will remain the same.
    --- Sounds may be returned as soundscripts (for example, "Weapon_357.Single") instead of the sound's file path. You can use sound.GetProperties to retrieve the actual file path.
    OriginalSoundName: string

    --- The time at which the sound should be played.
    --- If equal to 0 or CurTime(), the sound is played immediately. If greater than CurTime(), the sound is played with a delay. If less than CurTime(), part of the sound is skipped.
    SoundTime: number

    --- The DSP (digital signal processing) preset applied to the sound.
    --- There are approximately 134 different presets defined by the Source engine between 0 and 133. These presets represent different types of 'rooms' or environments.
    --- [List of DSP's](https://developer.valvesoftware.com/wiki/Dsp_presets)
    DSP: number

    --- The sound's attenuation, a number between 0 (low) and 511 (high)
    --- This determines how fast the sound drops away. A higher value means the sound can be heard farther away.
    --- See Enums/SNDLVL.
    SoundLevel: E_SNDLVL

    --- The pitch of the played sound, a number between 0 (low) and 255 (high), where 100 is the sound's original pitch.
    Pitch: number

    --- The bit flags of the played sound. See Enums/SND for available options.
    Flags: E_SND

    --- The sound's channel. See Enums/CHAN for available options.
    Channel: E_CHAN

    --- The volume of the played sound, return as a decimal number between 0 (low) and 1 (high).
    Volume: number

    --- The entity that played the sound.
    Entity: GEntity

    --- The origin of the played sound.
    Pos: GVector

end
--- Data structure used by the duplicator to store and load entity data.
--- It is created by duplicator.CopyEntTable and can be loaded by duplicator.CreateEntityFromTable.
--- It also shows up in several other contexts:
--- * duplicator.RegisterEntityClass
--- * ENTITY:OnEntityCopyTableFinish
--- * ENTITY:OnDuplicated
--- **NOTE**: In addition to all fields listed here, any field saved on the entity will be saved as-is to this table. For example, if you set `ent.FavoriteFood = "Steak"` before duplicating it, this structure will also contain the field `FavoriteFood` with the value `"Steak"`.
global record S_EntityCopyData
    --- The entity's name, see Entity:GetName.
    Name: string

    --- The entity's class name, see Entity:GetClass.
    Class: string

    --- The entity's position, relative to the duplication origin point.
    Pos: GVector

    --- The entity's angle, relative to the duplication angle.
    Angle: GAngle

    --- The entity's Network Vars, see ENTITY:SetupDataTables and Networking Entities.
    DT: table

    --- The entity's model, see Entity:GetModel.
    Model: string

    --- The entity's model scale, see Entity:GetModelScale. This will only be present if the model scale isn't 1.
    ModelScale: number

    --- The entity's active skin, see Entity:GetSkin.
    Skin: number

    --- The entity's collision group, see Entity:GetCollisionGroup. Uses the Enums/COLLISION_GROUP.
    ColGroup: number

    --- The entity's collision bound minimums, see Entity:GetCollisionBounds.
    Mins: GVector

    --- The entity's collision bound maximums, see Entity:GetCollisionBounds.
    Maxs: GVector

    --- Data about the entity's PhysObjs, see Entity:GetPhysicsObjectNum. The key is the physics object index (starts from 0), and the value is a Structures/PhysicsObjectSave. Unlike other tables in this structure, if there are no physics objects for this entity this will be an empty table.
    PhysicsObjects: table

    --- The entity's Flex Scale, see Entity:GetFlexScale.
    FlexScale: number

    --- Each flex bone's flex weight, see Entity:GetFlexWeight. The key is the flex's index and the value is the weight. Only flexes with a non-default (nonzero) weight are listed, and if none exist, this field will be nil.
    Flex: table

    --- The entity's body groups, see Entity:GetBodygroup. The key is the bodygroup ID and the value is the assigned bodygroup number. Only body groups with a non-default (> 0) value are listed, and if none exist, this field will be nil.
    BodyG: table

    --- Bone manipulation data, see Entity:HasBoneManipulations. The key is the bone index and the value is a Structures/BoneManipulationData. Only bones that have been manipulated with non-default values are listed, and if none exist, this field will be nil.
    BoneManip: table

    --- The entity's MapCreationID, only exists for entities that were created by the map. See Entity:MapCreationID.
    MapCreationID: number

    --- Deprecated, always 0. See Entity:GetWorkshopID.
    WorkshopID: number

end
--- The table structure used for bullets that have already been fired.
--- See GM:PostEntityFireBullets for more information.
global record S_FiredBullet
    --- The type of ammo that was fired.
    --- Should be one of the values from the game.GetAmmoTypes table.
    AmmoType: string

    --- The Entity that fired the bullet.
    --- This is usually the Player that is holding the Weapon.
    Attacker: GEntity

    --- The amount of damage dealt by the bullet.
    --- When set to `0`, damage should be determined based on the values set in the Structures/AmmoData of the bullet's Ammo Type.
    Damage: number

    --- The physics impact force of the bullet.
    Force: number

    --- A whole integer number that controls the frequency of visible bullet tracers.
    --- A tracer will be fired once after this many non-tracer bullets have been fired.
    --- Set to `1` to always fire a tracer.
    Tracer: number

    --- The Structures/TraceResult from the Trace that determined where and what the bullet hit.
    Trace: S_TraceResult

end
--- Used for surface.CreateFont.
global record S_FontData
    --- The font source. Custom font files are stored in `resource/fonts/`.
    --- The length is limited to 31 characters maximum.
    --- **WARNING**: This must be the actual 'nice' font, not a file name. Unless the client is running Linux or macOS. (Finding the Font Name)
    --- This also cannot be an already registered font, i.e. you cannot base your font from any of the Default Fonts
    font: string

    --- Allow the font to display glyphs that are outside of the Latin-1 range. Unicode code points above 0xFFFF are not supported.
    extended: boolean

    --- The font height in pixels
    --- `Range:` 4 - 255
    size: number

    --- The font boldness
    weight: number

    --- The strength of the font blurring
    --- `Range:` 0 - 80
    blursize: number

    --- The "scanline" interval
    --- Must be > 1 to work. This setting is per blursize per font - so if you create a font using "Arial" without scanlines, you cannot create an Arial font using scanlines with the same blursize
    scanlines: number

    --- Smooth the font
    antialias: boolean

    --- Add an underline to the font
    underline: boolean

    --- Make the font italic
    italic: boolean

    --- Add a strike through
    strikeout: boolean

    --- Enables the use of symbolic fonts such as Webdings
    symbol: boolean

    --- Seems to add a line in the middle of each letter
    rotary: boolean

    --- Add shadow casting to the font
    shadow: boolean

    --- Additive rendering
    additive: boolean

    --- Add a black outline to the font.
    --- This does not work well with antialias, and only allows black 1-pixel outlines. It may be preferable to not use this parameter, and instead use draw.SimpleTextOutlined when drawing text that you want outlined.
    outline: boolean

end
--- Table created by the string.FormattedTime function if no format is given to it.
global record S_FormattedTime
    --- milliseconds
    ms: number

    --- seconds
    s: number

    --- minutes
    m: number

    --- hours
    h: number

end
--- Information about a gamemode.
--- While some of the fields may be serverside or clientside only, it is recommended to provide them on both so addons could use their values.
global record S_GM
    --- The fancy name of your gamemode.
    Name: string

    --- The name/contact info of the gamemode author.
    Author: string

    --- The contact email associated with the gamemode.
    Email: string

    --- The website associated with the gamemode.
    Website: string

    --- The name of the gamemode folder, automatically set.
    FolderName: string

    --- The name of the gamemode folder prepended with "gamemodes/" (such as "gamemodes/sandbox"), automatically set.
    Folder: string

    --- Set this to true if your gamemode is team-based. Used to enable/disable the base gamemode team system.
    TeamBased: boolean

    --- The name of the gamemode folder prepended with "gamemode_" (such as "gamemode_sandbox"), automatically set.
    ThisClass: string

    --- The table of the base gamemode to derive from, set automatically by Global.DeriveGamemode.
    --- **NOTE**: It is recommended to use Global.DEFINE_BASECLASS when referencing the gamemode's BaseClass to prevent unintended behavior
    --- **NOTE**: Global.DeriveGamemode modifies the main gamemode's BaseClass, which is shared with parent gamemodes. Because of this, in parent gamemodes the BaseClass can be incorrect, so for instance you need to use `self.BaseClass.BaseClass` in the 1st parent instead
    BaseClass: table

    --- Whether the gamemode is Sandbox, or derived from Sandbox. This is not really part of the `GM` structure, and listed here only for convenience.
    IsSandboxDerived: boolean
    --- Called when a map I/O event occurs.
    --- See also Entity:Fire and Entity:Input for functions to fire Inputs on entities.
    -- @param ent --- Entity that receives the input
    -- @param input --- The input name. Is not guaranteed to be a valid input on the entity.
    -- @param activator --- Activator of the input
    -- @param caller --- Caller of the input
    -- @param value --- Data provided with the input. Will be either a string, a number, a boolean or a nil.
    -- @return --- Return true to prevent this input from being processed. Do not return otherwise.
    AcceptInput: function(ent: GEntity, input: string, activator: GEntity, caller: GEntity, value: any): boolean

    --- Adds a death notice entry.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_deathnotice.lua#L202-L223)
    -- @param attacker --- The name of the attacker
    -- @param attackerTeam --- The team of the attacker
    -- @param inflictor --- Class name of the entity inflicting the damage
    -- @param victim --- Name of the victim
    -- @param victimTeam --- Team of the victim
    -- @return --- `true/false` to prevent the notice from being shown. Do not return otherwise.
    AddDeathNotice: function(attacker: string, attackerTeam: number, inflictor: string, victim: string, victimTeam: number): any

    --- Allows you to adjust the mouse sensitivity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L418)
    -- @param defaultSensitivity --- The old sensitivity
    --- In general it will be 0, which is equivalent to a sensitivity of 1.
    -- @param localFOV --- Player's current FOV.
    -- @param defaultFOV --- Default FOV.
    -- @return --- A fraction of the normal sensitivity (0.5 would be half as sensitive).
    --- Return -1 to not override and prevent subsequent hooks and WEAPON:AdjustMouseSensitivity from running.
    --- Return nil to not override and allow subsequent hooks and WEAPON:AdjustMouseSensitivity to run.
    AdjustMouseSensitivity: function(defaultSensitivity: number, localFOV: number, defaultFOV: number): number

    --- Called when a player tries to pick up something using the "use" key, return to override.
    --- This hook will not be called if `sv_playerpickupallowed` is set to 0.
    --- See GM:GravGunPickupAllowed for the Gravity Gun pickup variant.
    --- See GM:PhysgunPickup for the Physics Gun pickup variant.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L818-L828)
    -- @param ply --- The player trying to pick up something.
    -- @param ent --- The Entity the player attempted to pick up.
    -- @return --- Allow the player to pick up the entity or not.
    AllowPlayerPickup: function(ply: GPlayer, ent: GEntity): boolean

    --- This hook is used to calculate animations for a player.
    --- **WARNING**: This hook must return the same values at the same time on both, client **and** server. On client for players to see the animations, on server for hit detection to work properly.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L296-L321)
    -- @param ply --- The player to apply the animation.
    -- @param vel --- The velocity of the player.
    -- @return --- Enums/ACT for the activity the player should use. A nil return will be treated as ACT_INVALID.
    -- @return --- Sequence for the player to use. This takes precedence over the activity (the activity is still used for layering). Return -1 or nil to let the activity determine the sequence.
    CalcMainActivity: function(ply: GPlayer, vel: GVector): number, number

    --- Called from GM:CalcView when player is in driving a vehicle.
    --- This hook may not be called in gamemodes that override GM:CalcView.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L305)
    -- @param veh --- The vehicle the player is driving
    -- @param ply --- The vehicle driver
    -- @param view --- The view data containing players FOV, view position and angles, see Structures/CamData
    -- @return --- The modified view table containing new values, see Structures/CamData
    CalcVehicleView: function(veh: GVehicle, ply: GPlayer, view: table): table

    --- Allows override of the default view.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L357)
    -- @param ply --- The local player.
    -- @param origin --- The player's view position.
    -- @param angles --- The player's view angles.
    -- @param fov --- Field of view.
    -- @param znear --- Distance to near clipping plane.
    -- @param zfar --- Distance to far clipping plane.
    -- @return --- View data table. See Structures/CamData
    CalcView: function(ply: GPlayer, origin: GVector, angles: GAngle, fov: number, znear: number, zfar: number): table

    --- Allows overriding the position and angle of the viewmodel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L555)
    -- @param wep --- The weapon entity
    -- @param vm --- The viewmodel entity
    -- @param oldPos --- Original position (before viewmodel bobbing and swaying)
    -- @param oldAng --- Original angle (before viewmodel bobbing and swaying)
    -- @param pos --- Current position
    -- @param ang --- Current angle
    -- @return --- New position
    -- @return --- New angle
    CalcViewModelView: function(wep: GWeapon, vm: GEntity, oldPos: GVector, oldAng: GAngle, pos: GVector, ang: GAngle): GVector, GAngle

    --- Called whenever a players tries to create an undo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L328-L328)
    -- @param ply --- The player who tried to create something.
    -- @param undo --- The undo table as a Structures/Undo.
    -- @return --- Return false to disallow creation of the undo.
    CanCreateUndo: function(ply: GPlayer, undo: table): boolean

    --- Called when a variable is about to be edited on an Entity (called by `Edit Properties...` menu), to determine if the edit should be permitted.
    --- See Editable entities for more details about the system.
    --- By default, Sandbox will also call ENTITY:CanEditVariables if no hook returns a value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/variable_edit.lua#L28)
    -- @param ent --- The entity being edited.
    -- @param ply --- The player doing the editing.
    -- @param key --- The name of the variable.
    -- @param value --- The new value, as a string which will later be converted to its appropriate type.
    -- @param editor --- The edit table defined in Entity:NetworkVar.
    -- @return --- Return `false` to disallow editing.
    CanEditVariable: function(ent: GEntity, ply: GPlayer, key: string, value: string, editor: table): boolean

    --- Determines if the player can exit the vehicle on their own. Player:ExitVehicle will bypass this hook.
    --- See GM:CanPlayerEnterVehicle for the opposite hook.
    --- See also GM:PlayerLeaveVehicle for a hook that will be called whenever a player exits any vehicle for any reason.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L567)
    -- @param veh --- The vehicle entity
    -- @param ply --- The player
    -- @return --- True if the player can exit the vehicle.
    CanExitVehicle: function(veh: GVehicle, ply: GPlayer): boolean

    --- Determines whether or not a given player player can enter the given vehicle. Player:EnterVehicle will still call this hook.
    --- Called just before GM:PlayerEnteredVehicle. See also GM:CanExitVehicle.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L584-L590)
    -- @param player --- The player that wants to enter a vehicle.
    -- @param vehicle --- The vehicle in question.
    -- @param role --- The seat number.
    -- @return --- `false` if the player is not allowed to enter the vehicle.
    CanPlayerEnterVehicle: function(player: GPlayer, vehicle: GVehicle, role: number): boolean

    --- Determines if the player can kill themselves using the `kill` or `explode` console commands.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L554-L556)
    -- @param player --- The player
    -- @return --- `true` if the player should be allowed to suicide, `false` if not.
    CanPlayerSuicide: function(player: GPlayer): boolean

    --- Determines if the player can unfreeze the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L65-L69)
    -- @param player --- The player
    -- @param entity --- The entity
    -- @param phys --- The physics object of the entity
    -- @return --- True if they can unfreeze.
    CanPlayerUnfreeze: function(player: GPlayer, entity: GEntity, phys: GPhysObj): boolean

    --- Controls if a property can be used or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L263-L265)
    -- @param ply --- Player, that tried to use the property
    -- @param property --- Class of the property that is tried to use, for example - bonemanipulate
    --- **WARNING**: This is not guaranteed to be the internal property name used in properties.Add!
    -- @param ent --- The entity, on which property is tried to be used on
    -- @return --- Return false to disallow using that property
    CanProperty: function(ply: GPlayer, property: string, ent: GEntity): boolean

    --- Called whenever a players tries to undo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L429-L429)
    -- @param ply --- The player who tried to undo something.
    -- @param undo --- The undo table as a Structures/Undo.
    -- @return --- Return false to disallow the undo.
    CanUndo: function(ply: GPlayer, undo: S_Undo): boolean

    --- Called each frame to record demos to video using IVideoWriter.
    --- **NOTE**: This hook is called every frame regardless of whether or not a demo is being recorded
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/demo_to_video.lua#L286-L310)
    CaptureVideo: function()

    --- Called when a message is printed to the chat box. Note, that this isn't working with player messages even though there are arguments for it.
    --- For player messages see GM:PlayerSay and GM:OnPlayerChat
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L250-L260)
    -- @param index --- The index of the player.
    -- @param name --- The name of the player.
    -- @param text --- The text that is being sent.
    -- @param type --- Chat filter type. Possible values are:
    --- * `joinleave` - Player join and leave messages
    --- * `namechange` - Player name change messages
    --- * `servermsg` - Server messages such as convar changes
    --- * `teamchange` - Team changes?
    --- * `chat` - (Obsolete?) Player chat? Seems to trigger when server console uses the `say` command
    --- * `none` - A fallback value
    -- @return --- Return true to suppress the chat message.
    ChatText: function(index: number, name: string, text: string, type: string): boolean

    --- Called whenever the content of the user's chat input box is changed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L243-L244)
    -- @param text --- The new contents of the input box
    ChatTextChanged: function(text: string)

    --- Called when a **non local player** connects to allow the Lua system to check the password.
    --- The default behaviour in the base gamemodes emulates what would normally happen. If `sv_password` is set and its value matches the password passed in by the client (via `password` concommand) - then they are allowed to join. If `sv_password` isn't set it lets them in too.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/init.lua#L124-L141)
    -- @param steamID64 --- The 64bit Steam ID of the joining player, use util.SteamIDFrom64 to convert it to a `STEAM_0:` one.
    -- @param ipAddress --- The IP of the connecting client
    -- @param svPassword --- The current value of sv_password (the password set by the server)
    -- @param clPassword --- The password provided by the client
    -- @param name --- The name of the joining player
    -- @return --- If the hook returns `false` then the player is disconnected
    -- @return --- If returning false in the first argument, then this should be the disconnect message. This will default to `#GameUI_ServerRejectBadPassword`, which is `Bad Password.` translated to the client's language.
    CheckPassword: function(steamID64: string, ipAddress: string, svPassword: string, clPassword: string, name: string): boolean, string

    --- Called when a player's sign on state changes.
    --- **BUG**: [You cannot get a valid player object from the userID at any point during this hook.](https://github.com/Facepunch/garrysmod-issues/issues/4899
    -- @param userID --- The userID of the player whose sign on state has changed.
    -- @param oldState --- The previous sign on state. See SIGNONSTATE enums.
    -- @param newState --- The new/current sign on state. See SIGNONSTATE enums.
    ClientSignOnStateChanged: function(userID: number, oldState: number, newState: number)

    --- Called when derma menus are closed with Global.CloseDermaMenus.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L729-L730)
    CloseDermaMenus: function()

    --- Called whenever an entity becomes a clientside ragdoll.
    --- See GM:CreateEntityRagdoll for serverside ragdolls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L732-L733)
    -- @param entity --- The Entity that created the ragdoll
    -- @param ragdoll --- The ragdoll being created.
    CreateClientsideRagdoll: function(entity: GEntity, ragdoll: GEntity)

    --- Called when a serverside ragdoll of an entity has been created.
    --- See GM:CreateClientsideRagdoll for clientside ragdolls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/init.lua#L85-L86)
    -- @param owner --- Entity that owns the ragdoll
    -- @param ragdoll --- The ragdoll entity
    CreateEntityRagdoll: function(owner: GEntity, ragdoll: GEntity)

    --- Allows you to change the players movements before they're sent to the server.
    --- See Game Movement for an explanation on the move system.
    --- **NOTE**: Due to this hook being clientside only, it could be overridden by the user allowing them to completely skip your logic, it is recommended to use GM:StartCommand in a shared file instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L653-L659)
    -- @param cmd --- The User Command data
    -- @return --- Return true to:
    --- * Disable Sandbox C menu "screen clicking"
    --- * Disable Teammate nocollide (verification required)
    --- * Prevent calling of C_BaseHLPlayer::CreateMove & subsequently C_BasePlayer::CreateMove
    CreateMove: function(cmd: GCUserCmd): boolean

    --- Teams are created within this hook using team.SetUp.
    --- This hook is called before GM:PreGamemodeLoaded.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L127-L149)
    CreateTeams: function()

    --- Called upon an animation event, this is the ideal place to call player animation functions such as Player:AddVCDSequenceToGestureSlot, Player:AnimRestartGesture and so on.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L352-L396)
    -- @param ply --- Player who is being animated
    -- @param event --- Animation event. See Enums/PLAYERANIMEVENT
    -- @param data --- The data for the event. This is interpreted as an Enums/ACT by `PLAYERANIMEVENT_CUSTOM` and `PLAYERANIMEVENT_CUSTOM_GESTURE`, or a sequence by `PLAYERANIMEVENT_CUSTOM_SEQUENCE`.
    -- @return --- The translated activity to send to the weapon. See Enums/ACT. Return `ACT_INVALID` if you don't want to send an activity.
    DoAnimationEvent: function(ply: GPlayer, event: number, data: number): number

    --- Handles the player's death.
    --- This hook is **not** called if the player is killed by Player:KillSilent. See GM:PlayerSilentDeath for that.
    --- * GM:PlayerDeath is called after this hook
    --- * GM:PostPlayerDeath is called after that
    --- **NOTE**: Player:Alive will return false in this hook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/init.lua#L39-L57)
    -- @param ply --- The player
    -- @param attacker --- The entity that killed the player
    -- @param dmg --- Damage info
    DoPlayerDeath: function(ply: GPlayer, attacker: GEntity, dmg: GCTakeDamageInfo)

    --- This hook is called every frame to draw all of the current death notices.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_deathnotice.lua#L254-L292)
    -- @param x --- X position to draw death notices as a ratio
    -- @param y --- Y position to draw death notices as a ratio
    DrawDeathNotice: function(x: number, y: number)

    --- Called every frame before drawing the in-game monitors ( Breencast, in-game TVs, etc ), but doesn't seem to be doing anything, trying to render 2D or 3D elements fail.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L717-L718)
    DrawMonitors: function()

    --- Called after all other 2D draw hooks are called. Draws over all VGUI Panels and HUDs.
    --- Unlike GM:HUDPaint, this hook is called with the game paused and while the Camera SWEP is equipped.
    --- Does not get called when `r_drawvgui` is disabled.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L714-L715)
    DrawOverlay: function()

    --- Allows you to override physgun effects rendering.
    --- **NOTE**: This is still called when `physgun_drawbeams` is set to `0`, because this hook is also capable of overriding physgun sprite effects, while the convar does not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L634-L639)
    -- @param ply --- Physgun owner
    -- @param physgun --- The physgun
    -- @param enabled --- Is the beam enabled
    -- @param target --- Entity we are grabbing. This will be NULL if nothing is being held
    -- @param physBone --- ID of the physics bone (PhysObj) we are grabbing at. Use Entity:TranslatePhysBoneToBone to translate to an actual bone.
    -- @param hitPos --- Beam hit position relative to the physics bone (PhysObj) we are grabbing.
    -- @return --- Return false to hide default effects
    DrawPhysgunBeam: function(ply: GPlayer, physgun: GWeapon, enabled: boolean, target: GEntity, physBone: number, hitPos: GVector): boolean

    --- Called right before an entity stops driving. Overriding this hook will cause it to not call drive.End and the player will not stop driving.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L215-L219)
    -- @param ent --- The entity being driven
    -- @param ply --- The player driving the entity
    EndEntityDriving: function(ent: GEntity, ply: GPlayer)

    --- Called whenever a sound has been played. This will not be called clientside if the server played the sound without the client also calling Entity:EmitSound.
    -- @param data --- Information about the played sound. Changes done to this table can be applied by returning `true` from this hook.
    --- See Structures/EmitSoundInfo.
    -- @return --- * Return `true` to apply all changes done to the data table.
    --- * Return `false` to prevent the sound from playing.
    --- * Return `nil` or nothing to play the sound without altering it.
    EntityEmitSound: function(data: table): boolean

    --- Called every time a bullet is about to be fired from an entity, which allows to completely modify the bullet structure before the bullet is actually fired.
    --- See GM:PostEntityFireBullets if you wish to hook the final bullet values, such as the aim direction post spread calculations.
    --- **WARNING**: This hook is called directly from Entity:FireBullets. Due to this, you cannot call Entity:FireBullets inside this hook or an infinite loop will occur crashing the game.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L270-L272)
    -- @param entity --- The entity that fired the bullet
    -- @param data --- The bullet data. See Structures/Bullet.
    -- @return --- * Return `true` to apply all changes done to the bullet table.
    --- * Return `false` to suppress the bullet.
    EntityFireBullets: function(entity: GEntity, data: S_Bullet): boolean

    --- Called when a key-value pair is set on an entity on map spawn. Is **not** called by Entity:SetKeyValue.
    --- See ENTITY:KeyValue for a scripted entities hook, and its scripted weapon alternative: WEAPON:KeyValue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L120-L121)
    -- @param ent --- Entity that the keyvalue is being set on
    -- @param key --- Key of the key/value pair
    -- @param value --- Value of the key/value pair
    -- @return --- If set, the value of the key-value pair will be overridden by this string.
    EntityKeyValue: function(ent: GEntity, key: string, value: string): string

    --- Called when an NW2Var is changed.
    --- **BUG**: [If a NW2Var is set on an entity that is based on a Lua Entity could result in the NW2Var being mixed up with other ones and being updated multiple times.](https://github.com/Facepunch/garrysmod-issues/issues/5455
    --- **NOTE**: This hook is fired before the client value is actually changed. Calling the GetNW2 function for the specified variable name within this hook will return the old value, not the current/updated one.
    --- This hook gets called for all NW2Vars on all Entities in a full update. The old value will be nil in this case.
    --- If this hook seems to be called for no apparent reason, check if it's caused by a full update.
    -- @param ent --- The owner entity of the changed NW2Var
    -- @param name --- The name of the changed NW2Var
    -- @param oldval --- The old value of the NW2Var
    -- @param newval --- The new value of the NW2Var
    EntityNetworkedVarChanged: function(ent: GEntity, name: string, oldval: any, newval: any)

    --- Called right before removal of an entity.
    --- **WARNING**: This hook is called clientside during full updates due to how networking works in the Source Engine.
    --- This can happen when the client briefly loses connection to the server, and can be simulated via `cl_fullupdate` for testing purposes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L98-L99)
    -- @param ent --- Entity being removed
    -- @param fullUpdate --- Whether the removal is happening due to a full update clientside.
    --- The entity may or **may not** be recreated immediately after, depending on whether it is in the local player's [PVS](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community"). (See Entity:IsDormant)
    EntityRemoved: function(ent: GEntity, fullUpdate: boolean)

    --- Called when an entity is about to take damage. You can modify all parts of the damage info in this hook or completely block the damage event.
    --- See GM:PostEntityTakeDamage if you wish to hook the final damage event.
    --- **WARNING**: Applying damage from this hook to the entity taking damage will lead to infinite loop/crash.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/init.lua#L71-L72)
    -- @param target --- The entity taking damage
    -- @param dmg --- Detailed information about the damage event.
    -- @return --- Return true to completely block the damage event
    EntityTakeDamage: function(target: GEntity, dmg: GCTakeDamageInfo): boolean

    --- This hook polls the entity the player use action should be applied to.
    --- **NOTE**: The default behavior of this hook is in [CBasePlayer::FindUseEntity](https://github.com/ValveSoftware/source-sdk-2013/blob/0d8dceea4310fde5706b3ce1c70609d72a38efdf/mp/src/game/shared/baseplayer_shared.cpp#L1068-L1270). Despite CBasePlayer::FindUseEntity being defined shared, it is only called serverside in practice, so this hook will be only called serverside, as well. It is possible for modules to call it clientside, so the Lua code should still be treated as shared.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_shd.lua#L103-L120)
    -- @param ply --- The player who initiated the use action.
    -- @param defaultEnt --- The entity that was chosen by the engine.
    -- @return --- The entity to use instead of default entity
    FindUseEntity: function(ply: GPlayer, defaultEnt: GEntity): GEntity

    --- Runs when user cancels/finishes typing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L237-L238)
    FinishChat: function()

    --- Called after GM:Move, applies all the changes from the CMoveData to the player.
    --- See Game Movement for an explanation on the move system.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L189-L194)
    -- @param ply --- Player
    -- @param mv --- Movement data
    -- @return --- Return true to suppress default engine behavior, i.e. declare that you have already moved the player according to the move data in a custom way.
    FinishMove: function(ply: GPlayer, mv: GCMoveData): boolean

    --- Called to allow override of the default Derma skin for all panels.
    --- **NOTE**: This hook is only called on Lua start up, changing its value (or adding new hooks) after it has been already called will not have any effect.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L437-L442)
    -- @return --- A **case sensitive** Derma skin name to be used as default, registered previously via derma.DefineSkin.
    --- Returning nothing, nil or invalid name will make it fallback to the "Default" skin.
    ForceDermaSkin: function(): string

    --- Called when game content has been changed, for example an addon or a mountable game was (un)mounted.
    GameContentChanged: function()

    --- An internal function used to get an untranslated string to show in the kill feed as the entity's name. See GM:SendDeathNotice
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/npc.lua#L49-L79)
    -- @param name --- The name of the entity.
    -- @return --- The untranslated name for given NPC. The translation/localization would happen on the client.
    GetDeathNoticeEntityName: function(name: string): string

    --- Called when a player takes damage from falling, allows to override the damage.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L727-L735)
    -- @param ply --- The player
    -- @param speed --- The fall speed
    -- @return --- New fall damage
    GetFallDamage: function(ply: GPlayer, speed: number): number

    --- Called when the game(server) needs to update the text shown in the server browser as the gamemode. Runs at a ~2s interval, runs even when the server is hibernating.
    --- **NOTE**: This hook (and the `sv_gamename_override` command) may not work on some popular gamemodes like DarkRP or Trouble Terrorist Town. This is not a bug, it's just how it works. See [here](https://github.com/Facepunch/garrysmod-issues/issues/4637#issuecomment-677884989) for more information.
    --- Also, it **only** works on dedicated servers and is called at regular intervals (about one second) **even** if the server has no players and the hibernation function is enabled.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L76-L78)
    -- @return --- The text to be shown in the server browser as the gamemode.
    GetGameDescription: function(): string

    --- Allows you to modify the Source Engine's motion blur shaders.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L462-L468)
    -- @param horizontal --- The amount of horizontal blur.
    -- @param vertical --- The amount of vertical  blur.
    -- @param forward --- The amount of forward/radial blur.
    -- @param rotational --- The amount of rotational blur.
    -- @return --- New amount of horizontal blur.
    -- @return --- New amount of vertical blur.
    -- @return --- New amount of forward/radial blur.
    -- @return --- New amount of rotational blur.
    GetMotionBlurValues: function(horizontal: number, vertical: number, forward: number, rotational: number): number, number, number, number

    --- Called to determine preferred carry angles for the entity. It works for both, +use pickup and gravity gun pickup.
    --- **WARNING**: Due to nature of the gravity gun coding in multiplayer, this hook **MAY** seem to not work ( but rest assured it does ), due to clientside prediction not knowing the carry angles. The +use pickup doesn't present this issue as it doesn't predict the player carrying the object clientside ( as you may notice by the prop lagging behind in multiplayer )
    --- **NOTE**: This hook can **not** override preferred carry angles of props such as the sawblade and the harpoon.
    -- @param ent --- The entity to generate carry angles for
    -- @param ply --- The player who is holding the object
    -- @return --- The preferred carry angles for the entity.
    GetPreferredCarryAngles: function(ent: GEntity, ply: GPlayer): GAngle

    --- Returns the color for the given entity's team. This is used in chat and deathnotice text.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L124-L130)
    -- @param ent --- Entity
    -- @return --- Team Global.Color
    GetTeamColor: function(ent: GEntity): table

    --- Returns the team color for the given team index.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L136-L140)
    -- @param team --- Team index
    -- @return --- Team Global.Color
    GetTeamNumColor: function(team: number): table

    --- Override this hook to disable/change ear-grabbing in your gamemode. By default, it is not called anywhere on the server.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L249-L271)
    -- @param ply --- Player
    GrabEarAnimation: function(ply: GPlayer)

    --- Called when an entity is released by a gravity gun.
    --- See GM:PhysgunDrop for the Physics Gun drop variant.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/gravitygun.lua#L33-L34)
    -- @param ply --- Player who is wielding the gravity gun
    -- @param ent --- The entity that has been dropped
    GravGunOnDropped: function(ply: GPlayer, ent: GEntity)

    --- Called when an entity is picked up by a gravity gun.
    --- See GM:OnPlayerPhysicsPickup for the player `+use` pickup variant.
    --- See GM:OnPhysgunPickup for the Physics Gun pickup variant.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/gravitygun.lua#L25-L26)
    -- @param ply --- The player wielding the gravity gun
    -- @param ent --- The entity that has been picked up by the gravity gun
    GravGunOnPickedUp: function(ply: GPlayer, ent: GEntity)

    --- Called every tick to poll whether a player is allowed to pick up an entity with the gravity gun or not.
    --- See GM:AllowPlayerPickup for the +USE pickup variant.
    --- See GM:PhysgunPickup for the Physics Gun pickup variant.
    --- Calls ENTITY:GravGunPickupAllowed on the entity being hovered every frame in Sandbox-derived gamemodes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/gravitygun.lua#L15-L17)
    -- @param ply --- The player wielding the gravity gun
    -- @param ent --- The entity the player is attempting to pick up
    -- @return --- Return true to allow entity pick up
    GravGunPickupAllowed: function(ply: GPlayer, ent: GEntity): boolean

    --- Called when an entity is about to be punted with the gravity gun (primary fire).
    --- By default this function makes ENTITY:GravGunPunt work in Sandbox derived gamemodes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/gravitygun.lua#L7-L9)
    -- @param ply --- The player wielding the gravity gun
    -- @param ent --- The entity the player is attempting to punt
    -- @return --- Return true to allow and false to disallow.
    GravGunPunt: function(ply: GPlayer, ent: GEntity): boolean

    --- Called when the mouse has been double clicked on any panel derived from CGModBase, such as the panel used by gui.EnableScreenClicker and the panel used by Panel:ParentToHUD.
    --- By default this hook calls GM:GUIMousePressed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L99-L103)
    -- @param mouseCode --- The code of the mouse button pressed, see Enums/MOUSE
    -- @param aimVector --- A normalized vector pointing in the direction the client has clicked
    GUIMouseDoublePressed: function(mouseCode: number, aimVector: GVector)

    --- Called whenever a players presses a mouse key on the context menu in Sandbox or on any panel derived from CGModBase, such as the panel used by gui.EnableScreenClicker and the panel used by Panel:ParentToHUD.
    --- See GM:VGUIMousePressed for a hook that is called on all VGUI elements.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L681-L682)
    -- @param mouseCode --- The key that the player pressed using Enums/MOUSE.
    -- @param aimVector --- A normalized direction vector local to the camera. Internally, this is  gui.ScreenToVector( gui.MousePos() ).
    GUIMousePressed: function(mouseCode: number, aimVector: GVector)

    --- Called whenever a players releases a mouse key on the context menu in Sandbox or on any panel derived from CGModBase, such as the panel used by gui.EnableScreenClicker and the panel used by Panel:ParentToHUD.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L688-L689)
    -- @param mouseCode --- The key the player released, see Enums/MOUSE
    -- @param aimVector --- A normalized direction vector local to the camera. Internally this is  gui.ScreenToVector( gui.MousePos() ).
    GUIMouseReleased: function(mouseCode: number, aimVector: GVector)

    --- Called to handle player armor reduction, when player receives damage.
    --- **VALIDATE**: Clarify hook order with other damage hooks.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L829-L861)
    -- @param ply --- The player that took damage.
    -- @param dmginfo --- The taken damage.
    HandlePlayerArmorReduction: function(ply: GPlayer, dmginfo: GCTakeDamageInfo)

    --- Allows to override player driving animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L139-L192)
    -- @param ply --- Player to process
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerDriving: function(ply: GPlayer): boolean

    --- Allows to override player crouch animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L55-L69)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerDucking: function(ply: GPlayer, velocity: GVector): boolean

    --- Called every frame by the player model animation system. Allows to override player jumping animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L2-L53)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerJumping: function(ply: GPlayer, velocity: GVector): boolean

    --- Called every frame by the player model animation system. Allows to override player landing animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L129-L137)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @param onGround --- Was the player on ground?
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerLanding: function(ply: GPlayer, velocity: GVector, onGround: boolean): boolean

    --- Allows to override player noclip animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L71-L98)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerNoClipping: function(ply: GPlayer, velocity: GVector): boolean

    --- Allows to override player swimming animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L113-L127)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerSwimming: function(ply: GPlayer, velocity: GVector): boolean

    --- Allows to override player flying ( in mid-air, not noclipping ) animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L100-L111)
    -- @param ply --- The player
    -- @param velocity --- Players velocity
    -- @return --- Return true if we've changed/set the animation, false otherwise
    HandlePlayerVaulting: function(ply: GPlayer, velocity: GVector): boolean

    --- Hides the team selection panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_pickteam.lua#L58-L65)
    HideTeam: function()

    --- Called when the client has picked up ammo. Override to disable default HUD notification.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_hudpickup.lua#L64-L92)
    -- @param itemName --- Name of the item (ammo) picked up
    -- @param amount --- Amount of the item (ammo) picked up
    HUDAmmoPickedUp: function(itemName: string, amount: number)

    --- Renders the HUD pick-up history. Override to hide default or draw your own HUD.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_hudpickup.lua#L94-L173)
    HUDDrawPickupHistory: function()

    --- Called every frame to render the scoreboard.
    --- It is recommended to use Derma and VGUI for this job instead of this hook. Called right after GM:HUDPaint.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_scoreboard.lua#L294-L295)
    HUDDrawScoreBoard: function()

    --- Called from GM:HUDPaint to draw player info when you hover over a player with your crosshair or mouse.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_targetid.lua#L6-L60)
    -- @return --- Should the player info be drawn.
    HUDDrawTargetID: function(): boolean

    --- Called when an item has been picked up. Override to disable the default HUD notification.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_hudpickup.lua#L36-L45)
    -- @param itemName --- Name of the picked up item
    HUDItemPickedUp: function(itemName: string)

    --- Called whenever the HUD should be drawn.
    --- This is the ideal place to draw custom HUD elements.
    --- To prevent the default game HUD from drawing, use GM:HUDShouldDraw.
    --- This hook does **not** get called when the Camera SWEP is held, or when the `` menu is open.
    --- If you need to draw in those situations, use GM:DrawOverlay instead.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L80-L86)
    HUDPaint: function()

    --- Called before GM:HUDPaint when the HUD background is being drawn.
    --- Just like GM:HUDPaint, this hook will not be called when the main menu is visible. GM:PostDrawHUD does not have this behavior.
    --- Things rendered in this hook will **always** appear behind things rendered in GM:HUDPaint.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L92-L93)
    HUDPaintBackground: function()

    --- Called when the Gamemode is about to draw a given element on the client's HUD (heads-up display).
    --- **WARNING**: This hook is called HUNDREDS of times per second (more than 5 times per frame on average). You shouldn't be performing any computationally intensive operations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L49-L74)
    -- @param name --- The name of the HUD element. You can find a full list of HUD elements for this hook here.
    -- @return --- Return false to prevent the given element from being drawn on the client's screen.
    HUDShouldDraw: function(name: string): boolean

    --- Called when a weapon has been picked up. Override to disable the default HUD notification.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_hudpickup.lua#L36-L45)
    -- @param weapon --- The picked up weapon
    HUDWeaponPickedUp: function(weapon: GWeapon)

    --- Called after the gamemode loads and starts.
    --- No entities would be present at the time this hook is called, please see GM:InitPostEntity for a one time fire hook after all map entities have been initialized.
    Initialize: function()

    --- Called after all the entities are initialized. Starting from this hook Global.LocalPlayer will return valid object.
    --- **NOTE**: At this point the client only knows about the entities that are within the spawnpoints' [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community"). For instance, if the server sends an entity that is not within this PVS, the client will receive it as NULL entity.
    InitPostEntity: function()

    --- Allows you to modify the supplied User Command with mouse input. This could be used to make moving the mouse do funky things to view angles.
    -- @param cmd --- User command.
    -- @param x --- The amount of mouse movement across the X axis this frame.
    -- @param y --- The amount of mouse movement across the Y axis this frame.
    -- @param ang --- The current view angle.
    -- @return --- Return true if we modified something.
    InputMouseApply: function(cmd: GCUserCmd, x: number, y: number, ang: GAngle): boolean

    --- Check if a player can spawn at a certain spawnpoint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L330-L358)
    -- @param ply --- The player who is spawned
    -- @param spawnpoint --- The spawnpoint entity (on the map).
    -- @param makeSuitable --- If this is true, it'll kill any players blocking the spawnpoint.
    -- @return --- Return true to indicate that the spawnpoint is suitable (Allow for the player to spawn here), false to prevent spawning.
    IsSpawnpointSuitable: function(ply: GPlayer, spawnpoint: GEntity, makeSuitable: boolean): boolean

    --- Called whenever a player pressed a key included within the IN keys.
    --- For a more general purpose function that handles all kinds of input, see GM:PlayerButtonDown.
    --- See GM:KeyRelease for the key release event.
    --- Despite being a predicted hook, it will still be called in singleplayer for your convenience.
    --- **WARNING**: Due to this being a predicted hook, Global.ParticleEffects created only serverside from this hook will not be networked to the client, so make sure to do that on both realms.
    -- @param ply --- The player pressing the key. If running client-side, this will always be Global.LocalPlayer.
    -- @param key --- The key that the player pressed using Enums/IN.
    KeyPress: function(ply: GPlayer, key: number)

    --- Runs when a IN key was released by a player.
    --- For a more general purpose function that handles all kinds of input, see GM:PlayerButtonUp.
    --- See GM:KeyPress for the key press event.
    --- Despite being a predicted hook, it will still be called in singleplayer for your convenience.
    -- @param ply --- The player releasing the key. If running client-side, this will always be Global.LocalPlayer.
    -- @param key --- The key that the player released using Enums/IN.
    KeyRelease: function(ply: GPlayer, key: number)

    --- **INTERNAL**:
    --- Called from `gm_load` when the game should load a map.
    -- @param data --- Compressed save data
    -- @param map --- The name of the map the save was created on
    -- @param timestamp --- The time the save was created on. Will always be 0.
    LoadGModSave: function(data: string, map: string, timestamp: number)

    --- Called while an addon from the Steam workshop is downloading. Used by default to update details on the fancy workshop download panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L40-L50)
    -- @return reason --- Failure Reason.
    -- @return workshopid --- the workshop ID of the missing map (if found). Can be an empty string
    LoadGModSaveFailed: function(): string, string

    --- Called when `menu.lua` has finished loading.
    MenuStart: function()

    --- Override this gamemode function to disable mouth movement when talking on voice chat. By default, it is not called anywhere on the server.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/animations.lua#L276-L294)
    -- @param ply --- Player in question
    MouthMoveAnimation: function(ply: GPlayer)

    --- The Move hook is called for you to manipulate the player's MoveData.
    --- You shouldn't adjust the player's position in any way in the move hook. This is because due to prediction errors, the netcode might run the move hook multiple times as packets arrive late. Therefore you should only adjust the movedata construct in this hook.
    --- Generally you shouldn't have to use this hook - if you want to make a custom move type you should look at the drive system.
    --- This hook is called after GM:PlayerTick.
    --- See Game Movement for an explanation on the move system.
    -- @param ply --- Player
    -- @param mv --- Movement information
    -- @return --- Return true to suppress default engine action.
    Move: function(ply: GPlayer, mv: GCMoveData): boolean

    --- Returning true in this hook will cause it to render depth buffers defined with render.GetResolvedFullFrameDepth.
    -- @return --- Render depth buffer
    NeedsDepthPass: function(): boolean

    --- Called when an entity has been created over the network.
    -- @param ent --- Created entity
    NetworkEntityCreated: function(ent: GEntity)

    --- Called when a player's SteamID has been validated by Steam.
    --- See also GM:PlayerAuthed and Player:IsFullyAuthenticated.
    --- **NOTE**: This hook doesn't work intentionally in singleplayer [because the SteamID is not validated](https://github.com/Facepunch/garrysmod-issues/issues/4906#issuecomment-819337130) in that case. This also applies to `sv_lan 1` servers for every duplicate `-multirun` client.
    -- @param name --- Player name
    -- @param steamID --- Player SteamID
    -- @param ownerID --- SteamID64 of the game license owner, in case Family Sharing is used. See also Player:OwnerSteamID64
    NetworkIDValidated: function(name: string, steamID: string, ownerID: string)

    --- Called whenever this entity changes its transmission state for this Global.LocalPlayer, such as exiting or re entering the [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community").
    --- **NOTE**: This is the best place to handle the reset of Entity:SetPredictable, as this would be usually called when the player lags and requests a full packet update.
    --- When the entity stops transmitting, Entity:IsDormant will only return true **after** this hook.
    -- @param entity --- The entity that changed its transmission state.
    -- @param shouldtransmit --- `True` if we started transmitting to this client and `false` if we stopped.
    NotifyShouldTransmit: function(entity: GEntity, shouldtransmit: boolean)

    --- Called when a player has achieved an achievement. You can get the name and other information from an achievement ID with the achievements library.
    -- @param ply --- The player that earned the achievement
    -- @param achievement --- The index of the achievement
    OnAchievementAchieved: function(ply: GPlayer, achievement: number)

    --- Called when the local player presses TAB while having their chatbox opened.
    --- **WARNING**: This function now uses player.Iterator. This means it can't run all the time, as an error in the GM:OnEntityCreated or GM:EntityRemoved hooks is likely to interrupt it. Make sure that no addon causes an error in these hooks.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L184-L215)
    -- @param text --- The currently typed into chatbox text
    -- @return --- What should be placed into the chatbox instead of what currently is when player presses tab
    OnChatTab: function(text: string): string

    --- Called when the player cleans up something.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/cl_init.lua#L76-L90)
    -- @param name --- The name of the cleanup type
    -- @return suppress --- Return false to suppress the cleanup notification.
    OnCleanup: function(name: string): boolean

    --- Called on the server when a Lua error occurs on a client and is sent to the server.
    --- This hook allows server-side code to detect and log client-side errors.
    --- See GM:OnLuaError for a hook that captures Lua errors directly within its [realm](States).
    --- **WARNING**: Note that the stack argument can contain a table with 0 values.
    --- **NOTE**: Warning: the hook "protects" against lua error spam. If it has 5 errors in less than 1 second, the hook will not receive any of these 4 errors.
    -- @param error --- The error that occurred. As well as the path and line of the error. Example:
    --- `addons/test/lua/autorun/client/test_error.lua:4: 'then' expected near '<eof>'`
    --- </eof>
    -- @param ply --- The player whose client caused the error.
    -- @param stack --- The Lua error stack trace
    -- @param name --- Title of the addon that is creating the Lua errors, or "ERROR" if addon is not found.
    OnClientLuaError: function(error: string, ply: GPlayer, stack: table, name: string)

    --- Called when a caption/subtitle has been emitted to the closed caption box.
    -- @param soundScript --- The name of the soundscript, or `customLuaToken` if it's from gui.AddCaption
    -- @param duration --- How long the caption should stay for
    -- @param fromPlayer --- Is this caption coming from the player?
    -- @param fullText --- The caption. Can be nil if its token is not registered
    -- @return --- Return `true` to prevent the caption from appearing
    OnCloseCaptionEmit: function(soundScript: string, duration: number, fromPlayer: boolean, fullText: string): boolean

    --- Called when the context menu keybind (+menu_context) is released, which by default is C.
    --- This hook will not run if input.IsKeyTrapping returns true.
    --- See also GM:OnContextMenuOpen.
    OnContextMenuClose: function()

    --- Called when the context menu keybind (`+menu_context`) is pressed, which by default is ``.
    --- See also GM:OnContextMenuClose.
    OnContextMenuOpen: function()

    --- Called when the crazy physics detection detects an entity with crazy physics, i.e. position being far outside of the map, velocities being near or at infinity, etc. The primary reason for this system is to prevent program crashes in physics engine.
    -- @param ent --- The entity that was detected as crazy
    -- @param physobj --- The physics object that is going crazy
    OnCrazyPhysics: function(ent: GEntity, physobj: GPhysObj)

    --- Called when a player has been hurt by an explosion. Override to disable default sound effect.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L554-L574)
    -- @param ply --- Player who has been hurt
    -- @param dmginfo --- Damage info from explosion
    OnDamagedByExplosion: function(ply: GPlayer, dmginfo: GCTakeDamageInfo)

    --- Called as soon as the entity is created. Very little of the entity's properties will be initialized at this stage. (keyvalues, classname, flags, anything), especially on the serverside.
    --- **WARNING**: Removing the created entity during this event can lead to unexpected problems. Use Global.SafeRemoveEntityDelayed( entity, 0 ) to safely remove the entity.
    -- @param entity --- The entity
    OnEntityCreated: function(entity: GEntity)

    --- Called when the Entity:WaterLevel of an entity is changed.
    --- 0 - The entity isn't in water.
    --- 1 - Slightly submerged (at least to the feet).
    --- 2 - The majority of the entity is submerged (at least to the waist).
    --- 3 - Completely submerged.
    --- **WARNING**: This hook can be considered a physics callback, so changing collision rules (Entity:SetSolidFlags) in it may lead to a crash!
    -- @param entity --- The entity.
    -- @param old --- Previous water level.
    -- @param new --- The new water level.
    OnEntityWaterLevelChanged: function(entity: GEntity, old: number, new: number)

    --- Called when the gamemode is loaded.
    --- Global.LocalPlayer() returns NULL at the time this is run.
    OnGamemodeLoaded: function()

    --- Called when a Lua error occurs.
    --- If you want to retrieve client errors on the server side, you can use this hook: GM:OnClientLuaError
    --- **NOTE**: On the server realm, this hook will only account for server-side errors, not client-side ones.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/errors.lua#L0)
    -- @param error --- The error that occurred.
    -- @param realm --- Where the Lua error took place, "client", or "server"
    -- @param stack --- The Lua error stack trace
    -- @param name --- Title of the addon that is creating the Lua errors, or nil if addon is not found.
    -- @param id --- Steam Workshop ID of the addon creating Lua errors, if it is an addon.
    OnLuaError: function(error: string, realm: string, stack: table, name: string, id: string)

    --- Called when a Addon Conflict occurs, only works in the Menu realm.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/problems/problems.lua#L260-L297)
    -- @param addon1 --- The first Addon
    -- @param addon2 --- The second Addon
    -- @param fileName --- The File the Conflict occurred in.
    OnNotifyAddonConflict: function(addon1: string, addon2: string, fileName: string)

    --- Called whenever an NPC drops an item upon its death, such as health kits, armor batteries, etc.
    --- It will NOT be called for dropped weapons, with exception of Half-Life: Source NPCs, since they don't use actual weapon entities and create a weapon entity on death.
    --- GM:PlayerDroppedWeapon works for NPC weapon drops already. (Yes, it's not a typo)
    --- It will also not be called for live grenades spawned by Zombine.
    -- @param npc --- The killed NPC
    -- @param item --- The item that got dropped by the NPC.
    OnNPCDropItem: function(npc: GNPC, item: GEntity)

    --- Called whenever an NPC is killed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/npc.lua#L74-L138)
    -- @param npc --- The killed NPC
    -- @param attacker --- The NPCs attacker, the entity that gets the kill credit, for example a player or an NPC.
    -- @param inflictor --- Death inflictor. The entity that did the killing. Not necessarily a weapon.
    OnNPCKilled: function(npc: GNPC, attacker: GEntity, inflictor: GEntity)

    --- Called when the main menu has been blocked by GM:OnPauseMenuShow four times in a small interval. This is used internally to explain to the user that they can hold `` to force open the main menu.
    OnPauseMenuBlockedTooManyTimes: function()

    --- Called when the pause menu is attempting to be opened. Allows you to prevent the main menu from being opened that time.
    --- The user can hold `` to not call this hook. If the main menu is blocked multiple times in short succession, a warning will be displayed to the end user on how to bypass the hook.
    -- @return ShouldOpen --- Should the menu be allowed to open?
    OnPauseMenuShow: function(): boolean

    --- Called when a permission gets Granted or Revoked.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/problems/permissions.lua#L221-L227)
    OnPermissionsChanged: function()

    --- Called when a player freezes an entity with the physgun.
    -- @param weapon --- The weapon that was used to freeze the entity.
    -- @param physobj --- Physics object of the entity.
    -- @param ent --- The target entity.
    -- @param ply --- The player who tried to freeze the entity.
    -- @return --- Return `false` to block the unfreeze.
    --- **WARNING**: The unfreezing is handled by the base gamemode hook. This hook has no return value, returning any value will prevent the gamemode hook from running, which is true for every hook.
    OnPhysgunFreeze: function(weapon: GEntity, physobj: GPhysObj, ent: GEntity, ply: GPlayer): boolean

    --- Called to when a player has successfully picked up an entity with their Physics Gun.
    --- Not to be confused with GM:PhysgunPickup which is called to ask if the player should be able to pick up an entity.
    --- See GM:GravGunOnPickedUp for the Gravity Gun pickup variant.
    --- See GM:OnPlayerPhysicsPickup for the player `+use` pickup variant.
    -- @param ply --- The player that has picked up something using the physics gun.
    -- @param ent --- The entity that was picked up.
    OnPhysgunPickup: function(ply: GPlayer, ent: GEntity)

    --- Called when a player reloads with the physgun. Override this to disable default unfreezing behavior.
    -- @param physgun --- The physgun in question
    -- @param ply --- The player wielding the physgun
    -- @return --- Whether the player can reload with the physgun or not
    OnPhysgunReload: function(physgun: GWeapon, ply: GPlayer): boolean

    --- @deprecated
    --- **DEPRECATED**: Use GM:PlayerChangedTeam instead, which works for every Player:SetTeam call.
    --- Called when a player has changed team using GM:PlayerJoinTeam.
    --- **WARNING**: This hook will not work with hook.Add and it is only called manually from GM:PlayerJoinTeam by the base gamemode
    -- @param ply --- Player who has changed team
    -- @param oldTeam --- Index of the team the player was originally in
    -- @param newTeam --- Index of the team the player has changed to
    OnPlayerChangedTeam: function(ply: GPlayer, oldTeam: number, newTeam: number)

    --- Called whenever a player sends a chat message. For the serverside equivalent, see GM:PlayerSay.
    --- **NOTE**: The input (or suppression) of this hook is based on the output from GM:PlayerSay. Chat events suppressed serverside do not call this hook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L142-L182)
    -- @param ply --- The player
    -- @param text --- The message's text
    -- @param teamChat --- Is the player typing in team chat?
    -- @param isDead --- Is the player dead?
    -- @return --- Should the message be suppressed?
    OnPlayerChat: function(ply: GPlayer, text: string, teamChat: boolean, isDead: boolean): boolean

    --- Called when a player makes contact with the ground after a jump or a fall.
    -- @param player --- Player
    -- @param inWater --- Did the player land in water?
    -- @param onFloater --- Did the player land on an object floating in the water?
    -- @param speed --- The speed at which the player hit the ground
    -- @return --- Return true to suppress default action
    OnPlayerHitGround: function(player: GEntity, inWater: boolean, onFloater: boolean, speed: number): boolean

    --- Called when a player jumps.
    -- @param player --- Player
    -- @param speed --- The velocity/impulse of the jump
    OnPlayerJump: function(player: GEntity, speed: number)

    --- Called when a player +use drops an entity.
    -- @param ply --- The player that dropped the object
    -- @param ent --- The object that was dropped.
    -- @param thrown --- Whether the object was throw or simply let go of.
    OnPlayerPhysicsDrop: function(ply: GPlayer, ent: GEntity, thrown: boolean)

    --- Called when a player +use pickups up an entity. This will be called after the entity passes though GM:AllowPlayerPickup.
    --- See GM:GravGunOnPickedUp for the Gravity Gun pickup variant.
    --- See GM:OnPhysgunPickup for the Physics Gun pickup variant.
    -- @param ply --- The player that picked up the object
    -- @param ent --- The object that was picked up.
    OnPlayerPhysicsPickup: function(ply: GPlayer, ent: GEntity)

    --- Called when gamemode has been reloaded by auto refresh.
    --- **NOTE**: It seems that this event can be triggered more than once for a single refresh event.
    OnReloaded: function()

    --- Called when the player's screen resolution of the game changes.
    --- Global.ScrW and Global.ScrH will return the new values when this hook is called.
    -- @param oldWidth --- The previous width of the game's window.
    -- @param oldHeight --- The previous height of the game's window.
    -- @param newWidth --- The new/current width of the game's window.
    -- @param newHeight --- The new/current height of the game's window.
    OnScreenSizeChanged: function(oldWidth: number, oldHeight: number, newWidth: number, newHeight: number)

    --- Called when a player releases the `+menu` bind on their keyboard, which is bound to Q by default.
    OnSpawnMenuClose: function()

    --- Called when a player presses the `+menu` bind on their keyboard, which is bound to `` by default.
    OnSpawnMenuOpen: function()

    --- Called when a DTextEntry gets focus.
    --- This hook is run from DTextEntry:OnGetFocus and PANEL:OnMousePressed of DTextEntry.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L354)
    -- @param panel --- The panel that got focus
    OnTextEntryGetFocus: function(panel: GPanel)

    --- Called when a DTextEntry loses focus.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L362)
    -- @param panel --- The panel that lost focus
    OnTextEntryLoseFocus: function(panel: GPanel)

    --- Called when the player undoes something.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/cl_init.lua#L46-L74)
    -- @param name --- The name of the undo action
    -- @param customText --- The custom text for the undo, set by undo.SetCustomUndoText
    -- @return suppress --- Return false to suppress the undo notification.
    OnUndo: function(name: string, customText: string): boolean

    --- Called when the player changes their weapon to another one - and their viewmodel model changes.
    --- **BUG**: [This is not always called clientside.](https://github.com/Facepunch/garrysmod-issues/issues/2473
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L251-L258)
    -- @param viewmodel --- The viewmodel that is changing
    -- @param oldModel --- The old model
    -- @param newModel --- The new model
    OnViewModelChanged: function(viewmodel: GEntity, oldModel: string, newModel: string)

    --- Called when a player drops an entity with the Physgun.
    --- See GM:GravGunOnDropped for the Gravity Gun drop variant.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L70-L71)
    -- @param player --- The player who dropped an entity
    -- @param entity --- The dropped entity
    PhysgunDrop: function(player: GPlayer, entity: GEntity)

    --- Called to determine if a player should be able to pick up an entity with the Physics Gun.
    --- See GM:OnPhysgunPickup for a hook which is called when a player has successfully picked up an entity.
    --- See GM:GravGunPickupAllowed for the Gravity Gun pickup variant.
    --- See GM:AllowPlayerPickup for the `+USE` pickup variant.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L58-L64)
    -- @param player --- The player that is picking up using the Physics Gun.
    -- @param entity --- The entity that is being picked up.
    -- @return --- Returns whether the player can pick up the entity or not.
    PhysgunPickup: function(player: GPlayer, entity: GEntity): boolean

    --- Called after player's reserve ammo count changes.
    -- @param ply --- The player whose ammo is being affected.
    -- @param ammoID --- The ammo type ID.
    -- @param oldCount --- The old ammo count.
    -- @param newCount --- The new ammo count.
    PlayerAmmoChanged: function(ply: GPlayer, ammoID: number, oldCount: number, newCount: number)

    --- Called after the player gets their Player:UniqueID set for the first time. This hook will also be called in singleplayer.
    --- See GM:NetworkIDValidated for a hook that is called with the player's SteamID is validated by Steam.
    -- @param ply --- The player
    -- @param steamid --- The player's SteamID.
    --- **WARNING**: This will always be an empty string `""` in singleplayer.
    -- @param uniqueid --- The player's UniqueID.
    --- **WARNING**: This will always be `"1"` in singleplayer.
    PlayerAuthed: function(ply: GPlayer, steamid: string, uniqueid: string)

    --- Runs when a bind has been pressed. Allows to block commands.
    --- **NOTE**: By using the "alias" console command, this hook can be effectively circumvented. To prevent this use input.TranslateAlias.
    --- To stop the user from using `+attack`, `+left` and any other movement commands of the sort, please look into using GM:StartCommand instead.
    --- **BUG**: [The third argument will always be true.](https://github.com/Facepunch/garrysmod-issues/issues/1176
    --- **BUG**: [This does not run for function keys binds (F1-F12).](https://github.com/Facepunch/garrysmod-issues/issues/2888
    -- @param ply --- The player who used the command; this will always be equal to Global.LocalPlayer.
    -- @param bind --- The bind command.
    -- @param pressed --- If the bind was activated or deactivated.
    -- @param code --- The button code. See BUTTON_CODE Enums.
    -- @return --- Return `true` to prevent the bind.
    PlayerBindPress: function(ply: GPlayer, bind: string, pressed: boolean, code: number): boolean

    --- Called when a player presses a button.
    --- This will not be called if player has a panel opened with keyboard input enabled, use PANEL:OnKeyCodePressed instead.
    --- See GM:KeyPress for an alternative that uses Enums/IN.
    --- See GM:PlayerButtonUp for the "key release" event.
    -- @param ply --- Player who pressed the button
    -- @param button --- The button, see Enums/BUTTON_CODE
    PlayerButtonDown: function(ply: GPlayer, button: E_BUTTON_CODE)

    --- Called when a player releases a button.
    --- This will not be called if player has a panel opened with keyboard input enabled, use PANEL:OnKeyCodeReleased instead.
    --- See GM:KeyRelease for an alternative that uses Enums/IN.
    --- See GM:PlayerButtonDown for the "key press" event.
    -- @param ply --- Player who released the button
    -- @param button --- The button, see Enums/BUTTON_CODE
    PlayerButtonUp: function(ply: GPlayer, button: E_BUTTON_CODE)

    --- Decides whether a player can hear another player using voice chat.
    --- **WARNING**: This hook is called **players count * speaking players count** times every 0.3 seconds if at least 1 player is talking or every 5 seconds if no one is talking.
    --- You should ensure that your code is efficient, or this will definitely influence performance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L799-L806)
    -- @param listener --- The listening player.
    -- @param talker --- The talking player.
    -- @return --- Return `true` if the listener should hear the talker, `false` if they shouldn't.
    -- @return --- 3D sound. If set to `true`, will fade out the sound the further away listener is from the  talker, the voice will also be in stereo, and not mono.
    PlayerCanHearPlayersVoice: function(listener: GPlayer, talker: GPlayer): boolean, boolean

    --- Returns whether or not a player is allowed to join a team
    --- **WARNING**: This hook will not work with hook.Add and it is only called manually from GM:PlayerJoinTeam by the base gamemode
    -- @param ply --- Player attempting to switch teams
    -- @param team --- Index of the team
    -- @return --- Allowed to switch
    PlayerCanJoinTeam: function(ply: GPlayer, team: number): boolean

    --- Returns whether or not a player is allowed to pick an item up. (ammo, health, armor)
    --- This will typically only work for base game entities, unless mod authors that implement similar entities also manually call this hook.
    --- See GM:PlayerCanPickupWeapon for a hook that controls weapon pickups.
    -- @param ply --- Player attempting to pick up
    -- @param item --- The item the player is attempting to pick up
    -- @return --- Allow pick up
    PlayerCanPickupItem: function(ply: GPlayer, item: GEntity): boolean

    --- Returns whether or not a player is allowed to pick up a weapon.
    --- If this returns `false`, Player:Give won't work.
    --- See GM:PlayerCanPickupItem for a hook that affects things like health kits, armor batteries and ammo entities.
    --- See GM:WeaponEquip for a hook that is called when a player successfully picks up a weapon after passing this hook.
    -- @param ply --- The player attempting to pick up the weapon.
    -- @param weapon --- The weapon entity in question.
    -- @return --- `false` to disallow pickup.
    PlayerCanPickupWeapon: function(ply: GPlayer, weapon: GWeapon): boolean

    --- Returns whether or not the player can see the other player's chat.
    --- **NOTE**: The **speaker** parameter does not have to be a valid Player object which happens when console messages are displayed for example.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L763)
    -- @param text --- The chat text
    -- @param teamOnly --- If the message is team-only
    -- @param listener --- The player receiving the message
    -- @param speaker --- The player sending the message.
    -- @return --- Can see other player's chat
    PlayerCanSeePlayersChat: function(text: string, teamOnly: boolean, listener: GPlayer, speaker: GPlayer): boolean

    --- Called when a player has changed team using Player:SetTeam.
    --- **WARNING**: Avoid calling Player:SetTeam in this hook as it may cause an infinite loop!
    --- **WARNING**: Player:Team inside this hook will return `oldTeam`.
    -- @param ply --- Player whose team has changed.
    -- @param oldTeam --- Index of the team the player was originally in. See team.GetName and the team library.
    -- @param newTeam --- Index of the team the player has changed to.
    PlayerChangedTeam: function(ply: GPlayer, oldTeam: number, newTeam: number)

    --- Called whenever a player is about to spawn something to see if they hit a limit for whatever they are spawning.
    --- **NOTE**: This hook will not be called in singleplayer, as singleplayer does not have limits.
    -- @param ply --- The player who is trying to spawn something.
    -- @param limitName --- The limit's name.
    -- @param current --- The amount of whatever player is trying to spawn that the player already has spawned.
    -- @param defaultMax --- The default maximum count, as dictated by the `sbox_max<limitname>` convar on the server. This is the amount that will be used if nothing is returned from this hook.</limitname>
    -- @return --- Return `false` to indicate the limit was hit, or nothing otherwise
    PlayerCheckLimit: function(ply: GPlayer, limitName: string, current: number, defaultMax: number): boolean

    --- **INTERNAL**:
    --- Called whenever a player's class is changed on the server-side with player_manager.SetPlayerClass.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L680-L695)
    -- @param ply --- The player whose class has been changed.
    -- @param newID --- The network ID of the player class's name string, or `0` if we are clearing a player class from the player.
    --- Pass this into util.NetworkIDToString to retrieve the proper name of the player class.
    PlayerClassChanged: function(ply: GPlayer, newID: number)

    --- Executes when a player connects to the server. Called before the player has been assigned a UserID and entity. See the player_connect gameevent for a version of this hook called after the player entity has been created.
    --- **NOTE**: This is only called clientside for listen server hosts.
    --- **NOTE**: This is not called clientside for the local player.
    -- @param name --- The player's name.
    -- @param ip --- The player's IP address. Will be "none" for bots.
    --- **NOTE**: This argument will only be passed serverside.
    PlayerConnect: function(name: string, ip: string)

    --- Called when a player is killed by Player:Kill or any other normal means.
    --- This hook is **not** called if the player is killed by Player:KillSilent. See GM:PlayerSilentDeath for that.
    --- * GM:DoPlayerDeath is called **before** this hook.
    --- * GM:PostPlayerDeath is called **after** this hook.
    --- See Player:LastHitGroup if you need to get the last hit hitgroup of the player.
    --- **NOTE**: Player:Alive will return false in this hook.
    -- @param victim --- The player who died
    -- @param inflictor --- Item used to kill the victim
    -- @param attacker --- Player or entity that killed the victim
    PlayerDeath: function(victim: GPlayer, inflictor: GEntity, attacker: GEntity)

    --- Returns whether or not the default death sound should be muted.
    -- @param ply --- The player
    -- @return --- Mute death sound
    PlayerDeathSound: function(ply: GPlayer): boolean

    --- Called every think while the player is dead. The return value will determine if the player respawns.
    --- Overwriting this function will prevent players from respawning by pressing space or clicking.
    --- **BUG**: [This hook is not called for players with the FL_FROZEN flag applied.](https://github.com/Facepunch/garrysmod-issues/issues/1577
    -- @param ply --- The player affected in the hook.
    -- @return --- **NOTE**: This hook does not define a return value. The description below just describes how the hook library works in general.
    --- Return a non-nil value to prevent the current gamemode from handling this event. In the `base` gamemode, the gamemode handles player respawning in this hook. So blocking the gamemode hook will prevent player from respawning, in this specific case.
    PlayerDeathThink: function(ply: GPlayer): boolean

    --- Called when a player leaves the server. See the player_disconnect gameevent for a shared version of this hook.
    --- **BUG**: [This is not called in single-player or listen servers for the host.](https://github.com/Facepunch/garrysmod-issues/issues/3523
    -- @param ply --- the player
    PlayerDisconnected: function(ply: GPlayer)

    --- Called to update the player's animation during a drive.
    -- @param ply --- The driving player
    PlayerDriveAnimate: function(ply: GPlayer)

    --- Called when a weapon is dropped by a player via Player:DropWeapon. Despite its name, this hook is also called for NPC weapon drops.
    --- Also called when a weapon is removed from a player via Player:StripWeapon.
    --- See also GM:WeaponEquip for a hook when a player picks up a weapon.
    --- The weapon's Entity:GetOwner will be NULL at the time this hook is called.
    --- WEAPON:OnDrop will be called before this hook is.
    -- @param owner --- The player or NPC who owned this weapon before it was dropped.
    -- @param wep --- The weapon that was dropped.
    PlayerDroppedWeapon: function(owner: GPlayer|GNPC, wep: GWeapon)

    --- Called when player stops using voice chat.
    -- @param ply --- Player who stopped talking
    PlayerEndVoice: function(ply: GPlayer)

    --- Called when a player enters a vehicle.
    --- Called just after GM:CanPlayerEnterVehicle.
    --- See also GM:PlayerLeaveVehicle.
    -- @param ply --- Player who entered vehicle.
    -- @param veh --- Vehicle the player entered.
    -- @param role --- The seat number.
    PlayerEnteredVehicle: function(ply: GPlayer, veh: GVehicle, role: number)

    --- Called before firing clientside animation events on a player model.
    --- See GM:PlayerHandleAnimEvent for the serverside version.
    -- @param ply --- The player who has triggered the event.
    -- @param pos --- Position of the effect
    -- @param ang --- Angle of the effect
    -- @param event --- The event ID of happened even. See [this page](http://developer.valvesoftware.com/wiki/Animation_Events).
    -- @param name --- Name of the event
    -- @return --- Return true to disable the effect
    PlayerFireAnimationEvent: function(ply: GPlayer, pos: GVector, ang: GAngle, event: number, name: string): boolean

    --- Called whenever a player steps. Return true to mute the normal sound.
    --- See GM:PlayerStepSoundTime for a related hook about footstep frequency.
    --- **NOTE**: This hook is called on all clients.
    -- @param ply --- The stepping player
    -- @param pos --- The position of the step
    -- @param foot --- Foot that is stepped. 0 for left, 1 for right
    -- @param sound --- Sound that is going to play
    -- @param volume --- Volume of the footstep
    -- @param filter --- The Recipient filter of players who can hear the footstep
    -- @return --- Prevent default step sound
    PlayerFootstep: function(ply: GPlayer, pos: GVector, foot: number, sound: string, volume: number, filter: GCRecipientFilter): boolean

    --- Called when a player freezes an object.
    -- @param ply --- Player who has frozen an object
    -- @param ent --- The frozen object
    -- @param physobj --- The frozen physics object of the frozen entity ( For ragdolls )
    PlayerFrozeObject: function(ply: GPlayer, ent: GEntity, physobj: GPhysObj)

    --- Called before firing serverside animation events on the player models.
    --- See GM:PlayerFireAnimationEvent for the clientside version.
    -- @param ply --- The player who has triggered the event.
    -- @param event --- The event ID of happened even. See [this page](http://developer.valvesoftware.com/wiki/Animation_Events).
    -- @param eventTime --- The absolute time this event occurred using Global.CurTime.
    -- @param cycle --- The frame this event occurred as a number between 0 and 1.
    -- @param type --- Event type. See [the Source SDK](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/shared/eventlist.h#L14-L23).
    -- @param options --- Name or options of this event.
    PlayerHandleAnimEvent: function(ply: GPlayer, event: number, eventTime: number, cycle: number, type: number, options: string)

    --- Called when a player gets hurt.
    -- @param victim --- Victim
    -- @param attacker --- Attacker Entity
    -- @param healthRemaining --- Remaining Health
    -- @param damageTaken --- Damage Taken
    PlayerHurt: function(victim: GPlayer, attacker: GEntity, healthRemaining: number, damageTaken: number)

    --- Called when the player spawns for the first time.
    --- See GM:PlayerSpawn for a hook called every player spawn.
    --- **NOTE**: This hook is called before the player has fully loaded, when the player is still in seeing the `Starting Lua` screen. For example, trying to use the Entity:GetModel function will return the default model (`models/player.mdl`).
    -- @param player --- The player who spawned.
    -- @param transition --- If `true`, the player just spawned from a [map transition](https://developer.valvesoftware.com/wiki/Level_Transitions). (Specifically via `trigger_changelevel` or `point_changelevel` entities)
    PlayerInitialSpawn: function(player: GPlayer, transition: boolean)

    --- Makes the player join a specified team. This is a convenience function that calls Player:SetTeam and runs the GM:OnPlayerChangedTeam hook.
    -- @param ply --- Player to force
    -- @param team --- The team to put player into
    PlayerJoinTeam: function(ply: GPlayer, team: number)

    --- Called when a player leaves a vehicle for any reason, including Player:ExitVehicle.
    --- See GM:PlayerEnteredVehicle for the opposite hook.
    --- **NOTE**: For vehicles with exit animations, this will be called **at the end** of the animation, **not at the start**!
    -- @param ply --- Player who left a vehicle.
    -- @param veh --- Vehicle the player left.
    PlayerLeaveVehicle: function(ply: GPlayer, veh: GVehicle)

    --- Called to give players the default set of weapons.
    --- **NOTE**: This function may not work in your custom gamemode if you have overridden your GM:PlayerSpawn and you do not use self.BaseClass.PlayerSpawn or hook.Call.
    -- @param ply --- Player to give weapons to.
    PlayerLoadout: function(ply: GPlayer)

    --- Called when a player tries to switch noclip mode.
    -- @param ply --- The person who entered/exited noclip
    -- @param desiredState --- Represents the noclip state (on/off) the user will enter if this hook allows them to.
    -- @return --- Return false to disallow the switch.
    PlayerNoClip: function(ply: GPlayer, desiredState: boolean): boolean

    --- Called after the player's think, just after GM:FinishMove.
    --- **NOTE**: On the client side, it is only called for the local player.
    -- @param ply --- The player
    PlayerPostThink: function(ply: GPlayer)

    --- Request a player to join the team. This function will check if the team is available to join or not.
    --- This hook is called when the player runs "changeteam" in the console.
    --- To prevent the player from changing teams, see GM:PlayerCanJoinTeam
    -- @param ply --- The player to try to put into a team
    -- @param team --- Team to put the player into if the checks succeeded
    PlayerRequestTeam: function(ply: GPlayer, team: number)

    --- Called when a player dispatched a chat message. For the clientside equivalent, see GM:OnPlayerChat.
    --- **NOTE**: It may be more reliable to use gameevent/player_say to read messages serverside because addons commonly return values in this hook to change chat messages.
    -- @param sender --- The player which sent the message.
    -- @param text --- The message's content.
    -- @param teamChat --- Return false when the message is for everyone, true when the message is for the sender's team.
    -- @return --- What to show instead of original text. Set to `""` to stop the message from displaying.
    PlayerSay: function(sender: GPlayer, text: string, teamChat: boolean): string

    --- Called to determine a spawn point for a player to spawn at.
    --- **NOTE**: The spawn point entity will also impact the player's eye angle. For example, if the entity is upside down, the player's view will be as well.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L360-L495)
    -- @param ply --- The player who needs a spawn point
    -- @param transition --- If true, the player just spawned from a map transition (`trigger_changelevel`). You probably want to not return an entity for that case to not override player's position.
    -- @return --- The spawn point entity to spawn the player at
    PlayerSelectSpawn: function(ply: GPlayer, transition: boolean): GEntity

    --- Find a team spawn point entity for this player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L301-L323)
    -- @param team --- Players team
    -- @param ply --- The player
    -- @return --- The entity to use as a spawn point.
    PlayerSelectTeamSpawn: function(team: number, ply: GPlayer): GEntity

    --- Called whenever view model hands needs setting a model. By default this calls PLAYER:GetHandsModel and if that fails, sets the hands model according to his player model.
    -- @param ply --- The player whose hands needs a model set
    -- @param ent --- The hands to set model of
    PlayerSetHandsModel: function(ply: GPlayer, ent: GEntity)

    --- Called whenever a player spawns and must choose a model. A good place to assign a model to a player.
    --- **NOTE**: This function may not work in your custom gamemode if you have overridden your GM:PlayerSpawn and you do not use self.BaseClass.PlayerSpawn in it, or hook.Call this hook from GM:PlayerSpawn.
    -- @param ply --- The player being chosen
    PlayerSetModel: function(ply: GPlayer)

    --- Returns true if the player should take damage from the given attacker.
    --- **WARNING**: Applying damage from this hook to the player taking damage will lead to infinite loop/crash.
    -- @param ply --- The player
    -- @param attacker --- The attacker
    -- @return --- Allow damage
    PlayerShouldTakeDamage: function(ply: GPlayer, attacker: GEntity): boolean

    --- Allows to suppress player taunts.
    -- @param ply --- Player who tried to taunt
    -- @param act --- Act ID of the taunt player tries to do, see Enums/ACT
    -- @return --- Return false to disallow player taunting
    PlayerShouldTaunt: function(ply: GPlayer, act: number): boolean

    --- Called when the player is killed by Player:KillSilent.
    --- The player is already considered dead when this hook is called.
    --- * See GM:PlayerDeath for a hook which handles all other death causes.
    --- * GM:PostPlayerDeath is called **after** this hook.
    --- **NOTE**: Player:Alive will return true in this hook.
    -- @param ply --- The player who was killed
    PlayerSilentDeath: function(ply: GPlayer)

    --- Called whenever a player spawns, including respawns.
    --- See GM:PlayerInitialSpawn for a hook called only the first time a player spawns.
    --- See the player_spawn gameevent for a shared version of this hook.
    --- **WARNING**: By default, in "base" derived gamemodes, this hook will also call GM:PlayerLoadout and GM:PlayerSetModel, which may override your Entity:SetModel and Player:Give calls. Consider using the other hooks or a 0-second timer.
    -- @param player --- The player who spawned.
    -- @param transition --- If true, the player just spawned from a map transition. You probably want to not touch player's weapons or position if this is set to `true`.
    PlayerSpawn: function(player: GPlayer, transition: boolean)

    --- Called to spawn the player as a spectator.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player.lua#L219-L233)
    -- @param ply --- The player to spawn as a spectator
    PlayerSpawnAsSpectator: function(ply: GPlayer)

    --- Determines if the player can spray using the `impulse 201` console command.
    -- @param sprayer --- The player.
    -- @return --- Return `false` to allow spraying, return `true` to prevent spraying.
    PlayerSpray: function(sprayer: GPlayer): boolean

    --- Called when player starts taunting.
    -- @param ply --- The player who is taunting
    -- @param act --- The sequence ID of the taunt
    -- @param length --- Length of the taunt
    PlayerStartTaunt: function(ply: GPlayer, act: number, length: number)

    --- Called when a player starts using voice chat.
    --- **NOTE**: Set mp_show_voice_icons to 0, if you want disable icons above player.
    -- @param ply --- Player who started using voice chat.
    -- @param plyIndex --- The player index. Only appears when non-local player speaks for the first time.
    -- @return --- Set true to hide player's `CHudVoiceStatus`.
    PlayerStartVoice: function(ply: GPlayer, plyIndex: number): boolean

    --- Allows you to override the time between footsteps.
    --- See GM:PlayerFootstep for a related hook about footstep sounds themselves.
    --- **NOTE**: This hook is called on all clients.
    -- @param ply --- Player who is walking
    -- @param type --- The type of footsteps, see Enums/STEPSOUNDTIME
    -- @param walking --- Is the player walking or not ( +walk? )
    -- @return --- Time between footsteps, in ms
    PlayerStepSoundTime: function(ply: GPlayer, type: number, walking: boolean): number

    --- Called whenever a player attempts to either turn on or off their flashlight, returning false will deny the change.
    --- **NOTE**: Also gets called when using Player:Flashlight.
    -- @param ply --- The player who attempts to change their flashlight state.
    -- @param enabled --- The new state the player requested, true for on, false for off.
    -- @return --- Can toggle the flashlight or not
    PlayerSwitchFlashlight: function(ply: GPlayer, enabled: boolean): boolean

    --- Called when a player attempts to switch their weapon.
    --- Primary usage of this hook is to prevent/allow weapon switching, **not** to detect weapon switching. It will not be called for Player:SetActiveWeapon.
    -- @param player --- The player switching weapons.
    -- @param oldWeapon --- The previous weapon. Will be `NULL` if the previous weapon was removed or the player is switching from nothing.
    -- @param newWeapon --- The weapon the player switched to. Will be `NULL` if the player is switching to nothing.
    --- **BUG**: [This can be `NULL` on the client if the weapon hasn't been created over the network yet.](https://github.com/Facepunch/garrysmod-issues/issues/2922
    -- @return --- Return `true` to prevent weapon switch.
    PlayerSwitchWeapon: function(player: GPlayer, oldWeapon: GWeapon, newWeapon: GWeapon): boolean

    --- The Move hook is called for you to manipulate the player's CMoveData. This hook is called moments before GM:Move and GM:PlayerNoClip.
    --- **WARNING**: This hook will not run when inside a vehicle. GM:VehicleMove will be called instead.
    -- @param player --- The player
    -- @param mv --- The current movedata for the player.
    PlayerTick: function(player: GPlayer, mv: GCMoveData)

    --- Called when a player has been hit by a trace and damaged (such as from a bullet). Returning true overrides the damage handling and prevents GM:ScalePlayerDamage from being called.
    -- @param ply --- The player that has been hit
    -- @param dmginfo --- The damage info of the bullet
    -- @param dir --- Normalized vector direction of the bullet's path
    -- @param trace --- The trace of the bullet's path, see Structures/TraceResult
    -- @return --- Override engine handling
    PlayerTraceAttack: function(ply: GPlayer, dmginfo: GCTakeDamageInfo, dir: GVector, trace: S_TraceResult): boolean

    --- Called when a player unfreezes an object.
    -- @param ply --- Player who has unfrozen an object
    -- @param ent --- The unfrozen object
    -- @param physobj --- The frozen physics object of the unfrozen entity ( For ragdolls )
    PlayerUnfrozeObject: function(ply: GPlayer, ent: GEntity, physobj: GPhysObj)

    --- Triggered when the player presses use on an object. Continuously runs until USE is released but will not activate other Entities until the USE key is released; dependent on activation type of the Entity.
    -- @param ply --- The player pressing the "use" key.
    -- @param ent --- The entity which the player is looking at / activating USE on.
    -- @return --- Return `false` if the player is not allowed to USE the entity.
    --- Do not return `true` if using a hook, otherwise other mods may not get a chance to block a player's use.
    PlayerUse: function(ply: GPlayer, ent: GEntity): boolean

    --- Called when it's time to populate the context menu menu bar at the top.
    -- @param menubar --- The DMenuBar itself.
    PopulateMenuBar: function(menubar: GPanel)

    --- Called right after the map has cleaned up (usually because game.CleanUpMap was called)
    --- See also GM:PreCleanupMap.
    PostCleanupMap: function()

    --- Called right after the 2D skybox has been drawn - allowing you to draw over it.
    --- **NOTE**: Provides a 3D rendering context
    PostDraw2DSkyBox: function()

    --- Called after rendering effects. This is where halos are drawn. Called just before GM:PreDrawHUD.
    --- **NOTE**: Provides a 2D rendering context
    PostDrawEffects: function()

    --- Called after GM:PreDrawHUD,  GM:HUDPaintBackground and GM:HUDPaint but before  GM:DrawOverlay.
    --- Unlike GM:HUDPaint(Background) hooks, this will still be called when the main menu is visible. And so will be GM:PreDrawHUD
    --- **NOTE**: Provides a 2D rendering context
    PostDrawHUD: function()

    --- Called after drawing opaque entities.
    --- See also GM:PostDrawTranslucentRenderables and GM:PreDrawOpaqueRenderables.
    --- **NOTE**: Provides a 3D rendering context
    -- @param bDrawingDepth --- Whether the current draw is writing depth.
    -- @param bDrawingSkybox --- Whether the current draw is drawing the 3D or 2D skybox.
    --- In case of 2D skyboxes it is possible for this hook to always be called with this parameter set to `true`.
    -- @param isDraw3DSkybox --- Whether the current draw is drawing the 3D.
    PostDrawOpaqueRenderables: function(bDrawingDepth: boolean, bDrawingSkybox: boolean, isDraw3DSkybox: boolean)

    --- Called after the player hands are drawn.
    --- See GM:PostDrawViewModel for the view model alternative.
    --- See GM:PreDrawPlayerHands for a hook that is called just before view model hands are drawn.
    -- @param hands --- This is the gmod_hands entity.
    -- @param vm --- This is the view model entity.
    -- @param ply --- The the owner of the view model.
    -- @param weapon --- This is the weapon that is from the view model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    PostDrawPlayerHands: function(hands: GEntity, vm: GEntity, ply: GPlayer, weapon: GWeapon, flags: number)

    --- Called after drawing the 3D skybox. This will not be called if skybox rendering was prevented via the GM:PreDrawSkyBox hook.
    --- See also GM:PostDraw2DSkyBox.
    --- **NOTE**: Provides a 3D rendering context
    PostDrawSkyBox: function()

    --- Called after all translucent entities are drawn.
    --- See also GM:PostDrawOpaqueRenderables and  GM:PreDrawTranslucentRenderables.
    --- **NOTE**: Provides a 3D rendering context
    --- **BUG**: [This is still called when r_drawentities or r_drawopaquerenderables is disabled.](https://github.com/Facepunch/garrysmod-issues/issues/3295
    --- **BUG**: [This is not called when r_drawtranslucentworld is disabled.](https://github.com/Facepunch/garrysmod-issues/issues/3296
    -- @param bDrawingDepth --- Whether the current call is writing depth.
    -- @param bDrawingSkybox --- Whether the current call is drawing the 3D or 2D skybox.
    --- In case of 2D skyboxes it is possible for this hook to always be called with this parameter set to `true`.
    -- @param isDraw3DSkybox --- Whether the current call is drawing the 3D skybox.
    PostDrawTranslucentRenderables: function(bDrawingDepth: boolean, bDrawingSkybox: boolean, isDraw3DSkybox: boolean)

    --- Called after view model is drawn.
    --- The render FOV in this hook is different from the main view, as view models are usually rendered with a different FOV. Every render operation will only be accurate with the view model entity.
    --- See GM:PreDrawViewModel for a hook that is called just before a view model is drawn.
    --- For view model hands alternative, see GM:PostDrawPlayerHands.
    --- **NOTE**: Provides a 3D rendering context
    -- @param viewmodel --- Players view model
    -- @param player --- The owner of the weapon/view model
    -- @param weapon --- The weapon the player is currently holding
    -- @param flags --- The STUDIO_ flags for this render operation.
    PostDrawViewModel: function(viewmodel: GEntity, player: GPlayer, weapon: GWeapon, flags: number)

    --- Called every time a bullet pellet (i.e. this hook is called multiple times for a shotgun shot) is fired from an entity. Notably this hook will have the final damage and aim direction for the bullet pellet.
    --- See GM:EntityFireBullets if you wish to modify the bullets before they are fired.
    --- **WARNING**: This hook is called directly from Entity:FireBullets. Due to this, you cannot call Entity:FireBullets inside this hook or an infinite loop will occur crashing the game.
    -- @param entity --- The entity that fired the bullet
    -- @param data --- A table of data about the bullet that was fired.
    --- See Structures/FiredBullet.
    -- @return --- Return `false` to suppress the bullet.
    PostEntityFireBullets: function(entity: GEntity, data: S_FiredBullet): boolean

    --- Called when an entity receives a damage event, after passing damage filters, etc.
    --- See GM:EntityTakeDamage if you wish to prevent damage events, or otherwise alter them.
    --- **WARNING**: Applying damage from this hook to the entity taking damage will lead to infinite loop/crash.
    -- @param ent --- The entity that took the damage.
    -- @param dmginfo --- Detailed information about the damage event.
    -- @param wasDamageTaken --- Whether the entity actually took the damage. (For example, shooting a Strider will generate this event, but it won't take bullet damage).
    PostEntityTakeDamage: function(ent: GEntity, dmginfo: GCTakeDamageInfo, wasDamageTaken: boolean)

    --- Called after the gamemode has loaded.
    PostGamemodeLoaded: function()

    --- Called right after GM:DoPlayerDeath, GM:PlayerDeath and GM:PlayerSilentDeath.
    --- This hook will be called for all deaths, including Player:KillSilent
    --- **NOTE**: Player:Alive will return false in this hook.
    -- @param ply --- The player
    PostPlayerDeath: function(ply: GPlayer)

    --- Called after a given player in your [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community") was drawn.
    --- This hook will not be called if player was prevented from being drawn via GM:PrePlayerDraw.
    --- **NOTE**: Provides a 3D rendering context
    -- @param ply --- The player that was drawn.
    -- @param flags --- The STUDIO_ flags for this render operation.
    PostPlayerDraw: function(ply: GPlayer, flags: number)

    --- Allows you to suppress post processing effect drawing.
    -- @param effect_name --- The classname of Post Processing effect
    -- @return --- Return true/false depending on whether this post process should be allowed
    PostProcessPermitted: function(effect_name: string): boolean

    --- Called after the frame has been rendered.
    PostRender: function()

    --- Called after the VGUI has been drawn.
    --- **NOTE**: Provides a 2D rendering context
    PostRenderVGUI: function()

    --- Called just after performing an undo.
    -- @param undo --- The undo table. See Undo struct.
    -- @param count --- The amount of props/actions undone. This will be `0` for undos that are skipped in cases where for example the entity that is meant to be undone is already deleted.
    PostUndo: function(undo: table, count: number)

    --- Called right before the map cleans up (usually because game.CleanUpMap was called)
    --- See also GM:PostCleanupMap.
    PreCleanupMap: function()

    --- Called just after GM:PreDrawViewModel and can technically be considered "PostDrawAllViewModels".
    --- **NOTE**: Provides a 3D rendering context
    PreDrawEffects: function()

    --- Called before rendering the halos. This is the place to call halo.Add. This hook is actually running inside of GM:PostDrawEffects.
    --- **NOTE**: Provides a 3D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/halo.lua#L148)
    PreDrawHalos: function()

    --- Called just after GM:PostDrawEffects. Drawing anything in it seems to work incorrectly.
    PreDrawHUD: function()

    --- Called before all opaque entities are drawn.
    --- See also GM:PreDrawTranslucentRenderables and  GM:PostDrawOpaqueRenderables.
    --- **NOTE**: Provides a 3D rendering context
    -- @param isDrawingDepth --- Whether the current draw is writing depth.
    -- @param isDrawSkybox --- Whether the current draw is drawing the 3D or 2D skybox.
    --- In case of 2D skyboxes it is possible for this hook to always be called with this parameter set to `true`.
    -- @param isDraw3DSkybox --- Whether the current draw is drawing the 3D.
    -- @return --- Return true to prevent opaque renderables from drawing.
    PreDrawOpaqueRenderables: function(isDrawingDepth: boolean, isDrawSkybox: boolean, isDraw3DSkybox: boolean): boolean

    --- Called before the player hands are drawn.
    --- See GM:PreDrawViewModel for the view model alternative.
    --- See GM:PostDrawPlayerHands for a hook that is called just before view model hands are drawn.
    -- @param hands --- This is the gmod_hands entity before it is drawn.
    -- @param vm --- This is the view model entity before it is drawn.
    -- @param ply --- The the owner of the view model.
    -- @param weapon --- This is the weapon that is from the view model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    -- @return --- Return true to prevent the viewmodel hands from rendering
    PreDrawPlayerHands: function(hands: GEntity, vm: GEntity, ply: GPlayer, weapon: GWeapon, flags: number): boolean

    --- Called before the 3D sky box is drawn. This will not be called for maps with no 3D skybox, or when the 3d skybox is disabled. (`r_3dsky 0`)
    --- See also GM:PostDrawSkyBox
    --- **NOTE**: Provides a 3D rendering context
    -- @return --- Return true to disable skybox drawing (both 2D and 3D skybox)
    PreDrawSkyBox: function(): boolean

    --- Called before all the translucent entities are drawn.
    --- See also GM:PreDrawOpaqueRenderables and  GM:PostDrawTranslucentRenderables.
    --- **NOTE**: Provides a 3D rendering context
    --- **BUG**: [This is still called when r_drawentities or r_drawopaquerenderables is disabled.](https://github.com/Facepunch/garrysmod-issues/issues/3295
    --- **BUG**: [This is not called when r_drawtranslucentworld is disabled.](https://github.com/Facepunch/garrysmod-issues/issues/3296
    -- @param isDrawingDepth --- Whether the current draw is writing depth.
    -- @param isDrawSkybox --- Whether the current draw is drawing the 3D or 2D skybox.
    --- In case of 2D skyboxes it is possible for this hook to always be called with this parameter set to `true`.
    -- @param isDraw3DSkybox --- Whether the current draw is drawing the 3D.
    -- @return --- Return true to prevent translucent renderables from drawing.
    PreDrawTranslucentRenderables: function(isDrawingDepth: boolean, isDrawSkybox: boolean, isDraw3DSkybox: boolean): boolean

    --- Called before the view model has been drawn.
    --- By default this hook also calls WEAPON:PreDrawViewModel, so you can use that if developing a scripted weapon.
    --- See GM:PostDrawViewModel for a hook that runs immediately after rendering a view model.
    --- See GM:PreDrawViewModels for a hook that runs before **all** view models are drawn within a frame.
    --- For view model hands, see GM:PreDrawPlayerHands.
    --- **NOTE**: Provides a 3D rendering context
    -- @param vm --- This is the view model entity before it is drawn. On server-side, this entity is the predicted view model.
    -- @param ply --- The owner of the view model.
    -- @param weapon --- This is the weapon that is from the view model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    -- @return --- Return true to prevent the default view model rendering. This also affects GM:PostDrawViewModel.
    PreDrawViewModel: function(vm: GEntity, ply: GPlayer, weapon: GWeapon, flags: number): boolean

    --- Called just before all view models (there are 3 per player, see Player:GetViewModel) and entities with `RENDERGROUP_VIEWMODEL` are drawn.
    --- See GM:PreDrawViewModel and GM:PostDrawViewModel for hooks that run for specific view models.
    --- You can use GM:PreDrawEffects as a "`PostDrawViewModels`" hook as it is called just after the all the view model(s) are drawn.
    --- **NOTE**: Provides a 3D rendering context
    PreDrawViewModels: function()

    --- Called before the gamemode is loaded.
    PreGamemodeLoaded: function()

    --- Called before the player is drawn.
    --- See also GM:PostPlayerDraw.
    -- @param player --- The player that is about to be drawn.
    -- @param flags --- The STUDIO_ flags for this render operation.
    -- @return --- Return `true` to prevent default player rendering, which hides the player.
    PrePlayerDraw: function(player: GPlayer, flags: number): boolean

    --- Called by scripted_ents.Register.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L55)
    -- @param ent --- The entity table to be registered.
    -- @param class --- The class name to be assigned.
    -- @return --- Return `false` to prevent the entity from being registered. Returning any other value has no effect.
    PreRegisterSENT: function(ent: table, class: string): boolean

    --- Called when a Scripted Weapon (SWEP) is about to be registered, allowing addons to alter the weapon's SWEP table with custom data for later usage. Called internally from weapons.Register.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L48)
    -- @param swep --- The SWEP table to be registered.
    -- @param class --- The class name to be assigned.
    -- @return --- Return `false` to prevent the weapon from being registered. Returning any other value has no effect.
    PreRegisterSWEP: function(swep: table, class: string): boolean

    --- Called before the renderer is about to start rendering the next frame.
    -- @return --- Return true to prevent all rendering. This can make the whole game stop rendering anything.
    PreRender: function(): boolean

    --- Called just before performing an undo.
    -- @param undo --- The undo table. See Undo struct.
    -- @return --- Return `false` to disallow the undo.
    PreUndo: function(undo: table): boolean

    --- This will prevent `` from sending to server when player tries to shoot from C menu.
    -- @return --- Return true to prevent screen clicks.
    PreventScreenClicks: function(): boolean

    --- Called when a prop has been destroyed.
    -- @param attacker --- The person who broke the prop. This can be a NULL entity for cases where the prop was not broken by a player.
    -- @param prop --- The entity that has been broken by the attacker.
    PropBreak: function(attacker: GPlayer, prop: GEntity)

    --- Render the scene. Used by the `Stereoscopy` post-processing effect.
    --- **NOTE**: Materials rendered in this hook require `$ignorez` parameter to draw properly.
    -- @param origin --- View origin
    -- @param angles --- View angles
    -- @param fov --- View FOV
    -- @return --- Return `true` to override drawing the scene.
    RenderScene: function(origin: GVector, angles: GAngle, fov: number): boolean

    --- Used to render post processing effects.
    --- **NOTE**: Provides a 2D rendering context
    RenderScreenspaceEffects: function()

    --- Called when the game is reloaded from a Source Engine save system ( not the Sandbox saves or dupes ).
    --- See GM:Saved for a hook that is called when such a save file is created.
    Restored: function()

    --- Called when the game is saved using the Source Engine save system (not the Sandbox saves or dupes).
    --- See GM:Restored for a hook that is called when such a save file is loaded.
    --- See also the saverestore for relevant functions.
    Saved: function()

    --- Called when an NPC takes damage.
    --- **NOTE**: This hook is called only when a specific hit group of the NPC is hit. In cases where the hitgroup doesn't matter, you should use GM:EntityTakeDamage instead!
    -- @param npc --- The NPC that takes damage
    -- @param hitgroup --- The hitgroup (hitbox) enum where the NPC took damage. See Enums/HITGROUP
    -- @param dmginfo --- Damage info
    ScaleNPCDamage: function(npc: GNPC, hitgroup: number, dmginfo: GCTakeDamageInfo)

    --- This hook allows you to change how much damage a player receives when one takes damage to a specific body part.
    --- **NOTE**: This is called only for bullet damage a player receives, you should use GM:EntityTakeDamage instead if you need to detect **ALL** damage.
    -- @param ply --- The player taking damage.
    -- @param hitgroup --- The hitgroup where the player took damage. See Enums/HITGROUP
    -- @param dmginfo --- The damage info.
    -- @return --- Return true to prevent damage that this hook is called for, stop blood particle effects and blood decals.
    --- It is possible to return true only on client ( This will work **only in multiplayer** ) to stop the effects but still take damage.
    ScalePlayerDamage: function(ply: GPlayer, hitgroup: number, dmginfo: GCTakeDamageInfo): boolean

    --- Called when player released the scoreboard button (`` by default).
    ScoreboardHide: function()

    --- Called when player presses the scoreboard button (`` by default).
    -- @return --- Return true to prevent default scoreboard from showing.
    ScoreboardShow: function(): boolean

    --- An internal function used to send a death notice event to all clients.
    -- @param attacker --- The entity that caused the death.
    -- @param inflictor --- The attacker's weapon class name or the attacker itself if no weapon was equipped.
    -- @param victim --- The entity that died.
    -- @param flags --- Death notice flags. 1 = Friendly victim (to the player), 2 = friendly attacker (to the player)
    SendDeathNotice: function(attacker: GEntity|string|nil, inflictor: string, victim: GEntity|string, flags: number)

    --- Sets player run and sprint speeds.
    --- **BUG**: [Using a speed of `0` can lead to prediction errors, and can cause players to move at `sv_maxvelocity`](https://github.com/Facepunch/garrysmod-issues/issues/2030
    --- **WARNING**: This is not a hook. Treat this as a utility function to set the player's speed.
    -- @param ply --- The player to set the speed of.
    -- @param walkSpeed --- The walk speed.
    -- @param runSpeed --- The run speed.
    SetPlayerSpeed: function(ply: GPlayer, walkSpeed: number, runSpeed: number)

    --- SetupMove is called before the engine process movements. This allows us to override the players movement.
    --- See Game Movement for an explanation on the move system.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/shared.lua#L179-L184)
    -- @param ply --- The player whose movement we are about to process
    -- @param mv --- The move data to override/use
    -- @param cmd --- The command data
    SetupMove: function(ply: GPlayer, mv: GCMoveData, cmd: GCUserCmd)

    --- Allows you to add extra positions to the player's [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community"). This is the place to call Global.AddOriginToPVS.
    -- @param ply --- The player
    -- @param viewEntity --- Players Player:GetViewEntity
    SetupPlayerVisibility: function(ply: GPlayer, viewEntity: GEntity)

    --- Allows you to use render.Fog* functions to manipulate skybox fog.
    --- This will not be called for maps with no 3D skybox, or when the 3d skybox is disabled. (`r_3dsky 0`)
    -- @param scale --- The scale of 3D skybox
    -- @return --- Return true to tell the engine that fog is set up
    SetupSkyboxFog: function(scale: number): boolean

    --- Allows you to use render.Fog* functions to manipulate world fog.
    -- @return --- Return true to tell the engine that fog is set up
    SetupWorldFog: function(): boolean

    --- Called to decide whether a pair of entities should collide with each other. This is only called if Entity:SetCustomCollisionCheck was used on one or both entities.
    --- Where applicable, consider using constraint.NoCollide or a [logic_collision_pair](https://developer.valvesoftware.com/wiki/Logic_collision_pair) entity instead - they are considerably easier to use and may be more appropriate in some situations.
    --- **WARNING**: This hook **must** return the same value consistently for the same pair of entities.
    --- If an entity changed in such a way that its collision rules change, you **must** call Entity:CollisionRulesChanged on that entity immediately - **not in this hook and not in physics callbacks.**
    --- As long as you religiously follow the rules set by the examples this hook will work reliably without breaking, even a small mistake might break physics.
    --- **BUG**: [This hook can cause all physics to break under certain conditions.](https://github.com/Facepunch/garrysmod-issues/issues/642
    -- @param ent1 --- The first entity in the collision poll.
    -- @param ent2 --- The second entity in the collision poll.
    -- @return --- Whether the entities should collide.
    ShouldCollide: function(ent1: GEntity, ent2: GEntity): boolean

    --- Called to determine if the Global.LocalPlayer should be drawn.
    --- If you're using this hook to draw a player for a GM:CalcView hook, then you may want to consider using the `drawviewer` variable you can use in your Structures/CamData table instead.
    --- **NOTE**: This hook has an internal cache that is reset at the start of every frame. This will prevent this hook from running in certain cases. This cache is reset in cam.Start and in a future update in render.RenderView when rendering extra views.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L406-L410)
    -- @param ply --- The player.
    -- @return --- `true` to draw the player, `false` to hide.
    ShouldDrawLocalPlayer: function(ply: GPlayer): boolean

    --- Called when a player executes `gm_showhelp` console command. (Default bind is ``)
    -- @param ply --- Player who executed the command
    ShowHelp: function(ply: GPlayer)

    --- Called when a player executes `gm_showspare1` console command ( Default bind is `` ).
    -- @param ply --- Player who executed the command.
    ShowSpare1: function(ply: GPlayer)

    --- Called when a player executes `gm_showspare2` console command ( Default bind is `` ).
    -- @param ply --- Player who executed the command.
    ShowSpare2: function(ply: GPlayer)

    --- Called when a player executes `gm_showteam` console command. ( Default bind is `` )
    -- @param ply --- Player who executed the command
    ShowTeam: function(ply: GPlayer)

    --- Called whenever the Lua environment is about to be shut down, for example on map change, or when the server is going to shut down.
    ShutDown: function()

    --- Called when spawn icon is generated.
    -- @param lastmodel --- File path of previously generated model.
    -- @param imagename --- File path of the generated icon.
    -- @param modelsleft --- Amount of models left to generate.
    SpawniconGenerated: function(lastmodel: string, imagename: string, modelsleft: number)

    --- Called when the Spawnmenu is Created.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/spawnmenu.lua#L247)
    SpawnMenuCreated: function()

    --- Runs when the user tries to open the chat box.
    --- **WARNING**: Returning `true` won't stop the chatbox from taking VGUI focus. chat.Close may be of use to mitigate that, or usage of GM:PlayerBindPress.
    -- @param isTeamChat --- Whether the message was sent through team chat.
    -- @return --- Return true to hide the default chat box.
    StartChat: function(isTeamChat: boolean): boolean

    --- Allows you to change the players inputs before they are processed by the server. This function is also called for bots, making it the best solution to control them.
    --- This is basically a shared version of GM:CreateMove.
    --- **NOTE**: This hook is predicted, but not by usual means, it is called when a CUserCmd is generated on the client, and on the server when it is received, so it is necessary for this hook to be called clientside even on singleplayer
    -- @param ply --- The player
    -- @param ucmd --- The usercommand
    StartCommand: function(ply: GPlayer, ucmd: GCUserCmd)

    --- Called right before an entity starts driving. Overriding this hook will cause it to not call drive.Start and the player will not begin driving the entity.
    -- @param ent --- The entity that is going to be driven
    -- @param ply --- The player that is going to drive the entity
    StartEntityDriving: function(ent: GEntity, ply: GPlayer)

    --- Called when you start a new game via the menu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/html/js/menu/control.NewGame.js#L174)
    StartGame: function()

    --- Called every rendered frame on client, except when the game is paused.
    --- Called every  game tick on the server. This will be the same as GM:Tick on the server when there is no lag, but will only be called once every processed server frame during lag.
    --- Global.CurTime is guaranteed to be different with each call to this hook on the server.
    --- See GM:Tick for a hook that runs every tick on both the client and server.
    --- **NOTE**: On server, this hook **WILL NOT** run if the server is empty, unless you set the ConVar `sv_hibernate_think` to `1`.
    Think: function()

    --- Called every game tick. engine.TickCount is guaranteed to be different between each call.
    --- Server side, this is similar to GM:Think (See that page for details).
    --- The default tickrate is `66.6666` (15 millisecond intervals). It can be changed via the `-tickrate` [command line option](Command_Line_Parameters).
    --- See engine.TickInterval for a function to retrieve this data at runtime.
    --- **NOTE**: This hook **WILL NOT** run if the server is empty, unless you set the ConVar `sv_hibernate_think` to 1
    Tick: function()

    --- **NOTE**: Isn't called when CalcMainActivity returns a valid override sequence id
    --- Allows you to translate player activities.
    -- @param ply --- The player
    -- @param act --- The activity. See Enums/ACT
    -- @return --- The new, translated activity
    TranslateActivity: function(ply: GPlayer, act: number): number

    --- Animation updates (pose params etc) should be done here.
    -- @param ply --- The player to update the animation info for.
    -- @param velocity --- The player's velocity.
    -- @param maxSeqGroundSpeed --- Speed of the animation - used for playback rate scaling.
    UpdateAnimation: function(ply: GPlayer, velocity: GVector, maxSeqGroundSpeed: number)

    --- Called when a variable is edited on an Entity (called by Edit Properties... menu). See Editable Entities for more information.
    --- **WARNING**: This hook is called to change a variable and not after a variable was changed
    -- @param ent --- The entity being edited
    -- @param ply --- The player doing the editing
    -- @param key --- The name of the variable
    -- @param val --- The new value, as a string which will later be converted to its appropriate type
    -- @param editor --- The edit table defined in Entity:NetworkVar
    VariableEdited: function(ent: GEntity, ply: GPlayer, key: string, val: string, editor: table)

    --- Called when you are driving a vehicle. This hook works just like GM:Move.
    --- This hook is called before GM:Move and will be called when GM:PlayerTick is not.
    -- @param ply --- Player who is driving the vehicle
    -- @param veh --- The vehicle being driven
    -- @param mv --- Move data
    VehicleMove: function(ply: GPlayer, veh: GVehicle, mv: GCMoveData)

    --- Called when user clicks on a VGUI panel.
    -- @param button --- The button that was pressed, see Enums/MOUSE
    -- @return --- Return true if the mouse click should be ignored or not.
    VGUIMousePressAllowed: function(button: number): boolean

    --- Called when a mouse button is pressed on a VGUI element or menu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_menus.lua#L71)
    -- @param pnl --- Panel that currently has focus.
    -- @param mouseCode --- The key that the player pressed using Enums/MOUSE.
    VGUIMousePressed: function(pnl: GPanel, mouseCode: number)

    --- Called as a weapon entity is picked up by a player. (Including Player:Give)
    --- Contrary to the name of the hook, it is **not called** when the player switches their active weapon to another.
    --- See also GM:PlayerDroppedWeapon and GM:PlayerCanPickupWeapon.
    --- **NOTE**: At the time when this hook is called Entity:GetOwner will return `NULL`. The owner is set on the next frame.
    --- **NOTE**: This will not be called when picking up a weapon you already have as the weapon will be removed and WEAPON:EquipAmmo will be called instead.
    -- @param weapon --- The equipped weapon.
    -- @param owner --- The player that is picking up the weapon.
    WeaponEquip: function(weapon: GWeapon, owner: GPlayer)

    --- Called when an addon from the Steam workshop finishes downloading. Used by default to update details on the workshop downloading panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L32-L38)
    -- @param id --- Workshop ID of addon.
    -- @param title --- Name of addon.
    WorkshopDownloadedFile: function(id: number, title: string)

    --- Called when an addon from the Steam workshop begins downloading. Used by default to place details on the workshop downloading panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L21-L30)
    -- @param id --- Workshop ID of addon.
    -- @param imageID --- ID of addon's preview image.
    --- For example, for **Extended Spawnmenu** addon, the image URL is
    --- ```
    --- http://cloud-4.steamusercontent.com/ugc/702859018846106764/9E7E1946296240314751192DA0AD15B6567FF92D/
    --- ```
    --- So, the value of this argument would be **702859018846106764**.
    -- @param title --- Name of addon.
    -- @param size --- File size of addon in bytes.
    WorkshopDownloadFile: function(id: number, imageID: number, title: string, size: number)

    --- Called while an addon from the Steam workshop is downloading. Used by default to update details on the fancy workshop download panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L40-L50)
    -- @param id --- Workshop ID of addon.
    -- @param imageID --- ID of addon's preview image.
    --- For example, for **Extended Spawnmenu** addon, the image URL is
    --- ```
    --- http://cloud-4.steamusercontent.com/ugc/702859018846106764/9E7E1946296240314751192DA0AD15B6567FF92D/
    --- ```
    --- So, the value of this argument would be **702859018846106764**.
    -- @param title --- Name of addon.
    -- @param downloaded --- Current bytes of addon downloaded.
    -- @param expected --- Expected file size of addon in bytes.
    WorkshopDownloadProgress: function(id: number, imageID: number, title: string, downloaded: number, expected: number)

    --- Called after GM:WorkshopStart.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L52-L71)
    -- @param remain --- Remaining addons to download
    -- @param total --- Total addons needing to be downloaded
    WorkshopDownloadTotals: function(remain: number, total: number)

    --- Called when downloading content from Steam workshop ends. Used by default to hide fancy workshop downloading panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L13-L19)
    WorkshopEnd: function()

    --- Called while an addon from the Steam workshop is extracting. Used by default to update details on the fancy workshop download panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L52-L62)
    -- @param id --- Workshop ID of addon.
    -- @param ImageID --- ID of addon's preview image.
    --- For example, for **Extended Spawnmenu** addon, the image URL is
    --- ```
    --- http://cloud-4.steamusercontent.com/ugc/702859018846106764/9E7E1946296240314751192DA0AD15B6567FF92D/
    --- ```
    --- So, the value of this argument would be **702859018846106764**.
    -- @param title --- Name of addon.
    -- @param percent --- Current bytes of addon extracted.
    WorkshopExtractProgress: function(id: number, ImageID: number, title: string, percent: number)

    --- Called when downloading content from Steam workshop begins. Used by default to show fancy workshop downloading panel.
    --- The order of Workshop hooks is this:
    --- * WorkshopStart
    --- * WorkshopDownloadTotals
    --- * * These are called for each new item:
    --- * WorkshopDownloadFile
    --- * WorkshopDownloadProgress - This is called until the file is finished
    --- * WorkshopDownloadedFile
    --- * WorkshopEnd (this ones called once)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L5-L11)
    WorkshopStart: function()

    --- Called when UGC subscription status changes.
    WorkshopSubscriptionsChanged: function()

    --- Called when a Workshop Message is received?. Currently, it seems like the message will be **#ugc.mounting** every time.
    --- **VALIDATE**: When does this exactly get called?. If an addon is subscribed, unsubscribed, error occurs or on any event?
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/menu/mount/mount.lua#L95-L103)
    -- @param message --- The Message from the Workshop. Will be a phrase that needs to be translated.
    WorkshopSubscriptionsMessage: function(message: string)

    --- **INTERNAL**:
    --- Called by the engine when the game initially fetches subscriptions to be displayed on the bottom of the main menu screen.
    -- @param num --- Amount of subscribed addons that have info retrieved.
    -- @param max --- Total amount of subscribed addons that need their info retrieved.
    WorkshopSubscriptionsProgress: function(num: number, max: number)
end
--- Table used by Global.HTTP function.
global record S_HTTPRequest
    --- Function to be called on failure.
    --- <callback>
    --- <arg type="string" name="reason">Reason for the failure.</arg>
    --- </callback>
    failed: function

    --- Function to be called on success.
    --- <callback>
    --- <arg type="number" name="code">The HTTP result code</arg>
    --- <arg type="string" name="body">The document data, usually HTML or JSON contents.</arg>
    --- <arg type="table" name="headers">List of headers the server provided.</arg>
    --- </callback>
    success: function

    --- Request method, case insensitive. Possible values are:
    --- * GET
    --- * POST
    --- * HEAD
    --- * PUT
    --- * DELETE
    --- * PATCH
    --- * OPTIONS
    method: string

    --- The target url
    url: string

    --- KeyValue table for [URL parameters](https://developer.mozilla.org/en-US/docs/Web/API/URLSearchParams). This is only applicable to the following request methods:
    --- * GET
    --- * POST (sent in body, so if `body` is set, parameters are ignored)
    --- * HEAD
    parameters: table

    --- KeyValue table for headers
    headers: table

    --- Body string for POST data. If set, will override parameters
    body: string

    --- Content type for body.
    type: string

    --- The timeout for the connection.
    timeout: number

end
--- Table used by util.TraceHull.
global record S_HullTrace
    --- The start position of the trace
    start: GVector

    --- The end position of the trace
    endpos: GVector

    --- The 3D vector local to the start/endpos with the highest values. This will represent the corner with the upper bounds of the box.
    maxs: GVector

    --- The 3D vector local to the start/endpos with the lowest (often negative) values. This will represent the corner with the lower bounds of the box.
    mins: GVector

    --- Things the trace should not hit. Can be an entity, a table of entities, a table of entity classes or a function:
    --- <callback>
    --- <arg type="Entity" name="ent">The entity that the trace hit</arg>
    --- <ret type="boolean">Return `true` to hit the entity, `false` to skip it.</ret>
    --- </callback>
    --- Using a function here is super slow. Try to avoid it.
    --filter: GEntity|{GEntity}|{string}|function

    --- The trace mask Enums/MASK. This determines what the trace should hit and what it shouldn't hit.
    mask: E_MASK

    --- The collision group Enums/COLLISION_GROUP. This determines what the trace should hit in regards to the entity's collision group.
    collisiongroup: E_COLLISION_GROUP

    --- Should the trace ignore world or not.
    ignoreworld: boolean

    --- If set, the trace result will be written to the supplied table instead of returning a new table
    output: S_TraceResult

    --- Turns the `filter` field into a whitelist, if it is a table.
    whitelist: boolean

    --- Enables traces to hit clientside only entities. Keep in mind that most naturally spawned entities are classified as debris, so extra `mask` values might be required.
    hitclientonly: boolean

end
--- Table structure used for render.SetLocalModelLights.
global record S_LocalLight
    --- The type of the light source, see Enums/MATERIAL_LIGHT.
    type: E_MATERIAL_LIGHT

    --- The color of the light source (x is red, y is green, z is blue). Values are not restricted to a specific range, higher values will result in a brighter light.
    color: GVector

    --- The origin of the light in world coordinates.
    pos: GVector

    --- The direction of the light. Only required for directional and spot lights.
    dir: GVector

    --- The maximum range of the light source. Does not actually control light attenuation. Usually left at 0 for infinite range.
    range: number

    --- Angular falloff exponent for spot lights. Higher values result in a sharper transition between the inner cone and the outer cone.
    angularFalloff: number

    --- The inner cone angle for spot lights, in degrees. No angular falloff will occur inside that cone.
    innerAngle: number

    --- The outer cone angle for spot lights, in degrees.
    outerAngle: number

    --- The distance at which the light will fade to 50% of its brightness.
    fiftyPercentDistance: number

    --- The distance at which the light will completely fade out.
    zeroPercentDistance: number

    --- The quadratic term of the light falloff. This will only be used if fiftyPercentDistance and zeroPercentDistance are not supplied, and allows finer control over light attenuation.
    quadraticFalloff: number

    --- The linear term of the light falloff. This will only be used if fiftyPercentDistance and zeroPercentDistance are not supplied, and allows finer control over light attenuation.
    linearFalloff: number

    --- The constant term of the light falloff. This will only be used if fiftyPercentDistance and zeroPercentDistance are not supplied, and allows finer control over light attenuation.
    constantFalloff: number

end
--- Table structure used by matproxy.Add.
global record S_MatProxyData
    --- The name of the material proxy
    name: string

    --- The function used to get variables from the ".vmt". Called once per each ".vmt".
    --- <callback>
    --- <arg type="table" name="self">The table structure itself</arg>
    --- <arg type="string" name="name">The material name</arg>
    --- <arg type="table" name="values">The material key values</arg>
    --- </callback>
    init: function

    --- The function used to apply the proxy. This is called every frame while any materials with this proxy are used in world.
    --- <callback>
    --- <arg type="table" name="self">The table structure itself.</arg>
    --- <arg type="string" name="name">The material name.</arg>
    --- <arg type="Entity" name="ent">The entity the material instance is applied to, if any.</arg>
    --- </callback>
    bind: function

end
--- A table structure representing the data stored by a single vertex of a mesh.
--- MeshVertex structures are usually grouped together in sets of 3 to define the corners of a triangle.
--- **NOTE**: Not all MeshVertex will contain all fields and not all fields are used by all shaders
--- Information on the fields used by most Source Engine shaders (Like `VertexLitGeneric`, `UnlitGeneric`, etc.) can be found [on the Valve Developer Wiki here.](https://developer.valvesoftware.com/wiki/Category:Shaders)
--- Returned by:
--- * util.GetModelMeshes
--- * PhysObj:GetMesh
--- Used by:
--- * IMesh:BuildFromTriangles
--- * Entity:PhysicsFromMesh
global record S_MeshVertex
    --- The Color that the area around this corner of a triangle should be tinted.
    color: GColor

    --- A normalized Vector representing a direction facing away from (perpendicular to) the surface of the triangle that this vertex is a part of.
    --- Many shaders use this to calculate lighting.
    normal: GVector

    --- A normalized Vector representing a direction facing along (parallel with) the surface of the triangle that this vertex is a part of.
    tangent: GVector

    --- A normalized Vector representing a direction facing away from (perpendicular to) both the vertex's normal and tangent directions.
    --- This is the result of a Cross Product between the vertex's normal and tangent directions.
    binormal: GVector

    --- The position of the vertex in local space.
    pos: GVector

    --- The horizontal coordinate of a position on the texture of the triangle that this vertex is a part of.
    --- This controls which part of the texture is drawn at this vertex.
    --- In the range `0` (the texture's left edge) to `1` (the texture's right edge)
    u: number

    --- The vertical coordinate of a position on the texture of the triangle that this vertex is a part of.
    --- This controls which part of the texture is drawn at this vertex.
    --- In the range `0` (the texture's top edge) to `1` (the texture's bottom edge)
    v: number

    --- A secondary U texture coordinate used by some shaders like `LightmappedGeneric`.
    --- Currently used exclusively by IMesh:BuildFromTriangles.
    u1: number

    --- A secondary V texture coordinate used by some shaders like `LightmappedGeneric`.
    --- Currently used exclusively by IMesh:BuildFromTriangles.
    v1: number

    --- A sequential table of four numbers whose purpose and expected values are determined by the shader.
    --- Many Source Engine shaders to hold tangent information of the vertex in the order `tangentX`, `tangentY`, `tangentZ`, `tangentHandedness`.
    userdata: {number}

    --- A sequential table of all the BoneWeight structures that affect this vertex.
    --- The total sum of their `weight` values should be `1`
    --- Current added exclusively by util.GetModelMeshes
    weights: {table}

end
--- Table returned by util.GetModelInfo.
global record S_ModelInfo
    --- Identical to Entity:SkinCount.
    SkinCount: number

    --- Valve key-value formatted info about the model's physics (Constraint Info, etc). This is limited to 4096 characters.
    --- This data can be parsed into a Lua table via util.KeyValuesToTablePreserveOrder
    KeyValues: string

    --- Valve key-value formatted info about the model (`$keyvalues` command in the `.qc` of the model), if present.
    --- Can describe things like health of a prop, flammability, etc.
    ModelKeyValues: string

    --- Number of meshes the model has. This could be 0 for animation only models.
    MeshCount: number

    --- Number of bones the model has.
    BoneCount: number

    --- Model flags. See [this page on Valve Developer Wiki](https://developer.valvesoftware.com/wiki/MDL#Model_flags) for explanation of each one.
    Flags: number

    --- Whether the model is meant to be a static prop (checks a specific model flag)
    StaticProp: boolean

    --- Number of materials used by this model.
    MaterialCount: number

    --- Number of sequences the model has.
    SequenceCount: number

    --- Number of attachments the model has.
    AttachmentCount: number

    --- Name of the model, as embedded in the model file itself. This may be different from the model path of the model on disk.
    ModelName: string

    --- Model version. This should be 48 most of the time, but can be different from mountable games.
    Version: number

    --- Checksum (CRC32) of the model. This value should be identical across all files for the same model. (.vtx, .mdl, .vvd, etc.)
    Checksum: number

    --- Name of the surface property for this model. See util.GetSurfaceData for more details about what they are.
    SurfacePropName: string

    --- If present, position of the eyes of the model, for NPCs.
    EyePosition: GVector

    --- Illumination position for the model, for cases where the model root would be potentially outside of the world.
    IllumPosition: GVector

    --- Mins of the model's bounding box.
    HullMin: GVector

    --- Maxs of the model's bounding box.
    HullMax: GVector

    --- A list of attachments the model has.
    --- Each attachment is a table with the following info:
    --- * Name
    --- * Bone
    --- * Offset
    Attachments: {table}

    --- A list of bones the model has. Please node that the keys of this table are **not** bone IDs, it's just a list,
    --- **VALIDATE**: but it might be safe to assume the keys are (BoneID-1) due to Lua table indexes starting at 1.
    --- .
    --- Each bone in the list has the following fields:
    --- * Name
    --- * Parent
    --- * Flags
    --- * PhysObj
    --- * SurfacePropName
    --- * Position
    --- * Angle
    Bones: {table}

    --- A list of sequences the model has, including the ones from `$includemodel`s.
    --- Each sequence is a table with the following info:
    --- * string Name
    --- * string Activity
    --- * table Events
    --- `Events` table is a list of tables with following memebers:
    --- * number Cycle
    --- * number Event
    --- * string Name
    --- * number Type
    --- * string Options
    Sequences: {table}

    --- A list of materials the model uses, across all its meshes.
    Materials: {string}

    --- A list of folders the game will look in for the **Materials**.
    MaterialDirectories: {string}

    --- Number of other models this model includes for their animations.
    IncludeModelCount: number

    --- The list of models this model includes for their animations.
    IncludeModels: {string}

    --- A list of hitbox sets this model has. Each hitbox set has the following structure:
    --- * Name
    --- * Count
    --- * HitBoxes - a table of hitboxes within this set
    --- Each hitbox has the following format:
    --- * Mins
    --- * Maxs
    --- * Bone
    HitBoxSets: {table}

end
--- A table structure containing the information required to create a mesh.
--- Returned by util.GetModelMeshes
global record S_ModelMeshData
    --- The name or path of this mesh's material.
    material: string

    --- A sequential table of MeshVertex Structures that represents the triangles of this mesh.
    --- These triangles are created from the contents of the `verticies` field.
    --- This can be used as an input to IMesh:BuildFromTriangles
    triangles: {table}

    --- A sequential table of MeshVertex Structures that represents each vertex of the mesh.
    --- **BUG**: This field has a typo in its name and should be named "vertices"
    verticies: {table}

end
--- Information about the NPC data structure, used to define spawnable NPCs for the Sandbox gamemode.
--- Example usage:
--- ```
--- list.Set( "NPC", "npc_tf2_ghost", {
--- Name = "Example NPC",
--- Class = "npc_tf2_ghost",
--- Category = "Nextbot"
--- } )
--- ```
global record S_NPCData
    --- The nice name of the NPC for UI display.
    Name: string

    --- Class name of the entity to spawn.
    Class: string

    --- Spawnmenu category to put the NPCinto.
    Category: string

    --- A list of weapons this NPC is typically meant to use. One will be picked on spawn at random, unless overwritten by the player.
    Weapons: table

    --- Key-value pairs to apply to the NPC on spawn. See Entity:SetKeyValue.
    KeyValues: table

    --- Model override for this NPC.
    Model: string

    --- Additional spawnflags for this NPC. See Entity:GetSpawnFlags.
    --- Ignored if `TotalSpawnFlags` key is present.
    SpawnFlags: number

    --- Total spawnflags override for this NPC.
    TotalSpawnFlags: number

    --- If set to `true`, this NPC can only be spawned on the ceiling. Stacks with `OnFloor`.
    OnCeiling: boolean

    --- If set to `true`, this NPC can only be spawned on the floor. Stacks with `OnCeiling`.
    OnFloor: boolean

    --- Offset, in Hammer units, away from the surface where the player is looking at for the NPC spawn position.
    Offset: number

    --- Material override for this NPC. See Entity:SetMaterial.
    Material: string

    --- Skin override for the NPC. See Entity:SetSkin.
    Skin: number

    --- If set to `true`, do not try to teleport the NPC to the ground.
    NoDrop: boolean

    --- Used to add additional rotation the NPC post spawn. Usually all NPCs would be facing the player on spawn. Value of `Angle( 0, 180, 0 )` would make the NPC face away from the player.
    Rotate: GAngle

    --- Health override for this NPC. Also sets Entity:SetMaxHealth.
    Health: number

    --- If set, a function to be called when the NPC is pasted using the duplicator library.
    OnDuplicated: function

end
--- The structure used by Vehicle:GetOperatingParams.
global record S_OperatingParams
    --- The current RPM of the vehicle
    RPM: number

    --- The current gear of the vehicle, starting from 0
    gear: number

    --- Is the vehicle boosting?
    isTorqueBoosting: boolean

    --- The current speed, in inches per second
    speed: number

    --- Steering angle
    steeringAngle: number

    --- Wheels on ground
    wheelsInContact: number

end
--- This page describes all **default** fields for a player class.
global record S_PLAYER
    --- The 'nice' name of the player class for display in User Interface and such.
    DisplayName: string

    --- How fast to move when not running
    WalkSpeed: number

    --- How fast to move when running/sprinting
    RunSpeed: number

    --- How fast to move when slow walking, which is activated via the `` keybind.
    SlowWalkSpeed: number

    --- Multiply walk speed by this when crouching
    CrouchedWalkSpeed: number

    --- How fast to go from not ducking, to ducking
    DuckSpeed: number

    --- How fast to go from ducking, to not ducking
    UnDuckSpeed: number

    --- How powerful a jump should be
    JumpPower: number

    --- Can the player use the flashlight
    CanUseFlashlight: boolean

    --- Max health we can have
    MaxHealth: number

    --- Max armor the player can have
    MaxArmor: number

    --- How much health we start with
    StartHealth: number

    --- How much armour we start with
    StartArmor: number

    --- Do we drop our weapon when we die
    DropWeaponOnDie: boolean

    --- Do we collide with teammates or run straight through them
    TeammateNoCollide: boolean

    --- Automatically swerves around other players
    AvoidPlayers: boolean

    --- Uses viewmodel hands
    UseVMHands: boolean
    --- Called when the player's class was changed from this class.
    ClassChanged: function()

    --- Called when the player dies
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L74-L75)
    Death: function()

    --- Called from GM:FinishMove.
    --- **WARNING**: This hook will not work if the current gamemode overrides GM:FinishMove and does not call this hook.
    --- **NOTE**: This hook is run after the drive.FinishMove has been called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_class/player_sandbox.lua#L161-L197)
    -- @param mv ---
    -- @return --- Return true to prevent default action
    FinishMove: function(mv: GCMoveData): boolean

    --- Called on player spawn to determine which hand model to use
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L126-L133)
    -- @return --- A table containing info about view model hands model to be set. See examples.
    GetHandsModel: function(): table

    --- Called when the class object is created
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L37)
    Init: function()

    --- Called on spawn to give the player their default loadout
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L60-L65)
    Loadout: function()

    --- Called from GM:Move.
    --- **WARNING**: This hook will not work if the current gamemode overrides GM:Move and does not call this hook.
    --- **NOTE**: This hook is run after the drive.Move has been called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L86)
    -- @param mv --- Movement information
    -- @return --- Return true to prevent default action
    Move: function(mv: GCMoveData): boolean

    --- Called after the viewmodel has been drawn
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L110-L118)
    -- @param viewmodel --- The viewmodel
    -- @param weapon --- The weapon
    PostDrawViewModel: function(viewmodel: GEntity, weapon: GEntity)

    --- Called before the viewmodel is drawn
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L100-L108)
    -- @param viewmodel --- The viewmodel
    -- @param weapon --- The weapon
    PreDrawViewModel: function(viewmodel: GEntity, weapon: GEntity)

    --- Called when we need to set player model from the class.
    --- **NOTE**: This will only be called if you have not overridden GM:PlayerSetModel or call this function from it or anywhere else using player_manager.RunClass
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L67-L74)
    SetModel: function()

    --- Setup the network table accessors.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L27-L34)
    SetupDataTables: function()

    --- Called when the player spawns
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L45-L52)
    Spawn: function()

    --- Called from GM:CreateMove.
    --- **WARNING**: This hook will not work if the current gamemode overrides GM:SetupMove and does not call this hook.
    --- **NOTE**: This hook is run after the drive.StartMove has been called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L85)
    -- @param mv --- The move data to override/use
    -- @param cmd --- The command data
    -- @return --- Return true to prevent default action
    StartMove: function(mv: GCMoveData, cmd: GCUserCmd): boolean

    --- Called when the player changes their weapon to another one causing their viewmodel model to change
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/player_class/player_default.lua#L89-L98)
    -- @param viewmodel --- The viewmodel that is changing
    -- @param old --- The old model
    -- @param new --- The new model
    ViewModelChanged: function(viewmodel: GEntity, old: string, new: string)
end
--- This table is returned by surface.GetPanelPaintState.
global record S_PanelPaintState
    --- The X coordinate for the top-left corner of the Panel currently being drawn.
    translate_x: number

    --- The Y coordinate for the top-left corner of the Panel currently being drawn.
    translate_y: number

    --- The X coordinate for the left edge of the ScissorRect that surrounds the Panel that is currently being drawn.
    scissor_left: number

    --- The Y coordinate for the top edge of the ScissorRect that surrounds the Panel that is currently being drawn.
    scissor_top: number

    --- The X coordinate for the right edge of the ScissorRect that surrounds the Panel that is currently being drawn.
    scissor_right: number

    --- The Y coordinate for the bottom edge of the ScissorRect that surrounds the Panel that is currently being drawn.
    scissor_bottom: number

    --- Whether or not the Panel currently being drawn has render.SetScissorRect active.
    scissor_enabled: boolean

end
--- Structure represents a path segment, returned by PathFollower:GetCurrentGoal, PathFollower:FirstSegment and PathFollower:LastSegment.
global record S_PathSegment
    --- The navmesh area this segment occupies.
    area: GCNavArea

    --- How much of a curve should the bot execute when navigating this segment. 0 = none, 1 = 180°
    curvature: number

    --- Distance of this segment from the start of the path.
    distanceFromStart: number

    --- The direction of travel to reach the end of this segment from the start, represented as a normalised vector.
    forward: GVector

    --- The direction of travel to reach the end of this segment from the start, represented as a cardinal direction integer 0 to 3, or 9 for vertical movement.
    how: number

    --- The navmesh ladder this segment occupies, if any.
    ladder: GCNavLadder

    --- Length of this segment.
    length: number

    m_portalCenter: GVector

    m_portalHalfWidth: number

    --- The position of the end of this segment.
    pos: GVector

    --- The movement type of this segment, indicating how bots are expected to move along this segment.
    --- * 0 is ground movement
    --- * 1 is falling down
    --- * 2 is climbing up or jumping
    --- * 3 is jumping over a gap
    --- * 4 is climbing a ladder up (unused)
    --- * 5 is climbing a ladder down (unused)
    type: number

end
--- Table used by physenv.SetPerformanceSettings and physenv.GetPerformanceSettings.
--- When setting the settings, omitting any key will fallback to its current value. (can be retrieved via the get function)
global record S_PhysEnvPerformanceSettings
    --- Maximum amount of seconds to precalculate collisions with objects.
    --- Default value for this setting is `0.5`.
    LookAheadTimeObjectsVsObject: number

    --- Maximum amount of seconds to precalculate collisions with world.
    --- Default value for this setting is `1`.
    LookAheadTimeObjectsVsWorld: number

    --- Maximum collision checks per tick.
    --- Objects may penetrate after this many collision checks
    --- Default value for this setting is `50000`.
    MaxCollisionChecksPerTimestep: number

    --- Maximum collision per object per tick.
    --- Object will be frozen after this many collisions (visual hitching vs. CPU cost)
    --- Default value for this setting is `10`.
    MaxCollisionsPerObjectPerTimestep: number

    --- Maximum world-space speed of an object in inches per second.
    --- Default value for this setting is `4000`.
    MaxVelocity: number

    --- Maximum world-space rotational velocity in degrees per second.
    --- Default value for this setting is `7200`.
    MaxAngularVelocity: number

    --- Minimum mass of an object to be affected by friction.
    --- Default value for this setting is `10`.
    MinFrictionMass: number

    --- Maximum mass of an object to be affected by friction.
    --- Default value for this setting is `2500`.
    MaxFrictionMass: number

end
--- Structure used by construct.SetPhysProp.
global record S_PhysProperties
    --- Enables or disables gravity for the entity
    GravityToggle: boolean

    --- Sets the physics material for the entity
    Material: string

end
--- Structure used in storing/restoring physics object attributes.
--- duplicator.GenericDuplicatorFunction and duplicator.DoGenericPhysics use a table of **PhysicsObjectSave**s with the struct's index in the table being the physics object ID.
--- Pos and Angle are set by the following:
--- ```
--- Pos, Angle = WorldToLocal(phys:GetPos(), phys:GetAngle(), Vector( 0, 0, 0 ), Angle( 0, 0, 0 ))
--- ```
global record S_PhysicsObjectSave
    --- The entity's world position made local with Global.WorldToLocal
    Pos: GVector

    --- The entity's world angles made local with Global.WorldToLocal
    Angle: GAngle

    --- Whether the entity is moveable. Equal to (`not` PhysObj:IsMoveable)
    Frozen: boolean

    --- Whether the entity's gravity is affected by gravity or not. PhysObj:IsGravityEnabled
    NoGrav: boolean

    --- Whether the entity is dormant or not. PhysObj:IsAsleep
    Sleep: boolean

end
--- A structure containing vertex information for use with surface.DrawPoly.
--- UV coordinates describe which part of a given texture should be drawn at a vertex - your graphics card's interpolator will fill in space between vertices. UV coords range from `0-1`, with `0` being top/left and `1` being bottom/right. If you're using a texture these are mandatory.
--- **NOTE**: You must pass a table of tables with this structure to the function. **You need to pass at least 3 points.**
--- Your points must be defined in a **clockwise order.** Otherwise, your shape will not render properly.
global record S_PolygonVertex
    --- The x coordinate of the vertex.
    x: number

    --- The y coordinate of the vertex.
    y: number

    --- The u texture coordinate of the vertex. `Can be left blank.`
    u: number

    --- The v texture coordinate of the vertex. `Can be left blank.`
    v: number

end
--- The structure used by Global.CreateNewAddonPreset.
global record S_Preset
    --- A Table containing all enabled addons.
    enabled: table

    --- A Table containing all disabled addons.
    disabled: table

    --- The name of the Preset.
    name: string

    --- What to do with addons not in the preset. Can be `enable`, `disable` or nothing.
    newAction: string

end
--- Table used by Global.FireProblem function.
global record S_Problem
    --- The Problem ID.
    id: string

    --- The Text to Display.
    text: string

    --- The Problem severity.
    severity: number

    --- The Problem Type. Possible values are:
    --- * config
    --- * hardware
    --- * addons
    type: string

    --- a Function that fixes the Problem.
    fix: function

end
--- Structure used for properties.Add.
global record S_PropertyAdd
    --- Can be set to "toggle" to make this property a toggle property.
    Type: string

    --- Label to show on opened menu
    MenuLabel: string

    --- Icon to show on opened menu for this item. Optional for simple properties and unused for toggle properties.
    MenuIcon: string

    --- Where in the list should the property be positioned, relative to other properties.
    --- For reference, here are the default properties and their Order values:
    --- Property |  Order |
    --- ---------|-------|
    --- | Bone Manipulate | 500 |
    --- | Bodygroups | 600 |
    --- | Skin | 601 |
    --- | Keep Upright | 900 |
    --- | Ignite/Extinguish | 999 |
    --- | Remove | 1000 |
    --- | Gravity | 1001 |
    --- | Drive | 1100 |
    --- | Collision | 1500 |
    --- | Statue | 1501 |
    --- | NPC Biggify/Smallify | 1799, 1800 |
    --- | Motion Control (Kinect) | 2500 |
    --- | Edit Properties | 90001 |
    Order: number

    --- Whether to add a spacer before this property. This should generally be true for the first property in a group of properties.
    PrependSpacer: boolean

    --- Used **clientside** to decide whether this property should be shown for an entity.
    --- It's good practice to call GM:CanProperty in this hook via gamemode.Call or hook.Run.
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="Entity" name="ent">the entity the player clicked</arg>
    --- <arg type="Player" name="player">the Global.LocalPlayer</arg>
    --- <ret type="boolean" name="check">Return true if the property should be shown for this entity.</ret>
    --- </callback>
    Filter: function

    --- Required for toggle properties (clientside).
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="Entity" name="ent">the entity the player clicked</arg>
    --- <arg type="table" name="tr">the player's eye trace</arg>
    --- <ret type="boolean" name="check">Return true if the property should appear checked in the UI.</ret>
    --- </callback>
    Checked: function

    --- Called **clientside** when the property is clicked
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="Entity" name="ent">the entity the player clicked</arg>
    --- <arg type="table" name="tr">the player's eye trace</arg>
    --- </callback>
    --- When appropriate, within this function you can call `self:MsgStart()`, write data with the net.`Write*` functions, and finish with `self:MsgEnd()`. This will activate the `Receive` function on the server. In most cases, you will want to send the entity to the server, as it's not done by default.
    Action: function

    --- Called **serverside** if the client sends a message in the `Action` function (see above).
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="number" name="len">the net message length, although this includes the property identifier used internally (the name of the property)</arg>
    --- <arg type="Player" name="ply">the player who clicked the property</arg>
    --- </callback>
    --- You can read data received from the client with the net.`Read*` functions. It's good practice to check GM:CanProperty here via gamemode.Call or hook.Run.
    Receive: function

    --- Called **clientside** when the property option has been created in the right-click menu. This is not called for toggle properties!
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="DMenuOption" name="option">the menu option</arg>
    --- <arg type="Entity" name="ent">the entity the player right-clicked</arg>
    --- <arg type="table" name="tr">the player's eye trace</arg>
    --- </callback>
    MenuOpen: function

    --- Same as `MenuOpen`, but also called for toggle properties and has different arguments. This is called immediately after `MenuOpen`, but nothing happens in between so you should only ever use one or the other.
    --- <callback>
    --- <arg type="table" name="self">the property table</arg>
    --- <arg type="DMenu" name="menu">the property menu</arg>
    --- <arg type="DMenuOption" name="option">the menu option</arg>
    --- </callback>
    OnCreate: function

end
--- Used for cam.Start.
--- Unless stated otherwise, the default values for all these keys would be inherited from the engine's current `CViewSetup` and do not have static representations.
global record S_RenderCamData
    --- The x position of the view port
    x: number

    --- The y position of the view port
    y: number

    --- The width of the view port
    w: number

    --- The height of the view port
    h: number

    --- The type of cam. Valid types are:
    --- * "2D" - No additional arguments are required
    --- * "3D" - Only origin and angles are needed, all other parameters are optional.
    type: string

    --- The position to render from
    origin: GVector

    --- The angles to render from
    angles: GAngle

    --- The field of view
    fov: number

    --- The aspect ratio of the view port (Note that this is NOT set to w/h by default)
    aspect: number

    --- The distance to the far clipping plane
    zfar: number

    --- The distance to the near clipping plane
    znear: number

    --- Set to true if this is to draw into a subrect of the larger screen.
    subrect: boolean

    --- m_bDoBloomAndToneMapping
    bloomtone: boolean

    --- A table having these keys: ( all floats )
    --- * left
    --- * right
    --- * bottom
    --- * top
    offcenter: table

    --- If set, makes the view/camera orthogonal. A table having these keys: ( all floats )
    --- * left
    --- * right
    --- * bottom
    --- * top
    ortho: table

end
--- Used for render.Capture.
global record S_RenderCaptureData
    --- Format of the capture. Valid formats are:
    --- * `jpeg` or `jpg`
    --- * `png`
    format: string

    --- X coordinate of the capture origin
    x: number

    --- Y coordinate of the capture origin
    y: number

    --- Width of the capture
    w: number

    --- Height of the capture
    h: number

    --- The quality of the capture. Affects jpeg only.
    quality: number

    --- Set to false to capture an image with alpha channel set to fully opaque. Affects png only.
    alpha: boolean

end
--- Information about Scripted Weapons (SWEPs),
--- used by SANDBOX:PlayerGiveSWEP and in SWEP creation.
--- For list of callbacks, see WEAPON Hooks.
--- While some of the fields may be serverside or clientside only, it is recommended to provide them on both so
--- addons could use their values.
global record S_SWEP is GWeapon
    --- Entity class name of the SWEP (file or folder name of your SWEP). This is
    --- set automatically
    ClassName: string

    --- If set, overrides the classname of the SWEP.
    ClassNameOverride: string

    --- The spawn menu category that this weapon
    --- resides in.
    Category: string

    --- Whether or not this weapon can be obtained through the
    --- spawn menu.
    Spawnable: boolean

    --- If spawnable, this variable determines whether only
    --- administrators can use the button in the spawn menu.
    AdminOnly: boolean

    --- The name of the SWEP displayed in the spawn menu.
    PrintName: string

    --- The weapon's base script, relative to `lua/weapons`.
    Base: string

    --- The deploy speed multiplier. This does not change the
    --- internal deployment speed.
    m_WeaponDeploySpeed: number

    --- @deprecated
    --- **DEPRECATED**: Use Entity:GetOwner() instead.
    Owner: GEntity

    --- @deprecated
    --- **DEPRECATED**: Use `SWEP` instead. However, if called in a SWEP method; use `self` instead.
    Weapon: GWeapon

    --- The SWEP's author.
    Author: string

    --- The contact information regarding the SWEP's author.
    Contact: string

    --- The purpose of the SWEP.
    Purpose: string

    --- The instructions regarding the SWEP's usage.
    Instructions: string

    --- Relative path to the SWEP's view model.
    ViewModel: string

    --- Used primarily for Counter Strike: Source view models, this variable is used to flip them back to normal.
    ViewModelFlip: boolean

    --- Behaves similarly to `ViewModelFlip`, but for the second view model.
    ViewModelFlip1: boolean

    --- Behaves similarly to `ViewModelFlip`, but for the third view model.
    ViewModelFlip2: boolean

    --- The field of view percieved whilst wielding this `SWEP`.
    ViewModelFOV: number

    --- Relative path to the SWEP's world model.
    WorldModel: string

    --- Whether this weapon can be autoswitched
    --- away from when the player runs out of ammo in this weapon or picks up another weapon or ammo
    AutoSwitchFrom: boolean

    --- Whether this weapon can be autoswitched to
    --- when the player runs out of ammo in their current weapon or they pick this weapon up
    AutoSwitchTo: boolean

    --- Determines the priority of the weapon when
    --- autoswitching. The weapon being autoswitched from will attempt to switch to a weapon with the same weight
    --- that has ammo, but if none exists, it will prioritise higher weight weapons.
    Weight: number

    --- The scale of the viewmodel bob (viewmodel movement
    --- from left to right when walking around)
    BobScale: number

    --- The scale of the viewmodel sway (viewmodel
    --- position lerp when looking around).
    SwayScale: number

    --- Should the weapon icon bounce in weapon
    --- selection?
    BounceWeaponIcon: boolean

    --- Should draw the weapon selection info
    --- box, containing SWEP.Instructions, etc.
    DrawWeaponInfoBox: boolean

    --- Should we draw the default HL2 ammo counter?
    DrawAmmo: boolean

    --- Should we draw the default crosshair?
    DrawCrosshair: boolean

    --- The SWEP render group, see Enums/RENDERGROUP. If unset, the engine will decide the render group based on the SWEPs world model.
    RenderGroup: E_RENDERGROUP

    --- Slot in the weapon selection menu, starts with `0`
    Slot: number

    --- Position in the slot, should be in the range `0-128`
    SlotPos: number

    --- Internal variable for drawing the info box in weapon selection
    SpeechBubbleLid: number

    --- Path to
    --- a material. Override this in your SWEP to set the icon in the weapon selection. This must be the texture ID,
    --- see surface.GetTextureID. Keep in mind that the path must be to a `.vmt` file, NOT `.vtf`.
    --- Alternatively you can render custom weapon selection via WEAPON:DrawWeaponSelection.
    WepSelectIcon: number

    --- Should we use Counter-Strike muzzle
    --- flashes upon firing? This is required for DoD:S or CS:S view models to fix their muzzle flashes.
    CSMuzzleFlashes: boolean

    --- Use the X shape muzzle flash instead of the
    --- default Counter-Strike muzzle flash. Requires CSMuzzleFlashes to be set to true.
    CSMuzzleX: boolean

    --- Primary attack settings. The table contains these fields:
    --- * string `Ammo` - Ammo type (`Pistol`, `SMG1`, etc.) See game.AddAmmoType.
    --- * number `ClipSize` - The maximum amount of bullets one clip can hold. Setting it to `-1` means weapon uses no clips, like a grenade or a rocket launch.
    --- * number `DefaultClip` - Default ammo in the clip, making it higher than ClipSize will give player additional ammo on spawn
    --- * boolean `Automatic` - If true makes the weapon shoot automatically as long as the player has primary attack button held down
    Primary: table

    --- Secondary attack settings, has same fields as Primary attack settings
    Secondary: table

    --- Makes the player models hands bonemerged onto
    --- the view model
    --- **WARNING**: The gamemode and view models **must** support this feature for it to work!
    --- You can find more information here: Using Viewmodel Hands
    UseHands: boolean

    --- The folder from where the weapon was loaded. This should always be
    --- "weapons/weapon_myweapon", regardless whether your SWEP is stored as a file, or multiple files in a folder.
    --- It is set automatically on load
    Folder: string

    --- Makes the default SWEP crosshair be
    --- positioned in 3D space where your aim actually is (like on Jeep), instead of simply sitting in the middle of
    --- the screen at all times
    AccurateCrosshair: boolean

    --- Disable the ability for players to duplicate this
    --- SWEP
    DisableDuplicator: boolean

    --- Sets the spawnmenu content icon type
    --- for the entity, used by spawnmenu in the Sandbox-derived gamemodes.
    --- See spawnmenu.AddContentType for more information.
    ScriptedEntityType: string

    --- If set to false, the weapon will not play the
    --- weapon pick up sound when picked up.
    m_bPlayPickupSound: boolean

    --- If set,
    --- overrides the icon path to be displayed in the Spawnmenu for this entity. The path is relative to the `materials/` folder.
    IconOverride: string
    --- Called when another entity fires an event to this entity.
    -- @param inputName --- The name of the input that was triggered.
    -- @param activator --- The initial cause for the input getting triggered.
    -- @param called --- The entity that directly trigger the input.
    -- @param data --- The data passed.
    -- @return --- Should we suppress the default action for this input?
    AcceptInput: function(inputName: string, activator: GEntity, called: GEntity, data: string): boolean

    --- Allows you to adjust the mouse sensitivity. This hook only works if you haven't overridden GM:AdjustMouseSensitivity.
    -- @return --- Sensitivity scale
    AdjustMouseSensitivity: function(): number

    --- Returns how much of primary ammo the player has.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L251-L257)
    -- @return --- The amount of primary ammo player has
    Ammo1: function(): number

    --- Returns how much of secondary ammo the player has.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L262-L267)
    -- @return --- The amount of secondary ammo player has
    Ammo2: function(): number

    --- Allows you to adjust player view while this weapon in use.
    --- This hook is called from the default implementation of GM:CalcView which is [here](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/cl_init.lua#L387-L395). Therefore, it will not be called if any other hook added to `CalcView` returns any value, or if the current gamemode overrides the default hook and does not call the SWEP function.
    -- @param ply --- The owner of weapon
    -- @param pos --- Current position of players view
    -- @param ang --- Current angles of players view
    -- @param fov --- Current FOV of players view
    -- @return --- New position of players view
    -- @return --- New angle of players view
    -- @return --- New FOV of players view
    CalcView: function(ply: GPlayer, pos: GVector, ang: GAngle, fov: number): GVector, GAngle, number

    --- Allows overriding the position and angle of the viewmodel. This hook only works if you haven't overridden GM:CalcViewModelView.
    -- @param ViewModel --- The viewmodel entity
    -- @param OldEyePos --- Original position (before viewmodel bobbing and swaying)
    -- @param OldEyeAng --- Original angle (before viewmodel bobbing and swaying)
    -- @param EyePos --- Current position
    -- @param EyeAng --- Current angle
    -- @return --- New position
    -- @return --- New angle
    CalcViewModelView: function(ViewModel: GEntity, OldEyePos: GVector, OldEyeAng: GAngle, EyePos: GVector, EyeAng: GAngle): GVector, GAngle

    --- Called when a Citizen NPC is looking around to a (better) weapon to pickup.
    -- @return --- Return true to allow this weapon to be picked up by NPCs.
    CanBePickedUpByNPCs: function(): boolean

    --- Helper function for checking for no ammo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L200-L213)
    -- @return --- Can use primary attack
    CanPrimaryAttack: function(): boolean

    --- Helper function for checking for no ammo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L219-L231)
    -- @return --- Can use secondary attack
    CanSecondaryAttack: function(): boolean

    --- Allows you to use any numbers you want for the ammo display on the HUD.
    --- Can be useful for weapons that don't use standard ammo.
    -- @return --- The new ammo display settings. A table with 4 possible keys:
    --- * boolean Draw - Whether to draw the ammo display or not
    --- * number PrimaryClip - Amount of primary ammo in the clip
    --- * number PrimaryAmmo - Amount of primary ammo in the reserves
    --- * number SecondaryAmmo - Amount of secondary ammo. It is shown like alt-fire for SMG1 and AR2 are shown.
    --- There is **no** SecondaryClip!
    CustomAmmoDisplay: function(): table

    --- Called when player has just switched to this weapon.
    --- **NOTE**: Due to this hook being predicted, it is not called clientside in singleplayer at all, and in multiplayer it will not be called clientside if the weapon is switched with Player:SelectWeapon or the "use" console command, however it will be called clientside with the default weapon selection menu and when using CUserCmd:SelectWeapon
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L114-L116)
    -- @return --- Return true to allow switching away from this weapon using `lastinv` command
    Deploy: function(): boolean

    --- Called when the crosshair is about to get drawn, and allows you to override it.
    --- This function will **not** be called if `SWEP.DrawCrosshair` is set to false or if player is affected by Player:CrosshairDisable.
    -- @param x --- X coordinate of the crosshair.
    -- @param y --- Y coordinate of the crosshair.
    -- @return --- Return true to override the default crosshair.
    DoDrawCrosshair: function(x: number, y: number): boolean

    --- Called so the weapon can override the impact effects it makes.
    --- **NOTE**: If the bullet was fired in a predicted environment, the hook will not be called on the `CLIENT` realm.
    --- **NOTE**: This hook will also be called when `WEAPON:GetOwner():FireBullets` is called. While in `MULTIPLAYER`, this hook will be called on the respective state, but in `SINGLEPLAYER`, this hook will always be called on the `CLIENT` realm even if `FireBullets` was called on the `SERVER`.
    -- @param tr --- A Structures/TraceResult from player's eyes to the impact point
    -- @param damageType --- The damage type of bullet. See Enums/DMG
    -- @return --- Return true to not do the default thing - which is to call `UTIL_ImpactTrace` in C++
    DoImpactEffect: function(tr: table, damageType: number): boolean

    --- This hook allows you to draw on screen while this weapon is in use.
    --- If you want to draw a custom crosshair, consider using WEAPON:DoDrawCrosshair instead.
    DrawHUD: function()

    --- This hook allows you to draw on screen while this weapon is in use. This hook is called **before** WEAPON:DrawHUD and is equivalent of GM:HUDPaintBackground.
    DrawHUDBackground: function()

    --- This hook draws the selection icon in the weapon selection menu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/cl_init.lua#L34-L58)
    -- @param x --- X coordinate of the selection panel
    -- @param y --- Y coordinate of the selection panel
    -- @param width --- Width of the selection panel
    -- @param height --- Height of the selection panel
    -- @param alpha --- Alpha value of the selection panel
    DrawWeaponSelection: function(x: number, y: number, width: number, height: number, alpha: number)

    --- Called when we are about to draw the world model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    DrawWorldModel: function(flags: number)

    --- Called when we are about to draw the translucent world model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    DrawWorldModelTranslucent: function(flags: number)

    --- Called when a player or NPC has picked the weapon up.
    -- @param NewOwner --- The one who picked the weapon up. Can be Player or NPC.
    Equip: function(NewOwner: GEntity)

    --- The player has picked up the weapon and has taken the ammo from it.
    --- The weapon will be removed immediately after this call.
    -- @param ply --- The player who picked up the weapon
    EquipAmmo: function(ply: GPlayer)

    --- Called before executing an animation event, such as a muzzle flash appearing or a shell ejecting.
    --- This will only be called serverside for 3000-range events, and clientside for 5000-range and other events.
    -- @param pos --- Position of the effect.
    -- @param ang --- Angle of the effect.
    -- @param event --- The event ID of the happened event. See [this page](http://developer.valvesoftware.com/wiki/Animation_Events).
    -- @param options --- Name or options of the event.
    -- @param source --- The source entity. This will be a viewmodel on the client and the weapon itself on the server
    -- @return --- Return true to disable the effect.
    FireAnimationEvent: function(pos: GVector, ang: GAngle, event: number, options: string, source: GEntity): boolean

    --- This hook allows you to freeze players screen.
    --- **NOTE**: Player will still be able to move or shoot
    -- @return --- Return true to freeze moving the view
    FreezeMovement: function(): boolean

    --- This hook is for NPCs, you return what they should try to do with it.
    --- **WARNING**: Calling NPC:CapabilitiesGet in this hook on the same entity can cause infinite loops since that function adds the result of WEAPON:GetCapabilities on top of the return value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/init.lua#L73-L77)
    -- @return --- A number defining what NPC should do with the weapon. Use the Enums/CAP.
    GetCapabilities: function(): E_CAP

    --- Called when the weapon is used by NPCs to determine how accurate the bullets fired should be.
    --- The inaccuracy is simulated by changing the NPC:GetAimVector based on the value returned from this hook.
    -- @param proficiency --- How proficient the NPC is with this gun. See Enums/WEAPON_PROFICIENCY
    -- @return --- An amount of degrees the bullets should deviate from the NPC's NPC:GetAimVector. Default is 15.
    GetNPCBulletSpread: function(proficiency: number): number

    --- Called when the weapon is used by NPCs to tell the NPC how to use this weapon. Controls how long the NPC can or should shoot continuously.
    -- @return --- Minimum amount of bullets per burst. Default is 1.
    -- @return --- Maximum amount of bullets per burst. Default is 1.
    -- @return --- Delay between each shot, aka firerate. Default is 1.
    GetNPCBurstSettings: function(): number, number, number

    --- Called when the weapon is used by NPCs to tell the NPC how to use this weapon. Controls amount of time the NPC can rest (not shoot) between bursts.
    -- @return --- Minimum amount of time the NPC can rest (not shoot) between bursts in seconds. Default is `0.3` seconds.
    -- @return --- Maximum amount of time the NPC can rest (not shoot) between bursts in seconds. Default is `0.6` seconds.
    GetNPCRestTimes: function(): number, number

    --- Allows you to override where the tracer effect comes from. ( Visual bullets )
    -- @return --- The new position to start tracer effect from
    GetTracerOrigin: function(): GVector

    --- This hook allows you to adjust view model position and angles.
    -- @param EyePos --- Current position
    -- @param EyeAng --- Current angle
    -- @return --- New position
    -- @return --- New angle
    GetViewModelPosition: function(EyePos: GVector, EyeAng: GAngle): GVector, GAngle

    --- Called when weapon tries to holster.
    --- **NOTE**: This will only be called serverside when using Player:SelectWeapon as that function immediately switches the weapon out of prediction.
    --- **BUG**: [This is called twice for every holster clientside, one in Prediction and one not.](https://github.com/Facepunch/garrysmod-issues/issues/2854
    --- **BUG**: [Before WEAPON:OnRemove is called, this function is only called serverside.](https://github.com/Facepunch/garrysmod-issues/issues/3133
    -- @param weapon --- The weapon we are trying switch to.
    -- @return --- Return true to allow weapon to holster.
    --- This will not have an effect if weapon was switched away from using Player:SetActiveWeapon
    Holster: function(weapon: GEntity): boolean

    --- This hook determines which parts of the HUD to draw.
    -- @param element --- The HUD element in question
    -- @return --- Return false to hide this HUD element
    HUDShouldDraw: function(element: string): boolean

    --- Called when the weapon entity is created.
    --- **NOTE**: Entity:GetOwner will return NULL at this point because the weapon is not equpped by a player or NPC yet. Use WEAPON:Equip or WEAPON:Deploy if you need the owner to be valid.
    --- **BUG**: [This is not called serverside after a quicksave.](https://github.com/Facepunch/garrysmod-issues/issues/3015
    Initialize: function()

    --- Called when the engine sets a value for this scripted weapon.
    --- See GM:EntityKeyValue for a hook that works for all entities.
    --- See ENTITY:KeyValue for an  hook that works for scripted entities.
    -- @param key --- The key that was affected.
    -- @param value --- The new value.
    -- @return --- Return true to suppress this KeyValue or return false or nothing to apply this key value.
    KeyValue: function(key: string, value: string): boolean

    --- Called internally during `TASK_RANGE_ATTACK1 --> OnRangeAttack1`. This allows you to separate your SWEPs primary firing function from players and NPCs.
    --- To get the delay the NPC will fire again, you can call `self:GetOwner():GetInternalVariable("m_flNextAttack")`
    --- **NOTE**: This hook is called internally only for NPCs that has `CAP_USE_SHOT_REGULATOR` set.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/init.lua#L93)
    -- @param shootPos --- The world position the NPC will use as attack starting position. You can create your projectiles here.
    -- @param shootDir --- The direction the NPC wants to shoot at.
    NPCShoot_Primary: function(shootPos: GVector, shootDir: GVector)

    --- A utility function to seperate your SWEPs secondary firing from players.
    --- Unlike WEAPON:NPCShoot_Primary, this won't be called by the engine for `TASK_RANGE_ATTACK2`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/init.lua#L83)
    -- @param shootPos --- The world position the NPC will use as attack starting position. You can create your projectiles here.
    -- @param shootDir --- The direction the NPC wants to shoot at.
    NPCShoot_Secondary: function(shootPos: GVector, shootDir: GVector)

    --- Called when weapon is dropped by Player:DropWeapon.
    --- See also WEAPON:OwnerChanged.
    -- @param owner --- The entity that dropped the weapon.
    OnDrop: function(owner: GEntity)

    --- Called whenever the weapons Lua script is reloaded.
    OnReloaded: function()

    --- Called when the Scripted Weapon is about to be removed.
    --- Entity:GetOwner may be unset at this point, see WEAPON:OnDrop and WEAPON:OwnerChanged.
    OnRemove: function()

    --- Called when the weapon entity is reloaded from a Source Engine save (not the Sandbox saves or dupes) or on a changelevel (for example Half-Life 2 campaign level transitions).
    --- For the duplicator callbacks, see ENTITY:OnDuplicated.
    --- See also saverestore for relevant functions.
    OnRestore: function()

    --- Called when weapon is dropped or picked up by a new player. This can be called clientside for all players on the server if the weapon has no owner and is picked up.
    --- See also WEAPON:OnDrop.
    OwnerChanged: function()

    --- Called after the view model has been drawn while the weapon in use. This hook is called from the default implementation of GM:PostDrawViewModel, and as such, will not occur if it has been overridden.
    --- WEAPON:ViewModelDrawn is an alternative hook which is always called before GM:PostDrawViewModel.
    -- @param vm --- This is the view model entity after it is drawn
    -- @param weapon --- This is the weapon that is from the view model (same as self)
    -- @param ply --- The owner of the view model
    -- @param flags --- The STUDIO_ flags for this render operation.
    PostDrawViewModel: function(vm: GEntity, weapon: GWeapon, ply: GPlayer, flags: number)

    --- Allows you to modify viewmodel while the weapon in use before it is drawn. This hook only works if you haven't overridden GM:PreDrawViewModel.
    -- @param vm --- This is the view model entity before it is drawn.
    -- @param weapon --- This is the weapon that is from the view model.
    -- @param ply --- The the owner of the view model.
    -- @param flags --- The STUDIO_ flags for this render operation.
    -- @return --- Return `true` to prevent the default action of rendering the view model. `PostDrawViewModel` will NOT be called in this scenario.
    PreDrawViewModel: function(vm: GEntity, weapon: GWeapon, ply: GPlayer, flags: number): boolean

    --- Called when primary attack button ( +attack ) is pressed.
    --- When in singleplayer, this function is only called in the server realm. When in multiplayer, the hook will be called on both the server and the client in order to allow for Prediction.
    --- You can force the hook to always be called on client like this:
    --- ```
    --- if ( game.SinglePlayer() ) then self:CallOnClient( "PrimaryAttack" ) end
    --- ```
    --- Note that due to prediction, in multiplayer SWEP:PrimaryAttack is called multiple times per one "shot" with the gun. To work around that, use Global.IsFirstTimePredicted.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L42-L60)
    PrimaryAttack: function()

    --- A convenience function that draws the weapon info box, used in WEAPON:DrawWeaponSelection.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/cl_init.lua#L63-L89)
    -- @param x --- The x co-ordinate of box position
    -- @param y --- The y co-ordinate of box position
    -- @param alpha --- Alpha value for the box
    PrintWeaponInfo: function(x: number, y: number, alpha: number)

    --- Called when the reload key ( +reload ) is pressed.
    Reload: function()

    --- Called every frame just before GM:RenderScene.
    --- Used by the Tool Gun to render view model screens (TOOL:DrawToolScreen).
    --- **NOTE**: Materials rendered in this hook require $ignorez parameter to draw properly.
    RenderScreen: function()

    --- Called when secondary attack button ( +attack2 ) is pressed.
    --- For issues with this hook being called rapidly on the client side, see the global function Global.IsFirstTimePredicted.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L66-L84)
    SecondaryAttack: function()

    --- Called when the SWEP should set up its  Data Tables.
    SetupDataTables: function()

    --- Sets the hold type of the weapon. This must be called on **both** the server and the client to work properly.
    --- **NOTE:** You should avoid calling this function and call Weapon:SetHoldType now.
    -- @param name --- Name of the hold type. You can find all default hold types here
    SetWeaponHoldType: function(name: string)

    --- A convenient function to shoot bullets.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L132-L148)
    -- @param damage --- The damage of the bullet
    -- @param num_bullets --- Amount of bullets to shoot
    -- @param aimcone --- Spread of bullets
    -- @param ammo_type --- Ammo type of the bullets
    -- @param force --- Force of the bullets
    -- @param tracer --- Show a tracer on every x bullets
    ShootBullet: function(damage: number, num_bullets: number, aimcone: number, ammo_type: string, force: number, tracer: number)

    --- A convenience function to create shoot effects.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L122-L130)
    ShootEffects: function()

    --- Called to determine if the view model should be drawn or not.
    -- @return --- Return true to draw the view model, false otherwise.
    ShouldDrawViewModel: function(): boolean

    --- Should this weapon be dropped when its owner dies?
    --- This only works if the player has Player:ShouldDropWeapon set to true.
    -- @return --- Return true to drop the weapon, false otherwise. Default ( if you don't return anything ) is false.
    ShouldDropOnDie: function(): boolean

    --- A convenience function to remove primary ammo from clip.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L162-L175)
    -- @param amount --- Amount of primary ammo to remove
    TakePrimaryAmmo: function(amount: number)

    --- A convenience function to remove secondary ammo from clip.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/weapons/weapon_base/shared.lua#L181-L194)
    -- @param amount --- How much of secondary ammo to remove
    TakeSecondaryAmmo: function(amount: number)

    --- Called when the weapon thinks.
    --- This hook won't be called during the deploy animation and when using Weapon:DefaultReload.
    --- Despite being a predicted hook, this hook is called clientside in single player (for your convenience), however it will not be recognized as a predicted hook via Player:GetCurrentCommand, and will run more often in this case.
    --- This hook will be called before Player movement is processed on the client, and after on the server.
    --- **NOTE**: This hook only runs while the weapon is in players hands. It does not run while it is carried by an NPC.
    --- **BUG**: [This will not be run during deploy animations after a serverside-only deploy. This usually happens after picking up and dropping an object with +use.](https://github.com/Facepunch/garrysmod-issues/issues/2855
    Think: function()

    --- @deprecated
    --- **DEPRECATED**: Use Weapon:Think instead.
    --- Alias of Weapon:Think.
    Tick: function()

    --- Translate a generic activity into a more specific activity, such as holdtype-specific activities.
    --- The translated activity is then used to request animations from the owner's model via Entity:SelectWeightedSequence and similar functions.
    --- For example, `ACT_MP_RUN` becomes `ACT_HL2MP_RUN_PISTOL`.
    -- @param act --- The activity to translate
    -- @return act --- The translated activity
    TranslateActivity: function(act: E_ACT): E_ACT

    --- Allows to change players field of view while player holds the weapon.
    --- **NOTE**: This hook must be defined shared and return same value on both to properly affect Area Portals.
    -- @param fov --- The current/default FOV.
    -- @return --- The target FOV.
    TranslateFOV: function(fov: number): number

    --- Called straight after the view model has been drawn. This is called before GM:PostDrawViewModel and WEAPON:PostDrawViewModel.
    -- @param ViewModel --- Players view model
    -- @param flags --- The STUDIO_ flags for this render operation.
    ViewModelDrawn: function(ViewModel: GEntity, flags: number)
end
--- Used by Entity:GetSequenceInfo.
global record S_SequenceInfo
    --- Name of the sequence.
    label: string

    --- Name of the activity this sequence is attached to.
    activityname: string

    --- The activity ID associated with this sequence. See Enums/ACT.
    activity: E_ACT

    --- How likely this sequence is to be picked when playing an activity its attached to. -1 means this is the only sequence for that activity. (needs validation)
    actweight: number

    --- The looping and other flags of this sequence, see [flags here](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/public/studio.h#L3078).
    flags: number

    --- Number of animation events this sequence has.
    numevents: number

    numblends: number

    --- Mins part of the bounding box for this sequence
    bbmin: GVector

    --- Maxs part of the bounding box for this sequence
    bbmax: GVector

    --- ideal cross fade in time (0.2 default)
    fadeintime: number

    --- ideal cross fade out time (0.2 default)
    fadeouttime: number

    --- transition node at entry
    localentrynode: number

    --- transition node at exit
    localexitnode: number

    --- Transition rules
    nodeflags: number

    --- Frame that should generate EndOFSequence
    lastframe: number

    --- If non 0, the next sequence for auto advancing sequences
    nextseq: number

    pose: number

    --- If non 0, index of pose parameter to be used as cycle index. This means that the sequence playback will be controlled by a pose parameter.
    cycleposeindex: number

    --- A 1-based array of all animationIDs associated with this sequence. For use with Entity:GetAnimInfo.
    anims: {number}

end
--- Used for serverlist.Query.
global record S_ServerQueryData
    --- The game directory to get the servers for
    GameDir: string

    --- Type of servers to retrieve. Valid values are `internet`, `favorite`, `history` and `lan`
    Type: string

    --- Steam application ID to get the servers for
    AppID: number

    --- Called when a new server is found and queried.
    --- <callback>
    --- <arg type="number" name="ping">Latency to the server.</arg>
    --- <arg type="string" name="name">Name of the server</arg>
    --- <arg type="string" name="desc">"Nice" gamemode name</arg>
    --- <arg type="string" name="map">Current map</arg>
    --- <arg type="number" name="players">Total player number ( bot + human )</arg>
    --- <arg type="number" name="maxplayers">Maximum reported amount of players</arg>
    --- <arg type="number" name="botplayers">Amount of bots on the server</arg>
    --- <arg type="boolean" name="pass">Whether this server has password or not</arg>
    --- <arg type="number" name="lastplayed">Time when you last played on this server, as UNIX timestamp or 0</arg>
    --- <arg type="string" name="address">IP Address of the server</arg>
    --- <arg type="string" name="gamemode">Gamemode folder name</arg>
    --- <arg type="number" name="workshopid">Gamemode Steam Workshop ID</arg>
    --- <arg type="boolean" name="isanon">Is the server signed into an anonymous account?</arg>
    --- <arg type="string" name="version">Version number, same format as jit.version_num</arg>
    --- <arg type="string" name="localization">Two digit country code, `us` if nil</arg>
    --- <arg type="string" name="gmcategory">Category of the gamemode, ex. `pvp`, `pve`, `rp` or `roleplay`</arg>
    --- <ret type="boolean" name="stop">Return `false` to stop the query.</ret>
    --- </callback>
    Callback: function

    --- Called if the query has failed, called with the servers IP Address
    CallbackFailed: function

    --- Called when the query is finished. No arguments
    Finished: function

end
--- Table used by PhysObj:ComputeShadowControl. Default values are given if the table element is omitted.
global record S_ShadowControlParams
    --- How long it takes to move to the set pos and angle. Limited by max speed/damping.
    --- **WARNING**: Cannot be 0! Will give errors if you do.
    secondstoarrive: number

    --- The time it should use - just use the one from ENTITY:PhysicsSimulate.
    delta: number

    --- Where you want to move to.
    pos: GVector

    --- Angle you want to move to.
    angle: GAngle

    --- What should be the maximal angular force applied.
    maxangular: number

    --- At which force/speed should it start damping the rotation.
    maxangulardamp: number

    --- Maximum linear force applied
    maxspeed: number

    --- Maximum linear force/speed before damping.
    maxspeeddamp: number

    --- The percentage it should damp the linear/angular force if it reaches it's max amount
    dampfactor: number

    --- If it's further away than this it'll teleport (Set to 0 to not teleport)
    teleportdistance: number

end
--- Table used in sound.Add and sound.GetProperties.
global record S_SoundData
    --- Path to the sound file to be used in this sound effect, relative to `sound/` directory (so exclude the `sound/` part).
    --- Can be a table of sound files, in which case the sound will be chosen randomly every time from the provided list.
    --- Each sound path can be prepended with a special character for special effects. You can learn more about this [here](https://developer.valvesoftware.com/wiki/Soundscripts#Sound_Characters).
    sound: string

    --- The name of the soundscript, to be referenced by in functions such as Entity:EmitSound.
    name: string

    --- The sound channel to play in. See Enums/CHAN
    channel: E_CHAN

    --- The soundlevel of the sound in dB. See Enums/SNDLVL. This will affect how far the sound can be heard.
    level: E_SNDLVL

    --- The volume of the sound as a decimal between `0` and `1`. Can be a table of two numbers, a minimum and a maximum value.
    --- **Warning:** Volume of `0` will act as volume of `1`
    volume: number

    --- The pitch of the sound. Can be a table of two numbers, a minimum and a maximum value.
    pitch: number|{number}

    --- The initial pitch.
    --- @deprecated
    --- **DEPRECATED**: Use pitch instead.
    pitchstart: number

    --- The pitch end.
    --- @deprecated
    --- **DEPRECATED**: Use pitch instead.
    pitchend: number

end
--- Table describing a sound hint, used by NPC:GetBestSoundHint and sound.GetLoudestSoundHint.
global record S_SoundHintData
    --- Origin of the sound hint
    origin: GVector

    --- Owner of the sound hint, if any (emitting entity, like a thumper)
    owner: GEntity

    --- Target of the sound hint, if any
    target: GEntity

    --- Volume of the sound hint
    volume: number

    --- SOUND_ enums
    type: E_SOUND

    --- CurTime based expiration date
    expiration: number

    --- Does this sound hint expire?
    expires: boolean

    --- CHAN_ enums
    channel: E_CHAN

end
--- Returned by util.GetSunInfo.
global record S_SunInfo
    --- The sun's direction relative to 0,0,0.
    direction: GVector

    --- Indicates how obstructed the sun is, 1 not visible, 0 fully visible.
    obstruction: number

    --- Color of sun's overlay in `0`-`255` range as Color structure.
    overlayColor: S_Color

    --- The sun's overlay name of material. For example: `sprites/light_glow02_add_noz.vmt`.
    overlayMaterial: string

    --- Size of sun's overlay.
    overlaySize: number

    --- Color of sun in `0`-`255` range as Color structure.
    sunColor: S_Color

    --- The sun's name of material.
    sunMaterial: string

    --- Size of sun.
    sunSize: number

    --- State of sun.
    enabled: boolean

end
--- Table returned by util.GetSurfaceData.
global record S_SurfacePropertyData
    --- The name of the surface property, identical to util.GetSurfacePropName.
    name: string

    --- How hard a surface is. If this is greater than or equal to another surfaces's hardThreshold, a hard impact sound will be used.
    hardnessFactor: number

    --- Hardness threshold for impact sounds. HitSurface.hardnessFactor >= InflictorSurface.hardThreshold - hard impact sound (depends on hardVelocityThreshold's value), HitSurface.hardnessFactor < InflictorSurface.hardThreshold - soft impact sound (always).
    hardThreshold: number

    --- Velocity threshold for impact sounds. impactSpeed >= HitSurface.hardVelocityThreshold - hard impact sound (depends on hardThreshold's value), impactSpeed < HitSurface.hardVelocityThreshold - soft impact sound (always).
    hardVelocityThreshold: number

    --- Amount of sound reflected from the surface represented as a number 0.0 - 1.0. 0 - no reflection, 1 - fully reflected.
    reflectivity: number

    --- How rough a surface is. If this is greater than or equal to another surfaces's roughThreshold, a rough scrape sound will be used.
    roughnessFactor: number

    --- Roughness threshold for friction sounds. HitSurface.roughnessFactor >= InflictorSurface.roughThreshold - rough friction sound, HitSurface.roughnessFactor < InflictorSurface.roughThreshold - soft friction sound.
    roughThreshold: number

    --- Indicates whether or not the surface is a ladder. Used to detect whether a player is on a ladder. 0 - false, > 0 - true.
    climbable: number

    --- Scalar multiplier for player jump height - or more accurately, applied z-axis velocity on a surface. For example, 1 - normal jump, 2 - twice as high, and 0.5 - half as high.
    jumpFactor: number

    --- The surface material. See Enums/MAT.
    material: E_MAT

    --- Scalar multiplier for player speed. Achieves this by multiplying CMoveData:SetMaxSpeed in GM:Move.
    maxSpeedFactor: number

    --- This is the physical drag on an object when in contact with this surface (0 - x, 0 none to x a lot).
    dampening: number

    --- Material density in kg / m^3 (water is 1000). If a surface's density is < 1000, it will float in water. This is used to calculate the total mass of an object.
    density: number

    --- Collision elasticity - used to compute coefficient of restitution represented as a number 0.0 - 1.0. 0.01 is soft, 1.0 is hard.
    elasticity: number

    --- Physical friction used to slow entities touching the surface represented as a number 0.0 - 1.0. 0.01 is slick, 1.0 is completely rough.
    friction: number

    --- Material thickness. If this is 0, the material is not volumetrically solid, and thus the object mass will be calculated as "volume * 0.0254^3 * density" where 0.0254 is meters per inch. If non-zero, the mass will be "surfacearea * thickness * 0.0254^3 * density".
    thickness: number

    --- Sound to play when a prop or func_breakable is broken.
    breakSound: string

    --- Bullet impact sound with this surface.
    bulletImpactSound: string

    --- Physical impact sound when hitting surfaces hard.
    impactHardSound: string

    --- Physical impact sound when hitting surfaces softly.
    impactSoftSound: string

    --- Unused sound.
    rollingSound: string

    --- Friction sound when roughly scraping against an entity.
    scrapeRoughSound: string

    --- Friction sound when smoothly scraping against an entity.
    scrapeSmoothSound: string

    --- Footstep sound for left foot.
    stepLeftSound: string

    --- Footstep sound for right foot.
    stepRightSound: string

    --- Unused sound.
    strainSound: string

end
--- The **TOOL** table is used in Sandbox tool creation. You can find a list of callbacks on the  page and a list of methods on the  page. Do note that some of the fields below have no effect on server-side operations.
--- The tool information box drawn on the HUD while your tool is selected has 2 values that are set by language.Add.
--- * `tool.[tool mode].name` - The tool name (Note this is NOT the same as TOOL.Name)
--- * `tool.[tool mode].desc` - The tool description
--- Ensure that all tool file names are entirely lowercase.  Including capital letters can lead to unintended behavior.
global record S_TOOL is GWeapon
    --- If set to false, the tool won't be added to the tool menu and players will have to access it by other means.
    AddToMenu: boolean

    --- The tool menu category under which the tool should be listed.
    Category: string

    --- The console command to execute upon being selected in the Q menu.
    Command: string

    --- The name of the tool in the Q menu.
    --- Common practice is to set this to "#tool.[lua filename].name" to match the name displayed in the tool information box.
    Name: string

    --- A key-value ( convar name-default value ) table containing the client-side convars to create. All convars will be prefixed with the filename of the tool.
    --- You can later use Tool:GetClientNumber or Tool:GetClientInfo to retrieve these values.
    ClientConVar: table

    --- Same as above, but created server-side instead.
    ServerConVar: table

    --- A key-value ( string name - ConVar object ) table containing the cached convar objected created from `ClientConVar`.
    ClientConVars: table

    --- Same as above, but server-side (`ServerConVar`) instead.
    ServerConVars: table

    --- The function that is called to build the context menu for your tool. It has one argument, namely the context menu's base panel to which all of your custom panels are going to be parented to.
    --- While it might sound like a hook, it isn't - you won't receive a `self` argument inside the function. See TOOL.BuildCPanel.
    BuildCPanel: function

    --- Allows you to override the tool usage information shown when the tool is equipped.
    --- See Tool Information Display for more information.
    Information: table

    --- Class name of the tool. (name of the .lua file)
    --- This is set automatically.
    Mode: string

    --- The tool tab (spawnmenu.AddToolTab) to add this tool to. (The internal name, first argument)
    Tab: string

    --- When enabled the game tries to run the left mouse click as soon as possible
    LeftClickAutomatic: boolean

    --- When enabled the game tries to run the right mouse click as soon as possible
    RightClickAutomatic: boolean
    --- Called when the tool's control panel needs to be rebuilt.
    --- **WARNING**: Due to historical reasons, this hook does not provide the tool object as `self`! See examples.
    -- @param cpanel --- The DForm control panel to add settings to.
    BuildCPanel: function(cpanel: GPanel)

    --- Called when WEAPON:Deploy of the toolgun is called.
    --- This is also called when switching from another tool on the server.
    -- @return --- Return true to allow switching away from the toolgun using lastinv command
    Deploy: function(): boolean

    --- Called when WEAPON:DrawHUD of the toolgun is called, only when the user has this tool selected.
    DrawHUD: function()

    --- Called after the default tool screen has been drawn from WEAPON:RenderScreen.
    --- **NOTE**: If this method exists on the TOOL object table, the default scrolling text will not be drawn
    --- **NOTE**: Materials rendered in this hook require $ignorez parameter to draw properly.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/cl_viewscreen.lua#L67-L69)
    -- @param width --- The width of the tool's screen in pixels.
    -- @param height --- The height of the tool's screen in pixels.
    DrawToolScreen: function(width: number, height: number)

    --- Called when WEAPON:Think of the toolgun is called, only when the user has this tool selected.
    -- @return --- Return true to freeze the player
    FreezeMovement: function(): boolean

    --- Called when WEAPON:Holster of the toolgun is called, when switching between different toolguns.
    Holster: function()

    --- Called when the user left clicks with the tool.
    -- @param tr --- A trace from user's eyes to wherever they aim at. See Structures/TraceResult
    -- @return --- Return `true` to draw the tool gun beam and play fire animations, `false` otherwise.
    LeftClick: function(tr: table): boolean

    --- Called when the user presses the reload key with the tool out.
    -- @param tr --- A trace from user's eyes to wherever they aim at. See Structures/TraceResult
    -- @return --- Return `true` to draw the tool gun beam and play fire animations, `false` otherwise
    Reload: function(tr: table): boolean

    --- Called when the user right clicks with the tool.
    -- @param tr --- A trace from user's eyes to wherever they aim at. See Structures/TraceResult
    -- @return --- Return `true` to draw the tool gun beam and play fire animations, `false` otherwise
    RightClick: function(tr: table): boolean

    --- Called when WEAPON:Think of the toolgun is called. This only happens when the tool gun is currently equipped/selected by the player and the selected tool is this tool.
    Think: function()
end
--- Table is one element from team.GetAllTeams.
global record S_TeamData
    --- Color of the team
    Color: GColor

    --- Whether the team is joinable or not.
    Joinable: boolean

    --- Name of the team
    Name: string

    --- Score of the team
    Score: number

end
--- Used for draw.Text.
global record S_TextData
    --- Text to be drawn.
    text: string

    --- The font to draw with. List of default fonts can be found here.
    font: string

    --- This holds the X and Y coordinates. Key value 1 is x, key value 2 is y.
    pos: table

    --- The alignment of the X position. See Enums/TEXT_ALIGN
    xalign: E_TEXT_ALIGN

    --- The alignment of the Y position. See Enums/TEXT_ALIGN
    yalign: E_TEXT_ALIGN

    --- The text color
    color: GColor

end
--- Used for draw.TexturedQuad.
global record S_TextureData
    --- surface.GetTextureID number of the texture to be drawn.
    texture: number

    --- The x Coordinate.
    x: number

    --- The y Coordinate.
    y: number

    --- The width of the texture.
    w: number

    --- The height of the texture.
    h: number

    --- The texture color. See Color.
    color: GColor

end
--- Table returned by Vector:ToScreen.
global record S_ToScreenData
    --- The x coordinate on the players screen
    x: number

    --- The y coordinate on the players screen
    y: number

    --- The coordinate is not behind the player. **This does not mean the coordinate is on the screen.** When this is false, it means that the coordinate would not be on the screen even if the player had a full 180 degree FOV.
    visible: boolean

end
--- Table structure used for util.TraceLine.
global record S_Trace
    --- The start position of the trace
    start: GVector

    --- The end position of the trace
    endpos: GVector

    --- Things the trace should not hit. Can be an entity, a table of entities, a table of entity classes or a function:
    --- <callback>
    --- <arg type="Entity" name="ent">The entity that the trace hit</arg>
    --- <ret type="boolean">Return `true` to hit the entity, `false` to skip it.</ret>
    --- </callback>
    --- Using a function here is super slow. Try to avoid it.
    --filter: GEntity|{GEntity}|{string}|function

    --- The trace mask Enums/MASK. This determines what the trace should hit and what it shouldn't hit. A mask is a combination of Enums/CONTENTS - you can use these for more advanced masks.
    mask: E_MASK

    --- The collision group Enums/COLLISION_GROUP. This determines what the trace should hit in regards to the entity's collision group.
    collisiongroup: E_COLLISION_GROUP

    --- Should the trace ignore world or not
    ignoreworld: boolean

    --- If set, the trace result will be written to the supplied table instead of returning a new table
    output: S_TraceResult

    --- Turns the `filter` field into a whitelist, if it is a table.
    whitelist: boolean

    --- Enables traces to hit clientside only entities. Keep in mind that most naturally spawned entities are classified as debris, so extra `mask` values might be required.
    hitclientonly: boolean

end
--- Table structure used as trace result. Default values are when the trace hits nothing.
--- See util.TraceLine and util.TraceHull.
global record S_TraceResult
    --- The entity hit by the trace.
    Entity: GEntity

    --- This indicates the how much of your trace length was used from 0-1 (resultLength/originalLength).
    Fraction: number

    --- Given the trace started in a solid enviroment, this will return at what distance the trace left the solid from 0-1. Doesn't work if the trace hit a non-worldspawn entity.
    FractionLeftSolid: number

    --- Indicates whether the trace hit something.
    Hit: boolean

    --- The ID of the hitbox hit by the trace.
    HitBox: number

    --- Enums/HITGROUP describing what hitgroup the trace hit (not the same as HitBox).
    HitGroup: E_HITGROUP

    --- Indicates whenever the trace hit a no-draw brush.
    HitNoDraw: boolean

    --- Indicates whenever the trace did not hit the world.
    HitNonWorld: boolean

    --- The direction of the surface that was hit as a normal vector (vector with length of 1).
    HitNormal: GVector

    --- The position the trace stopped. This will be the provided endpos if the trace hit nothing.
    HitPos: GVector

    --- Indicates whenever the trace hit the sky.
    HitSky: boolean

    --- The surface material (not texture) of whatever the trace hit. Will be `**displacement**` if the trace hit a displacement, and `**studio**` if it hit a prop.
    HitTexture: string

    --- Indicates whenever the trace hit the world.
    HitWorld: boolean

    --- Enums/MAT of the material hit by the trace.
    MatType: E_MAT

    --- The direction of the trace as a normal vector (vector with length of 1).
    --- Equivalent to: `( traceRes.HitPos - traceRes.StartPos ):Normalize()`
    Normal: GVector

    --- The PhysObj ID that was hit.
    --- Used for Entity:GetPhysicsObjectNum.
    PhysicsBone: number

    --- The origin of the trace. Will match the provided startpos.
    StartPos: GVector

    --- ID of hit surface property from `scripts/surfaceproperties.txt`.
    --- You can get the name using util.GetSurfacePropName.
    --- Used for CEffectData:SetSurfaceProp.
    SurfaceProps: number

    --- Indicates whenever the trace started in a solid enviroment.
    StartSolid: boolean

    --- True if the entire trace is inside a solid.
    AllSolid: boolean

    --- The surface flags of the hit surface. See Enums/SURF.
    SurfaceFlags: E_SURF

    --- The displacement flags of the hit surface. See Enums/DISPSURF.
    DispFlags: E_DISPSURF

    --- The contents of the hit surface. See Enums/CONTENTS.
    Contents: E_CONTENTS

    --- BoneID on the model that the hit hitbox is attached to, if available.
    HitBoxBone: number

end
--- Table structure used by steamworks.FileInfo.
global record S_UGCFileInfo
    --- The Workshop item ID
    id: number

    --- The title of the Workshop item
    title: string

    --- The description of the Workshop item
    description: string

    --- The internal File ID of the workshop item, if any
    fileid: number

    --- The internal File ID of the workshop item preview, if any
    previewid: number

    --- A URL to the preview image of the workshop item
    previewurl: string

    --- The SteamID64 of the original uploader of the addon
    owner: number

    --- Unix timestamp of when the item was created
    created: number

    --- Unix timestamp of when the file was last updated
    updated: number

    --- Whether the file is banned or not
    banned: boolean

    --- Comma (,) separated list of tags, may be truncated to some length
    tags: string

    --- File size of the workshop item contents in bytes
    size: number

    --- Filesize of the preview file in bytes
    previewsize: number

    --- If the addon is subscribed, this value represents whether it is installed on the client and its files are accessible, false otherwise.
    installed: boolean

    --- If the addon is subscribed, this value represents whether it is disabled on the client, false otherwise.
    disabled: boolean

    --- A list of child Workshop Items for this item.
    --- For collections this will be sub-collections, for workshop items this will be the items they depend on.
    children: table

    --- **WARNING**: We advise against using this. It may be changed or removed in a future update.
    --- The "nice" name of the Uploader, or "Unnammed Player" if we failed to get the data for some reason.
    --- Do not use this field as it will most likely not be updated in time. Use steamworks.RequestPlayerInfo instead.
    ownername: string

    --- If this key is set, no other data will be present in the response.
    --- Values above 0 represent Steam Error codes (https://steamerrors.com/), values below 0 mean the following:
    --- * -1 means Failed to create query
    --- * -2 means Failed to send query
    --- * -3 means Received 0 or more than 1 result
    --- * -4 means Failed to get item data from the response
    --- * -5 means Workshop item ID in the response is invalid
    --- * -6 means Workshop item ID in response is mismatching the requested file ID
    error: number

    --- Number of "up" votes for this item.
    up: number

    --- Number of "down" votes for this item.
    down: number

    --- Number of total votes (up and down) for this item. This is NOT `up - down`.
    total: number

    --- The up down vote ratio for this item, i.e. `1` is when every vote is `up`, `0.5` is when half of the total votes are the up votes, etc.
    score: number

    --- A list of Steam content descriptiors for this Steam Workshop item.
    --- Possible values are:
    --- * `general_mature`
    --- * `gore`
    --- * `suggestive`
    --- * `nudity`
    --- * `adult_only`
    content_descriptors: {string}

end
--- Table structure used by undo.Do_Undo and GM:CanUndo.
global record S_Undo
    --- The player responsible who owns the undo
    Owner: GPlayer

    --- The name of the text to report to the player
    Name: string

    --- A table of entities to be removed by the undo
    Entities: {GEntity}

    --- A table of {function_to_call, func_arg2, func_arg3}
    Functions: {table}

    --- A custom undo text to show the client
    CustomUndoText: string

    --- A "nice" name of the undo, which will be used for the UI
    NiceText: string

end
--- The structure used by Vehicle:SetVehicleParams and Vehicle:GetVehicleParams.
global record S_VehicleParams
    --- Wheels per axle
    wheelsPerAxle: number

    --- Number of axles
    axleCount: number

    --- A table of Structures/VehicleParamsAxle tables.
    axles: S_VehicleParamsAxle

    --- See Structures/VehicleParamsBody
    body: S_VehicleParamsBody

    --- See Structures/VehicleParamsEngine
    engine: S_VehicleParamsEngine

    --- See Structures/VehicleParamsSteering
    steering: S_VehicleParamsSteering

end
--- The structure used by Structures/VehicleParams.
global record S_VehicleParamsAxle
    brakeFactor: number

    offset: GVector

    raytraceCenterOffset: GVector

    raytraceOffset: GVector

    suspension_maxBodyForce: number

    suspension_springConstant: number

    suspension_springDamping: number

    suspension_springDampingCompression: number

    suspension_stabilizerConstant: number

    torqueFactor: number

    wheelOffset: GVector

    --- Material index of braking material of the wheels. Upon braking, the wheels will be set to this material.
    wheels_brakeMaterialIndex: number

    wheels_damping: number

    wheels_frictionScale: number

    wheels_inertia: number

    --- Mass of each wheel.
    wheels_mass: number

    --- Material index of the wheels by default.
    wheels_materialIndex: number

    --- Radius of the wheels.
    wheels_radius: number

    wheels_rotdamping: number

    --- Material index of skid material of the wheels. Upon skidding ( pressing Space and sliding the vehicle ), the wheels will be set to this material.
    wheels_skidMaterialIndex: number

    wheels_springAdditionalLength: number

end
--- The structure used by Structures/VehicleParams.
global record S_VehicleParamsBody
    --- Additional gravity to be applied to the vehicle
    addGravity: number

    counterTorqueFactor: number

    keepUprightTorque: number

    --- Mass center override
    massCenterOverride: GVector

    --- Mass override
    massOverride: number

    --- Maximum angular velocity
    maxAngularVelocity: number

    tiltForce: number

    tiltForceHeight: number

end
--- The structure used by Structures/VehicleParams.
global record S_VehicleParamsEngine
    autobrakeSpeedFactor: number

    autobrakeSpeedGain: number

    --- This acts as the final ratio of the gearbox.
    --- It's like a master coefficient of the gearbox.
    axleRatio: number

    --- Amount of seconds between being able to use the boost ( by pressing Shift key by default )
    boostDelay: number

    --- Duration of the boost in seconds
    boostDuration: number

    boostForce: number

    --- Maximum speed while boosting
    --- **WARNING**: The Vehicle:SetVehicleParams function takes this in **miles per hour**, but Vehicle:GetVehicleParams returns this in **hammer units per second**!
    --- In this case HU = inches, so 1 MPH is 17.6 HU/s.
    boostMaxSpeed: number

    --- Amount of gears this vehicle has.
    gearCount: number

    --- A table of numbers, of gear rations.
    --- Table length is equal to "gearCount" member of this table.
    gearRatio: table

    --- The HP amount of the vehicle
    --- This value is used to calculate the effectively applied torque, along with ratios and `maxRPM`.
    horsepower: number

    --- If `true`, the gearbox shifts gears, if `false` the gearbox stays stuck to the 1st gear (gear number 0).
    isAutoTransmission: boolean

    --- Maximum RPM of the vehicle.
    --- Despite this being a maximum value, the vehicle can exceed it.
    --- **WARNING**: Attempts to exceed the max RPM will force the active gear ratio to be that of the 1st gear, which will provide even more torque. This is the opposite of a rev limiter. This value is only used for the calculation of the effectively applied torque.
    maxRPM: number

    --- Maximum reverse speed of the vehicle
    --- **WARNING**: The Vehicle:SetVehicleParams function takes this in **miles per hour**, but Vehicle:GetVehicleParams returns this in **hammer units per second**!
    --- In this case HU = inches, so 1 MPH is 17.6 HU/s.
    maxRevSpeed: number

    --- Maximum forward going speed of the vehicle without boosting
    --- **WARNING**: The Vehicle:SetVehicleParams function takes this in **miles per hour**, but Vehicle:GetVehicleParams returns this in **hammer units per second**!
    --- In this case HU = inches, so 1 MPH is 17.6 HU/s.
    maxSpeed: number

    --- Amount of RPM to automatically shift one gear down
    shiftDownRPM: number

    --- Amount of RPM to automatically shift one gear up
    shiftUpRPM: number

    throttleTime: number

    torqueBoost: boolean

end
--- The structure used by Structures/VehicleParams.
global record S_VehicleParamsSteering
    boostSteeringRateFactor: number

    boostSteeringRestRateFactor: number

    brakeSteeringRateFactor: number

    --- The maximum angle at which the vehicle can turn while boosting
    degreesBoost: number

    --- The maximum angle at which the vehicle can turn while moving at max speed and not boosting
    degreesFast: number

    --- The maximum angle at which the vehicle can turn while moving slowest
    degreesSlow: number

    --- Disabled in Garry's Mod. In Half-Life 2: Episode 2 this dictates whether the vehicle should leave wheel dust effects when driving around
    dustCloud: boolean

    --- Whether the vehicle is allowed to skid/drift
    isSkidAllowed: boolean

    --- In Hammer Units
    powerSlideAccel: number

    speedFast: number

    speedSlow: number

    steeringExponent: number

    steeringRateFast: number

    steeringRateSlow: number

    steeringRestRateFast: number

    steeringRestRateSlow: number

    throttleSteeringRestRateFactor: number

    turnThrottleReduceFast: number

    turnThrottleReduceSlow: number

end
--- Table structure passed to SANDBOX:PlayerSpawnVehicle, describing a spawnable Vehicle in Sandbox gamemode.
--- Example usage in defined a custom spawnable vehicle:
--- ```
--- list.Set( "Vehicles", "Jeep", {
--- -- Required information
--- Name = "Jeep",
--- Model = "models/buggy.mdl",
--- Class = "prop_vehicle_jeep_old",
--- Category = "Half-Life 2",
--- -- Optional information
--- Author = "VALVe",
--- Information = "The regular old jeep",
--- KeyValues = {
--- vehiclescript = "scripts/vehicles/jeep_test.txt"
--- }
--- } )
--- ```
global record S_VehicleTable
    --- Entity class name for this vehicle.
    Class: string

    --- Nice name for this vehicle, for UI purposes.
    Name: string

    --- Model of the vehicle.
    Model: string

    --- A list of key-value pairs to apply to the vehicle entity.
    --- Possible valid keys that can be set are:
    --- | Key | Description |
    --- |:-------:|:------------|
    --- | `vehiclescript` | The vehicle script files contained in scripts\vehicles\ define the behaviour and handling of a vehicle.
    --- | `limitview` | Limit vertical view of the vehicles to +/-70 degrees (90 for unlimited)
    --- | `vehiclelocked` | Players cannot enter vehicle until it is unlocked.
    --- | `cargovisible` | Is the Magnusson cargo hopper visible?
    --- | `EnableGun` | Whether the Tau Cannon is enabled or disabled. Doesn't work correctly with the Episode Two jalopy model.
    --- | `NoHazardLights`| Stops the jalopy's hazard lights from turning on and flashing when the player exits the vehicle.
    KeyValues: table

    --- Offset away the surface player is looking at to spawn at.
    Offset: number

    --- Set these members on the spawned vehicle's table (Entity:GetTable) to given values.
    Members: table

    --- Author of the vehicle, for UI purposes.
    Author: string

    --- Category of this vehicle, for UI purposes.
    Category: string

    --- A small description of the vehicle, for UI purposes.
    Information: string

end
--- Table structure used by video.Record.
global record S_VideoData
    --- The video container format.
    --- Valid options are: `webm`, `ogg`
    container: string

    --- The video codec.
    --- Valid options are: `vp8`, `theora`
    video: string

    --- The audio codec.
    --- Valid options are: `vorbis`
    audio: string

    --- The video quality
    quality: number

    --- The record bitrate
    bitrate: number

    --- Frames per second
    fps: number

    --- Lock the frame count per second
    lockfps: boolean

    --- The file name for the video
    name: string

    --- The videos width
    width: number

    --- The videos height
    height: number

end
--- Table structure used for render.RenderView.
--- Unless stated otherwise, the default values for all these keys would be inherited from the engine's CViewSetup and do not have static representations.
global record S_ViewData
    --- The view's original position
    origin: GVector

    --- The view's angles
    angles: GAngle

    --- Default width divided by height. Has a deprecated alias `aspectratio`.
    aspect: number

    --- The x position of the viewport to render in
    x: number

    --- The y position of the viewport to render in
    y: number

    --- The width of the viewport to render in
    w: number

    --- The height of the viewport to render in
    h: number

    --- Draw the HUD and call the hud painting related hooks
    drawhud: boolean

    --- Draw monitors
    drawmonitors: boolean

    --- The weapon's viewmodel
    drawviewmodel: boolean

    --- Whether to force draw the local player or not.
    drawviewer: boolean

    --- The viewmodel's FOV
    viewmodelfov: number

    --- The main view's FOV
    fov: number

    --- If set, renders the view orthogonally. A table with these keys:
    --- * left
    --- * right
    --- * top
    --- * bottom
    ortho: table

    --- Coordinate for the left clipping plane. Requires `ortho` to be set to `true`.
    --- **Deprecated**: Use `ortho` table instead!
    ortholeft: number

    --- Coordinate for the right clipping plane. Requires `ortho` to be set to `true`.
    --- **Deprecated**: Use `ortho` table instead!
    orthoright: number

    --- Coordinate for the top clipping plane. Requires `ortho` to be set to `true`.
    --- **Deprecated**: Use `ortho` table instead!
    orthotop: number

    --- Coordinate for the bottom clipping plane. Requires `ortho` to be set to `true`.
    --- **Deprecated**: Use `ortho` table instead!
    orthobottom: number

    --- The distance of the view's origin to the near clipping plane
    znear: number

    --- The distance of the view's origin to the far clipping plane
    zfar: number

    --- The distance of the view's origin to the near clipping plane for the viewmodel
    znearviewmodel: number

    --- The distance of the view's origin to the far clipping plane for the viewmodel
    zfarviewmodel: number

    --- Currently works identically to the "bloomtone" option (it also overrides it if you set this to false).
    dopostprocess: boolean

    --- Disables default engine bloom and pauses the "brightness changes" on HDR maps.
    bloomtone: boolean

    --- This is identifying which logical part of the scene an entity is being redered in, see Enums/VIEW.
    viewid: E_VIEW

    --- This allows you to "zoom in" on a part of the screen - for example, the top-left quarter of the screen. This is similar to how [poster splits the screen](https://garry.blog/poster-screenshots/) into separate renders.
    --- It's a table with 4 keys, controlling what portion of the screen to draw:
    --- * left - where the left edge starts. Natural value is 0.
    --- * right - where the right edge ends. Natural value is equal to w (the width of the viewport).
    --- * top - where the `bottom` edge starts. Natural value is 0.
    --- * bottom - where the `top` edge ends. Natural value is equal to h (the height of the viewport).
    --- Note that top and bottom are reversed.
    --- Values outside the viewport are allowed, but not recommended - instead you should increase the view FOV.
    offcenter: table

end
--- Table structure used for render.GetViewSetup.
global record S_ViewSetup
    --- The current view id. See Enums/VIEW.
    viewid: E_VIEW

    --- The view's origin/position
    origin: GVector

    --- The view's angles
    angles: GAngle

    --- Width divided by height
    aspect: number

    --- The x position of the viewport
    x: number

    --- The y position of the viewport
    y: number

    --- The width of the viewport
    width: number

    --- The height of the viewport
    height: number

    --- The main view's FOV, adjusted for aspect ratio.
    fov: number

    --- The main view's FOV as the user setting.
    fov_unscaled: number

    --- The viewmodel's FOV, adjusted for aspect ratio.
    fovviewmodel: number

    --- The viewmodel's FOV as the user setting.
    fovviewmodel_unscaled: number

    --- If the current view is orthogonal, a table with these keys:
    --- * left
    --- * right
    --- * top
    --- * bottom
    --- Will not be present if view is not orthagonal.
    ortho: table

    --- The distance of the view's origin to the near clipping plane
    znear: number

    --- The distance of the view's origin to the far clipping plane
    zfar: number

    --- The distance of the view's origin to the near clipping plane for the viewmodel
    znearviewmodel: number

    --- The distance of the view's origin to the far clipping plane for the viewmodel
    zfarviewmodel: number

    --- Whether default engine bloom and tonemapping are enabled at this instant for this view.
    bloomtone: boolean

    --- Whether `m_bRenderToSubrectOfLargerScreen` if set for this view.
    subrect: boolean

    --- It's a table with 4 keys, controlling what portion of the screen to draw:
    --- * left - where the left edge starts. Natural value is 0.
    --- * right - where the right edge ends. Natural value is equal to w (the width of the viewport).
    --- * top - where the `bottom` edge starts. Natural value is 0.
    --- * bottom - where the `top` edge ends. Natural value is equal to h (the height of the viewport).
    --- Note that top and bottom are reversed.
    --- This will not be present if offscreen rendering is not enabled for this view.
    --- See Structures/ViewData for more info.
    offcenter: table

end
--- A basic label or "single line text area" that is non-editable. You might be looking for DLabel, which uses this panel internally.
global interface VLabel is GPanel

end

--- A standard Derma text label. A lot of this panels functionality is a base for button elements, such as DButton
global interface DLabel is VLabel
    --- Called when the label is left clicked (on key release) by the player.
    --- This will be called after DLabel:OnDepressed and DLabel:OnReleased.
    --- This can be overridden; by default, it calls DLabel:Toggle.
    --- See also DLabel:DoRightClick, DLabel:DoMiddleClick and DLabel:DoDoubleClick.
    DoClick: function(self)

    --- Called just before DLabel:DoClick.
    --- In DLabel does nothing and is safe to override. Used by DMenuOption and DCollapsibleCategory's tabs.
    DoClickInternal: function(self)

    --- Called when the label is double clicked by the player with left clicks.
    --- DLabel:SetDoubleClickingEnabled must be set to true for this hook to work, which it is by default.
    --- This will be called after DLabel:OnDepressed and DLabel:OnReleased and DLabel:DoClick.
    --- See also DLabel:DoRightClick and DLabel:DoMiddleClick.
    DoDoubleClick: function(self)

    --- Called just before DLabel:DoDoubleClick. In DLabel does nothing and is safe to override.
    DoDoubleClickInternal: function(self)

    --- Called when the label is middle mouse (Mouse wheel, also known as mouse 3) clicked (on key release) by the player.
    --- This will be called after DLabel:OnDepressed and DLabel:OnReleased.
    --- See also DLabel:DoClick, DLabel:DoRightClick and DLabel:DoDoubleClick.
    DoMiddleClick: function(self)

    --- Called when the label is right clicked (on key release) by the player.
    --- This will be called after DLabel:OnDepressed and DLabel:OnReleased.
    --- See also DLabel:DoClick, DLabel:DoMiddleClick and DLabel:DoDoubleClick.
    DoRightClick: function(self)

    --- Returns whether the label stretches vertically or not.
    --- Set by DLabel:SetAutoStretchVertical.
    -- @return --- Whether the label stretches vertically or not.
    GetAutoStretchVertical: function(self): boolean

    --- Returns whether the DLabel should set its text color to the current skin's bright text color.
    --- See DLabel:SetBright.
    -- @return ---
    GetBright: function(self): boolean

    --- Returns the actual color of the text.
    --- See also DLabel:GetTextColor and DLabel:GetTextStyleColor.
    -- @return --- The the actual color of the text.
    GetColor: function(self): table

    --- Returns whether the DLabel should set its text color to the current skin's dark text color.
    --- See DLabel:SetDark.
    -- @return ---
    GetDark: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**: Use Panel:IsEnabled instead.
    --- Gets the disabled state of the DLabel. This is set with DLabel:SetDisabled.
    -- @return --- The disabled state of the label.
    GetDisabled: function(self): boolean

    --- Returns whether or not double clicking will call DLabel:DoDoubleClick.
    --- See DLabel:SetDoubleClickingEnabled.
    -- @return --- true = enabled, false means disabled
    GetDoubleClickingEnabled: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**: You should use DLabel:GetPaintBackground instead.
    --- Returns whether or not the panel background is being drawn. Alias of DLabel:GetPaintBackground.
    -- @return --- True if the panel background is drawn, false otherwise.
    GetDrawBackground: function(self): boolean

    --- Returns the current font of the DLabel. This is set with DLabel:SetFont.
    -- @return --- The name of the font in use.
    GetFont: function(self): string

    --- Returns whether the DLabel should set its text color to the current skin's highlighted text color.
    --- See DLabel:SetHighlight.
    -- @return ---
    GetHighlight: function(self): boolean

    --- Used internally by DComboBox.
    --- Returns whether the frame is part of a derma menu or not.
    --- If this is `true`, Global.CloseDermaMenus will not be called when the frame is clicked, and thus any open menus will remain open.
    -- @return isMenu --- Whether this panel is a Menu Component
    GetIsMenu: function(self): boolean

    --- Returns whether the toggle functionality is enabled for a label. Set with DLabel:SetIsToggle.
    -- @return --- Whether or not toggle functionality is enabled.
    GetIsToggle: function(self): boolean

    --- Returns whether or not the background should be painted.
    -- @return --- If the background is painted or not
    GetPaintBackground: function(self): boolean

    --- Returns the "override" text color, set by DLabel:SetTextColor.
    -- @return --- The color of the text, or nil.
    GetTextColor: function(self): table

    --- **INTERNAL**:
    --- Returns the "internal" or fallback color of the text.
    --- See also DLabel:GetTextColor and DLabel:SetTextStyleColor.
    -- @return --- The "internal" color of the text
    GetTextStyleColor: function(self): table

    --- Returns the current toggle state of the label. This can be set with DLabel:SetToggle and toggled with DLabel:Toggle.
    --- In order to use toggle functionality, you must first call DLabel:SetIsToggle with `true`, as it is disabled by default.
    -- @return --- The current toggle state.
    GetToggle: function(self): boolean

    --- Called when the player presses the label with any mouse button.
    --- This works as an alternative to PANEL:OnMousePressed as that hook is used heavily by DLabel and overriding it will break functionality.
    --- See also DLabel:DoClick, DLabel:DoMiddleClick, DLabel:DoRightClick, DLabel:OnReleased and DLabel:DoDoubleClick.
    OnDepressed: function(self)

    --- Called when the player releases any mouse button on the label. This is always called after DLabel:OnDepressed.
    --- This works as an alternative to PANEL:OnMouseReleased as that hook is used heavily by DLabel and overriding it will break functionality.
    --- See also DLabel:DoClick, DLabel:DoMiddleClick, DLabel:DoRightClick and DLabel:DoDoubleClick.
    OnReleased: function(self)

    --- Called when the toggle state of the label is changed by DLabel:Toggle.
    --- In order to use toggle functionality, you must first call DLabel:SetIsToggle with `true`, as it is disabled by default.
    -- @param toggleState --- The new toggle state.
    OnToggled: function(self, toggleState: boolean)

    --- Automatically adjusts the height of the label dependent of the height of the text inside of it.
    -- @param stretch --- Whenever to stretch the label vertically or not.
    SetAutoStretchVertical: function(self, stretch: boolean)

    --- Sets the color of the text to the bright text color defined in the skin.
    --- Disables DLabel:SetDark. Gets overridden by DLabel:SetHighlight.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use DLabel:SetTextColor.
    -- @param bright --- Whenever to set the text to bright or not.
    SetBright: function(self, bright: boolean)

    --- Changes color of label. Alias of DLabel:SetTextColor.
    -- @param color --- The color to set. Uses the Color structure.
    SetColor: function(self, color: table)

    --- Sets the color of the text to the dark text color defined in the skin.
    --- Disables DLabel:SetBright. Gets overridden by DLabel:SetHighlight.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use DLabel:SetTextColor.
    -- @param dark --- Whenever to set the text to dark or not.
    SetDark: function(self, dark: boolean)

    --- @deprecated
    --- **DEPRECATED**: Use Panel:SetEnabled instead.
    --- Sets the disabled state of the DLabel.
    --- When disabled, the label does not respond to click, toggle or drag & drop actions.
    -- @param disable --- `true` to disable the DLabel, `false` to enable it.
    SetDisabled: function(self, disable: boolean)

    --- Sets whether or not double clicking should call DLabel:DoDoubleClick.
    --- This is enabled by default.
    -- @param enable --- true to enable, false to disable
    SetDoubleClickingEnabled: function(self, enable: boolean)

    --- @deprecated
    --- **DEPRECATED**: You should use DLabel:SetPaintBackground instead.
    --- Sets whether or not to draw the panel background. Alias of DLabel:SetPaintBackground.
    -- @param draw --- True to show the panel's background, false to hide it.
    SetDrawBackground: function(self, draw: boolean)

    --- Sets the font of the label.
    -- @param fontName --- The name of the font.
    --- See here for a list of existing fonts.
    --- Alternatively, use surface.CreateFont to create your own custom font.
    SetFont: function(self, fontName: string)

    --- Sets the color of the text to the highlight text color defined in the skin.
    --- For the default Derma skin this makes the label red.
    --- Overrides colors set by both DLabel:SetBright and DLabel:SetDark while active.
    --- You should only consider using this if you are using background elements that are not manually painted and are using the skin colors. Otherwise use DLabel:SetTextColor.
    -- @param highlight --- true to set the label's color to skins's text highlight color, false otherwise.
    SetHighlight: function(self, highlight: boolean)

    --- Used internally by DComboBox.
    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, Global.CloseDermaMenus will not be called when the frame is clicked, and thus any open menus will remain open.
    -- @param isMenu --- Whether this pane is a Menu Component
    SetIsMenu: function(self, isMenu: boolean)

    --- Enables or disables toggle functionality for a label. Retrieved with DLabel:GetIsToggle.
    --- You must call this before using DLabel:SetToggle, DLabel:GetToggle or DLabel:Toggle.
    -- @param allowToggle --- Whether or not to enable toggle functionality.
    SetIsToggle: function(self, allowToggle: boolean)

    --- Sets whether or not the background should be painted. This is mainly used by derivative classes, such as DButton.
    -- @param paint ---
    SetPaintBackground: function(self, paint: boolean)

    --- Sets the text color of the DLabel. This will take precedence over DLabel:SetTextStyleColor.
    -- @param color --- The text color. Uses the Color.
    SetTextColor: function(self, color: table)

    --- **INTERNAL**: Use DLabel:SetTextColor instead!
    --- Used by DLabel:SetDark, DLabel:SetBright and DLabel:SetHighlight to set the text color without affecting DLabel:SetTextColor calls.
    -- @param color --- The text color. Uses the Color.
    SetTextStyleColor: function(self, color: table)

    --- Sets the toggle state of the label. This can be retrieved with DLabel:GetToggle and toggled with DLabel:Toggle.
    --- In order to use toggle functionality, you must first call DLabel:SetIsToggle with `true`, as it is disabled by default.
    -- @param toggleState --- The toggle state to be set.
    SetToggle: function(self, toggleState: boolean)

    --- Toggles the label's state. This can be set and retrieved with DLabel:SetToggle and DLabel:GetToggle.
    --- In order to use toggle functionality, you must first call DLabel:SetIsToggle with `true`, as it is disabled by default.
    Toggle: function(self)

    --- A hook called from within PANEL:ApplySchemeSettings to determine the color of the text on display.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dlabel.lua#L289-L279)
    -- @param skin --- A table supposed to contain the color values listed above.
    UpdateColours: function(self, skin: table)

    --- **INTERNAL**:
    --- Called internally to update the color of the text.
    UpdateFGColor: function(self)
end

--- A simple rectangular box, commonly used for parenting other elements to. Pretty much all elements are based on this.
global interface DPanel is GPanel
    --- Returns the panel's background color.
    --- **NOTE**: By default this returns **nil** even though the default background color is white
    -- @return --- Color of the panel's background.
    GetBackgroundColor: function(self): table

    --- Returns whether or not the panel is disabled.
    --- @deprecated
    --- **DEPRECATED**: Use Panel:IsEnabled.
    -- @return --- `true` if the panel is disabled (mouse input disabled and background alpha set to 75), `false` if its enabled (mouse input enabled and background alpha set to 255).
    GetDisabled: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**: You should use DPanel:GetPaintBackground instead.
    --- Returns whether or not the panel background is being drawn. Alias of DPanel:GetPaintBackground.
    -- @return --- True if the panel background is drawn, false otherwise.
    GetDrawBackground: function(self): boolean

    --- Used internally by DMenu.
    --- Returns whether the frame is part of a derma menu or not.
    --- If this is `true`, Global.CloseDermaMenus will not be called when the frame is clicked, and thus any open menus will remain open.
    -- @return isMenu --- Whether this panel is a Menu Component
    GetIsMenu: function(self): boolean

    --- Returns whether or not the panel background is being drawn.
    -- @return --- True if the panel background is drawn, false otherwise.
    GetPaintBackground: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing. Returns value set by DPanel:SetTabbingDisabled.
    -- @return draw ---
    GetTabbingDisabled: function(self): boolean

    --- Sets the background color of the panel.
    -- @param color --- The background color.
    SetBackgroundColor: function(self, color: table)

    --- Sets whether or not to disable the panel.
    --- @deprecated
    --- **DEPRECATED**: Use Panel:SetEnabled instead.
    -- @param disabled --- True to disable the panel (mouse input disabled and background alpha set to 75), false to enable it (mouse input enabled and background alpha set to 255).
    SetDisabled: function(self, disabled: boolean)

    --- @deprecated
    --- **DEPRECATED**: You should use DPanel:SetPaintBackground instead.
    --- Sets whether or not to draw the panel background. Alias of DPanel:SetPaintBackground.
    -- @param draw --- True to show the panel's background, false to hide it.
    SetDrawBackground: function(self, draw: boolean)

    --- Used internally by DMenu.
    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, Global.CloseDermaMenus will not be called when the frame is clicked, and thus any open menus will remain open.
    -- @param isMenu --- Whether this pane is a Menu Component
    SetIsMenu: function(self, isMenu: boolean)

    --- Sets whether or not to paint/draw the panel background.
    -- @param paint --- True to show the panel's background, false to hide it.
    SetPaintBackground: function(self, paint: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- @param draw ---
    SetTabbingDisabled: function(self, draw: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    UpdateColours: function(self)
end

--- Base panel used by DFrame, this panel is needed so that elements such as the TextEntry can obtain focus.
global interface VEditablePanel is GPanel

end

--- A standard Derma button.
--- By default, a DButton is 22px tall.
global interface DButton is DLabel
    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that returns value set by DButton:SetDrawBorder. See that page for more info.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L4)
    -- @return --- value set by DButton:SetDrawBorder.
    GetDrawBorder: function(self): boolean

    --- Returns true if the DButton is currently depressed (a user is clicking on it).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L26-L30)
    -- @return --- Whether or not the button is depressed.
    IsDown: function(self): boolean

    --- Sets a console command to be called when the button is clicked.
    --- This overrides the button's `DoClick` method.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L129-L135)
    -- @param command --- The console command to be called.
    -- @param args --- The arguments for the command.
    SetConsoleCommand: function(self, command: string, args: string)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does absolutely nothing at all. Default value is automatically set to true.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L4)
    -- @param draw --- Does nothing.
    SetDrawBorder: function(self, draw: boolean)

    --- Sets an image to be displayed as the button's background. Alias of DButton:SetImage
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L52)
    -- @param img --- The image file to use, relative to `/materials`. If this is nil, the image background is removed.
    SetIcon: function(self, img: string)

    --- Sets an image to be displayed as the button's background.
    --- See DButton:SetMaterial for equivalent function that uses IMaterial instead.
    --- Also see: DImageButton
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L32-L52)
    -- @param img --- The image file to use, relative to the `materials/` folder. Can be set to `nil` to remove the image background.
    SetImage: function(self, img: string)

    --- Sets an image to be displayed as the button's background.
    --- See DButton:SetImage for equivalent function that uses file paths instead. Also see DImageButton.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L54-L73)
    -- @param img --- The material to use. If this is nil, the image background is removed.
    SetMaterial: function(self, img: GIMaterial)

    --- A hook called from within DLabel's PANEL:ApplySchemeSettings to determine the color of the text on display.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dbutton.lua#L86-L94)
    -- @param skin --- A table supposed to contain the color values listed above.
    UpdateColours: function(self, skin: table)
end

--- **INTERNAL**:
--- A base for other controls for DProperties. Acts as a generic text input on its own.
global interface DProperty_Generic is GPanel
    --- Returns the internal row panel of a DProperties that this panel belongs to.
    -- @return --- The row panel.
    GetRow: function(self): GPanel

    --- **INTERNAL**:
    --- Called internally by DProperties.
    -- @param row --- The new row panel.
    SetRow: function(self, row: GPanel)

    --- Sets up a generic control for use by DProperties.
    -- @param data --- See Editable Entities.
    Setup: function(self, data: table)

    --- Called by this control, or a derived control, to alert the row of the change.
    -- @param newVal --- The new value.
    -- @param force --- Force an update.
    ValueChanged: function(self, newVal: any, force: boolean)
end

--- Basic text input field.
--- See DTextEntry for a more advanced version.
global interface VTextEntry is GPanel
    --- Called from engine whenever a valid character is typed while the text entry is focused.
    --- Used internally for functionality of DTextEntry
    -- @param keyCode --- They key code of the key pressed, see Enums/KEY.
    -- @return --- Whether you've handled the key press. Returning true prevents the default text entry behavior from occurring.
    OnKeyCodeTyped: function(self, keyCode: number): boolean

    --- Called when the text inside the TextEntry changes.
    --- You may be looking for DTextEntry:OnValueChange instead.
    OnTextChanged: function(self)
end

--- Displays elements in a horizontal or vertical list. A scrollbar is automatically shown if necessary.
--- You can get its vertical bar via `DPanelList.VBar`.
--- DPanelList was succeeded in version 13 by more specialised layout elements.
--- @deprecated
--- **DEPRECATED**:
---  Use a combination of DIconLayout, DListLayout and DScrollPanel instead.
global interface DPanelList is DPanel
    --- Adds a existing panel to the end of DPanelList.
    -- @param pnl --- Panel to be used as element of list
    -- @param state --- If set to "ownline", the item will take its own entire line.
    AddItem: function(self, pnl: GPanel, state: string)

    --- Removes all items.
    CleanList: function(self)

    --- Hides all child panels, and optionally deletes them.
    -- @param remove --- Whether to actually delete the panels, not just hide them.
    --Clear: function(self, remove: boolean)

    --- Enables/creates the vertical scroll bar so that the panel list can be scrolled through.
    EnableVerticalScrollbar: function(self)

    --- Returns all panels has added by DPanelList:AddItem
    -- @return --- A table of panels used as items of DPanelList.
    GetItems: function(self): table

    --- Returns offset of list items from the panel borders set by DPanelList:SetPadding
    -- @return --- Offset from panel borders
    GetPadding: function(self): number

    --- Returns distance between list items set by DPanelList:SetSpacing
    -- @return --- Distance between panels
    GetSpacing: function(self): number

    --- Insert given panel at the top of the list.
    -- @param insert --- The panel to insert
    -- @param strLineState --- If set to "ownline", no other panels will be placed to the left or right of the panel we are inserting
    InsertAtTop: function(self, insert: GPanel, strLineState: string)

    --- **INTERNAL**:
    --- Used internally to rebuild the child panel positions.
    Rebuild: function(self)

    --- Sets the DPanelList to size its height to its contents. This is set to false by default.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpanellist.lua#L4)
    -- @param shouldSizeToContents --- Whether to size to the height of the DPanelList contents.
    SetAutoSize: function(self, shouldSizeToContents: boolean)

    --- Sets the offset of the lists items from the panel borders
    -- @param Offset --- Offset from panel borders
    SetPadding: function(self, Offset: number)

    --- Sets distance between list items
    -- @param Distance --- Distance between panels
    SetSpacing: function(self, Distance: number)
end

--- **INTERNAL**:
--- A VGUI base panel providing drag/drop functionality. Used by DIconLayout, DListLayout and DTileLayout.
global interface DDragBase is DPanel
    --- **INTERNAL**:
    --- Internal function used in DDragBase:MakeDroppable
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L47-L51)
    -- @param drops ---
    -- @param bDoDrop ---
    -- @param command ---
    -- @param y ---
    -- @param x ---
    DropAction_Copy: function(self, drops: table, bDoDrop: boolean, command: string, y: number, x: number)

    --- **INTERNAL**:
    --- Internal function used in DDragBase:DropAction_Copy
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L72-L137)
    -- @param drops ---
    -- @param bDoDrop ---
    -- @param command ---
    -- @param y ---
    -- @param x ---
    DropAction_Normal: function(self, drops: table, bDoDrop: boolean, command: string, y: number, x: number)

    --- **INTERNAL**:
    --- Internal function used in DDragBase:DropAction_Normal
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L53-L70)
    -- @param drops ---
    -- @param bDoDrop ---
    -- @param command ---
    -- @param y ---
    -- @param x ---
    DropAction_Simple: function(self, drops: table, bDoDrop: boolean, command: string, y: number, x: number)

    --- Returns the drag'n'drop group this panel belongs to. See DDragBase:MakeDroppable. An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L4)
    -- @return --- Name of the DnD family.
    GetDnD: function(self): string

    --- Returns whether this panel is read only or not for drag'n'drop purposes. An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L6)
    -- @return name --- Whether this panel is read only or not.
    GetReadOnly: function(self): boolean

    --- Whether this panel uses live drag'n'drop previews. An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L5)
    -- @return ---
    GetUseLiveDrag: function(self): boolean

    --- Makes the panel a receiver for any droppable panel with the same DnD name. Internally calls Panel:Receiver.
    --- See Drag and Drop for VGUI.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L34-L44)
    -- @param name --- The unique name for the receiver slot. Only droppable panels with the same DnD name as this can be dropped on the panel.
    -- @param allowCopy --- Whether or not to allow droppable panels to be copied when the `` key is held down.
    MakeDroppable: function(self, name: string, allowCopy: boolean)

    --- Called when anything is dropped on or rearranged within the DDragBase. For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L139-L141)
    OnModified: function(self)

    --- **INTERNAL**:
    ---  Used internally by DDragBase:MakeDroppable.
    --- See also DDragBase:GetDnD
    --- An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L4)
    -- @param name --- Name of the DnD family.
    SetDnD: function(self, name: string)

    --- Determines where you can drop stuff.
    --- "4" for left
    --- "5" for center
    --- "6" for right
    --- "8" for top
    --- "2" for bottom
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L24-L32)
    -- @param pos --- Where you're allowed to drop things.
    SetDropPos: function(self, pos: string)

    --- Sets whether this panel is read only or not for drag'n'drop purposes. If set to `true`, you can only copy from this panel, and cannot modify its contents. This is an Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L6)
    -- @param name --- Whether this panel should be read only or not.
    SetReadOnly: function(self, name: boolean)

    --- Whether to use live drag'n'drop previews. This is an Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L5)
    -- @param newState ---
    SetUseLiveDrag: function(self, newState: boolean)

    --- **INTERNAL**:
    --- Internal function used in DDragBase:DropAction_Normal
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddragbase.lua#L143-L168)
    -- @param drop ---
    -- @param pnl ---
    UpdateDropTarget: function(self, drop: number, pnl: GPanel)
end

--- The collapsible category allows you to create numerous sections of controls, and have the ability to contract/expand them.
--- Consider using DCategoryList if you plan on using more than 1 of these.
global interface DCollapsibleCategory is GPanel
    --- Adds a new text button to the collapsible category, like the tool menu in Spawnmenu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L75-L122)
    -- @param name --- The name of the button
    -- @return --- The DButton
    --Add: function(self, name: string): GPanel

    --- **INTERNAL**:
    --- Internal function that handles the open/close animations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L281-L307)
    -- @param anim ---
    -- @param delta ---
    -- @param data ---
    AnimSlide: function(self, anim: table, delta: number, data: table)

    --- Forces the category to open or collapse
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L233-L238)
    -- @param expand --- True to open, false to collapse
    DoExpansion: function(self, expand: boolean)

    --- An Global.AccessorFunc that returns the expand/collapse animation time set by DCollapsibleCategory:SetAnimTime.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L50)
    -- @return --- The animation time in seconds
    GetAnimTime: function(self): number

    --- @deprecated
    --- **DEPRECATED**: You should use DCollapsibleCategory:GetPaintBackground instead.
    --- Returns whether or not the panel background is being drawn. Alias of DCollapsibleCategory:GetPaintBackground.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L52)
    -- @return --- True if the panel background is drawn, false otherwise.
    GetDrawBackground: function(self): boolean

    --- Returns whether the DCollapsibleCategory is expanded or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L48)
    -- @return --- If expanded it will return true.
    GetExpanded: function(self): boolean

    --- Returns the header height of the DCollapsibleCategory.
    --- See also DCollapsibleCategory:SetHeaderHeight.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L162-L166)
    -- @return height --- The current height of the header.
    GetHeaderHeight: function(self): number

    --- If set, the DCategoryList that created this panel.
    --- See also DCollapsibleCategory:SetList.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L54)
    -- @return --- The DCategoryList that created us.
    GetList: function(self): GPanel

    --- @deprecated
    --- **DEPRECATED**:
    --- Doesn't actually do anything.
    --- Returns the number set by DCollapsibleCategory:SetPadding.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L53)
    -- @return ---
    GetPadding: function(self): number

    --- An Global.AccessorFunc that returns whether or not the background should be painted.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L41)
    -- @return --- If the background is painted or not
    GetPaintBackground: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns whatever was set by DCollapsibleCategory:SetStartHeight
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L49)
    -- @return ---
    GetStartHeight: function(self): number

    --- Called by DCollapsibleCategory:Toggle. This function does nothing by itself, as you're supposed to overwrite it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L227-L231)
    -- @param expanded --- If it was expanded or not
    OnToggle: function(self, expanded: boolean)

    --- Sets the time in seconds it takes to expand the DCollapsibleCategory
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L50)
    -- @param time --- The time in seconds it takes to expand
    SetAnimTime: function(self, time: number)

    --- Sets the contents of the DCollapsibleCategory.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L176-L196)
    -- @param pnl --- The panel, containing the contents for the DCollapsibleCategory, mostly an DScrollPanel
    SetContents: function(self, pnl: GPanel)

    --- @deprecated
    --- **DEPRECATED**: You should use DCollapsibleCategory:SetPaintBackground instead.
    --- Sets whether or not to draw the panel background. Alias of DCollapsibleCategory:SetPaintBackground.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L52)
    -- @param draw --- True to show the panel's background, false to hide it.
    SetDrawBackground: function(self, draw: boolean)

    --- Sets whether the DCollapsibleCategory is expanded or not upon opening the container.
    --- You should use DCollapsibleCategory:Toggle or DCollapsibleCategory:DoExpansion instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L48)
    -- @param expanded --- Whether it shall be expanded or not by default
    SetExpanded: function(self, expanded: boolean)

    --- Sets the header height of the DCollapsibleCategory.
    --- See also DCollapsibleCategory:GetHeaderHeight.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L156-L160)
    -- @param height --- The new height to set. Default height is 20.
    SetHeaderHeight: function(self, height: number)

    --- Sets the name of the DCollapsibleCategory.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L150-L154)
    -- @param label --- The label/name of the DCollapsibleCategory.
    SetLabel: function(self, label: string)

    --- Used internally by DCategoryList when it creates a DCollapsibleCategory during DCategoryList:Add.
    --- If set, Panel:UnselectAll will be called on the list, instead of calling it on the category panel itself when a category is clicked.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L54)
    -- @param pnl --- The Panel:UnselectAll that is the "parent" of this panel.
    SetList: function(self, pnl: GPanel)

    --- @deprecated
    --- **DEPRECATED**:
    --- Doesn't actually do anything.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L53)
    -- @param padding ---
    SetPadding: function(self, padding: number)

    --- Sets whether or not the background should be painted.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L51)
    -- @param paint ---
    SetPaintBackground: function(self, paint: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L49)
    -- @param height ---
    SetStartHeight: function(self, height: number)

    --- Toggles the expanded state of the DCollapsibleCategory.
    --- See DCollapsibleCategory:GetExpanded for a function to retrieve the expanded state.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L209-L225)
    Toggle: function(self)

    --- **INTERNAL**:
    --- Used internally to update the "AltLine" property on all "child" panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcategorycollapse.lua#L136-L142)
    UpdateAltLines: function(self)
end

--- The DFrame is the moma of basically all VGUI elements. 98% of the time you will parent your element to this.
global interface DFrame is VEditablePanel
    --- Centers the frame relative to the whole screen and invalidates its layout. This overrides Panel:Center.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L104-L110)
    Center: function(self)

    --- Hides or removes the DFrame, and calls DFrame:OnClose.
    --- To set whether the frame is hidden or removed, use DFrame:SetDeleteOnClose.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L89-L99)
    Close: function(self)

    --- Gets whether the background behind the frame is being blurred.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L14)
    -- @return --- Whether or not background blur is enabled.
    GetBackgroundBlur: function(self): boolean

    --- Determines whether or not the DFrame will be removed when it is closed. This is set with DFrame:SetDeleteOnClose.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L8)
    -- @return --- Whether or not the frame will be removed on close.
    GetDeleteOnClose: function(self): boolean

    --- Gets whether or not the frame is draggable by the user.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L5)
    -- @return --- Whether the frame is draggable or not.
    GetDraggable: function(self): boolean

    --- Gets whether or not the frame is part of a derma menu. This is set with DFrame:SetIsMenu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L4)
    -- @return --- Whether or not this frame is a menu component.
    GetIsMenu: function(self): boolean

    --- Gets the minimum height the DFrame can be resized to by the user.
    --- You must call DFrame:SetSizable before the user can resize the frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L12)
    -- @return --- The minimum height the user can resize the frame to.
    GetMinHeight: function(self): number

    --- Gets the minimum width the DFrame can be resized to by the user.
    --- You must call DFrame:SetSizable before the user can resize the frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L11)
    -- @return --- The minimum width the user can resize the frame to.
    GetMinWidth: function(self): number

    --- Gets whether or not the shadow effect bordering the DFrame is being drawn.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L9)
    -- @return --- Whether or not the shadow is being drawn.
    GetPaintShadow: function(self): boolean

    --- Gets whether or not the DFrame is restricted to the boundaries of the screen resolution.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L7)
    -- @return --- Whether or not the frame is restricted.
    GetScreenLock: function(self): boolean

    --- Gets whether or not the DFrame can be resized by the user.
    --- This is achieved by clicking and dragging in the bottom right corner of the frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L6)
    -- @return --- Whether the frame can be resized or not.
    GetSizable: function(self): boolean

    --- Returns the title of the frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L77-L81)
    -- @return --- Title of the frame.
    GetTitle: function(self): string

    --- Determines if the frame or one of its children has the screen focus.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L112-L119)
    -- @return --- Whether or not the frame has focus.
    IsActive: function(self): boolean

    --- Called when the DFrame is closed with DFrame:Close. This applies when the `close` button in the DFrame's control box is clicked.
    --- This function does nothing and is safe to override.
    --- This is **not** called when the DFrame is removed with Panel:Remove, see PANEL:OnRemove for that.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L101-L102)
    OnClose: function(self)

    --- Indicate that the background elements won't be usable.
    -- @param blur --- Whether or not to block mouse on background panels or not.
    SetBackgroundBlur: function(self, blur: boolean)

    --- Determines whether or not the DFrame is removed when it is closed with DFrame:Close.
    -- @param shouldDelete --- Whether or not to delete the frame on close. This is `true` by default.
    SetDeleteOnClose: function(self, shouldDelete: boolean)

    --- Sets whether the frame should be draggable by the user. The DFrame can only be dragged from its title bar.
    -- @param draggable --- Whether to be draggable or not.
    SetDraggable: function(self, draggable: boolean)

    --- Adds or removes an icon on the left of the DFrame's title.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L121-L135)
    -- @param path --- Set to nil to remove the icon.
    --- Otherwise, set to file path to create the icon.
    SetIcon: function(self, path: string)

    --- Sets whether the frame is part of a derma menu or not.
    --- If this is set to `true`, Global.CloseDermaMenus will not be called when the frame is clicked, and thus any open menus will remain open.
    -- @param isMenu --- Whether or not this frame is a menu component.
    SetIsMenu: function(self, isMenu: boolean)

    --- Sets the minimum height the DFrame can be resized to by the user.
    --- This only applies to users attempting to resize the frame; Panel:SetTall and similar methods will not be affected. You must call DFrame:SetSizable before the user can resize the frame.
    -- @param minH --- The minimum height the user can resize the frame to.
    SetMinHeight: function(self, minH: number)

    --- Sets the minimum width the DFrame can be resized to by the user.
    --- This only applies to users attempting to resize the frame; Panel:SetWide and similar methods will not be affected. You must call DFrame:SetSizable before the user can resize the frame.
    -- @param minW --- The minimum width the user can resize the frame to.
    SetMinWidth: function(self, minW: number)

    --- Sets whether or not the shadow effect bordering the DFrame should be drawn.
    -- @param shouldPaint --- Whether or not to draw the shadow. This is `true` by default.
    SetPaintShadow: function(self, shouldPaint: boolean)

    --- Sets whether the DFrame is restricted to the boundaries of the screen resolution.
    -- @param lock --- If `true`, the frame cannot be dragged outside of the screen bounds
    SetScreenLock: function(self, lock: boolean)

    --- Sets whether or not the DFrame can be resized by the user.
    --- This is achieved by clicking and dragging in the bottom right corner of the frame.
    --- You can set the minimum size using DFrame:SetMinWidth and DFrame:SetMinHeight.
    -- @param sizeable --- Whether the frame should be resizeable or not.
    SetSizable: function(self, sizeable: boolean)

    --- Sets the title of the frame.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L83-L87)
    -- @param title --- New title of the frame.
    SetTitle: function(self, title: string)

    --- Determines whether the DFrame's control box (close, minimise and maximise buttons) is displayed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dframe.lua#L69-L75)
    -- @param show --- `false` hides the control box; this is `true` by default.
    ShowCloseButton: function(self, show: boolean)
end

--- A base for all context menu panels ( The ones used for tool options in sandbox )
global interface VContextBase is GPanel
    --- Returns the ConVar for the panel to change/handle, set by ContextBase:SetConVar
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/contextbase.lua#L16-L18)
    -- @return --- The ConVar for the panel to change.
    ConVar: function(self): string

    --- Called by spawnmenu functions (when creating a context menu) to fill this control with data.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/contextbase.lua#L20-L25)
    -- @param contextData --- A two-membered table:
    --- * string convar - The console variable to use. Calls ContextBase:SetConVar.
    --- * string label - The text to display inside the control's label.
    ControlValues: function(self, contextData: table)

    --- Sets the ConVar for the panel to change/handle.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/contextbase.lua#L12-L14)
    -- @param cvar --- The ConVar for the panel to change.
    SetConVar: function(self, cvar: string)

    --- You should override this function and use it to check whether your convar value changed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/contextbase.lua#L40-L45)
    TestForChanges: function(self)
end

--- @deprecated
--- **DEPRECATED**: Only exists for backwards compatibility with Panel:SetActionFunction. Use DButton instead.
--- Creates a button that players can click on.
--- [View source](https://github.com/Facepunch/garrysmod/blob/dfdafba0f04e75be122961291a56d9c1714a3d8a/garrysmod/lua/vgui/dbutton.lua#L181-L193)
global interface VButton is DButton

end

--- DScrollPanel is a VGUI Element similar to DPanel however it has a vertical scrollbar docked to the right which can be used to put more content in a smaller area. DScrollPanels are essentially DPanels with the Scroll Bar.
--- This can be used to replace the DPanelList with DPanelList:EnableVerticalScrollbar and get similar functionality as well as using a non-deprecated element.
--- If you would like to paint or edit the elements of the scrollbar use DScrollPanel:GetVBar. If you want to see if the scrollbar is visible then use the VBar.Enabled variable on the scrollbar's VBar.
--- **NOTE**: Panel:DockPadding will not have an effect on children of this panel. Use the function on DScrollPanel:GetCanvas instead.
global interface DScrollPanel is DPanel
    --- Parents the passed panel to the DScrollPanel's canvas.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L33-L37)
    -- @param pnl --- The panel to add.
    AddItem: function(self, pnl: GPanel)

    --- Returns the canvas ( The panel all child panels are parented to ) of the DScrollPanel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L57-L61)
    -- @return --- The canvas
    GetCanvas: function(self): GPanel

    --- @deprecated
    --- **DEPRECATED**:
    --- Gets the DScrollPanels padding, set by DScrollPanel:SetPadding.
    -- @return --- DScrollPanels padding
    GetPadding: function(self): number

    --- Returns the vertical scroll bar of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L51-L55)
    -- @return --- The DVScrollBar.
    GetVBar: function(self): DVScrollBar

    --- Return the width of the DScrollPanel's canvas.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L63-L67)
    -- @return --- The width of the DScrollPanel's canvas
    InnerWidth: function(self): number

    --- **INTERNAL**:
    --- Used internally to rebuild the panel's children positioning. You should use Panel:InvalidateLayout instead.
    PerformLayoutInternal: function(self)

    --- **INTERNAL**:
    --- Used internally to rebuild the panel's children positioning. You should use Panel:InvalidateLayout instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L69-L80)
    Rebuild: function(self)

    --- Scrolls to the given child
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dscrollpanel.lua#L94-L106)
    -- @param panel --- The panel to scroll to, must be a child of the DScrollPanel.
    ScrollToChild: function(self, panel: GPanel)

    --- **INTERNAL**:
    --- Sets the canvas of the DScrollPanel.
    -- @param canvas --- The new canvas
    SetCanvas: function(self, canvas: GPanel)

    --- @deprecated
    --- **DEPRECATED**:
    --- Sets the DScrollPanel's padding. This function appears to be unused.
    -- @param padding --- The padding of the DScrollPanel.
    SetPadding: function(self, padding: number)
end

--- **INTERNAL**:
--- Float control for the DProperties panel.
global interface DProperty_Float is DProperty_Generic
    --- Called to poll the amount of digits after the decimal point. This is used internally for DProperty_Int.
    -- @return data --- The amount of digits after the decimal point.
    GetDecimals: function(self): table
end

--- A form which may be used to display text the player is meant to select and copy or alternately allow them to enter some text of their own.
--- **NOTE**: At least one of your `DTextEntry`'s parents must either be an EditablePanel or derived from it (like a DFrame, for example), else it won't be able to focus and thus be unselectable.
--- You must also call Panel:MakePopup on said panel or the `DTextEntry` will not work.
global interface DTextEntry is VTextEntry
    --- Adds an entry to DTextEntry's history.
    --- See DTextEntry:SetHistoryEnabled.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L366-L373)
    -- @param text --- Text to add to the text entry's history.
    AddHistory: function(self, text: string)

    --- Called whenever the value of the panel has been updated (whether by user input or otherwise).
    --- It allows you to determine whether a user can modify the TextEntry's text.
    --- By default, this only checks whether the panel disallows numeric characters, preventing it from being edited if the value contains any.
    --- This is actually an engine hook that only works on TextEntry derived elements.
    --- If you are looking for a way to modify character limits, see Panel:SetMaximumCharCount
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L321-L327)
    -- @param char --- The last character entered into the panel.
    -- @return --- Return `true` to prevent the value from changing, `false` to allow it.
    AllowInput: function(self, char: string): boolean

    --- Returns whether a string is numeric or not.
    --- Always returns false if the DTextEntry:SetNumeric is set to false.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L296-L311)
    -- @param strValue --- The string to check.
    -- @return --- Whether the string is numeric or not.
    CheckNumeric: function(self, strValue: string): boolean

    --- Called by the DTextEntry when a list of autocompletion options is requested. Meant to be overridden.
    -- @param inputText --- Player's current input.
    -- @return --- If a table is returned, the values of the table will show up as autocomplete suggestions for the user.
    GetAutoComplete: function(self, inputText: string): table

    --- Returns the cursor color of a DTextEntry.
    -- @return --- The color of the cursor as a Color.
    GetCursorColor: function(self): table

    --- @deprecated
    --- **DEPRECATED**: Use Panel:IsEnabled instead.
    --- Returns whether the textbox is disabled. Use Panel:IsEnabled instead.
    -- @return --- Whether the textbox is disabled.
    GetDisabled: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    ---  Alias of DTextEntry:GetPaintBackground. Use that instead.
    --- Whether the background is displayed or not.
    -- @return ---
    GetDrawBackground: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns the value set by DTextEntry:SetDrawBorder.
    -- @return ---
    GetDrawBorder: function(self): boolean

    --- Returns whether pressing Enter can cause the panel to lose focus. Note that a multiline DTextEntry cannot be escaped using the Enter key even when this function returns true.
    -- @return --- Whether pressing the Enter key can cause the panel to lose focus.
    GetEnterAllowed: function(self): boolean

    --- Returns the contents of the DTextEntry as a number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L388-L392)
    -- @return --- Text of the DTextEntry as a float, or nil if it cannot be converted to a number using Global.tonumber.
    GetFloat: function(self): number

    --- Returns the highlight/text selection color of the text entry. If it was not overwritten, it will return the derma skin value. (`colTextEntryTextHighlight`)
    -- @return --- The highlight Global.Color.
    GetHighlightColor: function(self): table

    --- Returns whether the history functionality of  DTextEntry is enabled. See DTextEntry:AddHistory.
    -- @return --- Whether the history is enabled or not.
    GetHistoryEnabled: function(self): boolean

    --- Similar to DTextEntry:GetFloat, but rounds the value to the nearest integer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L379-L386)
    -- @return --- Text of the DTextEntry as a round number, or nil if it cannot be converted to a number.
    GetInt: function(self): number

    --- Returns whether only numeric characters (`123456789.-`) can be entered into the DTextEntry.
    -- @return --- Whether the DTextEntry is numeric or not.
    GetNumeric: function(self): boolean

    --- Whether the background is displayed or not
    -- @return show --- `false` hides the background; this is `true` by default.
    GetPaintBackground: function(self): boolean

    --- Return current color of panel placeholder
    -- @return --- Current placeholder color
    GetPlaceholderColor: function(self): table

    --- Returns the placeholder text set with DTextEntry:SetPlaceholderText.
    -- @return ---
    GetPlaceholderText: function(self): string

    --- Returns whether or not the panel accepts `` key.
    -- @return --- Whether the DTextEntry should ignore ``.
    GetTabbingDisabled: function(self): boolean

    --- Returns the text color of a DTextEntry.
    -- @return --- The color of the text as a Color.
    GetTextColor: function(self): table

    --- Returns whether the DTextEntry is set to run DTextEntry:OnValueChange every time a character is typed or deleted or only when Enter is pressed.
    -- @return ---
    GetUpdateOnType: function(self): boolean

    --- Returns whether this DTextEntry is being edited or not. (i.e. has focus)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L64-L66)
    -- @return --- Whether this DTextEntry is being edited or not
    IsEditing: function(self): boolean

    --- Called by DTextEntry:OnTextChanged when the user modifies the text in the DTextEntry.
    --- You should override this function to define custom behavior when the DTextEntry text changes.
    OnChange: function(self)

    --- Called whenever enter is pressed on a DTextEntry.
    --- **NOTE**: DTextEntry:IsEditing will still return true in this callback!
    -- @param value --- The current text of the DTextEntry
    OnEnter: function(self, value: string)

    --- Called whenever the DTextEntry gains focus.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L336-L348)
    OnGetFocus: function(self)

    --- Called from DTextEntry's TextEntry:OnKeyCodeTyped override whenever a valid character is typed while the text entry is focused.
    -- @param keyCode --- They key code of the key pressed, see Enums/KEY.
    OnKeyCode: function(self, keyCode: number)

    --- Called whenever the DTextEntry lose focus.
    OnLoseFocus: function(self)

    --- **INTERNAL**:
    --- Called internally when the text inside the DTextEntry changes. This is an implementation of TextEntry:OnTextChanged
    --- You should not override this function. Use DTextEntry:OnValueChange instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L188-L208)
    -- @param noMenuRemoval --- Determines whether to remove the autocomplete menu (false) or not (true).
    --OnTextChanged: function(self, noMenuRemoval: boolean)

    --- Called when the text changes of the DTextEntry are applied. (And set to the attached console variable, if one is given)
    --- See also DTextEntry:OnChange for a function that is called on every text change, even if the console variable is not updated.
    --- You should override this function to define custom behavior when the text changes.
    --- This method is called:
    --- * When Enter is pressed after typing
    --- * When DTextEntry:SetValue is used
    --- * For every key typed - only if DTextEntry:SetUpdateOnType was set to true (default is false)
    -- @param value --- The DTextEntry text.
    OnValueChange: function(self, value: string)

    --- **INTERNAL**: You really should be using DTextEntry:GetAutoComplete instead.
    --- Builds a DMenu for the DTextEntry based on the input table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L213-L232)
    -- @param tab --- Table containing results from DTextEntry:GetAutoComplete.
    OpenAutoComplete: function(self, tab: table)

    --- Sets the cursor's color in  DTextEntry (the blinking line).
    -- @param color --- The color to set the cursor to.
    SetCursorColor: function(self, color: table)

    --- @deprecated
    --- **DEPRECATED**: Use Panel:SetEnabled instead.
    --- Disables input on a DTextEntry and greys it out visually. This differs from DTextEntry:SetEditable which doesn't visually change the textbox.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L313-L315)
    -- @param disabled --- Whether the textbox should be disabled
    SetDisabled: function(self, disabled: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    ---  Alias of DTextEntry:SetPaintBackground. Use that instead.
    -- @param show ---
    SetDrawBackground: function(self, show: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- @param bool ---
    SetDrawBorder: function(self, bool: boolean)

    --- Disables Input on a DTextEntry. This differs from DTextEntry:SetDisabled - SetEditable will not affect the appearance of the textbox.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L329-L334)
    -- @param enabled --- Whether the DTextEntry should be editable
    SetEditable: function(self, enabled: boolean)

    --- Sets whether pressing the Enter key will cause the DTextEntry to lose focus or not, provided it is not multiline. This is true by default.
    -- @param allowEnter --- If set to false, pressing Enter will not cause the panel to lose focus and will never call DTextEntry:OnEnter.
    SetEnterAllowed: function(self, allowEnter: boolean)

    --- Changes the font of the DTextEntry.
    -- @param font --- The name of the font to be changed to.
    SetFont: function(self, font: string)

    --- Sets/overrides the default highlight/text selection color of the text entry.
    -- @param color --- The new highlight Global.Color.
    SetHighlightColor: function(self, color: table)

    --- Enables or disables the history functionality of  DTextEntry. This allows the player to scroll through history elements using up and down arrow keys.
    --- See DTextEntry:AddHistory.
    -- @param enable --- Whether to enable history or not.
    SetHistoryEnabled: function(self, enable: boolean)

    --- Sets whether or not to decline non-numeric characters as input.
    --- Numeric characters are `1234567890.-`
    -- @param numericOnly --- Whether to accept only numeric characters.
    SetNumeric: function(self, numericOnly: boolean)

    --- Sets whether to show the default background of the DTextEntry.
    -- @param show --- `false` hides the background; this is `true` by default.
    SetPaintBackground: function(self, show: boolean)

    --- Allow you to set placeholder color.
    -- @param color --- The color of the placeholder.
    SetPlaceholderColor: function(self, color: table)

    --- Sets the placeholder text that will be shown while the text entry has no user text. The player will not need to delete the placeholder text if they decide to start typing.
    -- @param text ---
    SetPlaceholderText: function(self, text: string)

    --- Sets whether or not the panel accepts `` key.
    --- **NOTE**: Disabling tab key prevents the panel from unfocusing by mouse, however, still works for focusing to other keyboard focus.
    -- @param enabled --- Whether the DTextEntry should ignore ``.
    SetTabbingDisabled: function(self, enabled: boolean)

    --- Sets the text color of the DTextEntry.
    -- @param color --- The text color. Uses the Color.
    SetTextColor: function(self, color: table)

    --- Sets whether we should fire DTextEntry:OnValueChange every time we type or delete a character or only when Enter is pressed.
    -- @param updateOnType ---
    SetUpdateOnType: function(self, updateOnType: boolean)

    --- Sets the text of the DTextEntry and calls DTextEntry:OnValueChange.
    --- **NOTE**: The text of the DTextEntry only changes if it's not currently being typed in. If you would rather set the text regardless, use Panel:SetText.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L277-L290)
    -- @param text --- The value to set.
    SetValue: function(self, text: string)

    --- **INTERNAL**: Used by DTextEntry:OnTextChanged, DTextEntry:OnEnter and DTextEntry:OnLoseFocus
    --- Updates the ConVar associated with the TextEntry to its new value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dtextentry.lua#L256-L262)
    UpdateConvarValue: function(self)

    --- **INTERNAL**:
    --- Used internally to set text from the history.
    UpdateFromHistory: function(self)

    --- **INTERNAL**:
    --- Used internally to set text from the autocomplete menu.
    UpdateFromMenu: function(self)
end

--- An image button.
--- This panel inherits all methods of DButton, such as DLabel:DoClick.
global interface DImageButton is DButton
    --- **INTERNAL**:
    --- Used internally to briefly scale the image when clicked.
    DepressImage: function(self)

    --- Returns whether DImageButton:DepressImage is functional or not.
    -- @return enable --- `true` to enable image depressing when clicked.
    GetDepressImage: function(self): boolean

    --- Returns the "image" of the DImageButton. Equivalent of DImage:GetImage.
    -- @return --- The path to the image that is loaded.
    GetImage: function(self): string

    --- Returns whether the image inside the button should be stretched to fit it or not
    --- See DImageButton:SetStretchToFit
    -- @return ---
    GetStretchToFit: function(self): boolean

    --- Sets the color of the image. Equivalent of DImage:SetImageColor
    -- @param color --- The Global.Color to set
    SetColor: function(self, color: table)

    --- Controls whether DImageButton:DepressImage is functional or not.
    -- @param enable --- `true` to enable image depressing when clicked.
    SetDepressImage: function(self, enable: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Alias of DImageButton:SetImage.
    -- @param strImage ---
    -- @param strBackup ---
    --SetIcon: function(self, strImage: string, strBackup: string)

    --- Sets the "image" of the DImageButton. Equivalent of DImage:SetImage.
    -- @param strImage --- The path of the image to load, relative to the `materials/` folder. When no file extension is supplied the `.vmt` file extension is assumed.
    -- @param strBackup --- The path of the backup image.
    --SetImage: function(self, strImage: string, strBackup: string)

    --- Hides or shows the image of the image button. Internally this calls Panel:SetVisible on the internal DImage.
    -- @param visible --- Set true to make it visible ( default ), or false to hide the image
    SetImageVisible: function(self, visible: boolean)

    --- Sets whether the DImageButton should keep the aspect ratio of its image. Equivalent of DImage:SetKeepAspect.
    --- Note that this will not try to fit the image inside the button, but instead it will fill the button with the image.
    -- @param keep --- true to keep the aspect ratio, false not to
    SetKeepAspect: function(self, keep: boolean)

    --- Sets a Global.Material directly as an image. Equivalent of DImage:SetMaterial.
    -- @param mat --- The material to set
    SetMaterial: function(self, mat: GIMaterial)

    --- See DImage:SetOnViewMaterial
    -- @param mat ---
    -- @param backup ---
    SetOnViewMaterial: function(self, mat: string, backup: string)

    --- Sets whether the image inside the DImageButton should be stretched to fill the entire size of the button, without preserving aspect ratio.
    --- If set to false, the image will not be resized at all.
    -- @param stretch --- True to stretch, false to not to stretch
    SetStretchToFit: function(self, stretch: boolean)
end

--- A tab oriented control where you can create multiple tabs with items within. Used mainly for organization.
global interface DPropertySheet is GPanel
    --- Adds a new tab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L175-L210)
    -- @param name --- Name of the tab
    -- @param pnl --- Panel to be used as contents of the tab. This normally should be a DPanel
    -- @param icon --- Icon for the tab. This will ideally be a silkicon, but any material name can be used.
    -- @param noStretchX --- Should DPropertySheet try to fill itself with given panel horizontally.
    -- @param noStretchY --- Should DPropertySheet try to fill itself with given panel vertically.
    -- @param tooltip --- Tooltip for the tab when user hovers over it with his cursor
    -- @return --- A table containing the following keys:
    --- * Panel Tab - The created DTab.
    --- * string Name - Name of the created tab
    --- * Panel Panel - The contents panel of the tab
    AddSheet: function(self, name: string, pnl: GPanel, icon: string, noStretchX: boolean, noStretchY: boolean, tooltip: string): table

    --- Removes tab and/or panel from the parent DPropertySheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L405-L441)
    -- @param tab --- The DTab of the sheet from DPropertySheet.
    --- See DPropertySheet:GetItems.
    -- @param removePanel --- Set to true to remove the associated panel object as well.
    -- @return --- The panel of the tab.
    CloseTab: function(self, tab: GPanel, removePanel: boolean): GPanel

    --- **INTERNAL**:
    --- Internal function that handles the cross fade animation when the player switches tabs.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L254-L302)
    -- @param anim ---
    -- @param delta ---
    -- @param data ---
    CrossFade: function(self, anim: table, delta: number, data: table)

    --- Returns the active DTab of this DPropertySheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L151)
    -- @return --- The DTab
    GetActiveTab: function(self): GPanel

    --- Returns the amount of time (in seconds) it takes to fade between tabs.
    --- Set by DPropertySheet:SetFadeTime
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L153)
    -- @return --- The amount of time (in seconds) it takes to fade between tabs.
    GetFadeTime: function(self): number

    --- Returns a list of all tabs of this DPropertySheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L248-L252)
    -- @return --- A table of tables.
    --- Each table contains 3 key-value pairs:
    --- * string Name - The name of the tab.
    --- * Panel Tab - The DTab associated with the tab.
    --- * Panel Panel - The Panel associated with the tab.
    GetItems: function(self): table

    --- Gets the padding from the parent panel to child panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L152)
    -- @return --- Padding
    GetPadding: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns whatever value was set by DPropertySheet:SetShowIcons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L155)
    -- @return ---
    GetShowIcons: function(self): boolean

    --- Called when a player switches the tabs.
    --- Source code states that this is meant to be overridden.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L238-L240)
    -- @param old --- The previously active DTab
    -- @param new --- The newly active DTab
    OnActiveTabChanged: function(self, old: GPanel, new: GPanel)

    --- Sets the active tab of the DPropertySheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L151)
    -- @param tab --- The DTab to set active.
    --- See DPropertySheet:GetItems
    SetActiveTab: function(self, tab: GPanel)

    --- Sets the amount of time (in seconds) it takes to fade between tabs.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L153)
    -- @param time --- The amount of time it takes (in seconds) to fade between tabs.
    SetFadeTime: function(self, time: number)

    --- Sets the padding from parent panel to children panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L152)
    -- @param padding --- Amount of padding
    SetPadding: function(self, padding: number)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L155)
    -- @param show ---
    SetShowIcons: function(self, show: boolean)

    --- Creates a close button on the right side of the DPropertySheet that will run the given callback function when pressed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L391-L403)
    -- @param func --- Callback function to be called when the close button is pressed.
    SetupCloseButton: function(self, func: function)

    --- Sets the width of the DPropertySheet to fit the contents of all of the tabs.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L359-L374)
    SizeToContentWidth: function(self)

    --- Switches the active tab to a tab with given name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L376-L389)
    -- @param name --- Case sensitive name of the tab.
    SwitchToName: function(self, name: string)
end

--- @deprecated
--- **DEPRECATED**: This is derived from the deprecated DPanelList.
--- A base panel for things like DModelSelect.
--- Basically, a list of panels that can be selected.
--- Selected panel can be retrieved and has visual indication of being selected.
global interface DPanelSelect is DPanelList
    --- Adds a panel to be selectable.
    -- @param pnl --- The panel to add.
    -- @param conVars --- ConVars to set when this panel is selected. Keys are the cvar name, value is the value for that cvar.
    AddPanel: function(self, pnl: GPanel, conVars: table)

    --- **INTERNAL**:
    --- Used internally by DPanelSelect:AddPanel to select the best default selected panel based on player's convars.
    FindBestActive: function(self)

    --- Called when the selected panel changes.
    -- @param oldPnl --- Old selected panel.
    -- @param newPnl --- New selected panel.
    OnActivePanelChanged: function(self, oldPnl: GPanel, newPnl: GPanel)

    --- Selects a given panel.
    -- @param pnl --- Panel to select. It should've been added previously via DPanelSelect:AddPanel.
    SelectPanel: function(self, pnl: GPanel)
end

--- **INTERNAL**:
--- Internal subpanel that represents an option used by DMenu.
global interface DMenuOption is DButton
    --- Creates a sub DMenu and returns it. Has no duplicate call protection.
    -- @return --- The created DMenu to add options to.
    AddSubMenu: function(self): GPanel

    --- Returns the checked state of DMenuOption.
    -- @return --- Are we checked or not
    GetChecked: function(self): boolean

    --- Returns whether the DMenuOption is a checkbox option or a normal button option.
    -- @return ---
    GetIsCheckable: function(self): boolean

    --- Returns which DMenu this option belongs.
    -- @return --- A DMenu to which this panel belongs.
    GetMenu: function(self): GPanel

    --- Returns whether this DMenuOption should act like a radio button, set by DMenuOption:SetRadio.
    -- @return checked --- `true` to set as a radio button.
    GetRadio: function(self): boolean

    --- Called whenever the DMenuOption's checked state changes.
    -- @param checked --- The new checked state
    OnChecked: function(self, checked: boolean)

    --- Sets the checked state of the DMenuOption.
    --- Invokes DMenuOption:OnChecked.
    -- @param checked --- `true` to set as checked.
    SetChecked: function(self, checked: boolean)

    --- Sets whether the DMenuOption is a checkbox option or a normal button option.
    --- Enables automatic DMenuOption:GetChecked toggling with left/right clicks.
    -- @param checkable --- Whether the menu option should allow the player to toggle itself.
    SetIsCheckable: function(self, checkable: boolean)

    --- **INTERNAL**:
    --- Used to set the DMenu for this option.
    -- @param pnl --- The DMenu for this option.
    SetMenu: function(self, pnl: GPanel)

    --- Sets whether this DMenuOption should act like a radio button.
    --- Checking a radio button automatically unchecks all adjacent radio buttons.
    -- @param checked --- `true` to set as a radio button.
    SetRadio: function(self, checked: boolean)

    --- **INTERNAL**:
    --- Used internally by DMenuOption:AddSubMenu to create the submenu arrow and assign the created submenu to be opened when this option is hovered.
    -- @param menu --- The sub DMenu this option belongs to.
    SetSubMenu: function(self, menu: GPanel)

    --- Toggles the checked state of DMenuOption. Does not respect DMenuOption:GetIsCheckable.
    ToggleCheck: function(self)
end

--- **INTERNAL**:
--- A single column, used by DListView.
global interface DListView_Column is GPanel
    --- Called when the column is left clicked (on key release) by the client.
    --- See also DListView_Column:DoRightClick.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dlistview_column.lua#L91-L96)
    DoClick: function(self)

    --- Called when the column is right clicked (on key release) by the client.
    --- See also DListView_Column:DoClick.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dlistview_column.lua#L98-L100)
    DoRightClick: function(self)

    --- Gets the index used for this column.
    -- @return index --- The column index of the DListView_Column.
    GetColumnID: function(self): number

    --- Returns whether the column is sorted in descending order or not.
    -- @return desc --- Whether the column is sorted in descending order or not.
    GetDescending: function(self): boolean

    --- Returns the fixed width of this column.
    -- @return width --- The fixed width.
    GetFixedWidth: function(self): number

    --- Returns the maximum width set with DListView_Column:SetMaxWidth.
    -- @return width --- The maximum width
    GetMaxWidth: function(self): number

    --- Returns the minimum width set with DListView_Column:SetMinWidth.
    -- @return width --- The minimum width
    GetMinWidth: function(self): number

    --- Returns the text alignment for the column
    -- @return alignment --- The direction of the content, based on the number pad. See DListView_Column:SetTextAlign.
    GetTextAlign: function(self): number

    --- Resizes the column, additionally adjusting the size of the column to the right, if any.
    -- @param size --- The amount to add to the current column's width.
    --- Positive values will make it wider, and negative values will make it thinner.
    ResizeColumn: function(self, size: number)

    --- **INTERNAL**:
    --- Sets the index used for this column.
    -- @param index --- The column index of the DListView_Column.
    SetColumnID: function(self, index: number)

    --- Sets whether the column is sorted in descending order or not.
    -- @param desc --- Whether the column is sorted in descending order or not.
    SetDescending: function(self, desc: boolean)

    --- Sets the fixed width of the column.
    --- **NOTE**: Internally this will set SetMinWidth and SetMaxWidth to the value provided
    -- @param width --- The number value which will determine a fixed width.
    SetFixedWidth: function(self, width: number)

    --- Sets the maximum width of a column.
    -- @param width --- The number value which will determine a maximum width.
    SetMaxWidth: function(self, width: number)

    --- Sets the minimum width of a column.
    -- @param width --- The number value which will determine a minimum width.
    SetMinWidth: function(self, width: number)

    --- Sets the text in the column's header.
    -- @param name --- The new name that the column's header will use.
    SetName: function(self, name: string)

    --- Sets the text alignment for the column
    -- @param alignment --- The direction of the content, based on the number pad.
    --- |   |   |   |
    --- | --- | --- | --- |
    --- | ``: **top-left** | ``: **top-center**	| ``: **top-right** |
    --- | ``: **middle-left** | ``: **center** | ``: **middle-right** |
    --- | ``: **bottom-left** | ``: **bottom-center** | ``: **bottom-right** |
    SetTextAlign: function(self, alignment: number)

    --- Sets the width of the panel.
    -- @param width --- The number value which will determine panel width.
    SetWidth: function(self, width: number)
end

--- **INTERNAL**: Use DLabelURL instead.
--- A panel similar to Label, but can be clicked to open a URL in the Steam Overlay, and appears with an underline. This is used by DLabelURL.
global interface VURLLabel

end

--- The HTML control can be used to display web pages just like an internet browser.
--- DHTML has additional functionality for interfacing with the page, such as sending and receiving data.
--- ## Blocked URL Extentions
--- This means your url cannot end in any of these extensions, e.g.: (http://yourdomain.com/garry.exe)
--- * .exe
--- * .bat
--- * .dll
--- * .zip
--- * .mp3
--- * .swf
global interface VHTML is GPanel
    --- Called when the page inside the HTML window runs the `console.log` javascript function.
    --- On the x86-64 beta, it's called for all built-in `console.*` javascript functions.
    --- Overwriting this function in any way will disable default behavior of printing the message to the in-game console.
    -- @param msg --- The message to be logged (or Lua code to be executed; see above).
    -- @param file --- The message source file, if any.
    -- @param lineNr --- The line number in the file the message was output from.
    -- @param severity --- The severity of the message. Possible values are:
    --- * "log"
    --- * "warn"
    --- * "error"
    --- * "debug"
    ConsoleMessage: function(self, msg: string, file: string, lineNr: number, severity: string)

    --- Called when this panel begins loading a page.
    -- @param url --- The URL of the current page.
    OnBeginLoadingDocument: function(self, url: string)

    --- Called by the engine when a callback function is called.
    -- @param library --- Library name of the JS function that was called.
    -- @param name --- Name of the JS function that was called.
    -- @param arguments --- Table containing all arguments passed to the JS function.
    -- @return --- Return `true` to suppress default engine action.
    OnCallback: function(self, library: string, name: string, arguments: table): boolean

    --- Called when this panel's address changes.
    -- @param url --- The URL of the new page.
    OnChangeAddressBar: function(self, url: string)

    --- Called by HTML panels when the target URL of the frame has changed, this happens when you hover over a link.
    -- @param url --- New target URL.
    OnChangeTargetURL: function(self, url: string)

    --- Called by HTML panels when the title of the loaded page has been changed.
    -- @param newTitle --- The new title of the page.
    OnChangeTitle: function(self, newTitle: string)

    --- Called by HTML panels when the page attempts to open a new child view (such as a popup or new tab).
    -- @param sourceURL --- The URL of the page requesting to create a child.
    -- @param targetURL --- The URL of the requested child.
    -- @param isPopup --- True if the requested view is a popup.
    OnChildViewCreated: function(self, sourceURL: string, targetURL: string, isPopup: boolean)

    --- Called by HTML panels when the panel's DOM has been set up. You can run JavaScript in here.
    -- @param url --- The URL of the current page.
    OnDocumentReady: function(self, url: string)

    --- Called when this panel successfully loads a page.
    -- @param url --- The URL of the current page.
    OnFinishLoadingDocument: function(self, url: string)
end

--- A grid for editing the properties of something using names and values. Properties can be categorized and strongly typed.
--- ##  Associated controls
--- * DProperty_VectorColor
--- * DProperty_Boolean
--- * DProperty_Generic
--- * DProperty_Combo
--- * DProperty_Float
--- * DProperty_Int
global interface DProperties is GPanel
    --- Returns the DScrollPanel all the properties panels are attached to.
    -- @return --- A DScrollPanel canvas
    GetCanvas: function(self): GPanel

    --- **INTERNAL**:
    --- Returns (or creates) a category of properties.
    --- See DProperties:CreateRow for adding actual properties.
    -- @param name --- Name of the category
    -- @param create --- Create a new category if it doesn't exist.
    -- @return --- An internal panel.
    GetCategory: function(self, name: string, create: boolean): GPanel
end

--- DIconLayout is what replaced DPanelList in Garry's Mod 13.
--- DPanelList still exists in GMod but is deprecated and does not support the new GWEN skin.
--- DIconLayout is used to make a list of panels.
--- Unlike DPanelList, DIconLayout does not automatically add a scroll bar - the example below shows you how you can do this.
global interface DIconLayout is DDragBase
    --- Creates a replica of the DIconLayout it is called on.
    -- @return --- The replica.
    Copy: function(self): GPanel

    --- Copies the contents (Child elements) of another DIconLayout to itself.
    -- @param from --- DIconLayout to copy from.
    CopyContents: function(self, from: GPanel)

    --- Returns the size of the border.
    -- @return ---
    GetBorder: function(self): number

    --- Returns the direction that it will be layed out, using the DOCK enumerations.
    -- @return --- Layout direction.
    GetLayoutDir: function(self): number

    --- Returns the distance between two 'icons' on the X axis.
    -- @return --- Distance between two 'icons' on the X axis.
    GetSpaceX: function(self): number

    --- Returns distance between two "Icons" on the Y axis.
    -- @return --- distance between two "Icons" on the Y axis.
    GetSpaceY: function(self): number

    --- Returns whether the icon layout will stretch its height to fit all the children.
    --- See also DIconLayout:GetStretchWidth
    -- @return ---
    GetStretchHeight: function(self): boolean

    --- Returns whether the icon layout will stretch its width to fit all the children.
    --- See also DIconLayout:GetStretchHeight
    -- @return ---
    GetStretchWidth: function(self): boolean

    --- Resets layout vars before calling Panel:InvalidateLayout. This is called when children are added or removed, and must be called when the spacing, border or layout direction is changed.
    Layout: function(self)

    --- **INTERNAL**:
    --- Used internally to layout the child elements if the DIconLayout:SetLayoutDir is set to LEFT (See Enums/DOCK).
    LayoutIcons_LEFT: function(self)

    --- **INTERNAL**:
    --- Used internally to layout the child elements if the DIconLayout:SetLayoutDir is set to TOP (See Enums/DOCK).
    LayoutIcons_TOP: function(self)

    --- Called when the panel is modified.
    OnModified: function(self)

    --- Sets the internal border (padding) within the DIconLayout. This will not change its size, only the positioning of children. You must call DIconLayout:Layout in order for the changes to take effect.
    -- @param width --- The border (padding) inside the DIconLayout.
    SetBorder: function(self, width: number)

    --- Sets the direction that it will be layed out, using the Enums/DOCK.
    --- Currently only TOP and LEFT are supported.
    -- @param direction --- Enums/DOCK
    SetLayoutDir: function(self, direction: number)

    --- Sets the horizontal (x) spacing between children within the DIconLayout. You must call DIconLayout:Layout in order for the changes to take effect.
    -- @param xSpacing --- The width of the gap between child objects.
    SetSpaceX: function(self, xSpacing: number)

    --- Sets the vertical (y) spacing between children within the DIconLayout. You must call DIconLayout:Layout in order for the changes to take effect.
    -- @param ySpacing --- The vertical gap between rows in the DIconLayout.
    SetSpaceY: function(self, ySpacing: number)

    --- If set to true, the icon layout will stretch its height to fit all the children.
    --- See also DIconLayout:SetStretchWidth
    -- @param do_stretch ---
    SetStretchHeight: function(self, do_stretch: boolean)

    --- If set to true, the icon layout will stretch its width to fit all the children.
    --- See also DIconLayout:SetStretchHeight
    -- @param stretchW ---
    SetStretchWidth: function(self, stretchW: boolean)
end

--- Creates a slider that can be moved along the X and/or Y axis
global interface DSlider is GPanel
    --- **INTERNAL**:
    --- Used internally to set the X axis convar.
    ConVarXNumberThink: function(self)

    --- **INTERNAL**:
    --- Used internally to set the Y axis convar.
    ConVarYNumberThink: function(self)

    --- Identical to DSlider:IsEditing
    -- @return ---
    GetDragging: function(self): boolean

    --- Returns the draggable panel's lock on the X axis.
    --- See DSlider:SetLockX for more info.
    -- @return ---
    GetLockX: function(self): number

    --- Returns the draggable panel's lock on the Y axis.
    --- See DSlider:SetLockY for more info.
    -- @return ---
    GetLockY: function(self): number

    --- @deprecated
    --- **DEPRECATED**: Does not affect anything by default.
    --- Returns the current notch color, set by DSlider:SetNotchColor
    -- @return clr --- The current color
    GetNotchColor: function(self): GColor

    --- @deprecated
    --- **DEPRECATED**:
    --- Appears to be non functioning, however is still used by panels such as DNumSlider.
    -- @return ---
    GetNotches: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- @return ---
    GetNumSlider: function(self): any

    --- Returns the target position of the draggable "knob" panel of the slider on the X axis.
    --- Set by DSlider:SetSlideX.
    -- @return --- The value range seems to be from 0 to 1
    GetSlideX: function(self): number

    --- Returns the target position of the draggable "knob" panel of the slider on the Y axis.
    --- Set by DSlider:SetSlideY.
    -- @return --- The value range seems to be from 0 to 1
    GetSlideY: function(self): number

    --- Returns the value set by DSlider:SetTrapInside.
    -- @return ---
    GetTrapInside: function(self): boolean

    --- Returns true if this element is being edited by the player.
    -- @return ---
    IsEditing: function(self): boolean

    --- Called when the values of this slider panel were changed.
    -- @param x --- The X axis position of the slider in range 0-1
    -- @param y --- The Y axis position of the slider in range 0-1
    OnValueChanged: function(self, x: number, y: number)

    --- **INTERNAL**:
    --- Used internally to fire DSlider:OnValueChanged
    OnValuesChangedInternal: function(self)

    --- This function is called by the DSlider when user middle mouse clicks on the draggable knob of the slider.
    --- You are meant to override this function to do reset the slider to desired defaults on both axes.
    --- By default, will reset the slider to `0.5` on both axes.
    ResetToDefaultValue: function(self)

    --- Sets the background for the slider.
    -- @param path --- Path to the image.
    SetBackground: function(self, path: string)

    --- Sets the ConVar to be set when the slider changes on the X axis.
    -- @param convar --- Name of the convar to set.
    SetConVarX: function(self, convar: string)

    --- Sets the ConVar to be set when the slider changes on the Y axis.
    -- @param convar --- Name of the convar to set.
    SetConVarY: function(self, convar: string)

    --- **INTERNAL**:
    --- Sets whether or not the slider is being dragged.
    -- @param dragging ---
    SetDragging: function(self, dragging: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    SetImage: function(self)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    SetImageColor: function(self)

    --- Sets the lock on the X axis.
    --- For example the value 0.5 will lock the draggable panel to half the width of the slider's panel.
    -- @param lockX --- Set to nil to reset lock.
    --- The value range is from 0 to 1.
    SetLockX: function(self, lockX: number)

    --- Sets the lock on the Y axis.
    --- For example the value 0.5 will lock the draggable panel to half the height of the slider's panel.
    -- @param lockY --- Set to nil to reset lock.
    --- The value range is from 0 to 1.
    SetLockY: function(self, lockY: number)

    --- @deprecated
    --- **DEPRECATED**: Does not affect anything by default.
    --- Sets the current notch color, overriding the color set by the derma skin.
    -- @param clr --- The new color to set
    SetNotchColor: function(self, clr: GColor)

    --- @deprecated
    --- **DEPRECATED**:
    --- Appears to be non functioning, however is still used by panels such as DNumSlider.
    -- @param notches ---
    SetNotches: function(self, notches: number)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- @param slider ---
    SetNumSlider: function(self, slider: any)

    --- Used to position the draggable panel of the slider on the X axis.
    -- @param x --- The value range seems to be from 0 to 1
    SetSlideX: function(self, x: number)

    --- Used to position the draggable panel of the slider on the Y axis.
    -- @param y --- The value range seems to be from 0 to 1
    SetSlideY: function(self, y: number)

    --- Makes the slider itself, the "knob", trapped within the bounds of the slider panel. Example:
    --- <upload src="70c/8dafb0260022da3.png" size="6257" name="image.png">
    --- </upload>
    -- @param trap ---
    SetTrapInside: function(self, trap: boolean)

    --- For override by child panels, such as DNumSlider. Allows changing the output values of the slider.
    -- @param x --- The input X coordinate, in range of 0-1.
    -- @param y --- The input Y coordinate, in range of 0-1.
    -- @return --- The output X coordinate, in range of 0-1.
    -- @return --- The output X coordinate, in range of 0-1.
    TranslateValues: function(self, x: number, y: number): number, number
end

--- DModelPanel is a VGUI element that projects a 3D model onto a 2D plane. See also DAdjustableModelPanel
global interface DModelPanel is DButton
    --- **INTERNAL**:
    ---  Used by the DModelPanel's paint hook to draw the model and background.
    DrawModel: function(self)

    --- Returns the ambient lighting used on the rendered entity.
    -- @return --- The color of the ambient lighting.
    GetAmbientLight: function(self): table

    --- Returns the animation speed of the panel entity, see DModelPanel:SetAnimSpeed.
    -- @return --- The animation speed.
    GetAnimSpeed: function(self): number

    --- Returns whether or not the panel entity should be animated when the default DModelPanel:LayoutEntity function is called.
    -- @return --- True if the panel entity can be animated with Entity:SetSequence directly, false otherwise.
    GetAnimated: function(self): boolean

    --- Returns the position of the model viewing camera.
    -- @return --- The position of the camera.
    GetCamPos: function(self): GVector

    --- Returns the color of the rendered entity.
    -- @return --- The color of the entity, see Color.
    GetColor: function(self): table

    --- Returns the entity being rendered by the model panel.
    -- @return --- The rendered entity (client-side)
    GetEntity: function(self): GCSEnt

    --- Returns the FOV (field of view) the camera is using.
    -- @return --- The FOV of the camera.
    GetFOV: function(self): number

    --- Returns the angles of the model viewing camera. Is **nil** until changed with DModelPanel:SetLookAng.
    -- @return --- The angles of the camera.
    GetLookAng: function(self): GAngle

    --- Returns the position the viewing camera is pointing toward.
    -- @return --- The position the camera is pointing toward.
    GetLookAt: function(self): GVector

    --- Gets the model of the rendered entity.
    -- @return --- The model of the rendered entity.
    GetModel: function(self): string

    --- By default, this function slowly rotates and animates the entity being rendered.
    --- If you want to change this behavior, you should override it.
    -- @param entity --- The entity that is being rendered.
    LayoutEntity: function(self, entity: GEntity)

    --- Called when the entity of the DModelPanel was drawn.
    --- This is a rendering hook with 3d drawing context.
    -- @param ent --- The clientside entity of the DModelPanel that has been drawn.
    PostDrawModel: function(self, ent: GEntity)

    --- Called **before** the entity of the DModelPanel is drawn.
    -- @param ent --- The clientside entity of the DModelPanel that has been drawn.
    -- @return --- Return false to stop the entity from being drawn. This will also cause DModelPanel:PostDrawModel to stop being called.
    PreDrawModel: function(self, ent: GEntity): boolean

    --- This function is used in DModelPanel:LayoutEntity. It will progress the animation, set using Entity:SetSequence. By default, it is the walking animation.
    RunAnimation: function(self)

    --- Sets the ambient lighting used on the rendered entity.
    -- @param color --- The color of the ambient lighting.
    SetAmbientLight: function(self, color: table)

    --- Sets the speed used by DModelPanel:RunAnimation to advance frame on an entity sequence.
    --- **NOTE**: Entity:FrameAdvance doesn't seem to have any functioning arguments and therefore changing this will not have any affect on the panel entity's sequence speed without reimplementation. It only affects the value returned by DModelPanel:GetAnimSpeed
    -- @param animSpeed --- The animation speed.
    SetAnimSpeed: function(self, animSpeed: number)

    --- Sets whether or not to animate the entity when the default DModelPanel:LayoutEntity is called.
    -- @param animated --- True to animate, false otherwise.
    SetAnimated: function(self, animated: boolean)

    --- Sets the position of the camera.
    -- @param pos --- The position to set the camera at.
    SetCamPos: function(self, pos: GVector)

    --- Sets the color of the rendered entity.
    --- **NOTE**: This does not work on Garry's Mod player models since they use a different color system. To modify a player model color, see Example 2 on the DModelPanel page
    -- @param color --- The render color of the entity.
    SetColor: function(self, color: table)

    --- Sets the directional lighting used on the rendered entity.
    -- @param direction --- The light direction, see Enums/BOX.
    -- @param color --- The color of the directional lighting.
    SetDirectionalLight: function(self, direction: number, color: table)

    --- Sets the entity to be rendered by the model panel.
    --- **NOTE**: If you set `ent` to a shared entity you must set `ent` to nil before removing this panel or else a "Trying to remove server entity on client!" error is thrown
    -- @param ent --- The new panel entity.
    SetEntity: function(self, ent: GEntity)

    --- Sets the panel camera's FOV (field of view).
    -- @param fov --- The field of view value.
    SetFOV: function(self, fov: number)

    --- Sets the angles of the camera.
    -- @param ang --- The angles to set the camera to.
    SetLookAng: function(self, ang: GAngle)

    --- Makes the panel's camera face the given position. Basically sets the camera's angles (DModelPanel:SetLookAng) after doing some math.
    -- @param pos --- The position to orient the camera toward.
    SetLookAt: function(self, pos: GVector)

    --- Sets the model of the rendered entity.
    --- **NOTE**: This function may give a different model than expected. This is not a bug, however this problem may appear with some player models which are renamed several times in a wrong way. To solve that, you can use Entity:SetModel and Entity:SetModelName on the internal panel entity. More information : https://github.com/Facepunch/garrysmod-issues/issues/4534.
    -- @param model --- The model to apply to the entity.
    SetModel: function(self, model: string)

    --- Runs a Global.ClientsideScene on the panel's entity.
    -- @param path --- The path to the scene file. (.vcd)
    StartScene: function(self, path: string)
end

--- A field with multiple selectable values.
global interface DComboBox is DButton
    --- Adds a choice to the combo box.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L138-L158)
    -- @param value --- The text show to the user.
    -- @param data --- The data accompanying this string. If left empty, the value argument is used instead.
    --- Can be accessed with the second argument of DComboBox:GetSelected, DComboBox:GetOptionData and as an argument of DComboBox:OnSelect.
    -- @param select --- Should this be the default selected text show to the user or not.
    -- @param icon --- Adds an icon for this choice.
    -- @return --- The index of the new option.
    AddChoice: function(self, value: string, data: any, select: boolean, icon: string): number

    --- Adds a spacer below the currently last item in the drop down. Recommended to use with DComboBox:SetSortItems set to `false`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L132-L136)
    AddSpacer: function(self)

    --- **INTERNAL**:
    --- Ran every frame to update the value of this panel to the value of the associated convar. See Panel:SetConvar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L247-L258)
    CheckConVarChanges: function(self)

    --- Selects a combo box option by its index and changes the text displayed at the top of the combo box.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L85-L97)
    -- @param value --- The text to display at the top of the combo box.
    -- @param index --- The option index.
    ChooseOption: function(self, value: string, index: number)

    --- Selects an option within a combo box based on its table index.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L99-L104)
    -- @param index --- Selects the option with given index.
    ChooseOptionID: function(self, index: number)

    --- Clears the combo box's text value, choices, and data values.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L29-L40)
    Clear: function(self)

    --- Closes the combo box menu. Called when the combo box is clicked while open.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L236-L244)
    CloseMenu: function(self)

    --- Returns an option's data based on the given index.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L48-L52)
    -- @param index --- The option index.
    -- @return --- The option's data value.
    GetOptionData: function(self, index: number): any

    --- Returns an option's text based on the given index.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L42-L46)
    -- @param index --- The option index.
    -- @return --- The option's text value.
    GetOptionText: function(self, index: number): string

    --- Returns an option's text based on the given data.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L54-L72)
    -- @param data --- The data to look up the name of.
    --- If given a number and no matching data was found, the function will test given data against each Global.tonumber'd data entry.
    -- @return --- The option's text value.
    --- If no matching data was found, the data itself will be returned. If multiple identical data entries exist, the first instance will be returned.
    GetOptionTextByData: function(self, data: string): string

    --- Returns the currently selected option's text and data
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L112-L118)
    -- @return --- The option's text value.
    -- @return --- The option's stored data.
    GetSelected: function(self): string, any

    --- Returns the index (ID) of the currently selected option.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L106-L110)
    -- @return --- The ID of the currently selected option.
    GetSelectedID: function(self): number

    --- An Global.AccessorFunc that returns an whether the items in the dropdown will be alphabetically sorted or not.
    --- See DComboBox:SetSortItems.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L8)
    -- @return --- True if enabled, false otherwise.
    GetSortItems: function(self): boolean

    --- Returns whether or not the combo box's menu is opened.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L170-L174)
    -- @return --- True if the menu is open, false otherwise.
    IsMenuOpen: function(self): boolean

    --- Called when the player opens the dropdown menu. For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L126-L130)
    -- @param menu --- The DMenu menu panel.
    OnMenuOpened: function(self, menu: GPanel)

    --- Called when an option in the combo box is selected. This function does nothing by itself, you're supposed to overwrite it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L120-L124)
    -- @param index --- The index of the option for use with other DComboBox functions.
    -- @param value --- The name of the option.
    -- @param data --- The data assigned to the option.
    OnSelect: function(self, index: number, value: string, data: any)

    --- Opens the combo box drop down menu. Called when the combo box is clicked.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L176-L234)
    OpenMenu: function(self)

    --- Removes a choice added with DComboBox:AddChoice
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L160-L168)
    -- @param index --- The index of the option to remove.
    -- @return text --- The text of the removed option.
    -- @return data --- The data of the removed option that was provided.
    RemoveChoice: function(self, index: number): string, any

    --- An Global.AccessorFunc that sets whether or not the items should be sorted alphabetically in the dropdown menu of the DComboBox. If set to false, items will appear in the order they were added by DComboBox:AddChoice calls.
    --- This is enabled by default.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L8)
    -- @param sort --- true to enable, false to disable
    SetSortItems: function(self, sort: boolean)

    --- Sets the text shown in the combo box when the menu is not collapsed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcombobox.lua#L266-L270)
    -- @param value --- The text in the DComboBox.
    SetValue: function(self, value: string)
end

--- An easy form with functions to quickly add form elements
global interface DForm is DCollapsibleCategory
    --- Adds one or two items to the DForm.
    --- If this method is called with only one argument, it is added to the bottom of the form. If two arguments are passed, they are placed side-by-side at the bottom of the form.
    --- Internally, this function is used by the various DForm functions to, for example, add labels to the left of buttons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L42-L73)
    -- @param left --- Left-hand element to add to the DForm.
    -- @param right --- Right-hand element to add to the DForm.
    AddItem: function(self, left: GPanel, right: GPanel)

    --- Adds a DButton onto the DForm
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L254-L267)
    -- @param text --- The text on the button
    -- @param concommand --- The concommand to run when the button is clicked
    -- @param args --- The arguments to pass on to the concommand when the button is clicked
    -- @return --- The created DButton
    Button: function(self, text: string, concommand: string, ...: any): DButton

    --- Adds a DCheckBoxLabel onto the DForm.
    --- **NOTE**: This will run DCheckBoxLabel:OnChange when being added. This is caused by Panel:SetConVar being used when this function is used. To avoid this, use DForm:AddItem with a DCheckBoxLabel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L192-L203)
    -- @param label --- The label to be set next to the check box
    -- @param convar --- The console variable to change when this is changed
    -- @return --- The created DCheckBoxLabel
    CheckBox: function(self, label: string, convar: string): DCheckBoxLabel

    --- Adds a DComboBox onto the DForm
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L134-L152)
    -- @param title --- Text to the left of the combo box
    -- @param convar --- Console variable to change when the user selects something from the dropdown.
    -- @return --- The created DComboBox
    -- @return --- The created DLabel
    ComboBox: function(self, title: string, convar: string): DComboBox, DLabel

    --- Adds a DLabel onto the DForm. Unlike DForm:Help, this is indented and is colored blue, depending on the derma skin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L225-L247)
    -- @param help --- The help message to be displayed.
    -- @return --- The created DLabel
    ControlHelp: function(self, help: string): DLabel

    --- @deprecated
    --- **DEPRECATED**:
    --- An Accessor Function in DForm that does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L6)
    -- @return ---
    GetAutoSize: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L7)
    -- @return ---
    GetSpacing: function(self): number

    --- Adds a DLabel onto the DForm as a helper
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L205-L223)
    -- @param help --- The help message to be displayed
    -- @return --- The created DLabel
    Help: function(self, help: string): DLabel

    --- Adds a DListBox onto the DForm
    --- @deprecated
    --- **DEPRECATED**: Use DListView with DForm:AddItem instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L277-L295)
    -- @param label --- The label to set on the DListBox
    -- @return --- The created DListBox
    -- @return --- The created DLabel if label string was specified
    ListBox: function(self, label: string): DListBox, DLabel

    --- Adds a DNumSlider onto the DForm
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L174-L190)
    -- @param label --- A short label for the slider.
    -- @param convar --- The [console variable](ConVars) to change when the slider is changed
    -- @param min --- The minimum value of the slider
    -- @param max --- The maximum value of the slider
    -- @param decimals --- The number of decimals to allow for the slider value.
    -- @return --- The created DNumSlider.
    NumSlider: function(self, label: string, convar: string, min: number, max: number, decimals: number): DNumSlider

    --- Adds a DNumberWang onto the DForm
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L154-L172)
    -- @param label --- The label to be placed next to the DNumberWang
    -- @param convar --- The console variable to change when the slider is changed
    -- @param min --- The minimum value of the slider
    -- @param max --- The maximum value of the slider
    -- @param decimals --- The number of decimals to allow in the slider (Optional)
    -- @return --- The created DNumberWang
    -- @return --- The created DLabel
    NumberWang: function(self, label: string, convar: string, min: number, max: number, decimals: number): DNumberWang, DLabel

    --- @deprecated
    --- **DEPRECATED**: This is derived from the deprecated DPanelSelect.
    --- Creates a DPanelSelect and docks it to the top of the DForm.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L269-L275)
    -- @return --- The created DPanelSelect.
    PanelSelect: function(self): DPanelSelect

    --- Creates a PropSelect panel and docks it to the top of the DForm.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L91-L132)
    -- @param label --- The label to display above the prop select.
    -- @param convar --- The convar to set the selected model to.
    -- @param models --- A table of models to display for selection. Supports 2 formats:
    --- 1) Key is the model and value are the convars to set when that model is selected in format `convar=value`
    --- 2) An table of tables where each table must have the following keys:
    --- * string model - The model.
    --- * number skin - Model's skin. Defaults to 0
    --- * string tooltip - Displayed when user hovers over the model. Defaults to the model path.
    --- * The key of the table is the value of the convar.
    -- @param height --- The height of the prop select panel, in 64px icon increments.
    -- @return --- The created PropSelect panel.
    PropSelect: function(self, label: string, convar: string, models: table, height: number): VPropSelect

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L297-L298)
    Rebuild: function(self)

    --- @deprecated
    --- **DEPRECATED**:
    --- an Global.AccessorFunc that does nothing
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L6)
    -- @param None ---
    SetAutoSize: function(self, _: boolean)

    --- Sets the title (header) name of the DForm. This is `Label` until set.
    --- @deprecated
    --- **DEPRECATED**: This is an alias of derived DCollapsibleCategory:SetLabel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L24-L28)
    -- @param name --- The new header name.
    SetName: function(self, name: string)

    --- @deprecated
    --- **DEPRECATED**:
    --- An Global.AccessorFunc that does nothing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L7)
    -- @param None ---
    SetSpacing: function(self, _: number)

    --- Adds a DTextEntry to a DForm
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dform.lua#L75-L89)
    -- @param label --- The label to be next to the text entry
    -- @param convar --- The console variable to be changed when the text entry is changed
    -- @return --- The created DTextEntry
    -- @return --- The created DLabel
    TextEntry: function(self, label: string, convar: string): DTextEntry, DLabel
end

--- A simple Derma Drawer
global interface DDrawer is GPanel
    --- Closes the DDrawer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L68-L76)
    Close: function(self)

    --- An Global.AccessorFunc that returns the Open Size of DDrawer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L4)
    -- @return --- Open size.
    GetOpenSize: function(self): number

    --- An Global.AccessorFunc that returns the Open Time of DDrawer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L5)
    -- @return --- Time in seconds.
    GetOpenTime: function(self): number

    --- Opens the DDrawer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L58-L66)
    Open: function(self)

    --- An Global.AccessorFunc that sets the height of DDrawer
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L4)
    -- @param Value --- Height of DDrawer. Default is `100`.
    SetOpenSize: function(self, Value: number)

    --- An Global.AccessorFunc that sets the time (in seconds) for DDrawer to open.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L5)
    -- @param value --- Length in seconds. Default is 0.3
    SetOpenTime: function(self, value: number)

    --- Toggles the DDrawer.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/ddrawer.lua#L48-L56)
    Toggle: function(self)
end

--- An editable DLabel, double click on it to edit.
--- This is used in the spawnmenu spawnlist headers.
global interface DLabelEditable is DLabel
    --- Returns whether the editable label will stretch to the text entered or not.
    -- @return --- Whether the editable label will stretch to the text entered or not.
    GetAutoStretch: function(self): boolean

    --- Returns whether this DLabelEditable is being edited or not. (i.e. has focus)
    -- @return --- Whether this DLabelEditable is being edited or not
    IsEditing: function(self): boolean

    --- A hook called when the player presses Enter (i.e. the finished editing the label) and the text has changed.
    --- Allows you to override/modify the text that will be set to display.
    -- @param txt --- The original user input text
    -- @return --- If provided, will override the text that will be applied to the label itself.
    OnLabelTextChanged: function(self, txt: string): string

    --- Sets whether the editable label should stretch to the text entered or not.
    -- @param stretch --- Whether the editable label should stretch to the text entered or not.
    SetAutoStretch: function(self, stretch: boolean)
end

--- A window that is used to publish dupes and saves
global interface VUGCPublishWindow is DFrame

end

--- A panel capable of loading `.tga` images.
global interface VTGAImage is GPanel

end

--- The default SpawnmenuContentPanel
--- **INTERNAL**:
global interface VSpawnmenuContentPanel is DPanel
    --- Changes the Spawnmenu category to search in
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/content.lua#L52-L56)
    -- @param hookname --- The Hook name
    CallPopulateHook: function(self, hookname: string)

    --- Allows the modification of the ContentSidebar
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/content.lua#L44-L46)
    EnableModify: function(self)

    --- Changes the Spawnmenu category to search in
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/content.lua#L48-L50)
    -- @param category --- The category
    -- @param hookname --- The Hook name
    EnableSearch: function(self, category: string, hookname: string)

    --- Switches the current panel with the given panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/content.lua#L58-L75)
    -- @param panel --- Panel to switch to
    SwitchPanel: function(self, panel: GPanel)
end

--- A "spawn icon" displays an image for the given model path.
--- It is mostly used in the Spawn Menu (``).
--- It uses ModelImage internally.
global interface VSpawnIcon is DButton
    --- Returns the currently active Sub Model IDs for each Body Group of the spawn icon.
    --- This is set by SpawnIcon:SetBodyGroup.
    -- @return --- The Body Groups of the spawnicon
    GetBodyGroup: function(self): string

    --- Returns the currently set model name. This is set by SpawnIcon:SetModelName.
    -- @return --- The model name
    GetModelName: function(self): string

    --- Returns the currently set skin of the spawnicon. This is set by SpawnIcon:SetSkinID.
    -- @return --- Current skin ID
    GetSkinID: function(self): number

    --- Called when right clicked on the SpawnIcon. It will not be called if there is a selection (Panel:GetSelectionCanvas), in which case SANDBOX:SpawnlistOpenGenericMenu is called.
    OpenMenu: function(self)

    --- **INTERNAL**: This is done automatically by SpawnIcon. You do not need to call this. Doing so may cause unforeseen consequences.
    --- Sets the active Sub Model ID for the given Body Group 		ID, so it can be retrieved with SpawnIcon:GetBodyGroup.
    --- Use Panel:SetModel instead.
    -- @param bodyGroupId --- The Body Group ID to set the active Sub Model ID for.
    --- Body Group IDs start at `0`.
    -- @param activeSubModelId --- The Sub Model ID to set as active.
    --- Sub Model IDs start at `0`.
    SetBodyGroup: function(self, bodyGroupId: number, activeSubModelId: number)

    --- **INTERNAL**: This is done automatically by SpawnIcon. You do not need to call this. Doing so may cause unforeseen consequences.
    --- Sets the model name, so it can be retrieved with SpawnIcon:GetModelName. Use Panel:SetModel instead.
    -- @param mdl --- The model name to set
    SetModelName: function(self, mdl: string)

    --- **INTERNAL**: This is done automatically by SpawnIcon. You do not need to call this. Doing so may cause unforeseen consequences.
    --- Sets the skin id of the spawn icon, so it can be retrieved with SpawnIcon:GetSkinID. Use Panel:SetModel instead.
    -- @param skin --- Skin ID to set
    SetSkinID: function(self, skin: number)
end

--- @deprecated
--- **DEPRECATED**: Only exists for backwards compatibility with Panel:SetActionFunction and Panel:PostMessage.
--- Use DNumSlider instead.
--- A simple slider featuring an numeric display.
global interface VSlider is GPanel

end

--- Used as scroll bar for PanelList
--- @deprecated
--- **DEPRECATED**: Used in deprecated  PanelList. Use DVScrollBar (Used in DScrollPanel).
global interface VSlideBar is GPanel

end

--- A very versatile text display element that's used to power the default chat and console.
--- Rich Text panels allows multicolored, highlight-able, and interactive text using individual text segment markup (segments are defined by the Panel:AppendText method).
--- The **RichText** element has a `64000` character limit.
--- You can hide the RichText scrollbar with the following function: Panel:SetVerticalScrollbarEnabled
global interface VRichText is GPanel

end

--- **INTERNAL**:
--- @deprecated
--- **DEPRECATED**:
--- Currently there are no functions to retrieve checked state of a Radio Button, and their visuals are seemingly broken.
global interface VRadioButton is GPanel

end

--- Used in Sandbox tools to allow the player to select models out of a list. Despite being only used in Sandbox, it is **not** exclusive to that gamemode.
--- See also MatSelect for the material selecting alternative.
global interface VPropSelect is VContextBase
    --- Adds a new model to the selection list.
    -- @param model --- Model path, **including** `models/` and `.mdl`.
    -- @param convars --- A list of convar names (as keys) and their values to set when the user selects this model.
    AddModel: function(self, model: string, convars: table)

    --- Adds a new model to the selection list.
    -- @param value --- The "value" for this model, which is used to set the ContextBase:SetConVar.
    -- @param model --- Model path, **including** `models/` and `.mdl`.
    -- @param skin --- The skin number for this model. It will **not** be set to the convar, use the value argument to track skin-model combos.
    AddModelEx: function(self, value: string, model: string, skin: number)

    --- Find and select a SpawnIcon panel based on the input model path.
    -- @param mdl --- The model to find and select within this PropSelect.
    FindAndSelectButton: function(self, mdl: string)

    --- Find a SpawnIcon panel based on the input model path.
    -- @param mdl --- The model to find within this PropSelect.
    -- @return --- The found spawnicon, or `nil`.
    FindModelByValue: function(self, mdl: string): VSpawnIcon

    --- If set to above 0, automatically stretches the panel to fit this many rows. Default is 2.
    --- If 0 or below, it will automatically stretch to fit all rows.
    Height: number

    --- Called when the player right clicks a model.
    --- By default, this opens a menu that lets the player copy the model path.
    -- @param pnl --- The Spawnicon that was clicked.
    OnRightClick: function(self, pnl: GPanel)

    --- Called when the player selects a model.
    -- @param pnl --- The Spawnicon that was clicked.
    -- @param model --- Path of the selected model, or its "value".
    OnSelect: function(self, pnl: GPanel, model: string)

    --- **INTERNAL**: Use PropSelect:FindAndSelectButton instead.
    --- Selects a given spawnicon panel.
    -- @param icon --- The spawnicon to select, retrieved via PropSelect:FindModelByValue.
    SelectModel: function(self, icon: VSpawnIcon)
end

--- **INTERNAL**:
--- A preset editor, which can be opened by ControlPresets.
--- This control only exists in Sandbox derived gamemodes.
global interface VPresetEditor is DFrame

end

--- A panel list with a custom vertical scroll bar that doesn't have up/down buttons and has a momentum to scrolling.
--- @deprecated
--- **DEPRECATED**: You should use DScrollPanel instead
global interface VPanelList is GPanel

end

--- **INTERNAL**:
--- Panel used to display models, used by SpawnIcon.
global interface VModelImage

end

--- The panel used by Material & Lamp Sandbox tools for texture selection. Despite being only used in Sandbox, it is **not** exclusive to that gamemode.
--- See also PropSelect for the prop selecting alternative.
global interface VMatSelect is VContextBase
    --- Adds a new material to the selection list.
    -- @param label --- Tooltip for the material, for when the player hovers over the material.
    -- @param path --- Path to the material. Relative to `materials/` folder (do not include it), and do not include the `.vmt` extension.
    AddMaterial: function(self, label: string, path: string)

    --- Adds a new material to the selection list, with some extra options.
    -- @param label --- Tooltip for the material, for when the player hovers over the material.
    -- @param path --- Path to the material. Relative to `materials/` folder (do not include it), and do not include the `.vmt` extension.
    -- @param value --- Overrides the "value" of the material. This will be what MatSelect:OnSelect receives in the first argument. It also affects MatSelect:FindMaterialByValue.
    -- @param convars --- A list of convar names (as keys) and their values to set when the user selects this material. ContextBase:SetConVar will be ignored.
    AddMaterialEx: function(self, label: string, path: string, value: any, convars: table)

    --- Find a material and selects it, if it exists in this panel.
    -- @param mat --- The material to find and select within this MatSelect.
    FindAndSelectMaterial: function(self, mat: string)

    --- Find a DImageButton panel based on the input material path.
    -- @param mat --- The material to find within this MatSelect.
    -- @return --- The found material, or nil.
    FindMaterialByValue: function(self, mat: string): DImageButton

    --- Returns whether the panel would set its own height to fit all materials within its height.
    -- @return autoSize --- `true` = auto size itself.
    GetAutoHeight: function(self): boolean

    --- Called when the player right clicks a material.
    --- By default, this opens a menu that lets the player copy the material path.
    -- @param pnl --- The DImageButton that was clicked.
    OnRightClick: function(self, pnl: GPanel)

    --- Called when the player selects a material.
    -- @param material --- Material path of the selected material, not including any file extension.
    -- @param pnl --- The DImageButton that was clicked.
    OnSelect: function(self, material: string, pnl: GPanel)

    --- **INTERNAL**: Use MatSelect:FindAndSelectMaterial instead.
    --- Selects a given material panel.
    -- @param mat --- The material to select, found by MatSelect:FindMaterialByValue
    SelectMaterial: function(self, mat: DImageButton)

    --- Defines a paint over function for a DImageButton when it is selected.
    --- **WARNING**: `self` in the context of this function is the DImageButton!
    -- @param w --- Width of the DImageButton panel.
    -- @param h --- Height of the DImageButton panel.
    SelectedItemPaintOver: function(self, w: number, h: number)

    --- Sets whether the panel should set its own height to fit all materials within its height.
    -- @param autoSize --- If `true`, auto size itself.
    SetAutoHeight: function(self, autoSize: boolean)

    --- Sets the height of a single material in pixels.
    -- @param height  --- The height of the material, in pixels. Default is `128`.
    SetItemHeight: function(self, height_: number)

    --- Sets the width of a single material in pixels.
    -- @param width --- The width of the material, in pixels. Default is `128`.
    SetItemWidth: function(self, width: number)

    --- Sets the target height of the panel, in number of rows.
    -- @param rows --- Amount of rows to target the height to. Default is `2`.
    SetNumRows: function(self, rows: number)
end

--- Material is a VGUI element that renders a VMT material.
global interface VMaterial is VButton
    --- Sets the alpha value of the Material panel.
    -- @param alpha --- The alpha value, from 0 to 255.
    SetAlpha: function(self, alpha: number)

    --- Sets the material used by the panel.
    --- **NOTE**: If the material is not showing up as the correct size, try setting the Material panel's `AutoSize` variable to **false**
    -- @param matname --- The file path of the material to set (relative to "garrysmod/materials/").
    --SetMaterial: function(self, matname: string)
end

--- A checkbox panel similar to DCheckBox and DImageButton with customizable checked state image.
--- Uses the Material panel internally. Can't have a label.
--- **NOTE**: Will error if no material was set.
global interface VImageCheckBox is VButton
    --- Returns the checked state of the ImageCheckBox
    -- @return --- true for checked, false otherwise
    GetChecked: function(self): boolean

    --- Sets the checked state of the checkbox.
    --- Checked state can be obtained by ImageCheckBox.State.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/imagecheckbox.lua#L32-L36)
    -- @param OnOff --- true for checked, false otherwise
    Set: function(self, OnOff: boolean)

    --- Sets the checked state of the checkbox.
    --- Checked state can be obtained via ImageCheckBox:GetChecked
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/imagecheckbox.lua#L18-L24)
    -- @param bOn --- true for checked, false otherwise
    SetChecked: function(self, bOn: boolean)

    --- Sets the material that will be visible when the ImageCheckBox is checked.
    --- Internally calls Material:SetMaterial.
    --- **NOTE**: Will error if no material was set.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/imagecheckbox.lua#L4-L16)
    -- @param mat --- The file path of the material to set (relative to "garrysmod/materials/").
    --SetMaterial: function(self, mat: string)
end

--- An icon editor that permits a user to modify a SpawnIcon and re-render it. This is used by the spawn menu and is what is shown when you right-click an icon and select `Edit Icon`.
--- This makes use of the DAdjustableModelPanel element.
--- **NOTE**: This panel is only available in Sandbox and Sandbox derived gamemodes!
global interface VIconEditor is DFrame
    --- Applies the top-down view camera settings for the model in the DAdjustableModelPanel.
    --- Called when a user clicks the `Above` (third) button (See IconEditor).
    AboveLayout: function(self)

    --- Applies the best camera settings for the model in the DAdjustableModelPanel, using the values returned by Global.PositionSpawnIcon.
    --- Called when a user clicks the `wand` button (See the ) and when IconEditor:Refresh is called.
    BestGuessLayout: function(self)

    --- **INTERNAL**:
    ---  Fills the DListView on the left of the editor with the model entity's animation list. Called by IconEditor:Refresh.
    -- @param ent --- The entity being rendered within the model panel.
    FillAnimations: function(self, ent: GEntity)

    --- Applies the front view camera settings for the model in the DAdjustableModelPanel.
    --- Called when a user clicks the `Front` (second) button (See the ).
    FullFrontalLayout: function(self)

    --- Places the camera at the origin (0,0,0), relative to the entity, in the DAdjustableModelPanel.
    --- Called when a user clicks the `Center` (fifth) button (See the ).
    OriginLayout: function(self)

    --- Updates the internal DAdjustableModelPanel and SpawnIcon.
    --- This should be called immediately after setting the SpawnIcon with IconEditor:SetIcon.
    Refresh: function(self)

    --- Re-renders the SpawnIcon.
    --- Called when a user clicks the `RENDER` button, this retrieves the render data from the internal DAdjustableModelPanel and passes it as a table to Panel:RebuildSpawnIconEx.
    RenderIcon: function(self)

    --- Applies the right side view camera settings for the model in the DAdjustableModelPanel.
    --- Called when a user clicks the `Right` (fourth) button (See the ). (Note: The icon for this points left.)
    RightLayout: function(self)

    --- **INTERNAL**:
    ---  Sets up the default ambient and directional lighting for the DAdjustableModelPanel. Called by IconEditor:Refresh.
    SetDefaultLighting: function(self)

    --- Sets the editor's model and icon from an entity. Alternative to IconEditor:SetIcon, with uses a SpawnIcon.
    --- You do not need to call IconEditor:Refresh after this.
    -- @param ent --- The entity to retrieve the model and skin from.
    SetFromEntity: function(self, ent: GEntity)

    --- Sets the SpawnIcon to modify. You should call Panel:Refresh immediately after this, as the user will not be able to make changes to the icon beforehand.
    -- @param icon --- The SpawnIcon object to be modified.
    --SetIcon: function(self, icon: GPanel)

    --- **INTERNAL**:
    ---  Updates the entity being rendered in the internal DAdjustableModelPanel. Called by the model panel's DModelPanel:LayoutEntity method.
    -- @param ent --- The entity being rendered within the model panel.
    UpdateEntity: function(self, ent: GEntity)
end

--- @deprecated
--- **DEPRECATED**: You should use DFrame instead.
--- A window that in which you can place just about every other component and even another frame.
global interface VFrame is GPanel

end

--- **INTERNAL**: Used by the fingerposer panel.
--- A panel used by Sandbox's Finger Poser tool.
global interface VFingerVar is GPanel

end

--- **INTERNAL**:
--- A panel used by Sandbox's Finger Poser tool.
global interface Vfingerposer is VContextBase

end

--- A generic vertical scrollbar, used in DScrollPanel. See the horizontal alternative [here](DHScrollBar).
--- The scrollbar notably contains `DVScrollBar.btnUp`, `DVScrollBar.btnDown`, and `DVScrollBar.btnGrip` which are the up button, down button, and grip respectively. Editing the paint functions of these allows custom scrollbar styling (See DScrollPanel:GetVBar for an example), although it is a better idea to use [Derma Skins](Derma_Skin_Creation).
global interface DVScrollBar is GPanel
    --- Adds specified amount of scroll in pixels.
    -- @param add --- How much to scroll downwards. Can be negative for upwards scroll
    -- @return --- True if the scroll level was changed (i.e. if we did or did not scroll)
    AddScroll: function(self, add: number): boolean

    --- Smoothly scrolls to given level.
    -- @param scroll --- The scroll level to animate to. In pixels from the top ( from 0 )
    -- @param length --- Length of the animation in seconds
    -- @param delay --- Delay of the animation in seconds
    -- @param ease --- See Panel:NewAnimation for explanation.
    AnimateTo: function(self, scroll: number, length: number, delay: number, ease: number)

    --- Returns the scale of the scroll bar based on the difference in size between the visible "window" into the canvas that is being scrolled. Should be used after DVScrollBar:SetUp.
    -- @return --- The scale of the scrollbar.
    BarScale: function(self): number

    --- Returns whether or not the manual up/down scroll buttons are visible or not. Set by DVScrollBar:SetHideButtons.
    -- @return --- Whether or not the manual up/down scroll buttons are visible or not.
    GetHideButtons: function(self): boolean

    --- Returns the negative of DVScrollBar:GetScroll.
    -- @return --- The scroll offset.
    GetOffset: function(self): number

    --- Returns the amount of scroll level from the top in pixels
    -- @return --- The amount of scroll level from the top
    GetScroll: function(self): number

    --- **INTERNAL**:
    --- Called from within DScrollBarGrip
    Grip: function(self)

    --- Allows hiding the up and down buttons for better visual stylisation.
    -- @param hide --- True to hide
    SetHideButtons: function(self, hide: boolean)

    --- Sets the scroll level in pixels.
    -- @param scroll --- The new scroll value.
    SetScroll: function(self, scroll: number)

    --- Sets up the scrollbar for use.
    --- The scrollbar will automatically disable itself if the total height of the canvas is lower than the height of the panel that holds the canvas during this function call.
    -- @param barSize --- The size of the panel that holds the canvas, basically size of "1 page".
    -- @param canvasSize --- The total size of the canvas, this typically is the bigger number.
    SetUp: function(self, barSize: number, canvasSize: number)
end

--- Vertical version of DHorizontalDivider.
global interface DVerticalDivider is DPanel
    --- **INTERNAL**:
    --- Used internally to clamp the vertical divider to DVerticalDivider:GetTopMin and DVerticalDivider:GetBottomMin.
    DoConstraints: function(self)

    --- Returns the bottom content panel of the DVerticalDivider.
    -- @return --- The bottom content panel.
    GetBottom: function(self): GPanel

    --- Returns the minimum height of the bottom content panel.
    -- @return --- The minimum height of the bottom content panel.
    GetBottomMin: function(self): number

    --- Returns the height of the divider bar between the top and bottom content panels of the DVerticalDivider.
    -- @return --- The height of the divider bar.
    GetDividerHeight: function(self): number

    --- Returns whether the divider is being dragged or not.
    -- @return --- If true, mouse movement will alter the size of the divider.
    GetDragging: function(self): boolean

    --- **INTERNAL**:
    --- Returns the local Y position of where the user starts dragging the divider.
    -- @return --- The local Y position where divider dragging has started.
    GetHoldPos: function(self): number

    --- Returns the middle content panel of the DVerticalDivider.
    -- @return --- The middle content panel.
    GetMiddle: function(self): GPanel

    --- Returns the top content panel of the DVerticalDivider.
    -- @return --- The top content panel.
    GetTop: function(self): GPanel

    --- Returns the current height of the top content panel set by DVerticalDivider:SetTopHeight or by the user.
    -- @return --- The current height of the DVerticalDivider.
    GetTopHeight: function(self): number

    --- Returns the maximum height of the top content panel. See DVerticalDivider:SetTopMax for more information.
    -- @return --- The maximum height of the top content panel.
    GetTopMax: function(self): number

    --- Returns the minimum height of the top content panel.
    -- @return --- The minimum height of the top content panel.
    GetTopMin: function(self): number

    --- Sets the passed panel as the bottom content of the DVerticalDivider.
    -- @param pnl --- The panel to set as the bottom content.
    SetBottom: function(self, pnl: GPanel)

    --- Sets the minimum height of the bottom content panel.
    -- @param height --- The minimum height of the bottom content panel. Default is 50.
    SetBottomMin: function(self, height: number)

    --- Sets the height of the divider bar between the top and bottom content panels of the DVerticalDivider.
    -- @param height --- The height of the divider bar.
    SetDividerHeight: function(self, height: number)

    --- **INTERNAL**:
    --- Sets whether the divider is being dragged or not.
    -- @param isDragging --- Setting this to true causes cursor movement to alter the position of the divider.
    SetDragging: function(self, isDragging: boolean)

    --- **INTERNAL**:
    --- Sets the local Y position of where the user starts dragging the divider.
    -- @param y --- The local Y position where divider dragging has started.
    SetHoldPos: function(self, y: number)

    --- Places the passed panel in between the top and bottom content panels of the DVerticalDivider.
    -- @param pnl --- The panel to set as the middle content.
    SetMiddle: function(self, pnl: GPanel)

    --- Sets the passed panel as the top content of the DVerticalDivider.
    -- @param pnl --- The panel to set as the top content.
    SetTop: function(self, pnl: GPanel)

    --- Sets the height of the top content panel.
    --- The height of the bottom content panel is automatically calculated by taking the total height of the DVerticalDivider and subtracting it with the height of the top content panel and the divider bar.
    -- @param height --- The height of the top content panel.
    SetTopHeight: function(self, height: number)

    --- Sets the maximum height of the top content panel. This is ignored if the panel would exceed the minimum bottom content panel height set from DVerticalDivider:SetBottomMin.
    -- @param height --- The maximum height of the top content panel. Default is 4096.
    SetTopMax: function(self, height: number)

    --- Sets the minimum height of the top content panel.
    -- @param height --- The minimum height of the top content panel. Default is 50.
    SetTopMin: function(self, height: number)

    --- **INTERNAL**:
    --- Causes the user to start dragging the divider.
    StartGrab: function(self)
end

--- **INTERNAL**:
--- Used by DTree_Node.
global interface DTree_Node_Button is DButton

end

--- **INTERNAL**:
--- This panel is created whenever you add a node to a DTree.
--- The root node of a DTree is also a DTree_Node and controls much of its action. it can be accessed with DTree:Root.
global interface DTree_Node is DPanel
    --- A helper function that adds a new node and calls to DTree_Node:MakeFolder on it.
    -- @param name --- The name of the new node
    -- @param folder --- The folder in the filesystem to use, relative to the garrysmod/ folder.
    -- @param path --- The path to search in. See File Search Paths
    -- @param showFiles --- Should files be added as nodes (true) or folders only (false)
    -- @param wildcard --- The wildcard to use when searching for files.
    -- @param bDontForceExpandable ---
    -- @return --- The created DTree_Node
    AddFolder: function(self, name: string, folder: string, path: string, showFiles: boolean, wildcard: string, bDontForceExpandable: boolean): GPanel

    --- Add a child node to the DTree_Node
    -- @param name --- Name of the node.
    -- @param icon --- The icon that will show next to the node in the DTree.
    -- @return --- Returns the created DTree_Node panel.
    AddNode: function(self, name: string, icon: string): GPanel

    --- **INTERNAL**:
    --- Adds the given panel to the child nodes list, a DListLayout.
    -- @param pnl --- The panel to add.
    AddPanel: function(self, pnl: GPanel)

    --- **INTERNAL**:
    --- Internal function that handles the expand/collapse animations.
    -- @param anim ---
    -- @param delta ---
    -- @param data ---
    AnimSlide: function(self, anim: table, delta: number, data: table)

    --- **INTERNAL**:
    --- Called when a child node is expanded or collapsed to propagate this event to parent nodes to update layout.
    -- @param expanded ---
    ChildExpanded: function(self, expanded: boolean)

    --- Cleans up the internal table of items (sub-nodes) of this node from invalid panels or sub-nodes that were moved from this node to another.
    --- Appears the be completely unused by the game on its own.
    CleanList: function(self)

    --- Create and returns a copy of this node, including all the sub-nodes.
    -- @return --- The copied DTree_Node.
    Copy: function(self): GPanel

    --- **INTERNAL**:
    --- Creates the container DListLayout for the DTree_Nodes.
    --- This is called automatically so you don't have to.
    CreateChildNodes: function(self)

    --- **INTERNAL**:
    --- Called automatically to update the status of DTree_Node:GetLastChild on children of this node.
    DoChildrenOrder: function(self)

    --- Called when the node is clicked.
    --- See also DTree_Node:DoRightClick.
    -- @return --- Return true to prevent DoClick from being called on parent nodes or the DTree itself.
    DoClick: function(self): boolean

    --- Called when the node is right clicked.
    --- See also DTree_Node:DoClick.
    -- @return --- Return true to prevent DoRightClick from being called on parent nodes or the DTree itself.
    DoRightClick: function(self): boolean

    --- Expands or collapses this node, as well as ALL child nodes of this node.
    --- Works opposite of DTree_Node:ExpandTo.
    -- @param expand --- Whether to expand (true) or collapse (false)
    ExpandRecurse: function(self, expand: boolean)

    --- Collapses or expands all nodes from the topmost-level node to this one.
    --- Works opposite of DTree_Node:ExpandRecurse.
    -- @param expand --- Whether to expand (true) or collapse (false)
    ExpandTo: function(self, expand: boolean)

    --- **INTERNAL**:
    --- Called automatically from DTree_Node:PopulateChildrenAndSelf and DTree_Node:PopulateChildren to populate this node with child nodes of files and folders.
    -- @param bAndChildren --- Does nothing. Set to true if called from DTree_Node:PopulateChildren.
    -- @param bExpand --- Expand self once population process is finished.
    FilePopulate: function(self, bAndChildren: boolean, bExpand: boolean)

    --- **INTERNAL**:
    --- Called automatically from DTree_Node:FilePopulate to actually fill the node with sub-nodes based on set preferences like should files be added, etc.
    -- @param files --- A list of files in this folder
    -- @param folders --- A list of folder in this folder.
    -- @param foldername --- The folder name/path this node represents
    -- @param path --- The Path ID search was performed with. See File Search Paths
    -- @param bAndChildren --- Inherited from the **FilePopulate** call. Does nothing
    -- @param wildcard --- The wildcard that was given
    FilePopulateCallback: function(self, files: table, folders: table, foldername: string, path: string, bAndChildren: boolean, wildcard: string)

    --- Returns n-th child node.
    --- Basically an alias of Panel:GetChild.
    -- @param num --- The number of the child to get, starting with 0
    -- @return --- The child panel, if valid ID is given
    GetChildNode: function(self, num: number): GPanel

    --- Returns the number of child nodes this node has. For use with DTree_Node:GetChildNode
    -- @return --- Number of child nodes.
    GetChildNodeCount: function(self): number

    --- Returns a table containing all child nodes of this node.
    -- @return --- A list of all child nodes.
    GetChildNodes: function(self): table

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns value set by DTree_Node:SetDirty.
    -- @return ---
    GetDirty: function(self): boolean

    --- Returns whether the double clock to collapse/expand functionality is enabled on this node.
    -- @return ---
    GetDoubleClickToOpen: function(self): boolean

    --- **INTERNAL**:
    --- Returns what is set by DTree_Node:SetDraggableName.
    -- @return ---
    GetDraggableName: function(self): string

    --- **INTERNAL**:
    --- Returns whether or not this node is drawing lines
    -- @return ---
    GetDrawLines: function(self): boolean

    --- Returns whether the node is expanded or not.
    -- @return --- Expanded or not.
    GetExpanded: function(self): boolean

    --- Returns the filepath of the file attached to this node.
    -- @return ---
    GetFileName: function(self): string

    --- Returns the folder path to search in, set by DTree_Node:MakeFolder.
    -- @return --- The folder path.
    GetFolder: function(self): string

    --- Returns whether the expand/collapse button is shown on this node regardless of whether or not it has sub-nodes.
    --- See also DTree_Node:SetForceShowExpander.
    -- @return ---
    GetForceShowExpander: function(self): boolean

    --- Returns whether the expand button (little + button) should be shown or hidden.
    -- @return --- Цhether the expand button should be shown or hidden.
    GetHideExpander: function(self): boolean

    --- Returns the image path to the icon of this node.
    -- @return --- The path to the image
    GetIcon: function(self): string

    --- Returns the indentation level of the DTree this node belongs to.
    --- Alias of DTree:GetIndentSize, see it for more info.
    -- @return --- The indentation level.
    GetIndentSize: function(self): number

    --- Returns whether this node is the last child on this level or not.
    -- @return --- Whether this node is the last child on this level or not.
    GetLastChild: function(self): boolean

    --- The height of a single DTree_Node of the DTree this node belongs to.
    --- Alias of DTree:GetLineHeight.
    -- @return --- The height of a single DTree_Node.
    GetLineHeight: function(self): number

    --- **INTERNAL**:
    --- @deprecated
    --- **DEPRECATED**: Seems to be unused entirely.
    --- Returns whether the node still needs a filesystem search for sub-nodes.
    -- @return --- Whether the node still needs a filesystem search.
    GetNeedsChildSearch: function(self): boolean

    --- **INTERNAL**:
    --- Returns whether or not the node is set to be populated from the filesystem.
    -- @return ---
    GetNeedsPopulating: function(self): boolean

    --- Returns the parent DTree_Node. Note that Panel:GetParent will not be the same!
    -- @return --- The parent node.
    GetParentNode: function(self): GPanel

    --- Returns the path ID (File Search Paths) used in populating the DTree from the filesystem.
    --- See DTree_Node:SetPathID and DTree_Node:MakeFolder.
    -- @return --- The Path ID
    GetPathID: function(self): string

    --- Returns the root node, the DTree this node is under.
    --- See also DTree_Node:GetParentNode.
    -- @return --- The root node
    GetRoot: function(self): GPanel

    --- Returns whether or not nodes for files should/will be added when populating the node from filesystem.
    -- @return ---
    GetShowFiles: function(self): boolean

    --- Returns the wildcard set by DTree_Node:MakeFolder.
    -- @return --- The search wildcard
    GetWildCard: function(self): string

    --- Inserts a sub-node into this node before or after the given node.
    -- @param node --- The DTree_Node to insert.
    -- @param nodeNextTo --- The node to insert the node above before or after.
    -- @param before --- true to insert before, false to insert after.
    Insert: function(self, node: GPanel, nodeNextTo: GPanel, before: boolean)

    --- **INTERNAL**:
    --- Inserts an existing node as a "child" or a sub-node of this node.
    --- Used internally by the drag'n'drop functionality.
    -- @param node --- Has to be DTree_Node
    InsertNode: function(self, node: GPanel)

    --- **INTERNAL**:
    --- Called automatically internally.
    --- Makes the target node compatible with this node's drag'n'drop.
    -- @param node --- The DTree_Node.
    InstallDraggable: function(self, node: GPanel)

    --- **INTERNAL**:
    --- See DTree_Node:DoClick
    InternalDoClick: function(self)

    --- **INTERNAL**:
    --- See DTree_Node:DoRightClick.
    InternalDoRightClick: function(self)

    --- Returns true if DTree_Node:GetRoot is the same as DTree_Node:GetParentNode of this node.
    -- @return --- If this is a root node.
    IsRootNode: function(self): boolean

    --- Removes given node as a sub-node of this node.
    --- It doesn't actually remove or unparent the panel, just removes it from the internal DListView.
    -- @param pnl --- The node to remove
    LeaveTree: function(self, pnl: GPanel)

    --- Makes this node a folder in the filesystem. This will make it automatically populated.
    --- See also DTree_Node:AddFolder.
    -- @param folder --- The folder in the filesystem to use, relative to the garrysmod/ folder.
    -- @param path --- The path to search in. See File Search Paths
    -- @param showFiles --- Should files be added as nodes (true) or folders only (false)
    -- @param wildcard --- The wildcard to use when searching for files.
    -- @param dontForceExpandable --- If set to true, don't show the expand buttons on empty nodes.
    MakeFolder: function(self, folder: string, path: string, showFiles: boolean, wildcard: string, dontForceExpandable: boolean)

    --- Moves given panel to the top of the children of this node.
    --- Despite name of this function, it cannot move the children to any position but the topmost.
    -- @param node --- The node to move.
    MoveChildTo: function(self, node: GPanel)

    --- Moves this node to the top of the level.
    MoveToTop: function(self)

    --- Called when sub-nodes of this DTree_Node were changed, such as being rearranged if that functionality is enabled.
    OnModified: function(self)

    --- Called when a new sub-node is added this node.
    -- @param newNode --- The newly added sub node.
    OnNodeAdded: function(self, newNode: DTree_Node)

    --- **INTERNAL**:
    --- Called when this or a sub node is selected. Do not use this, it is not for override.
    --- Use DTree:OnNodeSelected or DTree_Node:DoClick instead.
    -- @param node ---
    OnNodeSelected: function(self, node: GPanel)

    --- **INTERNAL**:
    --- Called automatically to perform layout on this node if this node DTree_Node:IsRootNode.
    PerformRootNodeLayout: function(self)

    --- **INTERNAL**:
    --- Called automatically from DTree_Node:PopulateChildrenAndSelf.
    PopulateChildren: function(self)

    --- **INTERNAL**:
    --- Called automatically from DTree_Node:SetExpanded (or when user manually expands the node) to populate the node with sub-nodes from the filesystem if this was enabled via DTree_Node:MakeFolder.
    -- @param expand --- Expand self once population process is finished.
    PopulateChildrenAndSelf: function(self, expand: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Appears to have no effect on the DTree_Node.
    -- @param dirty ---
    SetDirty: function(self, dirty: boolean)

    --- Sets whether double clicking the node should expand/collapse it or not.
    -- @param enable --- true to enable, false to disable this functionality.
    SetDoubleClickToOpen: function(self, enable: boolean)

    --- **INTERNAL**:
    --- Used to store name for sub elements for a Panel:Droppable call.
    -- @param name ---
    SetDraggableName: function(self, name: string)

    --- **INTERNAL**:
    --- Sets whether or not this node should draw visual lines.
    -- @param draw ---
    SetDrawLines: function(self, draw: boolean)

    --- Expands or collapses this node.
    -- @param expand --- Whether to expand (true) or collapse (false)
    -- @param surpressAnimation --- Whether to play animation (false) or not (true)
    SetExpanded: function(self, expand: boolean, surpressAnimation: boolean)

    --- **INTERNAL**:
    --- Sets the file full filepath to the file attached to this node
    -- @param filename ---
    SetFileName: function(self, filename: string)

    --- **INTERNAL**:
    --- Sets the folder to search files and folders in.
    --- Use DTree_Node:MakeFolder instead.
    -- @param folder ---
    SetFolder: function(self, folder: string)

    --- Sets whether or not the expand/collapse button (+/- button) should be shown on this node regardless of whether it has sub-elements or not.
    -- @param forceShow ---
    SetForceShowExpander: function(self, forceShow: boolean)

    --- **INTERNAL**:
    --- Sets whether the expand button (little + button) should be shown or hidden.
    -- @param hide ---
    SetHideExpander: function(self, hide: boolean)

    --- Sets the material for the icon of the DTree_Node.
    -- @param path --- The path to the material to be used. Do not include "materials/". .pngs are supported.
    SetIcon: function(self, path: string)

    --- **INTERNAL**:
    --- Called automatically to set whether this node is the last child on this level or not.
    -- @param last ---
    SetLastChild: function(self, last: boolean)

    --- **INTERNAL**:
    --- @deprecated
    --- **DEPRECATED**: Seems to be unused entirely.
    --- Sets whether the node still needs a filesystem search for sub-nodes.
    -- @param newState --- New state.
    SetNeedsChildSearch: function(self, newState: boolean)

    --- **INTERNAL**:
    --- Sets whether or not the node needs populating from the filesystem.
    -- @param needs --- Whether or not the node needs populating
    SetNeedsPopulating: function(self, needs: boolean)

    --- **INTERNAL**:
    --- Sets the parent node of this node. Not the same as Panel:SetParent.
    --- This is set automatically, you shouldn't use this.
    -- @param parent --- The panel to set as a parent node for this node
    SetParentNode: function(self, parent: GPanel)

    --- **INTERNAL**:
    --- Sets the path ID (File Search Paths) for populating the tree from the filesystem.
    --- Use DTree_Node:MakeFolder instead.
    -- @param path --- The path ID to set.
    SetPathID: function(self, path: string)

    --- **INTERNAL**:
    --- Sets the root node (the DTree) of this node.
    --- This is set automatically, you shouldn't use this.
    -- @param root --- The panel to set as root node.
    SetRoot: function(self, root: GPanel)

    --- **INTERNAL**:
    --- Called automatically to update the "selected" status of this node.
    -- @param selected --- Whether this node is currently selected or not.
    SetSelected: function(self, selected: boolean)

    --- **INTERNAL**:
    --- Sets whether or not nodes for files should be added when populating the node from filesystem.
    -- @param showFiles ---
    SetShowFiles: function(self, showFiles: boolean)

    --- **INTERNAL**:
    --- Sets the search wildcard.
    --- Use DTree_Node:MakeFolder instead
    -- @param wildcard --- The wildcard to set
    SetWildCard: function(self, wildcard: string)

    --- @deprecated
    --- **DEPRECATED**:
    --- Currently does nothing, not implemented.
    SetupCopy: function(self)

    --- Returns whether or not the DTree this node is in has icons enabled.
    --- See DTree:ShowIcons for more info.
    -- @return --- Whether the icons are shown or not
    ShowIcons: function(self): number
end

--- A tree view element for Derma.
--- See also DTree_Node.
global interface DTree is DScrollPanel
    --- Add a node to the DTree
    -- @param name --- Name of the option.
    -- @param icon --- The icon that will show nexto the node in the DTree.
    -- @return --- Returns the created DTree_Node panel.
    AddNode: function(self, name: string, icon: string): GPanel

    --- **INTERNAL**:
    --- Calls directly to Panel:InvalidateLayout.
    --- Called by DTree_Nodes when a sub element has been expanded or collapsed.
    --- Used as a placeholder function alongside DTree:ExpandTo, DTree:SetExpanded and DTree:MoveChildTo.
    --- The DTree acts a root node and methods with the same name in DTree_Node call to the parent.
    -- @param bExpand ---
    ChildExpanded: function(self, bExpand: boolean)

    --- Called when the any node is clicked. Called by DTree_Node:DoClick.
    -- @param node --- The right clicked node.
    -- @return suppress ---
    DoClick: function(self, node: DTree_Node): boolean

    --- Called when the any node is right clicked. Called by DTree_Node:DoRightClick.
    -- @param node --- The right clicked node.
    -- @return suppress ---
    DoRightClick: function(self, node: DTree_Node): boolean

    --- **INTERNAL**:
    --- Does nothing. Used as a placeholder empty function alongside DTree:MoveChildTo, DTree:SetExpanded and DTree:ChildExpanded.
    --- The DTree acts a root node and methods with the same name in DTree_Node call to the parent.
    -- @param bExpand ---
    ExpandTo: function(self, bExpand: boolean)

    --- Returns the status of DTree:SetClickOnDragHover. See that for more info.
    -- @return ---
    GetClickOnDragHover: function(self): boolean

    --- Returns the indentation size of the DTree, the distance between each "level" of the tree is offset on the left from the previous level.
    --- Currently this feature has no effect on the DTree element.
    -- @return --- The indentation size.
    GetIndentSize: function(self): number

    --- Returns the height of each DTree_Node in the tree.
    -- @return --- The height of each DTree_Node in the tree.
    GetLineHeight: function(self): number

    --- Returns the currently selected node.
    -- @return --- Curently selected DTree_Node.
    GetSelectedItem: function(self): GPanel

    --- Returns whether or not the Silkicons next to each node of the DTree will be displayed.
    --- Individual icons can be set with DTree_Node:SetIcon or passed as the second argument in DTree:AddNode.
    -- @return --- Whether or not the silkicons next to each node will be displayed.
    GetShowIcons: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    LayoutTree: function(self)

    --- Moves given node to the top of DTrees children. (Makes it the topmost mode)
    --- Used as a placeholder function alongside DTree:ExpandTo, DTree:SetExpanded and DTree:ChildExpanded.
    --- The DTree acts a root node and methods with the same name in DTree_Node call to the parent.
    -- @param child --- The node to move
    -- @param pos --- @deprecated
    --- **DEPRECATED**:
    ---  Unused, does nothing.
    MoveChildTo: function(self, child: GPanel, pos: number)

    --- This function is called when a node within a tree is selected.
    -- @param node --- The node that was selected.
    OnNodeSelected: function(self, node: GPanel)

    --- Returns the root DTree_Node, the node that is the parent to all other nodes of the DTree.
    -- @return --- Root node.
    Root: function(self): GPanel

    --- Enables the "click when drag-hovering" functionality.
    --- If enabled, when hovering over any DTree_Node of this DTree while dragging a panel, the node will be automatically clicked on (and subsequently DTree:OnNodeSelected will be called) to open any attached panels, such as spawnlists in spawnmenu.
    --- See also: PANEL:DragHoverClick.
    -- @param enable ---
    SetClickOnDragHover: function(self, enable: boolean)

    --- **INTERNAL**:
    --- Does nothing. Is not called by the DTree itself.
    --- Used as a placeholder empty function alongside DTree:ExpandTo, DTree:MoveChildTo and DTree:ChildExpanded to prevent errors when DTree_Node:SetExpanded is incorrectly used on a DTree.
    -- @param bExpand ---
    SetExpanded: function(self, bExpand: boolean)

    --- Sets the indentation size of the DTree, the distance between each "level" of the tree is offset on the left from the previous level.
    --- Currently this feature has no effect on the DTree element.
    -- @param size --- The new indentation size.
    SetIndentSize: function(self, size: number)

    --- Sets the height of each DTree_Node in the tree.
    --- The default value is 17.
    -- @param h --- The height to set.
    --SetLineHeight: function(self, h: number)

    --- Set the currently selected top-level node.
    -- @param node --- DTree_Node to select.
    SetSelectedItem: function(self, node: GPanel)

    --- Sets whether or not the Silkicons next to each node of the DTree will be displayed.
    --- Individual icons can be set with DTree_Node:SetIcon or passed as the second argument in DTree:AddNode.
    -- @param show --- Whether or not to show icons.
    SetShowIcons: function(self, show: boolean)

    --- Returns whether or not the Silkicons next to each node of the DTree will be displayed.
    --- Alias of DTree:GetShowIcons.
    -- @return --- Whether or not the silkicons next to each node will be displayed.
    ShowIcons: function(self): boolean
end

--- **INTERNAL**:
--- The panel used internally for tooltips. See Panel:SetTooltip for more information.
--- <upload src="70c/8de029dfe107ffc.gif" size="12567" name="October03-1797-gmod.gif">
--- </upload>
global interface DTooltip is DLabel
    --- Forces the tooltip to close. This will remove the panel.
    Close: function(self)

    --- Used to draw a triangle beneath the DTooltip
    --- **NOTE**: Requires DTooltip:SetContents, without this it will error
    -- @param x --- arrow location on the x axis
    -- @param y --- arrow location on the y axis
    DrawArrow: function(self, x: number, y: number)

    --- **INTERNAL**:
    --- Sets up the tooltip for display for given panel and starts the timer.
    --- Normally you wouldn't call this and you'd use Panel:SetTooltip, Panel:SetTooltipPanel or Panel:SetTooltipPanelOverride.
    -- @param pnl --- The panel to open the tooltip for.
    OpenForPanel: function(self, pnl: GPanel)

    --- **INTERNAL**:
    --- Positions the DTooltip so it doesn't stay in the same draw position.
    PositionTooltip: function(self)

    --- What Panel you want put inside of the DTooltip
    --- **NOTE**: You can only have one Panel at a time; use Parenting to add more
    -- @param panel --- Contents
    -- @param delete --- If set to true, the panel in the first argument will be automatically removed when DTooltip is closed via DTooltip:Close.
    SetContents: function(self, panel: GPanel, delete: boolean)
end

--- Similarly to DIconLayout, this lays out panels in two dimensions as tiles.
--- The difference between this and DIconLayout is that DIconLayout items all have the same height while
--- DTileLayout items do not have this enforcement.
--- DTileLayout will find the best way to "pack" its children.
--- For example, in a two column layout, a item of height 2 units will be placed in one column while
--- two items of height 1 unit will be placed in the other column.
--- It is worth noting however that because this panel iterates through its children in an undefined order and lays out while
--- it is iterating, there is no guarantee that this packing will lead to the lowest possible height.
--- This is used by the spawnmenu to arrange spawnicons.
--- The base size defines the smallest a tile can be, and it will resize vertically to accommodate all child panels.
--- The number of elements in each row is determined by the base size and width.
--- It also optionally permits the rearrangement of these tiles.
--- To enable this functionality, call DDragBase:MakeDroppable on the DTileLayout with a unique identifier.
--- All panels added following this will be moveable.
global interface DTileLayout is DDragBase
    --- **INTERNAL**:
    ---  Clears the panel's tile table. Used by DTileLayout:LayoutTiles.
    ClearTiles: function(self)

    --- **INTERNAL**:
    ---  Called to designate a range of tiles as occupied by a panel.
    -- @param x --- The x coordinate of the top-left corner of the panel.
    -- @param y --- The y coordinate of the top-left corner of the panel.
    -- @param w --- The panel's width.
    -- @param h --- The panel's height.
    ConsumeTiles: function(self, x: number, y: number, w: number, h: number)

    --- Creates and returns an exact copy of the DTileLayout.
    -- @return --- The created copy.
    Copy: function(self): GPanel

    --- Creates copies of all the children from the given panel object and parents them to this one.
    -- @param source --- The source panel from which to copy all children.
    CopyContents: function(self, source: GPanel)

    --- **INTERNAL**:
    ---  Finds the coordinates of the first group of free tiles that fit the given size.
    -- @param x --- The x coordinate to start looking from.
    -- @param y --- The y coordinate to start looking from.
    -- @param w --- The needed width.
    -- @param h --- The needed height.
    -- @return --- The x coordinate of the found available space.
    -- @return --- The y coordinate of the found available space.
    FindFreeTile: function(self, x: number, y: number, w: number, h: number): number, number

    --- **INTERNAL**:
    ---  Determines if a group of tiles is vacant.
    -- @param x --- The x coordinate of the first tile.
    -- @param y --- The y coordinate of the first tile.
    -- @param w --- The width needed.
    -- @param h --- The height needed.
    -- @return --- Whether or not this group is available for occupation.
    FitsInTile: function(self, x: number, y: number, w: number, h: number): boolean

    --- Returns the size of each single tile, set with DTileLayout:SetBaseSize.
    -- @return --- Base tile size.
    GetBaseSize: function(self): number

    --- Returns the border spacing set by DTileLayout:SetBorder.
    -- @return --- The border spacing
    GetBorder: function(self): number

    --- Returns the minimum height the DTileLayout can resize to.
    -- @return --- The minimum height the panel can shrink to.
    GetMinHeight: function(self): number

    --- Returns the X axis spacing between 2 elements set by DTileLayout:SetSpaceX.
    -- @return ---
    GetSpaceX: function(self): number

    --- Returns the Y axis spacing between 2 elements set by DTileLayout:SetSpaceY.
    -- @return ---
    GetSpaceY: function(self): number

    --- **INTERNAL**:
    ---  Gets the occupied state of a tile.
    -- @param x --- The x coordinate of the tile.
    -- @param y --- The y coordinate of the tile.
    -- @return --- The occupied state of the tile, normally `1` or `nil`.
    GetTile: function(self, x: number, y: number): any

    --- Resets the last width/height info, and invalidates the panel's layout, causing it to recalculate all child positions. It is called whenever a child is added or removed, and can be called to refresh the panel.
    Layout: function(self)

    --- **INTERNAL**:
    ---  Called by PANEL:PerformLayout to arrange and lay out the child panels, if it has changed in size.
    LayoutTiles: function(self)

    --- Called when anything is dropped on or rearranged within the DTileLayout.
    OnModified: function(self)

    --- Sets the size of a single tile. If a child panel is larger than this size, it will occupy several tiles.
    --- If you are setting the size of the children properly then you probably don't need to change this.
    -- @param size --- The size of each tile. It is recommended you use `2ⁿ` (`16, 32, 64...`) numbers, and those above `4`, as numbers lower than this will result in many tiles being processed and therefore slow operation.
    SetBaseSize: function(self, size: number)

    --- Sets the spacing between the border/edge of the DTileLayout and all the elements inside.
    -- @param border ---
    SetBorder: function(self, border: number)

    --- Determines the minimum height the DTileLayout will resize to. This is useful if child panels will be added/removed often.
    -- @param minH --- The minimum height the panel can shrink to.
    SetMinHeight: function(self, minH: number)

    --- Sets the spacing between 2 elements in the DTileLayout on the X axis.
    -- @param spacingX --- New X axis spacing.
    SetSpaceX: function(self, spacingX: number)

    --- Sets the spacing between 2 elements in the DTileLayout on the Y axis.
    -- @param spaceY --- New Y axis spacing.
    SetSpaceY: function(self, spaceY: number)

    --- **INTERNAL**:
    ---  Called to set the occupied state of a tile.
    -- @param x --- The x coordinate of the tile.
    -- @param y --- The y coordinate of the tile.
    -- @param state --- The new state of the tile, normally `1` or `nil`.
    SetTile: function(self, x: number, y: number, state: any)
end

--- **INTERNAL**:
--- This element is created within and only used in the DPropertySheet file. These can be elements are stored items are stored in the `Items` subtable of the DPropertySheet
global interface DTab is DButton
    --- Returns the panel that the tab represents.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L5)
    -- @return --- Panel added to the sheet using DPropertySheet:AddSheet.
    GetPanel: function(self): GPanel

    --- The DPropertySheet this tab belongs to.
    -- @return pnl --- The DPropertySheet this tab belongs to.
    GetPropertySheet: function(self): GPanel

    --- **INTERNAL**:
    --- Returns the target height of this tab. Used internally by DTab's PANEL:ApplySchemeSettings.
    -- @return --- Either 20, or 28 if DTab:IsActive.
    GetTabHeight: function(self): number

    --- Returns whether the tab is the currently selected tab of the associated DPropertySheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpropertysheet.lua#L34)
    -- @return --- Currently selected tab.
    IsActive: function(self): boolean

    --- **INTERNAL**:
    ---  Used internally by DTab:Setup.
    -- @param pnl --- The contents of this tab.
    SetPanel: function(self, pnl: GPanel)

    --- **INTERNAL**:
    ---  Used internally by DTab:Setup.
    -- @param pnl --- The DPropertySheet to set for this tab.
    SetPropertySheet: function(self, pnl: GPanel)

    --- **INTERNAL**:
    ---  Used internally by DPropertySheet:AddSheet.
    -- @param label --- Label of the tab
    -- @param sheet --- The DPropertySheet this tab belongs to.
    -- @param pnl --- Panel to be used as contents of the tab. This normally should be a DPanel.
    -- @param icon --- Icon for the tab. This will typically be a silkicon, but any material name can be used.
    Setup: function(self, label: string, sheet: GPanel, pnl: GPanel, icon: string)
end

--- A panel that draws a sprite on the player's HUD with the given IMaterial, Global.Color and rotation.
--- A shortcut for this is Global.CreateSprite().
global interface DSprite is DPanel
    --- Gets the color the sprite is using as a modifier.
    -- @return --- The Global.Color being used.
    GetColor: function(self): table

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns the value set by DSprite:SetHandle
    -- @return ---
    GetHandle: function(self): GVector

    --- Gets the material the sprite is using.
    -- @return --- The material in use.
    GetMaterial: function(self): GIMaterial

    --- Gets the 2D rotation angle of the sprite, in the plane of the screen.
    -- @return --- The anti-clockwise rotation in degrees.
    GetRotation: function(self): number

    --- Sets the color modifier for the sprite.
    -- @param color --- The Global.Color to use.
    SetColor: function(self, color: table)

    --- @deprecated
    --- **DEPRECATED**:
    --- Seems to be an unused feature. Does nothing.
    -- @param vec ---
    SetHandle: function(self, vec: GVector)

    --- Sets the source material for the sprite.
    -- @param material --- The material to use. This will ideally be an [UnlitGeneric](https://developer.valvesoftware.com/wiki/UnlitGeneric).
    SetMaterial: function(self, material: GIMaterial)

    --- Sets the 2D rotation angle of the sprite, in the plane of the screen.
    -- @param ang --- The anti-clockwise rotation in degrees.
    SetRotation: function(self, ang: number)
end

--- A helper panel that will automatically resize itself to fit all its children using Panel:SizeToChildren.
global interface DSizeToContents is GPanel
    --- Returns whether the DSizeToContents panel should size to contents horizontally.
    -- @return --- Whether the panel should size to contents horizontally.
    GetSizeX: function(self): boolean

    --- Returns whether the DSizeToContents panel should size to contents vertically.
    -- @return --- Whether the panel should size to contents vertically.
    GetSizeY: function(self): boolean

    --- Sets whether the DSizeToContents panel should size to contents horizontally. This is `true` by default.
    -- @param sizeX --- Whether the panel should size to contents horizontally.
    SetSizeX: function(self, sizeX: boolean)

    --- Sets whether the DSizeToContents panel should size to contents vertically. This is `true` by default.
    -- @param sizeY --- Whether the panel should size to contents vertically.
    SetSizeY: function(self, sizeY: boolean)
end

--- Draw a shape on a derma panel. Only one kind of shape, a rectangle, is available for use.
global interface DShape is DPanel
    --- Returns the current type of shape this panel is set to display.
    --- See DShape:SetBorderColor.
    -- @return --- The border Color
    GetBorderColor: function(self): table

    --- Returns the color set to display the shape with.
    -- @return --- The shape Color
    GetColor: function(self): table

    --- Returns the current type of shape this panel is set to display.
    --- See DShape:SetType.
    -- @return --- Current shape type.
    GetType: function(self): string

    --- Sets the border color of the shape.
    --- Currently does nothing.
    -- @param clr --- The desired border color.
    --- See Color
    SetBorderColor: function(self, clr: table)

    --- Sets the color to display the shape with.
    -- @param clr --- The Color
    SetColor: function(self, clr: table)

    --- Sets the shape to be drawn.
    -- @param type --- The render type of the DShape. Only rectangles (`Rect`) work currently. If you don't define a type immediately, the PANEL:Paint method will generate errors until you do.
    SetType: function(self, type: string)
end

--- **INTERNAL**:
--- An internal panel used by DVScrollBar as the grip (middle) part of the scrollbar.
global interface DScrollBarGrip is DPanel

end

--- DRGBPicker is an interactive panel which can be used to select a color hue.
--- See DColorCube for a color picker which controls brightness and saturation.
--- See DColorMixer for a color picker that allows control over hue, saturation, and brightness at once.
global interface DRGBPicker is DPanel
    --- **INTERNAL**:
    --- Returns the color at given position on the internal texture.
    -- @param x --- The X coordinate on the texture to get the color from
    -- @param y --- The Y coordinate on the texture to get the color from
    -- @return --- Color
    -- @return --- The X-coordinate clamped to the texture's width.
    -- @return --- The Y-coordinate clamped to the texture's height.
    GetPosColor: function(self, x: number, y: number): table, number, number

    --- Returns the color currently set on the color picker.
    -- @return --- The color set on the color picker, see Color.
    GetRGB: function(self): table

    --- Function which is called when the cursor is clicked and/or moved on the color picker. Meant to be overridden.
    -- @param col --- The color that is selected on the color picker (Color form).
    OnChange: function(self, col: table)

    --- Sets the color stored in the color picker.
    --- **NOTE**: This function is meant to be called internally and will not update the position of the color picker line or call DRGBPicker:OnChange
    -- @param color --- The color to set, see Color.
    SetRGB: function(self, color: table)
end

--- **INTERNAL**:
--- Color picker control for a DProperties panel. Opens a DColorCombo if the color preview is clicked.
--- See Editable Entities for how this is used ingame.
global interface DProperty_VectorColor is DProperty_Generic
    --- Sets the color value of the property.
    -- @param color --- Sets the color to use in a DProperty_VectorColor.
    SetValue: function(self, color: GVector)

    --- **INTERNAL**:
    ---  Called by a property row to setup a color selection control.
    -- @param settings --- A table of settings. None of the values are used for this property. See Editable Entities.
    Setup: function(self, settings: table)
end

--- **INTERNAL**:
--- Integer control for the DProperties panel.
global interface DProperty_Int is DProperty_Float

end

--- **INTERNAL**:
--- Entity picker control for the DProperties panel.
global interface DProperty_Entity is DProperty_Generic

end

--- **INTERNAL**:
--- DComboBox control for a DProperties panel.
global interface DProperty_Combo is DProperty_Generic
    --- Add a choice to your combo control.
    -- @param Text --- Shown text.
    -- @param data --- Stored Data.
    -- @param select --- Select this element?
    AddChoice: function(self, Text: string, data: any, select: boolean)

    --- Called after the user selects a new value.
    -- @param data --- The new data that was selected.
    DataChanged: function(self, data: any)

    --- Set the selected option.
    -- @param Id --- Id of the choice to be selected.
    --SetSelected: function(self, Id: number)

    --- **INTERNAL**:
    --- Sets up a combo control.
    -- @param data --- Data to use to set up the combo box control. See Editable Entities.
    --- Structure:
    --- * string text - The default label for this combo box
    --- * table values - The values to add to the combo box. Keys are the "nice" text, values are the data value to send.
    --- * table icons - The icons for each value. They will be matched by key name.
    --- * boolean select - The "nice" name/key of the value that should be initially selected.
    Setup: function(self, data: table)
end

--- **INTERNAL**:
--- Checkbox control for the DProperties panel.
global interface DProperty_Boolean is DProperty_Generic

end

--- A progressbar, works with a fraction between 0 and 1 where 0 is 0% and 1 is 100%.
global interface DProgress is GPanel
    --- Returns the progress bar's fraction. 0 is 0% and 1 is 100%.

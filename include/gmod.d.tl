--- A derivative of the DModelPanel in which the user may modify the perspective of the model with their mouse and keyboard by clicking and dragging.
--- The keyboard keys `` `` `` `` `` `` `` `` `` and `` can be used when the right mouse is held down, with `` acting as a speed multiplier. When the left mouse is used, the Shift key holds the current `y` angle steady.
--- This is used by IconEditor for modifying spawn icons.
global interface DAdjustableModelPanel is DModelPanel
    --- **INTERNAL**:
    ---  Used by the panel to perform mouse capture operations when adjusting the model.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L61-L75)
    CaptureMouse: function(self)

    --- **INTERNAL**:
    ---  Used to adjust the perspective in the model panel via the keyboard, when the right mouse button is used.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L92-L146)
    FirstPersonControls: function(self)

    --- Gets whether mouse and keyboard-based adjustment of the perspective has been enabled. See DAdjustableModelPanel:SetFirstPerson for more information.
    --- This is an Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L4)
    -- @return --- Whether first person controls are enabled. See DAdjustableModelPanel:FirstPersonControls.
    GetFirstPerson: function(self): boolean

    --- Returns the movement speed multiplier set by DAdjustableModelPanel:SetMovementScale.
    --- An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L5)
    -- @return --- The movement scale, where `1` is normal, `2` is double, etc.
    GetMovementScale: function(self): number

    --- Enables mouse and keyboard-based adjustment of the perspective.
    --- This is set to `true` automatically each time mouse capture is enabled, and hence doesn't serve as a usable setting, other than to disable this functionality after the PANEL:OnMousePressed event.
    --- An Global.AccessorFunc
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L4)
    -- @param enable --- Whether to enable/disable first person controls. See DAdjustableModelPanel:FirstPersonControls.
    SetFirstPerson: function(self, enable: boolean)

    --- Sets the movement speed multiplier. Currently this only affects first person camera controls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dadjustablemodelpanel.lua#L5)
    -- @param  --- The movement scale, where `1` is normal, `2` is double, etc.
    SetMovementScale: function(self, _: number)
end

--- CtrlNumPad is a VGUI element designed primarily for SpawnMenu and ControlPanel. It is used to create a DBinder with at least one DLabel. Each change made by the player in the `CtrlNumPad` acts on a previously defined ConVar.
--- To retrieve the panels associated with this panel:
--- * To retrieve the DBinder created, you can use this variable associated with the panel: `PANEL.NumPad1`
--- * To retrieve the first DLabel created, you can use this variable associated with the panel: `PANEL.Label1`
--- * To retrieve the second DLabel created, you can use this variable associated with the panel: `PANEL.Label2`
--- By default, the DLabel:SetDark function is activated on both DLabels.
--- To retrieve the value of the `CtrlNumPad` you can use these functions : Player:GetInfoNum, CtrlNumPad:GetValue1 or CtrlNumPad:GetValue2
global interface VCtrlNumPad
    --- The value (key bind) of the first DBinder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L58-L64)
    -- @return keyBind --- The key bind or `KEY_NONE`.
    GetValue1: function(self): E_KEY

    --- The value (key bind) of the second DBinder, if it's enabled.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L66-L72)
    -- @return keyBind --- The key bind or `KEY_NONE`.
    GetValue2: function(self): E_KEY

    --- The name of the convar that will store the key code for player selected key of the left key binder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L45-L48)
    -- @param cvar --- The convar that will be used in the event of a key change by a player.
    SetConVar1: function(self, cvar: string)

    --- If set and label2 is set, the name of the convar that will store the key code for player selected key of the right key binder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L53-L56)
    -- @param cvar --- The convar that will be used in the event of a key change by a player.
    SetConVar2: function(self, cvar: string)

    --- The label for the left key binder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L29-L32)
    -- @param txt --- The label for the left key binder.
    SetLabel1: function(self, txt: string)

    --- If set and convar2 is set, the label for the right key binder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controls/ctrlnumpad.lua#L37-L40)
    -- @param txt --- The label for the right key binder.
    SetLabel2: function(self, txt: string)
end

--- A DComboBox based dropdown menu with build in easy ConVar support.

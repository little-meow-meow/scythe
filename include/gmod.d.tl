--- The sound's attenuation; how fast it drops away, enumerations used by Global.EmitSound and Entity:EmitSound. Information taken from [soundflags.h in Source SDK 2013](https://github.com/ValveSoftware/source-sdk-2013/blob/0d8dceea4310fde5706b3ce1c70609d72a38efdf/sp/src/public/soundflags.h#L53)
--- The engine starts running into trouble below 60dB.
--- **WARNING**: These enumerations do not exist in game and are listed here only for reference
global type E_SNDLVL = number
--- Sound plays everywhere
global SNDLVL_NONE: E_SNDLVL = 0
--- Rustling leaves
global SNDLVL_20dB: E_SNDLVL = 20
--- Whispering
global SNDLVL_25dB: E_SNDLVL = 25
--- Library
global SNDLVL_30dB: E_SNDLVL = 30
global SNDLVL_35dB: E_SNDLVL = 35
global SNDLVL_40dB: E_SNDLVL = 40
--- Refrigerator
global SNDLVL_45dB: E_SNDLVL = 45
--- Average home
global SNDLVL_50dB: E_SNDLVL = 50
global SNDLVL_55dB: E_SNDLVL = 55
--- Normal conversation, clothes dryer
global SNDLVL_60dB: E_SNDLVL = 60
--- *The same as SNDLVL_60dB*
global SNDLVL_IDLE: E_SNDLVL = 60
--- Washing machine, dishwasher
global SNDLVL_65dB: E_SNDLVL = 65
global SNDLVL_STATIC: E_SNDLVL = 66
--- Car, vacuum cleaner, mixer, electric sewing machine
global SNDLVL_70dB: E_SNDLVL = 70
--- Busy traffic
global SNDLVL_75dB: E_SNDLVL = 75
--- *The same as SNDLVL_75dB*
global SNDLVL_NORM: E_SNDLVL = 75
--- Mini-bike, alarm clock, noisy restaurant, office tabulator, outboard motor, passing snowmobile
global SNDLVL_80dB: E_SNDLVL = 80
--- *The same as SNDLVL_80dB*
global SNDLVL_TALKING: E_SNDLVL = 80
--- Average factory, electric shaver
global SNDLVL_85dB: E_SNDLVL = 85
--- Screaming child, passing motorcycle, convertible ride on freeway
global SNDLVL_90dB: E_SNDLVL = 90
global SNDLVL_95dB: E_SNDLVL = 95
--- Subway train, diesel truck, woodworking shop, pneumatic drill, boiler shop, jackhammer
global SNDLVL_100dB: E_SNDLVL = 100
--- Helicopter, power mower
global SNDLVL_105dB: E_SNDLVL = 105
--- Snowmobile (drivers seat), inboard motorboat, sandblasting
global SNDLVL_110dB: E_SNDLVL = 110
--- Car horn, propeller aircraft
global SNDLVL_120dB: E_SNDLVL = 120
--- Air raid siren
global SNDLVL_130dB: E_SNDLVL = 130
--- Threshold of pain, gunshot, jet engine
global SNDLVL_140dB: E_SNDLVL = 140
--- *The same as SNDLVL_140dB*
global SNDLVL_GUNFIRE: E_SNDLVL = 140
global SNDLVL_150dB: E_SNDLVL = 150
--- Rocket launching
global SNDLVL_180dB: E_SNDLVL = 180

--- For use with Entity:PhysicsInit, Entity:SetSolid and Entity:GetSolid.

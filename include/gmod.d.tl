    --- Sets the next time the clientside ENTITY:Think is called.
    -- @param nextthink --- The next time, relative to Global.CurTime, to execute the ENTITY:Think clientside.
    SetNextClientThink: function(self, nextthink: number)

    --- Sets if the entity's model should render at all.
    --- If set on the server, this entity will no longer network to clients, and for all intents and purposes cease to exist clientside.
    --- The entity can still be manually rendered via Entity:DrawModel in appropriate hooks.
    -- @param shouldNotDraw --- true disables drawing
    SetNoDraw: function(self, shouldNotDraw: boolean)

    --- Sets whether the entity is solid or not.
    -- @param IsNotSolid --- True will make the entity not solid, false will make it solid.
    SetNotSolid: function(self, IsNotSolid: boolean)

    --- Sets the owner of this entity, disabling all physics interaction with it.
    --- **NOTE**: This function is generally used to disable physics interactions on projectiles being fired by their owner, but can also be used for normal ownership in case physics interactions are not involved at all. The Gravity gun will be able to pick up the entity even if the owner can't collide with it, the Physics gun however will not.
    -- @param owner --- The entity to be set as owner.
    SetOwner: function(self, owner: GEntity)

    --- Sets the parent of this entity, making it move with its parent. This will make the child entity non solid, nothing can interact with them, including traces.
    --- All children of the parent get removed whenever it gets removed.
    --- **NOTE**: This does not work on the world.
    --- **WARNING**: This can cause undefined physics behavior when used on entities that don't support parenting. See the [Valve developer wiki](https://developer.valvesoftware.com/wiki/Entity_Hierarchy_(parenting)) for more information.
    -- @param parent --- The entity to parent to. Setting this to nil will clear the parent.
    -- @param attachmentOrBoneId --- The attachment or bone id to use when parenting. Defaults to -1 or whatever the parent had set previously.
    --- Use Entity:AddEffects( EF_FOLLOWBONE ) to treat this argument as a Bone ID instead of an Attachment ID. Similar to Entity:FollowBone.
    --- **NOTE**: You must call Entity:SetMoveType( MOVETYPE_NONE ) on the child for this argument to have any effect!
    SetParent: function(self, parent: GEntity, attachmentOrBoneId: number)

    --- Sets the parent of an entity to another entity with the given physics bone number. Similar to Entity:SetParent, except it is parented to a physbone. This function is useful mainly for ragdolls.
    --- **NOTE**: Despite this function being available server side, it doesn't actually do anything server side.
    -- @param bone --- Physics bone number to attach to. Use 0 for objects with only one physics bone. (See Entity:GetPhysicsObjectNum)
    SetParentPhysNum: function(self, bone: number)

    --- Sets whether or not the given entity is persistent. A persistent entity will be saved on server shutdown and loaded back when the server starts up. Additionally, by default persistent entities cannot be grabbed with the physgun and tools cannot be used on them.
    --- In sandbox, this can be set on an entity by opening the context menu, right clicking the entity, and choosing `"Make Persistent"`.
    --- **NOTE**: Persistence can only be enabled with the sbox_persist convar, which works as an identifier for the current set of persistent entities. An empty identifier (which is the default value) disables this feature.
    -- @param persist --- Whether or not the entity should be persistent.
    SetPersistent: function(self, persist: boolean)

    --- When called on a constraint entity, sets the two physics objects to be constrained.
    --- Usage is not recommended as the Constraint library provides easier ways to deal with constraints.
    -- @param Phys1 --- The first physics object to be constrained.
    -- @param Phys2 --- The second physics object to be constrained.
    SetPhysConstraintObjects: function(self, Phys1: GPhysObj, Phys2: GPhysObj)

    --- Sets the player who gets credit if this entity kills something with physics damage within the time limit.
    --- **NOTE**: Only functional on props, "anim" type SENTs, vehicles and a few other select entities.
    -- @param ent --- Player who gets the kills. Setting this to a non-player entity will not work.
    -- @param timeLimit --- Time in seconds until the entity forgets its physics attacker and prevents it from getting the kill credit.
    SetPhysicsAttacker: function(self, ent: GPlayer, timeLimit: number)

    --- Allows you to set how fast an entity's animation will play,
    --- with 1.0 being the default speed.
    --- **NOTE**: This function does not affect gestures.
    --- Use Entity:SetLayerPlaybackRate instead.
    -- @param fSpeed --- How fast the animation will play.
    SetPlaybackRate: function(self, fSpeed: number)

    --- Moves the entity to the specified position.
    --- Some entities, such as ragdolls, will continually reset their position. Consider using PhysObj:SetPos on every physics object to move ragdolls.
    --- **NOTE**: If the new position doesn't take effect right away, you can use Entity:SetupBones to force it to do so. This issue is especially common when trying to render the same entity twice or more in a single frame at different positions.
    --- **WARNING**: Entities with Entity:GetSolid of `SOLID_BBOX` will have their angles reset!
    --- **BUG**: [This will fail inside of predicted functions called during player movement processing. This includes WEAPON:PrimaryAttack and WEAPON:Think.](https://github.com/Facepunch/garrysmod-issues/issues/2447
    -- @param position --- The position to move the entity to.
    SetPos: function(self, position: GVector)

    --- Sets the specified pose parameter to the specified value.
    --- You should call Entity:InvalidateBoneCache after calling this function.
    --- **NOTE**: Avoid calling this in draw hooks, especially when animating things, as it might cause visual artifacts.
    -- @param poseName --- Name of the pose parameter. Entity:GetPoseParameterName might come in handy here.
    --- Can also be a pose parameter ID.
    -- @param poseValue --- The value to set the pose to.
    SetPoseParameter: function(self, poseName: string, poseValue: number)

    --- Sets whether an entity should be predictable or not.
    --- When an entity is set as predictable, its DT vars can be changed during predicted hooks. This is useful for entities which can be controlled by player input.
    --- Any datatable value that mismatches from the server will be overridden and a prediction error will be spewed.
    --- Weapons are predictable by default, and the drive system uses this function to make the controlled prop predictable as well.
    --- Visit  for a list of all predicted hooks, and the Prediction page.
    --- For further technical information on the subject, visit [valve's wiki](https://developer.valvesoftware.com/wiki/Prediction).
    --- **NOTE**: This function resets the datatable variables everytime it's called, it should ideally be called when a player starts using the entity and when he stops
    --- **NOTE**: Entities set as predictable with this function will be unmarked when the user lags and receives a full packet update, to handle such case visit GM:NotifyShouldTransmit
    -- @param setPredictable --- whether to make this entity predictable or not.
    SetPredictable: function(self, setPredictable: boolean)

    --- Prevents the server from sending any further information about the entity to a player.
    --- **NOTE**: You must also call this function on all entity's children. See Entity:GetChildren.
    --- [issue tracker](https://github.com/Facepunch/garrysmod-issues/issues/1736)
    --- Entity:SetFlexScale and other flex/bone manipulation functions will create a child entity.
    -- @param player --- The player to stop networking the entity to. Can also be a CRecipientFilter or a table as of March 2024 to affect multiple players at once.
    -- @param stopTransmitting --- true to stop the entity from networking, false to make it network again.
    --SetPreventTransmit: function(self, player: GPlayer|GCRecipientFilter|{GPlayer}, stopTransmitting: boolean)

    --- Sets the bone angles. This is used alongside Kinect in Entity:SetRagdollBuildFunction, for more info see ragdoll_motion entity.
    -- @param boneid --- Bone ID
    -- @param pos --- Angle to set
    SetRagdollAng: function(self, boneid: number, pos: GAngle)

    --- Sets the function to build the ragdoll. This is used alongside Kinect, for more info see `ragdoll_motion` entity in the game files.
    -- @param builder --- The build function.
    --- <callback>
    --- <arg type="Entity" name="ragdoll">The ragdoll to build</arg>
    --- </callback>
    SetRagdollBuildFunction: function(self, builder: function)

    --- Sets the bone position. This is used alongside Kinect in Entity:SetRagdollBuildFunction, for more info see ragdoll_motion entity.
    -- @param boneid --- Bone ID
    -- @param pos --- Position to set
    SetRagdollPos: function(self, boneid: number, pos: GVector)

    --- Sets the render angle override for the Entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/entity.lua#L16)
    -- @param newAngles --- The new render angles to be set to. To disable the override, set to nil.
    SetRenderAngles: function(self, newAngles: GAngle)

    --- Sets the render bounds for the entity.
    --- For world space coordinate alternative see Entity:SetRenderBoundsWS.
    -- @param mins --- The minimum corner of the bounds, relative to origin of the entity.
    -- @param maxs --- The maximum corner of the bounds, relative to origin of the entity.
    -- @param add --- If defined, adds this vector to maxs and subtracts this vector from mins.
    SetRenderBounds: function(self, mins: GVector, maxs: GVector, add: GVector)

    --- Sets the render bounds for the entity in world space coordinates. For relative coordinates see Entity:SetRenderBounds.
    -- @param mins --- The minimum corner of the bounds, relative to origin of the world/map.
    -- @param maxs --- The maximum corner of the bounds, relative to origin of the world/map.
    -- @param add --- If defined, adds this vector to maxs and subtracts this vector from mins.
    SetRenderBoundsWS: function(self, mins: GVector, maxs: GVector, add: GVector)

    --- Used to specify a plane, past which an object will be visually clipped.
    -- @param planeNormal --- The normal of the plane. Anything behind the normal will be clipped.
    -- @param planePosition --- The position of the plane.
    SetRenderClipPlane: function(self, planeNormal: GVector, planePosition: number)

    --- Enables the use of clipping planes to "cut" objects.
    -- @param enabled --- Enable or disable clipping planes
    SetRenderClipPlaneEnabled: function(self, enabled: boolean)

    --- Sets entity's render FX. Requires the entitys rendermode to support transparency.
    -- @param renderFX --- The new render FX to set, see Enums/kRenderFx
    SetRenderFX: function(self, renderFX: number)

    --- Sets the render mode of the entity.
    -- @param renderMode --- New render mode to set, see Enums/RENDERMODE.
    SetRenderMode: function(self, renderMode: number)

    --- Set the render origin override, a position where the Entity will be rendered at.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/entity.lua#L17)
    -- @param newOrigin --- The new origin in world coordinates where the Entity's model will now be rendered at. To disable the override, set to nil.
    SetRenderOrigin: function(self, newOrigin: GVector)

    --- Sets a save value for an entity. You can see a full list of an entity's save values by creating it and printing Entity:GetSaveTable.
    --- See Entity:GetInternalVariable for the opposite of this function.
    -- @param name --- Name of the save value to set
    -- @param value --- Value to set
    -- @return --- Key successfully set
    SetSaveValue: function(self, name: string, value: any): boolean

    --- Sets the entity's model sequence.
    --- If the specified sequence is already active, the animation will not be restarted. See Entity:ResetSequence for a function that restarts the animation even if it is already playing.
    --- In some cases you want to run Entity:ResetSequenceInfo to make this function run.
    --- **NOTE**: This will not work properly if called directly after calling Entity:SetModel. Consider waiting until the next Tick.
    --- Will not work on players due to the animations being reset every frame by the base gamemode animation system. See GM:CalcMainActivity.
    --- For custom scripted entities you will want to apply example from ENTITY:Think to make animations work.
    -- @param sequence --- The sequence to play.
    --- If set to a number, the input is treated as the sequence ID.
    --- If set to a string, the function will automatically call Entity:LookupSequence to retrieve the sequence ID.
    SetSequence: function(self, sequence: number)

    --- Sets whether or not the entity should make a physics contact sound when it's been picked up by a player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L11-L13)
    -- @param playsound --- True to play the pickup sound, false otherwise.
    SetShouldPlayPickupSound: function(self, playsound: boolean)

    --- Sets if entity should create a server ragdoll on death or a client one.
    --- **NOTE**: This is reset for players when they respawn (Entity:Spawn).
    --- Player ragdolls created with this enabled will have an owner set, see Entity:SetOwner for more information on what effects this has.
    -- @param serverragdoll --- Set `true` if ragdoll should be created on server, `false` if on client.
    SetShouldServerRagdoll: function(self, serverragdoll: boolean)

    --- Sets the skin of the entity.
    --- Entity:GetSkin returns current skin and Entity:SkinCount returns amount of skins.
    -- @param skinIndex --- 0-based index of the skin to use.
    SetSkin: function(self, skinIndex: number)

    --- Sets the solidity of an entity.
    -- @param solid_type --- The solid type. See the Enums/SOLID.
    SetSolid: function(self, solid_type: number)

    --- Sets solid flag(s) for the entity.
    --- This overrides any other flags the entity might have had. See Entity:AddSolidFlags for adding flags.
    -- @param flags --- The flag(s) to set, see Enums/FSOLID.
    SetSolidFlags: function(self, flags: E_FSOLID)

    --- Sets whether the entity should use a spawn effect when it is created on the client.
    --- See Entity:GetSpawnEffect for more information on how the effect is applied.
    --- **NOTE**: This function will only have an effect when the entity spawns. After that it will do nothing even is set to true.
    -- @param spawnEffect --- Sets if we should show a spawn effect.
    SetSpawnEffect: function(self, spawnEffect: boolean)

    --- Sets the SpawnFlags to set of an Entity
    --- SpawnFlags can easily be found on https://developer.valvesoftware.com/wiki/.
    --- **NOTE**: See also Entity:RemoveSpawnFlags, Entity:AddSpawnFlags
    --- Using SF Enumerations won't work, if this function is ran clientside due to the enumerations being defined only Serverside. Use the actual SpawnFlag number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L7-L9)
    -- @param flags --- The SpawnFlag to remove from the Entity
    SetSpawnFlags: function(self, flags: number)

    --- Overrides a single material on the model of this entity.
    --- To set a Lua material created with Global.CreateMaterial, just prepend a `!` to the material name.
    --- **VALIDATE**: The index argument limit seems to be larger than 0 to 31.
    --- **BUG**: [The server's value takes priority on the client.](https://github.com/Facepunch/garrysmod-issues/issues/3362
    -- @param index --- Index of the material to override, acceptable values are from 0 to 31.
    --- Indexes are by Entity:GetMaterials, but you have to subtract 1 from them.
    --- If called with no arguments, all sub materials will be reset.
    -- @param material --- The material to override the default one with. Set to nil to revert to default material.
    SetSubMaterial: function(self, index: number, material: string)

    --- Sets the axis-aligned bounding box (AABB) for an entity's hitbox detection.
    --- See also Entity:SetSurroundingBoundsType (mutually exclusive).
    -- @param min --- Minimum extent of the AABB relative to entity's position.
    -- @param max --- Maximum extent of the AABB relative to entity's position.
    SetSurroundingBounds: function(self, min: GVector, max: GVector)

    --- Automatically sets the axis-aligned bounding box (AABB) for an entity's hitbox detection.
    --- See also Entity:SetSurroundingBounds (mutually exclusive).
    -- @param bounds --- Bounds type of the entity, see Enums/BOUNDS
    SetSurroundingBoundsType: function(self, bounds: E_BOUNDS)

    --- **INTERNAL**:
    --- Changes the table that can be accessed by indexing an entity. Each entity starts with its own table by default.
    -- @param tab --- Table for the entity to use
    SetTable: function(self, tab: table)

    --- When this flag is set the entity will only transmit to the player when its parent is transmitted. This is useful for things like viewmodel attachments since without this flag they will transmit to everyone (and cause the viewmodels to transmit to everyone too).
    --- **NOTE**: In the case of scripted entities, this will override ENTITY:UpdateTransmitState
    -- @param onoff --- Will set the TransmitWithParent flag on or off
    SetTransmitWithParent: function(self, onoff: boolean)

    --- Marks the entity as a trigger, so it will generate ENTITY:StartTouch, ENTITY:Touch and ENTITY:EndTouch callbacks.
    --- Internally this is stored as FSOLID_TRIGGER flag.
    -- @param maketrigger --- Make the entity trigger or not
    SetTrigger: function(self, maketrigger: boolean)

    --- Sets whether an entity can be unfrozen, meaning that it cannot be unfrozen using the physgun.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L594-L596)
    -- @param freezable --- True to make the entity unfreezable, false otherwise.
    SetUnFreezable: function(self, freezable: boolean)

    --- Sets the use type of an entity, affecting how often ENTITY:Use will be called for Lua entities.
    -- @param useType --- The use type to apply to the entity. Uses Enums/_USE.
    SetUseType: function(self, useType: E__USE)

    --- Allows to quickly set variable to entity's Entity:GetTable.
    --- **NOTE**: This will not network the variable to client(s). You want Entity:SetNWString and similar functions for that
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L102-L106)
    -- @param key --- Key of the value to set
    -- @param value --- Value to set the variable to
    SetVar: function(self, key: any, value: any)

    --- Sets the entity's velocity. For entities with physics, consider using PhysObj:SetVelocity on the PhysObj of the entity.
    --- **NOTE**: Actually binds to CBaseEntity::SetBaseVelocity() which sets the entity's velocity due to forces applied by other entities.
    --- **WARNING**: If applied to a player, this will actually **ADD** velocity, not set it. (due to how movement code handles base velocity)
    -- @param velocity --- The new velocity to set.
    SetVelocity: function(self, velocity: GVector)

    --- Sets the model and associated weapon to this viewmodel entity.
    --- This is used internally when the player switches weapon.
    --- **NOTE**: View models are not drawn without a weapons associated to them.
    --- **WARNING**: This will silently fail if the entity is not a viewmodel.
    -- @param viewModel --- The model string to give to this viewmodel.
    --- Example: "models/weapons/c_smg1.mdl"
    -- @param weapon --- The weapon entity to associate this viewmodel to.
    SetWeaponModel: function(self, viewModel: string, weapon: GWeapon)

    --- Forces the entity to reconfigure its bones. You might need to call this after changing your model's scales or when manually drawing the entity multiple times at different positions.
    --- **NOTE**: This calls the BuildBonePositions callback added via Entity:AddCallback, so avoid calling this function inside it to prevent an infinite loop.
    SetupBones: function(self)

    --- Initializes the class names of an entity's phoneme mappings (mouth movement data). This is called by default with argument "phonemes" when a flex-based entity (such as an NPC) is created.
    --- **NOTE**: TF2 phonemes can be accessed by using a path such as "player/scout/phonemes/phonemes" , check TF2's "tf2_misc_dir.vpk" with GCFScape for other paths, however it seems that TF2 sounds don't contain phoneme definitions anymore after being converted to mp3 and only rely on VCD animations, this needs to be further investigated
    -- @param fileRoot --- The file prefix of the phoneme mappings (relative to "garrysmod/expressions/").
    SetupPhonemeMappings: function(self, fileRoot: string)

    --- Returns the amount of skins the entity has.
    --- To set the entity's skin, use Entity:SetSkin.
    --- To retrieve the total number of skins without an entity, see util.GetModelInfo.
    -- @return --- The amount of skins the entity's model has.
    SkinCount: function(self): number

    --- Moves the model instance from the source entity to this entity. This can be used to transfer decals that have been applied on one entity to another.
    --- Both entities must have the same model.
    -- @param srcEntity --- Entity to move the model instance from.
    -- @return --- Whether the operation was successful or not
    SnatchModelInstance: function(self, srcEntity: GEntity): boolean

    --- Initializes the entity and starts its networking. If called on a player, it will respawn them.
    --- This calls ENTITY:Initialize on Lua-defined entities.
    Spawn: function(self)

    --- Starts a "looping" sound. As with any other sound playing methods, this function expects the sound file to be looping itself and will not automatically loop a non looping sound file as one might expect.
    --- This function is almost identical to Global.CreateSound, with the exception of the sound being created in the STATIC channel and with normal attenuation.
    --- See also Entity:StopLoopingSound
    -- @param sound --- Sound to play. Can be either a sound script or a filepath.
    -- @return --- The ID number of started sound starting with 0, or -1 if we failed for some reason.
    StartLoopingSound: function(self, sound: string): number

    --- Starts a motion controller in the physics engine tied to this entity's PhysObj, which enables the use of ENTITY:PhysicsSimulate.
    --- The motion controller can later be destroyed via Entity:StopMotionController.
    --- Motion controllers are used internally to control other Entities' PhysObjects, such as the Gravity Gun, +use pickup and the Physics Gun.
    --- This function should be called every time you recreate the Entity's PhysObj. Or alternatively you should call Entity:AddToMotionController on the new PhysObj.
    --- Also see Entity:AddToMotionController and Entity:RemoveFromMotionController.
    --- **NOTE**: Only works on a scripted Entity of anim type.
    StartMotionController: function(self)

    --- Stops all particle effects parented to the entity and immediately destroys them.
    StopAndDestroyParticles: function(self)

    --- Stops a sound created by Entity:StartLoopingSound.
    -- @param id --- The sound ID returned by Entity:StartLoopingSound
    StopLoopingSound: function(self, id: number)

    --- Stops the motion controller created with Entity:StartMotionController.
    StopMotionController: function(self)

    --- Stops all particle effects parented to the entity.
    --- This is ran automatically on every client by Entity:StopParticles if called on the server.
    StopParticleEmission: function(self)

    --- Stops any attached to the entity .pcf particles using Global.ParticleEffectAttach or Global.ParticleEffect.
    --- On client, this is the same as Entity:StopParticleEmission. ( and you should use StopParticleEmission instead )
    --- On server, this is the same as running Entity:StopParticleEmission on every client.
    StopParticles: function(self)

    --- Stops all particle effects parented to the entity with given name.
    -- @param name --- The name of the particle to stop.
    StopParticlesNamed: function(self, name: string)

    --- Stops all particle effects parented to the entity with given name on given attachment.
    -- @param name --- The name of the particle to stop.
    -- @param attachment --- The attachment of the entity to stop particles on.
    StopParticlesWithNameAndAttachment: function(self, name: string, attachment: number)

    --- Stops emitting the given sound from the entity, especially useful for looping sounds.
    -- @param sound --- The name of the sound script or the filepath to stop playback of.
    StopSound: function(self, sound: string)

    --- Applies the specified amount of damage to the entity with DMG_GENERIC flag.
    --- **WARNING**: Calling this function on the victim entity in ENTITY:OnTakeDamage can cause infinite loops.
    --- **WARNING**: This function does not seem to do any damage if you apply it to a player who is driving a prop_vehicle_jeep or prop_vehicle_jeep_old vehicle. You need to call it on the vehicle instead.
    -- @param damageAmount --- The amount of damage to be applied.
    -- @param attacker --- The entity that initiated the attack that caused the damage.
    -- @param inflictor --- The entity that applied the damage, eg. a weapon.
    TakeDamage: function(self, damageAmount: number, attacker: GEntity, inflictor: GEntity)

    --- Applies the damage specified by the damage info to the entity.
    --- **WARNING**: Calling this function on the victim entity in ENTITY:OnTakeDamage can cause infinite loops.
    --- **WARNING**: This function does not seem to do any damage if you apply it to a player who is driving a prop_vehicle_jeep or prop_vehicle_jeep_old vehicle. You need to call it on the vehicle instead.
    --- **NOTE**: This function does not apply damage to [func_breakable_surf](https://developer.valvesoftware.com/wiki/Func_breakable_surf) entities correctly. To do this, you will need to use Entity:DispatchTraceAttack instead.
    -- @param damageInfo --- The damage to apply.
    TakeDamageInfo: function(self, damageInfo: GCTakeDamageInfo)

    --- Applies forces to our physics object in response to damage.
    -- @param dmginfo --- The damageinfo to apply. Only CTakeDamageInfo:GetDamageForce and CTakeDamageInfo:GetDamagePosition are used.
    TakePhysicsDamage: function(self, dmginfo: GCTakeDamageInfo)

    --- Check if the given position or entity is within this entity's [PVS(Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community").
    --- See also Entity:IsDormant.
    --- **NOTE**: The function won't take in to account Global.AddOriginToPVS and the like.
    -- @param testPoint --- Entity or Vector to test against. If an entity is given, this function will test using its bounding box.
    -- @return --- `true` if the testPoint is within our PVS.
    TestPVS: function(self, testPoint: GVector|GEntity): boolean

    --- Returns the ID of a PhysObj attached to the given bone.
    --- See Entity:TranslatePhysBoneToBone for reverse function.
    -- @param boneID --- The ID of a bone to look up the "physics root" bone of.
    -- @return --- The PhysObj ID of the given bone to be used with Entity:GetPhysicsObjectNum or `-1` if we cannot translate for some reason, such as a model bone having no physics object associated with it.
    TranslateBoneToPhysBone: function(self, boneID: number): number

    --- Returns the boneID of the bone the given PhysObj is attached to.
    --- See Entity:TranslateBoneToPhysBone for reverse function.
    -- @param physNum --- The PhysObj number on the entity
    -- @return --- The boneID of the bone the PhysObj is attached to.
    TranslatePhysBoneToBone: function(self, physNum: number): number

    --- Updates positions of bone followers created by Entity:CreateBoneFollowers.
    --- This should be called every tick.
    --- **NOTE**: This function only works on `anim`, `nextbot` and `ai` type entities.
    UpdateBoneFollowers: function(self)

    --- Marks the render-to-texture (RTT) shadow of this entity as dirty, as well as any potential projected texture shadows related to this entity, so they will be updated as soon as possible.
    UpdateShadow: function(self)

    --- Simulates a `+use` action on an entity.
    -- @param activator --- The entity that caused this input. This will usually be the player who pressed their use key
    -- @param caller --- The entity responsible for the input. This will typically be the same as `activator` unless some other entity is acting as a proxy
    -- @param useType --- Use type, see Enums/USE.
    -- @param value --- Any value.
    Use: function(self, activator: GEntity, caller: GEntity, useType: E_USE, value: number)

    --- **NOTE**: Does nothing on server.
    --- Animations will be handled purely clientside instead of a fixed animtime, enabling interpolation. This does not affect layers and gestures.
    UseClientSideAnimation: function(self)

    --- Enables or disables trigger bounds.
    --- This will give the entity a "trigger box" that extends around its bounding box by boundSize units in X/Y and (boundSize / 2) in +Z (-Z remains the same).
    --- The trigger box is world aligned and will work regardless of the object's solidity and collision group.
    --- Valve use trigger boxes for all pickup items. Their bloat size is 24, a surprisingly large figure.
    --- **NOTE**: The trigger boxes can be made visible as a light blue box by using the **ent_bbox** console command while looking at the entity. Alternatively a classname or entity index can be used as the first argument.
    --- This requires **developer** to be set to **1**.
    -- @param enable --- Enable or disable the bounds.
    -- @param boundSize --- The distance/size of the trigger bounds.
    UseTriggerBounds: function(self, enable: boolean, boundSize: number)

    --- Returns the index of this view model, it can be used to identify which one of the player's view models this entity is.
    -- @return --- View model index, ranges from 0 to 2, nil if the entity is not a view model
    ViewModelIndex: function(self): number

    --- Returns whether the target/given entity is visible from the this entity.
    --- This is meant to be used only with NPCs.
    --- Differences from a simple trace include:
    --- * If target has `FL_NOTARGET`, returns `false`
    --- * If `ai_ignoreplayers` is turned on and target is a player, returns `false`
    --- * Reacts to `ai_LOS_mode`:
    --- * * If `1`, does a simple trace with `COLLISION_GROUP_NONE` and `MASK_BLOCKLOS`
    --- * * If not, does a trace with `MASK_BLOCKLOS_AND_NPCS` (- `CONTENTS_BLOCKLOS` is target is player) and a custom LOS filter (`CTraceFilterLOS`)
    --- * Returns `true` if hits a vehicle the target is driving
    -- @param target --- Entity to check for visibility to.
    -- @return --- If the entities can see each other.
    Visible: function(self, target: GEntity): boolean

    --- Returns true if supplied vector is visible from the entity's line of sight.
    --- This is achieved similarly to a trace.
    -- @param pos --- The position to check for visibility
    -- @return --- Within line of sight
    VisibleVec: function(self, pos: GVector): boolean

    --- Returns an integer that represents how deep in water the entity is.
    -- @return --- The water level.
    --- * **0** - The entity isn't in water.
    --- * **1** - Slightly submerged (at least to the feet).
    --- * **2** - The majority of the entity is submerged (at least to the waist).
    --- * **3** - Completely submerged.
    WaterLevel: function(self): number

    --- Sets the activity of the entity's active weapon.
    --- **NOTE**: This does nothing on the client.
    --- **NOTE**: Only works for CBaseCombatCharacter entities, which includes players and NPCs.
    -- @param act --- Activity number. See Enums/ACT.
    -- @param duration --- How long the animation should take in seconds.
    Weapon_SetActivity: function(self, act: number, duration: number)

    --- Calls and returns WEAPON:TranslateActivity on the weapon the entity ( player or NPC ) carries.
    --- Despite existing on client, it doesn't actually do anything on client.
    -- @param act --- The NPC activity to translate
    -- @return --- The translated activity. Defaults to `act` input when a translation doesn't exist.
    Weapon_TranslateActivity: function(self, act: number): number

    --- Returns two vectors representing the minimum and maximum extent of the entity's axis-aligned bounding box (which is calculated from entity's collision bounds.
    -- @return --- The minimum vector for the entity's bounding box in world space.
    -- @return --- The maximum vector for the entity's bounding box in world space.
    WorldSpaceAABB: function(self): GVector, GVector

    --- Returns the center of the entity according to its collision model.
    -- @return --- The center of the entity
    WorldSpaceCenter: function(self): GVector

    --- Translates a worldspace vector into a vector relative to the entity's coordinate system.
    -- @param wpos --- A worldspace vector.
    -- @return --- The corresponding local space vector.
    WorldToLocal: function(self, wpos: GVector): GVector

    --- Translates a worldspace angle into an angle relative to the entity's coordinate system.
    -- @param ang --- A worldspace angle.
    -- @return --- The corresponding local space angle.
    WorldToLocalAngles: function(self, ang: GAngle): GAngle
end


--- **INTERNAL**:
--- This object is created by Global.WorkshopFileBase which is used internally to fetch data of the specific namespace
--- or to publish saves and dupes.
--- This also exists on the Server but most functions may throw an error. It's meant to be used clientside.
--- **NOTE**: You need to set the `HTML` field to a DHTML panel that is set up correctly like [here](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenttypes/dupes.lua#L12), or else you might get errors.
global interface GWorkshopFileBase
    --- Fetches all subscriptions for the set namespace and type
    --- **NOTE**: If you want to use the type `local` you need to implement the `:FetchLocal(offset, perpage)` function!
    -- @param type --- The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    -- @param offset --- Skips the first x results.
    -- @param perpage --- How many results per page should be returned.
    -- @param extratags --- additional tags to filter the results.
    -- @param searchText --- text that needs to be in the addon title. Use an empty string for none
    -- @param filter --- The filter for the results. (`enabledonly`, `disabledonly`)
    -- @param sort --- How it should be sorted. If set to `nil`, it will fallback to `timeadded`. (`title`, `size`, `updated`)
    Fetch: function(self, type: string, offset: number, perpage: number, extratags: table, searchText: string, filter: number, sort: string)

    --- Fetches all subscriptions for the set namespace and passes the result to WorkshopFileBase:FillFileInfo.
    -- @param offset --- Skips the first x results.
    -- @param perpage --- How many results per page should be returned.
    -- @param tags --- additional tags to filter the results.
    -- @param searchText --- text that needs to be in the addon title. Use an empty string for none
    -- @param isUGC --- if true it will use engine.GetUserContent instead of engine.GetAddons
    -- @param filter --- The filter for the results. (`enabledonly`, `disabledonly`)
    -- @param sort --- How it should be sorted. If set to `nil`, it will fallback to `timeadded`. (`title`, `size`, `updated`)
    FetchSubscribed: function(self, offset: number, perpage: number, tags: table, searchText: string, isUGC: boolean, filter: number, sort: string)

    --- Updates the set HTML panel with the newly fetched results
    -- @param results --- The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    -- @param isUGC --- Skips the first x results.
    FillFileInfo: function(self, results: table, isUGC: boolean)

    --- Creates a UGCPublishWindow to publish the dupe or save
    -- @param filename --- The type to search for. (`local`, `subscribed`, `subscribed_ugc`, `mine`, `favorite`)
    -- @param image --- The image to use
    Publish: function(self, filename: string, image: string)

    --- Retrieves the username for the given SteamID.
    -- @param steamid --- SteamID to retrieve the name for
    -- @param callback --- Callback function.
    --- <callback>
    --- <arg type="string" name="name">The retrieved name</arg>
    --- </callback>
    RetrieveUserName: function(self, steamid: string, callback: function)
end


--- This is a list of all methods only available for weapons. It is also possible to call Entity functions on weapons.
--- **NOTE**: A list of available methods has been expanded in your navigation bar.
global interface GWeapon is GEntity
    where self:IsWeapon()
    --- Returns whether the weapon allows to being switched from when a better ( Weapon:GetWeight ) weapon is being picked up.
    -- @return --- Whether the weapon allows to being switched from.
    AllowsAutoSwitchFrom: function(self): boolean

    --- Returns whether the weapon allows to being switched to when a better (Weapon:GetWeight) weapon is being picked up.
    -- @return --- Whether the weapon allows to being switched to.
    AllowsAutoSwitchTo: function(self): boolean

    --- Calls a SWEP function on client. Does nothing on client.
    --- **WARNING**: This uses the usermessage internally, because of that, the combined length of the arguments of this function may not exceed 254 bytes/characters or the function will cease to function!
    -- @param functionName --- Name of function to call. If you want to call `SWEP:MyFunc()` on client, you type in `"MyFunc"`
    -- @param data --- Custom data to be passed to the target SWEP function as the first argument.
    CallOnClient: function(self, functionName: string, data: string)

    --- Returns how much primary ammo is in the magazine.
    --- **NOTE**: This is not shared between clients and will instead return the maximum primary clip size.
    -- @return --- The amount of primary ammo in the magazine.
    Clip1: function(self): number

    --- Returns how much secondary ammo is in the magazine.
    --- **NOTE**: This is not shared between clients and will instead return the maximum secondary clip size.
    -- @return --- The amount of secondary ammo in the magazine.
    Clip2: function(self): number

    --- Forces the weapon to reload while playing given animation.
    --- **NOTE**: This will stop the Weapon:Think function from getting called while the weapon is reloading!
    -- @param act --- Sequence to use as reload animation. Uses the Enums/ACT.
    -- @return --- Did reloading actually take place
    DefaultReload: function(self, act: number): boolean

    --- Returns the sequence enumeration number that the weapon is playing.
    --- **BUG**: [This can return inconsistent results between the server and client.](https://github.com/Facepunch/garrysmod-issues/issues/2543
    -- @return --- Current activity, see Enums/ACT. Returns 0 if the weapon doesn't have active sequence.
    GetActivity: function(self): number

    --- Returns the weapon deploy speed, as set by Weapon:SetDeploySpeed. If not previously set, the value will be polled from the `sv_defaultdeployspeed` ConVar.
    -- @return speed --- The value to set deploy speed to.
    GetDeploySpeed: function(self): number

    --- Returns the hold type of the weapon.
    -- @return --- The hold type of the weapon. You can find a list of default hold types here.
    GetHoldType: function(self): string

    --- Returns maximum primary clip size
    -- @return --- Maximum primary clip size
    GetMaxClip1: function(self): number

    --- Returns maximum secondary clip size
    -- @return --- Maximum secondary clip size
    GetMaxClip2: function(self): number

    --- Gets the next time the weapon can primary fire. ( Can call WEAPON:PrimaryAttack )
    -- @return --- The time, relative to Global.CurTime
    GetNextPrimaryFire: function(self): number

    --- Gets the next time the weapon can secondary fire. ( Can call WEAPON:SecondaryAttack )
    -- @return --- The time, relative to Global.CurTime
    GetNextSecondaryFire: function(self): number

    --- Gets the primary ammo type of the given weapon.
    -- @return --- The ammo type ID, or -1 if not found.
    GetPrimaryAmmoType: function(self): number

    --- Returns the non-internal name of the weapon, that should be for displaying.
    --- **NOTE**: If that returns an untranslated message (#HL2_XX), use language.GetPhrase to see the "nice" name.
    --- **NOTE**: If SWEP.PrintName is not set in the Weapon or the Weapon Base then "<MISSING SWEP PRINT NAME>" will be returned.
    -- @return --- The "nice" name of the weapon.
    GetPrintName: function(self): string

    --- Gets the ammo type of the given weapons secondary fire.
    -- @return --- The secondary ammo type ID, or -1 if not found.
    GetSecondaryAmmoType: function(self): number

    --- Returns the slot of the weapon.
    --- **NOTE**: The slot numbers start from 0.
    -- @return --- The slot of the weapon.
    GetSlot: function(self): number

    --- Returns slot position of the weapon
    -- @return --- The slot position of the weapon
    GetSlotPos: function(self): number

    --- Returns the view model of the weapon.
    -- @return --- The view model of the weapon.
    GetWeaponViewModel: function(self): string

    --- Returns the world model of the weapon.
    -- @return --- The world model of the weapon.
    GetWeaponWorldModel: function(self): string

    --- Returns the "weight" of the weapon, which is used when deciding which Weapon is better by the engine.
    -- @return --- The weapon "weight".
    GetWeight: function(self): number

    --- Returns whether the weapon has ammo left or not. It will return false when there's no ammo left in the magazine **and** when there's no reserve ammo left.
    --- **NOTE**: This will return true for weapons like crowbar, gravity gun, etc.
    -- @return --- Whether the weapon has ammo or not.
    HasAmmo: function(self): boolean

    --- Returns whenever the weapon is carried by the local player.
    -- @return --- Is the weapon is carried by the local player or not
    IsCarriedByLocalPlayer: function(self): boolean

    --- Checks if the weapon is a SWEP or a built-in weapon.
    -- @return --- Returns true if weapon is scripted ( SWEP ), false if not ( A built-in HL2/HL:S weapon )
    IsScripted: function(self): boolean

    --- Returns whether the weapon is visible. The term visibility is not exactly what gets checked here, first it checks if the owner is a player, then checks if the active view model has EF_NODRAW flag NOT set.
    -- @return --- Is visible or not
    IsWeaponVisible: function(self): boolean

    --- Returns the time since this weapon last fired a bullet with Entity:FireBullets in seconds. It is not networked.
    -- @return --- The time in seconds when the last bullet was fired.
    LastShootTime: function(self): number

    --- Forces weapon to play activity/animation.
    -- @param act --- Activity to play. See the Enums/ACT (specifically `ACT_VM_`).
    SendWeaponAnim: function(self, act: number)

    --- Sets the activity the weapon is playing.
    --- See also Weapon:GetActivity.
    -- @param act --- The new activity to set, see Enums/ACT.
    SetActivity: function(self, act: number)

    --- Lets you change the number of bullets in the given weapons primary clip.
    -- @param ammo --- The amount of bullets the clip should contain
    SetClip1: function(self, ammo: number)

    --- Lets you change the number of bullets in the given weapons secondary clip.
    -- @param ammo --- The amount of bullets the clip should contain
    SetClip2: function(self, ammo: number)

    --- Sets the weapon deploy speed. This value needs to match on client and server.
    -- @param speed --- The value to set deploy speed to. Values less than `1` will slow down the animations. Minimum value is `0.1`.
    SetDeploySpeed: function(self, speed: number)

    --- Sets the hold type of the weapon. This function also calls WEAPON:SetWeaponHoldType and properly networks it to all clients.
    --- **NOTE**: This only works on scripted weapons.
    --- **BUG**: Using this function on weapons held by bots will not network holdtype changes to clients if the world model is set to an empty string (SWEP.WorldModel = "").
    -- @param name --- Name of the hold type. You can find all default hold types here
    SetHoldType: function(self, name: string)

    --- Sets the time since this weapon last fired in seconds. Used in conjunction with Weapon:LastShootTime
    -- @param time --- The time in seconds when the last time the weapon was fired.
    SetLastShootTime: function(self, time: number)

    --- Sets when the weapon can fire again. Time should be based on Global.CurTime.
    --- **NOTE**: The standard HL2 Pistol (`weapon_pistol`) bypasses this function due to an [internal implementation](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/server/hl2/weapon_pistol.cpp#L313-L317).
    --- **BUG**: [This will fire extra bullets if the time is set to less than Global.CurTime.](https://github.com/Facepunch/garrysmod-issues/issues/3786
    -- @param time --- Time when player should be able to use primary fire again
    SetNextPrimaryFire: function(self, time: number)

    --- Sets when the weapon can alt-fire again. Time should be based on Global.CurTime.
    -- @param time --- Time when player should be able to use secondary fire again
    SetNextSecondaryFire: function(self, time: number)
end


--- A 4x4 matrix.
--- This page lists all possible functions to manipulate matrices.
--- This object can be created by Global.Matrix.
--- Metamethod | Second Operand | Description
--- ---------- | -------------- | -----------
--- `__add` | VMatrix | Returns new VMatrix with the result of addition.
--- `__eq` | any | Compares 2 operands, if they both are VMatrix, compares each individual component.
--- `__mul` | VMatrix or Vector | Returns new VMatrix or Vector with the result of multiplication.
--- `__sub` | VMatrix | Returns new VMatrix with the result of subtraction.
--- `__tostring` |  | Returns a string in format `[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]\n[%f,\t%f,\t%f,\t%f]`.
--- `__unm` | | Returns new VMatrix with the result of negation.
global interface GVMatrix
    --- Adds given matrix to this matrix.
    -- @param input --- The input matrix to add.
    Add: function(self, input: GVMatrix)

    --- Returns the absolute rotation of the matrix. Scaled matrix might produce unexpected results!
    -- @return --- Absolute rotation of the matrix
    GetAngles: function(self): GAngle

    --- Returns a specific field in the matrix.
    -- @param row --- Row of the field whose value is to be retrieved, from 1 to 4
    -- @param column --- Column of the field whose value is to be retrieved, from 1 to 4
    -- @return --- The value of the specified field
    GetField: function(self, row: number, column: number): number

    --- Gets the forward direction of the matrix.
    --- ie. The first column of the matrix, excluding the w coordinate.
    -- @return --- The forward direction of the matrix.
    GetForward: function(self): GVector

    --- Returns an inverted matrix without modifying the original matrix.
    --- Inverting the matrix will fail if its [determinant](https://en.wikipedia.org/wiki/Determinant) is 0 or close to 0. (ie. its "scale" in any direction is 0.)
    --- See also VMatrix:GetInverseTR.
    -- @return --- The inverted matrix if possible, nil otherwise
    GetInverse: function(self): GVMatrix

    --- Returns an inverted matrix without modifying the original matrix. This function will not fail, but only works correctly on matrices that contain only translation and/or rotation.
    --- Using this function on a matrix with modified scale may return an incorrect inverted matrix.
    --- To get the inverse of a matrix that contains other modifications, see VMatrix:GetInverse.
    -- @return --- The inverted matrix.
    GetInverseTR: function(self): GVMatrix

    --- Gets the right direction of the matrix.
    --- ie. The second column of the matrix, negated, excluding the w coordinate.
    -- @return --- The right direction of the matrix.
    GetRight: function(self): GVector

    --- Returns the absolute scale of the matrix.
    -- @return --- Absolute scale of the matrix
    GetScale: function(self): GVector

    --- Returns the absolute translation of the matrix.
    -- @return --- Absolute translation of the matrix
    GetTranslation: function(self): GVector

    --- Returns the transpose (each row becomes a column) of this matrix.
    -- @return transposed --- The transposed matrix.
    GetTransposed: function(self): GVMatrix

    --- Gets the up direction of the matrix.
    --- ie. The third column of the matrix, excluding the w coordinate.
    -- @return --- The up direction of the matrix.
    GetUp: function(self): GVector

    --- Initializes the matrix as Identity matrix.
    Identity: function(self)

    --- Inverts the matrix.
    --- Inverting the matrix will fail if its [determinant](https://en.wikipedia.org/wiki/Determinant) is 0 or close to 0. (ie. its "scale" in any direction is 0.)
    --- If the matrix cannot be inverted, it does not get modified.
    --- See also VMatrix:InvertTR.
    -- @return --- Whether the matrix was inverted or not
    Invert: function(self): boolean

    --- Quickly inverts the matrix. This function will not fail, but only works correctly on matrices that contain only translation and/or rotation.
    --- Using this function on a matrix with modified scale may return an incorrect inverted matrix.
    --- To invert a matrix that contains other modifications, see VMatrix:Invert. This function is faster.
    InvertTR: function(self)

    --- Returns whether the matrix is equal to Identity matrix or not.
    -- @return --- Is the matrix an Identity matrix or not
    IsIdentity: function(self): boolean

    --- Returns whether the matrix is a rotation matrix or not.
    --- Technically it checks if the forward, right and up vectors are orthogonal and normalized.
    -- @return --- Is the matrix a rotation matrix or not
    IsRotationMatrix: function(self): boolean

    --- Checks whenever all fields of the matrix are 0, aka if this is a [null matrix](https://en.wikipedia.org/wiki/Zero_matrix).
    -- @return --- If the matrix is a null matrix.
    IsZero: function(self): boolean

    --- Multiplies this matrix by given matrix.
    -- @param input --- The input matrix to multiply by.
    Mul: function(self, input: GVMatrix)

    --- Rotates the matrix by the given angle.
    --- Postmultiplies the matrix by a rotation matrix (A = AR).
    -- @param rotation --- Rotation.
    Rotate: function(self, rotation: GAngle)

    --- Scales the matrix by the given vector.
    --- Postmultiplies the matrix by a scaling matrix (A = AS).
    -- @param scale --- Vector to scale with matrix with.
    Scale: function(self, scale: GVector)

    --- Scales the absolute translation with the given value.
    -- @param scale --- Value to scale the translation with.
    ScaleTranslation: function(self, scale: number)

    --- Copies values from the given matrix object.
    -- @param src --- The matrix to copy values from.
    Set: function(self, src: GVMatrix)

    --- Sets the absolute rotation of the matrix.
    -- @param angle --- New angles.
    SetAngles: function(self, angle: GAngle)

    --- Sets a specific field in the matrix.
    -- @param row --- Row of the field to be set, from 1 to 4
    -- @param column --- Column of the field to be set, from 1 to 4
    -- @param value --- The value to set in that field
    SetField: function(self, row: number, column: number, value: number)

    --- Sets the forward direction of the matrix.
    --- ie. The first column of the matrix, excluding the w coordinate.
    -- @param forward --- The forward direction of the matrix.
    SetForward: function(self, forward: GVector)

    --- Sets the right direction of the matrix.
    --- ie. The second column of the matrix, negated, excluding the w coordinate.
    -- @param forward --- The right direction of the matrix.
    SetRight: function(self, forward: GVector)

    --- Modifies the scale of the matrix while preserving the rotation and translation.
    -- @param scale --- The scale to set.
    SetScale: function(self, scale: GVector)

    --- Sets the absolute translation of the matrix.
    -- @param translation --- New translation.
    SetTranslation: function(self, translation: GVector)

    --- Sets each component of the matrix.
    -- @param e11 ---
    -- @param e12 ---
    -- @param e13 ---
    -- @param e14 ---
    -- @param e21 ---
    -- @param e22 ---
    -- @param e23 ---
    -- @param e24 ---
    -- @param e31 ---
    -- @param e32 ---
    -- @param e33 ---
    -- @param e34 ---
    -- @param e41 ---
    -- @param e42 ---
    -- @param e43 ---
    -- @param e44 ---
    SetUnpacked: function(self, e11: number, e12: number, e13: number, e14: number, e21: number, e22: number, e23: number, e24: number, e31: number, e32: number, e33: number, e34: number, e41: number, e42: number, e43: number, e44: number)

    --- Sets the up direction of the matrix.
    --- ie. The third column of the matrix, excluding the w coordinate.
    -- @param forward --- The up direction of the matrix.
    SetUp: function(self, forward: GVector)

    --- Subtracts given matrix from this matrix.
    -- @param input --- The input matrix to subtract.
    Sub: function(self, input: GVMatrix)

    --- Converts the matrix to a 4x4 table. See Global.Matrix function.
    -- @return --- The 4x4 table.
    ToTable: function(self): table

    --- Translates the matrix by the given vector aka. adds the vector to the translation.
    --- Postmultiplies the matrix by a translation matrix (A = AT).
    -- @param translation --- Vector to translate the matrix by.
    Translate: function(self, translation: GVector)

    --- Returns each component of the matrix, expanding rows before columns.
    -- @return --- VMatrix:GetField(1, 1)
    -- @return --- VMatrix:GetField(1, 2)
    -- @return --- VMatrix:GetField(1, 3)
    -- @return --- VMatrix:GetField(1, 4)
    -- @return --- VMatrix:GetField(2, 1)
    -- @return --- VMatrix:GetField(2, 2)
    -- @return --- VMatrix:GetField(2, 3)
    -- @return --- VMatrix:GetField(2, 4)
    -- @return --- VMatrix:GetField(3, 1)
    -- @return --- VMatrix:GetField(3, 2)
    -- @return --- VMatrix:GetField(3, 3)
    -- @return --- VMatrix:GetField(3, 4)
    -- @return --- VMatrix:GetField(4, 1)
    -- @return --- VMatrix:GetField(4, 2)
    -- @return --- VMatrix:GetField(4, 3)
    -- @return --- VMatrix:GetField(4, 4)
    Unpack: function(self): number, number, number, number, number, number, number, number, number, number, number, number, number, number, number, number

    --- Sets all components of the matrix to 0, also known as a [null matrix](https://en.wikipedia.org/wiki/Zero_matrix).
    --- This function is more efficient than setting each element manually.
    Zero: function(self)
end


--- This is a list of all methods only available for vehicles. It is also possible to call Entity functions on vehicles.
global interface GVehicle is GEntity
    where self:IsVehicle()
    --- Returns the remaining boosting time left.
    -- @return --- The remaining boosting time left
    BoostTimeLeft: function(self): number

    --- Tries to find an Exit Point for leaving vehicle, if one is unobstructed in the direction given.
    -- @param yaw --- Yaw/roll from vehicle angle to check for exit
    -- @param distance --- Distance from origin to drop player
    -- @return --- Returns the vector for exit position or nil if cannot exit that way.
    CheckExitPoint: function(self, yaw: number, distance: number): GVector

    --- Sets whether the engine is enabled or disabled, i.e. can be started or not.
    -- @param enable --- Enable or disable the engine
    EnableEngine: function(self, enable: boolean)

    --- Returns information about the ammo of the vehicle
    -- @return --- Ammo type of the vehicle ammo
    -- @return --- Clip size
    -- @return --- Count
    GetAmmo: function(self): number, number, number

    --- Returns third person camera distance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L683-L687)
    -- @return --- Camera distance
    GetCameraDistance: function(self): number

    --- Gets the driver of the vehicle, returns NULL if no driver is present.
    -- @return --- The driver of the vehicle.
    GetDriver: function(self): GEntity

    --- Returns the current speed of the vehicle in Half-Life Hammer Units (in/s). Same as Entity:GetVelocity + Vector:Length.
    -- @return --- The speed of the vehicle
    GetHLSpeed: function(self): number

    --- Returns the max speed of the vehicle in MPH.
    -- @return --- The max speed of the vehicle in MPH
    GetMaxSpeed: function(self): number

    --- Returns some info about the vehicle.
    -- @return --- The operating parameters.
    GetOperatingParams: function(self): S_OperatingParams

    --- Gets the passenger of the vehicle, returns NULL if no drivers is present.
    -- @param passenger --- The index of the passenger ( 0 is the driver )
    -- @return --- The passenger
    GetPassenger: function(self, passenger: number): GEntity

    --- Returns the seat position and angle of a given passenger seat.
    -- @param role --- The passenger role. ( 0 is the driver )
    -- @return --- The seat position in worldspace coordinates.
    -- @return --- The seat angle in worldspace coordinates.
    GetPassengerSeatPoint: function(self, role: number): GVector, GAngle

    --- Returns the current RPM of the vehicle. This value is fake and doesn't actually affect the vehicle movement.
    -- @return --- The RPM.
    GetRPM: function(self): number

    --- Returns the current speed of the vehicle in MPH.
    -- @return --- The speed of the vehicle in MPH
    GetSpeed: function(self): number

    --- Returns the current steering of the vehicle.
    -- @return --- The current steering of the vehicle.
    GetSteering: function(self): number

    --- Returns the maximum steering degree of the vehicle
    -- @return --- The maximum steering degree of the vehicle
    GetSteeringDegrees: function(self): number

    --- Returns if vehicle has thirdperson mode enabled or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L696-L700)
    -- @return --- Returns `true` if third person mode enabled, `false` otherwise
    GetThirdPersonMode: function(self): boolean

    --- Returns the current throttle of the vehicle.
    -- @return --- The current throttle of the vehicle
    GetThrottle: function(self): number

    --- Returns the vehicle class name. This is only useful for Sandbox spawned vehicles or any vehicle that properly sets the vehicle class with Vehicle:SetVehicleClass.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L684-L688)
    -- @return --- The class name of the vehicle.
    GetVehicleClass: function(self): string

    --- Returns the vehicle parameters of given vehicle.
    -- @return --- The vehicle parameters.
    GetVehicleParams: function(self): S_VehicleParams

    --- Returns the view position and forward angle of a given passenger seat.
    -- @param role --- The passenger role. 0 is the driver. This parameter seems to be ignored by the game engine and is therefore optional.
    -- @return --- The view position, will be 0, 0, 0 on failure
    -- @return --- The view angles, will be 0, 0, 0 on failure
    -- @return --- The field of view, will be 0 on failure
    GetVehicleViewPosition: function(self, role: number): GVector, GAngle, number

    --- Returns the PhysObj of given wheel.
    -- @param wheel --- The wheel to retrieve
    -- @return --- The wheel
    GetWheel: function(self, wheel: number): GPhysObj

    --- Returns the base wheel height.
    -- @param wheel --- The wheel to get the base wheel height of.
    -- @return --- The base wheel height.
    GetWheelBaseHeight: function(self, wheel: number): number

    --- Returns the wheel contact point.
    -- @param wheel --- The wheel to check
    -- @return --- The contact position
    -- @return --- The Surface Properties ID of hit surface.
    -- @return --- Whether the wheel is on ground or not
    GetWheelContactPoint: function(self, wheel: number): GVector, number, boolean

    --- Returns the wheel count of the vehicle
    -- @return --- The amount of wheels
    GetWheelCount: function(self): number

    --- Returns the total wheel height.
    -- @param wheel --- The wheel to get the base wheel height of.
    -- @return --- The total wheel height.
    GetWheelTotalHeight: function(self, wheel: number): number

    --- Returns whether this vehicle has boost at all.
    -- @return --- Whether this vehicle has boost at all.
    HasBoost: function(self): boolean

    --- Returns whether this vehicle has a brake pedal. See Vehicle:SetHasBrakePedal.
    -- @return --- Whether this vehicle has a brake pedal or not.
    HasBrakePedal: function(self): boolean

    --- Returns whether this vehicle is currently boosting or not.
    -- @return --- Whether this vehicle is currently boosting or not.
    IsBoosting: function(self): boolean

    --- Returns whether the engine is enabled or not, i.e. whether it can be started.
    -- @return --- Whether the engine is enabled
    IsEngineEnabled: function(self): boolean

    --- Returns whether the engine is started or not.
    -- @return --- Whether the engine is started or not.
    IsEngineStarted: function(self): boolean

    --- Determines whether a given Vehicle is fully initialized.
    --- It is possible, in uncommon circumstances, for a valid vehicle entity to be in an invalid state, such as before Entity:Spawn is called on the vehicle after creation.
    --- If this function returns `false`, then the Vehicle functions are not usable on this vehicle, while Entity functions are.
    -- @return --- `true` if the Vehicle is in a valid state, or `false` if the Vehicle is in an invalid state.
    IsValidVehicle: function(self): boolean

    --- Returns whether this vehicle's engine is underwater or not. ( Internally the attachment point "engine" or "vehicle_engine" is checked )
    -- @return --- Whether this vehicle's engine is underwater or not.
    IsVehicleBodyInWater: function(self): boolean

    --- Releases the vehicle's handbrake (Jeep) so it can roll without any passengers.
    --- This will be overwritten if the vehicle has a driver. Same as Vehicle:SetHandbrake( false )
    ReleaseHandbrake: function(self)

    --- Sets the boost. It is possible that this function does not work while the vehicle has a valid driver in it.
    -- @param boost --- The new boost value
    SetBoost: function(self, boost: number)

    --- Sets the third person camera distance of the vehicle.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L677-L681)
    -- @param distance --- Camera distance to set to
    SetCameraDistance: function(self, distance: number)

    --- Turns on or off the Jeep handbrake so it can roll without a driver inside.
    --- Does nothing while the vehicle has a driver in it.
    -- @param handbrake --- true to turn on, false to turn off.
    SetHandbrake: function(self, handbrake: boolean)

    --- Sets whether this vehicle has a brake pedal.
    -- @param brakePedal --- Whether this vehicle has a brake pedal
    SetHasBrakePedal: function(self, brakePedal: boolean)

    --- Sets maximum reverse throttle
    -- @param maxRevThrottle --- The new maximum throttle. This number must be negative.
    SetMaxReverseThrottle: function(self, maxRevThrottle: number)

    --- Sets maximum forward throttle
    -- @param maxThrottle --- The new maximum throttle.
    SetMaxThrottle: function(self, maxThrottle: number)

    --- Sets spring length of given wheel
    -- @param wheel --- The wheel to change spring length of
    -- @param length --- The new spring length
    SetSpringLength: function(self, wheel: number, length: number)

    --- Sets the steering of the vehicle.
    --- **VALIDATE**: The correct range, 0 to 1 or -1 to 1
    -- @param front --- Angle of the front wheels (-1 to 1)
    -- @param rear --- Angle of the rear wheels (-1 to 1)
    SetSteering: function(self, front: number, rear: number)

    --- Sets the maximum steering degrees of the vehicle
    -- @param steeringDegrees --- The new maximum steering degree
    SetSteeringDegrees: function(self, steeringDegrees: number)

    --- Sets the third person mode state.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L665-L669)
    -- @param enable --- Enable or disable the third person mode for this vehicle
    SetThirdPersonMode: function(self, enable: boolean)

    --- Sets the throttle of the vehicle. It is possible that this function does not work with a valid driver in it.
    -- @param throttle --- The new throttle.
    SetThrottle: function(self, throttle: number)

    --- **INTERNAL**:
    --- Sets the vehicle class name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L678-L682)
    -- @param class --- The vehicle class name to set
    SetVehicleClass: function(self, class: string)

    --- Sets whether the entry or exit camera animation should be played or not.
    -- @param bOn --- Whether the entry or exit camera animation should be played or not.
    SetVehicleEntryAnim: function(self, bOn: boolean)

    --- Sets the vehicle parameters for given vehicle.
    --- **NOTE**: Not all variables from the Structures/VehicleParams can be set.
    -- @param params --- The new new vehicle parameters. See Structures/VehicleParams.
    SetVehicleParams: function(self, params: table)

    --- Sets friction of given wheel.  This function may be broken.
    -- @param wheel --- The wheel to change the friction of
    -- @param friction --- The new friction to set
    SetWheelFriction: function(self, wheel: number, friction: number)

    --- Starts or stops the engine.
    -- @param start --- True to start, false to stop.
    StartEngine: function(self, start: boolean)
end


--- List of all possible functions to manipulate vectors.
--- Created by Global.Vector.
--- Type   | Name           | Description
--- ------ | -------------- | ------------------------------
--- number | `x`, `X`, `r` or `1` | The X component of the vector.
--- number | `y`, `Y`, `g` or `2` | The Y component of the vector.
--- number | `z`, `Z`, `b` or `3` | The Z component of the vector.
--- Metamethod | Second Operand | Description
--- ---------- | -------------- | -----------
--- `__add` | Vector | Returns new Vector with the result of addition.
--- `__div` | number or Vector | Returns new Vector with the result of division.
--- `__eq` | any | Compares 2 operands, if they both are Vector, compares each individual component.
--- `__index` | number or string | Gets the component of the Vector. Returns a number.
--- `__mul` | number or Vector| Returns new Vector with the result of multiplication.
--- `__newindex` | number or string | Sets the component of the Vector. Accepts number and string.
--- `__sub` | Vector | Returns new Vector with the result of subtraction.
--- `__tostring` | | Returns `x y z`.
--- `__unm` | | Returns new Vector with the result of negation.
global interface GVector
    where TypeID(self) == TYPE_VECTOR
    --- Adds the values of the argument vector to the original vector. This function is the same as vector1 + vector2 without creating a new vector object, skipping object construction and garbage collection.
    -- @param vector --- The vector to add.
    Add: function(self, vector: GVector)

    --- Returns an angle representing the normal of the vector.
    -- @return --- The angle/direction of the vector.
    Angle: function(self): GAngle

    --- Returns the angle of this vector (normalized), but instead of assuming that up is Global.Vector( 0, 0, 1 ) (Like Vector:Angle does) you can specify which direction is 'up' for the angle.
    -- @param up --- The up direction vector
    -- @return --- The angle
    AngleEx: function(self, up: GVector): GAngle

    --- Calculates the cross product of this vector and the passed one.
    --- The cross product of two vectors is a 3-dimensional vector with a direction perpendicular (at right angles) to both of them (according to the [right-hand rule](https://en.wikipedia.org/wiki/Right-hand_rule)), and magnitude equal to the area of parallelogram they span. This is defined as the product of the magnitudes, the sine of the angle between them, and unit (normal) vector `n` defined by the right-hand rule:
    --- :**a** × **b** = |**a**| |**b**| sin(θ) **n̂**
    --- where **a** and **b** are vectors, and **n̂** is a unit vector (magnitude of 1) perpendicular to both.
    -- @param otherVector --- Vector to calculate the cross product with.
    -- @return --- The cross product of the two vectors.
    Cross: function(self, otherVector: GVector): GVector

    --- Returns the squared distance of 2 vectors, this is quicker to call than Vector:Distance as DistToSqr does not need to calculate the square root, which is an expensive process.
    --- **NOTE**: Squared distances should not be summed. If you need to sum distances, use Vector:Distance.
    --- When performing a distance check, ensure the distance being checked against is squared. See example code below.
    -- @param otherVec --- The vector to calculate the distance to.
    -- @return --- Squared distance to the vector.
    DistToSqr: function(self, otherVec: GVector): number

    --- Returns the Euclidean distance between the vector and the other vector.
    --- **NOTE**: This function is more expensive than Vector:DistToSqr. However, please see the notes for Vector:DistToSqr before using it as squared distances are not the same as euclidean distances.
    -- @param otherVector --- The vector to get the distance to.
    -- @return --- Distance between the vectors.
    Distance: function(self, otherVector: GVector): number

    --- Returns the Euclidean distance between the vector and the other vector in 2D space. The Z axis is ignored.
    --- **NOTE**: This function is more expensive than Vector:Distance2DSqr. However, please see the notes for Vector:Distance2DSqr before using it as squared distances are not the same as Euclidean distances.
    -- @param otherVector --- The vector to get the distance to.
    -- @return --- Distance between the vectors in 2D space.
    Distance2D: function(self, otherVector: GVector): number

    --- Returns the squared distance between 2 vectors in 2D space, ignoring the Z axis. This is faster than Vector:Distance2D as calculating the square root is an expensive process.
    --- **NOTE**: Squared distances should not be summed. If you need to sum distances, use Vector:Distance2D.
    --- When performing a distance check, ensure the distance being checked against is squared.
    -- @param otherVec --- The vector to calculate the distance to.
    -- @return --- Squared distance to the vector in 2D space.
    Distance2DSqr: function(self, otherVec: GVector): number

    --- Divide the vector by the given number, that means x, y and z are divided by that value. This will change the value of the original vector, see example 2 for division without changing the value.
    -- @param divisor --- The value to divide the vector with.
    Div: function(self, divisor: number)

    --- Returns the [dot product](https://en.wikipedia.org/wiki/Dot_product#Geometric_definition)  of this vector and the passed one.
    --- The dot product of two vectors is the product of their magnitudes (lengths), and the cosine of the angle between them:
    --- **a · b** = |**a**| |**b**| cos(θ)
    --- where **a** and **b** are vectors.
    --- See Vector:Length for obtaining magnitudes.
    --- A dot product returns just the cosine of the angle if both vectors are normalized, and zero if the vectors are at right angles to each other.
    -- @param otherVector --- The vector to calculate the dot product with
    -- @return --- The dot product between the two vectors
    Dot: function(self, otherVector: GVector): number

    --- @deprecated
    --- **DEPRECATED**: This is an alias of Vector:Dot. Use that instead.
    --- Returns the dot product of the two vectors.
    -- @param Vector --- The other vector.
    -- @return --- Dot Product
    DotProduct: function(self, Vector: GVector): number

    --- Returns the negative version of this vector, i.e. a vector with every component to the negative value of itself.
    --- See also Vector:Negate.
    -- @return --- The negative of this vector.
    GetNegated: function(self): GVector

    --- @deprecated
    --- **DEPRECATED**: Use Vector:GetNormalized instead.
    --- Returns a normalized version of the vector. This is a alias of Vector:GetNormalized.
    -- @return --- Normalized version of the vector.
    GetNormal: function(self): GVector

    --- Returns a normalized version of the vector. Normalized means vector with same direction but with length of 1.
    --- This does not affect the vector you call it on; to do this, use Vector:Normalize.
    -- @return --- Normalized version of the vector.
    GetNormalized: function(self): GVector

    --- Returns if the vector is equal to another vector with the given tolerance.
    -- @param compare --- The vector to compare to.
    -- @param tolerance --- The tolerance range.
    -- @return --- Are the vectors equal or not.
    IsEqualTol: function(self, compare: GVector, tolerance: number): boolean

    --- Checks whenever all fields of the vector are 0.
    -- @return --- Do all fields of the vector equal 0 or not
    IsZero: function(self): boolean

    --- Returns the [Euclidean length](https://en.wikipedia.org/wiki/Euclidean_vector#Length) of the vector: √(x² + y² + z²).
    --- **WARNING**: This is a relatively expensive process since it uses the square root. It is recommended that you use Vector:LengthSqr whenever possible.
    -- @return --- Length of the vector.
    Length: function(self): number

    --- Returns the length of the vector in two dimensions, without the Z axis.
    --- **WARNING**: This is a relatively expensive process since it uses the square root. It is recommended that you use Vector:Length2DSqr whenever possible.
    -- @return --- Length of the vector in two dimensions, √(x² + y²)
    Length2D: function(self): number

    --- Returns the squared length of the vectors x and y value, x² + y².
    --- This is faster than Vector:Length2D as calculating the square root is an expensive process.
    -- @return --- Squared length of the vector in two dimensions
    Length2DSqr: function(self): number

    --- Returns the squared length of the vector, x² + y² + z².
    --- This is faster than Vector:Length as calculating the square root is an expensive process.
    -- @return --- Squared length of the vector
    LengthSqr: function(self): number

    --- Scales the vector by the given number (that means x, y and z are multiplied by that value), a Vector (X, Y, and Z of each vector are multiplied) or a VMatrix (Transforms the vector by the matrix's rotation/translation).
    -- @param multiplier --- The value to scale the vector with.
    Mul: function(self, multiplier: number)

    --- Negates this vector, i.e. sets every component to the negative value of itself. Same as `Vector( -vec.x, -vec.y, -vec.z )`
    Negate: function(self)

    --- Normalizes the given vector. This changes the vector you call it on, if you want to return a normalized copy without affecting the original, use Vector:GetNormalized.
    Normalize: function(self)

    --- Randomizes each element of this Vector object.
    -- @param min --- The minimum value for each component.
    -- @param max --- The maximum value for each component.
    Random: function(self, min: number, max: number)

    --- Rotates a vector by the given angle.
    --- Doesn't return anything, but rather changes the original vector.
    -- @param rotation --- The angle to rotate the vector by.
    Rotate: function(self, rotation: GAngle)

    --- Copies the values from the second vector to the first vector.
    -- @param vector --- The vector to copy from.
    Set: function(self, vector: GVector)

    --- Sets the x, y, and z of the vector.
    -- @param x --- The x component
    -- @param y --- The y component
    -- @param z --- The z component
    SetUnpacked: function(self, x: number, y: number, z: number)

    --- Substracts the values of the second vector from the orignal vector, this function can be used to avoid garbage collection.
    -- @param vector --- The other vector.
    Sub: function(self, vector: GVector)

    --- Translates the Vector (values ranging from 0 to 1) into a Color. This will also range the values from 0 - 1 to 0 - 255.
    --- x * 255 -> r
    --- y * 255 -> g
    --- z * 255 -> b
    --- This is the opposite of Color:ToVector
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/vector.lua#L8-L12)
    -- @return --- The created Color.
    ToColor: function(self): GColor

    --- Returns where on the screen the specified position vector would appear. A related function is gui.ScreenToVector, which converts a 2D coordinate to a 3D direction.
    --- **NOTE**: Should be called from a 3D rendering environment or after cam.Start3D or it may not work correctly.
    --- **BUG**: [Errors in a render hook can make this value incorrect until the player restarts their game.](https://github.com/Facepunch/garrysmod-issues/issues/462
    --- **BUG**: [cam.Start3D or 3D context cam.Start with non-default parameters incorrectly sets the reference FOV for this function, causing incorrect return values. This can be fixed by creating and ending a default 3D context (cam.Start3D with no arguments).](https://github.com/Facepunch/garrysmod-issues/issues/1404
    -- @return --- The created Structures/ToScreenData.
    ToScreen: function(self): S_ToScreenData

    --- Returns the vector as a table with three elements.
    -- @return --- The table with elements 1 = x, 2 = y, 3 = z.
    ToTable: function(self): table

    --- Returns the x, y, and z of the vector.
    -- @return --- x or Vector[1].
    -- @return --- y or Vector[2].
    -- @return --- z or Vector[3].
    Unpack: function(self): number, number, number

    --- Returns whenever the given vector is in a box created by the 2 other vectors.
    --- <upload src="22674/8d9276d7e6dd0af.png" size="6279" name="image.png">
    --- </upload>
    -- @param boxStart --- The first vector.
    -- @param boxEnd --- The second vector.
    -- @return --- Is the vector in the box or not.
    WithinAABox: function(self, boxStart: GVector, boxEnd: GVector): boolean

    --- Sets x, y and z to 0.
    Zero: function(self)

    metamethod __index: function(GVector, value: number): number
    metamethod __add: function(GVector, value: GVector): GVector
    metamethod __sub: function(GVector, value: GVector): GVector
    metamethod __mul: function(GVector, value: GVector): GVector
    metamethod __div: function(GVector, value: GVector): GVector

    x: number
    y: number
    z: number
end


--- A list of functions available inside a Sandbox Toolgun tool.
--- You can find the hooks here, and members here.
global interface GTool
    --- Returns whether the tool is allowed to be used or not. This function ignores the SANDBOX:CanTool hook.
    --- By default this will always return true clientside and uses `TOOL.AllowedCVar`which is a ConVar object pointing to  `toolmode_allow_*toolname*` convar on the server.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L90)
    -- @return --- Returns true if the tool is allowed.
    Allowed: function(self): boolean

    --- Builds a list of all ConVars set via the ClientConVar variable on the Structures/TOOL and their default values. This is used for the preset system.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L67)
    -- @return convars --- A list of all convars and their default values.
    BuildConVarList: function(self): table

    --- **INTERNAL**: This is called automatically for most toolgun actions so you shouldn't need to use it.
    --- Checks all added objects to see if they're still valid, if not, clears the list of objects.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L117)
    CheckObjects: function(self)

    --- Clears all objects previously set with Tool:SetObject.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L34)
    ClearObjects: function(self)

    --- **INTERNAL**: This is called automatically for all tools.
    --- Initializes the tool object
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L11)
    -- @return tool --- The created tool object.
    Create: function(self): GTool

    --- **INTERNAL**: This is called automatically for all tools.
    --- Creates clientside ConVars based on the ClientConVar table specified in the tool structure. Also creates the 'toolmode_allow_X' ConVar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L33)
    CreateConVars: function(self)

    --- Retrieves a physics bone number previously stored using Tool:SetObject.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L81)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated physics bone with given id.
    GetBone: function(self, id: number): number

    --- Attempts to grab a clientside tool ConVar value as a boolean.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L87)
    -- @param name --- Name of the ConVar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    -- @param default --- The default value to return in case the lookup fails.
    -- @return --- The value of the requested ConVar. It will be true if the value if the convar is not 0, just like ConVar:GetBool
    GetClientBool: function(self, name: string, default: boolean): number

    --- Attempts to grab a clientside tool ConVar as a string.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L67)
    -- @param name --- Name of the convar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    -- @return --- The value of the requested ConVar.
    GetClientInfo: function(self, name: string): string

    --- Attempts to grab a clientside tool ConVar's value as a number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L77)
    -- @param name --- Name of the convar to retrieve. The function will automatically add the `mytoolfilename_` part to it.
    -- @param default --- The default value to return in case the lookup fails.
    -- @return --- The value of the requested ConVar.
    GetClientNumber: function(self, name: string, default: number): number

    --- Retrieves an Entity previously stored using Tool:SetObject.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L48)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated Entity with given id.
    GetEnt: function(self, id: number): GEntity

    --- Returns a language key based on this tool's name and the current stage it is on.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L163)
    -- @return key --- The returned language key, for example `"#tool.weld.1"`
    GetHelpText: function(self): string

    --- Retrieves an local vector previously stored using Tool:SetObject.
    --- See also Tool:GetPos.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L76)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated local vector with given id.
    GetLocalPos: function(self, id: number): GVector

    --- Returns the name of the current tool mode.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L101)
    -- @return --- The current tool mode.
    GetMode: function(self): string

    --- Retrieves an normal vector previously stored using Tool:SetObject.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L85)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated normal vector with given id.
    GetNormal: function(self, id: number): GVector

    --- Returns the current operation of the tool set by Tool:SetOperation.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L28)
    -- @return --- The current operation the tool is at.
    GetOperation: function(self): number

    --- Returns the owner of this tool.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L120)
    -- @return --- Player using the tool
    GetOwner: function(self): GPlayer

    --- Retrieves an PhysObj previously stored using Tool:SetObject.
    --- See also Tool:GetEnt.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L100-L108)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated PhysObj with given id. If it wasn't specified, returns current PhysObj of associated Entity.
    GetPhys: function(self, id: number): GPhysObj

    --- Retrieves an vector previously stored using Tool:SetObject. See also Tool:GetLocalPos.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemode/sandbox/entities/weapons/gmod_tool/object.lua#L61)
    -- @param id --- The id of the object which was set in Tool:SetObject.
    -- @return --- Associated vector with given id. The vector is converted from Tool:GetLocalPos.
    GetPos: function(self, id: number): GVector

    --- @deprecated
    --- **DEPRECATED**: Use Tool:GetWeapon instead.
    --- Returns the Tool Gun (`gmod_tool`) Scripted Weapon.
    -- @return --- The tool gun weapon. (`gmod_tool`)
    GetSWEP: function(self): GWeapon

    --- Attempts to grab a serverside tool ConVar.
    --- This will not do anything on client, despite the function being defined shared.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool.lua#L59)
    -- @param name --- Name of the convar to retrieve. The function will automatically add the "mytoolfilename_" part to it.
    -- @return --- The value of the requested ConVar.
    GetServerInfo: function(self, name: string): string

    --- Returns the current stage of the tool set by Tool:SetStage.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L16)
    -- @return --- The current stage of the current operation the tool is at.
    GetStage: function(self): number

    --- Returns the Tool Gun (`gmod_tool`) Scripted Weapon.
    -- @return --- The tool gun weapon. (`gmod_tool`)
    GetWeapon: function(self): GWeapon

    --- Initializes the ghost entity with the given model. Removes any old ghost entity if called multiple times.
    --- The ghost is a regular prop_physics entity in singleplayer games, and a clientside prop in multiplayer games.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/ghostentity.lua#L6)
    -- @param model --- The model of the new ghost entity
    -- @param pos --- Position to initialize the ghost entity at, usually not needed since this is updated in Tool:UpdateGhostEntity.
    -- @param angle --- Angle to initialize the ghost entity at, usually not needed since this is updated in Tool:UpdateGhostEntity.
    MakeGhostEntity: function(self, model: string, pos: GVector, angle: GAngle)

    --- Returns the amount of stored objects ( Entitys ) the tool has.
    --- **VALIDATE**: Are TOOLs limited to 4 entities?
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L149)
    -- @return --- The amount of stored objects, or Tool:GetStage clientide.
    NumObjects: function(self): number

    --- Automatically forces the tool's control panel to be rebuilt.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stool_cl.lua#L12)
    -- @param extra_args --- Any arguments given to this function will be added to TOOL.BuildCPanel's arguments.
    RebuildControlPanel: function(self, ...: any)

    --- Removes any ghost entity created for this tool.
    --- This is called automatically at various points, including when changing tools, holstering the toolgun, therefore it is a very good idea to implement this callback in your custom tool to cleanup any custom ghost entities.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/ghostentity.lua#L68)
    ReleaseGhostEntity: function(self)

    --- Stores an Entity for later use in the tool.
    --- The stored values can be retrieved by Tool:GetEnt, Tool:GetPos, Tool:GetLocalPos, Tool:GetPhys, Tool:GetBone and Tool:GetNormal
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L112)
    -- @param id --- The id of the object to store.
    -- @param ent --- The entity to store.
    -- @param pos --- The position to store.
    --- **NOTE**: this position is in **global space** and is internally converted to **local space** relative to the object, so when you retrieve it later it will be corrected to the object's new position
    -- @param phys --- The physics object to store.
    -- @param bone --- The hit bone to store.
    -- @param normal --- The hit normal to store.
    SetObject: function(self, id: number, ent: GEntity, pos: GVector, phys: GPhysObj, bone: number, normal: GVector)

    --- Sets the current operation of the tool. Does nothing clientside. See also Tool:SetStage.
    --- Operations and stages work as follows:
    --- * Operation 1
    --- * * Stage 1
    --- * * Stage 2
    --- * * Stage 3
    --- * Operation 2
    --- * * Stage 1
    --- * * Stage 2
    --- * * Stage ...
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L20)
    -- @param operation --- The new operation ID to set.
    SetOperation: function(self, operation: number)

    --- Sets the current stage of the tool. Does nothing clientside.
    --- See also Tool:SetOperation.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod//gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L8-L14)
    -- @param stage --- The new stage to set.
    SetStage: function(self, stage: number)

    --- Initializes the ghost entity based on the supplied entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/ghostentity.lua#L54)
    -- @param ent --- The entity to copy ghost parameters off
    StartGhostEntity: function(self, ent: GEntity)

    --- **INTERNAL**: Called on deploy automatically
    --- Sets the tool's stage to how many stored objects the tool has.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/object.lua#L2)
    UpdateData: function(self)

    --- Updates the position and orientation of the ghost entity based on where the toolgun owner is looking along with data from object with id 1 set by Tool:SetObject.
    --- This should be called in the tool's TOOL:Think hook.
    --- This command is only used for tools that move props, such as easy weld, axis and motor. If you want to update a ghost like the thruster tool does it for example, check its [source code](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stools/thruster.lua#L179).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/ghostentity.lua#L101)
    UpdateGhostEntity: function(self)
end


--- A single AI task. Returned by ai_task.New.
global interface GTask
    --- **INTERNAL**:
    ---  Initialises the AI task. Called by ai_task.New.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L29-L31)
    Init: function(self)

    --- Initialises the AI task as an engine task.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L36-L43)
    -- @param taskname --- The name of the task.
    -- @param taskdata ---
    InitEngine: function(self, taskname: string, taskdata: number)

    --- Initialises the AI task as NPC method-based.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L56)
    -- @param startname --- The name of the NPC method to call on task start.
    -- @param runname --- The name of the NPC method to call on task run.
    -- @param taskdata ---
    InitFunctionName: function(self, startname: string, runname: string, taskdata: number)

    --- Determines if the task is an engine task (`TYPE_ENGINE`, 1).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L67)
    IsEngineType: function(self)

    --- Determines if the task is an NPC method-based task (`TYPE_FNAME`, 2).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L75)
    IsFNameType: function(self)

    --- Runs the AI task.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L112)
    -- @param target --- The NPC to run the task on.
    Run: function(self, target: GNPC)

    --- **INTERNAL**:
    ---  Runs the AI task as an NPC method. This requires the task to be of type `TYPE_FNAME`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L125)
    -- @param target --- The NPC to run the task on.
    Run_FName: function(self, target: GNPC)

    --- Starts the AI task.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L83)
    -- @param target --- The NPC to start the task on.
    Start: function(self, target: GNPC)

    --- **INTERNAL**:
    ---  Starts the AI task as an NPC method.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_task.lua#L99)
    -- @param target --- The NPC to start the task on.
    Start_FName: function(self, target: GNPC)
end


--- A brush surface object returned by Entity:GetBrushSurfaces.
--- Brush surfaces are a part of what makes up the map geometry aside from displacements. Any primitive brush model, including most breakable windows, can be represented by this object.
--- **NOTE**: This object internally uses the `SurfaceHandle_t` class, which is an alias for `msurface2_t*`.
global interface GSurfaceInfo
    --- Returns the brush surface's material.
    -- @return --- Material of one portion of a brush model.
    GetMaterial: function(self): GIMaterial

    --- Returns a list of vertices the brush surface is built from.
    -- @return --- A list of Vector points. This will usually be 4 corners of a quadrilateral in counter-clockwise order.
    GetVertices: function(self): {GVector}

    --- Checks if the brush surface is a nodraw surface, meaning it will not be drawn by the engine.
    --- **NOTE**: This internally checks the SURFDRAW_NODRAW flag.
    -- @return --- Returns true if this surface won't be drawn.
    IsNoDraw: function(self): boolean

    --- Checks if the brush surface is displaying the skybox.
    --- **NOTE**: This internally checks the SURFDRAW_SKY flag.
    -- @return --- Returns true if the surface is the sky.
    IsSky: function(self): boolean

    --- Checks if the brush surface is water.
    --- **NOTE**: This internally checks the SURFDRAW_WATER flag.
    -- @return --- Returns true if the surface is water.
    IsWater: function(self): boolean
end


--- An object returned by util.Stack.
--- Like a Lua table, a Stack is a container. It follows the principle of LIFO (last in, first out).
--- The Stack works like a stack of papers: the first page you put down (push) will be the last one you remove (pop). That also means that the last page you put down, will be the first to be removed.
global interface GStack
    --- Pop an item from the stack
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L257-L277)
    -- @param amount --- Amount of items you want to pop.
    -- @return object --- Latest popped item.
    Pop: function(self, amount: number): any

    --- Pop an item from the stack
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L279-L305)
    -- @param amount --- Amount of items you want to pop.
    -- @return items --- The Popped Items.
    PopMulti: function(self, amount: number): table

    --- Push an item onto the stack
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L251-L255)
    -- @param object --- The item you want to push
    Push: function(self, object: any)

    --- Returns the size of the stack
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L317-L319)
    -- @return --- The size of the stack
    Size: function(self): number

    --- Get the item at the top of the stack
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L307-L315)
    -- @return --- The item at the top of the stack
    Top: function(self): any
end


--- The object returned by ai_schedule.New.
global interface GSchedule
    --- Adds a task to the schedule. See also Schedule:AddTaskEx if you wish to customize task start and run function names.
    --- See also ENTITY:StartSchedule, NPC:StartEngineTask, and NPC:RunEngineTask.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L56-L62)
    -- @param taskname --- Custom task name
    -- @param taskdata --- Task data to be passed into the NPC's functions
    AddTask: function(self, taskname: string, taskdata: any)

    --- Adds a task to the schedule with completely custom function names.
    --- See also Schedule:AddTask.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L70-L76)
    -- @param start --- The full name of a function on the entity's table to be ran when the task is started.
    -- @param run --- The full name of a function on the entity's table to be ran when the task is continuously running.
    -- @param data --- Task data to be passed into the NPC's functions
    AddTaskEx: function(self, start: string, run: string, data: number)

    --- Adds an engine task to the schedule.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L36-L42)
    -- @param taskname --- Task name, see [ai_task.h](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/ai_task.h#L89-L502)
    -- @param taskdata --- Task data, can be a float.
    EngTask: function(self, taskname: string, taskdata: number)

    --- Returns the task at the given index.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L82-L84)
    -- @param num --- Task index.
    GetTask: function(self, num: number)

    --- **INTERNAL**:
    ---  Initialises the Schedule. Called by ai_schedule.New when the Schedule is created.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L21-L27)
    -- @param debugName --- The name passed from ai_schedule.New.
    Init: function(self, debugName: string)

    --- Returns the number of tasks in the schedule.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/ai_schedule.lua#L78-L80)
    -- @return --- The number of tasks in this schedule.
    NumTasks: function(self): number
end


--- A client side projected texture, created by Global.ProjectedTexture.
global interface GProjectedTexture
    --- Returns the angle of the ProjectedTexture, which were previously set by ProjectedTexture:SetAngles
    -- @return --- The angles of the ProjectedTexture.
    GetAngles: function(self): GAngle

    --- Returns the brightness of the ProjectedTexture, which was previously set by ProjectedTexture:SetBrightness
    -- @return --- The brightness of the ProjectedTexture.
    GetBrightness: function(self): number

    --- Returns the color of the ProjectedTexture, which was previously set by ProjectedTexture:SetColor.
    --- **BUG**: [The returned color will not have the color metatable.](https://github.com/Facepunch/garrysmod-issues/issues/2407
    -- @return --- Color, the color of the ProjectedTexture.
    GetColor: function(self): table

    --- Returns the constant attenuation of the projected texture, which can also be set by ProjectedTexture:SetConstantAttenuation.
    -- @return --- The constant attenuation
    GetConstantAttenuation: function(self): number

    --- Returns whether shadows are enabled for this ProjectedTexture, which was previously set by ProjectedTexture:SetEnableShadows
    -- @return --- Whether shadows are enabled.
    GetEnableShadows: function(self): boolean

    --- Returns the projection distance of the ProjectedTexture, which was previously set by ProjectedTexture:SetFarZ
    -- @return --- The projection distance of the ProjectedTexture.
    GetFarZ: function(self): number

    --- Returns the horizontal FOV of the ProjectedTexture, which was previously set by ProjectedTexture:SetHorizontalFOV or ProjectedTexture:SetFOV
    -- @return --- The horizontal FOV of the ProjectedTexture.
    GetHorizontalFOV: function(self): number

    --- Returns whenever or not the Texture should light up world geometry.
    -- @return lightworld --- `true` if the Texture should light up world geometry.
    GetLightWorld: function(self): boolean

    --- Returns the linear attenuation of the projected texture, which can also be set by ProjectedTexture:SetLinearAttenuation.
    -- @return --- The linear attenuation.
    GetLinearAttenuation: function(self): number

    --- Returns the NearZ value of the ProjectedTexture, which was previously set by ProjectedTexture:SetNearZ
    -- @return --- NearZ of the ProjectedTexture.
    GetNearZ: function(self): number

    --- Returns the state of projected texture view-frustum culling. See ProjectedTexture:SetNoCull.
    -- @return enable --- `false` if culling is enabled (default), `true` if disabled.
    GetNoCull: function(self): boolean

    --- Returns the current orthographic settings of the Projected Texture. To set these values, use ProjectedTexture:SetOrthographic.
    -- @return --- Whether or not this projected texture is orthographic. When false, nothing else is returned.
    -- @return --- left
    -- @return --- top
    -- @return --- right
    -- @return --- bottom
    GetOrthographic: function(self): boolean, number, number, number, number

    --- Returns the position of the ProjectedTexture, which was previously set by ProjectedTexture:SetPos
    -- @return --- The position of the ProjectedTexture.
    GetPos: function(self): GVector

    --- Returns the quadratic attenuation of the projected texture, which can also be set by ProjectedTexture:SetQuadraticAttenuation.
    -- @return --- The quadratic attenuation
    GetQuadraticAttenuation: function(self): number

    --- Returns the shadow depth bias of the projected texture.
    --- Set by ProjectedTexture:SetShadowDepthBias.
    -- @return bias --- The current shadow depth bias.
    GetShadowDepthBias: function(self): number

    --- Returns the shadow "filter size" of the projected texture. `0` is fully pixelated, higher values will blur the shadow more.
    --- Set by ProjectedTexture:SetShadowFilter.
    -- @return --- The current shadow filter size.
    GetShadowFilter: function(self): number

    --- Returns the shadow depth slope scale bias of the projected texture.
    --- Set by ProjectedTexture:SetShadowSlopeScaleDepthBias.
    -- @return --- The current shadow depth slope scale bias.
    GetShadowSlopeScaleDepthBias: function(self): number

    --- Returns the target entity of this projected texture.
    -- @return --- The current target entity.
    GetTargetEntity: function(self): GEntity

    --- Returns the texture of the ProjectedTexture, which was previously set by ProjectedTexture:SetTexture
    -- @return --- The texture of the ProjectedTexture.
    GetTexture: function(self): GITexture

    --- Returns the texture frame of the ProjectedTexture, which was previously set by ProjectedTexture:SetTextureFrame
    -- @return --- The texture frame.
    GetTextureFrame: function(self): number

    --- Returns the vertical FOV of the ProjectedTexture, which was previously set by ProjectedTexture:SetVerticalFOV or ProjectedTexture:SetFOV
    -- @return --- The vertical FOV of the ProjectedTexture.
    GetVerticalFOV: function(self): number

    --- Returns true if the projected texture is valid (i.e. has not been removed), false otherwise.
    --- Instead of calling this directly it's a good idea to call Global.IsValid in case the variable is nil.
    --- ```
    --- IsValid( ptexture )
    --- ```
    --- This not only checks whether the projected texture is valid - but also checks whether it's nil.
    -- @return --- Whether the projected texture is valid.
    IsValid: function(self): boolean

    --- Removes the projected texture. After calling this, ProjectedTexture:IsValid will return false, and any hooks with the projected texture as the identifier will be automatically deleted.
    Remove: function(self)

    --- Sets the angles (direction) of the projected texture.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param angle ---
    SetAngles: function(self, angle: GAngle)

    --- Sets the brightness of the projected texture.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param brightness --- The brightness to give the projected texture. A float from 0 to 1, where 1 is 100% brightness. Can be higher.
    SetBrightness: function(self, brightness: number)

    --- Sets the color of the projected texture.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param color --- Must be a Color.
    --- Unlike other projected textures, this color can only go up to 255.
    SetColor: function(self, color: table)

    --- Sets the constant attenuation of the projected texture.
    --- See also ProjectedTexture:SetLinearAttenuation and ProjectedTexture:SetQuadraticAttenuation.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param constAtten ---
    SetConstantAttenuation: function(self, constAtten: number)

    --- Enable or disable shadows cast from the projected texture.
    --- **NOTE**: As with all types of projected textures (including the player's flashlight and env_projectedtexture), there can only be 8 projected textures with shadows enabled in total.
    --- This limit can be increased with the launch parameter `-numshadowtextures LIMIT` where `LIMIT` is the new limit.
    --- Naturally, many projected lights with shadows enabled will drastically decrease framerate.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param newState ---
    SetEnableShadows: function(self, newState: boolean)

    --- Sets the angle of projection.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param fov --- Must be higher than 0 and lower than 180
    SetFOV: function(self, fov: number)

    --- Sets the distance at which the projected texture ends.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param farZ ---
    SetFarZ: function(self, farZ: number)

    --- Sets the horizontal angle of projection without affecting the vertical angle.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param hFOV --- The new horizontal Field Of View for the projected texture. Must be in range between 0 and 180.
    SetHorizontalFOV: function(self, hFOV: number)

    --- Set whenever or not the Texture should light up world geometry.
    -- @param lightworld --- Set it to `true` if the Texture should light up world geometry.
    SetLightWorld: function(self, lightworld: boolean)

    --- Sets the linear attenuation of the projected texture.
    --- See also ProjectedTexture:SetConstantAttenuation and ProjectedTexture:SetQuadraticAttenuation.
    --- The default value of linear attenuation when the projected texture is created is 100. (others are 0, as you are not supposed to mix them)
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param linearAtten ---
    SetLinearAttenuation: function(self, linearAtten: number)

    --- Sets the distance at which the projected texture begins its projection.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    --- **NOTE**: Setting this to 0 will disable the projected texture completely! This may be useful if you want to disable a projected texture without actually removing it
    --- **NOTE**: This seems to affect the rendering of shadows - a higher Near Z value will have shadows begin to render closer to their casting object. Comparing a low Near Z value (like 1) with a normal one (12) or high one (1000) is the easiest way to understand this artifact
    -- @param nearZ ---
    SetNearZ: function(self, nearZ: number)

    --- Allows disabling of projected texture view-frustum culling for cases where said culling creates unwanted side effects. Disabling culling will have a negative effect on performance.
    -- @param enable --- `false` to enable culling (default), `true` to disable.
    SetNoCull: function(self, enable: boolean)

    --- Changes the current projected texture between orthographic and perspective projection.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    --- Shadows dont work. (For non static props and for most map brushes)
    -- @param orthographic --- When false, all other arguments are ignored and the texture is reset to perspective projection.
    -- @param left --- The amount of units left from the projected texture's origin to project.
    -- @param top --- The amount of units upwards from the projected texture's origin to project.
    -- @param right --- The amount of units right from the projected texture's origin to project.
    -- @param bottom --- The amount of units downwards from the projected texture's origin to project.
    SetOrthographic: function(self, orthographic: boolean, left: number, top: number, right: number, bottom: number)

    --- Move the Projected Texture to the specified position.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param position ---
    SetPos: function(self, position: GVector)

    --- Sets the quadratic attenuation of the projected texture.
    --- See also ProjectedTexture:SetLinearAttenuation and ProjectedTexture:SetConstantAttenuation.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param quadAtten ---
    SetQuadraticAttenuation: function(self, quadAtten: number)

    --- Sets the shadow depth bias of the projected texture.
    --- The initial value is `0.0001`. Normal projected textures obey the value of the `mat_depthbias_shadowmap` ConVar.
    --- **VALIDATE**: You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param bias --- The shadow depth bias to set.
    SetShadowDepthBias: function(self, bias: number)

    --- Sets the shadow "filter size" of the projected texture. `0` is fully pixelated, higher values will blur the shadow more. The initial value is the value of `r_projectedtexture_filter` ConVar.
    --- **VALIDATE**: You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param filter --- The shadow filter size to set.
    SetShadowFilter: function(self, filter: number)

    --- Sets the shadow depth slope scale bias of the projected texture.
    --- The initial value is `2`. Normal projected textures obey the value of the `mat_slopescaledepthbias_shadowmap` ConVar.
    --- **VALIDATE**: You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param bias --- The shadow depth slope scale bias to set.
    SetShadowSlopeScaleDepthBias: function(self, bias: number)

    --- Sets the target entity for this projected texture, meaning it will only be lighting the given entity and the world.
    --- **VALIDATE**: You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param target --- The target entity, or `NULL` to reset.
    SetTargetEntity: function(self, target: GEntity)

    --- Sets the texture to be projected.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param texture --- The name of the texture. Can also be an ITexture.
    SetTexture: function(self, texture: string)

    --- For animated textures, this will choose which frame in the animation will be projected.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param frame --- The frame index to use.
    SetTextureFrame: function(self, frame: number)

    --- Sets the vertical angle of projection without affecting the horizontal angle.
    --- You must call ProjectedTexture:Update after using this function for it to take effect.
    -- @param vFOV --- The new vertical Field Of View for the projected texture. Must be in range between 0 and 180.
    SetVerticalFOV: function(self, vFOV: number)

    --- Updates the Projected Light and applies all previously set parameters.
    --- The best place to call this function is in GM:PreDrawOpaqueRenderables.
    Update: function(self)
end


--- This is a list of all methods only available for players. It is also possible to call Entity functions on the Player.
global interface GPlayer is GEntity
    where self:IsPlayer()
    --- Returns the player's AccountID part of their full SteamID.
    --- Since this does not include other vital parts of the SteamID such as "Account Type" and "Account Instance", it should be avoided, as AccountIDs are finite, and can theoretically be the same for multiple valid accounts.
    --- See Player:SteamID for the text representation of the full SteamID.
    --- See Player:SteamID64 for a 64bit representation of the full SteamID.
    --- **NOTE**: In a `-multirun` environment, this will return `-1` for all "copies" of a player because they are not authenticated with Steam.
    --- For bots this will return values starting with `0` for the first bot, `1` for the second bot and so on.
    -- @return --- The AccountID of Player's SteamID.
    AccountID: function(self): number

    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Adds an entity to the player's clean up list. This uses cleanup.Add internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L107-L111)
    -- @param type --- The Cleanup type for this Entity.
    -- @param ent --- The Entity to add.
    AddCleanup: function(self, type: string, ent: GEntity)

    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Adds an entity to the player's list of entities of the same type. See Player:GetCount to get the current count of entities of an entity type added with this function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L72-L91)
    -- @param str --- The type of this Entity.
    -- @param ent --- The Entity you want to add to the list.
    AddCount: function(self, str: string, ent: GEntity)

    --- Adds the provided amount to the player's death count.
    -- @param count --- The amount to add to the death count.
    AddDeaths: function(self, count: number)

    --- Adds the provided amount to the player's frag/kill count.
    -- @param count --- The amount to add.
    AddFrags: function(self, count: number)

    --- Adds an entity to the player's list of frozen objects.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L9-L30)
    -- @param ent --- The Entity to add.
    -- @param physobj --- The physics object of the Entity.
    AddFrozenPhysicsObject: function(self, ent: GEntity, physobj: GPhysObj)

    --- Sets up the voting system for the player.
    --- This is a really barebone system. By calling this a vote gets started, when the player presses 0-9 the callback function gets called along with the key the player pressed. Use the draw callback to draw the vote panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/player.lua#L21-L39)
    -- @param name --- Name of the vote
    -- @param timeout --- Time until the vote expires
    -- @param vote_callback --- The function to be run when the player presses 0-9 while a vote is active.
    --- <callback>
    --- <arg name="voteNum" type="number">Which option the player pressed, 1-9 and 0 being the very last option.</arg>
    --- <ret name="" type="boolean">Return true to remove this option from the vote.</ret>
    --- </callback>
    -- @param draw_callback --- Used to draw the vote panel.
    AddPlayerOption: function(self, name: string, timeout: number, vote_callback: function, draw_callback: function)

    --- Plays a sequence directly from a sequence number, similar to Player:AnimRestartGesture. This function has the advantage to play sequences that haven't been bound to an existing Enums/ACT
    --- **WARNING**: This is not automatically networked. This function has to be called on the client to be seen by said client.
    -- @param slot --- Gesture slot using Enums/GESTURE_SLOT
    -- @param sequenceId --- The sequence ID to play, can be retrieved with Entity:LookupSequence.
    -- @param cycle --- The cycle to start the animation at, ranges from 0 to 1.
    -- @param autokill --- If the animation should not loop. true = stops the animation, false = the animation keeps playing.
    AddVCDSequenceToGestureSlot: function(self, slot: number, sequenceId: number, cycle: number, autokill: boolean)

    --- Checks if the player is alive.
    --- Player specific implementation of Entity:Alive, the value is synchronized to the client.
    -- @return --- Whether the player is alive
    Alive: function(self): boolean

    --- Sets if the player can toggle their flashlight. Function exists on both the server and client but has no effect when ran on the client.
    --- This is a Lua method that internally uses GM:PlayerSwitchFlashlight. If current gamemode overwrites that hook and doesn't respect Player:CanUseFlashlight, this function will not have any effect.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L182)
    -- @param canFlashlight --- True allows flashlight toggling
    AllowFlashlight: function(self, canFlashlight: boolean)

    --- Lets the player spray their decal without delay
    -- @param allow --- Allow or disallow
    AllowImmediateDecalPainting: function(self, allow: boolean)

    --- Resets player gesture in selected slot.
    -- @param slot --- Slot to reset. See the Enums/GESTURE_SLOT.
    AnimResetGestureSlot: function(self, slot: number)

    --- Restart a gesture on a player, within a gesture slot.
    --- **WARNING**: This is not automatically networked. This function has to be called on the client to be seen by said client.
    -- @param slot --- Gesture slot using Enums/GESTURE_SLOT
    -- @param activity --- The activity ( see Enums/ACT ) or sequence that should be played
    -- @param autokill --- Whether the animation should be automatically stopped. true = stops the animation, false = the animation keeps playing/looping
    AnimRestartGesture: function(self, slot: number, activity: number, autokill: boolean)

    --- Restarts the main animation on the player, has the same effect as calling Entity:SetCycle( 0 ).
    AnimRestartMainSequence: function(self)

    --- Sets the sequence of the animation playing in the given gesture slot.
    -- @param slot --- The gesture slot. See Enums/GESTURE_SLOT
    -- @param sequenceID --- Sequence ID to set.
    AnimSetGestureSequence: function(self, slot: number, sequenceID: number)

    --- Sets the weight of the animation playing in the given gesture slot.
    -- @param slot --- The gesture slot. See Enums/GESTURE_SLOT
    -- @param weight --- The weight this slot should be set to. Value must be ranging from 0 to 1.
    AnimSetGestureWeight: function(self, slot: number, weight: number)

    --- Returns the player's armor.
    -- @return --- The player's armor.
    Armor: function(self): number

    --- Bans the player from the server for a certain amount of minutes.
    -- @param minutes --- Duration of the ban in minutes (0 is permanent)
    -- @param kick --- Whether to kick the player after banning them or not
    Ban: function(self, minutes: number, kick: boolean)

    --- Returns true if the player's flashlight hasn't been disabled by Player:AllowFlashlight.
    --- **NOTE**: This is not synchronized between clients and server automatically!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L183)
    -- @return --- Whether the player can use flashlight.
    CanUseFlashlight: function(self): boolean

    --- Prints a string to the chatbox of the client.
    --- **WARNING**: Just like the usermessage, this function is affected by the 255 byte limit!
    -- @param message --- String to be printed
    ChatPrint: function(self, message: string)

    --- Checks if the limit of an entity type added by Player:AddCount is hit or not. If it's hit, it will call the GM:PlayerCheckLimit hook, and call Player:LimitHit if the hook doesn't return `false`.
    --- This will always return `true` in singleplayer, as singleplayer does not have limits.
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L9-L32)
    -- @param str --- The entity type to check the limit for. Default types:
    --- * "constraints"
    --- * "props"
    --- * "ragdolls"
    --- * "vehicles"
    --- * "effects"
    --- * "balloons"
    --- * "cameras"
    --- * "npcs"
    --- * "sents"
    --- * "dynamite"
    --- * "lamps"
    --- * "lights"
    --- * "wheels"
    --- * "thrusters"
    --- * "hoverballs"
    --- * "buttons"
    --- * "emitters"
    -- @return --- Returns `true` if the limit of this type is not hit, `false` otherwise.
    CheckLimit: function(self, str: string): boolean

    --- Runs the concommand on the player. This does not work on bots. If used clientside, always runs the command on the local player.
    --- If you wish to directly modify the movement input of bots, use GM:StartCommand instead.
    --- **NOTE**: Some commands/convars are blocked from being run/changed using this function, usually to prevent harm/annoyance to clients. For a list of blocked commands, see Blocked ConCommands.
    -- @param command --- command to run
    ConCommand: function(self, command: string)

    --- Creates the player's death ragdoll entity and deletes the old one.
    --- This is normally used when a player dies, to create their death ragdoll.
    --- The ragdoll will be created with the player's properties such as Position, Angles, PlayerColor, Velocity and Model.
    --- You can retrieve the entity this creates with Player:GetRagdollEntity.
    CreateRagdoll: function(self)

    --- Disables the default player's crosshair. Can be reenabled with Player:CrosshairEnable. This will affect WEAPON:DoDrawCrosshair.
    CrosshairDisable: function(self)

    --- Enables the player's crosshair, if it was previously disabled via Player:CrosshairDisable.
    CrosshairEnable: function(self)

    --- Returns whether the player is crouching or not (FL_DUCKING flag).
    -- @return --- Whether the player is crouching.
    Crouching: function(self): boolean

    --- Returns the player's death count
    -- @return --- The number of deaths the player has had.
    Deaths: function(self): number

    --- Prints the players' name and position to the console.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L48-L53)
    DebugInfo: function(self)

    --- Detonates all tripmines belonging to the player.
    DetonateTripmines: function(self)

    --- Disables world clicking for given player. See Panel:SetWorldClicker and Player:IsWorldClickingDisabled.
    -- @param disable --- Whether the world clicking should be disabled.
    DisableWorldClicking: function(self, disable: boolean)

    --- Sends a third person animation event to the player.
    --- Calls GM:DoAnimationEvent with PLAYERANIMEVENT_CUSTOM_GESTURE as the event, data as the given data.
    -- @param data --- The data to send.
    DoAnimationEvent: function(self, data: number)

    --- Starts the player's attack animation. The attack animation is determined by the weapon's HoldType.
    --- Similar to other animation event functions, calls GM:DoAnimationEvent with PLAYERANIMEVENT_ATTACK_PRIMARY as the event and no extra data.
    DoAttackEvent: function(self)

    --- Sends a specified third person animation event to the player.
    --- Calls GM:DoAnimationEvent with specified arguments.
    -- @param event --- The event to send. See Enums/PLAYERANIMEVENT.
    -- @param data --- The data to send alongside the event.
    DoCustomAnimEvent: function(self, event: number, data: number)

    --- Sends a third person reload animation event to the player.
    --- Similar to other animation event functions, calls GM:DoAnimationEvent with PLAYERANIMEVENT_RELOAD as the event and no extra data.
    DoReloadEvent: function(self)

    --- Sends a third person secondary fire animation event to the player.
    --- Similar to other animation event functions, calls GM:DoAnimationEvent with PLAYERANIMEVENT_ATTACK_SECONDARY as the event and no extra data.
    DoSecondaryAttack: function(self)

    --- Show/Hide the player's weapon's viewmodel.
    -- @param draw --- Should draw
    -- @param vm --- Which view model to show/hide, 0-2.
    DrawViewModel: function(self, draw: boolean, vm: number)

    --- Show/Hide the player's weapon's worldmodel.
    -- @param draw --- Should draw
    DrawWorldModel: function(self, draw: boolean)

    --- Drops the players' weapon of a specific class.
    -- @param class --- The class to drop.
    -- @param target --- If set, launches the weapon at given position. There is a limit to how far it is willing to throw the weapon. Overrides velocity argument.
    -- @param velocity --- If set and previous argument is unset, launches the weapon with given velocity. If the velocity is higher than 400, it will be clamped to 400.
    DropNamedWeapon: function(self, class: string, target: GVector, velocity: GVector)

    --- Drops any object the player is currently holding with either Gravity Gun, Physics Gun or `+use` (E key)
    --- See also Entity:ForcePlayerDrop.
    -- @param entity --- Only drop if the held entity is this entity. If left blank, drop any held entity.
    DropObject: function(self, entity: GEntity)

    --- Forces the player to drop the specified weapon
    -- @param weapon --- Weapon to be dropped. If unset, will default to the currently equipped weapon.
    -- @param target --- If set, launches the weapon at given position. There is a limit to how far it is willing to throw the weapon. Overrides velocity argument.
    -- @param velocity --- If set and previous argument is unset, launches the weapon with given velocity. If the velocity is higher than 400, it will be clamped to 400.
    DropWeapon: function(self, weapon: GWeapon, target: GVector, velocity: GVector)

    --- Force puts the player into a specified vehicle.
    --- This **does not** bypass GM:CanPlayerEnterVehicle.
    -- @param vehicle --- Vehicle the player will enter
    EnterVehicle: function(self, vehicle: GVehicle)

    --- Equips the player with the HEV suit.
    --- Allows the player to zoom, walk slowly, sprint, pickup armor batteries, use the health and armor stations and also shows the HUD.
    --- The player also emits a flatline sound on death, which can be overridden with GM:PlayerDeathSound.
    --- The player is automatically equipped with the suit on spawn, if you wish to stop that, use Player:RemoveSuit.
    EquipSuit: function(self)

    --- Forces the player off the current ladder if they are on one.
    ExitLadder: function(self)

    --- Forces the player to exit the vehicle if they're in one.
    --- This function will bypass GM:CanExitVehicle. See also GM:PlayerLeaveVehicle
    ExitVehicle: function(self)

    --- Enables/Disables the player's flashlight.
    --- Player:CanUseFlashlight must be true in order for the player's flashlight to be changed.
    --- GM:PlayerSwitchFlashlight can block this function.
    -- @param isOn --- Turns the flashlight on/off
    Flashlight: function(self, isOn: boolean)

    --- Returns true if the player's flashlight is on.
    -- @return --- Whether the player's flashlight is on.
    FlashlightIsOn: function(self): boolean

    --- Returns the amount of frags a player has.
    --- **NOTE**: The value will change depending on the player's kill or suicide: +1 for a kill, -1 for a suicide.
    -- @return --- frags
    Frags: function(self): number

    --- Freeze the player. Frozen players cannot move, look around, or attack. Key bindings are still called. Similar to Player:Lock but the player can still take damage.
    --- Manages the FL_FROZEN flag on the player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L212-L220)
    -- @param frozen --- Whether the player should be frozen.
    Freeze: function(self, frozen: boolean)

    --- Returns the player's active weapon.
    --- If used on a Global.LocalPlayer() and the player is spectating another player with `OBS_MODE_IN_EYE`, the weapon returned will be of the spectated player.
    -- @return --- The weapon the player currently has equipped or NULL if the player doesn't have an active weapon eg. when they're dead.
    GetActiveWeapon: function(self): GWeapon

    --- Returns the player's current activity.
    -- @return act --- The player's current activity. See Enums/ACT.
    GetActivity: function(self): number

    --- Returns the direction that the player is aiming.
    -- @return --- The direction vector of players aim
    GetAimVector: function(self): GVector

    --- Returns true if the players' model is allowed to rotate around the pitch and roll axis.
    -- @return --- Allowed
    GetAllowFullRotation: function(self): boolean

    --- Returns whether the player is allowed to use their weapons in a vehicle or not.
    -- @return --- Whether the player is allowed to use their weapons in a vehicle or not.
    GetAllowWeaponsInVehicle: function(self): boolean

    --- Returns a table of all ammo the player has.
    -- @return --- A table with the following format
    --- * number Key - AmmoID to be used with functions like game.GetAmmoName.
    --- * number Value - Amount of ammo the player has of this kind.
    GetAmmo: function(self): table

    --- Gets the amount of ammo the player has.
    -- @param ammotype --- The ammunition type. Can be either number ammo ID or string ammo name.
    -- @return --- The amount of ammo player has in reserve.
    GetAmmoCount: function(self, ammotype: any): number

    --- Gets if the player will be pushed out of nocollided players.
    -- @return --- pushed
    GetAvoidPlayers: function(self): boolean

    --- Returns true if the player is able to walk using the (default) alt key.
    -- @return --- AbleToWalk
    GetCanWalk: function(self): boolean

    --- Determines whenever the player is allowed to use the zoom functionality.
    -- @return --- canZoom
    GetCanZoom: function(self): boolean

    --- Returns the player's class id.
    -- @return --- The player's class id.
    GetClassID: function(self): number

    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    --- Gets the total amount of entities of an entity type added by Player:AddCount.
    --- Default types:
    --- ```
    --- balloons
    --- buttons
    --- cameras
    --- dynamite
    --- effects
    --- emitters
    --- hoverballs
    --- lamps
    --- lights
    --- npcs
    --- props
    --- ragdolls
    --- sents
    --- thrusters
    --- vehicles
    --- wheels
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L34-L70)
    -- @param type --- Type to get entity count of.
    -- @param minus --- If specified, it will reduce the counter by this value. Works only serverside.
    -- @return count --- The returned count.
    GetCount: function(self, type: string, minus: number): number

    --- Returns the crouched walk speed multiplier.
    --- See also Player:GetWalkSpeed and Player:SetCrouchedWalkSpeed.
    -- @return --- The crouched walk speed multiplier.
    GetCrouchedWalkSpeed: function(self): number

    --- Returns the last command which was sent by the specified player. This can only be called on the player which Global.GetPredictionPlayer() returns.
    --- **NOTE**: When called clientside in singleplayer during WEAPON:Think, it will return nothing as the hook is not technically predicted in that instance. See the note on the page.
    --- **BUG**: [This will fail in GM:StartCommand.](https://github.com/Facepunch/garrysmod-issues/issues/3302
    -- @return --- Last user commands
    GetCurrentCommand: function(self): GCUserCmd

    --- Gets the **actual** view offset which equals the difference between the players actual position and their view when standing.
    --- Do not confuse with Player:GetViewOffset and Player:GetViewOffsetDucked
    -- @return --- The actual view offset.
    GetCurrentViewOffset: function(self): GVector

    --- Gets the entity the player is currently driving via the drive library.
    -- @return --- The currently driven entity, or NULL entity
    GetDrivingEntity: function(self): GEntity

    --- Returns driving mode of the player. See Entity Driving.
    -- @return --- The drive mode ID or 0 if player doesn't use the drive system.
    GetDrivingMode: function(self): number

    --- Returns a player's duck speed (in seconds)
    -- @return --- duckspeed
    GetDuckSpeed: function(self): number

    --- Returns the entity the player is currently using, like func_tank mounted turrets or +use prop pickups.
    -- @return --- Entity in use, or NULL entity otherwise. For +use prop pickups, this will be NULL clientside.
    GetEntityInUse: function(self): GEntity

    --- Returns a table with information of what the player is looking at.
    --- The results of this function are **cached** clientside every frame.
    --- Uses util.GetPlayerTrace internally and is therefore bound by its limits.
    --- See also Player:GetEyeTraceNoCursor.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L172-L192)
    -- @return --- Trace information, see Structures/TraceResult.
    GetEyeTrace: function(self): S_TraceResult

    --- Returns the trace according to the players view direction, ignoring their mouse (holding `` and moving the mouse in Sandbox).
    --- The results of this function are **cached** clientside every frame.
    --- Uses util.GetPlayerTrace internally and is therefore bound by its limits.
    --- See also Player:GetEyeTrace.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L194-L213)
    -- @return --- Trace result. See Structures/TraceResult.
    GetEyeTraceNoCursor: function(self): S_TraceResult

    --- Returns the FOV of the player.
    -- @return --- Field of view as a float
    GetFOV: function(self): number

    --- Returns the steam "relationship" towards the player.
    -- @return --- Should return one of four different things depending on their status on your friends list: "friend", "blocked", "none", "requested" or "error_nofriendid" for bots.
    GetFriendStatus: function(self): string

    --- Gets the hands entity of a player
    -- @return --- The hands entity if players has one
    GetHands: function(self): GEntity

    --- Returns the widget the player is hovering with their mouse.
    -- @return --- The hovered widget.
    GetHoveredWidget: function(self): GEntity

    --- Retrieves the minimum and maximum Vectors of the [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for the Player's physics and movement Hull Traces.
    --- See also: Player:SetHull, Player:SetHullDuck, Player:GetHullDuck
    -- @return mins --- The hull mins, the lowest corner of the Player's bounding box.
    -- @return maxs --- The hull maxs, the highest corner of the Player's bounding box, opposite of the mins.
    GetHull: function(self): GVector, GVector

    --- Retrieves the minimum and maximum Vectors of the [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for the Player's physics and movement Hull Traces while they are crouching (or "Ducking").
    --- See also: Player:SetHullDuck, Player:GetHull, Player:SetHull
    -- @return mins --- The hull mins, the lowest corner of the Player's bounding box while crouching.
    -- @return maxs --- The hull maxs, the highest corner of the Player's crouching bounding box, opposite of the mins.
    GetHullDuck: function(self): GVector, GVector

    --- Retrieves the value of a client-side ConVar. The ConVar must have a FCVAR_USERINFO flag for this to work.
    --- On client this function will return value of the local player, regardless of which player the function was called on!
    --- See Player:GetInfoNum for the same function that automatically converts the string to a number.
    -- @param cVarName --- The name of the client-side ConVar.
    -- @return --- The value of the ConVar. Or an empty string if the convar doesn't exist.
    --- **WARNING**: The returned value is truncated to 31 bytes.
    GetInfo: function(self, cVarName: string): string

    --- Retrieves the numeric value of a client-side convar, returns nil if value is not convertible to a number. The ConVar must have a FCVAR_USERINFO flag for this to work.
    -- @param cVarName --- The name of the ConVar to query the value of
    -- @param default --- Default value if we failed to retrieve the number.
    -- @return --- The value of the ConVar or the default value
    GetInfoNum: function(self, cVarName: string, default: number): number

    --- Returns the jump power of the player
    -- @return --- Jump power
    GetJumpPower: function(self): number

    --- Returns the player's ladder climbing speed.
    --- See Player:GetWalkSpeed for normal walking speed, Player:GetRunSpeed for sprinting speed and Player:GetSlowWalkSpeed for slow walking speed.
    -- @return speed --- The ladder climbing speed.
    GetLadderClimbSpeed: function(self): number

    --- Returns the timescale multiplier of the player movement.
    -- @return --- The timescale multiplier, defaults to `1`.
    GetLaggedMovementValue: function(self): number

    --- Returns the maximum amount of armor the player should have. Default value is 100.
    -- @return maxarmor --- The new max armor value
    GetMaxArmor: function(self): number

    --- Returns the player's maximum movement speed.
    --- See also Player:SetMaxSpeed, Player:GetWalkSpeed and Player:GetRunSpeed.
    -- @return --- The maximum movement speed the player can go at.
    GetMaxSpeed: function(self): number

    --- Returns the player's name, this is an alias of Player:Nick.
    --- @deprecated
    --- **DEPRECATED**: Use Player:Nick.
    --- **NOTE**: This function overrides Entity:GetName (in the Lua metatable, not in c++), keep it in mind when dealing with ents.FindByName or any engine function which requires the mapping name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L56-L56)
    -- @return --- The player's name.
    GetName: function(self): string

    --- Returns whenever the player is set not to collide with their teammates.
    -- @return --- noCollideWithTeammates
    GetNoCollideWithTeammates: function(self): boolean

    --- Returns the the observer mode of the player
    -- @return --- Observe mode of that player, see Enums/OBS_MODE.
    GetObserverMode: function(self): number

    --- Returns the entity the player is currently observing.
    --- Set using Player:SpectateEntity.
    -- @return --- The entity the player is currently spectating, or NULL if the player has no target.
    GetObserverTarget: function(self): GEntity

    --- Returns a **P**ersistent **Data** key-value pair from the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the sql library. See util.GetPData for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses Player:SteamID64, it previously utilized Player:UniqueID which can cause collisions (two or more players sharing the same PData entry). Player:SetPData now replaces all instances of Player:UniqueID with Player:SteamID64 when running Player:SetPData
    --- **NOTE**: PData is not networked from servers to clients!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L111-L131)
    -- @param key --- Name of the PData key
    -- @param default --- Default value if PData key doesn't exist.
    -- @return --- The data in the SQL database or the default value given.
    GetPData: function(self, key: string, default: any): string

    --- Returns a player's character model color.
    --- The part of the model that is colored is determined by the model's materials, and is therefore different for each model.
    --- See Player:GetWeaponColor for the accompanying function for the weapon color.
    --- **NOTE**: Override this function clientside on any Entity (including a player) with a supported model set (such as default player models) and returned color will apply to the model. This is done via the `PlayerColor` matproxy.
    -- @return --- The format is `Vector(r,g,b)`, and each color component should be between 0 and 1.
    GetPlayerColor: function(self): GVector

    --- Returns a table containing player information.
    -- @return --- A table containing player information.
    GetPlayerInfo: function(self): table

    --- Returns the preferred carry angles of an object, if any are set.
    --- Calls GM:GetPreferredCarryAngles with the target entity and returns the carry angles.
    -- @param carryEnt --- Entity to retrieve the carry angles of.
    -- @return --- Carry angles or nil if the entity has no preferred carry angles.
    GetPreferredCarryAngles: function(self, carryEnt: GEntity): GAngle

    --- Returns the widget entity the player is using.
    --- Having a pressed widget stops the player from firing their weapon to allow input to be passed onto the widget.
    -- @return --- The pressed widget.
    GetPressedWidget: function(self): GEntity

    --- Returns the weapon the player previously had equipped.
    -- @return --- The previous weapon of the player.
    --- **WARNING**: This is not guaranteed to be a weapon entity so it should be checked with Entity:IsWeapon for safety.
    GetPreviousWeapon: function(self): GEntity

    --- @deprecated
    --- **DEPRECATED**: You should use Player:GetViewPunchAngles instead.
    --- Returns players screen punch effect angle. See Player:ViewPunch and Player:SetViewPunchAngles
    -- @return --- The punch angle
    GetPunchAngle: function(self): GAngle

    --- Returns players death ragdoll. The ragdoll is created by Player:CreateRagdoll.
    --- **NOTE**: Calling Entity:GetPos server-side with this function then will return the position where Player:CreateRagdoll was used, as it is a hl2mp_ragdoll which is a serverside point entity that creates a clientside ragdoll for everyone (opposed to prop_ragdoll that is serverside and networks).
    -- @return --- The ragdoll.
    --- Unlike normal clientside ragdolls (`C_ClientRagdoll`), this will be a `C_HL2MPRagdoll` on the client, and `hl2mp_ragdoll` on the server.
    GetRagdollEntity: function(self): GEntity

    --- Returns the render angles for the player.
    -- @return --- The render angles of the player. Only **yaw** part of the angle seems to be present.
    GetRenderAngles: function(self): GAngle

    --- Returns the player's sprint speed.
    --- See also Player:SetRunSpeed, Player:GetWalkSpeed and Player:GetMaxSpeed.
    -- @return --- The sprint speed
    GetRunSpeed: function(self): number

    --- Returns the position of a Player's view
    --- **NOTE**: This is the same as calling Entity:EyePos on the player.
    -- @return --- The position of the player's view.
    GetShootPos: function(self): GVector

    --- Returns the player's slow walking speed, which is activated via `` keybind.
    --- See Player:GetWalkSpeed for normal walking speed, Player:GetRunSpeed for sprinting speed and Player:GetLadderClimbSpeed for ladder climb speed.
    -- @return speed --- The new slow walking speed.
    GetSlowWalkSpeed: function(self): number

    --- Returns the maximum height player can step onto.
    -- @return --- The maximum height player can get up onto without jumping, in hammer units.
    GetStepSize: function(self): number

    --- Returns the player's HEV suit power.
    --- **BUG**: [This will only work for the local player when used clientside.](https://github.com/Facepunch/garrysmod-issues/issues/3449
    -- @return --- The current suit power.
    GetSuitPower: function(self): number

    --- Returns the number of seconds that the player has been timing out for. You can check if a player is timing out with Player:IsTimingOut.
    --- **NOTE**: This function is relatively useless because it is tied to the value of the `sv_timeout` ConVar, which is irrelevant to the description above. [This is not considered as a bug](https://discord.com/channels/565105920414318602/567617926991970306/748970396224585738).
    -- @return --- Timeout seconds.
    GetTimeoutSeconds: function(self): number

    --- Returns TOOL table of players current tool, or of the one specified.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L105-L115)
    -- @param mode --- Classname of the tool to retrieve. ( Filename of the tool in gmod_tool/stools/ )
    -- @return --- TOOL table, or nil if the table wasn't found or the player doesn't have a tool gun.
    GetTool: function(self, mode: string): table

    --- Returns a player's unduck speed (in seconds)
    -- @return --- unduck speed
    GetUnDuckSpeed: function(self): number

    --- Returns the entity the player would use if they would press their `+use` keybind.
    --- <note issue="5027">Because entity physics objects usually do not exist on the client, the client's use entity will resolve to whatever the crosshair is placed on within a little less than 72 units of the player's eye position. This differs from the entity returned by the server, which has fully physical use checking. See util.TraceHull.
    --- Issue tracker: [5027](https://github.com/Facepunch/garrysmod-issues/issues/5027)</note>
    -- @return ent --- The entity that would be used or NULL.
    GetUseEntity: function(self): GEntity

    --- Returns the player's user group. By default, player user groups are loaded from `garrysmod/settings/users.txt`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L44-L48)
    -- @return --- The user group of the player. This will return `"user"` if player has no user group.
    GetUserGroup: function(self): string

    --- Returns the vehicle the player is driving.
    -- @return --- The vehicle the player is currently driving, if any.
    --- Returns NULL entity if the player is not driving.
    GetVehicle: function(self): GVehicle

    --- Returns the entity the player is using to see from (such as the player itself, the camera, or another entity).
    --- **NOTE**: This function will return a [NULL Entity] until Player:SetViewEntity has been used
    -- @return --- The entity the player is using to see from
    GetViewEntity: function(self): GEntity

    --- Returns the player's view model entity by the index.
    --- Each player has 3 view models by default, but only the first one is used.
    --- To use the other viewmodels in your SWEP, see Entity:SetWeaponModel.
    --- **NOTE**: In the Client realm, other players' viewmodels are not available unless they are being spectated.
    -- @param index --- optional index of the view model to return, can range from 0 to 2
    -- @return --- The view model entity
    GetViewModel: function(self, index: number): GEntity

    --- Returns the view offset of the player which equals the difference between the players actual position and their view.
    --- See also Player:GetViewOffsetDucked.
    -- @return --- New view offset, must be local vector to players Entity:GetPos
    GetViewOffset: function(self): GVector

    --- Returns the view offset of the player which equals the difference between the players actual position and their view when ducked.
    --- See also Player:GetViewOffset.
    -- @return --- New crouching view offset, must be local vector to players Entity:GetPos
    GetViewOffsetDucked: function(self): GVector

    --- Returns players screen punch effect angle.
    -- @return --- The punch angle
    GetViewPunchAngles: function(self): GAngle

    --- Returns client's view punch velocity. See Player:ViewPunch and Player:SetViewPunchVelocity
    -- @return punchVel --- The current view punch angle velocity.
    GetViewPunchVelocity: function(self): GAngle

    --- Returns the current voice volume scale for given player on client.
    -- @return --- The voice volume scale, where 0 is 0% and 1 is 100%.
    GetVoiceVolumeScale: function(self): number

    --- Returns the player's normal walking speed. Not sprinting, not slow walking. (+walk)
    --- See also Player:SetWalkSpeed, Player:GetMaxSpeed and Player:GetRunSpeed.
    -- @return --- The normal walking speed.
    GetWalkSpeed: function(self): number

    --- Returns the weapon for the specified class
    -- @param className --- Class name of weapon
    -- @return --- The weapon for the specified class, or NULL ENTITY if the player does not have this weapon.
    GetWeapon: function(self, className: string): GWeapon

    --- Returns a player's weapon color.
    --- The part of the model that is colored is determined by the model itself, and is different for each model.
    --- See Player:GetPlayerColor for the accompanying function for the player character model color.
    -- @return --- The format is `Vector(r,g,b)`, and each color should be between 0 and 1.
    GetWeaponColor: function(self): GVector

    --- Returns a table of the player's weapons.
    --- **NOTE**: This function returns a sequential table. Prefer to loop it with Global.ipairs instead of the Global.pairs function.
    -- @return --- All the weapons the player currently has.
    GetWeapons: function(self): table

    --- Gives the player a weapon.
    --- This function will call GM:PlayerCanPickupWeapon. If that hook returns false, this function will do nothing.
    --- **NOTE**: While this function is meant for weapons/pickupables only, it is **not** restricted to weapons. Any entity can be spawned using this function, including NPCs and SENTs.
    -- @param weaponClassName --- Class name of weapon to give the player
    -- @param bNoAmmo --- Set to true to not give any ammo on weapon spawn. (Reserve ammo set by DefaultClip)
    -- @return --- The weapon given to the player, if one was given. It will return NULL if the player already has the weapon, or the weapon entity (entity with given classname) doesn't exist.
    Give: function(self, weaponClassName: string, bNoAmmo: boolean): GWeapon

    --- Gives ammo to a player
    -- @param amount --- Amount of ammo
    -- @param type --- Type of ammo.
    --- This is a string for named ammo types, and a number for ammo ID.
    --- You can find a list of default ammo types here.
    -- @param hidePopup --- Hide display popup when giving the ammo
    -- @return --- Ammo given.
    GiveAmmo: function(self, amount: number, type: string, hidePopup: boolean): number

    --- Disables god mode on the player. Removes the FL_GODMODE flag from the player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L232-L240)
    GodDisable: function(self)

    --- Enables god mode on the player. Adds the FL_GODMODE flag to the player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L222-L230)
    GodEnable: function(self)

    --- Returns whether the player has god mode or not, contolled by Player:GodEnable and Player:GodDisable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L254-L262)
    -- @return --- Whether the player has god mode or not.
    HasGodMode: function(self): boolean

    --- Returns if the player has the specified weapon
    -- @param className --- Class name of the weapon
    -- @return --- True if the player has the weapon
    HasWeapon: function(self, className: string): boolean

    --- Returns the player's IP address and connection port in ip:port form
    --- **NOTE**: Returns `Error!` for bots.
    -- @return ip --- The player's IP address and connection port
    IPAddress: function(self): string

    --- Returns if the player is in a vehicle
    -- @return --- Whether the player is in a vehicle.
    InVehicle: function(self): boolean

    --- Returns whether the player is an admin or not. It will also return `true` if the player is Player:IsSuperAdmin by default.
    --- Internally this is determined by Player:IsUserGroup.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L9-L16)
    -- @return --- True if the player is an admin or a super admin.
    IsAdmin: function(self): boolean

    --- Returns if the player is an bot or not
    -- @return --- `true` if the player is a bot.
    IsBot: function(self): boolean

    --- Returns true from the point when the player is sending client info but not fully in the game until they disconnect.
    -- @return --- isConnected
    IsConnected: function(self): boolean

    --- Used to find out if a player is currently 'driving' an entity (by which we mean 'right click > drive' ).
    -- @return --- A value representing whether or not the player is 'driving' an entity.
    IsDrivingEntity: function(self): boolean

    --- Returns whether the players movement is currently frozen, controlled by Player:Freeze.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L244-L252)
    -- @return --- Whether the players movement is currently frozen or not.
    IsFrozen: function(self): boolean

    --- Returns whether the player identity was confirmed by the Steam network.
    --- See also GM:NetworkIDValidated.
    -- @return --- Whether the player has been fully authenticated or not.
    --- This will always be true for singleplayer and the listen server host.
    --- This will always be false for bots.
    IsFullyAuthenticated: function(self): boolean

    --- Returns if a player is the host of the current session.
    -- @return --- `true` if the player is the listen server host, `false` otherwise.
    --- This will always be `true` in single player, and `false` on a dedicated server.
    IsListenServerHost: function(self): boolean

    --- Returns whether or not the player is voice muted locally.
    -- @return --- whether or not the player is muted locally.
    IsMuted: function(self): boolean

    --- Returns true if the player is playing a taunt.
    -- @return --- Whether the player is playing a taunt.
    IsPlayingTaunt: function(self): boolean

    --- Returns whenever the player is heard by the local player clientside, or if the player is speaking serverside.
    -- @return --- Is the player speaking or not.
    IsSpeaking: function(self): boolean

    --- Returns whether the player is currently sprinting or not, specifically if they are holding their sprint key and are allowed to sprint.
    --- This will not check if the player is currently sprinting into a wall. (i.e. holding their sprint key but not moving)
    -- @return --- Is the player sprinting or not
    IsSprinting: function(self): boolean

    --- Returns whenever the player is equipped with the suit item.
    --- **BUG**: [This will only work for the local player when used clientside.](https://github.com/Facepunch/garrysmod-issues/issues/3449
    -- @return --- Is the suit equipped or not.
    IsSuitEquipped: function(self): boolean

    --- Returns whether the player is a super admin.
    --- Internally this is determined by Player:IsUserGroup. See also Player:IsAdmin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L22-L26)
    -- @return --- True if the player is a super admin.
    IsSuperAdmin: function(self): boolean

    --- Returns `true` if the player is timing out (i.e. is losing connection), `false` otherwise.
    --- A player is considered timing out when more than 4 seconds has elapsed since a network packet was received from given player.
    -- @return --- Whether the player is timing out.
    IsTimingOut: function(self): boolean

    --- Returns whether the player is typing in their chat.
    --- This may not work properly if the server uses a custom chatbox.
    -- @return --- Whether the player is typing in their chat or not.
    IsTyping: function(self): boolean

    --- Returns whether the player is in specified group or not. See Player:GetUserGroup for a way to get player's user group.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L32-L38)
    -- @param groupName --- Group to check the player for.
    -- @return --- `true` if the player has the given user group.
    IsUserGroup: function(self, groupName: string): boolean

    --- Returns if the player can be heard by the local player.
    -- @return --- isAudible
    IsVoiceAudible: function(self): boolean

    --- Returns if the player currently walking. (`+walk` keybind)
    -- @return --- `true` if the player is currently walking.
    IsWalking: function(self): boolean

    --- Returns whether the player is using the world clicking feature, see Panel:SetWorldClicker
    -- @return --- Is the player world clicking or not.
    IsWorldClicking: function(self): boolean

    --- Returns whether the world clicking is disabled for given player or not. See Player:DisableWorldClicking.
    -- @return --- Whether the world clicking is disabled or not.
    IsWorldClickingDisabled: function(self): boolean

    --- Returns whether a key is down. This is not networked to other players, meaning only the local client can see the keys they are pressing.
    -- @param key --- The key, see Enums/IN
    -- @return --- whether the key is down or not.
    KeyDown: function(self, key: number): boolean

    --- Gets whether a key was down one tick ago.
    -- @param key --- The key, see Enums/IN
    -- @return --- Is key down ?
    KeyDownLast: function(self, key: number): boolean

    --- Gets whether a key was just pressed this tick.
    -- @param key --- Corresponds to an Enums/IN. You can use bit.bor here (see example 2)
    -- @return --- Was pressed or not
    KeyPressed: function(self, key: number): boolean

    --- Gets whether a key was just released this tick.
    -- @param key --- The key, see Enums/IN
    -- @return --- Was released or not
    KeyReleased: function(self, key: number): boolean

    --- Kicks the player from the server.
    --- **NOTE**: This can not be run before the player has fully joined in. Use game.KickID for that.
    -- @param reason --- Reason to show for disconnection.
    --- **WARNING**: This will be shortened to ~512 chars, though this includes the command itself and the player index so will realistically be more around ~498. It is recommended to avoid going near the limit to avoid truncation.
    Kick: function(self, reason: string)

    --- Kills a player and calls GM:PlayerDeath.
    Kill: function(self)

    --- Kills a player without notifying the rest of the server.
    --- This will call GM:PlayerSilentDeath instead of GM:PlayerDeath.
    KillSilent: function(self)

    --- This allows the server to mitigate the lag of the player by moving back all the entities that can be lag compensated to the time the player attacked with his weapon.
    --- This technique is most commonly used on things that hit other entities instantaneously, such as traces.
    --- **NOTE**: Entity:FireBullets calls this function internally.
    --- Lag compensation only works for players and entities that have been enabled with Entity:SetLagCompensated
    --- Despite being defined shared, it can only be used server-side in a Predicted Hook.
    --- **WARNING**: This function NEEDS to be disabled after you're done with it or it will break the movement of the entities affected!
    --- **BUG**: [Lag compensation does not support pose parameters.](https://github.com/Facepunch/garrysmod-issues/issues/3683
    -- @param lagCompensation --- The state of the lag compensation, true to enable and false to disable.
    LagCompensation: function(self, lagCompensation: boolean)

    --- Returns the hitgroup where the player was last hit.
    -- @return --- Hitgroup, see Enums/HITGROUP
    LastHitGroup: function(self): number

    --- Shows "limit hit" notification in sandbox.
    --- **NOTE**: This function is only available in Sandbox and its derivatives.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L120-L124)
    -- @param type --- Type of hit limit.
    LimitHit: function(self, type: string)

    --- Returns the direction a player is looking as a entity/local-oriented angle.
    --- Unlike Entity:EyeAngles, this function does not include angles of the Player's Entity:GetParent.
    --- **BUG**: Does not work correctly clientside for non local players when in a vehicle. (validate: when parented in general?)
    -- @return --- The local eye angles.
    LocalEyeAngles: function(self): GAngle

    --- Stops a player from using any inputs, such as moving, turning, or attacking. Key binds are still called. Similar to Player:Freeze but the player takes no damage.
    --- Adds the FL_FROZEN and FL_GODMODE flags to the player.
    Lock: function(self)

    --- Returns the position of a Kinect bone.
    -- @param bone --- Bone to get the position of. Must be from 0 to 19.
    -- @return --- Position of the bone.
    MotionSensorPos: function(self, bone: number): GVector

    --- @deprecated
    --- **DEPRECATED**: Use Player:Nick.
    --- Returns the player's nick name. Identical to Player:Nick and Player:GetName.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L57-L57)
    -- @return --- Player's name.
    Name: function(self): string

    --- Returns the player's nick name also known as display name, as it appears in Steam.
    -- @return --- Player's nick name
    Nick: function(self): string

    --- Returns the 64-bit SteamID aka CommunityID of the Steam Account that owns the Garry's Mod license this player is using. This is useful for detecting players using Steam Family Sharing.
    --- If player is not using Steam Family Sharing, this will return the player's actual SteamID64().
    --- **NOTE**: This data will only be available after the player has fully authenticated with Steam. See Player:IsFullyAuthenticated.
    -- @return --- The 64bit SteamID
    OwnerSteamID64: function(self): string

    --- Returns the percentage of packets lost by the client. It is not networked so it only returns 0 when run clientside.
    -- @return --- Percentage of packets lost (0-100)
    PacketLoss: function(self): number

    --- Unfreezes the props player is looking at. This is essentially the same as pressing reload with the physics gun, including double press for unfreeze all.
    --- For freezing props, use PhysObj:EnableMotion.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L53-L96)
    -- @return --- Number of props unfrozen.
    PhysgunUnfreeze: function(self): number

    --- This makes the player hold (same as pressing `` on a small prop) given entity.
    --- Not to be confused with picking up items like ammo or health kits.
    --- This picks up the passed entity regardless of its mass or distance from the player.
    -- @param entity --- Entity to pick up.
    PickupObject: function(self, entity: GEntity)

    --- Forces the player to pickup an existing weapon entity. The player will not pick up the weapon if they already own a weapon of given type, or if the player could not normally have this weapon in their inventory.
    --- This function **will** bypass GM:PlayerCanPickupWeapon.
    -- @param wep --- The weapon to try to pick up.
    -- @param ammoOnly --- If set to true, the player will only attempt to pick up the ammo from the weapon. The weapon will not be picked up even if the player doesn't have a weapon of this type, and the weapon will be removed if the player picks up any ammo from it.
    -- @return result --- Whether the player succeeded in picking up the weapon or not.
    PickupWeapon: function(self, wep: GWeapon, ammoOnly: boolean): boolean

    --- Returns the player's ping to server.
    -- @return --- The player's ping.
    Ping: function(self): number

    --- Plays the correct step sound according to what the player is staying on.
    -- @param volume --- Volume for the sound, in range from 0 to 1
    PlayStepSound: function(self, volume: number)

    --- Displays a message either in their chat, console, or center of the screen. See also Global.PrintMessage.
    --- **NOTE**: When called serverside, this uses the archaic user message system (the umsg) and hence is limited to ≈250 characters.
    --- `HUD_PRINTCENTER` will not work when this is called clientside.
    -- @param type --- Which type of message should be sent to the player (Enums/HUD).
    -- @param message --- Message to be sent to the player.
    PrintMessage: function(self, type: number, message: string)

    --- Removes all ammo from a certain player
    RemoveAllAmmo: function(self)

    --- Removes all weapons and ammo from the player.
    RemoveAllItems: function(self)

    --- Removes the amount of the specified ammo from the player.
    -- @param ammoCount --- The amount of ammunition to remove.
    -- @param ammoName --- The name of the ammunition to remove from. This can also be a number ammoID.
    RemoveAmmo: function(self, ammoCount: number, ammoName: string)

    --- Removes a **P**ersistent **Data** key-value pair from the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the sql library. See util.RemovePData for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses Player:SteamID64, it previously utilized Player:UniqueID which can cause collisions (two or more players sharing the same PData entry). Player:SetPData now replaces all instances of Player:UniqueID with Player:SteamID64 when running Player:SetPData
    --- **NOTE**: PData is not networked from servers to clients!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L148-L164)
    -- @param key --- Key to remove
    -- @return --- true is succeeded, false otherwise
    RemovePData: function(self, key: string): boolean

    --- Strips the player's suit item.
    RemoveSuit: function(self)

    --- Resets both normal and duck hulls to their default values.
    ResetHull: function(self)

    --- Forces the player to say whatever the first argument is. Works on bots too.
    --- **NOTE**: This function ignores the default chat message cooldown
    --- **WARNING**: The argument can only contain 126 characters. [Source SDK 2013](https://github.com/ValveSoftware/source-sdk-2013/blob/0d8dceea4310fde5706b3ce1c70609d72a38efdf/sp/src/game/server/client.cpp#L84-L86)
    -- @param text --- The text to force the player to say.
    -- @param teamOnly --- Whether to send this message to our own team only.
    Say: function(self, text: string, teamOnly: boolean)

    --- Fades the screen
    -- @param flags --- Fade flags defined with Enums/SCREENFADE.
    -- @param color --- The color of the screenfade
    -- @param fadeTime --- Fade(in/out) effect transition time ( From no fade to full fade and vice versa ).
    --- This is limited to 7 bits integer part and 9 bits fractional part.
    -- @param fadeHold --- Fade effect hold time.
    --- This is limited to 7 bits integer part and 9 bits fractional part.
    ScreenFade: function(self, flags: number, color: GColor, fadeTime: number, fadeHold: number)

    --- Sets the active weapon of the player by its class name.
    --- **WARNING**: This will switch the weapon out of prediction, causing delay on the client and WEAPON:Deploy and WEAPON:Holster to be called out of prediction. Try using CUserCmd:SelectWeapon or input.SelectWeapon, instead.
    --- **NOTE**: This will trigger the weapon switch event and associated animations. To switch weapons silently, use Player:SetActiveWeapon.
    -- @param className --- The class name of the weapon to switch to.
    --- If the player doesn't have the specified weapon, nothing will happen. You can use Player:Give to give the weapon first.
    SelectWeapon: function(self, className: string)

    --- Sends a hint to a player.
    --- **NOTE**: This function is only available in Sandbox and its derivatives. Since this adds `#Hint_` to the beginning of each message, you should only use it with default hint messages, or those cached with language.Add. For hints with custom text, look at notification.AddLegacy.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L119-L127)
    -- @param name --- Name/class/index of the hint. You can find a list of hint names for this function here.
    -- @param delay --- Delay in seconds before showing the hint
    SendHint: function(self, name: string, delay: number)

    --- Executes a simple Lua string on the player.
    --- **NOTE**: If you need to use this function more than once consider using net library. Send net message and make the entire code you want to execute in net.Receive on client.
    --- **NOTE**: The string is limited to 254 bytes. Consider using the net library for more advanced server-client interaction.
    -- @param script --- The script to execute.
    SendLua: function(self, script: string)

    --- Sets the player's active weapon. You should use CUserCmd:SelectWeapon or Player:SelectWeapon, instead in most cases.
    --- This function will not trigger the weapon switch events or associated equip animations. It will bypass
    --- GM:PlayerSwitchWeapon and the currently active weapon's WEAPON:Holster return value.
    -- @param weapon --- The weapon to equip.
    SetActiveWeapon: function(self, weapon: GWeapon)

    --- Sets the player's activity.
    -- @param act --- The new activity to set. See Enums/ACT.
    SetActivity: function(self, act: number)

    --- Set if the players' model is allowed to rotate around the pitch and roll axis.
    -- @param Allowed --- Allowed to rotate
    SetAllowFullRotation: function(self, Allowed: boolean)

    --- Allows player to use their weapons in a vehicle. You need to call this before entering a vehicle.
    --- **BUG**: [Shooting in a vehicle fires two bullets.](https://github.com/Facepunch/garrysmod-issues/issues/1277
    -- @param allow --- Show we allow player to use their weapons in a vehicle or not.
    SetAllowWeaponsInVehicle: function(self, allow: boolean)

    --- Sets the amount of the specified ammo for the player.
    -- @param ammoCount --- The amount of ammunition to set.
    -- @param ammoType --- The ammunition type. Can be either number ammo ID or string ammo name. See Default Ammo Types for default values.
    SetAmmo: function(self, ammoCount: number, ammoType: any)

    --- Sets the player armor value.
    --- See GM:HandlePlayerArmorReduction for a hook that allows manipulating what armor does.
    -- @param amount --- The amount to set the armor value of the player to.
    SetArmor: function(self, amount: number)

    --- Pushes the player away from other players whenever the player inside another players' bounding box.
    --- This avoidance is performed clientside by altering movement sent to server.
    --- This applies to players within a single team. (Player:Team)
    -- @param avoidPlayers --- Whether to avoid teammates, or not.
    SetAvoidPlayers: function(self, avoidPlayers: boolean)

    --- Set if the player should be allowed to walk using the (default) alt key. (`+walk` keybind)
    -- @param canWalk --- `true` allows the player to walk.
    SetCanWalk: function(self, canWalk: boolean)

    --- Sets whether the player can use the HL2 suit zoom (`+zoom` bind) or not.
    -- @param canZoom --- Whether to make the player able or unable to zoom.
    SetCanZoom: function(self, canZoom: boolean)

    --- **INTERNAL**: Use player_manager.SetPlayerClass instead.
    --- Sets the player's class id.
    -- @param classID --- The class id the player is being set with.
    SetClassID: function(self, classID: number)

    --- Sets the crouched walk speed multiplier.
    --- Has no effect for values above 1.
    --- See also Player:SetWalkSpeed and Player:GetCrouchedWalkSpeed.
    -- @param speed --- The walk speed multiplier that crouch speed should be.
    SetCrouchedWalkSpeed: function(self, speed: number)

    --- Sets the **actual** view offset which equals the difference between the players actual position and their view when standing.
    --- Do not confuse with Player:SetViewOffset and Player:SetViewOffsetDucked
    -- @param viewOffset --- The new view offset.
    SetCurrentViewOffset: function(self, viewOffset: GVector)

    --- Activates a given DSP (Digital Signal Processor) effect on all sounds that the player hears. This is equivalent to setting `dsp_player` convar on the player.
    --- To apply a DSP effect to individual sounds, see CSoundPatch:SetDSP
    -- @param dspEffectId --- The index of the DSP sound filter to apply.
    --- For a list of the available IDs and their meaning, see DSP Presets.
    -- @param fastReset --- If set to true the sound filter will be removed faster.
    --- **NOTE**: **This only works clientside**
    --- If used serverside, a message will be displayed (`SetPlayerDSP: fastReset only valid from client`) in the server console.
    SetDSP: function(self, dspEffectId: number, fastReset: boolean)

    --- Sets a player's death count
    -- @param deathCount --- Number of deaths (positive or negative)
    SetDeaths: function(self, deathCount: number)

    --- **INTERNAL**:
    --- Sets the driving entity and driving mode.
    --- Use drive.PlayerStartDriving instead, see Entity Driving.
    -- @param drivingEntity --- The entity the player should drive.
    -- @param drivingMode --- The driving mode index.
    SetDrivingEntity: function(self, drivingEntity: GEntity, drivingMode: number)

    --- Sets how quickly a player ducks.
    --- **BUG**: [This will not work for values >= 1.](https://github.com/Facepunch/garrysmod-issues/issues/2722
    -- @param duckSpeed --- How quickly the player will duck.
    SetDuckSpeed: function(self, duckSpeed: number)

    --- Sets the local angle of the player's view (may rotate body too if angular difference is large)
    --- **NOTE**: This function works differently when the player is in a vehicle. In that case passing `Angle(0, 90, 0)` will have the player look forward (out the windshield) and `Angle(0, 0, 0)` will have them look to the right.
    -- @param angle --- Angle to set the view to
    SetEyeAngles: function(self, angle: GAngle)

    --- Set a player's FOV (Field Of View) over a certain amount of time.
    --- This is meant to be called on the server or shared (for prediction), it will have no effect if called clientside only. You may want to use GM:CalcView for that instead.
    -- @param fov --- the angle of perception (FOV). Set to 0 to return to default user FOV. ( Which is ranging from 75 to 100, depending on user settings )
    -- @param time --- the time it takes to transition to the FOV expressed in a floating point.
    -- @param requester --- The requester or "owner" of the zoom event. Only this entity will be able to change the player's FOV until it is set back to 0.
    SetFOV: function(self, fov: number, time: number, requester: GEntity)

    --- Sets a player's frags (kills)
    -- @param fragCount --- Number of frags (positive or negative)
    SetFrags: function(self, fragCount: number)

    --- Sets the hands entity of a player.
    --- The hands entity is an entity introduced in Garry's Mod 13 and it's used to show the player's hands attached to the viewmodel.
    --- This is similar to the approach used in L4D and CS:GO, for more information on how to implement this system in your gamemode visit Using Viewmodel Hands.
    -- @param hands --- The hands entity to set
    SetHands: function(self, hands: GEntity)

    --- Sets the widget that is currently hovered by the player's mouse.
    -- @param widget --- The widget entity that the player is hovering.
    SetHoveredWidget: function(self, widget: GEntity)

    --- Sets the size of the Player's [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for physics and movement Hull Traces.
    --- See also: Player:GetHull, Player:SetHullDuck, Player:GetHullDuck
    --- **NOTE**: This value is **not** replicated automatically to clients and must be manually called in both the Server and Client Realms.
    -- @param mins --- The hull mins, the lowest corner of the Player's bounding box.
    -- @param maxs --- The hull maxs, the highest corner of the Player's bounding box, opposite of the mins.
    SetHull: function(self, mins: GVector, maxs: GVector)

    --- Sets the size of the Player's [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) used for physics and movement Hull Traces while they are crouching (or "Ducking").
    --- See also: Player:GetHullDuck, Player:GetHull, Player:SetHull
    --- **NOTE**: This value is **not** replicated automatically to clients and must be manually called in both the Server and Client Realms.
    -- @param mins --- The hull mins, the lowest corner of the Player's bounding box while crouching.
    -- @param maxs --- The hull maxs, the highest corner of the Player's crouching bounding box, opposite of the mins.
    SetHullDuck: function(self, mins: GVector, maxs: GVector)

    --- Sets the jump power, eg. the velocity that will be applied to the player when they jump.
    -- @param jumpPower --- The new jump velocity.
    SetJumpPower: function(self, jumpPower: number)

    --- Sets the player's ladder climbing speed.
    --- See Player:SetWalkSpeed for normal walking speed, Player:SetRunSpeed for sprinting speed and Player:SetSlowWalkSpeed for slow walking speed.
    -- @param speed --- The ladder climbing speed.
    SetLadderClimbSpeed: function(self, speed: number)

    --- Slows down the player movement simulation by the timescale, this is used internally in the HL2 weapon stripping sequence.
    --- It achieves such behavior by multiplying the Global.FrameTime by the specified timescale at the start of the movement simulation and then restoring it afterwards.
    --- **NOTE**: This is reset to 1 on spawn.
    --- There is no weapon counterpart to this, you'll have to hardcode the multiplier in the weapon or call Weapon:SetNextPrimaryFire / Weapon:SetNextSecondaryFire manually.
    -- @param timescale --- The timescale multiplier.
    SetLaggedMovementValue: function(self, timescale: number)

    --- Sets the hitgroup where the player was last hit.
    -- @param hitgroup --- The hitgroup to set as the "last hit", see Enums/HITGROUP.
    SetLastHitGroup: function(self, hitgroup: number)

    --- Sets the maximum amount of armor the player should have. This affects default built-in armor pickups, but not Player:SetArmor.
    -- @param maxarmor --- The new max armor value.
    SetMaxArmor: function(self, maxarmor: number)

    --- Sets the maximum speed which the player can move at.
    --- **NOTE**: This is called automatically by the engine. If you wish to limit player speed without setting their run/sprint speeds, see CMoveData:SetMaxClientSpeed.
    -- @param walkSpeed --- The maximum speed.
    SetMaxSpeed: function(self, walkSpeed: number)

    --- Sets if the player should be voicechat muted locally.
    -- @param mute --- Mute or unmute.
    SetMuted: function(self, mute: boolean)

    --- Sets whenever the player should not collide with their teammates, based on their Player:Team.
    --- **NOTE**: This will only work for teams with ID 1 to 4 due to internal Engine limitations.
    --- **NOTE**: This causes traces with COLLISION_GROUP_PLAYER to pass through players.
    -- @param shouldNotCollide --- `true` to disable, `false` to enable collision.
    SetNoCollideWithTeammates: function(self, shouldNotCollide: boolean)

    --- Sets the players visibility towards NPCs.
    --- Internally this toggles the FL_NOTARGET flag, which you can manually test for using Entity:IsFlagSet
    -- @param visibility --- The visibility.
    SetNoTarget: function(self, visibility: boolean)

    --- Sets the players observer mode. You must start the spectating first with Player:Spectate.
    -- @param mode --- Spectator mode using Enums/OBS_MODE.
    SetObserverMode: function(self, mode: number)

    --- Writes a **P**ersistent **Data** key-value pair to the SQL database. (`sv.db` when called on server, `cl.db` when called on client)
    --- Internally uses the sql library. See util.SetPData for cases when the player is not currently on the server.
    --- **NOTE**: This function internally uses Player:SteamID64, it previously utilized Player:UniqueID which could have caused collisions (two or more players sharing the same PData entry). Player:SetPData now replaces all instances of Player:UniqueID with Player:SteamID64 when running Player:SetPData
    --- **NOTE**: PData is not networked from servers to clients!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L133-L146)
    -- @param key --- Name of the PData key
    -- @param value --- Value to write to the key (**must** be an SQL valid data type, such as a string or integer)
    -- @return --- Whether the operation was successful or not
    SetPData: function(self, key: string, value: any): boolean

    --- Sets the player model's color. The part of the model that is colored is determined by the model itself, and is different for each model.
    -- @param Color --- This is the color to be set. The format is Vector(r, g, b), and each color should be between 0 and 1.
    SetPlayerColor: function(self, Color: GVector)

    --- Sets the widget that is currently in use by the player's mouse.
    --- Having a pressed widget stops the player from firing their weapon to allow input to be passed onto the widget.
    -- @param pressedWidget --- The widget the player is currently using.
    SetPressedWidget: function(self, pressedWidget: GEntity)

    --- Sets the render angles of a player. Value set by this function is reset to player's angles (Entity:GetAngles) right after GM:UpdateAnimation.
    -- @param ang --- The new render angles to set
    SetRenderAngles: function(self, ang: GAngle)

    --- Sets the player's sprint speed.
    --- See also Player:GetRunSpeed, Player:SetWalkSpeed and Player:SetMaxSpeed.
    --- **NOTE**: player_default class run speed is: `400`
    -- @param runSpeed --- The new sprint speed when `sv_friction` is below `10`. Higher `sv_friction` values will result in slower speed.
    --- Has to be `7` or above or the player **won't** be able to move.
    SetRunSpeed: function(self, runSpeed: number)

    --- Sets the player's slow walking speed, which is activated via `` keybind.
    --- See Player:SetWalkSpeed for normal walking speed, Player:SetRunSpeed for sprinting speed and Player:SetLadderClimbSpeed for ladder climb speed.
    -- @param speed --- The new slow walking speed.
    SetSlowWalkSpeed: function(self, speed: number)

    --- Sets the maximum height a player can step onto without jumping.
    -- @param stepHeight --- The new maximum height the player can step onto without jumping
    SetStepSize: function(self, stepHeight: number)

    --- Sets the player's HEV suit power.
    --- **BUG**: [This will only work for the local player when used clientside.](https://github.com/Facepunch/garrysmod-issues/issues/3449
    -- @param power --- The new suit power.
    SetSuitPower: function(self, power: number)

    --- Sets whenever to suppress the pickup notification for the player.
    -- @param doSuppress --- Whenever to suppress the notice or not.
    SetSuppressPickupNotices: function(self, doSuppress: boolean)

    --- Sets the player to the chosen team. The value is networked to clients at reduced bit count (16 bits) as as a signed value, so the real range is [-32768, 32767].
    --- Can be retrieved via Player:Team
    -- @param team --- The team that the player is being set to.
    SetTeam: function(self, team: number)

    --- Sets how quickly a player un-ducks
    -- @param UnDuckSpeed --- How quickly the player will un-duck
    SetUnDuckSpeed: function(self, UnDuckSpeed: number)

    --- Sets the usergroup of the player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L61-L65)
    -- @param groupName --- The user group of the player.
    SetUserGroup: function(self, groupName: string)

    --- Attaches the players view to the position and angles of the specified entity.
    -- @param viewEntity --- The entity to attach the player view to.
    SetViewEntity: function(self, viewEntity: GEntity)

    --- Sets the **desired** view offset which equals the difference between the players actual position and their view when standing.
    --- If you want to set **actual** view offset, use Player:SetCurrentViewOffset
    --- See also Player:SetViewOffsetDucked for **desired** view offset when crouching.
    -- @param viewOffset --- The new desired view offset when standing.
    SetViewOffset: function(self, viewOffset: GVector)

    --- Sets the **desired** view offset which equals the difference between the players actual position and their view when crouching.
    --- If you want to set **actual** view offset, use Player:SetCurrentViewOffset
    --- See also Player:SetViewOffset for **desired** view offset when standing.
    -- @param viewOffset --- The new desired view offset when crouching.
    SetViewOffsetDucked: function(self, viewOffset: GVector)

    --- Sets client's view punch angle, but not the velocity. See Player:ViewPunch
    -- @param punchAngle --- The angle to set.
    SetViewPunchAngles: function(self, punchAngle: GAngle)

    --- Sets client's view punch velocity. See Player:ViewPunch and Player:SetViewPunchAngles
    -- @param punchVel --- The angle velocity to set.
    SetViewPunchVelocity: function(self, punchVel: GAngle)

    --- Sets the voice volume scale for given player on client. This value will persist from server to server, but will be reset when the game is shut down.
    --- **NOTE**: This doesn't work on bots, their scale will always be `1`. Does not work with multiruns.
    -- @param  --- The voice volume scale, where `0` is 0% and `1` is 100%.
    SetVoiceVolumeScale: function(self, _: number)

    --- Sets the player's normal walking speed. Not sprinting, not slow walking ``.
    --- See also Player:SetSlowWalkSpeed, Player:GetWalkSpeed, Player:SetCrouchedWalkSpeed, Player:SetMaxSpeed and Player:SetRunSpeed.
    --- **BUG**: [Using a speed of `0` can lead to prediction errors, and can cause players to move at sv_maxvelocity](https://github.com/Facepunch/garrysmod-issues/issues/2030
    --- **NOTE**: `player_default` class walk speed is: `200`.
    -- @param walkSpeed --- The new walk speed when `sv_friction` is below `10`. Higher `sv_friction` values will result in slower speed.
    --- Has to be `7` or above or the player **won't** be able to move.
    SetWalkSpeed: function(self, walkSpeed: number)

    --- Sets the player weapon's color. The part of the model that is colored is determined by the model itself, and is different for each model.
    -- @param Color --- This is the color to be set. The format is Vector(r,g,b), and each color should be between 0 and 1.
    SetWeaponColor: function(self, Color: GVector)

    --- Sets up the player's hands for the viewmodel. Calls GM:PlayerSetHandsModel to determine the model. If no entity is provided, uses the player's own hands model. If spectating another entity, pass that entity to use its hands model instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L185-L200)
    -- @param ent --- If the player is spectating an entity, this should be the entity the player is spectating, so we can use its hands model instead.
    SetupHands: function(self, ent: GEntity)

    --- Returns whether the player's player model will be drawn at the time the function is called.
    -- @return --- `true` if the player's playermodel is visible
    ShouldDrawLocalPlayer: function(self): boolean

    --- Sets whether the player's current weapon should drop on death.
    --- **NOTE**: This is reset on spawn to the player class's **DropWeaponOnDie** field by player_manager.OnPlayerSpawn.
    -- @param drop --- Whether to drop the player's current weapon or not
    ShouldDropWeapon: function(self, drop: boolean)

    --- Opens the player steam profile page in the steam overlay browser.
    ShowProfile: function(self)

    --- Signals the entity that it was dropped by the gravity gun.
    -- @param ent --- Entity that was dropped.
    SimulateGravGunDrop: function(self, ent: GEntity)

    --- Signals the entity that it was picked up by the gravity gun. This call is only required if you want to simulate the situation of picking up objects.
    -- @param ent --- The entity picked up
    -- @param lightning --- Whether or not to show lightning effects around the entity
    SimulateGravGunPickup: function(self, ent: GEntity, lightning: boolean)

    --- **WARNING**: The player must be respawned, otherwise they will be able to walk through doors and become invincible.
    --- Starts spectate mode for given player. This will also affect the players movetype in some cases.
    -- @param mode --- Spectate mode, see Enums/OBS_MODE.
    Spectate: function(self, mode: number)

    --- **WARNING**: The player must be respawned, otherwise they will be able to walk through doors and become invincible.
    --- Makes the player spectate the entity.
    --- To get the applied spectated entity, use Player:GetObserverTarget.
    -- @param entity --- Entity to spectate.
    SpectateEntity: function(self, entity: GEntity)

    --- Makes a player spray their decal.
    -- @param sprayOrigin --- The location to spray from
    -- @param sprayEndPos --- The location to spray to
    SprayDecal: function(self, sprayOrigin: GVector, sprayEndPos: GVector)

    --- Disables the sprint on the player.
    SprintDisable: function(self)

    --- Enables the sprint on the player.
    SprintEnable: function(self)

    --- @deprecated
    --- **DEPRECATED**: This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    --- Doesn't appear to do anything.
    StartSprinting: function(self)

    --- @deprecated
    --- **DEPRECATED**: This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    --- When used in a GM:SetupMove hook, this function will force the player to walk, as well as preventing the player from sprinting.
    StartWalking: function(self)

    --- Returns the player's SteamID.
    --- See Player:AccountID for a shorter version of the SteamID and Player:SteamID64 for the full SteamID.
    --- It is recommended to use Player:SteamID64 over the other SteamID formats whenever possible.
    --- **NOTE**: In a `-multirun` environment, this will return `STEAM_ID_LAN` for all "copies" of a player because they are not authenticated with Steam.
    --- For Bots this will return `BOT`.
    -- @return --- "Text" representation of the player's SteamID.
    SteamID: function(self): string

    --- Returns the player's full **64-bit SteamID**, also known as **CommunityID**. Information on how data is packed into this value can be found [here](https://developer.valvesoftware.com/wiki/SteamID).
    --- See Player:AccountID for a function that returns only the Account ID part of the SteamID and Player:SteamID for the text version of the SteamID.
    --- **NOTE**: In a `-multirun` environment, this will return `"0"` for all "copies" of a player because they are not authenticated with Steam.
    --- For bots, this will return `90071996842377216` (equivalent to `STEAM_0:0:0`) for the first bot to join.
    --- For each additional bot, the number increases by 1. So the next bot will be `90071996842377217` (`STEAM_0:1:0`) then `90071996842377218` (`STEAM_0:0:1`) and so on.
    -- @return --- Player's 64-bit SteamID aka CommunityID.
    --- **NOTE**: The return value is a string, not a number, since Lua's numbers are unable to store the entire 64bit numbers without data loss.
    SteamID64: function(self): string

    --- @deprecated
    --- **DEPRECATED**: This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    --- When used in a GM:SetupMove hook, this function will prevent the player from sprinting.
    --- When +walk is engaged, the player will still be able to sprint to half speed (normal run speed) as opposed to full sprint speed without this function.
    StopSprinting: function(self)

    --- @deprecated
    --- **DEPRECATED**: This appears to be a direct binding to internal functionality that is overridden by the engine every frame so calling these functions may not have any or expected effect.
    --- When used in a GM:SetupMove hook, this function behaves unexpectedly by preventing the player from sprinting similar to Player:StopSprinting.
    StopWalking: function(self)

    --- Turns off the zoom mode of the player. (+zoom console command)
    --- Basically equivalent of entering "-zoom" into player's console.
    StopZooming: function(self)

    --- @deprecated
    --- **DEPRECATED**: Alias of Player:RemoveAllAmmo
    --- Removes all ammo from the player.
    StripAmmo: function(self)

    --- Removes the specified weapon class from a certain player
    --- **NOTE**: this function will call the Entity:OnRemove but if you try use Entity:GetOwner it will return nil
    -- @param weapon --- The weapon class to remove
    StripWeapon: function(self, weapon: string)

    --- Removes all weapons from a certain player
    StripWeapons: function(self)

    --- Prevents a hint from showing up.
    --- **NOTE**: This function is only available in Sandbox and its derivatives
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/player_extension.lua#L129-L137)
    -- @param name --- Hint name/class/index to prevent from showing up. You can find a list of hint names for this function here.
    SuppressHint: function(self, name: string)

    --- Attempts to switch the player weapon to the one specified in the "cl_defaultweapon" convar, if the player does not own the specified weapon nothing will happen.
    --- If you want to switch to a specific weapon, use: Player:SetActiveWeapon
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L166-L177)
    SwitchToDefaultWeapon: function(self)

    --- Returns the player's team ID, set by Player:SetTeam
    --- Returns 0 clientside when the game is not fully loaded.
    -- @return --- The player's team's index number, as in the Enums/TEAM or a custom team defined in team.SetUp.
    Team: function(self): number

    --- Returns the time in seconds since the player connected.
    --- Bots will always return value 0.
    -- @return connectedTime --- How long this player was connected to the server for, in seconds.
    TimeConnected: function(self): number

    --- Performs a trace hull and applies damage to the entities hit, returns the first entity hit.
    --- **WARNING**: Hitting the victim entity with this function in ENTITY:OnTakeDamage can cause infinite loops.
    -- @param startPos --- The start position of the hull trace.
    -- @param endPos --- The end position of the hull trace.
    -- @param mins --- The minimum coordinates of the hull.
    -- @param maxs --- The maximum coordinates of the hull.
    -- @param damage --- The damage to be applied.
    -- @param damageFlags --- Bitflag specifying the damage type, see Enums/DMG.
    -- @param damageForce --- The force to be applied to the hit object.
    -- @param damageAllNPCs --- Whether to apply damage to all hit NPCs or not.
    -- @return --- The hit entity
    TraceHullAttack: function(self, startPos: GVector, endPos: GVector, mins: GVector, maxs: GVector, damage: number, damageFlags: number, damageForce: number, damageAllNPCs: boolean): GEntity

    --- Translates Enums/ACT according to the holdtype of players currently held weapon.
    -- @param act --- The initial Enums/ACT
    -- @return --- Translated Enums/ACT
    TranslateWeaponActivity: function(self, act: number): number

    --- Unlocks the player movement if locked previously.
    --- Will disable godmode for the player if locked previously.
    UnLock: function(self)

    --- **WARNING**: The player must be respawned, otherwise they will be able to walk through doors and become invincible.
    --- Stops the player from spectating another entity.
    UnSpectate: function(self)

    --- Unfreezes all objects the player has frozen with their Physics Gun. Same as double pressing `` while holding Physics Gun.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L98-L153)
    UnfreezePhysicsObjects: function(self)

    --- @deprecated
    --- **DEPRECATED**:
    --- **This function has collisions,** where more than one player can have the same UniqueID. It is **highly** recommended to use Player:SteamID64, Player:SteamID or Player:AccountID instead, which are guaranteed to be unique to each player.
    --- Returns a 32 bit integer that remains constant for a player across joins/leaves and across different servers. This can be used when a string is inappropriate - e.g. in a database primary key.
    --- **NOTE**: In Singleplayer, this function will always return 1.
    --- **BUG**: [In a `-multirun` environment, the value returned is different on the serverside and clientside.](https://github.com/Facepunch/garrysmod-issues/issues/6389
    -- @return --- The player's Unique ID
    UniqueID: function(self): number

    --- Returns a table that will stay allocated for the specific player serverside between connects until the server shuts down. On client it has no such special behavior.
    --- **NOTE**: This table is not synchronized (networked) between client and server.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/gamemode/obj_player_extend.lua#L157-L170)
    -- @param key --- Unique table key.
    -- @return --- The table that contains any info you have put in it.
    UniqueIDTable: function(self, key: any): table

    --- Returns the player's user ID. This number will always be unique, but will reset if the player reconnects. (Always increments for each connecting player)
    --- You can use Global.Player global function to get a player by their user ID.
    -- @return --- The player's user ID
    UserID: function(self): number

    --- Simulates a push on the client's screen. This **adds** view punch velocity, and does not reset the current view punch angle, for which you can use Player:SetViewPunchAngles.
    --- **NOTE**: Despite being defined shared, it only functions when called server-side.
    -- @param punchAngle --- The angle in which to push the player's screen.
    ViewPunch: function(self, punchAngle: GAngle)

    --- Resets the player's view punch (and the view punch velocity, read more at Player:ViewPunch) effect back to normal.
    -- @param tolerance --- Reset all ViewPunch below this threshold.
    ViewPunchReset: function(self, tolerance: number)

    --- Returns the players voice volume, how loud the player's voice communication currently is, as a number in range of [0,1].
    -- @return --- The voice volume.
    VoiceVolume: function(self): number
end


--- Created by util.GetPixelVisibleHandle and used by util.PixelVisible.
global interface Gpixelvis_handle_t

end


--- This is the object returned by Entity:GetPhysicsObject, Entity:GetPhysicsObjectNum and Vehicle:GetWheel.
--- It represents a physics object. An entity can have multiple physics objects (ragdolls), one physics objects (props), or none. (NPCs, non physics entities, etc.)
--- Physics objects are usually simulated by the physics engine and usually dictate the position of the entity, and not the other way around.
global interface GPhysObj
    --- Adds the specified [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) velocity to the current PhysObj.
    -- @param angularVelocity --- The additional velocity in `degrees/s`. (Local to the physics object.)
    --- **NOTE**: Does nothing on frozen objects.
    AddAngleVelocity: function(self, angularVelocity: GVector)

    --- Adds one or more bit flags.
    -- @param flags --- Bitflag, see Enums/FVPHYSICS.
    AddGameFlag: function(self, flags: number)

    --- Adds the specified velocity to the current.
    -- @param velocity --- Additional velocity in `source_unit/s`. (World frame)
    --- **NOTE**: Does nothing on frozen objects.
    AddVelocity: function(self, velocity: GVector)

    --- Rotates the object so that it's angles are aligned to the ones inputted.
    -- @param from ---
    -- @param to ---
    -- @return ---
    AlignAngles: function(self, from: GAngle, to: GAngle): GAngle

    --- Applies the specified impulse in the mass center of the physics object.
    --- **NOTE**: This will not work on players, use Entity:SetVelocity instead.
    -- @param impulse --- The [impulse](https://en.wikipedia.org/wiki/Impulse_(physics)) to be applied in `kg*source_unit/s`. (The vector is in world frame)
    ApplyForceCenter: function(self, impulse: GVector)

    --- Applies the specified impulse on the physics object at the specified position.
    -- @param impulse --- The impulse to be applied in `kg*source_unit/s`. (World frame)
    -- @param position --- The position in world coordinates (`source units`) where the force is applied to the physics object.
    ApplyForceOffset: function(self, impulse: GVector, position: GVector)

    --- Applies the specified angular impulse to the physics object. See PhysObj:CalculateForceOffset
    -- @param angularImpulse --- The angular impulse to be applied in `kg * m^2 * degrees / s`. (The vector is in world frame)
    --- **NOTE**: The unit conversion between meters and source units in this case is `1 meter ≈ 39.37 source units (100/2.54 exactly)`
    ApplyTorqueCenter: function(self, angularImpulse: GVector)

    --- Calculates the linear and angular impulse on the object's center of mass for an offset impulse.
    --- The outputs can be used with PhysObj:ApplyForceCenter and PhysObj:ApplyTorqueCenter, respectively.
    --- **Be careful to convert the angular impulse to world frame (PhysObj:LocalToWorldVector) if you are going to use it with ApplyTorqueCenter.**
    -- @param impulse --- The impulse acting on the object in `kg*source_unit/s`. (World frame)
    -- @param position --- The location of the impulse in world coordinates (`source units`)
    -- @return linearImpulse --- The calculated linear impulse on the physics object's center of mass in `kg*source_unit/s`. (World frame)
    -- @return angularImpulse --- The calculated angular impulse on the physics object's center of mass in `kg*m^2*degrees/s`. (Local frame)
    CalculateForceOffset: function(self, impulse: GVector, position: GVector): GVector, GVector

    --- Calculates the linear and angular velocities on the center of mass for an offset impulse. The outputs can be directly passed to PhysObj:AddVelocity and PhysObj:AddAngleVelocity, respectively.
    --- **WARNING**: This will return zero length vectors if the physics object's motion is disabled. See PhysObj:IsMotionEnabled.
    -- @param impulse --- The impulse acting on the object in `kg*source_unit/s`. (World frame)
    -- @param position --- The location of the impulse in world coordinates (`source units`)
    -- @return --- The calculated linear velocity from the impulse on the physics object's center of mass in `source_unit/s`. (World frame)
    -- @return --- The calculated angular velocity from the impulse on the physics object's center of mass in `degrees/s`. (Local frame)
    CalculateVelocityOffset: function(self, impulse: GVector, position: GVector): GVector, GVector

    --- Removes one of more specified flags.
    -- @param flags --- Bitflag, see Enums/FVPHYSICS.
    ClearGameFlag: function(self, flags: number)

    --- Allows you to move a PhysObj to a point and angle in 3D space. Works with any PhysObj, not just physics shadows.
    -- @param shadowparams --- The parameters for the shadow. See Structures/ShadowControlParams.
    ComputeShadowControl: function(self, shadowparams: table)

    --- Sets whether the physics object should collide with anything or not, including world.
    --- **WARNING**: This function currently has major problems with player collisions, and as such should be avoided at all costs.
    --- A better alternative to this function would be using Entity:SetCollisionGroup( COLLISION_GROUP_WORLD ).
    -- @param enable --- True to enable, false to disable.
    EnableCollisions: function(self, enable: boolean)

    --- Sets whenever the physics object should be affected by drag.
    -- @param enable --- True to enable, false to disable.
    EnableDrag: function(self, enable: boolean)

    --- Sets whether the PhysObject should be affected by gravity
    -- @param enable --- True to enable, false to disable.
    EnableGravity: function(self, enable: boolean)

    --- Sets whether the physobject should be able to move or not.
    --- This is the exact method the Physics Gun uses to freeze props. If a motion-disabled physics object is grabbed with the physics gun, the object will be able to move again. To disallow this, use GM:PhysgunPickup.
    -- @param enable --- True to enable, false to disable.
    EnableMotion: function(self, enable: boolean)

    --- Returns the mins and max of the physics object Axis-Aligned Bounding Box.
    -- @return --- The minimum extents of the bounding box.
    -- @return --- The maximum extents of the bounding box.
    GetAABB: function(self): GVector, GVector

    --- Gets the angular velocity of the object in degrees per second as a local vector. You can use dot product to read the magnitude from a specific axis.
    -- @return --- The angular velocity
    GetAngleVelocity: function(self): GVector

    --- Returns the angles of the physics object in degrees.
    -- @return --- The angles of the physics object.
    GetAngles: function(self): GAngle

    --- Returns the contents flag of the PhysObj.
    -- @return --- The Enums/CONTENTS.
    GetContents: function(self): number

    --- Returns the linear and angular damping of the physics object.
    -- @return --- The linear damping
    -- @return --- The angular damping
    GetDamping: function(self): number, number

    --- Returns the sum of the linear and rotational kinetic energies of the physics object.
    -- @return --- The kinetic energy
    GetEnergy: function(self): number

    --- Returns the parent entity of the physics object.
    -- @return --- The entity this physics object belongs to
    GetEntity: function(self): GEntity

    --- Returns the friction snapshot of this physics object. This is useful for determining if an object touching ground for example.
    -- @return --- A table of tables containing the following data:
    --- * PhysObj Other - The other physics object we came in contact with
    --- * number EnergyAbsorbed -
    --- * number FrictionCoefficient -
    --- * number NormalForce -
    --- * Vector Normal - Direction of the friction event
    --- * Vector ContactPoint - Contact point of the friction event
    --- * number Material - Surface Property ID of our physics obj
    --- * number MaterialOther - Surface Property ID of the physics obj we came in contact with
    GetFrictionSnapshot: function(self): table

    --- Returns the index this physics object is on its PhysObj:GetEntity.
    --- Useful for Entity:TranslateBoneToPhysBone.
    -- @return --- The physics object index on its parent entity.
    GetIndex: function(self): number

    --- Returns the principal moments of inertia `(Ixx, Iyy, Izz)` of the physics object, in the local frame, with respect to the center of mass.
    -- @return angularInertia --- The moment of inertia in `kg * m^2`
    --- **NOTE**: The unit conversion between meters and source units in this case is `1 meter ≈ 39.37 source units (100/2.54 exactly)`
    --- **NOTE**: This value changes proportionally to the physics object's mass (e.g. making the object twice as heavy will result in it having twice the angular inertia)
    GetInertia: function(self): GVector

    --- Returns 1 divided by the angular inertia. See PhysObj:GetInertia
    -- @return invAngularInertia --- The inverted angular inertia
    --- **WARNING**: Returns `[0, 0, 0]` on frozen physics objects.
    GetInvInertia: function(self): GVector

    --- Returns 1 divided by the physics object's mass (in kilograms).
    -- @return --- The inverted mass.
    --- **WARNING**: Returns 0 on frozen physics objects.
    GetInvMass: function(self): number

    --- Returns the mass of the physics object.
    -- @return --- The mass in kilograms.
    GetMass: function(self): number

    --- Returns the center of mass of the physics object as a local vector.
    -- @return --- The center of mass of the physics object.
    GetMassCenter: function(self): GVector

    --- Returns the [physical material](https://developer.valvesoftware.com/wiki/Material_surface_properties) ($surfaceprop) of the physics object.
    --- See util.GetSurfaceData for a function that adds these types as well as further explanation of what they are.
    -- @return --- The physical material name. ($surfaceprop)
    GetMaterial: function(self): string

    --- Returns the physics mesh of the object which is used for physobj-on-physobj collision.
    -- @return --- Table of Structures/MeshVertexs where each three vertices represent a triangle. Returns nil if the physics object is a sphere.
    GetMesh: function(self): table

    --- Returns all convex physics meshes of the object. See Entity:PhysicsInitMultiConvex for more information.
    -- @return --- Table of Structures/MeshVertexs where each Structures/MeshVertex is an independent convex mesh and each three vertices represent a triangle. Returns nil if the physics object is a sphere.
    GetMeshConvexes: function(self): table

    --- Returns the name of the physics object.
    -- @return --- The name of the physics object.
    GetName: function(self): string

    --- Returns the position of the physics object.
    -- @return --- The position in world coordinates. (`source units`)
    GetPos: function(self): GVector

    --- Returns the position and angle of the physics object as a 3x4 matrix (VMatrix is 4x4 so the fourth row goes unused). The first three columns store the angle as a [rotation matrix](https://en.wikipedia.org/wiki/Rotation_matrix), and the fourth column stores the position vector.
    -- @return --- The position and angle matrix.
    GetPositionMatrix: function(self): GVMatrix

    --- Returns the rotation damping of the physics object.
    -- @return --- The rotation damping
    GetRotDamping: function(self): number

    --- Returns the angles of the PhysObj shadow. See PhysObj:UpdateShadow.
    -- @return --- The angles of the PhysObj shadow.
    GetShadowAngles: function(self): GAngle

    --- Returns the position of the PhysObj shadow. See PhysObj:UpdateShadow.
    -- @return --- The position of the PhysObj shadow.
    GetShadowPos: function(self): GVector

    --- Returns the speed damping of the physics object.
    -- @return --- speedDamping
    GetSpeedDamping: function(self): number

    --- Returns the internal and external stress of the entity.
    -- @return --- The external stress (`𝜎𝑒`). It's the value of a giving force to other entities (in kg).
    -- @return --- The internal stress (`𝜎𝑖`). It's the value of a receiving force from other entities (in kg).
    GetStress: function(self): number, number

    --- Returns the surface area of the physics object in source-units². Or nil if the PhysObj is a generated sphere or box.
    -- @return --- The surface area or `nil` if the PhysObj is a generated sphere or box.
    GetSurfaceArea: function(self): number|nil

    --- Returns the absolute directional velocity of the physobject.
    -- @return --- velocity
    GetVelocity: function(self): GVector

    --- Returns the world velocity of a point in world coordinates about the object. This is useful for objects rotating around their own axis/origin.
    -- @param point --- A point to test in world space coordinates
    -- @return velocity --- Velocity at the given point
    GetVelocityAtPoint: function(self, point: GVector): GVector

    --- Returns the volume in source units³. Or nil if the PhysObj is a generated sphere or box.
    -- @return --- The volume or `nil` if the PhysObj is a generated sphere or box.
    GetVolume: function(self): number|nil

    --- Returns whenever the specified flag(s) is/are set.
    -- @param flags --- Bitflag, see Enums/FVPHYSICS.
    -- @return --- If flag was set or not
    HasGameFlag: function(self, flags: number): boolean

    --- Returns whether the physics object is "sleeping".
    --- See PhysObj:Sleep for more information.
    -- @return --- Whether the physics object is sleeping.
    IsAsleep: function(self): boolean

    --- Returns whenever the entity is able to collide or not.
    -- @return --- isCollisionEnabled
    IsCollisionEnabled: function(self): boolean

    --- Returns whenever the entity is affected by drag.
    -- @return --- dragEnabled
    IsDragEnabled: function(self): boolean

    --- Returns whenever the entity is affected by gravity.
    -- @return --- `true` if the gravity is enabled, `false` otherwise
    IsGravityEnabled: function(self): boolean

    --- Returns if the physics object can move itself (by velocity, acceleration)
    -- @return --- `true` if the motion is enabled, `false` otherwise.
    IsMotionEnabled: function(self): boolean

    --- Returns whenever the entity is able to move.
    -- @return --- movable
    IsMoveable: function(self): boolean

    --- Returns whenever the physics object is penetrating another physics object.
    --- This is internally implemented as `PhysObj:HasGameFlag( FVPHYSICS_PENETRATING )` and thus is only updated for non-static physics objects.
    -- @return --- Whether the physics object is penetrating another object.
    IsPenetrating: function(self): boolean

    --- Returns if the physics object is valid/not NULL.
    -- @return --- Whether the physics object is valid or not.
    IsValid: function(self): boolean

    --- Translates a vector in the physics object's local space into worldspace coordinates.
    --- **NOTE**: Internally transforms the vector by the PhysObj:GetPositionMatrix.
    --- So in GLua it approximates to:
    --- ```
    --- local matrixWorldTransform = PhysObj:GetPositionMatrix()
    --- local vecWorldspaced = Vector()
    --- vecWorldspaced:Set( vecLocal )
    --- vecWorldspaced:Mul( matrixWorldTransform )
    --- return vecWorldspaced
    --- ```
    -- @param vecLocal --- A vector in the physics object's local space.
    -- @return --- The corresponding worldspace vector.
    LocalToWorld: function(self, vecLocal: GVector): GVector

    --- Rotationally transforms a vector in the physics object's local space by the PhysObj:GetPositionMatrix.
    --- **NOTE**: In contrast to PhysObj:LocalToWorld, this function doesn't translate the vector.
    -- @param vecLocal --- A vector in the physics object's local space.
    -- @return --- The resulting vector from the rotational transformation.
    LocalToWorldVector: function(self, vecLocal: GVector): GVector

    --- Prints debug info about the state of the physics object to the console.
    OutputDebugInfo: function(self)

    --- Call this when the collision filter conditions change due to this object's state (e.g. changing solid type or collision group)
    RecheckCollisionFilter: function(self)

    --- A convinience function for Angle:RotateAroundAxis.
    -- @param dir --- Direction, around which we will rotate
    -- @param ang --- Amount of rotation, in degrees
    -- @return --- The resulting angle
    RotateAroundAxis: function(self, dir: GVector, ang: number): GAngle

    --- Sets the amount of [drag](https://en.wikipedia.org/wiki/Drag_(physics)) to apply to a physics object when attempting to rotate.
    -- @param coefficient --- [Drag coefficient](https://en.wikipedia.org/wiki/Drag_coefficient). The bigger this value is, the slower the angles will change.
    SetAngleDragCoefficient: function(self, coefficient: number)

    --- Sets the specified [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) on the PhysObj
    -- @param angularVelocity --- The new velocity in `degrees/s`. (Local frame)
    SetAngleVelocity: function(self, angularVelocity: GVector)

    --- Sets the specified instantaneous [angular velocity](https://en.wikipedia.org/wiki/Angular_velocity) on the PhysObj
    -- @param angularVelocity --- The new velocity to set velocity.
    SetAngleVelocityInstantaneous: function(self, angularVelocity: GVector)

    --- Sets the angles of the physobject in degrees.
    -- @param angles --- The new angles of the physobject.
    --- **WARNING**: The new angle will not be applied on the parent entity while the physics object is asleep (PhysObj:Sleep)
    SetAngles: function(self, angles: GAngle)

    --- Sets the buoyancy ratio of the physics object. (How well it floats in water)
    -- @param buoyancy --- Buoyancy ratio, where 0 is not buoyant at all (like a rock), and 1 is very buoyant (like wood). You can set values larger than 1 for greater effect.
    SetBuoyancyRatio: function(self, buoyancy: number)

    --- Sets the contents flag of the PhysObj.
    -- @param contents --- The Enums/CONTENTS.
    SetContents: function(self, contents: E_CONTENTS)

    --- Sets the linear and angular damping of the physics object.
    -- @param linearDamping --- Linear damping.
    -- @param angularDamping --- Angular damping.
    SetDamping: function(self, linearDamping: number, angularDamping: number)

    --- Modifies how much drag (air resistance) affects the object.
    -- @param drag --- The drag coefficient
    --- It can be positive or negative.
    SetDragCoefficient: function(self, drag: number)

    --- Sets the angular inertia. See PhysObj:GetInertia.
    --- **NOTE**: This does not affect linear inertia.
    -- @param angularInertia --- The angular inertia of the object.
    SetInertia: function(self, angularInertia: GVector)

    --- Sets the mass of the physics object.
    --- **WARNING**: This resets PhysObj:SetBuoyancyRatio (Recalculated based materials' and the physics objects' densities, latter of which is dependent on mass).
    --- If you used a custom ratio, you will have to re-set it again after `SetMass`.
    -- @param mass --- The mass in kilograms, in range `[0, 50000]`
    SetMass: function(self, mass: number)

    --- Sets the material of the physobject.
    --- **NOTE**: Impact sounds will only change if this is called on client
    -- @param materialName --- The name of the phys material to use. From this list: [Valve Developer](https://developer.valvesoftware.com/wiki/Material_surface_properties)
    SetMaterial: function(self, materialName: string)

    --- Sets the position of the physobject.
    -- @param position --- The new position of the physobject in world coordinates. (`source units`).
    --- **WARNING**: The new position will not be applied on the parent entity while the physics object is asleep (PhysObj:Sleep)
    -- @param teleport --- If `true`, temporarily disables collisions of the physics objects just before moving it, then enables collisions back again.
    SetPos: function(self, position: GVector, teleport: boolean)

    --- Sets the velocity of the physics object for the next iteration.
    -- @param velocity --- The new velocity of the physics object in `source_unit/s`. (World frame)
    SetVelocity: function(self, velocity: GVector)

    --- Sets the velocity of the physics object.
    -- @param velocity --- The new velocity of the physics object.
    SetVelocityInstantaneous: function(self, velocity: GVector)

    --- Makes the physics object "sleep". The physics object will no longer be moving unless it is "woken up" by either a collision with another moving object, or by PhysObj:Wake.
    --- This is an optimization feature of the physics engine. Normally physics objects will automatically "sleep" when not moving for a short while, to save resources, but it can be used for other purposes, for example to temporarily suspend an object mid air.
    Sleep: function(self)

    --- Unlike PhysObj:SetPos and PhysObj:SetAngles, this allows the movement of a physobj while leaving physics interactions intact.
    --- This is used internally by the motion controller of the Gravity Gun , the +use pickup and the Physics Gun, and entities such as the crane.
    --- **NOTE**: This is the ideal function to move a physics shadow created with Entity:PhysicsInitShadow or Entity:MakePhysicsObjectAShadow.
    -- @param targetPosition --- The position we should move to.
    -- @param targetAngles --- The angle we should rotate towards.
    -- @param frameTime --- The frame time to use for this movement, can be generally filled with Global.FrameTime or ENTITY:PhysicsSimulate with the deltaTime.
    --- Can be set to 0 when you need to update the physics object just once.
    UpdateShadow: function(self, targetPosition: GVector, targetAngles: GAngle, frameTime: number)

    --- Wakes the physics object, so that it will continue to simulate physics/gravity.
    --- See PhysObj:Sleep for more information.
    Wake: function(self)

    --- Translates a worldspace vector into the physics object's local space.
    -- @param vec --- A worldspace vector.
    -- @return --- The corresponding local space vector.
    WorldToLocal: function(self, vec: GVector): GVector

    --- Rotationally transforms a worldspace vector into the physics object's local space by the inverted PhysObj:GetPositionMatrix.
    --- For example, in GMod this is used in thrusters, for working out linear force for local acceleration.
    --- **NOTE**: In contrast to PhysObj:WorldToLocal, this function doesn't translate the vector.
    -- @param vec --- A worldspace vector.
    -- @return --- The resulting vector from the rotational transformation.
    WorldToLocalVector: function(self, vec: GVector): GVector
end


--- A PhysCollide holds collision data from VPhysics. These objects can be used to run (currently quite limited) collision tests, but do not represent actual physics objects.
--- Created by Global.CreatePhysCollideBox or Global.CreatePhysCollidesFromModel.
global interface GPhysCollide
    --- Destroys the PhysCollide object.
    Destroy: function(self)

    --- Checks whether this PhysCollide object is valid or not.
    --- You should just use Global.IsValid instead.
    -- @return --- Is valid or not.
    IsValid: function(self): boolean

    --- Performs a trace against this PhysCollide with the given parameters. This can be used for both line traces and box traces.
    -- @param origin --- The origin for the PhysCollide during the trace
    -- @param angles --- The angles for the PhysCollide during the trace
    -- @param rayStart --- The start position of the trace
    -- @param rayEnd --- The end position of the trace
    -- @param rayMins --- The mins of the trace's bounds
    -- @param rayMaxs --- The maxs of the trace's bounds
    -- @return --- Hit position of the trace. This is false if the trace did not hit.
    -- @return --- Hit normal of the trace
    -- @return --- Fraction of the trace. This is calculated from the distance between startPos, hitPos, and endPos.
    TraceBox: function(self, origin: GVector, angles: GAngle, rayStart: GVector, rayEnd: GVector, rayMins: GVector, rayMaxs: GVector): GVector, GVector, number
end


--- Path object for a NextBot NPC and bots created by player.CreateNextbot. Returned by Global.Path.
global interface GPathFollower
    --- Computes the shortest path to the provided entity arg. PathFollower Object must have `Chase` type.
    --- For PathFollower objects of the `Follow` type use PathFollower:Compute
    -- @param bot --- The bot to update along the path. This can also be a nextbot player (player.CreateNextbot)
    -- @param ent --- The entity we want to chase
    -- @param generator --- A function that allows you to alter the path generation. See example on PathFollower:Compute for the default function.
    --- <callback>
    --- <arg name="area" type="CNavArea">The area to move to.</arg>
    --- <arg name="fromArea" type="CNavArea">The area to move from.</arg>
    --- <arg name="ladder" type="CNavLadder">The ladder to move to or from (Validation required), if any.</arg>
    --- <arg name="elevator" type="Entity">Will probably be always NULL</arg>
    --- <arg name="length" type="number">Precomputed length between `area` and `fromArea`.</arg>
    --- <ret name="cost" type="number">The cost of movement between `area` and `fromArea`.</ret>
    --- </callback>
    Chase: function(self, bot: GNextBot, ent: GEntity, generator: function)

    --- Compute shortest path from bot to 'goal' via A* algorithm. This only works if the PathFollower is the `Follow` Type.
    --- For PathFollowers of the `Chase` Type see PathFollower:Chase
    -- @param bot --- The nextbot we're generating for.  This can also be a nextbot player (player.CreateNextbot).
    -- @param goal --- The target location, the goal.
    -- @param generator --- A function that allows you to alter the path generation by adjusting the "cost". See example below for the default function.
    --- <callback>
    --- <arg name="area" type="CNavArea">The area to move to.</arg>
    --- <arg name="fromArea" type="CNavArea">The area to move from.</arg>
    --- <arg name="ladder" type="CNavLadder">The ladder to move to or from (Validation required), if any.</arg>
    --- <arg name="elevator" type="Entity">Will probably be always NULL</arg>
    --- <arg name="length" type="number">Precomputed length between `area` and `fromArea`.</arg>
    --- <ret name="cost" type="number">The cost of movement between `area` and `fromArea`.</ret>
    --- </callback>
    -- @return --- * If returns true, path was found to the goal position.
    --- * If returns false, path may either be invalid (use IsValid() to check), or valid but doesn't reach all the way to the goal.
    Compute: function(self, bot: GNextBot, goal: GVector, generator: function): boolean

    --- Draws the path. This is meant for debugging - and uses debugoverlay.
    Draw: function(self)

    --- Returns the first segment of the path.
    -- @return --- A table with Structures/PathSegment.
    FirstSegment: function(self): table

    --- Returns the age since the path was built
    -- @return --- Path age
    GetAge: function(self): number

    --- Returns all of the segments of the given path.
    -- @return --- A table of tables with Structures/PathSegment.
    GetAllSegments: function(self): S_PathSegment

    --- The closest position along the path to a position
    -- @param position --- The point we're querying for
    -- @return --- The closest position on the path
    GetClosestPosition: function(self, position: GVector): GVector

    --- Returns the current goal data. Can return nil if the current goal is invalid, for example immediately after PathFollower:Update.
    -- @return --- A table with Structures/PathSegment.
    GetCurrentGoal: function(self): table

    --- Returns the cursor data
    -- @return --- A table with 3 keys:
    --- number curvature
    --- Vector forward
    --- Vector pos
    GetCursorData: function(self): table

    --- Returns the current progress along the path
    -- @return --- The current progress
    GetCursorPosition: function(self): number

    --- Returns the path end position
    -- @return --- The end position
    GetEnd: function(self): GVector

    --- Returns how close we can get to the goal to call it done.
    -- @return --- The distance we're setting it to
    GetGoalTolerance: function(self): number

    ---
    -- @return ---
    GetHindrance: function(self): GEntity

    --- Returns the total length of the path
    -- @return --- The length of the path
    GetLength: function(self): number

    --- Returns the minimum range movement goal must be along path.
    -- @return --- The minimum look ahead distance
    GetMinLookAheadDistance: function(self): number

    --- Returns the vector position of distance along path
    -- @param distance --- The distance along the path to query
    -- @return --- The position
    GetPositionOnPath: function(self, distance: number): GVector

    --- Returns the path start position
    -- @return --- The start position
    GetStart: function(self): GVector

    --- Invalidates the current path
    Invalidate: function(self)

    --- Returns true if the path is valid
    -- @return --- Wether the path is valid or not.
    IsValid: function(self): boolean

    --- Returns the last segment of the path.
    -- @return --- A table with Structures/PathSegment.
    LastSegment: function(self): table

    --- Moves the cursor by give distance.
    --- For a function that sets the distance, see PathFollower:MoveCursorTo.
    -- @param distance --- The distance to move the cursor (in relative world units)
    MoveCursor: function(self, distance: number)

    --- Sets the cursor position to given distance.
    --- For relative distance, see PathFollower:MoveCursor.
    -- @param distance --- The distance to move the cursor (in world units)
    MoveCursorTo: function(self, distance: number)

    --- Moves the cursor of the path to the closest position compared to given vector.
    -- @param pos ---
    -- @param type --- Seek type
    --- 0 = SEEK_ENTIRE_PATH - Search the entire path length
    --- 1 = SEEK_AHEAD - Search from current cursor position forward toward end of path
    --- 2 = SEEK_BEHIND - Search from current cursor position backward toward path start
    -- @param alongLimit ---
    MoveCursorToClosestPosition: function(self, pos: GVector, type: number, alongLimit: number)

    --- Moves the cursor to the end of the path
    MoveCursorToEnd: function(self)

    --- Moves the cursor to the end of the path
    MoveCursorToStart: function(self)

    --- Returns the next segment of the path.
    -- @return --- A table with Structures/PathSegment.
    NextSegment: function(self): table

    --- Returns the previous segment of the path.
    -- @return --- A table with Structures/PathSegment.
    PriorSegment: function(self): table

    --- Resets the age which is retrieved by PathFollower:GetAge to 0.
    ResetAge: function(self)

    --- How close we can get to the goal to call it done
    -- @param distance --- The distance we're setting it to
    SetGoalTolerance: function(self, distance: number)

    --- Sets minimum range movement goal must be along path
    -- @param mindist --- The minimum look ahead distance
    SetMinLookAheadDistance: function(self, mindist: number)

    --- Move the bot along the path.
    --- **NOTE**: player nextbots require CUserCmd:SetForwardMove to move forward along the path
    -- @param bot --- The bot to update along the path. This can also be a nextbot player (player.CreateNextbot)
    Update: function(self, bot: GNextBot)
end


--- This is the base panel for every other [VGUI](vgui) panel.
--- It contains all of the basic methods, some of which may only work on certain VGUI elements. See also Panel Hooks.
--- As their functionality is provided at the game's C/C++ level rather than by its Lua script extension, they are unfortunately unavailable for most practical purposes, however, they can still be obtained in a way similar to that provided by the baseclass library:
--- ```
--- -- Create a new panel type NewPanel that inherits all of its functionality from DLabel,
--- -- but has a different SetText method than DLabel does - all without the hassle of that
--- -- old DLabel's default text getting in the way. Fun stuff.
--- local PANEL = {}
--- function PANEL:Init()
--- self:SetText_Base( "" )
--- self:SetText( "Time for something different!" )
--- end
--- function PANEL:Paint( aWide, aTall )
--- local TextX, TextY = 0, 0
--- local TextColor = Color( 255, 0, 0, 255 )
--- surface.SetFont( self:GetFont() or "default" )
--- surface.SetTextColor( TextColor )
--- surface.SetTextPos( TextX, TextY )
--- surface.DrawText( self:GetText() )
--- end
--- -- And here we go:
--- PANEL.SetText_Base = FindMetaTable( "Panel" ).SetText
--- function PANEL:SetText( aText )
--- self.Text = tostring( aText )
--- end
--- function PANEL:GetText()
--- return self.Text or ""
--- end
--- vgui.Register( "NewPanel", PANEL, "DLabel" )
--- ```
global interface GPanel
    --- When provided with a string or table, this function will create a new vgui element with that name and set the parent to the panel that this method is called on. When provided with a panel it will use Panel:SetParent on the provided panel to set it to our source panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L506-L521)
    -- @param object --- The panel to be added (parented).
    -- @return --- New panel
    Add: function(self, object: GPanel): GPanel

    --- When provided with a string or table, this function will create a new vgui element with that name and set the parent to the panel that this method is called on. When provided with a panel it will use Panel:SetParent on the provided panel to set it to our source panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L506-L521)
    -- @param class --- The class to be added.
    -- @return --- New panel
    Add: function(self, class: string): GPanel

    --- When provided with a string or table, this function will create a new vgui element with that name and set the parent to the panel that this method is called on. When provided with a panel it will use Panel:SetParent on the provided panel to set it to our source panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L506-L521)
    -- @param table --- The table to create the panel from.
    -- @return --- New panel
    Add: function(self, table: table): GPanel

    --- @deprecated
    --- **DEPRECATED**: Does nothing
    --- This function does nothing.
    AddText: function(self)

    --- Aligns the panel on the bottom of its parent with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L129-L129)
    -- @param offset --- The align offset.
    AlignBottom: function(self, offset: number)

    --- Aligns the panel on the left of its parent with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L132-L132)
    -- @param offset --- The align offset.
    AlignLeft: function(self, offset: number)

    --- Aligns the panel on the right of its parent with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L130-L130)
    -- @param offset --- The align offset.
    AlignRight: function(self, offset: number)

    --- Aligns the panel on the top of its parent with the specified offset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L131-L131)
    -- @param offset --- The align offset.
    AlignTop: function(self, offset: number)

    --- Uses animation to transition the current alpha value of a panel to a new alpha, over a set period of time and after a specified delay.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L263-L269)
    -- @param alpha --- The alpha value (0-255) to approach.
    -- @param duration --- The time in seconds it should take to reach the alpha.
    -- @param delay --- The delay before the animation starts.
    -- @param callback --- The function to be called once the animation finishes.
    --- <callback>
    --- <arg type="table" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    AlphaTo: function(self, alpha: number, duration: number, delay: number, callback: function)

    --- Returns the Global.SysTime value when all animations for this panel object will end.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L90-L100)
    -- @return --- The system time value when all animations will end for this panel.
    AnimTail: function(self): number

    --- **INTERNAL**:
    ---  Performs the per-frame operations required for panel animations.
    --- This is called every frame by PANEL:AnimationThink.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L20-L59)
    AnimationThinkInternal: function(self)

    --- Appends text to a RichText element. This does not automatically add a new line.
    -- @param txt --- The text to append (add on).
    AppendText: function(self, txt: string)

    --- Appends text to a RichText element (exactly like Panel:AppendText), while also parsing and adding valid URLs (Panel:InsertClickableTextStart). This does not automatically add a new line.
    -- @param txt --- The text to append (add on).
    AppendTextWithURLs: function(self, txt: string)

    --- Used by Panel:LoadGWENFile and Panel:LoadGWENString to apply a GWEN controls table to a panel object.
    --- You can do this manually using file.Read and util.JSONToTable to import and create a GWEN table structure from a `.gwen` file. This method can then be called, passing the GWEN table's `Controls` member.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L166-L196)
    -- @param GWENTable --- The GWEN controls table to apply to the panel.
    ApplyGWEN: function(self, GWENTable: table)

    --- Centers the panel on its parent.
    --- **NOTE**: This will center the panel using the current size of the panel so should be called AFTER setting or adjusting the size of the 	panel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L165-L170)
    Center: function(self)

    --- Centers the panel horizontally with specified fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L158-L160)
    -- @param fraction --- The center fraction.
    CenterHorizontal: function(self, fraction: number)

    --- Centers the panel vertically with specified fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L151-L153)
    -- @param fraction --- The center fraction.
    CenterVertical: function(self, fraction: number)

    --- Returns the amount of children of the of panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dmenu.lua#L145-L147)
    -- @return --- The amount of children the panel has.
    ChildCount: function(self): number

    --- Returns the width and height of the space between the position of the panel (upper-left corner) and the max bound of the children panels (farthest reaching lower-right corner).
    -- @return --- The children size width.
    -- @return --- The children size height.
    ChildrenSize: function(self): number, number

    --- Removes all of the panel's children. Many panels also override this method to gracefully clear their contents without breaking themselves.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L590-L596)
    Clear: function(self)

    --- Fades panels color to specified one.
    --- **NOTE**: The panel must have `GetColor` and `SetColor` functions for `ColorTo` to work.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L240-L250)
    -- @param color --- The color to fade to
    -- @param length --- Length of the animation
    -- @param delay --- Delay before start fading
    -- @param callback --- Function to execute when finished
    --- <callback>
    --- <arg type="table{AnimationData}" name="animData">The Structures/AnimationData that was used.</arg>
    --- <arg type="Panel" name="targetPanel">The panel object that was animated.</arg>
    --- </callback>
    ColorTo: function(self, color: GColor, length: number, delay: number, callback: function)

    --- Updates a panel object's associated console variable. This must first be set up with Global.Derma_Install_Convar_Functions, and have a ConVar set using Panel:SetConVar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/init.lua#L86-L91)
    -- @param newValue --- The new value to set the associated console variable to.
    ConVarChanged: function(self, newValue: string)

    --- A think hook for Panels using ConVars as a value. Call it in the Think hook. Sets the panel's value should the convar change.
    --- This function is best for: checkboxes, sliders, number wangs
    --- For a string alternative, see Panel:ConVarStringThink.
    --- **NOTE**: Make sure your Panel has a SetValue function, else you may get errors.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/init.lua#L106-L119)
    ConVarNumberThink: function(self)

    --- A think hook for panels using ConVars as a value. Call it in the Think hook. Sets the panel's value should the convar change.
    --- This function is best for: text inputs, read-only inputs, dropdown selects
    --- For a number alternative, see Panel:ConVarNumberThink.
    --- **NOTE**: Make sure your Panel has a SetValue function, else you may get errors.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/init.lua#L94-L104)
    ConVarStringThink: function(self)

    --- Gets the size, position and dock state of the passed panel object, and applies it to this one.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L497-L504)
    -- @param srcPanel --- The panel to copy the boundary and dock settings from.
    CopyBase: function(self, srcPanel: GPanel)

    --- Copies position and size of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L175-L182)
    -- @param base --- The panel to copy size and position from.
    CopyBounds: function(self, base: GPanel)

    --- Copies the height of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L108-L110)
    -- @param base --- Panel to copy the height from.
    CopyHeight: function(self, base: GPanel)

    --- Copies the position of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L122-L124)
    -- @param base --- Panel to position the width from.
    CopyPos: function(self, base: GPanel)

    --- Performs the `` + `` key combination effect ( Copy selection to clipboard ) on selected text in a TextEntry or RichText based element.
    CopySelected: function(self)

    --- Copies the width of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L115-L117)
    -- @param base --- Panel to copy the width from.
    CopyWidth: function(self, base: GPanel)

    --- Returns the cursor position relative to the top left of the panel.
    --- This is equivalent to calling gui.MousePos and then Panel:ScreenToLocal.
    --- **WARNING**: This function uses a cached value for the screen position of the panel, computed at the end of the last VGUI Think/Layout pass.
    --- ie. inaccurate results may be returned if the panel or any of its ancestors have been repositioned outside of PANEL:Think or PANEL:PerformLayout within the last frame.
    -- @return --- X coordinate of the cursor, relative to the top left of the panel.
    -- @return --- Y coordinate of the cursor, relative to the top left of the panel.
    CursorPos: function(self): number, number

    --- Performs the `` + `` (delete text and copy it to clipboard buffer) action on selected text in a TextEntry or RichText based element.
    CutSelected: function(self)

    --- Deletes a cookie value using the panel's cookie name ( Panel:GetCookieName ) and the passed extension.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L238-L245)
    -- @param cookieName --- The unique cookie name to delete.
    DeleteCookie: function(self, cookieName: string)

    --- Resets the panel object's Panel:SetPos method and removes its animation table (`Panel.LerpAnim`). This effectively undoes the changes made by Panel:LerpPositions.
    --- In order to use Lerp animation again, you must call Panel:Stop before setting its `SetPosReal` property to `nil`. See the example below.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/animation.lua#L359-L365)
    DisableLerp: function(self)

    --- Returns the linear distance from the center of this panel object and another. **Both panels must have the same parent for this function to work properly.**
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L422-L428)
    -- @param tgtPanel --- The target object with which to compare position.
    -- @return --- The linear (straight-line) distance between the center of the two objects.
    Distance: function(self, tgtPanel: GPanel): number

    --- Returns the distance between the center of this panel object and a specified point **local to the parent panel**.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L430-L437)
    -- @param posX --- The horizontal (x) position in pixels of the point to compare with. Local to the parent panel, or container, not the panel the function is called on.
    -- @param posY --- The vertical (y) position in pixels of the point to compare with. Local to the parent panel, or container, not the panel the function is called on.
    -- @return --- The linear (straight-line) distance between the specified point local to parent panel and the center of this panel object.
    DistanceFrom: function(self, posX: number, posY: number): number

    --- Makes the panel "lock" the screen until it is removed. All input will be directed to the given panel.
    --- It will silently fail if used while cursor is not visible.
    --- Call Panel:MakePopup before calling this function.
    --- This must be called on a panel derived from EditablePanel.
    DoModal: function(self)

    --- Sets the dock type for the panel, making the panel "dock" in a certain direction, modifying it's position and size.
    --- You can set the inner spacing of a panel's docking using Panel:DockPadding, which will affect docked child panels, and you can set the outer spacing of a panel's docking using Panel:DockMargin, which affects how docked siblings are positioned/sized.
    --- You may need to use Panel:SetZPos to ensure child panels (DTextEntry) stay in a specific order.
    --- **NOTE**: After using this function, if you want to get the correct panel's bounds (position, size), use Panel:InvalidateParent (use `true` as argument if you need to update immediately)
    -- @param dockType --- Dock type using Enums/DOCK.
    Dock: function(self, dockType: E_DOCK)

    --- Sets the dock margin of the panel.
    --- The dock margin is the extra space that will be left around the edge when this element is docked inside its parent element.
    -- @param marginLeft --- The left margin to the parent.
    -- @param marginTop --- The top margin to the parent.
    -- @param marginRight --- The right margin to the parent.
    -- @param marginBottom --- The bottom margin to the parent.
    DockMargin: function(self, marginLeft: number, marginTop: number, marginRight: number, marginBottom: number)

    --- Sets the dock padding of the panel.
    --- The dock padding is the extra space that will be left around the edge when child elements are docked inside this element.
    -- @param paddingLeft --- The left padding to the parent.
    -- @param paddingTop --- The top padding to the parent.
    -- @param paddingRight --- The right padding to the parent.
    -- @param paddingBottom --- The bottom padding to the parent.
    DockPadding: function(self, paddingLeft: number, paddingTop: number, paddingRight: number, paddingBottom: number)

    --- **INTERNAL**:
    ---  Called by Panel:DragMouseRelease when a user clicks one mouse button whilst dragging with another.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L431-L438)
    -- @return --- Always returns `true`.
    DragClick: function(self): boolean

    --- **INTERNAL**:
    ---  Called by dragndrop.HoverThink to perform actions on an object that is dragged and hovered over another.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L499-L512)
    -- @param HoverTime --- If this time is greater than 0.1, PANEL:DragHoverClick is called, passing it as an argument.
    DragHover: function(self, HoverTime: number)

    --- **INTERNAL**:
    ---  Called to end a drag and hover action. This resets the panel's PANEL:PaintOver method, and is primarily used by dragndrop.StopDragging.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L531-L538)
    DragHoverEnd: function(self)

    --- Called to inform the dragndrop that a mouse button is being held down on a panel object.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L412-L429)
    -- @param mouseCode --- The code for the mouse button pressed, passed by, for example, PANEL:OnMousePressed. See the Enums/MOUSE.
    DragMousePress: function(self, mouseCode: number)

    --- Called to inform the dragndrop that a mouse button has been depressed on a panel object.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L440-L466)
    -- @param mouseCode --- The code for the mouse button pressed, passed by, for example, PANEL:OnMouseReleased. See the Enums/MOUSE.
    -- @return --- `true` if an object was being dragged, otherwise `false`.
    DragMouseRelease: function(self, mouseCode: number): boolean

    --- **INTERNAL**:
    ---  Called to draw the drop target when an object is being dragged across another. See Panel:SetDropTarget.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L514-L529)
    -- @param x --- The x coordinate of the top-left corner of the drop area.
    -- @param y --- The y coordinate of the top-left corner of the drop area.
    -- @param width --- The width of the drop area.
    -- @param height --- The height of the drop area.
    DrawDragHover: function(self, x: number, y: number, width: number, height: number)

    --- Draws a coloured rectangle to fill the panel object this method is called on. The colour is set using surface.SetDrawColor. This should only be called within the object's PANEL:Paint or PANEL:PaintOver hooks, as a shortcut for surface.DrawRect.
    --- **NOTE**: Provides a 2D rendering context
    DrawFilledRect: function(self)

    --- Draws a hollow rectangle the size of the panel object this method is called on, with a border width of 1 px. The border colour is set using surface.SetDrawColor. This should only be called within the object's PANEL:Paint or PANEL:PaintOver hooks, as a shortcut for surface.DrawOutlinedRect.
    --- **NOTE**: Provides a 2D rendering context
    DrawOutlinedRect: function(self)

    --- Used to draw the magenta highlight colour of a panel object when it is selected. This should be called in the object's PANEL:PaintOver hook. Once this is implemented, the highlight colour will be displayed only when the object is selectable and selected. This is achieved using Panel:SetSelectable and Panel:SetSelected respectively.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L91-L101)
    DrawSelections: function(self)

    --- Used to draw the text in a DTextEntry within a derma skin. This is usually called within the SKIN:PaintTextEntry skin hook.
    --- **NOTE**: Will silently fail if any of arguments are not given.
    --- **NOTE**: Provides a 2D rendering context
    -- @param textCol --- The colour of the main text.
    -- @param highlightCol --- The colour of the selection highlight (when selecting text).
    -- @param cursorCol --- The colour of the text cursor (or caret).
    DrawTextEntryText: function(self, textCol: table, highlightCol: table, cursorCol: table)

    --- Draws a textured rectangle to fill the panel object this method is called on. The texture is set using surface.SetTexture or surface.SetMaterial. This should only be called within the object's PANEL:Paint or PANEL:PaintOver hooks, as a shortcut for surface.DrawTexturedRect.
    --- **NOTE**: Provides a 2D rendering context
    DrawTexturedRect: function(self)

    --- Makes this panel droppable. This is used with Panel:Receiver to create drag and drop events.
    --- Can be called multiple times with different names allowing to be dropped onto different receivers.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L302-L310)
    -- @param name --- Name of your droppable panel
    -- @return --- Blank table stored on the panel itself under pnl.m_DragSlot[ name ]. Is reset every time this function is called and does not appear to be used or exposed anywhere else.
    Droppable: function(self, name: string): table

    --- Completes a box selection. If the end point of the selection box is within the selection canvas, mouse capture is disabled for the panel object, and the selected state of each child object within the selection box is toggled.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L223-L249)
    -- @return --- Whether the end point of the selection box was within the selection canvas.
    EndBoxSelection: function(self): boolean

    --- **INTERNAL**:
    ---  Used to run commands within a DHTML window.
    -- @param cmd --- The command to be run.
    Exec: function(self, cmd: string)

    --- Finds a panel in its children(and sub children) with the given name.
    -- @param panelName --- The name of the panel that should be found.
    -- @return --- foundPanel
    Find: function(self, panelName: string): GPanel

    --- Focuses the next panel in the focus queue.
    FocusNext: function(self)

    --- Focuses the previous panel in the focus queue.
    FocusPrevious: function(self)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `CheckboxText` property to a DCheckBoxLabel. This does exactly the same as Panel:GWEN_SetText, but exists to cater for the seperate GWEN properties.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L222)
    -- @param txt --- The text to be applied to the DCheckBoxLabel.
    GWEN_SetCheckboxText: function(self, txt: string)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `ControlName` property to a panel. This calls Panel:SetName.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L204)
    -- @param name --- The new name to apply to the panel.
    GWEN_SetControlName: function(self, name: string)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Dock` property to a  panel object. This calls Panel:Dock.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L214-L220)
    -- @param dockState --- The dock mode to pass to the panel's `Dock` method. This reads a string and applies the approriate Enums/DOCK.
    --- * `Right`: Dock right.
    --- * `Left`: Dock left.
    --- * `Bottom`: Dock at the bottom.
    --- * `Top`: Dock at the top.
    --- * `Fill`: Fill the parent panel.
    GWEN_SetDock: function(self, dockState: string)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `HorizontalAlign` property to a  panel object. This calls Panel:SetContentAlignment.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L208-L212)
    -- @param hAlign --- The alignment, as a string, to pass to Panel:SetContentAlignment. Accepts:
    --- * `Right`: Align mid-right.
    --- * `Left`: Align mid-left.
    --- * `Center`: Align mid-center.
    GWEN_SetHorizontalAlign: function(self, hAlign: string)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Margin` property to a  panel object. This calls Panel:DockMargin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L205)
    -- @param margins --- A four-membered table containing the margins as numbers:
    --- * number left - The left margin.
    --- * number top - The top margin.
    --- * number right - The right margin.
    --- * number bottom - The bottom margin.
    GWEN_SetMargin: function(self, margins: table)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Max` property to a  DNumberWang, Slider, DNumSlider or DNumberScratch. This calls `SetMax` on one of the previously listed methods.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L207)
    -- @param maxValue --- The maximum value the element is to permit.
    GWEN_SetMax: function(self, maxValue: number)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Min` property to a  DNumberWang, Slider, DNumSlider or DNumberScratch. This calls `SetMin` on one of the previously listed methods.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L206)
    -- @param minValue --- The minimum value the element is to permit.
    GWEN_SetMin: function(self, minValue: number)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Position` property to a  panel object. This calls Panel:SetPos.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L201)
    -- @param pos --- A two-membered table containing the x and y coordinates as numbers:
    --- * number x - The x coordinate.
    --- * number y - The y coordinate.
    GWEN_SetPosition: function(self, pos: table)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Size` property to a  panel object. This calls Panel:SetSize.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L202)
    -- @param size --- A two-membered table containing the width and heights as numbers:
    --- * number w - The width.
    --- * number h - The height.
    GWEN_SetSize: function(self, size: table)

    --- **INTERNAL**:
    ---  Used by Panel:ApplyGWEN to apply the `Text` property to a panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma_gwen.lua#L203)
    -- @param txt --- The text to be applied to the panel.
    GWEN_SetText: function(self, txt: string)

    --- Returns the alpha multiplier for this panel.
    -- @return --- alphaMul
    GetAlpha: function(self): number

    --- Returns the background color of a panel such as a RichText, Label or DColorCube.
    --- **NOTE**: This doesn't apply to all VGUI elements and its function varies between them
    -- @return color --- The Color structure
    GetBGColor: function(self): number

    --- Returns the position and size of the panel.
    --- This is equivalent to calling Panel:GetPos and Panel:GetSize together.
    -- @return --- The x coordinate of the panel, relative to its parent's top left.
    -- @return --- The y coordinate of the panel, relative to its parent's top left.
    -- @return --- The width of the panel.
    -- @return --- The height of the panel.
    GetBounds: function(self): number, number, number, number

    --- Returns the position/offset of the caret (or text cursor) in a text-based panel object.
    -- @return --- The caret position/offset from the start of the text. A value of `0` means the caret sits before the first character.
    GetCaretPos: function(self): number

    --- Gets a child by its index. For use with Panel:ChildCount.
    -- @param childIndex --- The index of the child to get.
    --- **NOTE**: This index starts at 0, except when you use this on a DMenu.
    GetChild: function(self, childIndex: number)

    --- Gets a child object's position relative to this panel object. The number of levels is not relevant; the child may have many parents between itself and the object on which the method is called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L442-L458)
    -- @param pnl --- The panel to get the position of.
    -- @return --- The horizontal (x) position of the child relative to this panel object.
    -- @return --- The vertical (y) position of the child relative to this panel object.
    GetChildPosition: function(self, pnl: GPanel): number, number

    --- Returns a table with all the child panels of the panel.
    -- @return --- All direct children of this panel.
    GetChildren: function(self): table

    --- Returns a table of all visible, selectable children of the panel object that lie at least partially within the specified rectangle.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L162-L187)
    -- @param x --- The horizontal (x) position of the top-left corner of the rectangle, relative to the panel object.
    -- @param y --- The vertical (y) position of the top-left corner of the rectangle, relative to the panel object.
    -- @param w --- The width of the rectangle.
    -- @param h --- The height of the rectangle.
    -- @return --- A table of panel objects that lie at least partially within the specified rectangle.
    GetChildrenInRect: function(self, x: number, y: number, w: number, h: number): table

    --- Returns the class name of the panel. This would be the class name of the base engine-level panel, not Lua classname. The latter is stored usually in Panel:GetName.
    -- @return --- The panel's class name.
    GetClassName: function(self): string

    --- Returns the child of this panel object that is closest to the specified point. The point is relative to the object on which the method is called. The distance the child is from this point is also returned.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L523-L538)
    -- @param x --- The horizontal (x) position of the point.
    -- @param y --- The vertical (y) position of the point.
    -- @return --- The child object that was closest to the specified point.
    -- @return --- The distance that this child was from the point.
    GetClosestChild: function(self, x: number, y: number): GPanel, number

    --- Returns the alignment of the text of a Label.
    --- **NOTE**: This function only works on Label panels and its derivatives.
    -- @return alignment --- The direction of the content, based on the number pad.
    --- ``: **bottom-left**
    --- ``: **bottom-center**
    --- ``: **bottom-right**
    --- ``: **middle-left**
    --- ``: **center**
    --- ``: **middle-right**
    --- ``: **top-left**
    --- ``: **top-center**
    --- ``: **top-right**
    GetContentAlignment: function(self): number

    --- Gets the size of the content/children within a panel object.
    --- Only works with Label derived panels by default such as DLabel.
    --- Will also work on any panel that manually implements this method.
    -- @return --- The content width of the object.
    -- @return --- The content height of the object.
    GetContentSize: function(self): number, number

    --- Gets the value of a cookie stored by the panel object. This can also be done with cookie.GetString, using the panel's cookie name, a fullstop, and then the actual name of the cookie.
    --- Make sure the panel's cookie name has not changed since writing, or the cookie will not be accessible. This can be done with Panel:GetCookieName and Panel:SetCookieName.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L214-L221)
    -- @param cookieName --- The name of the cookie from which to retrieve the value.
    -- @param default --- The default value to return if the cookie does not exist.
    -- @return --- The value of the stored cookie, or the default value should the cookie not exist.
    GetCookie: function(self, cookieName: string, default: string): string

    --- Gets the name the panel uses to store cookies. This is set with Panel:SetCookieName.
    -- @return --- The name the panel uses when reading or writing cookies. The format used is as follows:
    --- ```
    --- panelCookieName.individualCookieName
    --- ```
    GetCookieName: function(self): string

    --- Gets the value of a cookie stored by the panel object, as a number. This can also be done with cookie.GetNumber, using the panel's cookie name, a fullstop, and then the actual name of the cookie.
    --- Make sure the panel's cookie name has not changed since writing, or the cookie will not be accessible. This can be done with Panel:GetCookieName and Panel:SetCookieName.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L202-L209)
    -- @param cookieName --- The name of the cookie from which to retrieve the value.
    -- @param default --- The default value to return if the cookie does not exist.
    -- @return --- The number value of the stored cookie, or the default value should the cookie not exist.
    GetCookieNumber: function(self, cookieName: string, default: number): number

    --- Returns a dock enum for the panel's current docking type.
    -- @return --- The dock enum for the panel. See Enums/DOCK.
    GetDock: function(self): number

    --- Returns the docked margins of the panel. (set by Panel:DockMargin)
    -- @return --- Left margin.
    -- @return --- Top margin.
    -- @return --- Right margin.
    -- @return --- Bottom margin.
    GetDockMargin: function(self): number, number, number, number

    --- Returns the docked padding of the panel. (set by Panel:DockPadding)
    -- @return --- Left padding.
    -- @return --- Top padding.
    -- @return --- Right padding.
    -- @return --- Bottom padding.
    GetDockPadding: function(self): number, number, number, number

    --- Returns the foreground color of the panel.
    --- For a Label or RichText, this is the color of its text.
    --- **NOTE**: This doesn't apply to all VGUI elements (such as DLabel) and its function varies between them
    -- @return color --- A color structure. See Color
    GetFGColor: function(self): table

    --- Returns the name of the font that the panel renders its text with.
    --- This is the same font name set with Panel:SetFontInternal.
    --- **NOTE**: Only works on Label and TextEntry and their derived panels by default (such as DLabel and DTextEntry), and on any panel that manually implemented the Panel:GetFont method.
    -- @return --- The font name.
    GetFont: function(self): string

    --- Returns the panel's HTML material. Only works with Awesomium, HTML and DHTML panels that have been fully loaded.
    -- @return --- The HTML material used by the panel. Typically starts with `__vgui_texture_` followed by an incremental number.
    GetHTMLMaterial: function(self): GIMaterial

    --- Returns the height of a single line of a RichText panel.
    -- @return --- The line height.
    GetLineHeight: function(self): number

    --- Returns the current maximum character count.
    --- This function will only work on RichText and TextEntry panels and their derivatives.
    -- @return maxChar --- The maximum amount of characters this panel is allowed to contain.
    GetMaximumCharCount: function(self): number

    --- Returns the internal name of the panel. Can be set via Panel:SetName.
    -- @return --- The previously set internal name of the panel.
    GetName: function(self): string

    --- Returns the number of lines in a RichText or a TextEntry.
    --- You must wait a couple frames before calling this after using Panel:AppendText or Panel:SetText, otherwise it will return the number of text lines before the text change.
    -- @return --- The number of lines.
    GetNumLines: function(self): number

    --- Returns the parent of the panel, returns nil if there is no parent.
    -- @return --- The parent of given panel
    GetParent: function(self): GPanel

    --- Returns the position of the panel relative to its Panel:GetParent.
    --- If you require the panel's position **and** size, consider using Panel:GetBounds instead.
    --- If you need the position in screen space, see Panel:LocalToScreen.
    --- See also Panel:GetX and Panel:GetY.
    -- @return --- X coordinate, relative to this panels parents top left corner.
    -- @return --- Y coordinate, relative to this panels parents top left corner.
    GetPos: function(self): number, number

    --- Returns the vertical and horizontal start indexes of a TextEntry's visible text. This is useful when the panel is scrolled.
    -- @return horizontalIndex --- The horizontal start index. (characters)
    -- @return verticalIndex --- The vertical start index. (lines)
    GetScrollStartIndexes: function(self): number, number

    --- Returns a table of all children of the panel object that are selected. This is recursive, and the returned table will include tables for any child objects that also have children. This means that not all first-level members in the returned table will be of type Panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L189-L205)
    -- @return --- A table of any child objects that are selected, including tables for children of the child objects (These tables may also contain table members, as the method is recursive).
    GetSelectedChildren: function(self): table

    --- Returns the currently selected range of text.
    --- This function will only work on RichText and TextEntry panels and their derivatives.
    -- @return start --- The start of the range. If no text is selected it may be 0 and/or equal to the end range.
    -- @return endrange --- The end of the range. If no text is selected it may be 0 and/or equal to the start range.
    GetSelectedTextRange: function(self): number, number

    --- Returns the selection canvas for this panel. This will be the first parent that has Panel:SetSelectionCanvas set to true (or `self` if this panel is the selection canvas)
    --- A selection canvas would be the panel that contains a bunch of selectable panels (Panel:SetSelectable), usually for the drag'n'drop system. Calling this function on any of the selectable items, or any of their children, will return the first parent that can contain selectable panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L116-L131)
    -- @return --- The selection canvas, otherwise `nil`.
    GetSelectionCanvas: function(self): GPanel

    --- Returns the size of the panel.
    --- If you require both the panel's position and size, consider using Panel:GetBounds instead.
    -- @return --- width
    -- @return --- height
    GetSize: function(self): number, number

    --- Returns the table for the derma skin currently being used by this panel object.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L378-L413)
    -- @return --- The derma skin table currently being used by this object.
    GetSkin: function(self): table

    --- Returns the internal Lua table of the panel.
    -- @return --- A table containing all the members of given panel object.
    GetTable: function(self): table

    --- Returns the height of the panel.
    --- See Panel:GetWide for the width of the panel. See also Panel:GetSize for a function that returns both.
    -- @return --- height
    GetTall: function(self): number

    --- Returns the panel's text (where applicable).
    --- This method returns a maximum of 1023 bytes, except for TextEntry.
    -- @return --- The panel's text.
    GetText: function(self): string

    --- Gets the left and top text margins of a text-based panel object, such as a DButton or DLabel. This is set with Panel:SetTextInset.
    -- @return --- The left margin of the text, in pixels.
    -- @return --- The top margin of the text, in pixels.
    GetTextInset: function(self): number, number

    --- Gets the size of the text within a Label derived panel.
    -- @return --- The width of the text in the DLabel.
    -- @return --- The height of the text in the DLabel.
    GetTextSize: function(self): number, number

    --- Returns the tooltip text that was set with PANEL:SetTooltip.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L277-L282)
    -- @return tooltip --- The tooltip text, if it was set.
    GetTooltip: function(self): string

    --- Returns the tooltip delay (time between hovering over the panel, and the tooltip showing up) that was set with Panel:SetTooltipDelay, or nothing if it was not set.
    --- If the delay is not explicitly set by this function, it will fallback to the value of the `tooltip_delay` ConVar, which is `0.5` by default.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L294-L296)
    -- @return tooltip --- The tooltip delay in seconds, if it was set.
    GetTooltipDelay: function(self): number

    --- Returns the tooltip panel that was set with PANEL:SetTooltipPanel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L287-L289)
    -- @return tooltip --- The tooltip panel, if it was set.
    GetTooltipPanel: function(self): GPanel

    --- Gets valid receiver slot of currently dragged panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L335-L359)
    -- @return --- The panel this was called on if a valid receiver slot exists, otherwise false.
    -- @return --- The slot table.
    GetValidReceiverSlot: function(self): GPanel, table

    --- Returns the value the panel holds.
    --- In engine is only implemented for CheckButton, Label and TextEntry as a string.
    --- **NOTE**: This function is limited to 8092 Bytes. If using DTextEntry, use Panel:GetText for unlimited bytes.
    -- @return --- The value the panel holds.
    GetValue: function(self): any

    --- Returns the width of the panel.
    --- See Panel:GetTall for the height of the panel. See also Panel:GetSize for a function that returns both.
    -- @return --- width
    GetWide: function(self): number

    --- Returns the X position of the panel relative to its Panel:GetParent.
    --- Uses Panel:GetPos internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L62-L65)
    -- @return --- X coordinate.
    GetX: function(self): number

    --- Returns the Y position of the panel relative to its Panel:GetParent.
    --- Uses Panel:GetPos internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L66-L69)
    -- @return --- Y coordinate.
    GetY: function(self): number

    --- Returns the Z position of the panel.
    -- @return --- The Z order position of the panel.
    GetZPos: function(self): number

    --- Goes back one page in the HTML panel's history if available.
    GoBack: function(self)

    --- Goes forward one page in the HTML panel's history if available.
    GoForward: function(self)

    --- Goes to the page in the HTML panel's history at the specified relative offset.
    -- @param offset --- The offset in the panel's back/forward history, relative to the current page, that you would like to skip to. Because this is relative, 0 = current page while negative goes back and positive goes forward. For example, -2 will go back 2 pages in the history.
    GoToHistoryOffset: function(self, offset: number)

    --- Causes a RichText element to scroll to the bottom of its text.
    GotoTextEnd: function(self)

    --- Causes a RichText element to scroll to the top of its text.
    GotoTextStart: function(self)

    --- Returns whenever the panel has child panels.
    -- @return --- hasChilds
    HasChildren: function(self): boolean

    --- Returns if the panel is focused.
    -- @return --- hasFocus
    HasFocus: function(self): boolean

    --- Returns if the panel or any of its children(sub children and so on) has the focus.
    -- @return --- hasHierarchicalFocus
    HasHierarchicalFocus: function(self): boolean

    --- Returns whether the panel is a descendent of the given panel.
    -- @param parentPanel ---
    -- @return --- True if the panel is contained within parentPanel.
    HasParent: function(self, parentPanel: GPanel): boolean

    --- Makes a panel invisible.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L606-L608)
    Hide: function(self)

    --- Marks the end of a clickable text segment in a RichText element, started with Panel:InsertClickableTextStart.
    InsertClickableTextEnd: function(self)

    --- Starts the insertion of clickable text for a RichText element. Any text appended with Panel:AppendText between this call and Panel:InsertClickableTextEnd will become clickable text.
    --- The hook PANEL:OnTextClicked is called when the text is clicked.
    --- **NOTE**: The clickable text is a separate Derma panel which will not inherit the current font from the `RichText`.
    -- @param signalValue --- The text passed as the action signal's value.
    InsertClickableTextStart: function(self, signalValue: string)

    --- Inserts a color change in a RichText element, which affects the color of all text added with Panel:AppendText until another color change is applied.
    -- @param r --- The red value `(0 - 255)`.
    -- @param g --- The green value `(0 - 255)`.
    -- @param b --- The blue value `(0 - 255)`.
    -- @param a --- The alpha value `(0 - 255)`.
    InsertColorChange: function(self, r: number, g: number, b: number, a: number)

    --- Begins a text fade for a RichText element where the last appended text segment is fully faded out after a specific amount of time, at a specific speed.
    --- The alpha of the text at any given time is determined by the text's base alpha * ((`sustain` - Global.CurTime) / `length`) where Global.CurTime is added to `sustain` when this method is called.
    -- @param sustain --- The number of seconds the text remains visible.
    -- @param length --- The number of seconds it takes the text to fade out.
    --- If set **lower** than `sustain`, the text will not begin fading out until (`sustain` - `length`) seconds have passed.
    --- If set **higher** than `sustain`, the text will begin fading out immediately at a fraction of the base alpha.
    --- If set to **-1**, the text doesn't fade out.
    InsertFade: function(self, sustain: number, length: number)

    --- Invalidates the layout of this panel object and all its children. This will cause these objects to re-layout immediately, calling PANEL:PerformLayout. If you want to perform the layout in the next frame, you will have loop manually through all children, and call Panel:InvalidateLayout on each.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L473-L487)
    -- @param recursive --- If `true`, the method will recursively invalidate the layout of all children. Otherwise, only immediate children are affected.
    InvalidateChildren: function(self, recursive: boolean)

    --- Causes the panel to re-layout in the next frame. During the layout process  PANEL:PerformLayout will be called on the target panel.
    --- You should avoid calling this function every frame.
    --- **BUG**: [Using this on a panel after clicking on a docked element will cause docked elements to reorient themselves incorrectly. This can be fixed by assigning a unique Panel:SetZPos to each docked element.](https://github.com/Facepunch/garrysmod-issues/issues/2574
    -- @param layoutNow --- If true the panel will re-layout instantly and not wait for the next frame.
    InvalidateLayout: function(self, layoutNow: boolean)

    --- Calls Panel:InvalidateLayout on the panel's parent. This function will silently fail if the panel has no parent.
    --- This will cause the parent panel to re-layout, calling PANEL:PerformLayout.
    --- Internally sets `LayingOutParent` to `true` on this panel, and will silently fail if it is already set.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L250-L260)
    -- @param layoutNow --- If `true`, the re-layout will occur immediately, otherwise it will be performed in the next frame.
    InvalidateParent: function(self, layoutNow: boolean)

    --- Determines whether the mouse cursor is hovered over one of this panel object's children. This is a reverse process using vgui.GetHoveredPanel, and looks upward to find the parent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L610-L621)
    -- @param immediate --- Set to true to check only the immediate children of given panel ( first level )
    -- @return --- Whether or not one of this panel object's children is being hovered over.
    IsChildHovered: function(self, immediate: boolean): boolean

    --- Returns whether this panel is draggable ( if user is able to drag it ) or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L361-L365)
    -- @return --- Whether this panel is draggable ( if user is able to drag it ) or not.
    IsDraggable: function(self): boolean

    --- Returns whether this panel is currently being dragged or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L367-L373)
    -- @return --- Whether this panel is currently being dragged or not.
    IsDragging: function(self): boolean

    --- Returns whether the the panel is enabled or disabled.
    --- See Panel:SetEnabled for a function that makes the panel enabled or disabled.
    -- @return --- Whether the panel is enabled or disabled.
    IsEnabled: function(self): boolean

    --- Returns whether the mouse cursor is hovering over this panel or not
    --- Uses vgui.GetHoveredPanel internally.
    --- Requires Panel:SetMouseInputEnabled to be set to true.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L598-L600)
    -- @return --- true if the panel is hovered
    IsHovered: function(self): boolean

    --- Returns true if the panel can receive keyboard input.
    -- @return --- keyboardInputEnabled
    IsKeyboardInputEnabled: function(self): boolean

    --- Determines whether or not a HTML or DHTML element is currently loading a page.
    --- **NOTE**: Before calling Panel:SetHTML or DHTML:OpenURL, the result seems to be `false` with the Awesomium web renderer and `true` for the Chromium web renderer. This difference can be used to determine the available HTML5 capabilities.
    --- **NOTE**: On Awesomium, the result remains `true` until the root document is loaded and when in-page content is loading (when adding pictures, frames, etc.). During this state, the HTML texture is not refreshed and the panel is not painted (it becomes invisible).
    --- On Chromium, the value is only `true` when the root document is not ready. The rendering is not suspended when in-page elements are loading.
    -- @return --- Whether or not the (D)HTML object is loading.
    IsLoading: function(self): boolean

    --- Returns if the panel is going to be deleted in the next frame.
    -- @return --- markedForDeletion
    IsMarkedForDeletion: function(self): boolean

    --- Returns whether the panel was made modal or not. See Panel:DoModal.
    -- @return --- True if the panel is modal.
    IsModal: function(self): boolean

    --- Returns true if the panel can receive mouse input.
    -- @return --- mouseInputEnabled
    IsMouseInputEnabled: function(self): boolean

    --- Determines whether or not a TextEntry panel is in multi-line mode. This is set with Panel:SetMultiline.
    -- @return --- Whether the object is in multi-line mode or not.
    IsMultiline: function(self): boolean

    --- Returns whether the panel contains the given panel, recursively.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel.lua#L489-L495)
    -- @param childPanel ---
    -- @return --- True if the panel contains childPanel.
    IsOurChild: function(self, childPanel: GPanel): boolean

    --- Returns if the panel was made popup or not. See Panel:MakePopup
    -- @return --- `true` if the panel was made popup.
    IsPopup: function(self): boolean

    --- Determines if the panel object is selectable (like icons in the Spawn Menu, holding ``). This is set with Panel:SetSelectable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L66-L70)
    -- @return --- Whether the panel is selectable or not.
    IsSelectable: function(self): boolean

    --- Returns if the panel object is selected (like icons in the Spawn Menu, holding ``). This can be set in Lua using Panel:SetSelected.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L59-L64)
    -- @return --- Whether the panel object is selected or not. Always returns false if the object is not selectable. This can be modified using Panel:SetSelectable.
    IsSelected: function(self): boolean

    --- Determines if the panel object is a selection canvas or not. This is set with Panel:SetSelectionCanvas.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/selections.lua#L17-L21)
    -- @return --- The value (if any) set by Panel:SetSelectionCanvas.

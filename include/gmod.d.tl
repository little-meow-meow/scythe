--- Enumerations for use with render.SetStencilCompareFunction.
--- The comparison is between the reference value set by render.SetStencilReferenceValue, and the value of each pixel in the stencil buffer.
--- These enumerations are mirrors of Enums/STENCILCOMPARISONFUNCTION.
--- Also see this corresponding MSDN entry: https://msdn.microsoft.com/en-us/library/windows/desktop/ff476101%28v=vs.85%29.aspx.
global type E_STENCIL = number
--- Never passes.
global STENCIL_NEVER: E_STENCIL = 1
--- Passes where the reference value is less than the stencil value.
global STENCIL_LESS: E_STENCIL = 2
--- Passes where the reference value is equal to the stencil value.
global STENCIL_EQUAL: E_STENCIL = 3
--- Passes where the reference value is less than or equal to the stencil value.
global STENCIL_LESSEQUAL: E_STENCIL = 4
--- Passes where the reference value is greater than the stencil value.
global STENCIL_GREATER: E_STENCIL = 5
--- Passes where the reference value is not equal to the stencil value.
global STENCIL_NOTEQUAL: E_STENCIL = 6
--- Passes where the reference value is greater than or equal to the stencil value.
global STENCIL_GREATEREQUAL: E_STENCIL = 7
--- Always passes.
global STENCIL_ALWAYS: E_STENCIL = 8
--- Preserves the existing stencil buffer value.
global STENCIL_KEEP: E_STENCIL = 1
--- Sets the value in the stencil buffer to 0.
global STENCIL_ZERO: E_STENCIL = 2
--- Sets the value in the stencil buffer to the reference value, set using render.SetStencilReferenceValue.
global STENCIL_REPLACE: E_STENCIL = 3
--- Increments the value in the stencil buffer by 1, clamping the result.
global STENCIL_INCRSAT: E_STENCIL = 4
--- Decrements the value in the stencil buffer by 1, clamping the result.
global STENCIL_DECRSAT: E_STENCIL = 5
--- Inverts the value in the stencil buffer.
global STENCIL_INVERT: E_STENCIL = 6
--- Increments the value in the stencil buffer by 1, wrapping around on overflow.
global STENCIL_INCR: E_STENCIL = 7
--- Decrements the value in the stencil buffer by 1, wrapping around on overflow.
global STENCIL_DECR: E_STENCIL = 8

--- Enumerations for use with render.SetStencilCompareFunction.
--- The comparison is between the reference value set by render.SetStencilReferenceValue, and the value of each pixel in the stencil buffer.
--- Clientside only.
--- **NOTE**: These enumerations are also mirrored as Enums/STENCIL.
--- Also see this corresponding MSDN entry: http://msdn.microsoft.com/en-us/library/windows/desktop/ff476101%28v=vs.85%29.aspx.
global type E_STENCILCOMPARISONFUNCTION = number
--- Never passes.
global STENCILCOMPARISONFUNCTION_NEVER: E_STENCILCOMPARISONFUNCTION = 1
--- Passes where the reference value is less than the stencil value.
global STENCILCOMPARISONFUNCTION_LESS: E_STENCILCOMPARISONFUNCTION = 2
--- Passes where the reference value is equal to the stencil value.
global STENCILCOMPARISONFUNCTION_EQUAL: E_STENCILCOMPARISONFUNCTION = 3
--- Passes where the reference value is less than or equal to the stencil value.
global STENCILCOMPARISONFUNCTION_LESSEQUAL: E_STENCILCOMPARISONFUNCTION = 4
--- Passes where the reference value is greater than the stencil value.
global STENCILCOMPARISONFUNCTION_GREATER: E_STENCILCOMPARISONFUNCTION = 5
--- Passes where the reference value is not equal to the stencil value.
global STENCILCOMPARISONFUNCTION_NOTEQUAL: E_STENCILCOMPARISONFUNCTION = 6
--- Passes where the reference value is greater than or equal to the stencil value.
global STENCILCOMPARISONFUNCTION_GREATEREQUAL: E_STENCILCOMPARISONFUNCTION = 7
--- Always passes.
global STENCILCOMPARISONFUNCTION_ALWAYS: E_STENCILCOMPARISONFUNCTION = 8

--- Enumerations for use with render.SetStencilPassOperation, render.SetStencilFailOperation and render.SetStencilZFailOperation. Clientside only.
--- **NOTE**: These enumerations are also mirrored as Enums/STENCIL.
--- Also see this corresponding MSDN entry: http://msdn.microsoft.com/en-us/library/windows/desktop/ff476219%28v=vs.85%29.aspx.
global type E_STENCILOPERATION = number
--- Preserves the existing stencil buffer value.
global STENCILOPERATION_KEEP: E_STENCILOPERATION = 1
--- Sets the value in the stencil buffer to 0.
global STENCILOPERATION_ZERO: E_STENCILOPERATION = 2
--- Sets the value in the stencil buffer to the reference value, set using render.SetStencilReferenceValue.
global STENCILOPERATION_REPLACE: E_STENCILOPERATION = 3
--- Increments the value in the stencil buffer by 1, clamping the result.
global STENCILOPERATION_INCRSAT: E_STENCILOPERATION = 4
--- Decrements the value in the stencil buffer by 1, clamping the result.
global STENCILOPERATION_DECRSAT: E_STENCILOPERATION = 5
--- Inverts the value in the stencil buffer.
global STENCILOPERATION_INVERT: E_STENCILOPERATION = 6
--- Increments the value in the stencil buffer by 1, wrapping around on overflow.
global STENCILOPERATION_INCR: E_STENCILOPERATION = 7
--- Decrements the value in the stencil buffer by 1, wrapping around on overflow.
global STENCILOPERATION_DECR: E_STENCILOPERATION = 8


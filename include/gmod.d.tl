    -- @param ent --- The entity to check.
    -- @return --- A list of all constraints connected to the entity.
    GetTable: function(ent: GEntity): table

    --- Returns true if the entity has constraints attached to it
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1502-L1524)
    -- @param ent --- The entity to check.
    -- @return --- Whether the entity has any constraints or not.
    HasConstraints: function(ent: GEntity): boolean

    --- Creates a controllable constraint.Elastic, aka a Hydraulic constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1337-L1415)
    -- @param player --- The player that will be able to control the constraint. Used to call numpad.OnDown.
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls). Must be different from `bone1`.
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param length1 --- Minimum length of the constraint.
    -- @param length2 --- Maximum length of the constraint.
    -- @param width --- The width of the rope.
    -- @param key --- The key binding, corresponding to an Enums/KEY.
    -- @param slider --- Whether the hydraulic is fixed, i.e. cannot bend. Must be `1` to act as `true`.
    -- @param speed --- How fast it changes the length from `length1` to `length2` and backwards.
    -- @param material --- The material of the rope. If unset, will be solid black.
    -- @param toggle --- Whether the hydraulic should be a toggle, not a "hold key to extend" action.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return --- The created constraint. ([phys_spring](https://developer.valvesoftware.com/wiki/Phys_spring)) Will return `false` if the constraint could not be created.
    -- @return --- The created rope. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint could not be created.
    -- @return --- The muscle controller. (`gmod_winch_controller`) Will return `nil` if the constraint could not be created.
    -- @return --- The slider ([phys_slideconstraint](https://developer.valvesoftware.com/wiki/Phys_slideconstraint)) if `fixed` was exactly `1`. Will return nil otherwise, or if the constraint could not be created.
    Hydraulic: function(player: GPlayer, ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, length1: number, length2: number, width: number, key: number, slider: number, speed: number, material: string, toggle: boolean, color: table): GEntity, GEntity, GEntity, GEntity

    --- Creates a keep upright constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L621-L662)
    -- @param ent --- The entity to keep upright.
    -- @param ang --- The angle defined as "upright".
    -- @param bone --- The bone of the entity to constrain (0 for boneless).
    -- @param angularLimit --- Basically, the strength of the constraint. Must be above 0.
    -- @return --- The created constraint, if any or false if the constraint failed to set.
    Keepupright: function(ent: GEntity, ang: GAngle, bone: number, angularLimit: number): GEntity

    --- Creates a motor constraint, a player controllable constraint.Axis.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1037-L1130)
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls). Must be different from `bone1`.
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param friction --- Motor friction.
    -- @param torque --- Motor torque.
    -- @param forcetime --- Automatic shut-off after this time has passed. A value of 0 means to stay on forever or until deactivated.
    -- @param nocollide --- Whether the entities should be no-collided.
    -- @param toggle --- Whether the constraint is on toggle.
    -- @param player --- The player that will control the motor. Used to to call numpad.OnDown and numpad.OnUp.
    -- @param forcelimit --- Amount of force until it breaks (0 = unbreakable).
    -- @param key_fwd --- The key binding for "forward", corresponding to an Enums/KEY.
    -- @param key_bwd --- The key binding for "backwards", corresponding to an Enums/KEY.
    -- @param direction --- Either `1` or `-1` signifying which direction the motor should spin.
    -- @param localAxis --- Overrides axis of rotation?
    --- **VALIDATE**:
    -- @return --- The created constraint. ([phys_torque](https://developer.valvesoftware.com/wiki/Phys_torque)) Will return `false` if the constraint could not be created.
    -- @return --- The created axis constraint. ([phys_hinge](https://developer.valvesoftware.com/wiki/Phys_hinge)) Will return `nil` if the constraint could not be created.
    Motor: function(ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, friction: number, torque: number, forcetime: number, nocollide: number, toggle: number, player: GPlayer, forcelimit: number, key_fwd: number, key_bwd: number, direction: number, localAxis: GVector): GEntity, GEntity

    --- Creates a muscle constraint.
    --- Very similar to constraint.Hydraulic, but instead of a toggle between fully expanded and contracted, it will continuously alternate between the 2 states while enabled.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1422-L1496)
    -- @param player --- The player that will be able to control the constraint. Used to call numpad.OnDown.
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls). Must be different from `bone1`.
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param length1 --- Minimum length of the constraint.
    -- @param length2 --- Maximum length of the constraint.
    -- @param width --- Width of the rope.
    -- @param key --- The key binding, corresponding to an Enums/KEY.
    -- @param fixed --- Whether the constraint is fixed, i.e. cannot bend. Must be `1` to act as `true`.
    -- @param period --- How often the "contractions" should happen.
    -- @param amplitude --- Amplification of the "contractions"?
    -- @param startOn --- Whether the constraint should start activated. (i.e. spazzing).
    -- @param material --- Material of the rope. If left unset, will be solid black.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return --- The created constraint. ([phys_spring](https://developer.valvesoftware.com/wiki/Phys_spring)) Will return `false` if the constraint could not be created.
    -- @return --- The created rope. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint could not be created.
    -- @return --- The muscle controller. (`gmod_winch_controller`) Will return `nil` if the constraint could not be created.
    -- @return --- The slider ([phys_slideconstraint](https://developer.valvesoftware.com/wiki/Phys_slideconstraint)) if `fixed` was exactly `1`. Will return nil otherwise, or if the constraint could not be created.
    Muscle: function(player: GPlayer, ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, length1: number, length2: number, width: number, key: number, fixed: number, period: number, amplitude: number, startOn: boolean, material: string, color: table): GEntity, GEntity, GEntity, GEntity

    --- Creates an no-collide "constraint". Disables collision between two entities.
    --- **NOTE**: Does not work with players.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L913-L954)
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param disableOnRemove --- If set, the nocollide will be reversed if the constraint is removed.
    -- @return --- The created constraint. ([logic_collision_pair](https://developer.valvesoftware.com/wiki/Logic_collision_pair)) Will return `false` if the constraint could not be created.
    NoCollide: function(ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, disableOnRemove: boolean): GEntity

    --- Creates a pulley constraint.
    --- It consists of 3 rope segments, 2 of which have variable length, visually connected by a 3rd. Reducing length of one end will increase the length of the other end.
    --- You can visualize the pulley like so:
    --- ```
    --- WPos2 --- WPos3
    --- |			|
    --- |			|
    --- Ent1	   Ent4
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1137-L1207)
    -- @param ent1 --- First entity to constrain.
    -- @param ent4 --- The other entity to attach to.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone4 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos4 --- Position relative to the the second physics object to constrain to.
    -- @param worldPos2 --- World position constrain the first entity to. This point will be static.
    -- @param worldPos3 --- World position constrain the second entity to. This point will be static.
    -- @param forceLimit --- Amount of force until it breaks (0 = unbreakable).
    -- @param rigid --- Whether the constraint is rigid, i.e. cannot bend.
    -- @param width --- Width of the rope. If below or at `0`, visual rope segments will not be created.
    -- @param material --- Material of the rope. If unset, will be solid black.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return --- The created constraint. ([phys_pulleyconstraint](https://developer.valvesoftware.com/wiki/Phys_pulleyconstraint)) Will return `false` if the constraint could not be created.
    -- @return --- The first rope segment. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint or this rope segment could not be created.
    -- @return --- The second rope segment. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint or this rope segment could not be created.
    -- @return --- The third rope segment. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint or this rope segment could not be created.
    Pulley: function(ent1: GEntity, ent4: GEntity, bone1: number, bone4: number, localPos1: GVector, localPos4: GVector, worldPos2: GVector, worldPos3: GVector, forceLimit: number, rigid: boolean, width: number, material: string, color: table): GEntity, GEntity, GEntity, GEntity

    --- Attempts to remove all constraints associated with an entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L189-L216)
    -- @param ent --- The entity to remove constraints from.
    -- @return --- Whether any constraints were removed.
    -- @return --- Number of constraints removed.
    RemoveAll: function(ent: GEntity): boolean, number

    --- Attempts to remove all constraints of a specified type associated with an entity
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L146-L182)
    -- @param ent --- The entity to check.
    -- @param type --- The constraint type to remove (eg. `"Weld"`, `"Elastic"`, `"NoCollide"`).
    -- @return --- Whether we removed any constraints or not.
    -- @return --- The amount of constraints removed.
    RemoveConstraints: function(ent: GEntity, type: string): boolean, number

    --- Creates a simple rope (length) based constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L468-L540)
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param length --- Length of the rope.
    -- @param addLength --- Amount to add to the length of the rope. Works as it does in the Rope tool.
    -- @param forceLimit --- Amount of force until it breaks (0 = unbreakable).
    -- @param width --- Width of the rope.
    -- @param material --- Material of the rope. If unset, will be solid black.
    -- @param rigid --- Whether the constraint is rigid.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return constraint --- The constraint entity ([phys_lengthconstraint](https://developer.valvesoftware.com/wiki/Phys_lengthconstraint)).
    --- Will be a `keyframe_rope` if you are roping to the same bone on the same entity. Will return `false` if the constraint could not be created.
    -- @return rope --- The rope entity. Will return `nil` if `constraint` return value is a [keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope) or if the constraint could not be created.
    Rope: function(ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, length: number, addLength: number, forceLimit: number, width: number, material: string, rigid: boolean, color: table): GEntity, GEntity

    --- Creates a slider constraint. A slider is like a rope, but allows the constrained object to move only in 1 direction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L684-L767)
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param width --- The width of the rope.
    -- @param material --- The material of the rope. If unset, will be solid black.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return --- The created constraint entity. ([phys_slideconstraint](https://developer.valvesoftware.com/wiki/Phys_slideconstraint)) Will return `false` if the constraint could not be created.
    -- @return --- The created rope. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint or the rope could not be created.
    Slider: function(ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, width: number, material: string, color: table): GEntity, GEntity

    --- Creates a weld constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L396-L461)
    -- @param ent1 --- The first entity.
    -- @param ent2 --- The second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param forceLimit --- The amount of force appliable to the constraint before it will break (0 is never).
    -- @param noCollide --- Should `ent1` be nocollided to `ent2` via this constraint.
    -- @param deleteEnt1OnBreak --- If true, when `ent2` is removed, `ent1` will also be removed.
    -- @return --- The created constraint entity. ([phys_constraint](https://developer.valvesoftware.com/wiki/Phys_constraint))
    Weld: function(ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, forceLimit: number, noCollide: boolean, deleteEnt1OnBreak: boolean): GEntity

    --- Creates a winch constraint, a player controllable constraint.Elastic, allowing gradually increasing or decreasing the length.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L1265-L1330)
    -- @param player --- The player that will be used to call numpad.OnDown and numpad.OnUp.
    -- @param ent1 --- First entity.
    -- @param ent2 --- Second entity.
    -- @param bone1 --- PhysObj number of first entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param bone2 --- PhysObj number of second entity to constrain to. (0 for non-ragdolls).
    --- See Entity:TranslateBoneToPhysBone.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.
    -- @param localPos2 --- Position relative to the the second physics object to constrain to.
    -- @param width --- The width of the rope.
    -- @param fwdBind --- The key binding for "forward", corresponding to an Enums/KEY.
    -- @param bwdBind --- The key binding for "backwards", corresponding to an Enums/KEY.
    -- @param fwdSpeed --- Forward speed.
    -- @param bwdSpeed --- Backwards speed.
    -- @param material --- The material of the rope. If unset, will be solid black.
    -- @param toggle --- Whether the winch should be on toggle.
    -- @param color --- The color of the rope. See Global.Color.
    -- @return --- The created constraint. ([phys_spring](https://developer.valvesoftware.com/wiki/Phys_spring)) Can return `nil`. Will return `false` if the constraint could not be created.
    -- @return --- The created rope. ([keyframe_rope](https://developer.valvesoftware.com/wiki/Keyframe_rope)) Will return `nil` if the constraint could not be created.
    -- @return --- The winch controller. (`gmod_winch_controller`) Can return `nil`.
    Winch: function(player: GPlayer, ent1: GEntity, ent2: GEntity, bone1: number, bone2: number, localPos1: GVector, localPos2: GVector, width: number, fwdBind: number, bwdBind: number, fwdSpeed: number, bwdSpeed: number, material: string, toggle: boolean, color: table): GEntity, GEntity, GEntity
end


--- The construct library is used to control the physical properties of entities.
global record construct
    --- Creates a magnet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/construct.lua#L95-L149)
    -- @param ply --- Player that will have the numpad control over the magnet.
    -- @param pos --- The position of the magnet.
    -- @param ang --- The angles of the magnet.
    -- @param model --- The model of the magnet.
    -- @param material --- Material of the magnet ( texture ).
    -- @param key --- The key to toggle the magnet, see Enums/KEY.
    -- @param maxObjects --- Maximum amount of objects the magnet can hold.
    -- @param strength --- Strength of the magnet.
    -- @param nopull --- If > 0, disallows the magnet to pull objects towards it.
    -- @param allowrot --- If > 0, allows rotation of the objects attached.
    -- @param startOn --- If > 0, enabled from spawn.
    -- @param toggle --- If != 0, pressing the key toggles the magnet, otherwise you'll have to hold the key to keep it enabled.
    -- @param vel --- Velocity to set on spawn.
    -- @param aVel --- Angular velocity to set on spawn.
    -- @param frozen --- Freeze the magnet on start.
    -- @return --- The magnet.
    Magnet: function(ply: GPlayer, pos: GVector, ang: GAngle, model: string, material: string, key: number, maxObjects: number, strength: number, nopull: number, allowrot: number, startOn: number, toggle: number, vel: GVector, aVel: GAngle, frozen: boolean): GEntity

    --- Sets props physical properties.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/construct.lua#L13-L51)
    -- @param ply --- The player. This variable is not used and can be left out.
    -- @param ent --- The entity to apply properties to.
    -- @param physObjID --- You can use this or the argument below. This will be used in case you don't provide argument below.
    -- @param physObj --- The physics object to apply the properties to.
    -- @param data --- The table containing properties to apply. See Structures/PhysProperties.
    SetPhysProp: function(ply: GPlayer, ent: GEntity, physObjID: number, physObj: GPhysObj, data: table)
end


--- The controlpanel library.
global record controlpanel
    --- Clears ALL the control panels ( for tools ).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/controlpanel.lua#L43-L47)
    Clear: function()

    --- Returns (or creates if not exists) a control panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/controlpanel.lua#L21-L41)
    -- @param name --- The name of the panel. For normal tools this will be equal to `TOOL.Mode` (the tool's filename without the extension).
    --- When you create a tool/option via spawnmenu.AddToolMenuOption, the internal control panel name is `TOOL.Mode .. "_" .. tool_tab:lower() .. "_" .. tool_category:lower()`.
    -- @return --- The ControlPanel panel.
    Get: function(name: string): GPanel
end


--- Functions to persist data on a user's computer.
--- The data will be read / written to / from a database
--- corresponding to the realm the library was used in.
--- | Realm | Database File |
--- |:-----:|:-----|
--- | [Server](/gmod/States#server) | `garrysmod/sv.db`
--- | [Client](/gmod/States#client) | `garrysmod/cl.db`
--- | [Menu](/gmod/States#menu) | `garrysmod/mn.db`
global record cookie
    --- Removes any cookie with the given name.
    --- Does nothing if the cookie doesn't exist.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cookie.lua#L105-L114)
    -- @param key --- The name of the cookie that you want to delete.
    Delete: function(key: string)

    --- Gets the value of a cookie on the client as a number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cookie.lua#L95-L103)
    -- @param name --- The name of the cookie that you want to get.
    -- @param default --- Value to return if the cookie does not exist.
    -- @return --- The cookie value.
    GetNumber: function(name: string, default: any): number

    --- Gets the value of a cookie on the client as a string.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cookie.lua#L85-L93)
    -- @param name --- The name of the cookie that you want to get.
    -- @param default --- Value to return if the cookie does not exist.
    -- @return --- The cookie value.
    GetString: function(name: string, default: any): string

    --- Creates / updates a cookie in the Database.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cookie.lua#L116-L121)
    -- @param key --- The name of the cookie.
    -- @param value --- The data stored in the cookie.
    Set: function(key: string, value: string)
end


--- Coroutines are similar to threads, however they do not run simultaneously. They offer a way to split up tasks and dynamically pause & resume functions.
global record coroutine
    --- Creates a coroutine of the given function.
    -- @param func --- The function for the coroutine to use.
    -- @return --- The created coroutine.
    create: function(func: function): thread

    --- Returns whether the running coroutine can yield.
    --- A running coroutine is yieldable if it is not in the main thread, and it is not inside a non-yieldable C function.
    --- **NOTE**: This is only available on the x86-64 versions, because of the difference in the LuaJIT version. [See here](jit.version)
    -- @return canyield --- Returns true when the running coroutine can yield.
    isyieldable: function(): boolean

    --- Resumes the given coroutine and passes the given vararg to either the function arguments or the coroutine.yield that is inside that function and returns whatever yield is called with the next time or by the final return in the function.
    -- @param coroutine --- Coroutine to resume.
    -- @param args --- Arguments to be returned by coroutine.yield.
    -- @return --- If the executed thread code had no errors occur within it.
    -- @return --- If an error occurred, this will be a string containing the error message. Otherwise, this will be arguments that were yielded.
    resume: function(coroutine: thread, ...: any): boolean, any...

    --- Returns the active coroutine or nil if we are not within a coroutine.
    -- @return --- The active coroutine.
    running: function(): thread

    --- Returns the status of the coroutine passed to it, the possible statuses are "suspended", "running", and "dead".
    -- @param coroutine --- Coroutine to check the status of.
    -- @return --- The coroutine's status.
    status: function(coroutine: thread): string

    --- Repeatedly yields the coroutine for the given duration before continuing.
    --- Only works inside a coroutine. Only useful in nextbot coroutine think function.
    --- This function uses Global.CurTime instead of Global.RealTime.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/coroutine.lua#L15-L26)
    -- @param duration --- The number of seconds to wait.
    wait: function(duration: number)

    --- Returns a function which calling is equivalent with calling coroutine.resume with the coroutine and all extra parameters.
    --- The values returned by the returned function only contain the values passed to the inner coroutine.yield call and do not include the *no error* status that coroutine.resume provides. In case of failure, an error is thrown instead.
    -- @param coroutine --- Coroutine to resume.
    -- @return ---
    wrap: function(coroutine: function): function

    --- Pauses the active coroutine and passes all additional variables to the call of coroutine.resume that resumed the coroutine last time, and returns all additional variables that were passed to the previous call of resume.
    -- @param returnValue --- Arguments to be returned by the last call of coroutine.resume.
    -- @return --- Arguments that were set previously by coroutine.resume.
    yield: function(...: any): any...
end


--- The cvars library allows you to control what happens when a cvar (console variable) is changed.
global record cvars
    --- Adds a callback to be called when the named convar changes.
    --- **BUG**: [This does not callback convars in the menu state.](https://github.com/Facepunch/garrysmod-issues/issues/1440
    --- **BUG**: [This does not callback convars on the client with FCVAR_GAMEDLL and convars on the server without FCVAR_GAMEDLL.](https://github.com/Facepunch/garrysmod-issues/issues/3503
    --- **BUG**: [This does not callback convars on the client with FCVAR_REPLICATED.](https://github.com/Facepunch/garrysmod-issues/issues/3740
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L54-L81)
    -- @param name --- The name of the convar to add the change callback to.
    -- @param callback --- The function to be called when the convar changes.
    --- <callback>
    --- <arg type="string" name="convar">The name of the convar.</arg>
    --- <arg type="string" name="oldValue">The old value of the convar.</arg>
    --- <arg type="string" name="newValue">The new value of the convar.</arg>
    --- </callback>
    -- @param identifier --- If set, you will be able to remove the callback using cvars.RemoveChangeCallback.
    --- The identifier is not required to be globally unique, as it's paired with the actual name of the convar.
    AddChangeCallback: function(name: string, callback: function, identifier: string)

    --- Retrieves console variable as a boolean.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L138-L147)
    -- @param cvar --- Name of console variable.
    -- @param default --- The value to return if the console variable does not exist.
    -- @return --- Retrieved value.
    Bool: function(cvar: string, default: boolean): boolean

    --- Returns a table of the given ConVars callbacks.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L21-L31)
    -- @param name --- The name of the ConVar.
    -- @param createIfNotFound --- Whether or not to create the internal callback table for given ConVar if there isn't one yet.
    --- This argument is internal and should not be used.
    -- @return --- A table of the convar's callbacks, or nil if the convar doesn't exist.
    GetConVarCallbacks: function(name: string, createIfNotFound: boolean): table

    --- Retrieves console variable as a number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L123-L132)
    -- @param cvar --- Name of console variable.
    -- @param default --- The value to return if the console variable does not exist.
    -- @return --- Retrieved value or the second argument if the console variable does not exist. Will return 0 if the console variable exists and has a string value.
    Number: function(cvar: string, default: any): number

    --- **INTERNAL**: You are probably looking for cvars.AddChangeCallback.
    --- Called by the engine when a convar value changes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L38-L52)
    -- @param name --- Convar name.
    -- @param oldVal --- The old value of the convar.
    -- @param newVal --- The new value of the convar.
    OnConVarChanged: function(name: string, oldVal: string, newVal: string)

    --- Removes a callback for a convar using the the callback's identifier. The identifier should be the third argument specified for cvars.AddChangeCallback.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L87-L102)
    -- @param name --- The name of the convar to remove the callback from.
    -- @param indentifier --- The callback's identifier.
    RemoveChangeCallback: function(name: string, indentifier: string)

    --- Retrieves console variable as a string.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/cvars.lua#L108-L117)
    -- @param cvar --- Name of console variable.
    -- @param default --- The value to return if the console variable does not exist.
    -- @return --- Retrieved value.
    String: function(cvar: string, default: any): string
end




--- The debugoverlay library is mainly useful for 3D debugging, it can be used to draw shapes on the screen for debug purposes.
--- **NOTE**: These functions will not do anything unless the **developer** console variable is set to non 0.
--- **BUG**: [There's some code that prevents debugoverlay from being added if the game is paused, i.e. when console is open in singleplayer.](https://github.com/Facepunch/garrysmod-issues/issues/5972#issuecomment-2275751896
global record debugoverlay
    --- Displays an axis indicator at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param origin --- Position origin.
    -- @param ang --- Angle of the axis.
    -- @param size --- Size of the axis.
    -- @param lifetime --- Number of seconds to appear.
    -- @param ignoreZ --- If true, will draw on top of everything; ignoring the Z buffer.
    Axis: function(origin: GVector, ang: GAngle, size: number, lifetime: number, ignoreZ: boolean)

    --- Displays a solid coloured box at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param origin --- Position origin.
    -- @param mins --- Minimum bounds of the box.
    -- @param maxs --- Maximum bounds of the box.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the box. Uses the Color.
    Box: function(origin: GVector, mins: GVector, maxs: GVector, lifetime: number, color: table)

    --- Displays a solid colored rotated box at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param pos --- World position.
    -- @param mins --- The mins of the box (lowest corner).
    -- @param maxs --- The maxs of the box (highest corner).
    -- @param ang --- The angle to draw the box at.
    -- @param lifetime --- Amount of seconds to show the box.
    -- @param color --- The color of the box. Uses the Color.
    BoxAngles: function(pos: GVector, mins: GVector, maxs: GVector, ang: GAngle, lifetime: number, color: table)

    --- Creates a coloured cross at the specified position for the specified time.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param position --- Position origin.
    -- @param size --- Size of the cross.
    -- @param lifetime --- Number of seconds the cross will appear for.
    -- @param color --- The color of the cross. Uses the Color.
    -- @param ignoreZ --- If true, will draw on top of everything; ignoring the Z buffer.
    Cross: function(position: GVector, size: number, lifetime: number, color: table, ignoreZ: boolean)

    --- Displays 2D text at the specified coordinates.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param pos --- The position in 3D to display the text.
    -- @param line --- Line of text, will offset text on the to display the new line unobstructed.
    -- @param text --- The text to display.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the box. Uses the Color.
    EntityTextAtPosition: function(pos: GVector, line: number, text: string, lifetime: number, color: table)

    --- Draws a 3D grid of limited size in given position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param position ---
    Grid: function(position: GVector)

    --- Displays a coloured line at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param pos1 --- First position of the line.
    -- @param pos2 --- Second position of the line.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the line. Uses the Color.
    -- @param ignoreZ --- If true, will draw on top of everything; ignoring the Z buffer.
    Line: function(pos1: GVector, pos2: GVector, lifetime: number, color: table, ignoreZ: boolean)

    --- Displays text triangle at the specified coordinates.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param x --- The position of the text, from 0 ( left ) to 1 ( right ).
    -- @param y --- The position of the text, from 0 ( top ) to 1 ( bottom ).
    -- @param text --- The text to display.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the box. Uses the Color.
    ScreenText: function(x: number, y: number, text: string, lifetime: number, color: table)

    --- Displays a coloured sphere at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param origin --- Position origin.
    -- @param size --- Size of the sphere.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the sphere. Uses the Color.
    -- @param ignoreZ --- If true, will draw on top of everything; ignoring the Z buffer.
    Sphere: function(origin: GVector, size: number, lifetime: number, color: table, ignoreZ: boolean)

    --- Displays "swept" box, two boxes connected with lines by their vertices.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param vStart --- The start position of the box.
    -- @param vEnd --- The end position of the box.
    -- @param vMins --- The "minimum" edge of the box.
    -- @param vMaxs --- The "maximum" edge of the box.
    -- @param ang --- The angle to draw the box at.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the box. Uses the Color.
    SweptBox: function(vStart: GVector, vEnd: GVector, vMins: GVector, vMaxs: GVector, ang: GAngle, lifetime: number, color: table)

    --- Displays text at the specified position.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param origin --- Position origin.
    -- @param text --- String message to display.
    -- @param lifetime --- Number of seconds to appear.
    -- @param viewCheck --- Clip text that is obscured.
    Text: function(origin: GVector, text: string, lifetime: number, viewCheck: boolean)

    --- Displays a colored triangle at the specified coordinates.
    --- **NOTE**: This function will silently fail if the `developer` ConVar is set to `0`.
    --- It is not networked to clients, except for the listen server host.
    --- It will not work when the game is paused.
    -- @param pos1 --- First point of the triangle.
    -- @param pos2 --- Second point of the triangle.
    -- @param pos3 --- Third point of the triangle.
    -- @param lifetime --- Number of seconds to appear.
    -- @param color --- The color of the box. Uses the Color.
    -- @param ignoreZ --- If true, will draw on top of everything; ignoring the Z buffer.
    Triangle: function(pos1: GVector, pos2: GVector, pos3: GVector, lifetime: number, color: table, ignoreZ: boolean)
end


--- The derma library allows you to add custom derma controls and create & modify derma skins.
global record derma
    --- Gets the color from a Derma skin of a panel and returns default color if not found.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L222-L229)
    -- @param name ---
    -- @param pnl ---
    -- @param default --- The default color in case of failure.
    Color: function(name: string, pnl: GPanel, default: table)

    --- This is NOT a function, it's a variable containing all derma controls, registered with derma.DefineControl.
    --- Use derma.GetControlList to retrieve this list.
    --- It's a list of tables, each having 3 keys, all from derma.DefineControl arguments:
    --- * string ClassName - The class name of the panel.
    --- * string Description - The description of the panel.
    --- * string BaseClass - The base class of the panel.
    Controls: table

    --- Defines a new Derma control with an optional base.
    --- This calls vgui.Register internally, but also does the following:
    --- * Adds the control to derma.GetControlList
    --- * Adds a key "Derma" - This is returned by derma.GetControlList
    --- * Makes a global table with the name of the control (This is technically deprecated and should not be relied upon)
    --- * If reloading (i.e. called this function with name of an existing panel), updates all existing instances of panels with this name. (Updates functions, calls PANEL:PreAutoRefresh and PANEL:PostAutoRefresh, etc.)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L99-L127)
    -- @param name --- Name of the newly created control.
    -- @param description --- Description of the control.
    -- @param tab --- Table containing control methods and properties.
    -- @param base --- Derma control to base the new control off of.
    -- @return --- A table containing the new control's methods and properties.
    DefineControl: function(name: string, description: string, tab: table, base: string): table

    --- Defines a new skin so that it is usable by Derma. The default skin can be found in `garrysmod/lua/skins/default.lua`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L132-L149)
    -- @param name --- Name of the skin.
    -- @param descriptions --- Description of the skin.
    -- @param skin --- Table containing skin data.
    DefineSkin: function(name: string, descriptions: string, skin: table)

    --- Returns the derma.Controls table, a list of all derma controls registered with derma.DefineControl.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L90-L94)
    -- @return --- A listing of all available derma-based controls. See derma.Controls for structure and contents.
    GetControlList: function(): table

    --- Returns the default skin table, which can be changed with the hook GM:ForceDermaSkin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L163-L178)
    -- @return --- The default skin table.
    GetDefaultSkin: function(): table

    --- Returns the skin table of the skin with the supplied name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L183-L187)
    -- @param name --- Name of skin.
    -- @return --- The skin table.
    GetNamedSkin: function(name: string): table

    --- Returns a copy of the table containing every Derma skin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L154-L158)
    -- @return --- Table of every Derma skin.
    GetSkinTable: function(): table

    --- Clears all cached panels so that they reassess which skin they should be using.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L243-L247)
    RefreshSkins: function()

    --- Returns how many times derma.RefreshSkins has been called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L234-L238)
    -- @return --- Amount of times derma.RefreshSkins has been called.
    SkinChangeIndex: function(): number

    --- Checks if a matching hook function exists in the skin _(based on the concatenation of type and name args)_, then calls it.
    --- This function is used dynamically inside Global.Derma_Hook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L187-L200)
    -- @param type --- The type of hook to run, usually `Paint`.
    -- @param name --- The name of the hook/panel to run. Example: `Button`.
    -- @param panel --- The panel to call the hook for.
    -- @param vararg1 --- First parameter for the panel hook. i.e. width of the panel for.Paint hooks.
    -- @param vararg2 --- Second parameter for the panel hook. i.e. height of the panel for.Paint hooks.
    -- @return --- The returned variable from the skin hook.
    SkinHook: function(type: string, name: string, panel: GPanel, vararg1: any, vararg2: any): any

    --- This is NOT a function, it's a variable containing all registered via derma.DefineSkin derma skins.
    SkinList: table

    --- Returns a function to draw a specified texture of panels skin.
    --- These are usually generated via GWEN.CreateTextureBorder and similar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/derma/derma.lua#L207-L217)
    -- @param name --- The identifier of the texture.
    -- @param pnl --- Panel to get the skin of.
    -- @param fallback --- What to return if we failed to retrieve the texture.
    -- @return --- A function that is created with the GWEN library to draw a texture.
    --- <callback>
    --- <arg name="x" type="number">X coordinate for the box.</arg>
    --- <arg name="y" type="number">Y coordinate for the box.</arg>
    --- <arg name="w" type="number">Width of the box.</arg>
    --- <arg name="h" type="number">Height of the box.</arg>
    --- <arg name="clr" type="table" default="color_white">Optional color, default is white. Uses the Color.</arg>
    --- </callback>
    SkinTexture: function(name: string, pnl: GPanel, fallback: function): function
end


--- The drag'n'drop library, used internally by certain base panels to allow for drag'n'drop functionality, like spawnmenu's customizations.
global record dragndrop
    --- **INTERNAL**:
    --- Calls the receiver function of hovered panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L175-L192)
    -- @param bDoDrop --- true if the mouse was released, false if we right clicked.
    -- @param command --- The command value. This should be the ID of the clicked dropdown menu ( if right clicked, or nil ).
    -- @param mx --- The local to the panel mouse cursor X position when the click happened.
    -- @param my --- The local to the panel  mouse cursor Y position when the click happened.
    CallReceiverFunction: function(bDoDrop: boolean, command: number, mx: number, my: number)

    --- Clears all the internal drag'n'drop variables.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L6-L19)
    Clear: function()

    --- **INTERNAL**:
    --- Handles the drop action of drag'n'drop library.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L37-L76)
    Drop: function()

    --- Returns a table of currently dragged panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L162-L173)
    -- @param name --- If set, the function will return only the panels with this Panel:Droppable name.
    -- @return --- A table of all panels that are being currently dragged, if any.
    GetDroppable: function(name: string): table

    --- Allows you to capture the panel that was dropped into the game (dropped onto the root panel). This function is meant to be overridden.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L29-L35)
    HandleDroppedInGame: function()

    --- **INTERNAL**:
    --- Handles the hover think. Called from dragndrop.Think.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L557-L581)
    HoverThink: function()

    --- Returns whether the user is dragging something with the drag'n'drop system.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L21-L27)
    -- @return --- True if the user is dragging something with the drag'n'drop system.
    IsDragging: function(): boolean

    --- **INTERNAL**:
    --- Starts the drag'n'drop.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L78-L111)
    StartDragging: function()

    --- Stops the drag'n'drop and calls dragndrop.Clear.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L113-L129)
    StopDragging: function()

    --- **INTERNAL**:
    --- Handles all the drag'n'drop processes. Calls dragndrop.UpdateReceiver and dragndrop.HoverThink.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L194-L231)
    Think: function()

    --- **INTERNAL**:
    --- Updates the receiver to drop the panels onto. Called from dragndrop.Think.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/dragdrop.lua#L131-L157)
    UpdateReceiver: function()
end


--- The draw library's purpose is to simplify the usage of the surface library.
global record draw
    --- Simple draw text at position, but this will expand newlines and tabs.
    --- **NOTE**: Provides a 2D rendering context
    --- See also MarkupObject for limited width and markup support.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L119-L160)
    -- @param text --- Text to be drawn.
    -- @param font --- Name of font to draw the text in. See surface.CreateFont to create your own, or Default Fonts for a list of default fonts.
    -- @param x --- The X Coordinate.
    -- @param y --- The Y Coordinate.
    -- @param color --- Color to draw the text in. Uses the Color.
    -- @param xAlign --- Where to align the text horizontally. Uses the Enums/TEXT_ALIGN.
    DrawText: function(text: string, font: string, x: number, y: number, color: table, xAlign: number)

    --- Returns the height of the specified font in pixels. This is equivalent to the height of the character `W`. See surface.GetTextSize.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L33-L49)
    -- @param font --- Name of the font to get the height of.
    -- @return --- The font height.
    GetFontHeight: function(font: string): number

    --- Sets drawing texture to a default white texture (vgui/white) via surface.SetMaterial. Useful for resetting the drawing texture.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L312-L314)
    NoTexture: function()

    --- Draws a rounded rectangle.
    --- **NOTE**: This function actually draws rectangles with 'gui/cornerX' textures applied to it's rounded corners. It means that this function will fail (or will be drawn not as expected) with any vertex operations, such as model matrices like cam.Start3D2D (corners would be pixelated) or stencil operations. Consider using surface.DrawPoly or mesh library
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L162-L171)
    -- @param cornerRadius --- Radius of the rounded corners, works best with a multiple of 2.
    --- For values 0 or below, surface.DrawRect will be used instead for performance.
    -- @param x --- The x coordinate of the top left of the rectangle.
    -- @param y --- The y coordinate of the top left of the rectangle.
    -- @param width --- The width of the rectangle.
    -- @param height --- The height of the rectangle.
    -- @param color --- The color to fill the rectangle with. Uses the Color.
    RoundedBox: function(cornerRadius: number, x: number, y: number, width: number, height: number, color: table)

    --- Draws a rounded rectangle. This function also lets you specify which corners are drawn rounded.
    --- **NOTE**: This function actually draws rectangles with 'gui/cornerX' textures applied to it's rounded corners. It means that this function will fail (or will be drawn not as expected) with any vertex operations, such as model matrices like cam.Start3D2D (corners would be pixelated) or stencil operations. Consider using surface.DrawPoly or mesh library
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L173-L231)
    -- @param cornerRadius --- Radius of the rounded corners, works best with a power of 2 number.
    -- @param x --- The x coordinate of the top left of the rectangle.
    -- @param y --- The y coordinate of the top left of the rectangle.
    -- @param width --- The width of the rectangle.
    -- @param height --- The height of the rectangle.
    -- @param color --- The color to fill the rectangle with. Uses the Color.
    -- @param roundTopLeft --- Whether the top left corner should be rounded.
    -- @param roundTopRight --- Whether the top right corner should be rounded.
    -- @param roundBottomLeft --- Whether the bottom left corner should be rounded.
    -- @param roundBottomRight --- Whether the bottom right corner should be rounded.
    RoundedBoxEx: function(cornerRadius: number, x: number, y: number, width: number, height: number, color: table, roundTopLeft: boolean, roundTopRight: boolean, roundBottomLeft: boolean, roundBottomRight: boolean)

    --- Draws text on the screen.
    --- **NOTE**: This function does not handle newlines properly. See draw.DrawText for a function that does.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L51-L94)
    -- @param text --- The text to be drawn.
    -- @param font --- The font. See surface.CreateFont to create your own, or see Default Fonts for a list of default fonts.
    -- @param x --- The X Coordinate.
    -- @param y --- The Y Coordinate.
    -- @param color --- The color of the text. Uses the Color.
    -- @param xAlign --- The alignment of the X coordinate using Enums/TEXT_ALIGN.
    -- @param yAlign --- The alignment of the Y coordinate using Enums/TEXT_ALIGN.
    -- @return --- The width of the text. Same value as if you were calling surface.GetTextSize.
    -- @return --- The height of the text. Same value as if you were calling surface.GetTextSize.
    SimpleText: function(text: string, font: string, x: number, y: number, color: table, xAlign: number, yAlign: number): number, number

    --- Creates a simple line of text that is outlined.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L96-L114)
    -- @param Text --- The text to draw.
    -- @param font --- The font name to draw with. See surface.CreateFont to create your own, or here for a list of default fonts.
    -- @param x --- The X Coordinate.
    -- @param y --- The Y Coordinate.
    -- @param color --- The color of the text. Uses the Color.
    -- @param xAlign --- The alignment of the X Coordinate using Enums/TEXT_ALIGN.
    -- @param yAlign --- The alignment of the Y Coordinate using Enums/TEXT_ALIGN.
    -- @param outlinewidth --- Width of the outline.
    -- @param outlinecolor --- Color of the outline. Uses the Color.
    -- @return --- The width of the text. Same value as if you were calling surface.GetTextSize.
    -- @return --- The height of the text. Same value as if you were calling surface.GetTextSize.
    SimpleTextOutlined: function(Text: string, font: string, x: number, y: number, color: table, xAlign: number, yAlign: number, outlinewidth: number, outlinecolor: table): number, number

    --- Works like draw.SimpleText but uses a table structure instead.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L269-L273)
    -- @param textdata --- The text properties. See the Structures/TextData
    -- @return --- Width of drawn text.
    -- @return --- Height of drawn text.
    Text: function(textdata: table): number, number

    --- Works like draw.Text, but draws the text with a shadow.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L279-L295)
    -- @param textdata --- The text properties. See Structures/TextData.
    -- @param distance --- How far away the shadow appears.
    -- @param alpha --- How visible the shadow is (0-255).
    -- @return textWidth --- The width of drawn text.
    -- @return textHeight --- The height of drawn text.
    TextShadow: function(textdata: table, distance: number, alpha: number): number, number

    --- Draws a texture with a table structure.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L302-L310)
    -- @param texturedata --- The texture properties. See Structures/TextureData.
    TexturedQuad: function(texturedata: table)

    --- Draws a rounded box with text in it.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/draw.lua#L238-L263)
    -- @param bordersize --- Size of border, should be multiple of 2. Ideally this will be 8 or 16.
    -- @param x --- The X Coordinate.
    -- @param y --- The Y Coordinate.
    -- @param text --- Text to draw.
    -- @param font --- Font to draw in. See surface.CreateFont to create your own, or here for a list of default fonts.
    -- @param boxcolor --- The box color. Uses the Color.
    -- @param textcolor --- The text color. Uses the Color.
    -- @param xalign --- The alignment of the X coordinate using Enums/TEXT_ALIGN.
    -- @param yalign --- The alignment of the Y coordinate using Enums/TEXT_ALIGN.
    -- @return --- The width of the word box.
    -- @return --- The height of the word box.
    WordBox: function(bordersize: number, x: number, y: number, text: string, font: string, boxcolor: table, textcolor: table, xalign: number, yalign: number): number, number
end


--- The drive library is for adding custom control modes to the new "remote control" entity piloting system in Garry's Mod 13. See Entity Driving.
global record drive
    --- **INTERNAL**:
    --- Used internally to make DRIVE:CalcView work, called by default from `base` gamemode's GM:CalcView hook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L154-L162)
    -- @param ply --- The player.
    -- @param view --- The view, see Structures/ViewData.
    -- @return --- True if succeeded.
    CalcView: function(ply: GPlayer, view: S_ViewData): boolean

    --- **INTERNAL**:
    --- Clientside, the client creates the cmd (usercommand) from their input device (mouse, keyboard) and then it's sent to the server. Restrict view angles here.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L141-L149)
    -- @param cmd --- The user command.
    -- @return --- True if succeeded.
    CreateMove: function(cmd: GCUserCmd): boolean

    --- **INTERNAL**:
    --- Destroys players current driving method.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L103-L109)
    -- @param ply --- The player to affect.
    DestroyMethod: function(ply: GPlayer)

    --- Player has stopped driving the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L214-L240)
    -- @param ply --- The player.
    -- @param ent --- The entity.
    End: function(ply: GPlayer, ent: GEntity)

    --- **INTERNAL**:
    --- The move is finished. Copy mv back into the target.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L196-L209)
    -- @param ply --- The player.
    -- @param mv --- The move data.
    -- @return --- True if succeeded.
    FinishMove: function(ply: GPlayer, mv: GCMoveData): boolean

    --- **INTERNAL**:
    --- Returns ( or creates if inexistent ) a driving method.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L56-L101)
    -- @param ply --- The player.
    -- @return --- A method object.
    GetMethod: function(ply: GPlayer): table

    --- **INTERNAL**:
    --- The move is executed here.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L183-L191)
    -- @param ply --- The player.
    -- @param mv --- The move data.
    -- @return --- True if succeeded.
    Move: function(ply: GPlayer, mv: GCMoveData): boolean

    --- Starts driving for the player.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L39-L48)
    -- @param ply --- The player to affect.
    -- @param ent --- The entity to drive.
    -- @param mode --- The driving mode.
    PlayerStartDriving: function(ply: GPlayer, ent: GEntity, mode: string)

    --- Stops the player from driving anything. ( For example a prop in sandbox )
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L50-L54)
    -- @param ply --- The player to affect.
    PlayerStopDriving: function(ply: GPlayer)

    --- Registers a new entity drive mode/method.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L14-L37)
    -- @param name --- The name of the drive mode/method.
    -- @param data --- The data required to create the drive mode/method. This includes the functions used by the drive. See DRIVE_Hooks.
    -- @param base --- The name of a drive mode/method to inherit code from.
    Register: function(name: string, data: table, base: string)

    --- Called when the player first starts driving this entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L114-L134)
    -- @param ply --- The player.
    -- @param ent --- The entity.
    Start: function(ply: GPlayer, ent: GEntity)

    --- **INTERNAL**:
    --- The user command is received by the server and then converted into a move. This is also run clientside when in multiplayer, for prediction to work.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/drive.lua#L169-L177)
    -- @param ply --- The player.
    -- @param mv --- The move data.
    -- @param cmd --- The user command.
    -- @return --- True if succeeded.
    StartMove: function(ply: GPlayer, mv: GCMoveData, cmd: GCUserCmd): boolean
end


--- The duplicator library allows you to specify what should be saved when someone attempts to duplicate your custom entity with the duplicator tool. It can also be used by 3rd party duplicator tools to make use of the built in system.
global record duplicator
    --- Allow entities with given class name to be duplicated. See duplicator.Disallow for the opposite effect.
    --- duplicator.IsAllowed can be used to poll the status of a particular entity class.
    --- `duplicator.Allow` is automatically called by scripted_ents.Register and weapons.Register, unless the associated entity table has `ENT.DisableDuplicator` set to `true`.
    --- This is also automatically called by duplicator.RegisterEntityClass.
    --- In addition to that most spawnmenu content, such as engine weapons and pickup-ables, as well as most engine NPCs in Sandbox-derived gamemodes are also allowed by default.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L331-L335)
    -- @param classname --- An entity's classname to allow duplicating.
    Allow: function(classname: string)

    --- Calls every function registered with duplicator.RegisterBoneModifier on each bone the ent has.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L885-L912)
    -- @param ply --- The player whose entity this is.
    -- @param ent --- The entity in question.
    ApplyBoneModifiers: function(ply: GPlayer, ent: GEntity)

    --- Calls every function registered with duplicator.RegisterEntityModifier on the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L865-L879)
    -- @param ply --- The player whose entity this is.
    -- @param ent --- The entity in question.
    ApplyEntityModifiers: function(ply: GPlayer, ent: GEntity)

    --- A list of all entity bone modifiers registered with duplicator.RegisterBoneModifier.
    BoneModifiers: table

    --- Clears/removes the chosen entity modifier from the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L527-L534)
    -- @param ent --- The entity the modification is stored on.
    -- @param key --- The key of the stored entity modifier.
    ClearEntityModifier: function(ent: GEntity, key: any)

    --- A list of all constraints that can be duplicated. Registered with duplicator.RegisterConstraint.
    ConstraintType: table

    --- Copies the entity, and all of its constraints and entities, then returns them in a table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L615-L645)
    -- @param ent --- The entity to duplicate. The function will automatically copy all constrained entities.
    -- @param tableToAdd --- A preexisting table to add entities and constraints in from.
    --- Uses the same table format as the table returned from this function.
    -- @return --- A table containing duplication info which includes the following members:
    --- * table Entities
    --- * table Constraints
    --- * Vector Mins
    --- * Vector Maxs
    --- The values of Mins & Maxs from the table are returned from duplicator.WorkoutSize.
    Copy: function(ent: GEntity, tableToAdd: table): table

    --- Returns a table with some entity data that can be used to create a new entity with duplicator.CreateEntityFromTable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L558-L564)
    -- @param ent --- The entity table to save.
    -- @return --- See Structures/EntityCopyData.
    CopyEntTable: function(ent: GEntity): table

    --- Copies the passed table of entities to save for later.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L647-L659)
    -- @param ents --- A table of entities to save/copy.
    -- @return --- A table containing duplication info which includes the following members:
    --- * table Entities
    --- * table Constraints
    --- * Vector Mins
    --- * Vector Maxs
    CopyEnts: function(ents: table): table

    --- **INTERNAL**:
    ---  Creates a constraint from a saved/copied constraint table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L726-L791)
    -- @param constraint --- Saved/copied constraint table.
    -- @param entityList --- The list of entities that are to be constrained.
    -- @return --- The newly created constraint entity, if any.
    --- For example, an entity of class `phys_pulleyconstraint` or `phys_spring`, etc., the functional entity of the constraint.
    -- @return --- The second constraint related entity, if any.
    --- For a most constraints, this would be a `keyframe_rope` for the visual part of a constraint.
    -- @return --- The third constraint related entity, if any.
    --- For example, a Hydraulic constraint would return the `gmod_winch_controller` entity here. A pulley would have another `keyframe_rope`.
    -- @return --- The fourth constraint related entity, if any.
    --- For example, a Hydraulic constraint would return the `phys_slideconstraint` entity here. A pulley would have yet another `keyframe_rope`.
    CreateConstraintFromTable: function(constraint: table, entityList: table): GEntity, GEntity, GEntity, GEntity

    --- "Create an entity from a table."
    --- This creates an entity using the data in EntTable.
    --- If an entity factory has been registered for the entity's Class, it will be called.
    --- Otherwise, duplicator.GenericDuplicatorFunction will be called instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L664-L716)
    -- @param ply --- The player who wants to create something.
    -- @param entTable --- The duplication data to build the entity with. See Structures/EntityCopyData.
    -- @return --- The newly created entity.
    CreateEntityFromTable: function(ply: GPlayer, entTable: table): GEntity

    --- Disallow this entity to be duplicated. Opposite of duplicator.Allow.
    --- This function is useful for temporarily disabling duplication of certain entity classes that may have been previously allowed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L340-L344)
    -- @param classname --- An entity's classname to disallow duplicating.
    Disallow: function(classname: string)

    --- "Restores the bone's data."
    --- Loops through Bones and calls Entity:ManipulateBoneScale, Entity:ManipulateBoneAngles and Entity:ManipulateBonePosition on ent with the table keys and the subtable values s, a and p respectively.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L454-L467)
    -- @param ent --- The entity to be bone manipulated.
    -- @param bones --- Table with a Structures/BoneManipulationData for every bone (that has manipulations applied) using the bone ID as the table index.
    DoBoneManipulator: function(ent: GEntity, bones: table)

    --- Restores the flex data using Entity:SetFlexWeight and Entity:SetFlexScale.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L436-L449)
    -- @param ent --- The entity to restore the flexes on.
    -- @param flex --- The flexes to restore.
    -- @param scale --- The flex scale to apply. (Flex scale is unchanged if omitted)
    DoFlex: function(ent: GEntity, flex: table, scale: number)

    --- "Applies generic every-day entity stuff for ent from table data."
    --- Depending on the values of Model, Angle, Pos, Skin, Flex, Bonemanip, ModelScale, ColGroup, Name, and BodyG (table of multiple values) in the data table, this calls Entity:SetModel, Entity:SetAngles, Entity:SetPos, Entity:SetSkin, duplicator.DoFlex, duplicator.DoBoneManipulator, Entity:SetModelScale, Entity:SetCollisionGroup, Entity:SetName, Entity:SetBodygroup on ent.
    --- If ent has a RestoreNetworkVars function, it is called with data.DT.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L1044-L1048)
    -- @param ent --- The entity to be applied upon.
    -- @param data --- The data to be applied onto the entity.
    DoGeneric: function(ent: GEntity, data: table)

    --- "Applies bone data, generically."
    --- If data contains a PhysicsObjects table, it moves, re-angles and if relevent freezes all specified bones, first converting from local coordinates to world coordinates.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L1036-L1042)
    -- @param ent --- The entity to be applied upon.
    -- @param ply --- The player who owns the entity. Unused in function as of early 2013.
    -- @param data --- The data to be applied onto the entity.
    DoGenericPhysics: function(ent: GEntity, ply: GPlayer, data: table)

    --- A list of all entity classes have a custom duplication spawn function. Registered with duplicator.RegisterEntityClass.
    --- If you wish to get a specific entity class table, use duplicator.FindEntityClass.
    EntityClasses: table

    --- A list of all entity modifiers registered with duplicator.RegisterEntityModifier.
    EntityModifiers: table

    --- Checks the given duplication table and tries to figure out any addons that might be required to correctly spawn the duplication. Currently this is limited to models and material overrides saved in the duplication.
    -- @param dupe --- The duplication table to process, for example from duplicator.Copy.
    --- The provided table will have `RequiredAddons` key added.
    FigureOutRequiredAddons: function(dupe: table)

    --- Returns the entity class factory registered with duplicator.RegisterEntityClass.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L395-L400)
    -- @param name --- The name of the entity class factory.
    -- @return --- Is compromised of the following members:
    --- * function Func - The function that creates the entity.
    --- * table Args - Arguments to pass to the function.
    FindEntityClass: function(name: string): table

    --- "Generic function for duplicating stuff"
    --- This is called when duplicator.CreateEntityFromTable can't find an entity factory to build with. It calls duplicator.DoGeneric and duplicator.DoGenericPhysics to apply standard duplicator stored things such as the model and position.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L472-L505)
    -- @param ply --- The player who wants to create something.
    -- @param data --- The duplication data to build the entity with.
    -- @return --- The newly created entity.
    GenericDuplicatorFunction: function(ply: GPlayer, data: table): GEntity

    --- **INTERNAL**:
    ---  Fills entStorageTable with all of the entities in a group connected with constraints. Fills constraintStorageTable with all of the constraints constraining the group.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L921-L969)
    -- @param ent --- The entity to start from
    -- @param entStorageTable --- The table the entities will be inserted into.
    -- @param constraintStorageTable --- The table the constraints will be inserted into.
    -- @return --- entStorageTable
    -- @return --- constraintStorageTable
    GetAllConstrainedEntitiesAndConstraints: function(ent: GEntity, entStorageTable: table, constraintStorageTable: table): table, table

    --- Returns whether the entity can be duplicated or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L349-L353)
    -- @param classname --- An entity's classname.
    -- @return --- Returns true if the entity can be duplicated (nil otherwise).
    IsAllowed: function(classname: string): boolean

    --- "Given entity list and constraint list, create all entities and return their tables"
    --- Calls duplicator.CreateEntityFromTable on each sub-table of EntityList. If an entity is actually created, it calls ENTITY:OnDuplicated with the entity's duplicator data, then duplicator.ApplyEntityModifiers, duplicator.ApplyBoneModifiers and finally  ENTITY:PostEntityPaste is called.
    --- The constraints are then created with duplicator.CreateConstraintFromTable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L769-L859)
    -- @param Player --- The player who wants to create something.
    -- @param EntityList --- A table of duplicator data to create the entities from.
    -- @param ConstraintList --- A table of duplicator data to create the constraints from.
    -- @return --- List of created entities.
    -- @return --- List of created constraints.
    Paste: function(Player: GPlayer, EntityList: table, ConstraintList: table): table, table

    --- Registers a function to be called on each of an entity's bones when duplicator.ApplyBoneModifiers is called.
    --- **NOTE**: This function is available to call on the client, but registered functions aren't used anywhere!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L405)
    -- @param key --- The type of the key doesn't appear to matter, but it is preferable to use a string.
    -- @param boneModifier --- Function called on each bone that an ent has. Called during duplicator.ApplyBoneModifiers.
    --- <callback>
    --- <arg type="Player" name="ply">The player that is spawning the entity.</arg>
    --- <arg type="Entity" name="ent">The entity being spawned in.</arg>
    --- <arg type="number" name="boneID"></arg>
    --- <arg type="PhysObj" name="bone"></arg>
    --- <arg type="table" name="data">What you pass to duplicator.StoreBoneModifier.</arg>
    --- </callback>
    RegisterBoneModifier: function(key: any, boneModifier: function)

    --- Register a function used for creating a duplicator-supported constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L367-L374)
    -- @param name --- The unique name of the new constraint. It will be used to identify which constraint to apply on duplicator load.
    -- @param callback --- Function to be called when this constraint is created.
    --- It is a good idea to check constraint.CanConstrain before doing anything else.
    --- You must also call constraint.AddConstraintTable if creating custom constraint entities.
    --- * This is what stores the constraint for duplicator to save and load, as well as for constraint.GetTable.
    --- * The constraint entity must have `Type` key on it. This means that a single entity can only represent one constraint.
    --- Optionally, the callback can return up to 4 entities, which are considered the "constraint" entities.
    --- * Each of those is added to `"ropeconstraints"` or `"constraints"` cleanup list based on entity's classname (Player:AddCleanup)
    --- * The first entity is added to the player's entity count (Player:AddCount) in Sandbox.
    --- * None of these entities **should** be the 2 entities being constraint (i.e. a `prop_physics`), but it can be one one of them if you know what you are doing.
    -- @param customData --- Arguments to be passed to the callback function when the constraint is created via duplicator.CreateConstraintFromTable.
    --- The data would be taken the constraint entity table added via constraint.AddConstraintTable. All constraint library constraints call it on the appropriate entity for you. (Typically its the first entity returned by the callback)
    RegisterConstraint: function(name: string, callback: function, ...: any)

    --- This allows you to specify a specific function to be run when your SENT is pasted with the duplicator, instead of relying on the generic automatic functions.
    --- **NOTE**: Automatically calls duplicator.Allow for the entity class.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L381-L390)
    -- @param name --- The ClassName of the entity you wish to register a factory for.
    -- @param function --- The factory function you want to have called.
    --- <callback>
    --- <arg type="Player" name="ply">The player that is spawning the entity.</arg>
    --- <arg type="vararg" name="...">Whatever arguments you request to be passed.</arg>
    --- <ret type="Entity" name="ent">It also should return the entity created, otherwise duplicator.Paste result will not include it!</ret>
    --- </callback>
    -- @param args --- Strings of the names of arguments you want passed to function the from the Structures/EntityCopyData. As a special case, "Data" will pass the whole structure.
    RegisterEntityClass: function(name: string, _function: function, ...: any)

    --- This allows you to register tweaks to entities. For instance, if you were making an "unbreakable" addon, you would use this to enable saving the "unbreakable" state of entities between duplications.
    --- This function registers a piece of generic code that is run on all entities with this modifier. In order to have it actually run, use duplicator.StoreEntityModifier.
    --- This function does nothing when run clientside.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L406)
    -- @param name --- An identifier for your modification. This is not limited, so be verbose. `Person's 'Unbreakable' mod` is far less likely to cause conflicts than `unbreakable`.
    -- @param func --- The function to be called for your modification.
    --- <callback>
    --- <arg type="Player" name="ply">The player that is spawning the entity.</arg>
    --- <arg type="Entity" name="ent">The entity being spawned in.</arg>
    --- <arg type="table" name="data">What you pass to duplicator.StoreEntityModifier.</arg>
    --- </callback>
    RegisterEntityModifier: function(name: string, func: function)

    --- Help to remove certain map created entities before creating the saved entities
    --- This is obviously so we don't get duplicate props everywhere.
    --- It should be called before calling Paste.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L993-L1003)
    RemoveMapCreatedEntities: function()

    --- "When a copy is copied it will be translated according to these.
    --- If you set them - make sure to set them back to 0 0 0!"
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L362)
    -- @param v --- The angle to offset all pastes from.
    SetLocalAng: function(v: GAngle)

    --- "When a copy is copied it will be translated according to these.
    --- If you set them - make sure to set them back to 0 0 0!"
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L361)
    -- @param v --- The position to offset all pastes from.
    SetLocalPos: function(v: GVector)

    --- Stores bone mod data for a registered bone modification function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L539-L553)
    -- @param ent --- The entity to add bone mod data to.
    -- @param boneID --- The bone ID.
    --- See Entity:GetPhysicsObjectNum.
    -- @param key --- The key for the bone modification.
    -- @param data --- The bone modification data that is passed to the bone modification function.
    StoreBoneModifier: function(ent: GEntity, boneID: number, key: any, data: table)

    --- Stores an entity modifier into an entity for saving.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L510-L522)
    -- @param entity --- The entity to store modifier in.
    -- @param name --- Unique modifier name as defined in duplicator.RegisterEntityModifier.
    -- @param data --- Modifier data.
    StoreEntityModifier: function(entity: GEntity, name: string, data: table)

    --- Works out the AABB size of the duplication.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/duplicator.lua#L569-L609)
    -- @param Ents --- A table of entity duplication datums.
    -- @return Mins --- AABB mins vector.
    -- @return Maxs --- AABB maxs vector.
    WorkoutSize: function(Ents: table): GVector, GVector
end


--- The effects library allows you to manually add scripted effects.
global record effects
    --- Creates a "beam ring point" effect.
    -- @param pos --- The origin position of the effect.
    -- @param lifetime --- How long the effect will be drawing for, in seconds.
    -- @param startRad --- Initial radius of the effect.
    -- @param endRad --- Final radius of the effect, at the end of the effect's lifetime.
    -- @param width --- How thick the beam should be.
    -- @param amplitude --- How noisy the beam should be.
    -- @param color --- Beam's Global.Color.
    -- @param extra --- Extra info, all optional. A table with the following keys: (any combination)
    --- * number speed - ?
    --- * number spread - ?
    --- * number delay - Delay in seconds after which the effect should appear.
    --- * number flags- Beam flags.
    --- * number framerate - texture framerate.
    --- * string material - The material to use instead of the default one.
    BeamRingPoint: function(pos: GVector, lifetime: number, startRad: number, endRad: number, width: number, amplitude: number, color: table, extra: table)

    --- Creates a bubble trail effect, the very same you get when shooting underwater.
    -- @param startPos --- The start position of the effect.
    -- @param endPos --- The end position of the effects.
    -- @param count --- How many bubbles to spawn. There's a hard limit of 500 tempents at any time.
    -- @param height --- How high the bubbles can fly up before disappearing.
    -- @param speed --- How quickly the bubbles move.
    -- @param delay --- Delay in seconds after the function call and before the effect actually spawns.
    BubbleTrail: function(startPos: GVector, endPos: GVector, count: number, height: number, speed: number, delay: number)

    --- Creates a bunch of bubbles inside a defined box.
    -- @param mins --- The lowest extents of the box.
    -- @param maxs --- The highest extents of the box.
    -- @param count --- How many bubbles to spawn. There's a hard limit of 500 tempents at any time.
    -- @param height --- How high the bubbles can fly up before disappearing.
    -- @param speed --- How quickly the bubbles move.
    -- @param delay --- Delay in seconds after the function call and before the effect actually spawns.
    Bubbles: function(mins: GVector, maxs: GVector, count: number, height: number, speed: number, delay: number)

    --- **INTERNAL**: You are looking for util.Effect.
    --- Returns the table of the effect specified.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/effects.lua#L51-L71)
    -- @param name --- Effect name.
    -- @return --- The effect table.
    Create: function(name: string): table

    --- **INTERNAL**:
    --- Returns a list of all Lua-defined effects.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/effects.lua#L73-L81)
    -- @return --- The effects table.
    GetList: function(): table

    --- **INTERNAL**:
    --- Registers a new effect.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/effects.lua#L18-L45)
    -- @param effect_table --- Effect table.
    -- @param name --- Effect name.
    Register: function(effect_table: table, name: string)

    --- Imitates the "near miss" tracer sound, with the ability to override the sound played.
    --- The frequency of the sound is limited internally, as to not overwhelm the player. (same as normal tracers)
    -- @param start --- Start position of the tracer.
    -- @param endpos --- End position of the tracer.
    -- @param tracerType --- Tracer type. Acceptable values are:
    --- * 1 - Normal bullet.
    --- * 2 - Gunship bullet.
    --- * 4 - Strider bullet.
    --- * 8 - Underwater bullet.
    --- This affects the default sound, as well as the distance from which the sound can be heard compared to the closest point on the tracer line to the player's eyes.
    -- @param soundOverride --- If set, this sound will be played instead of the default sound.
    TracerSound: function(start: GVector, endpos: GVector, tracerType: number, soundOverride: string)
end


--- The engine library provides functions to access various features in the game's engine, most are related to the demo and save systems.
global record engine
    --- Returns non paused Global.FrameTime.
    -- @return --- Frame time.
    AbsoluteFrameTime: function(): number

    --- Returns the name of the currently running gamemode.
    -- @return --- The active gamemode's name. This is the name of the gamemode's folder.
    ActiveGamemode: function(): string

    --- Closes the server and completely exits.
    --- To enable this function for use on your server, add `-allowquit` to your commandline, which will make this function run `quit keep_players` when executed, this also does not forcibly disconnect players.
    --- This is also available when running in server test mode (launch option `-systemtest`). Server test mode is used internally at Facepunch as part of the build process to make sure that the dedicated servers aren't crashing on startup.
    CloseServer: function()

    --- Returns a list of addons the player have subscribed to on the workshop.
    --- This list will also include "Floating" .gma addons that are mounted by the game, but not the folder addons.
    -- @return --- A table of tables containing 8 keys (downloaded, models, title, file, mounted, wsid, size, updated).
    GetAddons: function(): table

    --- When starting playing a demo, engine.GetDemoPlaybackTick will be reset and its old value will be added to this functions return value.
    -- @return ---
    GetDemoPlaybackStartTick: function(): number

    --- Current tick of currently loaded demo.
    --- If not playing a demo, it will return amount of ticks since last demo playback.
    -- @return --- The amount of ticks of currently loaded demo.
    GetDemoPlaybackTick: function(): number

    --- Returns time scale of demo playback.
    --- If not during demo playback, returns 1.
    -- @return --- The time scale of demo playback, value of demo_timescale console variable.
    GetDemoPlaybackTimeScale: function(): number

    --- Returns total amount of ticks of currently loaded demo.
    --- If not playing a demo, returns 0 or the value of last played demo.
    -- @return --- Total amount of ticks of currently loaded demo.
    GetDemoPlaybackTotalTicks: function(): number

    --- Returns a table containing info for all installed gamemodes.
    -- @return --- The gamemodes.
    GetGamemodes: function(): table

    --- Returns an array of tables corresponding to all games from which Garry's Mod supports mounting content.
    -- @return --- A table of tables containing all mountable games.
    GetGames: function(): table

    --- @deprecated
    --- **DEPRECATED**: Used internally for in-game menus, may be merged in the future into engine.GetAddons.
    --- Returns the UGC (demos, saves and dupes) the player have subscribed to on the workshop.
    -- @return --- Returns a table with 5 keys (title, type, tags, wsid, timeadded).
    GetUserContent: function(): table

    --- Returns true if we're currently playing a demo.
    --- You will notice that there's no server-side version of this. That's because there is no server when playing a demo. Demos are both recorded and played back purely clientside.
    -- @return --- Whether the game is currently playing a demo or not.
    IsPlayingDemo: function(): boolean

    --- Returns true if the game is currently recording a demo file (.dem) using gm_demo.
    -- @return --- Whether the game is currently recording a demo or not.
    IsRecordingDemo: function(): boolean

    --- This is a direct binding to the function `engine->LightStyle`. This function allows you to change the default light style of the map - so you can make lighting lighter or darker. You’ll need to call render.RedownloadAllLightmaps clientside to refresh the lightmaps to this new color.
    --- **BUG**: [Calling this function with arguments 0 and "a" will cause dynamic lights such as those produced by the Light tool to stop working.](https://github.com/Facepunch/garrysmod-issues/issues/3626
    -- @param lightstyle --- The lightstyle to edit. 0 to 63. If you want to edit map lighting, you want to set this to 0.
    -- @param pattern --- The pattern to change the lightstyle to. `a` is the darkest, `z` is the brightest. You can use stuff like "abcxyz" to make flashing patterns. The normal brightness for a map is `m`. Values over `z` are allowed, `~` for instance.
    LightStyle: function(lightstyle: number, pattern: string)

    --- Loads a duplication from the local filesystem.
    -- @param dupeName --- Name of the file. (e.g, `engine.OpenDupe("dupes/8b809dd7a1a9a375e75be01cdc12e61f.dupe")`).
    -- @return --- A table with a simple field:
    --- * string `data` - Compressed dupe data. Use util.JSONToTable to make it into a format useable by the duplicator tool.
    OpenDupe: function(dupeName: string): table

    --- Returns an estimate of the server's performance. Equivalent to calling Global.FrameTime from the server, according to source code.
    -- @return --- Frame time.
    -- @return --- Server framerate [standard deviation](https://en.wikipedia.org/wiki/Standard_deviation).
    ServerFrameTime: function(): number, number



    --- Returns the number of ticks since the game server started.
    -- @return --- Number of ticks since the game server started.
    TickCount: function(): number

    --- Returns the time interval between each game tick in seconds.
    --- This function is useful for making animations (usually serverside, such as doors rotating) and similar things to be independent of the tickrate in hooks that run at the tick rate, such as GM:Tick.
    --- Clientside you'd want to use Global.FrameTime for this purpose in hooks that run every frame.
    --- The default tickrate is `66.6666`, aka `15` milliseconds interval between each game tick.
    --- The tickrate can be adjusted via the `-tickrate` [command line option](Command_Line_Parameters).
    -- @return --- Number of seconds between each gametick.
    TickInterval: function(): number

    --- **INTERNAL**:
    --- Returns video recording settings set by video.Record. Used by Demo-To-Video feature.
    -- @return --- The video recording settings, see Structures/VideoData.
    VideoSettings: function(): table

    --- **INTERNAL**: Do not use.
    --- Saves a duplication as a file.
    -- @param dupe --- Dupe table, encoded by util.TableToJSON and compressed by util.Compress.
    -- @param jpeg --- The dupe icon, created by render.Capture.
    WriteDupe: function(dupe: string, jpeg: string)

    --- **INTERNAL**: Do not use.
    --- Stores savedata into the game. (can be loaded using the LoadGame menu)
    -- @param saveData --- Data generated by gmsave.SaveMap.
    -- @param name --- Name the save will have.
    WriteSave: function(saveData: string, name: string)
end


--- The ents library provides functions for creating and finding entities in the game.
global record ents
    --- Creates an entity. This function will fail and return `NULL` if the networked-edict limit is hit (around **8176**), or the provided entity class doesn't exist.
    --- **WARNING**: Do not use before GM:InitPostEntity has been called, otherwise the server will crash!
    --- If you need to perform entity creation when the game starts, create a hook for GM:InitPostEntity and do it there.
    -- @param class --- The classname of the entity to create.
    -- @return --- The created entity, or `NULL` if failed.
    Create: function(class: string): GEntity

    --- Creates a clientside only prop with optional physics. See also Global.ClientsideModel if physics is not needed.
    --- For physics to work you're expected to use the `model` argument. A simple Entity:SetModel will not be enough — the Entity:PhysicsInit* function will be needed.
    --- **BUG**: [Parented clientside prop will become detached if the parent entity leaves the PVS. **A workaround is available on its github page.**](https://github.com/Facepunch/garrysmod-issues/issues/861
    -- @param model --- The model for the entity to be created.
    -- @return --- Created entity (`C_PhysPropClientside`).
    CreateClientProp: function(model: string): GEntity

    --- Creates a clientside only rope, similar to those used by the Dog and Fast Zombie models from Half-Life 2.
    --- Created ropes will be automatically cleaned up when one of the attached entities is removed.
    --- **WARNING**: It doesn’t work exactly the same way as constraint.CreateKeyframeRope or constraint.Rope, you can see it when you try to use Slack with constraint.CreateKeyframeRope or addlength on constraint.Rope.
    -- @param ent1 --- The first entity to attach the rope to.
    -- @param ent1attach --- The attachment ID on the first entity to attach the rope to, or a local Vector relative to the first entity.
    -- @param ent2 --- The second entity to attach the rope to.
    -- @param ent2attach --- The attachment ID on the second entity to attach the rope to, or a local Vector relative to the second entity.
    -- @param extra --- Extra optional settings for the rope. Possible values are:
    --- * slack - How much extra rope to add to the length. (default: 0)
    --- * width - Width of the rope. (default: 2)
    --- * segments - How many segments the rope should have (default: 8, valid range is [2,10])
    --- * material - Which material should the rope have. (default: `"cable/cable"`)
    --- * nogravity - If set, the rope should have no gravity. (default: 0)
    -- @return --- Created entity (`C_RopeKeyframe`).
    CreateClientRope: function(ent1: GEntity, ent1attach: number|GVector, ent2: GEntity, ent2attach: number|GVector, extra: table): GEntity

    --- Creates a clientside only scripted entity. The scripted entity must be of "anim" type.
    -- @param class --- The class name of the entity to create.
    -- @return --- Created entity.
    CreateClientside: function(class: string): GEntity

    --- Returns a table of all entities along the ray. The ray does not stop on collisions, meaning it will go through walls/entities.
    --- This function is capable of detecting clientside only entities by default.
    --- This internally uses [spatial partitioning](https://en.wikipedia.org/wiki/Space_partitioning) to avoid looping through all entities.
    -- @param start --- The start position of the ray.
    -- @param end --- The end position of the ray.
    -- @param mins --- The mins corner of the ray.
    -- @param maxs --- The maxs corner of the ray.
    -- @return --- Table of the found entities. There's a limit of 1024 entities.
    FindAlongRay: function(start: GVector, _end: GVector, mins: GVector, maxs: GVector): {GEntity}

    --- Gets all entities with the given class, supports wildcards.
    --- This function returns a sequential table, meaning it should be looped with Global.ipairs instead of Global.pairs for efficiency reasons.
    --- This works internally by iterating over ents.GetAll. `ents.FindByClass` is always faster than ents.GetAll or ents.Iterator.
    -- @param class --- The class of the entities to find, supports wildcards.
    --- Asterisks (`*`) are the only wildcard supported.
    -- @return --- A table containing all found entities.
    FindByClass: function(class: string): {GEntity}

    --- Finds all entities that are of given class and are children of given entity. This works internally by iterating over ents.FindByClass.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/ents.lua#L2-L26)
    -- @param class --- The class of entities to search for.
    -- @param parent --- Parent of entities that are being searched for.
    -- @return --- A table of found entities or nil if none are found.
    FindByClassAndParent: function(class: string, parent: GEntity): {GEntity}

    --- Gets all entities with the given model, supports wildcards.
    --- This works internally by iterating over ents.GetAll.
    -- @param model --- The model of the entities to find.
    -- @return --- A table of all found entities.
    FindByModel: function(model: string): {GEntity}

    --- Gets all entities with the given hammer targetname. This works internally by iterating over ents.GetAll.
    --- Doesn't do anything on client.
    -- @param name --- The targetname to look for.
    -- @return --- A table of all found entities.
    FindByName: function(name: string): {GEntity}

    --- Returns all entities within the specified box.
    --- This internally uses a Spatial Partition to avoid looping through all entities, so it is more efficient than using ents.GetAll for this purpose.
    --- **NOTE**: Clientside entities will not be returned by this function. Serverside only entities without networked edicts (entity indexes), such as point logic or Constraints are not returned either
    -- @param boxMins --- The box minimum coordinates.
    -- @param boxMaxs --- The box maximum coordinates.
    -- @return --- A table of all found entities.
    FindInBox: function(boxMins: GVector, boxMaxs: GVector): {GEntity}

    --- Finds and returns all entities within the specified cone. Only entities whose Entity:WorldSpaceCenter is within the cone are considered to be in it.
    --- The "cone" is actually a conical "slice" of an axis-aligned box (see: ents.FindInBox). The image to the right shows approximately how this function would look in 2D. Due to this, the entity may be farther than the specified range!
    --- **NOTE**: Clientside entities will not be returned by this function.
    -- @param origin --- The tip of the cone.
    -- @param normal --- Direction of the cone.
    -- @param range --- The range of the cone/box around the origin.
    --- **NOTE**: The function internally adds 1 to this argument before using it.
    -- @param angle_cos --- The cosine of the angle between the center of the cone to its edges, which is half the overall angle of the cone.
    --- 1 makes a 0° cone, 0.707 makes approximately 90°, 0 makes 180°, and so on.
    -- @return --- A table of all found Entitys.
    FindInCone: function(origin: GVector, normal: GVector, range: number, angle_cos: number): {GEntity}

    --- Finds all entities that lie within a [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community").
    --- **NOTE**: The function won't take in to account Global.AddOriginToPVS and the like.
    -- @param viewPoint --- Entity or Vector to find entities within the PVS of. If a player is given, this function will use the player's view entity.
    -- @return --- The found Entitys.
    FindInPVS: function(viewPoint: GEntity|GVector): {GEntity}

    --- Gets all entities within the specified sphere.
    --- This function internally calls util.IsBoxIntersectingSphere for every entity on the map based on their Orientated Bounding Box.
    -- @param origin --- Center of the sphere.
    -- @param radius --- Radius of the sphere.
    -- @return --- A table of all found Entitys.
    FindInSphere: function(origin: GVector, radius: number): {GEntity}

    --- Fires a use event.
    -- @param target --- Name of the target entity.
    -- @param activator --- Activator of the event.
    -- @param caller --- Caller of the event.
    -- @param usetype --- Use type. See the Enums/USE.
    -- @param value --- This value is passed to ENTITY:Use, but isn't used by any default entities in the engine.
    FireTargets: function(target: string, activator: GEntity, caller: GEntity, usetype: E_USE, value: number)

    --- Returns a table of all existing entities.
    --- Consider using ents.Iterator instead for better performance.
    --- This function returns a sequential table, meaning it should be looped with Global.ipairs instead of Global.pairs for efficiency reasons.
    -- @return --- Table of all existing Entitys.
    GetAll: function(): {GEntity}

    --- Returns an entity by its index. Same as Global.Entity.
    -- @param entIdx --- The index of the entity.
    -- @return --- The entity if it exists, or `NULL` if it doesn't.
    GetByIndex: function(entIdx: number): GEntity

    --- Gives you the amount of currently existing entities.
    --- Similar to **#**ents.GetAll() but with better performance since the entity table doesn't have to be generated.
    --- If ents.GetAll is already being called for iteration, than using the **#** operator on the table will be faster than calling this function since it is JITted.
    -- @param IncludeKillMe --- Include entities with the FL_KILLME flag. This will skip an internal loop, and the function will be more efficient as a byproduct.
    -- @return --- Number of entities.
    GetCount: function(IncludeKillMe: boolean): number

    --- Returns the amount of networked entities, which is limited to 8192. ents.Create will fail somewhere between 8064 and 8176 - this can vary based on the amount of existing temp ents.
    --- See also [MAX_EDICT_BITS](https://wiki.facepunch.com/gmod/Global_Variables#maxedictbits) global variable.
    -- @return --- Number of networked entities.
    GetEdictCount: function(): number

    --- Returns entity that has given Entity:MapCreationID.
    -- @param id --- Entity's creation id.
    -- @return --- Found entity, `nil` otherwise.
    GetMapCreatedEntity: function(id: number): GEntity|nil

    --- Returns a [Stateless Iterator](https://www.lua.org/pil/7.3.html) for all entities.
    --- Intended for use in [Generic For-Loops](https://www.lua.org/pil/4.3.5.html).
    --- See player.Iterator for a similar function for all players.
    --- **NOTE**: Internally, this function uses cached values that are stored in Lua, as opposed to ents.GetAll, which is a C++ function.
    --- Because a call operation from Lua to C++ *and* with a return back to Lua is quite costly, this function will be more efficient than ents.GetAll.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity_iter.lua#L4-L11)
    -- @return --- The Iterator Function from ipairs.
    -- @return --- Table of all existing Entities.  This is a cached copy of ents.GetAll.
    --- **WARNING**: This table is intended to be read-only.
    --- Modifying the return table will affect all subsequent calls to this function until the cache is refreshed, replacing all of your ents.GetAll usages may come with unintended side effects because of this.
    -- @return --- The starting index for the table of players.
    --- This is always `0` and is returned for the benefit of [Generic For-Loops](https://www.lua.org/pil/4.3.5.html).
    Iterator: function(): function, {GEntity}, number
end


--- The file library provides functions for finding, reading and writing to files.
--- The following path values are most commonly used:
--- * `LUA` searches the lua files (in /lua/, in your gamemodes, in all the addons).
--- * `GAME` searches all the mounted content (main folder, addons, mounted games etc).
--- * `MOD` searches only the garrysmod folder.
--- * `DATA` searches in the data folder.
--- See File Search Paths for the descriptive list of path values.
--- For the full list of path values, type `path` in the console.
global record file
    --- Appends a file relative to the `data` folder.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/file.lua#L31-L39)
    -- @param name --- The file's name.
    -- @param content --- The content which should be appended to the file.
    -- @return --- If the operation was successful.
    Append: function(name: string, content: string): boolean

    --- Returns the content of a file asynchronously.
    --- All limitations of file.Read also apply.
    -- @param fileName --- The name of the file.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @param callback --- A callback function that will be called when the file read operation finishes.
    --- <callback>
    --- <arg type="string" name="fileName">The `fileName` argument above.</arg>
    --- <arg type="string" name="gamePath">The `gamePath` argument above.</arg>
    --- <arg type="number" name="status">The status of the operation. The list can be found in Enums/FSASYNC.</arg>
    --- <arg type="string" name="data">The entirety of the data of the file.</arg>
    --- </callback>
    -- @param sync --- If `true` the file will be read synchronously.
    -- @return status --- FSASYNC_OK on success, FSASYNC_ERR_ on failure.
    AsyncRead: function(fileName: string, gamePath: string, callback: function, sync: boolean): E_FSASYNC

    --- Creates a directory that is relative to the `data` folder.
    -- @param name --- The directory's name.
    CreateDir: function(name: string)

    --- Deletes a file or `empty` folder that is relative to the **data** folder. You can't remove any files outside of **data** folder.
    --- **NOTE**: You are able to delete **any** file in the Menu state.
    -- @param name --- The file name.
    -- @param path --- The path to look for the files and directories in. See this list for a list of valid paths.
    --- **NOTE**: This is only available in the menu state.
    -- @return success ---
    Delete: function(name: string, path: string): boolean

    --- Returns a boolean of whether the file or directory exists or not.
    --- If you want to check for a directory, file.IsDir will be faster since it won't check for files.
    -- @param name --- The file or directory's name. ( You must include the file extension for files, for example "data.txt" )
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return --- Returns `true` if the file exists and `false` if it does not.
    Exists: function(name: string, gamePath: string): boolean

    --- Returns a list of files and directories inside a single folder.
    --- **WARNING**: It seems that paths with capital letters (e.g. lua/MyFolder/*) don't work as expected on Linux.
    -- @param name --- The wildcard to search for. `models/*.mdl` will list **.mdl** files in the `models/` folder.
    -- @param path --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @param sorting --- The sorting to be used, **optional**.
    --- * `nameasc` sort the files ascending by name.
    --- * `namedesc` sort the files descending by name.
    --- * `dateasc` sort the files ascending by date.
    --- * `datedesc` sort the files descending by date.
    -- @return --- A table of found files, or `nil` if the path is invalid.
    -- @return --- A table of found directories, or `nil` if the path is invalid.
    Find: function(name: string, path: string, sorting?: string): table, table

    --- Returns whether the given file is a directory or not.
    -- @param fileName --- The file or directory's name.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return --- `true` if the given path is a directory or `false` if it's a file.
    IsDir: function(fileName: string, gamePath: string): boolean

    --- Attempts to open a file with the given mode.
    -- @param fileName --- The files name. See file.Write for details on filename restrictions when writing to files.
    -- @param fileMode --- The mode to open the file in. Possible values are:
    --- * **r** - read mode.
    --- * **w** - write mode.
    --- * **a** - append mode.
    --- * **rb** - binary read mode.
    --- * **wb** - binary write mode.
    --- * **ab** - binary append mode.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return File --- The opened file object, or `nil` if it failed to open due to it not existing or being used by another process.
    Open: function(fileName: string, fileMode: string, gamePath: string): GFile

    --- Returns the content of a file.
    --- **WARNING**: Beware of casing -- some filesystems are case-sensitive. SRCDS on Linux seems to force file/directory creation to lowercase, but will not modify read operations.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/file.lua#L4-L19)
    -- @param fileName --- The name of the file.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return --- The data from the file as a string, or `nil` if the file isn't found.
    Read: function(fileName: string, gamePath: string): string

    --- Attempts to rename a file with the given name to another given name.
    --- This function is constrained to the `data/` folder.
    -- @param orignalFileName --- The original file or folder name. See file.Write for details on filename restrictions when writing to files.
    --- **This argument will be forced lowercase.**
    -- @param targetFileName --- The target file or folder name. See file.Write for details on filename restrictions when writing to files.
    --- **This argument will be forced lowercase.**
    -- @return --- `true` on success, `false` otherwise.
    Rename: function(orignalFileName: string, targetFileName: string): boolean

    --- Returns the file's size in bytes.
    -- @param fileName --- The file's name.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return --- The file size in bytes, or `-1` if the file is not found.
    Size: function(fileName: string, gamePath: string): number

    --- Returns when the file or folder was last modified in Unix time.
    -- @param path --- The **file** or **folder** path.
    -- @param gamePath --- The path to look for the files and directories in. See this list for a list of valid paths.
    -- @return --- Seconds passed since Unix epoch, or `0` if the file is not found.
    Time: function(path: string, gamePath: string): number

    --- Writes the given string to a file. Erases all previous data in the file. To add data without deleting previous data, use file.Append.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/file.lua#L21-L29)
    -- @param fileName --- The name of the file being written into. The path is relative to the `data/` folder.
    --- This argument will be forced lowercase.
    --- The filename **must** end with one of the following:
    --- * .txt
    --- * .dat
    --- * .json
    --- * .xml
    --- * .csv
    --- * .dem
    --- * .vcd
    --- * .gma
    --- * .mdl
    --- * .phy
    --- * .vvd
    --- * .vtx
    --- * .ani
    --- * .vtf
    --- * .vmt
    --- * .png
    --- * .jpg
    --- * .jpeg
    --- * .mp3
    --- * .wav
    --- * .ogg
    --- Restricted symbols are: `":`, and multiple consecutive spaces, as well as pretty much every other non Latin (a-Z) character
    -- @param content --- The content that will be written into the file.
    -- @return --- If the operation was successful.
    Write: function(fileName: string, content: string): boolean
end


--- The frame blending library.
global record frame_blend
    --- **INTERNAL**:
    --- Adds a frame to the blend. Calls frame_blend.CompleteFrame once enough frames have passed since last frame_blend.CompleteFrame call.
    AddFrame: function()

    --- **INTERNAL**:
    --- Blends the frame(s).
    BlendFrame: function()

    --- **INTERNAL**:
    --- Renders the frame onto internal render target.
    CompleteFrame: function()

    --- **INTERNAL**:
    --- Actually draws the frame blend effect.
    DrawPreview: function()

    --- Returns whether frame blend post processing effect is enabled or not.
    -- @return --- Is frame blend enabled or not.
    IsActive: function(): boolean

    --- **INTERNAL**:
    --- Returns whether the current frame is the last frame?
    -- @return --- Whether the current frame is the last frame?
    IsLastFrame: function(): boolean

    --- **INTERNAL**:
    --- Returns amount of frames needed to render?
    -- @return --- Amount of frames needed to render?
    RenderableFrames: function(): number

    --- Returns whether we should skip frame or not.
    -- @return --- Should the frame be skipped or not.
    ShouldSkipFrame: function(): boolean
end


--- The game library provides functions to access various features in the game's engine, most of it's functions are related to controlling the map.
global record game
    --- Adds a new ammo type to the game.
    --- You can find a list of default ammo types [here](https://wiki.facepunch.com/gmod/Default_Ammo_Types).
    --- **WARNING**: This function **must** be called on both the client and server in GM:Initialize or you will have unexpected problems.
    --- **NOTE**: There is a limit of 256 ammo types, including the default ones.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/game.lua#L2-L40)
    -- @param ammoData --- The attributes of the ammo. See the Structures/AmmoData.
    AddAmmoType: function(ammoData: S_AmmoData)

    --- Registers a new decal.
    --- **WARNING**: There's a rather low limit of around 256 for decal materials that may be registered and they are not cleared on map load.
    -- @param decalName --- The name of the decal.
    -- @param materialName --- The material to be used for the decal. May also be a list of material names, in which case a random material from that list will be chosen every time the decal is placed.
    AddDecal: function(decalName: string, materialName: string)

    --- Loads a particle file. Individual particle systems will still need to be precached with Global.PrecacheParticleSystem.
    --- **NOTE**: You will still need to call this function clientside regardless if you create the particle effects serverside.
    -- @param particleFileName --- The path of the file to add. Must be `(file).pcf`.
    AddParticles: function(particleFileName: string)

    --- **INTERNAL**: Consider using game.GetAmmoTypes and game.GetAmmoData instead.
    --- Called by the engine to retrieve the ammo types.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/game.lua#L46-L54)
    -- @return --- All ammo types registered via game.AddAmmoType, sorted by its name value.
    BuildAmmoTypes: function(): table

    --- Removes most entities, and then respawns entities created by the map, as if the map was just loaded.
    --- There are certain exclusions, such as players or weapons held by players, soundscapes and others.
    --- EFL_KEEP_ON_RECREATE_ENTITIES can be set on entities to preserve them through a map cleanup.
    --- On the client it will remove decals, sounds, gibs, dead NPCs, and entities created via ents.CreateClientProp. This function is ran on all clients from server automatically, when it is called on the server.
    --- This function calls GM:PreCleanupMap before cleaning up the map and GM:PostCleanupMap after cleaning up the map.
    --- Beware of calling this function in hooks that may be called on map clean up (such as ENTITY:StartTouch) to avoid infinite loops.
    --- **BUG**: [Calling this destroys all BASS streams.](https://github.com/Facepunch/garrysmod-issues/issues/2874
    --- **BUG**: [This can crash when removing `_firesmoke` entities. **You can use the example below to workaround this issue.**](https://github.com/Facepunch/garrysmod-issues/issues/3637
    --- **BUG**: [The EFL_KEEP_ON_RECREATE_ENTITIES flag doesn't prevent an entity from being recreated, which means flagged entities will be duplicated since they are both kept and recreated.](https://github.com/Facepunch/garrysmod-issues/issues/6105
    -- @param dontSendToClients --- If set to `true`, don't run this functions on all clients.
    -- @param extraFilters --- Entity classes not to reset during cleanup.
    -- @param callback --- If set, delays the map cleanup until the end of a server tick, allowing bypassing the entity limit on maps with large amounts of them. Otherwise the entities will not be cleaned up until the end of the server tick.
    --- The callback function will be called after the map cleanup has been performed.
    CleanUpMap: function(dontSendToClients: boolean, extraFilters: table, callback: function)

    --- Runs a console command.
    --- Make sure to add a newline ("\n") at the end of the command.
    --- **WARNING**: If you use data that were received from a client, you should avoid using this function because newline and semicolon (at least) allow the client to run arbitrary commands!
    --- For safety, you are urged to prefer using Global.RunConsoleCommand in this case.
    -- @param stringCommand --- String containing the command and arguments to be ran.
    ConsoleCommand: function(stringCommand: string)

    --- Returns the damage type of given ammo type.
    -- @param id --- Ammo ID to retrieve the damage type of. Starts from 1.
    -- @return --- See Enums/DMG.
    GetAmmoDamageType: function(id: number): number

    --- Returns the Structures/AmmoData for given ID.
    -- @param id --- ID of the ammo type to look up the data for.
    -- @return --- The Structures/AmmoData containing all ammo data.
    GetAmmoData: function(id: number): S_AmmoData

    --- Returns the ammo bullet force that is applied when an entity is hit by a bullet of given ammo type.
    -- @param id --- Ammo ID to retrieve the force of. Starts from 1.
    -- @return --- The ammo force.
    GetAmmoForce: function(id: number): number

    --- Returns the ammo type ID for given ammo type name.
    --- See game.GetAmmoName for reverse.
    -- @param name --- Name of the ammo type to look up ID of.
    -- @return --- The ammo type ID of given ammo type name, or -1 if not found.
    GetAmmoID: function(name: string): number

    --- Returns the real maximum amount of ammo of given ammo ID, regardless of the setting of `gmod_maxammo` convar.
    -- @param id --- Ammo type ID.
    -- @return --- The maximum amount of reserve ammo a player can hold of this ammo type.
    GetAmmoMax: function(id: number): number

    --- Returns the damage given ammo type should do to NPCs.
    -- @param id --- Ammo ID to retrieve the damage info of. Starts from 1.
    -- @return ---
    GetAmmoNPCDamage: function(id: number): number

    --- Returns the ammo name for given ammo type ID.
    --- See game.GetAmmoID for reverse.
    -- @param id --- Ammo ID to retrieve the name of. Starts from 1.
    -- @return --- The name of given ammo type ID or nil if ammo type ID is invalid.
    GetAmmoName: function(id: number): string

    --- Returns the damage given ammo type should do to players.
    -- @param id --- Ammo ID to retrieve the damage info of. Starts from 1.
    -- @return ---
    GetAmmoPlayerDamage: function(id: number): number

    --- Returns a list of all ammo types currently registered.
    -- @return --- A table containing all ammo types. The keys are ammo IDs, the values are the names associated with those IDs.
    GetAmmoTypes: function(): {number:string}

    --- Returns the counter of a Global State.
    --- See Global States for more information.
    -- @param name --- The name of the Global State to set.
    --- If the Global State by that name does not exist, it will be created.
    --- See Global States for a list of default global states.
    -- @return --- The value of the given Global State, 0 if the global state doesn't exist.
    GetGlobalCounter: function(name: string): number

    --- Returns whether a Global State is off, active or dead ( inactive ).
    --- See Global States for more information.
    -- @param name --- The name of the Global State to retrieve the state of.
    --- If the Global State by that name does not exist, **GLOBAL_DEAD** will be returned.
    --- See Global States for a list of default global states.
    -- @return --- The state of the Global State. See Enums/GLOBAL.
    GetGlobalState: function(name: string): number

    --- Returns the public IP address and port of the current server. This will return the IP/port that you are connecting through when ran clientside.
    --- **NOTE**: Returns "loopback" in singleplayer.
    --- **BUG**: [Returns "0.0.0.0:`port`" on the server when called too early, including in GM:Initialize and GM:InitPostEntity. This bug seems to only happen the first time a server is launched, and will return the correct value after switching maps.](https://github.com/Facepunch/garrysmod-issues/issues/3001
    -- @return --- The IP address and port in the format "x.x.x.x:x".
    GetIPAddress: function(): string

    --- Returns the name of the current map, without a file extension.
    --- On the menu state, returns "menu".
    --- **WARNING**: In Multiplayer this does not return the current map in the CLIENT realm before GM:Initialize.
    -- @return --- The name of the current map, without a file extension.
    GetMap: function(): string

    --- Returns the current map change count for the server.
    --- This is useful to determine whether the current map is the initial map, or whether a `changelevel` (using `map` command is also detected) has occurred at any point in the server's session.
    -- @return --- The current map change count. Will start at `1`.
    GetMapChangeCount: function(): number

    --- Returns the next map that would be loaded according to the file that is set by the mapcyclefile convar.
    -- @return --- nextMap or nil if called too early.
    GetMapNext: function(): string

    --- Returns the revision (Not to be confused with [VBSP Version](https://developer.valvesoftware.com/wiki/Source_BSP_File_Format#Versions)) of the current map.
    -- @return --- Revision of the currently loaded map.
    GetMapVersion: function(): number

    --- Returns the difficulty level of the game.
    --- **TIP:** You can use this function in your scripted NPCs or Nextbots to make them stronger, however, it is a good idea to lock powerful attacks behind the highest difficulty instead of just increasing the health.
    --- **NOTE**: Internally this is tied to the gamerules entity, so you'll have to wait until GM:InitPostEntity is called to return the skill level.
    -- @return --- The difficulty level, Easy (1), Normal (2), Hard (3).
    GetSkillLevel: function(): number

    --- Returns the time scale set with game.SetTimeScale.
    --- If you want to get the value of `host_timescale`, use:
    --- ```lua
    --- local timescale = GetConVar( "host_timescale" ):GetFloat()
    --- ```
    -- @return --- The time scale.
    GetTimeScale: function(): number

    --- Returns the wind's velocity at a given position, as influenced by current map's [env_wind](https://developer.valvesoftware.com/wiki/Env_wind) entities.
    -- @param pos --- The point to get wind speed at.
    --- If specified, wind controllers with `windradius` other than `-1` will be taken into account, if the point is within their radius.
    --- If omitted, only the global wind controller will be used (if one exists).
    --- **NOTE**: This argument will be ignored on the `CLIENT` realm and will be treated as `nil` because the position of `env_wind` is not currently networked to clients.
    -- @return windVelocity --- `windDir * windSpeed` — the current wind direction multiplied by the current total wind speed.
    --- See [env_wind_shared.cpp#L255-L258](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/shared/env_wind_shared.cpp#L255-L258) for how it's calculated.
    GetWindSpeed: function(pos: GVector): GVector

    --- Returns the worldspawn entity.
    -- @return --- The world.
    GetWorld: function(): GEntity

    --- Returns true if the server is a dedicated server, false if it is a listen server or a singleplayer game.
    -- @return --- Is the server dedicated or not.
    IsDedicated: function(): boolean

    --- Kicks a player from the server. This can be ran before the player has spawned.
    -- @param id --- UserID, SteamID or SteamID64 of the player to kick. Uses SteamID32 eg STEAM_0:0:00000000.
    -- @param reason --- Reason to display to the player. This can span across multiple lines.
    --- **WARNING**: This will be shortened to ~512 chars, though this includes the command itself and the player index so will realistically be more around ~483. It is recommended to avoid going near the limit to avoid truncation.
    KickID: function(id: string, reason: string)

    --- Loads the next map according to the `nextlevel` convar, or from the current `mapcyclefile` set by the respective convar.
    LoadNextMap: function()

    --- Returns the map load type of the current map.
    --- After changing the map with the console command `changelevel`, "newgame" is returned. With `changelevel2` (single player only), "transition" is returned.
    -- @return --- The load type. Possible values are: "newgame", "loadgame", "transition", "background".
    MapLoadType: function(): string

    --- Returns the maximum amount of players (including bots) that the server can have.
    -- @return --- The maximum amount of players.
    MaxPlayers: function(): number

    --- Mounts a GMA addon from the disk.
    --- Can be used with steamworks.DownloadUGC.
    --- **NOTE**: Any error models currently loaded that the mounted addon provides will be reloaded.
    --- Any error materials currently loaded that the mounted addon provides will NOT be reloaded. That means that this cannot be used to fix missing map materials, as the map materials are loaded before you are able to call this.
    -- @param path --- Location of the GMA file to mount, retrieved from steamworks.DownloadUGC or relative to the `garrysmod/` directory (ignores mounting). This file does not have to end with the .gma extension, but will be interpreted as a GMA.
    -- @return --- success.
    -- @return --- If successful, a table of files that have been mounted.
    MountGMA: function(path: string): boolean, table

    --- Removes all the clientside ragdolls. On server, it will remove all `prop_ragdolls` that have the `SF_RAGDOLLPROP_USE_LRU_RETIREMENT` (4096) spawnflag.
    RemoveRagdolls: function()

    --- Sets the counter of a Global State.
    --- See Global States for more information.
    -- @param name --- The name of the Global State to set.
    --- If the Global State by that name does not exist, it will be created.
    --- See Global States for a list of default global states.
    -- @param count --- The value to set for that Global State.
    SetGlobalCounter: function(name: string, count: number)

    --- Sets whether a Global State is off, active or dead ( inactive ).
    --- See Global States for more information.
    -- @param name --- The name of the Global State to set.
    --- If the Global State by that name does not exist, it will be created.
    --- See Global States for a list of default global states.
    -- @param state --- The state of the Global State. See Enums/GLOBAL.
    SetGlobalState: function(name: string, state: number)

    --- Sets the difficulty level of the game, can be retrieved with game.GetSkillLevel.
    --- This will automatically change whenever the "skill" convar is modified serverside.
    -- @param level --- The difficulty level, Easy( 1 ), Normal( 2 ), Hard( 3 ).
    SetSkillLevel: function(level: number)

    --- Sets the time scale of the game.
    --- This function is supposed to remove the need of using the host_timescale convar, which is cheat protected.
    --- To slow down or speed up the movement of a specific player, use Player:SetLaggedMovementValue instead.
    --- **NOTE**: Like host_timescale, this method does not affect sounds, if you wish to change that, look into GM:EntityEmitSound.
    --- **NOTE**: The true timescale will be `host_timescale` multiplied by game.GetTimeScale.
    -- @param timeScale --- The new timescale, minimum value is 0.001 and maximum is 5.
    SetTimeScale: function(timeScale: number)

    --- Returns whether the current session is a single player game.
    -- @return --- isSinglePlayer.
    SinglePlayer: function(): boolean

    --- Returns the name of the entity that should be used as player start position.
    --- This is not the same thing as spawn points (See GM:PlayerSelectSpawn for that), this is used to properly transit the player between maps, and therefore will only be set after a level change via `trigger_changelevel` entity in singleplayer.
    -- @return --- The name of the entity that should be used as start position.
    StartSpot: function(): string
end


--- Used to interface with the built-in game events system.
--- **NOTE**: All Serverside gameevents are networked and called clientside. It could happen that a gameevent is called twice because of this like OnRequestFullUpdate.
--- The following is a list of all available game events.
global record gameevent
    --- Adds a [game event](gameevent) listener, creating a new hook using the hook library, which can be listened to via hook.Add with the given `eventName` as event.
    --- **NOTE**: All gameevents are called in the **Menu State**, but if you want to use them you need to use some DLL(like [this](https://github.com/RaphaelIT7/gmod-gameevent) one) or you need to create your own.
    -- @param eventName --- The event to listen to. List of valid events (with examples) can be found [here](gameevent).
    Listen: function(eventName: string)
end


--- The gamemode library provides functions relating to the gamemode system in Garry's Mod. This entire library also passes through the C -> Lua bridge.
global record gamemode
    --- Called by the engine to call a hook within the loaded gamemode.
    --- The supplied event 'name' must be defined in the active gamemode. Otherwise, nothing will happen - not even hooks added with hook.Add will be called.
    --- This is similar to hook.Run and hook.Call, except the hook library will call hooks created with hook.Add even if there is no corresponding gamemode function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/gamemode.lua#L74-L83)
    -- @param name --- The name of the hook to call.
    -- @param args --- The arguments.
    -- @return --- The result of the hook function - can be up to 6 values. Returns false if the gamemode function doesn't exist (i.e. nothing happened), but remember - a hook can also return false.
    Call: function(name: string, ...: any): any

    --- **INTERNAL**:
    ---  This returns the internally stored gamemode table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/gamemode.lua#L66-L68)
    -- @param name --- The name of the gamemode you want to get.
    -- @return --- The gamemode's table.
    Get: function(name: string): table

    --- **INTERNAL**:
    --- Called by the engine when a gamemode is being loaded.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/gamemode.lua#L20-L60)
    -- @param gm --- Your GM table.
    -- @param name --- Name of your gamemode, lowercase, no spaces.
    -- @param derived --- The gamemode name that your gamemode is derived from.
    Register: function(gm: table, name: string, derived: string)
end


--- Similar purpose to the game and engine, allows access to various features of the game's engine.
global record gmod
    --- Returns GAMEMODE.
    -- @return --- GAMEMODE.
    GetGamemode: function(): S_GM
end


--- The gmsave library provides functions relating to the singleplayer save system in Garry's Mod.
global record gmsave
    --- Loads a saved map.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/gmsave.lua#L11-L78)
    -- @param mapData --- The JSON encoded string containing all the map data.
    -- @param ply --- The player to load positions for.
    -- @param callback --- A function to be called after all the entities have been placed.
    LoadMap: function(mapData: string, ply: GPlayer, callback: function)

    --- Sets player position and angles from supplied table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/gmsave/player.lua#L14-L22)
    -- @param ply --- The player to "load" values for.
    -- @param data --- A table containing Origin and Angle keys for position and angles to set.
    PlayerLoad: function(ply: GPlayer, data: table)

    --- Returns a table containing player position and angles. Used by gmsave.SaveMap.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/gmsave/player.lua#L2-L12)
    -- @param ply --- The player to "save".
    -- @return --- A table containing player position ( Origin ) and angles ( Angle ).
    PlayerSave: function(ply: GPlayer): table

    --- Saves the map.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/gmsave.lua#L80-L108)
    -- @param ply --- The player, whose position should be saved for loading the save.
    -- @return --- The encoded to JSON string containing save data.
    SaveMap: function(ply: GPlayer): string

    --- Returns if we should save this entity in a duplication or a map save or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/gmsave/entity_filters.lua#L49-L79)
    -- @param ent --- The entity.
    -- @param t --- A table containing classname key with entities classname.
    -- @return --- Should save entity or not.
    ShouldSaveEntity: function(ent: GEntity, t: table): boolean
end


--- The gui library is similar to the input but features functions that are more focused on the mouse's interaction with GUI panels.
global record gui
    --- Opens the game menu overlay.
    ActivateGameUI: function()

    --- Pushes text to the closed caption box.
    --- **WARNING**: The function will not work, if the console command variable `closecaption` is set to 0.
    -- @param captionStream --- The caption to emit. See [Closed Captions](https://developer.valvesoftware.com/wiki/Closed_Captions) for more info.
    --- Note the ability to add special commands to captions, such as `<sfx>` to mark the caption as a sound effect caption, which would be hidden if `cc_subtitles` is set to 1. (To only show dialogue subtitles)</sfx>
    -- @param duration --- How long the caption should stay for
    -- @param fromPlayer --- Is this caption coming from the player?
    --- This is used to give different colors to the caption to differentiate, for example, whether the SMG is fired by the player or an NPC.
    AddCaption: function(captionStream: string, duration: number, fromPlayer: boolean)

    --- Enables the mouse cursor without restricting player movement, like using Sandbox's context menu. See vgui.CursorVisible for a function to see if the cursor is visible or not.
    --- **NOTE**: Some CUserCmd functions will return incorrect values when this function is active because [the user input is getting overtaken by the vgui system](https://github.com/Facepunch/garrysmod-issues/issues/982#issuecomment-505671531).
    -- @param enabled --- Whether the cursor should be enabled or not. (true = enable, false = disable)
    EnableScreenClicker: function(enabled: boolean)

    --- Hides the game menu overlay.
    --- @deprecated
    --- **DEPRECATED**: Will be disabled in a future patch. Use GM:OnPauseMenuShow instead.
    HideGameUI: function()

    --- Simulates a mouse move with the given deltas.
    -- @param deltaX --- The movement delta on the x axis.
    -- @param deltaY --- The movement delta on the y axis.
    InternalCursorMoved: function(deltaX: number, deltaY: number)

    --- Simulates a key press for the given key.
    -- @param key --- The key, see Enums/KEY.
    InternalKeyCodePressed: function(key: number)

    --- Simulates a key release for the given key.
    -- @param key --- The key, see Enums/KEY.
    InternalKeyCodeReleased: function(key: number)

    --- Simulates a key type typing to the specified key.
    -- @param key --- The key, see Enums/KEY.
    InternalKeyCodeTyped: function(key: number)

    --- Simulates an ASCII symbol writing.
    --- Use to write text in the chat or in VGUI.
    --- Doesn't work while the main menu is open!
    -- @param code --- ASCII code of symbol, see [this chart](https://files.facepunch.com/wiki/files/ab571/8dc389806d65b98.gif).
    InternalKeyTyped: function(code: number)

    --- Simulates a double mouse key press for the given mouse key.
    -- @param key --- The key, see Enums/MOUSE.
    InternalMouseDoublePressed: function(key: number)

    --- Simulates a mouse key press for the given mouse key.
    -- @param key --- The key, see Enums/MOUSE.
    InternalMousePressed: function(key: number)

    --- Simulates a mouse key release for the given mouse key.
    -- @param key --- The key, see Enums/MOUSE.
    InternalMouseReleased: function(key: number)

    --- Simulates a mouse wheel scroll with the given delta.
    -- @param delta --- The amount of scrolling to simulate.
    InternalMouseWheeled: function(delta: number)

    --- Returns whether the console is visible or not.
    -- @return --- Whether the console is visible or not.
    IsConsoleVisible: function(): boolean

    --- Returns whether the game menu overlay ( main menu ) is open or not.
    -- @return --- Whether the game menu overlay ( main menu ) is open or not
    IsGameUIVisible: function(): boolean

    --- @deprecated
    --- **DEPRECATED**: Use input.GetCursorPos instead.
    --- Returns the cursor's position on the screen, or 0, 0 if cursor is not visible.
    -- @return --- mouseX
    -- @return --- mouseY
    MousePos: function(): number, number

    --- Returns x component of the mouse position.
    -- @return --- mouseX
    MouseX: function(): number

    --- Returns y component of the mouse position.
    -- @return --- mouseY
    MouseY: function(): number

    --- Opens specified URL in the steam overlay browser.
    --- **NOTE**: When called clientside, user will be asked for confirmation before the website will open.
    -- @param url --- URL to open, it has to start with either `http://` or `https://`.
    OpenURL: function(url: string)

    --- Converts the specified screen position to a **direction** vector local to the player's view. A related function is Vector:ToScreen, which translates a 3D position to a screen coordinate.
    --- util.AimVector is a more generic version of this, using a custom view instead of the player's current view.
    -- @param x --- X coordinate on the screen.
    -- @param y --- Y coordinate on the screen.
    -- @return --- Direction
    ScreenToVector: function(x: number, y: number): GVector

    --- @deprecated
    --- **DEPRECATED**: Use input.SetCursorPos instead.
    --- Sets the cursor's position on the screen, relative to the topleft corner of the window
    -- @param mouseX --- The X coordinate to move the cursor to.
    -- @param mouseY --- The Y coordinate to move the cursor to.
    SetMousePos: function(mouseX: number, mouseY: number)
end


--- The halo library is used to draw glowing outlines around entities, an example of this can be seen by picking up props with the physgun in Garry's Mod 13.
global record halo
    --- Applies a halo glow effect to one or multiple entities.
    --- **WARNING**: Using this function outside of the GM:PreDrawHalos hook can cause instability or crashes.
    --- **NOTE**: The ignoreZ parameter will cause the halos to draw over the player's viewmodel. You can work around this using render.DepthRange in the GM:PreDrawViewModel, GM:PostDrawViewModel, GM:PreDrawPlayerHands and GM:PostDrawPlayerHands hooks.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/halo.lua#L13-L33)
    -- @param entities --- A table of entities to add the halo effect to.
    -- @param color --- The desired color of the halo. See Color.
    -- @param blurX --- The strength of the halo's blur on the x axis.
    -- @param blurY --- The strength of the halo's blur on the y axis.
    -- @param passes --- The number of times the halo should be drawn per frame. **Increasing this may hinder player FPS**.
    -- @param additive --- Sets the render mode of the halo to additive.
    -- @param ignoreZ --- Renders the halo through anything when set to `true`.
    Add: function(entities: table, color: table, blurX: number, blurY: number, passes: number, additive: boolean, ignoreZ: boolean)

    --- **INTERNAL**:
    --- Renders a halo according to the specified table, only used internally, called from a GM:PostDrawEffects hook added by the halo library.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/halo.lua#L39-L145)
    -- @param entry --- Table with info about the halo to draw.
    Render: function(entry: table)

    --- Returns the entity the halo library is currently rendering the halo for.
    --- The main purpose of this function is to be used in ENTITY:Draw in order not to draw certain parts of the entity when the halo is being rendered, so there's no halo around unwanted entity parts, such as lasers, 3D2D displays, etc.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/halo.lua#L35-L37)
    -- @return --- If set, the currently rendered entity by the halo library.
    RenderedEntity: function(): GEntity
end


--- The hammer library.
global record hammer
    --- Sends command to Hammer, if Hammer is running with the current map loaded.
    -- @param cmd --- Command to send including arguments.
    --- All commands are in the format "command var1 var2 etc".
    --- All commands that pick an entity with x y z , must use the exact position including decimals (i.e. -354.4523 123.4).
    --- # List of commands
    --- | Command       | Description   |
    --- | ------------- | ------------- |
    --- | "session_begin mapName mapVersion" | Starts a hammer edit, locking the editor. mapName is the current map without path or suffix, mapVersion is the current version in the .vmf file |
    --- | "session_end" | Ends a hammer edit, unlocking the editor. |
    --- | "map_check_version mapName mapVersion" | This only works after session_begin, so you'd know the right version already and this only returns ok, this function is apparently useless. |
    --- | "entity_create entityClass x y z" | Creates an entity of entityClass at position x y z. |
    --- | "entity_delete entityClass x y z" | Deletes an entity of entityClass at position x y z. |
    --- | "entity_set_keyvalue entityClass x y z "key" "value"" | Set's the KeyValue pair of an entity of entityClass at x y z. The Key name and Value String must be in quotes. |
    --- | "entity_rotate_incremental entityClass x y z incX incY incZ" | Rotates an entity of entityClass at x y z by incX incY incZ. |
    --- | "node_create nodeClass nodeID x y z" | Creates an AI node of nodeClass with nodeID at x y z you should keep nodeID unique or you will have issues. |
    --- | "node_delete nodeID" | Deletes node(s) with nodeID, this will delete multiple nodes if they have the same nodeID. |
    --- | "nodelink_create startNodeID endNodeID" | Creates a link between AI nodes startNodeID and endNodeID. |
    --- | "nodelink_delete startNodeID endNodeID" | Removes a link between AI nodes startNodeID and endNodeID. |
    -- @return --- Returns "ok" if command succeeded otherwise returns "badcommand"
    --- **All changes only happen in hammer, there is *NO* in game representation/feedback**
    SendCommand: function(cmd: string): string
end


--- The hook library allows you to add hooks called by the game engine, allowing multiple scripts to modify game function.
global record hook
    --- Registers a function (or "callback") with the Hook system so that it will be called automatically whenever a specific event (or "hook") occurs.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/hook.lua#L23-L42)
    -- @param eventName --- The event to hook on to. This can be any GM hook, gameevent after using gameevent.Listen, or custom hook run with hook.Call or hook.Run.
    -- @param identifier --- The unique identifier, usually a string. This can be used elsewhere in the code to replace or remove the hook. The identifier **should** be unique so that you do not accidentally override some other mods hook, unless that's what you are trying to do.
    --- The identifier can be either a string, or a table/object with an IsValid function defined such as an Entity or Panel. numbers and booleans, for example, are not allowed.
    --- If the identifier is a table/object, it will be inserted in front of the other arguments in the callback and the hook will be called as long as it's valid. However, if IsValid( identifier ) returns false when **any** eventName hook is called, the hook will be removed.
    -- @param func --- The function to be called, arguments given to it depend on the identifier used.
    --- **WARNING**: Returning any value besides nil from the hook's function will stop other hooks of the same event down the loop from being executed. Only return a value when absolutely necessary and when you know what you are doing.
    --- It will also prevent the associated `GM:*` hook from being called on the gamemode.
    --- It WILL break other addons.
    Add: function(eventName: string, identifier: any, func: function)

    --- Calls all hooks associated with the given event until one returns something other than `nil`, and then returns that data.
    --- In almost all cases, you should use hook.Run instead - it calls hook.Call internally but supplies the gamemode table by itself, making your code neater.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/hook.lua#L74-L137)
    -- @param eventName --- The event to call hooks for.
    -- @param gamemodeTable --- If the gamemode is specified, the gamemode hook within will be called, otherwise not.
    -- @param args --- The arguments to be passed to the hooks.
    -- @return --- Return data from called hooks. Limited to **6** return values.
    Call: function(eventName: string, gamemodeTable: table, ...: any): any...

    --- Returns a list of all the hooks registered with hook.Add.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/hook.lua#L15-L21)
    -- @return --- A table of tables. See below for output example.
    GetTable: function(): table

    --- Removes the hook with the supplied identifier from the given event.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/hook.lua#L45-L61)
    -- @param eventName --- The event name.
    -- @param identifier --- The unique identifier of the hook to remove, usually a string.
    Remove: function(eventName: string, identifier: any)

    --- Calls all hooks associated with the given event **until** one returns something other than `nil` and then returns that data. If no hook returns any data, it will try to call the `GAMEMODE:<eventname>` alternative, if one exists.
    --- This function internally calls hook.Call.
    --- See also: gamemode.Call - same as this, but does not call hooks if the gamemode hasn't defined the function.
    --- </eventname>
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/hook.lua#L64-L71)
    -- @param eventName --- The event to call hooks for.
    -- @param args --- The arguments to be passed to the hooks.
    -- @return --- Return data from called hooks. Limited to **6** return values.
    Run: function(eventName: string, ...: any): any...
end


--- The http library allows either the server or client to communicate with external websites via HTTP, both `GET` (http.Fetch) and `POST` (http.Post) are supported. A more powerful & advanced method can be used via the global Global.HTTP function.
global record http
    --- Launches an asynchronous **GET** request to an HTTP server. Internally calls Global.HTTP.
    --- HTTP requests returning a status code >= `400` are still considered a success and will call the onSuccess callback.
    --- The onFailure callback is usually only called on DNS or TCP errors (e.g. the website is unavailable or the domain does not exist).
    --- A rough overview of possible onFailure messages:
    --- * `invalid url` - Invalid/empty url. ( no request was attempted )
    --- * `invalid request` - Steam HTTP lib failed to create a HTTP request.
    --- * `error` - OnComplete callback's second argument, `bError`, is `true`.
    --- * `unsuccessful` - OnComplete's first argument, `pResult->m_bRequestSuccessful`, returned `false`.
    --- **BUG**: [This cannot send or receive multiple headers with the same name.](https://github.com/Facepunch/garrysmod-issues/issues/2232
    --- **NOTE**: HTTP-requests that respond with a large body may return an `unsuccessful` error. Try using the [Range](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Range) header to download the file in chunks.
    --- **NOTE**: HTTP-requests to destinations on private networks (such as `192.168.0.1`, or `127.0.0.1`) won't work.
    --- To enable HTTP-requests to destinations on private networks use Command Line Parameters `-allowlocalhttp`. (Dedicated servers only)
    --- **Not all headers are allowed in the client realm, here is a list of known blacklisted headers inside the client realm:**
    --- ```
    --- host
    --- expect
    --- content-length
    --- proxy-authenticate
    --- accept-charset
    --- connection
    --- accept-encoding
    --- origin
    --- date
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/http.lua#L18-L44)
    -- @param url --- The URL of the website to fetch.
    -- @param onSuccess --- Function to be called on success.
    --- <callback>
    --- <arg type="string" name="body"></arg>
    --- <arg type="number" name="size">equal to string.len(body).</arg>
    --- <arg type="table" name="headers"></arg>
    --- <arg type="number" name="code">The HTTP success code.</arg>
    --- </callback>
    -- @param onFailure --- Function to be called on failure.
    --- <callback>
    --- <arg type="string" name="error">The error message.</arg>
    --- </callback>
    -- @param headers --- KeyValue table for headers.
    Fetch: function(url: string, onSuccess: function, onFailure: function, headers: table)

    --- Sends an asynchronous **POST** request to an HTTP server. Internally calls Global.HTTP.
    --- HTTP requests returning a status code >= `400` are still considered a success and will call the onSuccess callback.
    --- The onFailure callback is usually only called on DNS or TCP errors (e.g. the website is unavailable or the domain does not exist).
    --- **BUG**: [This cannot send or receive multiple headers with the same name.](https://github.com/Facepunch/garrysmod-issues/issues/2232
    --- **NOTE**: HTTP-requests that respond with a large body may return an `unsuccessful` error. Try using the [Range](https://developer.mozilla.org/en-US/docs/Web/HTTP/Headers/Range) header to download the file in chunks.
    --- **NOTE**: HTTP-requests to destinations on private networks (such as `192.168.0.1`, or `127.0.0.1`) won't work.
    --- To enable HTTP-requests to destinations on private networks use Command Line Parameters `-allowlocalhttp`. (Dedicated servers only)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/http.lua#L46-L73)
    -- @param url --- The url to of the website to post.
    -- @param parameters --- The post parameters (x-www-form-urlencoded) to be send to the server. **Keys and values must be strings**.
    -- @param onSuccess --- Function to be called on success.
    --- <callback>
    --- <arg type="string" name="body">The reponse body as a string.</arg>
    --- <arg type="string" name="size">equal to string.len(body).</arg>
    --- <arg type="table" name="headers">The response headers as a table.</arg>
    --- <arg type="number" name="code">The HTTP success code.</arg>
    --- </callback>
    -- @param onFailure --- Function to be called on failure.
    --- <callback>
    --- <arg type="string" name="error">The error message.</arg>
    --- </callback>
    -- @param headers --- KeyValue table for headers.
    Post: function(url: string, parameters: table, onSuccess: function, onFailure: function, headers: table)
end


--- The input library allows you to gather information about the clients input devices (mouse & keyboard), such as the cursor position and whether a key is pressed or not.
global record input
    --- Returns the last key captured by key trapping.
    -- @return --- The key, see Enums/KEY.
    CheckKeyTrapping: function(): number

    --- Returns the digital value of an analog stick on the current (set up via convars) controller.
    -- @param axis --- The analog axis to poll. See Enums/ANALOG.
    -- @return --- The digital value.
    --- **NOTE**: A joystick axis returns `-32768` when it's pushed completely up/completely left, & returns `32767` when it's pushed completely down/completely right.
    --- A mouse wheel starts @ `0` & increases by `1` for every unit of scroll up/decreases by `1` for every unit of scroll down.
    --- A mouse axis is `0` when the arrow is @ the top or left of the screen; When the arrow is @ the bottom right of the screen, the mouse y axis is the height of the screen & the mouse x axis is the width of the screen (in pixels). Note that in game, the “arrow” stays near the middle of the screen.
    --- Trigger axis always return `0` (verify).
    GetAnalogValue: function(axis: E_ANALOG): number

    --- Returns the cursor's position on the screen.
    --- **BUG**: [On macOS, the cursor isn't locked on the middle of the screen which causes a significant offset of the positions returned by this function.](https://github.com/Facepunch/garrysmod-issues/issues/4964
    -- @return --- The cursors position on the X axis.
    -- @return --- The cursors position on the Y axis.
    GetCursorPos: function(): number, number

    --- Gets the button code from a button name. This is opposite of input.GetKeyName.
    -- @param button --- The internal button name, such as `` or ``.
    -- @return --- The button code, see Enums/BUTTON_CODE.
    GetKeyCode: function(button: string): E_BUTTON_CODE

    --- Gets the button name from a numeric button code. The name needs to be translated with language.GetPhrase before being displayed.
    --- **NOTE**: Despite the name of the function, this also works for the full range of keys in Enums/BUTTON_CODE.
    -- @param button --- The button, see Enums/BUTTON_CODE.
    -- @return --- Button name.
    GetKeyName: function(button: E_BUTTON_CODE): string

    --- Gets whether the specified button code is down.
    --- Unlike input.IsKeyDown this can also detect joystick presses from Enums/JOYSTICK.
    -- @param button --- The button, valid values are in the range of Enums/BUTTON_CODE.
    -- @return --- Is the button down?
    IsButtonDown: function(button: E_BUTTON_CODE): boolean

    --- Returns whether a control key is being pressed.
    -- @return --- Is Ctrl key down or not?
    IsControlDown: function(): boolean

    --- Gets whether a key is down.
    -- @param key --- The key, see Enums/KEY.
    -- @return --- Is the key down?
    IsKeyDown: function(key: number): boolean

    --- Returns whether key trapping is activate and the next key press will be captured.
    -- @return --- Whether key trapping active or not.
    IsKeyTrapping: function(): boolean

    --- Gets whether a mouse button is down.
    -- @param mouseKey --- The key, see Enums/MOUSE.
    -- @return --- Is the key down?
    IsMouseDown: function(mouseKey: number): boolean

    --- Gets whether a shift key is being pressed
    -- @return --- isDown
    IsShiftDown: function(): boolean

    --- Returns the client's bound key for the specified console command. If the player has multiple keys bound to a single command, then the key with the lowest Enums/BUTTON_CODE will be returned.
    -- @param binding --- The binding name
    -- @param exact --- True to disable automatic stripping of a single leading `+` character
    -- @return --- The first key found with that binding or no value if no key with given binding was found.
    --- See also input.GetKeyCode.
    LookupBinding: function(binding: string, exact: boolean): string

    --- Returns the bind string that the given key is bound to.
    -- @param key --- Key from Enums/BUTTON_CODE
    -- @return --- The bind string of the given key.
    LookupKeyBinding: function(key: E_BUTTON_CODE): string

    --- Switches to the provided weapon on the next CUserCmd generation/CreateMove call. Direct binding to [CInput::MakeWeaponSelection](https://github.com/ValveSoftware/source-sdk-2013/blob/39f6dde8fbc238727c020d13b05ecadd31bda4c0/src/game/client/in_main.cpp#L989-L992).
    -- @param weapon --- The weapon entity to switch to.
    SelectWeapon: function(weapon: GWeapon)

    --- Sets the cursor's position on the screen, relative to the topleft corner of the window
    -- @param mouseX --- X coordinate for mouse position
    -- @param mouseY --- Y coordinate for mouse position
    SetCursorPos: function(mouseX: number, mouseY: number)

    --- Begins waiting for a key to be pressed so we can save it for input.CheckKeyTrapping. Used by the DBinder.
    StartKeyTrapping: function()

    --- Translates a console command alias, basically reverse of the `alias` console command.
    -- @param command --- The alias to lookup.
    -- @return --- The command(s) this alias will execute if ran, or nil if the alias doesn't exist.
    TranslateAlias: function(command: string): string

    --- Returns whether a key was initially pressed in the same frame this function was called.
    --- This function only works in Move hooks, and will detect key presses even in main menu or when a typing in a text field.
    -- @param key --- The key, see Enums/KEY.
    -- @return --- True if the key was initially pressed the same frame that this function was called, false otherwise.
    WasKeyPressed: function(key: number): boolean

    --- Returns whether a key was released in the same frame this function was called.
    --- This function only works in Move hooks, and will detect key releases even in main menu or when a typing in a text field.
    -- @param key --- The key, see Enums/KEY.
    -- @return --- True if the key was released the same frame that this function was called, false otherwise.
    WasKeyReleased: function(key: number): boolean

    --- Returns whether the key is being held down or not.
    --- This function only works in Move hooks, and will detect key events even in main menu or when a typing in a text field.
    -- @param key --- The key to test, see Enums/KEY
    -- @return --- Whether the key is being held down or not.
    WasKeyTyped: function(key: number): boolean

    --- Returns whether a mouse key was double pressed in the same frame this function was called.
    --- If this function returns true, input.WasMousePressed will return false.
    --- This function only works in Move hooks, and will detect mouse events even in main menu or when a typing in a text field.
    -- @param button --- The mouse button to test, see Enums/MOUSE
    -- @return --- Whether the mouse key was double pressed or not.
    WasMouseDoublePressed: function(button: number): boolean

    --- Returns whether a mouse key was initially pressed in the same frame this function was called.
    --- If input.WasMouseDoublePressed returns true, this function will return false.
    --- This function only works in Move hooks, and will detect mouse events even in main menu or when a typing in a text field.
    -- @param key --- The key, see Enums/MOUSE
    -- @return --- True if the mouse key was initially pressed the same frame that this function was called, false otherwise.
    WasMousePressed: function(key: number): boolean

    --- Returns whether a mouse key was released in the same frame this function was called.
    --- This function only works in Move hooks, and will detect mouse events even in main menu or when a typing in a text field.
    -- @param key --- The key to test, see Enums/MOUSE
    -- @return --- True if the mouse key was released the same frame that this function was called, false otherwise.
    WasMouseReleased: function(key: number): boolean
end


--- Library to work with the [LuaJIT](http://luajit.org/) functionality of gmod.
global record jit
    --- A variable containing the target architecture name: `x86`, `x64`, `arm`, `ppc`, `ppcspe`, or `mips`. This will be `x86` or `x64` in GMod.
    arch: string

    --- @deprecated
    --- **DEPRECATED**: This function was disabled due to security concerns.
    --- You can attach callbacks to a number of compiler events with jit.attach. The callback can be called:
    --- * when a function has been compiled to bytecode (`"bc"`);
    --- * when trace recording starts or stops (`"trace"`);
    --- * as a trace is being recorded (`"record"`);
    --- * or when a trace exits through a side exit (`"texit"`).
    --- Set a callback with `jit.attach(callback, "event")` and clear the same callback with `jit.attach(callback)`.
    --- Only one callback can be active per event.
    --- **WARNING**: This function isn't officially documented on LuaJIT wiki, use it at your own risk.
    -- @param callback --- The callback function.
    --- The arguments passed to the callback depend on the event being reported:
    --- * `"bc"`:
    --- * function **func** - The function that's just been recorded
    --- * `"trace"`:
    --- * string **what** - description of the trace event: "flush", "start", "stop", "abort". Available for all events.
    --- * number **tr** - The trace number. Not available for flush.
    --- * function **func** - The function being traced. Available for start and abort.
    --- * number **pc** - The program counter - the bytecode number of the function being recorded (if this a Lua function). Available for start and abort.
    --- * number **otr** - start: the parent trace number if this is a side trace, abort: abort code
    --- * string **oex** - start: the exit number for the parent trace, abort: abort reason (string)
    --- * `"record"`:
    --- * number **tr** - The trace number. Not available for flush.
    --- * function **func** - The function being traced. Available for start and abort.
    --- * number **pc** - The program counter - the bytecode number of the function being recorded (if this a Lua function). Available for start and abort.
    --- * number **depth** - The depth of the inlining of the current bytecode.
    --- * `"texit"`:
    --- * number **tr** - The trace number. Not available for flush.
    --- * number **ex** - The exit number
    --- * number **ngpr** - The number of general-purpose and floating point registers that are active at the exit.
    --- * number **nfpr** - The number of general-purpose and floating point registers that are active at the exit.
    -- @param event --- The event to hook into.
    attach: function(callback: function, event: string)

    --- Flushes the whole cache of compiled code.
    flush: function()

    --- Disables LuaJIT Lua compilation.
    off: function()

    --- Enables LuaJIT Lua compilation.
    on: function()

    --- This is NOT a function, it's a variable containing the target OS name: `Windows`, `Linux`, `OSX`, `BSD`, `POSIX` or `Other`.
    os: string

    --- Returns the status of the JIT compiler and the current optimizations enabled.
    -- @return --- Is JIT enabled
    -- @return --- Strings for CPU-specific features and enabled optimizations
    status: function(): boolean, any

    --- A variable containing the LuaJIT version string. This is `LuaJIT 2.0.4` in GMod, and `LuaJIT 2.1.0-beta3` on the x86-64 branch of GMod.
    version: string

    --- A variable containing the version number of the LuaJIT core.
    version_num: number
end


--- The killicon library is used to add to and control the icons that appear in the top right of your screen when a player is killed.
global record killicon
    --- Creates new kill icon using a texture.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L30-L37)
    -- @param class --- Weapon or entity class.
    -- @param texture --- Path to the texture.
    -- @param color --- Color of the kill icon.
    Add: function(class: string, texture: string, color: table)

    --- Creates kill icon from existing one.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L39-L43)
    -- @param new_class --- New class of the kill icon.
    -- @param existing_class --- Already existing kill icon class.
    AddAlias: function(new_class: string, existing_class: string)

    --- Adds kill icon for given weapon/entity class using special font.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L20-L28)
    -- @param class --- Weapon or entity class.
    -- @param font --- Font to be used.
    -- @param symbol --- The symbol to be used.
    -- @param color --- Color of the killicon.
    -- @param heightScale  --- Used internally to correct certain killicons to more closely match their visual size.
    AddFont: function(class: string, font: string, symbol: string, color: table, heightScale_: number)

    --- Creates new kill icon using a sub-rectangle of a texture.
    -- @param class --- Weapon or entity class this killicon is for.
    -- @param texture --- Path to the texture.
    -- @param color --- Color of the kill icon.
    -- @param x --- The start position (X axis) of the rectangle on the given texture. This is in texture coordinates.
    -- @param y --- The start position (Y axis) of the rectangle on the given texture. This is in texture coordinates.
    -- @param w --- The width of the rectangle on the given texture. This is in texture coordinates.
    -- @param h --- The height of the rectangle on the given texture. This is in texture coordinates.
    AddTexCoord: function(class: string, texture: string, color: table, x: number, y: number, w: number, h: number)

    --- Draws a kill icon.
    --- @deprecated
    --- **DEPRECATED**: This function applies unpredictable vertical offsets, you should use killicon.Render instead, which does not suffer from this issue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L97-L135)
    -- @param x --- X coordinate of the icon.
    -- @param y --- Y coordinate of the icon.
    -- @param name --- Classname of the kill icon.
    -- @param alpha --- Alpha/transparency value ( 0 - 255 ) of the icon.
    Draw: function(x: number, y: number, name: string, alpha: number)

    --- Checks if kill icon exists for given class.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L45-L49)
    -- @param class --- The class to test.
    -- @return --- Returns true if kill icon exists.
    Exists: function(class: string): boolean

    --- Returns the size of a kill icon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L51-L95)
    -- @param name --- Classname of the kill icon.
    -- @param dontEqualizeHeight --- If set to `true`, returns the real size of the kill icon, without trying to equalize the height to match the default kill icon font.
    -- @return --- Width of the kill icon.
    -- @return --- Height of the kill icon.
    GetSize: function(name: string, dontEqualizeHeight: boolean): number, number

    --- Renders a kill icon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/killicon.lua#L196-L200)
    -- @param x --- X coordinate of the icon.
    -- @param y --- Y coordinate of the icon.
    -- @param name --- Classname of the kill icon.
    -- @param alpha --- Alpha/transparency value ( 0 - 255 ) of the icon.
    -- @param dontEqualizeHeight --- Do not rescale the icon to match the default kill icon font.
    Render: function(x: number, y: number, name: string, alpha: number, dontEqualizeHeight: number)
end


--- The language library is used for translation.
global record language
    --- Adds a language item. Language placeholders preceded with "#" are replaced with full text in Garry's Mod once registered with this function.
    -- @param placeholder --- The key for this phrase, without the preceding "#".
    -- @param fulltext --- The phrase that should be displayed whenever this key is used.
    Add: function(placeholder: string, fulltext: string)

    --- Retrieves the translated version of inputted string. Useful for concentrating multiple translated strings.
    -- @param phrase --- The phrase to translate
    -- @return --- The translated phrase, or the input string if no translation was found. There is a limit of 4000 bytes for the returned string.
    GetPhrase: function(phrase: string): string
end


--- The list library allows you add and retrieve values to and from lists. The list library is basically a fancy wrapper for a table, but with much more limited functionality.
--- It is used extensively in the built-in Sandbox gamemode for addon-extensible lists of things (list of wheel models, list of thruster effects, etc) , without using global tables for this task.
--- See Default Lists for a page of default Sandbox lists.
global record list
    --- Adds an item to a named list.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L41-L45)
    -- @param identifier --- The list identifier.
    -- @param item --- The item to add to the list.
    -- @return --- The index at which the item was added.
    Add: function(identifier: string, item: any): number

    --- Returns true if the list contains the value. (as a value - not a key)
    --- For a function that looks for a key and not a value see list.HasEntry.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L47-L58)
    -- @param list --- List to search through.
    -- @param value --- The value to test.
    -- @return --- Returns true if the list contains the value, false otherwise.
    Contains: function(list: string, value: any): boolean

    --- Returns a copy of the list stored at identifier.
    --- **WARNING**: This function uses table.Copy which can be very slow for larger lists. You should avoid calling it repeatedly or in performance sensitive hooks such as GM:Think.
    --- Where possible you should use the much faster helper functions:
    --- list.Contains,
    --- list.HasEntry, or
    --- list.GetEntry.
    --- There is also the more dangerous option of calling list.GetForEdit to get the unprotected list if you absolutely must iterate through it in a think hook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L10-L14)
    -- @param identifier --- The list identifier.
    -- @return --- The copy of the list.
    Get: function(identifier: string): table

    --- Returns a copy of the entry in the list `list` with key `key`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L16-L27)
    -- @param list --- List to search through.
    -- @param key --- The key to search for.
    -- @return --- Returns the  value if the list contains the key, nil otherwise.
    GetEntry: function(list: string, key: string): any|nil

    --- Returns the actual table of the list stored at identifier. Modifying this will affect the stored list.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L16-L27)
    -- @param identifier --- The list identifier.
    -- @param dontCreate --- If the list at given identifier does not exist, do **not** create it.
    -- @return --- The actual list.
    GetForEdit: function(identifier: string, dontCreate: boolean): table

    --- Returns a list of all lists currently in use.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L29-L33)
    -- @return --- The list of all lists, i.e. a table containing names of all lists.
    GetTable: function(): table

    --- Returns true if the list contains the given key.
    --- For a function that looks for values and not keys see list.Contains.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L60-L66)
    -- @param list --- List to search through.
    -- @param key --- The key to test.
    -- @return --- Returns true if the list contains the key, false otherwise.
    HasEntry: function(list: string, key: any): boolean

    --- Removes a single entry from the list `list` with key `key`.
    --- This is equivalent to `list.Set( myList, myKey, nil )`.
    -- @param list --- List to remove an entry in.
    -- @param key --- The key for the entry to remove.
    RemoveEntry: function(list: string, key: string)

    --- Sets a specific position in the named list to a value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/list.lua#L35-L39)
    -- @param identifier --- The list identifier.
    -- @param key --- The key in the list to set.
    -- @param item --- The item to set to the list as key.
    Set: function(identifier: string, key: any, item: any)
end


--- The markup library only contains a single function to create a MarkupObject.
global record markup
    --- A convenience function that converts a Color into its markup ready string representation.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/markup.lua#L39-L46)
    -- @param col --- The Color to convert.
    -- @return --- The markup color, for example `255,255,255`.
    Color: function(col: GColor): string

    --- Converts a string to its escaped, markup-safe equivalent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/markup.lua#L279-L281)
    -- @param text --- The string to sanitize.
    -- @return sanitizedText --- The parsed markup object ready to be drawn.
    Escape: function(text: string): string

    --- Parses markup into a MarkupObject. Currently, this only supports fonts and colors as demonstrated in the example.
    --- **WARNING**: This function is very slow! Always cache its result.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/markup.lua#L295-L557)
    -- @param markup --- The markup to be parsed.
    -- @param maxWidth --- The max width of the output.
    -- @return --- The parsed markup object ready to be drawn via MarkupObject:Draw.
    Parse: function(markup: string, maxWidth: number): GMarkupObject
end


--- An easing library that allows you to interpolate with various kinds of smoothing [functions](https://easings.net/). To use with Global.Lerp, input what you would to the fraction argument in one of these easing functions and then the output of that into the Global.Lerp fraction argument.
--- <example>
--- <description>Example usage with Lerp and math.ease.InSine</description>
--- <code>
--- -- Define a wrapper function to make it easier to work with
--- local function easedLerp(fraction, from, to)
--- return Lerp(math.ease.InSine(fraction), from, to)
--- end
--- -- Compare with the non-eased version of Lerp
--- print(easedLerp(0.25, 0, 1))
--- print(Lerp(0.25, 0, 1))
--- print(easedLerp(0.25, 0, 5))
--- print(Lerp(0.25, 0, 5))
--- </code>
--- <output>
--- ```
--- 0.076120467488713
--- 0.25
--- 0.38060233744357
--- 1.25
--- ```
--- </output>
--- </example>
--- <example>
--- <description>
--- A brief visual example of different easing methods
--- <upload src="ab571/8dc38906fb4cfbe.gif" size="4162886" name="easing_examples.gif">
--- </upload></description>
--- </example>
global record math
    --- Calculates the difference between two angles.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L189-L197)
    -- @param a --- The first angle.
    -- @param b --- The second angle.
    -- @return --- The difference between the angles between -180 and 180
    AngleDifference: function(a: number, b: number): number

    --- Gradually approaches the target value by the specified amount.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L173-L183)
    -- @param current --- The value we're currently at.
    -- @param target --- The target value. This function will never overshoot this value.
    -- @param change --- The amount that the current value is allowed to change by to approach the target. (It makes no difference whether this is positive or negative.)
    -- @return --- New current value, closer to the target than it was previously.
    Approach: function(current: number, target: number, change: number): number

    --- Increments an angle towards another by specified rate.
    --- **NOTE**: This function is for numbers representing angles (0-360), NOT Angle objects!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L199-L201)
    -- @param currentAngle --- The current angle to increase
    -- @param targetAngle --- The angle to increase towards
    -- @param rate --- The amount to approach the target angle by
    -- @return --- Modified angle
    ApproachAngle: function(currentAngle: number, targetAngle: number, rate: number): number

    --- Basic code for Bézier-Spline algorithm.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L131-L142)
    -- @param fraction --- A number in the range `[0,fractionMax]` which controls which location along the spline's length should be evaluated as the return value.
    -- @param points --- A table of Vectors that form the spline.
    --- There must be **at least** 4 points.
    -- @param fractionMax --- The maximum value of the `fraction` argument.
    --- The most common value for this is `1`.
    -- @return --- The point on the Bézier curve that corresponds to the given `fraction` argument.
    BSplinePoint: function(fraction: number, points: table, fractionMax: number): GVector

    --- Converts a binary string into a number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L31-L33)
    -- @param string --- Binary string to convert
    -- @return --- Base 10 number.
    BinToInt: function(string: string): number

    --- Cubic Hermite spline algorithm.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L148-L159)
    -- @param frac --- From 0 to 1, where alongside the spline the point will be.
    -- @param point0 --- First point for the spline.
    -- @param tan0 --- Tangent for the first point for the spline.
    -- @param point1 --- Second point for the spline.
    -- @param tan1 --- Tangent for the second point for the spline.
    -- @return --- Point on the cubic Hermite spline, at given fraction.
    CHSpline: function(frac: number, point0: GVector, tan0: GVector, point1: GVector, tan1: GVector): GVector

    --- Clamps a number between a minimum and maximum value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L53-L55)
    -- @param input --- The number to clamp.
    -- @param min --- The minimum value.
    -- @param max --- The maximum value, this function will **never** return a number greater than this.
    -- @return --- The clamped value.
    Clamp: function(input: number, min: number, max: number): number

    --- Lerp point between 4 control points with cubic bezier.
    --- See math.QuadraticBezier for a similar function which works with 3 control points.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L220-L226)
    -- @param frac --- The fraction for finding the result. This number is clamped between 0 and 1.
    -- @param p0 --- First control point
    -- @param p1 --- First tangent
    -- @param p2 --- Second tangent
    -- @param p3 --- Second control point
    -- @return --- Point between control points at the specified fraction
    CubicBezier: function(frac: number, p0: GVector, p1: GVector, p2: GVector, p3: GVector): GVector

    --- @deprecated
    --- **DEPRECATED**: You should use math.Distance instead
    --- Returns the difference between two points in 2D space. Alias of math.Distance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L20-L24)
    -- @param x1 --- X position of first point
    -- @param y1 --- Y position of first point
    -- @param x2 --- X position of second point
    -- @param y2 --- Y position of second point
    -- @return --- Distance between the two points.
    Dist: function(x1: number, y1: number, x2: number, y2: number): number

    --- Returns the difference between two points in 2D space.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L20-L24)
    -- @param x1 --- X position of first point
    -- @param y1 --- Y position of first point
    -- @param x2 --- X position of second point
    -- @param y2 --- Y position of second point
    -- @return --- Distance between the two points
    Distance: function(x1: number, y1: number, x2: number, y2: number): number

    --- Returns the squared difference between two points in 2D space. This is computationally faster than math.Distance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L10-L14)
    -- @param x1 --- X position of first point
    -- @param y1 --- Y position of first point
    -- @param x2 --- X position of second point
    -- @param y2 --- Y position of second point
    -- @return --- The squared distance between the two points.
    DistanceSqr: function(x1: number, y1: number, x2: number, y2: number): number

    --- Calculates the progress of a value fraction, taking in to account given easing fractions
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L74-L98)
    -- @param progress --- Fraction of the progress to ease, from 0 to 1.
    -- @param easeIn --- Fraction of how much easing to begin with, from 0 to 1.
    -- @param easeOut --- Fraction of how much easing to end with, from 0 to 1.
    -- @return --- "Eased" Value, from 0 to 1
    EaseInOut: function(progress: number, easeIn: number, easeOut: number): number

    --- Simple function that calculates [factorial](https://en.wikipedia.org/wiki/Factorial) of a whole number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L244-L257)
    -- @param val_in --- An whole number to get a factorial of. Decimal numbers will be treated as whole numbers.
    -- @return --- The factorial of given number.
    Factorial: function(val_in: number): number

    --- Eases in by reversing the direction of the ease slightly before returning.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L128-L130)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InBack: function(fraction: number): number

    --- Eases in like a bouncy ball.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L168-L170)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InBounce: function(fraction: number): number

    --- Eases in using a circular function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L114-L116)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InCirc: function(fraction: number): number

    --- Eases in by cubing the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L61-L63)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InCubic: function(fraction: number): number

    --- Eases in like a rubber band.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L142-L148)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InElastic: function(fraction: number): number

    --- Eases in using an exponential equation with a base of 2 and where the fraction is used in the exponent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L97-L99)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InExpo: function(fraction: number): number

    --- Eases in and out by reversing the direction of the ease slightly before returning on both ends.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L136-L140)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InOutBack: function(fraction: number): number

    --- Eases in and out like a bouncy ball.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L187-L191)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InOutBounce: function(fraction: number): number

    --- Eases in and out using a circular function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L122-L126)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutCirc: function(fraction: number): number

    --- Eases in and out by cubing the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L69-L71)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutCubic: function(fraction: number): number

    --- Eases in and out like a rubber band.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L158-L166)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    InOutElastic: function(fraction: number): number

    --- Eases in and out using an exponential equation with a base of 2 and where the fraction is used in the exponent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L105-L112)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutExpo: function(fraction: number): number

    --- Eases in and out by squaring the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L57-L59)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutQuad: function(fraction: number): number

    --- Eases in and out by raising the fraction to the power of 4.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L81-L83)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutQuart: function(fraction: number): number

    --- Eases in and out by raising the fraction to the power of 5.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L93-L95)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutQuint: function(fraction: number): number

    --- Eases in and out using math.sin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L45-L47)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InOutSine: function(fraction: number): number

    --- Eases in by squaring the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L49-L51)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InQuad: function(fraction: number): number

    --- Eases in by raising the fraction to the power of 4.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L73-L75)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InQuart: function(fraction: number): number

    --- Eases in by raising the fraction to the power of 5.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L85-L87)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InQuint: function(fraction: number): number

    --- Eases in using math.sin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L37-L39)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    InSine: function(fraction: number): number

    --- Converts an integer to a binary (base-2) string.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L44-L47)
    -- @param int --- Number to be converted.
    -- @return --- Binary number string. The length of this will always be a multiple of 3.
    IntToBin: function(int: number): string

    --- Checks if two floating point numbers are nearly equal.
    --- This is useful to mitigate  [accuracy issues in floating point numbers](https://en.wikipedia.org/wiki/Floating-point_arithmetic#Accuracy_problems). See examples below.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L275-L281)
    -- @param a --- The first number to compare.
    -- @param b --- The second number to compare.
    -- @param tolerance --- The maximum difference between the two numbers to consider them equal.
    -- @return --- True if the difference between the two numbers is less than or equal to the tolerance.
    IsNearlyEqual: function(a: number, b: number, tolerance: number): boolean

    --- Normalizes angle, so it returns value between -180 and 180.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L185-L187)
    -- @param angle --- The angle to normalize, in degrees.
    -- @return --- The normalized angle, in the range of -180 to 180 degrees.
    NormalizeAngle: function(angle: number): number

    --- Eases out by reversing the direction of the ease slightly before finishing.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L132-L134)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    OutBack: function(fraction: number): number

    --- Eases out like a bouncy ball.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L172-L185)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    OutBounce: function(fraction: number): number

    --- Eases out using a circular function.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L118-L120)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutCirc: function(fraction: number): number

    --- Eases out by cubing the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L65-L67)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutCubic: function(fraction: number): number

    --- Eases out like a rubber band.
    --- **NOTE**: This doesn't work properly when used with Global.Lerp as it clamps the fraction between 0 and 1. Using your own version of Global.Lerp that is unclamped would be necessary instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L150-L156)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value
    OutElastic: function(fraction: number): number

    --- Eases out using an exponential equation with a base of 2 and where the fraction is used in the exponent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L101-L103)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutExpo: function(fraction: number): number

    --- Eases out by squaring the fraction.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L53-L55)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutQuad: function(fraction: number): number

    --- Eases out by raising the fraction to the power of 4.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L77-L79)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutQuart: function(fraction: number): number

    --- Eases out by raising the fraction to the power of 5.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L89-L91)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutQuint: function(fraction: number): number

    --- Eases out using math.sin.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math/ease.lua#L41-L43)
    -- @param fraction --- Fraction of the progress to ease, from 0 to 1
    -- @return --- "Eased" Value, from 0 to 1
    OutSine: function(fraction: number): number

    --- Lerp point between 3 control points with quadratic bezier.
    --- See math.CubicBezier for a function which works with 4 control points.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L232-L238)
    -- @param frac --- The fraction for finding the result.
    -- @param p0 --- First control point
    -- @param p1 --- Tangent
    -- @param p2 --- Second control point
    -- @return --- Point between control points at the specified fraction
    QuadraticBezier: function(frac: number, p0: GVector, p1: GVector, p2: GVector): GVector

    --- Returns a random float between min and max.
    --- See also math.random
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L61-L63)
    -- @param min --- The minimum value.
    -- @param max --- The maximum value.
    -- @return --- Random float between min and max.
    Rand: function(min: number, max: number): number

    --- Remaps the value from one range to another
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L207-L209)
    -- @param value --- The value
    -- @param inMin --- The minimum of the initial range
    -- @param inMax --- The maximum of the initial range
    -- @param outMin --- The minimum of new range
    -- @param outMax --- The maximum of new range
    -- @return --- The number in the new range
    Remap: function(value: number, inMin: number, inMax: number, outMin: number, outMax: number): number

    --- Rounds the given value to the nearest whole number or to the given decimal places.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L162-L165)
    -- @param value --- The value to round.
    -- @param decimals --- The decimal places to round to.
    -- @return --- The rounded value.
    Round: function(value: number, decimals: number): number

    --- Snaps a number to the closest multiplicative of given number. See also Angle:SnapTo.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L212-L214)
    -- @param input --- The number to snap.
    -- @param snapTo --- What to snap the input number to.
    -- @return --- The clamped value.
    SnapTo: function(input: number, snapTo: number): number

    --- Returns the fraction of where the current time is relative to the start and end times
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L203-L205)
    -- @param start --- Start time in seconds
    -- @param end --- End time in seconds
    -- @param current --- Current time in seconds
    -- @return --- Fraction
    TimeFraction: function(start: number, _end: number, current: number): number

    --- Trim unwanted decimal places.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L168-L171)
    -- @param num --- The number to truncate
    -- @param digits --- The amount of digits to keep after the point.
    -- @return --- The result.
    Truncate: function(num: number, digits: number): number

    --- Calculates the absolute value of a number (effectively removes any negative sign).
    -- @param x --- The number to get the absolute value of.
    -- @return --- The absolute value.
    abs: function(x: number): number

    --- Returns the [arccosine](https://en.wikipedia.org/wiki/Arccosine) of the given number.
    -- @param cos --- Cosine value in range of -1 to 1.
    -- @return --- An angle in radians, between 0 and pi, which has the given cos value.
    --- nan if the argument is out of range.
    acos: function(cos: number): number

    --- Returns the [arcsine](https://en.wikipedia.org/wiki/Inverse_trigonometric_functions) of the given number.
    -- @param normal --- Sine value in the range of -1 to 1.
    -- @return --- An angle in radians, in the range -pi/2 to pi/2, which has the given sine value.
    --- nan if the argument is out of range.
    asin: function(normal: number): number

    --- Returns the [arctangent](https://en.wikipedia.org/wiki/Inverse_trigonometric_functions) of the given number.
    -- @param normal --- Tangent value.
    -- @return --- An angle in radians, in the range -pi/2 to pi/2, which has the given tangent.
    atan: function(normal: number): number

    --- functions like math.atan(y / x), except it also takes into account the quadrant of the angle and so doesn't have a limited range of output.
    --- **NOTE**: The Y argument comes first!
    -- @param y --- Y coordinate.
    -- @param x --- X coordinate.
    -- @return --- The angle of the line from (0, 0) to (x, y) in radians, in the left-open interval (-pi, pi]
    atan2: function(y: number, x: number): number

    --- **INTERNAL**: Use math.BSplinePoint instead.
    --- Basic code for Bezier-Spline algorithm, helper function for math.BSplinePoint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/math.lua#L100-L129)
    -- @param i ---
    -- @param k --- **BUG**: [Sending in a value < 1 will result in an infinite loop.](https://github.com/Facepunch/garrysmod/pull/1477
    -- @param t ---
    -- @param tinc ---
    -- @return ---
    calcBSplineN: function(i: number, k: number, t: number, tinc: number): number

    --- Ceils or rounds a number up.
    --- See math.floor for the inverse of this function.
    -- @param number --- The number to be rounded up.
    -- @return --- ceiled numbers
    ceil: function(number: number): number

    --- Returns the [cosine](https://en.wikipedia.org/wiki/Trigonometric_functions#cos) of given angle.
    -- @param number --- Angle in radians
    -- @return --- Cosine of given angle in the range (-1, 1)
    cos: function(number: number): number

    --- Returns the [hyperbolic cosine](https://en.wikipedia.org/wiki/Cosh_(mathematical_function)) of the given angle.
    -- @param number --- Angle in radians.
    -- @return --- The hyperbolic cosine of the given angle.
    cosh: function(number: number): number

    --- Converts radians to degrees.
    -- @param radians --- Value to be converted to degrees.
    -- @return --- degrees
    deg: function(radians: number): number

    --- Returns e to the power of the input.
    -- @param exponent --- The exponent for the function.
    -- @return --- e to the specified power
    exp: function(exponent: number): number

    --- Floors or rounds a number down.
    --- See math.ceil for the inverse of this function.
    -- @param number --- The number to be rounded down.
    -- @return --- floored numbers
    floor: function(number: number): number

    --- Returns the modulus of the specified values.
    --- While this is similar to the `%` operator, **it will return a negative value if the first argument is negative**, whereas the % operator will return a **positive** value **even if the first operand is negative**.
    --- This function is also slower than the `%` operator.
    -- @param base --- The base value.
    -- @param modulator --- The modulator.
    -- @return --- The calculated modulus.
    fmod: function(base: number, modulator: number): number

    --- **Lua reference description**: Returns `m` and `e` such that `x = m2e`, `e` is an integer and the absolute value of `m` is in the range ((0.5, 1) (or zero when x is zero).
    --- Used to split the number value into a normalized fraction and an exponent. Two values are returned: the first is a multiplier in the range `1/2` (**inclusive**) to `1` (**exclusive**) and the second is an integer exponent.
    --- The result is such that `x = m*2^e`.
    -- @param x --- The value to get the normalized fraction and the exponent from.
    -- @return --- m, multiplier - between `0.5` and `1`.
    -- @return --- e, exponent - **always** an integer.
    frexp: function(x: number): number, number

    --- A variable that effectively represents infinity, in the sense that in any numerical comparison every number will be less than this.
    --- For example, if `x` is a number, `x > math.huge` will **NEVER** be `true` except in the case of overflow (see below).
    --- Lua will consider any number greater than or equal to `2^1024` (the exponent limit of a [double](http://en.wikipedia.org/wiki/Double-precision_floating-point_format)) as `inf` and hence equal to this.
    huge: number

    --- Takes a normalised number and returns the floating point representation.
    --- Effectively it returns the result of `normalizedFraction * 2.0 ^ exponent`. math.frexp is the opposite function.
    -- @param normalizedFraction --- The value to get the normalized fraction and the exponent from.
    -- @param exponent --- The value to get the normalized fraction and the exponent from.
    -- @return --- result
    ldexp: function(normalizedFraction: number, exponent: number): number

    --- With one argument, return the natural logarithm of x (to base e).
    --- With two arguments, return the logarithm of x to the given base, calculated as log(x)/log(base).
    -- @param x --- The value to get the base from exponent from.
    -- @param base --- The logarithmic base.
    -- @return --- Logarithm of x to the given base
    log: function(x: number, base: number): number

    --- Returns the base-10 logarithm of x. This is usually more accurate than math.log(x, 10).
    -- @param x --- The value to get the base from exponent from.
    -- @return --- The result.
    log10: function(x: number): number

    --- Returns the largest value of all arguments.
    -- @param numbers --- Numbers to get the largest from
    -- @return --- The largest number
    max: function(...: any): number

    --- Returns the smallest value of all arguments.
    -- @param numbers --- Numbers to get the smallest from.
    -- @return --- The smallest number
    min: function(...: any): number

    --- @deprecated
    --- **DEPRECATED**: This is removed in Lua versions later than what GMod is currently using. You should use the % operator or math.fmod instead.
    --- Returns the modulus of the specified values. Same as math.fmod.
    -- @param base --- The base value
    -- @param modulator --- Modulator
    -- @return --- The calculated modulus
    mod: function(base: number, modulator: number): number

    --- Returns the integral and fractional component of the modulo operation.
    -- @param base --- The base value.
    -- @return --- The integral component.
    -- @return --- The fractional component.
    modf: function(base: number): number, number

    --- A variable containing the mathematical constant pi. (`3.1415926535898`)
    --- See also: Trigonometry
    --- **NOTE**: It should be noted that due to the nature of floating point numbers, results of calculations with `math.pi` may not be what you expect. See second example below.
    pi: number

    --- Returns x raised to the power y.
    --- In particular, math.pow(1.0, x) and math.pow(x, 0.0) always return 1.0, even when x is a zero or a nan. If both x and y are finite, x is negative, and y is not an integer then math.pow(x, y) is undefined.
    -- @param x --- Base.
    -- @param y --- Exponent.
    -- @return --- y power of x
    pow: function(x: number, y: number): number

    --- Converts an angle in degrees to it's equivalent in radians.
    -- @param degrees --- The angle measured in degrees.
    -- @return --- radians
    rad: function(degrees: number): number

    --- When called without arguments, returns a uniform pseudo-random real number in the range 0 to 1 which includes 0 but excludes 1.
    --- When called with an integer number m, returns a uniform pseudo-random integer in the range 1 to m inclusive.
    --- When called with two integer numbers m and n, returns a uniform pseudo-random integer in the range m to n inclusive.
    --- See also math.Rand
    -- @param m --- If m is the only parameter: upper limit.
    --- If n is also provided: lower limit.
    --- If provided, this must be an integer.
    -- @param n --- Upper limit.
    --- If provided, this must be an integer.
    -- @return --- Random value
    random: function(m: number, n: number): number

    --- Seeds the random number generator. The same seed will guarantee the same sequence of numbers each time with math.random.
    --- For shared random values across predicted realms, use util.SharedRandom.
    --- **WARNING**: Usage of this function affects **ALL** random numbers in the game. This means that improper use (such as setting the seed to a static value that doesn't change with time) can negatively affect other addons or the base game.
    --- It is a good idea to set the seed back to at least something like Global.SysTime in those cases.
    -- @param seed --- The new seed
    randomseed: function(seed: number)

    --- Returns the [sine](https://en.wikipedia.org/wiki/Trigonometric_functions) of given angle.
    -- @param number --- Angle in radians
    -- @return --- Sine for given angle in the range (-1, 1)
    sin: function(number: number): number

    --- Returns the [hyperbolic sine](https://en.wikipedia.org/wiki/Hyperbolic_functions) of the given angle.
    -- @param number --- Angle in radians.
    -- @return --- The hyperbolic sine of the given angle.
    sinh: function(number: number): number

    --- Returns the square root of the number.
    -- @param value --- Value to get the square root of.
    -- @return --- squareRoot
    sqrt: function(value: number): number

    --- Returns the tangent of the given angle.
    -- @param value --- Angle in radians
    -- @return --- The tangent of the given angle.
    tan: function(value: number): number

    --- Returns the [hyperbolic tangent](https://en.wikipedia.org/wiki/Hyperbolic_functions) of the given number.
    -- @param number --- Angle in radians.
    -- @return --- The hyperbolic tangent of the given angle.
    tanh: function(number: number): number

    --- A variable containing the mathematical constant tau, which is equivalent to 2*math.pi. (`6.28318530718`)
    --- See also: Trigonometry
    --- **NOTE**: It should be noted that due to the nature of floating point numbers, results of calculations with `math.tau` may not be what you expect. See the second example on math.pi page.
    tau: number
end


--- A library that allows implementing custom [material proxies](https://developer.valvesoftware.com/wiki/Material_proxies) for materials.
--- Material proxies allow programmatically setting specific `.vmt` shader parameters on a per-entity basis, rather being global across all instances of a material.
--- You can find a tutorial for making colourable textures over at this [GitHub wiki](https://github.com/fgrg2801/gmod-colorable-playermodels/wiki)
global record matproxy
    --- **INTERNAL**:
    --- A list of all **active** material proxies.
    ActiveList: table

    --- Register a material proxy. See matproxy for more general explanation of what they are.
    --- **NOTE**: The `bind` function is required. The `init` function won't run without it set.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/matproxy.lua#L20-L45)
    -- @param matProxyData --- The information about the proxy. See Structures/MatProxyData
    Add: function(matProxyData: table)

    --- **INTERNAL**:
    --- Called by the engine from `OnBind`. Calls bind method of the Lua material proxy.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/matproxy.lua#L50-L58)
    -- @param uname --- The material proxy name.
    -- @param mat --- The material the proxy is being applied to.
    -- @param ent --- The entity the material is applied to.
    Call: function(uname: string, mat: GIMaterial, ent: GEntity)

    --- **INTERNAL**:
    --- Called by the engine from `OnBind`. Calls init method of the Lua material proxy.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/matproxy.lua#L63-L79)
    -- @param name --- Name of the material proxy.
    -- @param uname --- Name for the active material proxy instance.
    -- @param mat --- Material the material proxy is applied to.
    -- @param values --- `.vmt` shader parameters of the material.
    Init: function(name: string, uname: string, mat: GIMaterial, values: table)

    --- A list of all material proxies registered with matproxy.Add.
    ProxyList: table

    --- **INTERNAL**:
    --- Called by engine to determine if a certain material proxy is registered in Lua.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/matproxy.lua#L11-L15)
    -- @param name --- The name of proxy in question
    -- @return --- Whether the material proxy of given name is registered.
    ShouldOverrideProxy: function(name: string): boolean
end


--- The menu library.
global record menu
    --- **INTERNAL**:
    --- Used by "Demo to Video" to record the frame.
    RecordFrame: function()
end


--- The menubar library.
global record menubar
    --- Creates the menu bar ( The bar at the top of the screen when holding C or Q in sandbox ) and docks it to the top of the screen. It will not appear.
    --- Calling this multiple times will **NOT** remove previous panel.
    Init: function()

    --- Checks if the supplied panel is parent to the menubar
    -- @param pnl --- The panel to check
    -- @return --- Is parent or not
    IsParent: function(pnl: GPanel): boolean

    --- Parents the menubar to the panel and displays the menubar.
    -- @param pnl --- The panel to parent to
    ParentTo: function(pnl: GPanel)
end


--- The mesh library allows you to create meshes. A mesh is a set of vertices that define a 3D shape, for constant meshes you should use the IMesh object instead.
global record mesh
    --- Pushes the currently set vertex data (via other `mesh.*` functions) into the mesh stack. See example on mesh.Begin.
    AdvanceVertex: function()

    --- Begins creating or modifying a 3D mesh constructed from a given quantity and type of primitive 3D shapes such as triangles and quads.
    --- The resulting mesh can be stored in an IMesh if it is intended to be drawn multiple times or on multiple frames.
    -- @param mesh --- The IMesh that the created mesh will be stored in.
    --- If the mesh has already been built, it will instead have its existing verticies modified but cannot have the quantity of vertices changed.
    -- @param primitiveType --- An enum that indicates what the format of the mesh's primitives will be.
    --- For a full list of the available options, see the Enums/MATERIAL.
    -- @param primitiveCount --- The quantity of primitives this mesh will contain as a whole integer number.
    --- The total number of vertices must not exceed the limit of `32768`.
    --- The number of vertices created by each primitive will depend on the type of primitive used to construct the mesh.
    --- The expected value of this argument is dependent on the primitive type used.
    --- For a full list of the primitive counts expected by each primitive type, see Enums/MATERIAL.
    Begin: function(mesh: GIMesh, primitiveType: number, primitiveCount: number)

    --- Begins creating or modifying a 3D mesh constructed from a given quantity and type of primitive 3D shapes such as triangles and quads.
    --- The resulting mesh can be stored in an IMesh if it is intended to be drawn multiple times or on multiple frames.
    -- @param primitiveType --- An enum that indicates what the format of the mesh's primitives will be.
    --- For a full list of the available options, see the Enums/MATERIAL.
    -- @param primitiveCount --- The quantity of primitives this mesh will contain as a whole integer number.
    --- The total number of vertices must not exceed the limit of `32768`.
    --- The number of vertices created by each primitive will depend on the type of primitive used to construct the mesh.
    --- The expected value of this argument is dependent on the primitive type used.
    --- For a full list of the primitive counts expected by each primitive type, see Enums/MATERIAL.
    Begin: function(primitiveType: number, primitiveCount: number)

    --- Sets the color to be used for the next vertex. This is `COLOR0` semantic of
    --- Vertex Shader. See mesh.Begin.
    -- @param r --- Red component.
    -- @param g --- Green component.
    -- @param b --- Blue component.
    -- @param a --- Alpha component.
    Color: function(r: number, g: number, b: number, a: number)

    --- Ends the mesh (Started with mesh.Begin) and renders it.
    End: function()

    --- Sets the normal to be used for the next vertex. See mesh.Begin.
    -- @param normal --- The normal of the vertex.
    Normal: function(normal: GVector)

    --- Sets the normal to be used for the next vertex. See mesh.Begin.
    -- @param x --- The X part of the vertex normal.
    -- @param y --- The Y part of the vertex normal.
    -- @param z --- The Z part of the vertex normal.
    Normal: function(x: number, y: number, z: number)

    --- Sets the position to be used for the next vertex. See mesh.Begin.
    -- @param position --- The position of the vertex.
    Position: function(position: GVector)

    --- Sets the position to be used for the next vertex. See mesh.Begin.
    -- @param x --- The X position of the vertex.
    -- @param y --- The Y position of the vertex.
    -- @param z --- The Z position of the vertex.
    Position: function(x: number, y: number, z: number)

    --- Adds a quad (4 vertices) to the currently built mesh. See mesh.Begin.
    -- @param vertex1 --- The first vertex.
    -- @param vertex2 --- The second vertex.
    -- @param vertex3 --- The third vertex.
    -- @param vertex4 --- The fourth vertex.
    -- @param color --- The color for the vertices.
    Quad: function(vertex1: GVector, vertex2: GVector, vertex3: GVector, vertex4: GVector, color: table)

    --- Adds a quad (4 vertices) to the currently built mesh, by using position, normal and sizes. See mesh.Begin.
    --- See also mesh.Quad.
    -- @param position --- The center of the quad.
    -- @param normal --- The normal of the quad.
    -- @param sizeX --- X size in pixels.
    -- @param sizeY --- Y size in pixels.
    -- @param color --- The color for the vertices.
    QuadEasy: function(position: GVector, normal: GVector, sizeX: number, sizeY: number, color: table)

    --- Sets the specular map values. This is `COLOR1` semantic of Vertex Shader.
    --- **NOTE**: This doesn't currently work, even though `COLOR0` can be successfully passed to the Vertex Shader using mesh.Color, unlike `COLOR1`, ​​using this function.
    -- @param r --- The red channel multiplier of the specular map.
    -- @param g --- The green channel multiplier of the specular map.
    -- @param b --- The blue channel multiplier of the specular map.
    -- @param a --- The alpha channel multiplier of the specular map.
    Specular: function(r: number, g: number, b: number, a: number)

    --- Sets the `S` tangent to be used, also known as "binormal".
    --- Tangents and binormals are using in bumpmap rendering.
    --- See also mesh.TangentT and mesh.Begin.
    -- @param tangentS --- The S tangent.
    TangentS: function(tangentS: GVector)

    --- Sets the `S` tangent to be used, also known as "binormal".
    --- Tangents and binormals are using in bumpmap rendering.
    --- See also mesh.TangentT and mesh.Begin.
    -- @param x --- The X part of the vertex' tangent S.
    -- @param y --- The Y part of the vertex' tangent S.
    -- @param z --- The Z part of the vertex' tangent S.
    TangentS: function(x: number, y: number, z: number)

    --- Sets the `T` tangent to be used.
    --- Tangents and binormals are using in bumpmap rendering.
    --- See also mesh.TangentS and mesh.Begin.
    -- @param tangentT --- The T tangent.
    TangentT: function(tangentT: GVector)

    --- Sets the `T` tangent to be used.
    --- Tangents and binormals are using in bumpmap rendering.
    --- See also mesh.TangentS and mesh.Begin.
    -- @param x --- The X part of the vertex' tangent T.
    -- @param y --- The Y part of the vertex' tangent T.
    -- @param z --- The Z part of the vertex' tangent T.
    TangentT: function(x: number, y: number, z: number)

    --- Sets the texture coordinates for the next vertex for the current mesh. (See mesh.Begin)
    -- @param set --- The texture coordinate set, 0 to 7.
    --- Non-zero values require the currently bound material to support it. For example, any `LightmappedGeneric` material supports sets 1 and 2 (lightmap texture coordinates and bump map texture coords?).
    -- @param s --- S coordinate.
    -- @param t --- T coordinate. Will be optional in the next update.
    -- @param u --- U coordinate.
    -- @param v --- V coordinate.
    TexCoord: function(set: number, s: number, t: number, u?: number, v?: number)

    --- A set of four numbers that can be used for arbitrary purposes by Material shaders.
    --- This is most commonly used to provide tangent information about each vertex to the Material's shader.
    -- @param tangentX ---
    -- @param tangentY ---
    -- @param tangentZ ---
    -- @param tangentHandedness ---
    UserData: function(tangentX: number, tangentY: number, tangentZ: number, tangentHandedness: number)

    --- Returns the amount of vertices that have been pushed via mesh.AdvanceVertex.
    -- @return --- The amount of vertices.
    VertexCount: function(): number
end


--- Functions related to Kinect for Windows usage in GMod.
--- **WARNING**: Kinect feature works only on 32-bit version of the game.
global record motionsensor
    --- **INTERNAL**:
    ---  Called to build the skeleton. See Using The Kinect and Kinect developing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/motionsensor.lua#L221-L260)
    -- @param translator --- `list.Get( "SkeletonConvertor" )` and motionsensor.ChooseBuilderFromEntity.
    -- @param player --- The player to get motion sensor positions from.
    -- @param rotation --- Global rotation of the player?
    -- @return --- Position
    -- @return --- Angles
    -- @return --- Sensor
    BuildSkeleton: function(translator: table, player: GPlayer, rotation: GAngle): GVector, GAngle, table

    ---
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/motionsensor.lua#L46-L58)
    -- @param ent --- Entity to choose builder for
    -- @return --- Chosen builder. The builders are stored in `list.Get( "SkeletonConvertor" )`
    ChooseBuilderFromEntity: function(ent: GEntity): string

    --- Returns the depth map material.
    -- @return --- The material
    GetColourMaterial: function(): GIMaterial

    --- Returns players skeletal data if they are using Kinect. See Using The Kinect and Kinect developing.
    -- @return --- The skeleton data.
    GetSkeleton: function(): table

    --- Return whether a kinect is connected - and active (ie - Start has been called).
    -- @return --- Connected and active or not
    IsActive: function(): boolean

    --- Returns true if we have detected that there's a kinect connected to the PC
    -- @return --- Connected or not
    IsAvailable: function(): boolean

    --- **INTERNAL**:
    ---  Used internally by motionsensor.ProcessAnglesTable. See Using The Kinect and Kinect developing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/motionsensor.lua#L60-L121)
    -- @param translator ---
    -- @param sensor ---
    -- @param pos ---
    -- @param ang ---
    -- @param special_vectors ---
    -- @param boneid ---
    -- @param v ---
    -- @return --- Return nil on failure
    ProcessAngle: function(translator: table, sensor: table, pos: GVector, ang: GAngle, special_vectors: table, boneid: number, v: table): boolean

    --- **INTERNAL**:
    ---  Used internally by motionsensor.BuildSkeleton. See Using The Kinect and Kinect developing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/motionsensor.lua#L126-L190)
    -- @param translator ---
    -- @param sensor ---
    -- @param pos ---
    -- @param rotation ---
    -- @return --- Ang. If `!translator.AnglesTable` then `return {}`
    ProcessAnglesTable: function(translator: table, sensor: table, pos: GVector, rotation: GAngle): table

    --- **INTERNAL**:
    ---  Used internally by motionsensor.BuildSkeleton. See Using The Kinect and Kinect developing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/motionsensor.lua#L195-L216)
    -- @param translator ---
    -- @param sensor ---
    -- @return --- Positions. if `!translator.PositionTable` then return - `{}`
    ProcessPositionTable: function(translator: table, sensor: table): table

    --- This starts access to the kinect sensor. Note that this usually freezes the game for a couple of seconds.
    -- @return --- `true` if the access has been started
    Start: function(): boolean

    --- Stops the motion capture.
    Stop: function()
end


--- The navigation mesh library. To be used with CNavArea.
--- The navigation mesh is used by NextBot to calculate path to its target.
global record navmesh
    --- Add this position and normal to the list of walkable positions, used before map generation with navmesh.BeginGeneration
    -- @param pos --- The terrain position.
    -- @param dir --- The normal of this terrain position.
    AddWalkableSeed: function(pos: GVector, dir: GVector)

    --- Starts the generation of a new navmesh.
    --- **NOTE**: This process is highly resource intensive and it's not wise to use during normal gameplay
    BeginGeneration: function()

    --- Clears all the walkable positions, used before calling navmesh.BeginGeneration.
    ClearWalkableSeeds: function()

    --- Creates a new CNavArea.
    -- @param corner --- The first corner of the new CNavArea
    -- @param opposite_corner --- The opposite (diagonally) corner of the new CNavArea
    -- @return --- The new CNavArea or nil if we failed for some reason.
    CreateNavArea: function(corner: GVector, opposite_corner: GVector): GCNavArea

    --- Creates a new CNavLadder.
    -- @param top --- The top position of the ladder.
    -- @param bottom --- The bottom position of the ladder.
    -- @param width --- Width for the new ladder.
    -- @param dir --- Directional vector in which way the ladder should be facing. Please note that ladders can only face in the 4 cardinal directions - NORTH, SOUTH, WEST, EAST.
    -- @param maxHeightAboveTopArea --- If above 0, will limit how much the top of the ladder can be adjusted to the closest CNavArea when automatically connecting the newly created ladder to pre-existing nav areas.
    -- @return --- The new CNavLadder or nil if we failed for some reason.
    CreateNavLadder: function(top: GVector, bottom: GVector, width: number, dir: GVector, maxHeightAboveTopArea: number): GCNavLadder

    --- Returns a list of areas within distance, used to find hiding spots by NextBots for example.
    -- @param pos --- The position to search around. This position will be used to find the closest area to search from.
    -- @param radius --- Radius to search within
    -- @param stepHeight --- Maximum step up height allowed
    -- @param dropHeight --- Maximum step down (fall distance) allowed
    -- @return --- A list of found CNavAreas.
    Find: function(pos: GVector, radius: number, stepHeight: number, dropHeight: number): table

    --- Returns a list of CNavAreas overlapping the given cube extents.
    -- @param pos1 --- The start position of the cube to search in.
    -- @param pos2 --- The "end" position of the cube to search in. This is the opposite corner of the cube, diagonally.
    -- @return --- A list of found CNavAreas.
    FindInBox: function(pos1: GVector, pos2: GVector): table

    --- Returns an integer indexed table of all CNavAreas on the current map. If the map doesn't have a navmesh generated then this will return an empty table.
    -- @return --- A table of all the CNavAreas on the current map.
    GetAllNavAreas: function(): {GCNavArea}

    --- Returns a table of all blocked CNavAreas on the current map. See CNavArea:MarkAsBlocked.
    -- @return --- A table of all the blocked CNavAreas on the current map.
    GetBlockedAreas: function(): table

    --- Returns the position of the edit cursor when nav_edit is set to 1.
    -- @return --- The position of the edit cursor.
    GetEditCursorPosition: function(): GVector

    --- Finds the closest standable ground at, above, or below the provided position.
    --- **NOTE**: The ground must have at least 32 units of empty space above it to be considered by this function, unless 16 layers are tested without finding valid ground.
    -- @param pos --- Position to find the closest ground for.
    -- @return --- The height of the ground layer.
    -- @return --- The normal of the ground layer.
    GetGroundHeight: function(pos: GVector): number, GVector

    --- Returns the currently marked CNavArea, for use with editing console commands.
    -- @return --- The currently marked CNavArea.
    GetMarkedArea: function(): GCNavArea

    --- Returns the currently marked CNavLadder, for use with editing console commands.
    -- @return --- The currently marked CNavLadder.
    GetMarkedLadder: function(): GCNavLadder

    --- Returns the Nav Area contained in this position that also satisfies the elevation limit.
    --- This function will properly see blocked CNavAreas. See navmesh.GetNearestNavArea.
    -- @param pos --- The position to search for.
    -- @param beneathLimit --- The elevation limit at which the Nav Area will be searched.
    -- @return --- The nav area.
    GetNavArea: function(pos: GVector, beneathLimit: number): GCNavArea

    --- Returns a CNavArea by the given ID.
    --- **NOTE**: Avoid calling this function every frame, as internally it does a lookup trough all the CNavAreas, call this once and store the result
    -- @param id --- ID of the CNavArea to get. Starts with 1.
    -- @return --- The CNavArea with given ID.
    GetNavAreaByID: function(id: number): GCNavArea

    --- Returns the total count of nav areas on the map. If you want to get all nav areas, use navmesh.GetAllNavAreas instead as nav areas IDs are not always sequential.
    -- @return --- The total count of nav areas on the map.
    GetNavAreaCount: function(): number

    --- Returns a CNavLadder by the given ID.
    -- @param id --- ID of the CNavLadder to get. Starts with 1.
    -- @return --- The CNavLadder with given ID.
    GetNavLadderByID: function(id: number): GCNavLadder

    --- Returns the closest CNavArea to given position at the same height, or beneath it.
    --- This function will ignore blocked CNavAreas. See navmesh.GetNavArea for a function that does see blocked areas.
    -- @param pos --- The position to look from
    -- @param anyZ --- This argument is ignored and has no effect
    -- @param maxDist --- This is the maximum distance from the given position that the function will look for a CNavArea
    -- @param checkLOS --- If this is set to true then the function will internally do a util.TraceLine from the starting position to each potential CNavArea with a [MASK_NPCSOLID_BRUSHONLY](https://wiki.facepunch.com/gmod/Enums/MASK). If the trace fails then the CNavArea is ignored.
    --- If this is set to false then the function will find the closest CNavArea through anything, including the world.
    -- @param checkGround --- If checkGround is true then this function will internally call navmesh.GetNavArea to check if there is a CNavArea directly below the position, and return it if so, before checking anywhere else.
    -- @param team --- This will internally call CNavArea:IsBlocked to check if the target CNavArea is not to be navigated by the given team. Currently this appears to do nothing.
    -- @return --- The closest CNavArea found with the given parameters, or a NULL CNavArea if one was not found.
    GetNearestNavArea: function(pos: GVector, anyZ: boolean, maxDist: number, checkLOS: boolean, checkGround: boolean, team: number): GCNavArea

    --- Returns the classname of the player spawn entity.
    -- @return --- The classname of the spawn point entity. By default returns "info_player_start"
    GetPlayerSpawnName: function(): string

    --- Whether we're currently generating a new navmesh with navmesh.BeginGeneration.
    -- @return --- Whether we're generating a nav mesh or not.
    IsGenerating: function(): boolean

    --- Returns true if a navmesh has been loaded when loading the map.
    -- @return --- Whether a navmesh has been loaded when loading the map.
    IsLoaded: function(): boolean

    --- Loads a new navmesh from the .nav file for current map discarding any changes made to the navmesh previously.
    --- **WARNING**: Calling this function too soon, causes the Server to crash!
    Load: function()

    --- Deletes every CNavArea and CNavLadder on the map **without saving the changes**.
    Reset: function()

    --- Saves any changes made to navmesh to the .nav file.
    Save: function()

    --- Sets the CNavArea as marked, so it can be used with editing console commands.
    -- @param area --- The CNavArea to set as the marked area.
    SetMarkedArea: function(area: GCNavArea)

    --- Sets the CNavLadder as marked, so it can be used with editing console commands.
    -- @param area --- The CNavLadder to set as the marked ladder.
    SetMarkedLadder: function(area: GCNavLadder)

    --- Sets the classname of the default spawn point entity, used before generating a new navmesh with navmesh.BeginGeneration.
    -- @param spawnPointClass --- The classname of what the player uses to spawn, automatically adds it to the walkable positions during map generation.
    SetPlayerSpawnName: function(spawnPointClass: string)
end


--- The net library is one of a number of ways to send data between the client and server.
--- The major advantages of the net library are the large size limit (64kb/message) and the ability to send data backwards - from the client to the server.
--- Refer to Net Library Usage for a short introduction.
global record net
    --- Cancels a net message started by net.Start, so you can immediately start a new one without any errors.
    Abort: function()

    --- Sends the currently built net message (see net.Start) to all connected players.
    --- More information can be found in Net Library Usage.
    Broadcast: function()

    --- Returns the amount of data left to read in the current message. Does nothing when sending data.
    --- **NOTE**: This will include 6 extra bits (or 1 byte rounded-up) used by the engine internally.
    -- @return --- The amount of data left to read in the current net message in **bytes**.
    --- Returns `nil` if no net message has been started.
    -- @return --- The amount of data left to read in the current net message in **bits**.
    --- Returns `nil` if no net message has been started.
    BytesLeft: function(): number, number

    --- Returns the size of the current message.
    --- **NOTE**: This will include 3 extra bytes (24 bits) used by the engine internally to send the data over the network.
    -- @return --- The amount of **bytes** written to the current net message.
    --- Returns `nil` if no net message has been started.
    -- @return --- The amount of **bits** written to the current net message.
    --- Returns `nil` if no net message has been started.
    BytesWritten: function(): number, number

    --- **INTERNAL**: You may be looking for net.Receive.
    --- Function called by the engine to tell the Lua state a message arrived.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L23-L40)
    -- @param length --- The message length, in **bits**.
    -- @param client --- The player that sent the message. This will be `nil` in the client state.
    Incoming: function(length: number, client: GPlayer)

    --- Reads an angle from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The read angle, or `Angle( 0, 0, 0 )` if no angle could be read
    ReadAngle: function(): GAngle

    --- Reads a bit from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- `0` or `1`, or `0` if the bit could not be read.
    ReadBit: function(): number

    --- Reads a boolean from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L47-L51)
    -- @return --- `true` or `false`, or `false` if the bool could not be read.
    ReadBool: function(): boolean

    --- Reads a Color from the current net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L118-L131)
    -- @param hasAlpha --- If the color has alpha written or not. **Must match what was given to net.WriteColor.**
    -- @return --- The Color read from the current net message, or `Color( 0, 0, 0, 0 )` if the color could not be read.
    ReadColor: function(hasAlpha: boolean): table

    --- Reads pure binary data from the message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @param length --- The length of the data to be read, in **bytes**.
    -- @return --- The binary data read, or a string containing one character with a byte of `0` if no data could be read.
    ReadData: function(length: number): string

    --- Reads a double-precision number from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The double-precision number, or `0` if no number could be read.
    ReadDouble: function(): number

    --- Reads an entity from the received net message. You should always check if the specified entity exists as it may have been removed and therefore `NULL` if it is outside of the players [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community") or was already removed.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L66-L73)
    -- @return --- The entity, or `nil` if no entity could be read.
    ReadEntity: function(): GEntity

    --- Reads a floating point number from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The floating point number, or `0` if no number could be read.
    ReadFloat: function(): number

    --- **INTERNAL**:
    --- Reads a word, basically unsigned short. This is used internally to read the "header" of the message which is an unsigned short which can be converted to the corresponding message name via util.NetworkIDToString.
    -- @return --- The header number
    ReadHeader: function(): number

    --- Reads an integer from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @param bitCount --- The amount of bits to be read.
    --- This must be set to what you set to net.WriteInt. Read more information at net.WriteInt.
    -- @return --- The read integer number, or `0` if no integer could be read.
    ReadInt: function(bitCount: number): number

    --- Reads a VMatrix from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The matrix, or an empty matrix if no matrix could be read.
    ReadMatrix: function(): GVMatrix

    --- Reads a normal vector from the net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The normalized vector ( length = `1` ), or `Vector( 0, 0, 1 )` if no normal could be read.
    ReadNormal: function(): GVector

    --- Reads a player entity that was written with net.WritePlayer from the received net message.
    --- You should always check if the specified entity exists as it may have been removed and therefore `NULL` if it is outside of the local players [PVS](https://developer.valvesoftware.com/wiki/PVS) or was already removed.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L89-L97)
    -- @return --- The player, or `Entity(0)` if no entity could be read.
    ReadPlayer: function(): GPlayer

    --- Reads a [null-terminated string](https://en.wikipedia.org/wiki/Null-terminated_string) from the net stream. The size of the string is 8 bits plus 8 bits for every ASCII character in the string.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The read string, or a string with `0` length if no string could be read.
    ReadString: function(): string

    --- Reads a table from the received net message.
    --- See net.WriteTable for extra info.
    --- **NOTE**: Sometimes when sending a table through the net library, the order of the keys may be switched. So be cautious when comparing (See example 1).
    --- You may get `net.ReadType: Couldn't read type X` during the execution of the function, the problem is that you are sending objects that **cannot** be serialized/sent over the network.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L156-L183)
    -- @param sequential --- Set to `true` if the input table is sequential. This saves on bandwidth.
    -- @return --- Table received via the net message, or a blank table if no table could be read.
    ReadTable: function(sequential: boolean): table

    --- **INTERNAL**: Used internally by net.ReadTable.
    --- Reads a value from the net message with the specified type, written by net.WriteType.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L229-L238)
    -- @param typeID --- The type of value to be read, using Enums/TYPE.
    -- @return --- The value, or the respective blank value based on the type you're reading if the value could not be read.
    ReadType: function(typeID: number): any

    --- Reads an unsigned integer with the specified number of bits from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @param bitCount --- The size of the integer to be read, in bits.
    --- This must be set to what you set to net.WriteUInt. Read more information at net.WriteUInt.
    -- @return --- The unsigned integer read, or `0` if the integer could not be read.
    ReadUInt: function(bitCount: number): number

    --- Reads a unsigned integer with 64 bits from the received net message.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The uint64 number.
    --- **NOTE**: Since Lua cannot store full 64-bit integers, this function returns a string. It is mainly aimed at usage with Player:SteamID64.
    ReadUInt64: function(): string

    --- **INTERNAL**:
    --- A list of types that can be sent over the network via net.ReadType.
    ReadVars: table

    --- Reads a vector from the received net message. Vectors sent by this function are **compressed**, which may result in precision loss. See net.WriteVector for more information.
    --- **WARNING**: You **must** read information in same order as you write it.
    -- @return --- The read vector, or `Vector( 0, 0, 0 )` if no vector could be read.
    ReadVector: function(): GVector

    --- Adds a net message handler. Only one receiver can be used to receive the net message.
    --- You can use the `net.Read*` functions within the message handler callback.
    --- **WARNING**: You **should** put this function **outside** of any other function or hook for it to work properly unless you know what you are doing!
    --- You **must** read information in the same order as you write it.
    --- Each net message has a length limit of **64KB**!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L14-L18)
    -- @param messageName --- The message name to hook to.
    --- **NOTE**: The message-name is converted to lower-case so the message-names "`BigBlue`" and "`bigblue`" would be equal.
    -- @param callback --- The function to be called if the specified message was received.
    --- <callback>
    --- <arg type="number" name="len">Length of the message, in bits.</arg>
    --- <arg type="Player" name="ply">The player that sent the message, works **only** server-side.</arg>
    --- </callback>
    Receive: function(messageName: string, callback: function)

    --- **INTERNAL**:
    --- This is NOT a function, it's a table used internally by the net library to store net receivers added with net.Receive.
    --- The key is the lowercase net message name and the value is the message's callback function.
    --- **NOTE**: Modifying net.Receivers won't affect the net string pool used in util.AddNetworkString.
    Receivers: table

    --- Sends the current net message to the specified player(s)
    -- @param ply --- The player to send the message to.
    Send: function(ply: GPlayer)

    --- Sends the current net message to the specified player(s)
    -- @param plys --- A table of players to send the message to.
    Send: function(plys: {GPlayer})

    --- Sends the current net message to the specified player(s)
    -- @param filter --- A recipient filter specifying message targets.
    Send: function(filter: GCRecipientFilter)

    --- Sends the current message (see net.Start) to all except the player or players specified.
    -- @param ply --- The player to **NOT** send the message to.
    SendOmit: function(ply: GPlayer)

    --- Sends the current message (see net.Start) to all except the player or players specified.
    -- @param plys --- A table of players to **NOT** send the message to.
    SendOmit: function(plys: {GPlayer})

    --- Sends current net message (see net.Start) to all players that are in the same [Potentially Audible Set (PAS)](https://developer.valvesoftware.com/wiki/PAS) as the position, or simply said, it adds all players that can potentially hear sounds from this position.
    -- @param position --- PAS position.
    SendPAS: function(position: GVector)

    --- Sends current net message (see net.Start) to all players in the [PVS (Potential Visibility Set)](https://developer.valvesoftware.com/wiki/PVS "PVS - Valve Developer Community") of the position, or, more simply said, sends the message to players that can potentially see this position.
    -- @param position --- Position that must be in players' visibility set.
    SendPVS: function(position: GVector)

    --- Sends the current net message (see net.Start) to the server. The player object must exist on the server for the net message to be received successfully by the server.
    --- **WARNING**: Each net message has a length limit of 65,533 bytes (approximately 64 KiB) and your net message will error and fail to send if it is larger than this.
    --- The message name must be pooled with util.AddNetworkString beforehand!
    SendToServer: function()

    --- Begins a new net message. If another net message is already started and hasn't been sent yet, it will be discarded.
    --- After calling this function, you will want to call `net.Write` functions to write your data, if any, and then finish with a call to one of the following functions:
    --- * net.Send
    --- * net.SendOmit
    --- * net.SendPAS
    --- * net.SendPVS
    --- * net.Broadcast
    --- * net.SendToServer
    --- **WARNING**: Each net message has a length limit of 65,533 bytes (approximately 64 KiB) and your net message will error and fail to send if it is larger than this.
    --- The net library has an internal buffer that sent messages are added to that is capable of holding roughly 256 kb at a time. Trying to send more will lead to the client being kicked because of a buffer overflow. More information on net library limits can be found here.
    --- The message name must be pooled with util.AddNetworkString beforehand!
    --- Net messages will not reliably reach the client until the client's GM:InitPostEntity hook is called.
    -- @param messageName --- The name of the message to send
    -- @param unreliable --- If set to `true`, the message is not guaranteed to reach its destination
    -- @return --- `true` if the message has been started.
    Start: function(messageName: string, unreliable: boolean): boolean

    --- Writes an angle to the current net message.
    -- @param angle --- The angle to be sent.
    WriteAngle: function(angle: GAngle)

    --- Appends a boolean (as `1` or `0`) to the current net message.
    --- Please note that the bit is written here from a boolean (`true/false`) but net.ReadBit returns a number.
    -- @param boolean --- Bit status (false = `0`, true = `1`).
    WriteBit: function(boolean: boolean)

    --- Appends a boolean to the current net message. Alias of net.WriteBit.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L41-L41)
    -- @param boolean --- Boolean value to write.
    WriteBool: function(boolean: boolean)

    --- Appends a Color to the current net message.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L103-L116)
    -- @param Color --- The Color you want to append to the net message.
    -- @param writeAlpha --- If we should write the alpha of the color or not.
    WriteColor: function(Color: table, writeAlpha: boolean)

    --- Writes a chunk of binary data to the message.
    -- @param binaryData --- The binary data to be sent.
    -- @param length --- The length of the binary data to be sent, in bytes.
    WriteData: function(binaryData: string, length: number)

    --- Appends a double-precision number to the current net message.
    -- @param double --- The double to be sent
    WriteDouble: function(double: number)

    --- Appends an entity to the current net message using its Entity:EntIndex.
    --- See net.ReadEntity for the function to read the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L56-L64)
    -- @param entity --- The entity to be sent.
    WriteEntity: function(entity: GEntity)

    --- Appends a float (number with decimals) to the current net message.
    -- @param float --- The float to be sent.
    WriteFloat: function(float: number)

    --- Appends a signed integer - a whole number, positive/negative - to the current net message. Can be read back with net.ReadInt on the receiving end.
    --- Use net.WriteUInt to send an unsigned number (that you know will **never** be negative). Use net.WriteFloat for a non-whole number (e.g. `2.25`).
    -- @param integer --- The integer to be sent.
    -- @param bitCount --- The amount of bits the number consists of. This must be **32** or less.
    --- If you are unsure what to set, just set it to `32`.
    --- Consult the table below to determine the bit count you need:
    --- | Bit Count |  Minimum value |  Maximum value |
    --- |-----------|:--------------:|:--------------:|
    --- | 3 | -4 | 3 |
    --- | 4 | -8 | 7 |
    --- | 5 | -16 | 15 |
    --- | 6 | -32 | 31 |
    --- | 7 | -64 | 63 |
    --- | 8 | -128 | 127 |
    --- | 9 | -256 | 255 |
    --- | 10 | -512 | 511 |
    --- | 11 | -1,024 | 1,023 |
    --- | 12 | -2,048 | 2,047 |
    --- | 13 | -4,096 | 4,095 |
    --- | 14 | -8,192 | 8,191 |
    --- | 15 | -16,384 | 16,383 |
    --- | 16 | -32,768 | 32,767 |
    --- | 17 | -65,536 | 65,535 |
    --- | 18 | -131,072 | 131,071 |
    --- | 19 | -262,144 | 262,143 |
    --- | 20 | -524,288 | 524,287 |
    --- | 21 | -1,048,576 | 1,048,575 |
    --- | 22 | -2,097,152 | 2,097,151 |
    --- | 23 | -4,194,304 | 4,194,303 |
    --- | 24 | -8,388,608 | 8,388,607 |
    --- | 25 | -16,777,216 | 16,777,215 |
    --- | 26 | -33,554,432 | 33,554,431 |
    --- | 27 | -67,108,864 | 67,108,863 |
    --- | 28 | -134,217,728 | 134,217,727 |
    --- | 29 | -268,435,456 | 268,435,455 |
    --- | 30 | -536,870,912 | 536,870,911 |
    --- | 31 | -1,073,741,824 | 1,073,741,823 |
    --- | 32 | -2,147,483,648 | 2,147,483,647 |
    WriteInt: function(integer: number, bitCount: number)

    --- Writes a VMatrix to the current net message.
    -- @param matrix --- The matrix to be sent.
    WriteMatrix: function(matrix: GVMatrix)

    --- Writes a normalized/direction vector ( Vector with length of 1 ) to the net message.
    --- This function uses less bandwidth compared to net.WriteVector and will not send vectors with length of > 1 properly.
    -- @param normal --- The normalized/direction vector to be send.
    WriteNormal: function(normal: GVector)

    --- Appends a player entity to the current net message using its Entity:EntIndex. This saves a small amount of network bandwidth over net.WriteEntity.
    --- See net.ReadPlayer for the function to read the entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L76-L87)
    -- @param ply --- The player to be sent.
    WritePlayer: function(ply: GPlayer)

    --- Appends a string to the current net message. The size of the written data is 8 bits for every ASCII character in the string + 8 bits for the null terminator.
    --- The maximum allowed length of a single written string is **65532 characters**. (aka the limit of the net message itself)
    -- @param string --- The string to be sent.
    --- The input will be terminated at the first null byte if one is present. See net.WriteData if you wish to write binary data.
    WriteString: function(string: string)

    --- Appends a table to the current net message. Adds **16 extra bits** per key/value pair, so you're better off writing each individual key/value as the exact type if possible.
    --- **WARNING**: All net messages have a **64kb** buffer. This function will not check or error when that buffer is overflown. You might want to consider using util.TableToJSON and util.Compress and send the resulting string in **60kb** chunks, doing the opposite on the receiving end.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L127-L154)
    -- @param table --- The table to be sent.
    --- **WARNING**: If the table contains a `nil` key the table may not be read correctly.
    --- Not all objects can be sent over the network. Things like functions, IMaterials, etc will cause errors when reading the table from a net message.
    --- Each element is also limited by the constraint of the `net.Write<luatype>` function for the element type.</luatype>
    -- @param sequential --- Set to `true` if the input table is sequential. This saves on bandwidth, adding **8 extra bits** per key/value pair instead of 16 bits.
    --- **NOTE**: To read the table you need to give net.ReadTable the same value!
    WriteTable: function(table: table, sequential: boolean)

    --- **INTERNAL**: Used internally by net.WriteTable.
    --- Appends any type of value to the current net message.
    --- **NOTE**: An additional 8-bit unsigned integer indicating the type will automatically be written to the packet before the value, in order to facilitate reading with net.ReadType. If you know the data type you are writing, use a function meant for that specific data type to reduce amount of data sent.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/net.lua#L199-L213)
    -- @param Data --- The data to be sent.
    WriteType: function(Data: any)

    --- Appends an unsigned integer with the specified number of bits to the current net message.
    --- Use net.WriteInt if you want to send negative and positive numbers. Use net.WriteFloat for a non-whole number (e.g. `2.25`).
    --- **NOTE**: Unsigned numbers **do not** support negative numbers.
    -- @param unsignedInteger --- The unsigned integer to be sent.
    -- @param bitCount --- The size of the integer to be sent, in bits. Acceptable values range from any number `1` to `32` inclusive.
    --- For reference: `1` = bit, `4` = nibble, `8` = byte, `16` = short, `32` = long.
    --- Consult the table below to determine the bit count you need. The minimum value for all bit counts is `0`.
    --- | Bit Count |  Maximum value |
    --- |-----------|:--------------:|
    --- | 1 | 1  |
    --- | 2 | 3  |
    --- | 3 | 7  |
    --- | 4 | 15 |
    --- | 5 | 31 |
    --- | 6 | 63 |
    --- | 7 | 127 |
    --- | 8 | 255 |
    --- | 9 | 511 |
    --- | 10 | 1,023 |
    --- | 11 | 2,047 |
    --- | 12 | 4,095 |
    --- | 13 | 8,191 |
    --- | 14 | 16,383 |
    --- | 15 | 32,767 |
    --- | 16 | 65,535 |
    --- | 17 | 131,071 |
    --- | 18 | 262,143 |
    --- | 19 | 524,287  |
    --- | 20 | 1,048,575  |
    --- | 21 | 2,097,151  |
    --- | 22 | 4,194,303  |
    --- | 23 | 8,388,607  |
    --- | 24 | 16,777,215  |
    --- | 25 | 33,554,431  |
    --- | 26 | 67,108,863  |
    --- | 27 | 134,217,727  |
    --- | 28 | 268,435,455  |
    --- | 29 | 536,870,911  |
    --- | 30 | 1,073,741,823 |
    --- | 31 | 2,147,483,647 |
    --- | 32 | 4,294,967,295 |
    WriteUInt: function(unsignedInteger: number, bitCount: number)

    --- Appends an unsigned integer with 64 bits to the current net message.
    --- The limit for an uint64 is 18'446'744'073'709'551'615.
    --- Everything above the limit will be set to the limit.
    --- Unsigned numbers **do not** support negative numbers.
    -- @param uint64 --- The 64 bit value to be sent. Can be a number.
    --- **WARNING**: Since Lua cannot store full 64-bit integers, this function takes a string. It is mainly aimed at usage with Player:SteamID64.
    --- If your input is a number and not a string, it won't be networked correctly as soon as it has more than 13 digits.
    --- This is because Lua represents numbers over 13 digits as `1e+14`(`100 000 000 000 000`)
    --- You can do something like this to convert it to a string: `string.format("%.0f", number)`.
    --- If you try to use Global.tostring it will fail because it will create a result something like `1e+14` which doesn't work.
    WriteUInt64: function(uint64: string)

    --- **INTERNAL**:
    --- A list of types that can be sent over the network via net.WriteType.
    WriteVars: table

    --- Appends a vector to the current net message.
    --- Vectors sent by this function are compressed, which may result in precision loss. XYZ components greater than `16384` or less than `-16384` are irrecoverably altered (most significant bits are trimmed) and precision after the decimal point is low.
    -- @param vector --- The vector to be sent.
    WriteVector: function(vector: GVector)
end


--- Used to display notifications on the screen (mid-right).
global record notification
    --- Adds a standard notification to your screen.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/notification.lua#L66-L85)
    -- @param text --- The text to display.
    -- @param type --- Determines the notification method (e.g. icon) for displaying the notification. See the Enums/NOTIFY.
    -- @param length --- The number of seconds to display the notification for.
    AddLegacy: function(text: string, type: number, length: number)

    --- Adds a notification with an animated progress bar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/notification.lua#L26-L55)
    -- @param id --- Can be any type. It's used as an index.
    -- @param strText --- The text to show
    -- @param frac --- If set, overrides the progress bar animation with given percentage. Range is 0 to 1.
    AddProgress: function(id: any, strText: string, frac: number)

    --- Removes the notification after 0.8 seconds.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/notification.lua#L57-L64)
    -- @param uid --- The unique ID of the notification
    Kill: function(uid: any)
end


--- The numpad module allows you to execute functions on a key press or release.
global record numpad
    --- Activates numpad key owned by the player
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L96-L117)
    -- @param ply --- The player whose numpad should be simulated
    -- @param key --- The key to press, see Enums/KEY
    -- @param isButton --- Should this keypress pretend to be a from a `gmod_button`? (causes numpad.FromButton to return `true`)
    Activate: function(ply: GPlayer, key: number, isButton: boolean)

    --- Deactivates numpad key owned by the player
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L122-L140)
    -- @param ply --- The player whose numpad should be simulated
    -- @param key --- The key to press, corresponding to Enums/KEY
    -- @param isButton --- Should this keypress pretend to be a from a `gmod_button`? (causes numpad.FromButton to return `true`)
    Deactivate: function(ply: GPlayer, key: number, isButton: boolean)

    --- Returns true during a function added with numpad.Register when the third argument to numpad.Activate is true.
    --- This is caused when a numpad function is triggered by a button SENT being used.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L30-L34)
    -- @return --- wasButton
    FromButton: function(): boolean

    --- Calls a function registered with numpad.Register when a player presses specified key.
    --- See for key released action: numpad.OnUp
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L174-L187)
    -- @param ply --- The player whose numpad should be watched
    -- @param key --- The key, corresponding to Enums/KEY
    -- @param name --- The name of the function to run, corresponding with the one used in numpad.Register
    -- @param ... --- Arguments to pass to the function passed to numpad.Register.
    -- @return --- The impulse ID
    OnDown: function(ply: GPlayer, key: number, name: string, ...: any): number

    --- Calls a function registered with numpad.Register when a player releases specified key.
    --- See for key pressed action: numpad.OnDown
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L192-L205)
    -- @param ply --- The player whose numpad should be watched
    -- @param key --- The key, corresponding to Enums/KEY
    -- @param name --- The name of the function to run, corresponding with the one used in numpad.Register
    -- @param ... --- Arguments to pass to the function passed to numpad.Register.
    -- @return --- The impulse ID
    OnUp: function(ply: GPlayer, key: number, name: string, ...: any): number

    --- Registers a numpad library action for use with numpad.OnDown and numpad.OnUp
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L241-L245)
    -- @param id --- The unique id of your action.
    -- @param func --- The function to be executed.
    --- <callback>
    --- <arg type="Player" name="ply">The player who pressed the button</arg>
    --- <arg type="vararg" name="data">The 4th and all subsequent arguments passed from numpad.OnDown and/or numpad.OnUp.</arg>
    --- <ret type="boolean" name="data" default="nil">Returning `false` in this function will remove the listener which triggered this function
    --- (example: return `false` if one of your varargs is an entity which is no longer valid)</ret>
    --- </callback>
    Register: function(id: string, func: function)

    --- Removes a function added by either numpad.OnUp or numpad.OnDown
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L229-L236)
    -- @param ID --- The impulse ID returned by numpad.OnUp or numpad.OnDown
    Remove: function(ID: number)

    --- Either runs numpad.Activate or numpad.Deactivate depending on the key's current state
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/numpad.lua#L145-L154)
    -- @param ply --- The player whose numpad should be simulated
    -- @param key --- The key to press, corresponding to Enums/KEY
    Toggle: function(ply: GPlayer, key: number)
end


--- The os library is a standard Lua library originally intended to allow Lua access to various features of the Operating System it's running on, however many of the features and functions have been removed in Garry's Mod due to security issues. It's only used in Garry's Mod for date & time operations.
global record os
    --- Returns the approximate cpu time the application ran.
    --- See also Global.SysTime
    --- **NOTE**: This function has different precision on Linux (1/100).
    -- @return --- runtime
    clock: function(): number

    --- Returns the date/time as a formatted string or in a table.
    -- @param format --- The format string.
    --- If this is equal to `*t` or `!*t` then this function will return a Structures/DateData, otherwise it will return a string.
    --- If this starts with an `!`, the returned data will use the UTC timezone rather than the local timezone.
    --- See http://www.mkssoftware.com/docs/man3/strftime.3.asp for available format flags.
    --- **BUG**: [**Not all flags are available on all operating systems** and the result of using an invalid flag is undefined. This currently crashes the game on Windows. Most or all flags are available on OS X and Linux but considerably fewer are available on Windows. See http://msdn.microsoft.com/en-us/library/fe06s4ak.aspx for a list of available flags on Windows. Note that the **#** flags also crashes the game on Windows.](https://github.com/Facepunch/garrysmod-issues/issues/329
    --- Known formats that work on all platforms:
    --- | Format | Description | Example of the output |
    --- |:------:|:-----------:|:---------------------:|
    --- | `%a` | Abbreviated weekday name | `Wed` |
    --- | `%A` | Full weekday name | `Wednesday` |
    --- | `%b` | Abbreviated month name | `Sep` |
    --- | `%B` | Full month name | `September` |
    --- | `%c` | Locale-appropriate date and time | Varies by platform and language settings |
    --- | `%d` | Day of the month [01-31] | `16` |
    --- | `%H` | Hour, using a 24-hour clock [00-23] | `23` |
    --- | `%I` | Hour, using a 12-hour clock [01-12] | `11` |
    --- | `%j` | Day of the year [001-365] | `259` |
    --- | `%m` | Month [01-12] | `09` |
    --- | `%M` | Minute [00-59] | `48` |
    --- | `%p` | Either `am` or `pm` | `pm` |
    --- | `%S` | Second [00-60] | `10` |
    --- | `%w` | Weekday [0-6 = Sunday-Saturday] | `3` |
    --- | `%W` | Week of the year [00-53] | `37` |
    --- | `%x` | Date (Same as `%m/%d/%y`) | `09/16/98` |
    --- | `%X` | Time (Same as `%H:%M:%S`) | `23:48:10` |
    --- | `%y` | Two-digit year [00-99] | `98` |
    --- | `%Y` | Full year | `1998` |
    --- | `%z` | Timezone | `-0300` |
    --- | `%%` | A percent sign | `%` |
    -- @param time --- Time to use for the format.
    -- @return --- Formatted date
    --- **NOTE**: This will be a Structures/DateData if the first argument equals to `*t` or `!*t`
    date: function(format: string, time: number): string

    --- Subtracts the second from the first value and rounds the result.
    -- @param timeA --- The first value.
    -- @param timeB --- The value to subtract.
    -- @return --- diffTime
    difftime: function(timeA: number, timeB: number): number

    --- Returns the system time in seconds past the unix epoch. If a table is supplied, the function attempts to build a system time with the specified table members.
    -- @param dateData --- Table to generate the time from. This table's data is interpreted as being in the local timezone. See Structures/DateData
    -- @return --- Seconds passed since Unix epoch
    time: function(dateData: table): number
end


--- The package library is a standard Lua library, it's mainly for use with the module system built into Lua.
global record package
    --- A list of all loaded packages.
    loaded: table

    --- Sets a metatable for module with its __index field referring to the global environment, so that this module inherits values from the global environment. To be used as an option to Global.module.
    -- @param module --- The module table to be given a metatable
    seeall: function(module: table)
end


--- Used to ask player for various potentially dangerous permissions.
global record permissions
    --- Requests the player to connect to a specified server. The player will be prompted with a confirmation window.
    -- @param address --- The address to ask to connect to. If a port is not given, the default `:27015` port will be added.
    AskToConnect: function(address: string)



    --- Activates player's microphone as if they pressed the speak button themself. The player will be prompted with a confirmation window which grants permission temporarily/permanently(depending on checkbox state) for the connected server (revokable).
    --- This is used for TTT's traitor voice channel.
    -- @param enable --- Enable or disable voice activity. `true` will run `+voicerecord` command, anything else `-voicerecord`.
    EnableVoiceChat: function(enable: boolean)





    --- Returns whether the player has granted the current server a specific permission.
    -- @param permission --- The permission to poll. Currently only 2 permission are valid:
    --- * `"connect"`
    --- * `"voicerecord"`
    -- @return --- Whether the permission is granted or not.
    IsGranted: function(permission: string): boolean
end


--- The physenv library allows you to control the physics environment created by the engine, and lets you modify constants such as gravity and maximum velocity.
global record physenv
    --- Adds a [material surface property](https://developer.valvesoftware.com/wiki/Material_surface_properties) type to the game's physics environment.
    --- See util.GetSurfaceData for the opposite function.
    --- **BUG**: [The game has a limit of 128 surface properties - this includes properties loaded automatically from [surfaceproperties.txt](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/scripts/surfaceproperties.txt). Due to this, there's only a small amount of open slots that can be registered with GMod's provided surfaceproperties.txt.](https://github.com/Facepunch/garrysmod-issues/issues/2604
    --- Does nothing on `x86-64` beta.
    -- @param properties --- The properties to add. Each one should include `"base"` or the game will crash due to some values being missing.
    AddSurfaceData: function(properties: string)

    --- Returns the air density used to calculate drag on physics objects.
    --- **VALIDATE**: The unit is in `kg/m³`.
    -- @return airDensity --- Default value is 2.
    GetAirDensity: function(): number

    --- Gets the gravitational acceleration used for physics objects in `source_unit/s^2`.
    -- @return --- Gravity direction and strength.
    GetGravity: function(): GVector

    --- Returns the last simulation duration of the in-game physics.
    -- @return --- The last simulation duration of the in-game physics in seconds
    GetLastSimulationTime: function(): number

    --- Gets the current performance settings in table form.
    -- @return --- Performance settings or nil if called too early. See Structures/PhysEnvPerformanceSettings
    GetPerformanceSettings: function(): table

    --- Returns the pause status of global physics simulation. See physenv.SetPhysicsPaused for the setter.
    -- @return --- `true` if paused.
    GetPhysicsPaused: function(): boolean

    --- Sets the air density.
    -- @param airDensity --- The new air density.
    SetAirDensity: function(airDensity: number)

    --- Sets the gravitational acceleration used for physics objects. Does not affect players.
    -- @param gravAccel --- The new gravity in `source_unit/s^2`.
    SetGravity: function(gravAccel: GVector)

    --- Sets the performance settings.
    -- @param performanceSettings --- The new performance settings. See Structures/PhysEnvPerformanceSettings
    SetPerformanceSettings: function(performanceSettings: table)

    --- Pauses or unpauses the physics simulation globally. See physenv.GetPhysicsPaused for the getter.
    -- @param pause --- `true` to pause, `false` to unpause.
    SetPhysicsPaused: function(pause: boolean)
end


--- The player library is used to get the Lua objects that represent players in-game.
global record player
    --- Similar to the serverside command "bot", this function creates a new Player bot with the given name. This bot will not obey to the usual `bot_*` commands, and it's the same bot base used in TF2 and CS:S.
    --- The best way to control the behaviour of a Player bot right now is to use the GM:StartCommand hook and modify its input serverside.
    --- **NOTE**: Despite this Player being fake, it has to be removed from the server by using Player:Kick and **NOT** Entity:Remove.
    --- Also keep in mind that these bots still use player slots, so you won't be able to spawn them in singleplayer!
    --- **NOTE**: Any Bot created using this method will be considered UnAuthed by Garry's Mod
    -- @param botName --- The name of the bot, using an already existing name will append brackets at the end of it with a number pertaining it.
    --- Example: "Bot name test", "Bot name test(1)".
    -- @return --- The newly created Player bot. Returns NULL if there's no Player slots available to host it.
    CreateNextBot: function(botName: string): GPlayer

    --- Gets all the current players in the server (not including connecting clients).
    --- This function returns bots as well as human players. See player.GetBots and  player.GetHumans.
    --- **NOTE**: This function returns a sequential table, meaning it should be looped with Global.ipairs instead of Global.pairs for efficiency reasons.
    -- @return --- All Players currently in the server.
    GetAll: function(): {GPlayer}

    --- Returns a table of all bots on the server.
    -- @return --- A table only containing bots ( AI / non human players )
    GetBots: function(): {GPlayer}

    --- Tried to get the player with the specified Player:AccountID.
    --- **WARNING**: Internally this function iterates over all players in the server, meaning it can be quite expensive in a performance-critical context.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L265-L274)
    -- @param accountID --- The Player:AccountID to find the player by.
    -- @return --- Player if one is found, `false` otherwise.
    GetByAccountID: function(accountID: number): GPlayer|boolean

    --- Gets the player with the specified connection ID.
    --- Connection ID can be retrieved via gameevent.Listen events.
    --- For a function that returns a player based on their Entity:EntIndex, see Global.Entity.
    --- For a function that returns a player based on their Player:UserID, see Global.Player.
    -- @param connectionID --- The connection ID to find the player by.
    -- @return --- Player if one is found, `NULL` otherwise.
    GetByID: function(connectionID: number): GPlayer

    --- Gets the player with the specified SteamID.
    --- **WARNING**: Internally this function iterates over all players in the server, meaning it can be quite expensive in a performance-critical context.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L287-L297)
    -- @param steamID --- The Player:SteamID to find the player by.
    -- @return --- Player if one is found, `false` otherwise.
    GetBySteamID: function(steamID: string): GPlayer|boolean

    --- Gets the player with the specified SteamID64.
    --- **WARNING**: Internally this function iterates over all players in the server, meaning it can be quite expensive in a performance-critical context.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L299-L308)
    -- @param steamID64 --- The Player:SteamID64 to find the player by.
    -- @return --- Player if one is found, `false` otherwise.
    GetBySteamID64: function(steamID64: string): GPlayer|boolean

    --- @deprecated
    --- **DEPRECATED**: Use player.GetBySteamID64, player.GetBySteamID or player.GetByAccountID to get a player by a unique identifier instead.
    --- Gets the player with the specified uniqueID (not recommended way to identify players).
    --- **WARNING**: It is highly recommended to use player.GetByAccountID, player.GetBySteamID or player.GetBySteamID64 instead as this function can have collisions ( be same for different people ) while SteamID is guaranteed to unique to each player.
    --- **WARNING**: Internally this function iterates over all players in the server, meaning it can be quite expensive in a performance-critical context.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player.lua#L276-L285)
    -- @param uniqueID --- The Player:UniqueID to find the player by.
    -- @return --- Player if one is found, `false` otherwise.
    GetByUniqueID: function(uniqueID: string): GPlayer|boolean

    --- Returns the active player count.
    --- **NOTE**: Similar to **#**player.GetAll() but with better performance since the player table doesn't have to be generated. If player.GetAll is already being called for iteration, then using the **#** operator on the table will be faster than calling this function since it is JITted.
    --- **NOTE**: Players who are currently connecting to the server will not be counted. See function: player.GetCountConnecting
    -- @return --- Number of players.
    GetCount: function(): number

    --- Returns the amount of players connecting to the server, but not yet spawned in.
    --- `player.GetCountConnecting() + player.GetCount()` would result in the total player count on this server.
    -- @return --- Number of players still connecting.
    GetCountConnecting: function(): number

    --- Returns a table containing all human players (non-bot/AI).
    --- Unlike player.GetAll, this does not include bots.
    --- **NOTE**: This function returns a sequential table, meaning it should be looped with Global.ipairs instead of Global.pairs for efficiency reasons.
    -- @return --- A table containing all human (non-bot/AI) players.
    GetHumans: function(): {GPlayer}

    --- Returns a [Stateless Iterator](https://www.lua.org/pil/7.3.html) for all players on the server.
    --- Intended for use in [Generic For-Loops](https://www.lua.org/pil/4.3.5.html).
    --- See ents.Iterator for a similar function for all entities.
    --- **NOTE**: Internally, this function uses cached values that are stored in Lua, as opposed to player.GetAll, which is a C++ function.
    --- Because a call operation from Lua to C++ *and* with a return back to Lua is quite costly, this function will be more efficient than player.GetAll.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity_iter.lua#L13-L20)
    -- @return --- The Iterator Function from ipairs.
    -- @return --- Table of all existing Players.  This is a cached copy of player.GetAll.
    --- **WARNING**: This table is intended to be read-only.
    --- Modifying the return table will affect all subsequent calls to this function until the cache is refreshed, replacing all of your player.GetAll usages may come with unintended side effects because of this.
    --- An example:
    --- ```
    --- -- Bad code.
    --- local scan_ents = select( 2, player.Iterator() )
    --- table.Add( scan_ents, ents.FindByClass( "ttt_decoy" ) )
    --- -- Fine code. A copy of the table is being made and used.
    --- local scan_ents = table.Copy( select( 2, player.Iterator() ) )
    --- table.Add( scan_ents, ents.FindByClass( "ttt_decoy" ) )
    --- ```
    -- @return --- The starting index for the table of players.
    --- This is always `0` and is returned for the benefit of [Generic For-Loops](https://www.lua.org/pil/4.3.5.html).
    Iterator: function(): function, {GPlayer}, number
end


--- The player_manager library lets you manage players, such as setting their models or creating player classes.
global record player_manager
    --- Assigns view model hands to player model.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L27-L34)
    -- @param name --- Player model name.
    -- @param model --- Hands model.
    -- @param skin --- Skin to apply to the hands.
    -- @param bodygroups --- Bodygroups to apply to the hands. See Entity:SetBodyGroups for help with the format.
    -- @param matchBodySkin --- If set to `true`, the skin of the hands will be set to the skin of the playermodel.
    --- This is useful when player models have multiple user-selectable skins.
    AddValidHands: function(name: string, model: string, skin: number, bodygroups: string, matchBodySkin: boolean)

    --- Associates a simplified name with a path to a valid player model.
    --- Only used internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L17-L25)
    -- @param name --- Simplified name.
    -- @param model --- Valid PlayerModel path.
    AddValidModel: function(name: string, model: string)

    --- Returns the entire list of valid player models.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L36-L41)
    -- @return --- List of all valid player models.
    AllValidModels: function(): table

    --- Clears a player's class association by setting their ClassID to 0.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L399-L403)
    -- @param ply --- Player to clear class from.
    ClearPlayerClass: function(ply: GPlayer)

    --- Gets a players class.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L390-L397)
    -- @param ply --- Player to get class.
    -- @return --- The players class.
    GetPlayerClass: function(ply: GPlayer): string

    --- Gets a players' class table.
    -- @param ply --- Player to get class of.
    -- @return --- The players class table.
    GetPlayerClassTable: function(ply: GPlayer): table

    --- Retrieves a copy of all registered player classes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L300-L304)
    -- @return --- A copy of all registered player classes.
    GetPlayerClasses: function(): table

    --- Applies basic class variables when the player spawns.
    --- Called from GM:PlayerSpawn in the base gamemode.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L433-L457)
    -- @param ply --- Player to setup.
    -- @param transiton --- If true, the player just spawned from a map transition. You probably want to not touch player's weapons or position if this is set to `true`.
    OnPlayerSpawn: function(ply: GPlayer, transiton: boolean)

    --- Register a class metatable to be assigned to players later.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L350-L375)
    -- @param name --- Class name.
    -- @param table --- Class metatable, see Structures/PLAYER.
    -- @param base --- Base class name.
    RegisterClass: function(name: string, table: table, base: string)

    --- Execute a named function within the player's set class.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L405-L415)
    -- @param ply --- Player to execute function on.
    -- @param funcName --- Name of function.
    -- @param arguments --- Optional arguments. Can be of any type.
    -- @return --- The values returned by the called function.
    RunClass: function(ply: GPlayer, funcName: string, ...: any): any...

    --- Sets a player's class.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L377-L388)
    -- @param ply --- Player to set class.
    -- @param className --- Name of class to set.
    SetPlayerClass: function(ply: GPlayer, className: string)

    --- Retrieves correct hands for given player model. By default returns citizen hands.
    --- **NOTE**: See player_manager.AddValidHands for defining/linking hands to a model - this must be defined somewhere otherwise the model will return citizen hands here.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L69-L79)
    -- @param name --- Player model name.
    -- @return --- A table with following contents:
    --- * string model - Model of hands.
    --- * number skin - Skin of hands.
    --- * string body - Bodygroups of hands.
    TranslatePlayerHands: function(name: string): table

    --- Returns the valid model path for a simplified name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L44-L55)
    -- @param shortName --- The short name of the model.
    -- @return --- The valid model path for the short name.
    TranslatePlayerModel: function(shortName: string): string

    --- Returns the simplified name for a valid model path of a player model.
    --- Opposite of player_manager.TranslatePlayerModel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/player_manager.lua#L57-L67)
    -- @param model --- The model path to a player model.
    -- @return --- The simplified name for that model.
    TranslateToPlayerModelName: function(model: string): string
end


--- The presets library lets you add and modify the pre-set options for scripted tools (selected via the white bar at the top of each tools control panel).
global record presets
    --- Adds preset to a preset group.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L33-L46)
    -- @param groupname --- The preset group name, usually it's tool class name.
    -- @param name --- Preset name, must be unique.
    -- @param values --- A table of preset console commands.
    Add: function(groupname: string, name: string, values: table)

    --- **INTERNAL**:
    --- Used internally to tell the player that the name they tried to use in their preset is not acceptable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L81-L85)
    BadNameAlert: function()

    --- Returns whether a preset with given name exists or not
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L20-L31)
    -- @param type --- The preset group name, usually it's tool class name.
    -- @param name --- Name of the preset to test
    -- @return --- true if the preset does exist
    Exists: function(type: string, name: string): boolean

    --- Returns a table with preset names and values from a single preset group.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L8-L18)
    -- @param groupname --- Preset group name.
    -- @return --- All presets in specified group.
    GetTable: function(groupname: string): table

    --- **INTERNAL**:
    --- Used internally to ask the player if they want to override an already existing preset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L87-L91)
    -- @param callback ---
    OverwritePresetPrompt: function(callback: function)

    --- Removes a preset entry from a preset group.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L65-L78)
    -- @param groupname --- Preset group to remove from
    -- @param name --- Name of preset to remove
    Remove: function(groupname: string, name: string)

    --- Renames preset.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/presets.lua#L48-L63)
    -- @param groupname --- Preset group name
    -- @param oldname --- Old preset name
    -- @param newname --- New preset name
    Rename: function(groupname: string, oldname: string, newname: string)
end


--- The properties library gives you access to the menu that shows up when right clicking entities while holding C.
global record properties
    --- Add properties to the properties module. Properties can be blocked via GM:CanProperty.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/properties.lua#L28-L36)
    -- @param name --- A unique name used to identify the property
    -- @param propertyData --- A table that defines the property. Uses the Structures/PropertyAdd.
    Add: function(name: string, propertyData: table)

    --- Returns true if given entity can be targeted by the player via the properties system.
    --- This should be used serverside in your properties to prevent abuse by clientside scripting.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/properties.lua#L104-L120)
    -- @param ent --- The entity to test
    -- @param ply --- If given, will also perform a distance check based on the entity's Orientated Bounding Box.
    -- @return --- True if entity can be targeted, false otherwise
    CanBeTargeted: function(ent: GEntity, ply: GPlayer): boolean

    --- Returns an entity player is hovering over with their cursor.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/properties.lua#L122-L156)
    -- @param pos --- Eye position of local player, Entity:EyePos
    -- @param aimVec --- Aim vector of local player, Player:GetAimVector
    -- @return --- The hovered entity
    GetHovered: function(pos: GVector, aimVec: GVector): GEntity

    --- A list of all properties registered with properties.Add.
    List: table

    --- Checks if player hovers over any entities and open a properties menu for it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/properties.lua#L93-L100)
    -- @param eyepos --- The eye pos of a player
    -- @param eyevec --- The aim vector of a player
    OnScreenClick: function(eyepos: GVector, eyevec: GVector)

    --- Opens properties menu for given entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/properties.lua#L74-L91)
    -- @param ent --- The entity to open menu for
    -- @param tr --- The trace that is passed as second argument to Action callback of a property
    OpenEntityMenu: function(ent: GEntity, tr: table)

    --- Remove an entity right-click property. See properties.Add for details.
    -- @param name --- A unique name used to identify the property to be removed.
    Remove: function(name: string)
end


--- The render library is a powerful set of functions that let you control how the world and its contents are rendered. It can also be used to draw some 3D clientside effects such as beams, boxes and spheres.
global record render
    --- Adds a Beam Segment to the Beam started by render.StartBeam.
    --- For more detailed information on Beams, as well as usage examples, see the Beams Render Reference.
    -- @param startPos --- Beam start position.
    -- @param width --- The width of the beam.
    -- @param textureEnd --- The end coordinate of the texture used.
    -- @param color --- The color to be used. Uses the Color.
    AddBeam: function(startPos: GVector, width: number, textureEnd: number, color: table)

    --- Blurs the render target ( or a given texture ).
    --- **WARNING**: Calling this on a RenderTarget created with TEXTUREFLAGS_POINTSAMPLE will result in strange visual glitching.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L88-L107)
    -- @param rendertarget --- The texture to blur.
    -- @param blurx --- Horizontal amount of blur.
    -- @param blury --- Vertical amount of blur.
    -- @param passes --- Amount of passes to go through.
    BlurRenderTarget: function(rendertarget: GITexture, blurx: number, blury: number, passes: number)

    --- This function overrides the brush material for next render operations. It can be used with Entity:DrawModel.
    -- @param mat ---
    BrushMaterialOverride: function(mat: GIMaterial)

    --- Captures a part of the current render target and returns the data as a binary string in the given format.
    --- Since the pixel buffer clears itself every frame, this will return a black screen outside of render hooks. To capture the user's final view, use GM:PostRender. This will not capture the Steam overlay or third-party injections (such as the Discord overlay, Overwolf, and advanced cheats) on the user's screen.
    --- **BUG**: [In PNG mode, this function can produce unexpected result where foreground is rendered as transparent.](https://github.com/Facepunch/garrysmod-issues/issues/2571
    --- This is caused by render.SetWriteDepthToDestAlpha set to `true` when doing most of render operations, including rendering in `_rt_fullframefb`. If you want to capture render target's content as PNG image only for output quality, set Structures/RenderCaptureData's `alpha` to `false` when capturing render targets with render.SetWriteDepthToDestAlpha set to `true`.
    --- **WARNING**: This function will return nil if escape menu is open
    -- @param captureData --- Parameters of the capture. See Structures/RenderCaptureData.
    -- @return --- The binary data.
    Capture: function(captureData: table): string

    --- **NOTE**: Provides a 2D rendering context
    --- Dumps the current render target and allows the pixels to be accessed by render.ReadPixel.
    --- Capturing outside a render hook will return 0 0 0 255.
    CapturePixels: function()

    --- Clears the current render target and the specified buffers.
    --- **BUG**: [This sets the alpha incorrectly for surface draw calls for render targets.](https://github.com/Facepunch/garrysmod-issues/issues/2085
    -- @param r --- Red component to clear to.
    -- @param g --- Green component to clear to.
    -- @param b --- Blue component to clear to.
    -- @param a --- Alpha component to clear to.
    -- @param clearDepth --- Clear the depth.
    -- @param clearStencil --- Clear the stencil.
    Clear: function(r: number, g: number, b: number, a: number, clearDepth: boolean, clearStencil: boolean)

    --- Tests every pixel of the active Render Target against the current Stencil configuration and sets the Color Channel values and, optionally, the Depth Buffer values for every pixel that passes.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page
    --- **NOTE**: This function does **not** clear the Stencil Buffer on its own.
    --- If you would like to clear the Stencil Buffer, you can use render.ClearStencil
    -- @param red --- The red Color Channel value for each pixel that is cleared.
    --- Must be an integer value in the range 0-255 (`byte`).
    -- @param green --- The green Color Channel value for each pixel that is cleared.
    --- Must be an integer value in the range 0-255 (`byte`).
    -- @param blue --- The blue Color Channel value for each pixel that is cleared.
    --- Must be an integer value in the range 0-255 (`byte`).
    -- @param alpha --- The alpha (translucency) Color Channel value for each pixel that is cleared.
    --- Must be an integer value in the range 0-255 (`byte`).
    -- @param clearDepth --- If true, reset the Depth Buffer values.
    ClearBuffersObeyStencil: function(red: number, green: number, blue: number, alpha: number, clearDepth: boolean)

    --- Resets the depth buffer.
    -- @param clearStencil --- Whether to also clear the stencil buffer.
    ClearDepth: function(clearStencil: boolean)

    --- Clears a render target.
    --- It uses render.Clear then render.SetRenderTarget on the modified render target.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L27-L39)
    -- @param texture ---
    -- @param color --- The color, see Color.
    ClearRenderTarget: function(texture: GITexture, color: table)

    --- Sets the Stencil Buffer value to `0` for all pixels in the currently active Render Target.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    ClearStencil: function()

    --- Sets the Stencil Buffer value for every pixel in a given rectangle to a given value.
    --- This is **not** affected by render.SetStencilWriteMask.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param startX --- The X coordinate of the top left corner of the rectangle to be cleared.
    -- @param startY --- The Y coordinate of the top left corner of the rectangle to be cleared.
    -- @param endX --- The X coordinate of the bottom right corner of the rectangle to be cleared.
    --- **Note:** Unlike some other rectangle-based functions, this is **not** the width of the rectangle.
    -- @param endY --- The Y coordinate of the bottom right corner of the rectangle to be cleared.
    --- **Note:** Unlike some other rectangle-based functions, this is **not** the height of the rectangle.
    -- @param stencilBufferValue --- The Stencil Buffer value that all pixels within the rectangle will be set to.
    ClearStencilBufferRectangle: function(startX: number, startY: number, endX: number, endY: number, stencilBufferValue: number)

    --- Calculates the lighting caused by dynamic lights for the specified surface.
    -- @param position --- The position to sample from.
    -- @param normal --- The normal of the surface.
    -- @return --- A vector representing the light at that point.
    ComputeDynamicLighting: function(position: GVector, normal: GVector): GVector

    --- Calculates the light color of a certain surface.
    -- @param position --- The position of the surface to get the light from.
    -- @param normal --- The normal of the surface to get the light from.
    -- @return --- A vector representing the light at that point.
    ComputeLighting: function(position: GVector, normal: GVector): GVector

    --- Calculates diameter of a 3D sphere on a 2D screen.
    --- **NOTE**: Provides a 3D rendering context
    -- @param point --- The position of the sphere in 3D space.
    -- @param radius --- The radius of the sphere in 3D space.
    -- @return --- The diameter of the sphere in 2D screen space.
    ComputePixelDiameterOfSphere: function(point: GVector, radius: number): number

    --- Copies the currently active Render Target to the specified texture.
    --- **WARNING**: This does not copy the Depth buffer, no method for that is known at this moment so a common workaround is to store the source texture somewhere else, perform your drawing operations, save the result somewhere else and reapply the source texture.
    -- @param Target --- The texture to copy to.
    CopyRenderTargetToTexture: function(Target: GITexture)

    --- Copies the contents of one texture to another. Only works with rendertargets.
    --- **WARNING**: This does not copy the Depth buffer, no method for that is known at this moment so a common workaround is to store the source texture somewhere else, perform your drawing operations, save the result somewhere else and reapply the source texture.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L61-L70)
    -- @param texture_from --- The texture to copy from.
    -- @param texture_to --- The texture being copied to.
    CopyTexture: function(texture_from: GITexture, texture_to: GITexture)

    --- Sets the cull mode. The culling mode defines how back faces are culled when rendering geometry.
    -- @param cullMode --- Cullmode, see Enums/MATERIAL_CULLMODE.
    CullMode: function(cullMode: number)

    --- Set's the depth range of the upcoming render.
    -- @param depthmin --- The minimum depth of the upcoming render. `0.0` = render normally; `1.0` = render nothing.
    -- @param depthmax --- The maximum depth of the upcoming render. `0.0` = render everything (through walls); `1.0` = render normally.
    DepthRange: function(depthmin: number, depthmax: number)

    --- **NOTE**: Provides a 3D rendering context
    --- Draws a single-segment Beam made out of a textured, billboarded quad stretching between two points.
    --- For more detailed information, including usage examples, see the Beams Render Reference.
    -- @param startPos --- The Beam's start position.
    -- @param endPos --- The Beam's end position.
    -- @param width --- The width of the Beam.
    -- @param textureStart --- The starting coordinate of the Beam's texture.
    -- @param textureEnd --- The end coordinate of the Beam's texture.
    -- @param color --- What Color to tint the Beam.
    DrawBeam: function(startPos: GVector, endPos: GVector, width: number, textureStart: number, textureEnd: number, color: GColor)

    --- Draws a box in 3D space.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Origin of the box.
    -- @param angles --- Orientation of the box.
    -- @param mins --- Start position of the box, relative to origin.
    -- @param maxs --- End position of the box, relative to origin.
    -- @param color --- The color of the box. Uses the Color.
    DrawBox: function(position: GVector, angles: GAngle, mins: GVector, maxs: GVector, color: table)

    --- Draws a line in 3D space.
    --- **NOTE**: Provides a 3D rendering context
    -- @param startPos --- Line start position in world coordinates.
    -- @param endPos --- Line end position in world coordinates.
    -- @param color --- The color to be used. Uses the Color.
    -- @param writeZ --- Whether or not to consider the Z buffer. If false, the line will be drawn over everything currently drawn, if true, the line will be drawn with depth considered, as if it were a regular object in 3D space.
    --- **BUG**: [Enabling this option will cause the line to ignore the color's alpha.](https://github.com/Facepunch/garrysmod-issues/issues/1086
    DrawLine: function(startPos: GVector, endPos: GVector, color: table, writeZ: boolean)

    --- Draws 2 connected triangles. Expects material to be set by render.SetMaterial.
    --- **NOTE**: Provides a 3D rendering context
    -- @param vert1 --- First vertex.
    -- @param vert2 --- The second vertex.
    -- @param vert3 --- The third vertex.
    -- @param vert4 --- The fourth vertex.
    -- @param color --- The color of the quad. See Global.Color
    DrawQuad: function(vert1: GVector, vert2: GVector, vert3: GVector, vert4: GVector, color: table)

    --- Draws a quad. Expects material to be set by render.SetMaterial.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Origin of the sprite.
    -- @param normal --- The face direction of the quad.
    -- @param width --- The width of the quad.
    -- @param height --- The height of the quad.
    -- @param color --- The color of the quad. Uses the Color.
    -- @param rotation --- The rotation of the quad counter-clockwise in degrees around the normal axis. In other words, the quad will always face the same way but this will rotate its corners.
    DrawQuadEasy: function(position: GVector, normal: GVector, width: number, height: number, color: table, rotation: number)

    --- Draws the current material set by render.SetMaterial to the whole screen. The color cannot be customized.
    --- See also render.DrawScreenQuadEx.
    --- **NOTE**: Provides a 2D rendering context
    -- @param applyPoster --- If set to true, when rendering a poster the quad will be properly drawn in parts in the poster. This is used internally by some Post Processing effects. Certain special textures (frame buffer like textures) do not need this adjustment.
    DrawScreenQuad: function(applyPoster: boolean)

    --- Draws the current material set by render.SetMaterial to the area specified. Color cannot be customized.
    --- See also render.DrawScreenQuad.
    --- **NOTE**: Provides a 2D rendering context
    -- @param startX --- X start position of the rect.
    -- @param startY --- Y start position of the rect.
    -- @param width --- Width of the rect.
    -- @param height --- Height of the rect.
    DrawScreenQuadEx: function(startX: number, startY: number, width: number, height: number)

    --- Draws a sphere in 3D space. The material previously set with render.SetMaterial will be applied the sphere's surface.
    --- See also render.DrawWireframeSphere for a wireframe equivalent.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Position of the sphere.
    -- @param radius --- Radius of the sphere. Negative radius will make the sphere render inwards rather than outwards.
    -- @param longitudeSteps --- The number of longitude steps. This controls the quality of the sphere. Higher quality will lower performance significantly. 50 is a good number to start with.
    -- @param latitudeSteps --- The number of latitude steps. This controls the quality of the sphere. Higher quality will lower performance significantly. 50 is a good number to start with.
    -- @param color --- The color of the sphere. Uses the Color.
    DrawSphere: function(position: GVector, radius: number, longitudeSteps: number, latitudeSteps: number, color: table)

    --- Draws a sprite in 3D space.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Position of the sprite.
    -- @param width --- Width of the sprite.
    -- @param height --- Height of the sprite.
    -- @param color --- Color of the sprite. Uses the Color.
    DrawSprite: function(position: GVector, width: number, height: number, color: table)

    --- Draws a texture over the whole screen.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L148-L156)
    -- @param tex --- The texture to draw.
    DrawTextureToScreen: function(tex: GITexture)

    --- Draws a textured rectangle.
    --- **NOTE**: Provides a 2D rendering context
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L158-L166)
    -- @param tex --- The texture to draw.
    -- @param x --- The x coordinate of the rectangle to draw.
    -- @param y --- The y coordinate of the rectangle to draw.
    -- @param width --- The width of the rectangle to draw.
    -- @param height --- The height of the rectangle to draw.
    DrawTextureToScreenRect: function(tex: GITexture, x: number, y: number, width: number, height: number)

    --- Draws a wireframe box in 3D space.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Position of the box.
    -- @param angle --- Angles of the box.
    -- @param mins --- The lowest corner of the box.
    -- @param maxs --- The highest corner of the box.
    -- @param color --- The color of the box. Uses the Color.
    -- @param writeZ --- Sets whenever to write to the zBuffer.
    DrawWireframeBox: function(position: GVector, angle: GAngle, mins: GVector, maxs: GVector, color: table, writeZ: boolean)

    --- Draws a wireframe sphere in 3d space.
    --- **NOTE**: Provides a 3D rendering context
    -- @param position --- Position of the sphere.
    -- @param radius --- The size of the sphere.
    -- @param longitudeSteps --- The amount of longitude steps.
    --- The larger this number is, the smoother the sphere is.
    -- @param latitudeSteps --- The amount of latitude steps.
    --- The larger this number is, the smoother the sphere is.
    -- @param color --- The color of the wireframe. Uses the Color.
    -- @param writeZ --- Whether or not to consider the Z buffer. If false, the wireframe will be drawn over everything currently drawn. If true, it will be drawn with depth considered, as if it were a regular object in 3D space.
    DrawWireframeSphere: function(position: GVector, radius: number, longitudeSteps: number, latitudeSteps: number, color: table, writeZ: boolean)

    --- Sets the status of the clip renderer, returning previous state.
    --- **WARNING**: To prevent unintended rendering behavior of other mods/the game, you must reset the clipping state to its previous value.
    -- @param state --- New clipping state.
    -- @return --- Previous clipping state.
    EnableClipping: function(state: boolean): boolean

    --- Ends the beam mesh of a beam started with render.StartBeam.
    --- For more detailed information on Beams, as well as usage examples, see the Beams Render Reference.
    EndBeam: function()

    --- Sets the color of the fog.
    -- @param red --- Red channel of the fog color, 0 - 255.
    -- @param green --- Green channel of the fog color, 0 - 255.
    -- @param blue --- Blue channel of the fog color, 0 - 255.
    FogColor: function(red: number, green: number, blue: number)

    --- Sets the at which the fog reaches its max density.
    -- @param distance --- The distance at which the fog reaches its max density.
    --- **NOTE**: If used in GM:SetupSkyboxFog, this value **must** be scaled by the first argument of the hook
    FogEnd: function(distance: number)

    --- Sets the maximum density of the fog.
    -- @param maxDensity --- The maximum density of the fog, 0-1.
    FogMaxDensity: function(maxDensity: number)

    --- Sets the mode of fog.
    -- @param fogMode --- Fog mode, see Enums/MATERIAL_FOG.
    FogMode: function(fogMode: E_MATERIAL_FOG)

    --- Sets the distance at which the fog starts showing up.
    -- @param fogStart --- The distance at which the fog starts showing up.
    --- **NOTE**: If used in GM:SetupSkyboxFog, this value **must** be scaled by the first argument of the hook
    FogStart: function(fogStart: number)

    --- Returns the ambient color of the map.
    -- @return --- The ambient color of the map.
    GetAmbientLightColor: function(): GVector

    --- Returns the current alpha blending.
    -- @return --- Current alpha blending in range 0 to 1.
    GetBlend: function(): number

    --- **INTERNAL**: You can use Global.GetRenderTargetEx if you need to create a Render Target
    --- Returns the Render Target texture that is used internally for the Bloom Post Processing effect.
    -- @return --- The render target texture named `s_pBloomTex0`.
    GetBloomTex0: function(): GITexture

    --- **INTERNAL**: You probably want to just use a custom render target. See Global.GetRenderTargetEx.
    --- Returns the Render Target texture used internally for the Blur Post Processing effect.
    --- Despite its name, this function is not used for the Bloom effect.
    -- @return --- The render target texture named `s_pBloomTex1`.
    GetBloomTex1: function(): GITexture

    --- Returns the current color modulation values as normals.
    -- @return --- Red part of the color.
    -- @return --- Green part of the color.
    -- @return --- Blue part of the color.
    GetColorModulation: function(): number, number, number

    --- Returns the maximum available directX version.
    -- @return --- The directX version.
    GetDXLevel: function(): number

    --- Returns the current fog color.
    -- @return --- Red part of the color.
    -- @return --- Green part of the color
    -- @return --- Blue part of the color
    GetFogColor: function(): number, number, number

    --- Returns the fog start and end distance.
    -- @return --- Fog start distance set by render.FogStart.
    -- @return --- For end distance set by render.FogEnd.
    -- @return --- Fog Z distance set by render.SetFogZ.
    GetFogDistances: function(): number, number, number

    --- Get the maximum density of the fog.
    -- @return maxDensity --- The maximum density of the fog, 0-1.
    GetFogMaxDensity: function(): number

    --- Returns the fog mode.
    -- @return --- Fog mode, see Enums/MATERIAL_FOG.
    GetFogMode: function(): number

    --- @deprecated
    --- **DEPRECATED**: Alias of render.GetPowerOfTwoTexture in practice.
    --- Returns the full screen depth texture.
    -- @return --- The `_rt_FullFrameDepth` texture, which is an alias of `_rt_PowerOfTwoFB` on PC.
    GetFullScreenDepthTexture: function(): GITexture

    --- Returns whether HDR is currently enabled or not. This takes into account hardware support, current map and current client settings.
    -- @return --- `true` if the player currently has HDR enabled.
    GetHDREnabled: function(): boolean

    --- Gets the light exposure on the specified position.
    -- @param position --- The position of the surface to get the light from.
    -- @return --- The light color.
    GetLightColor: function(position: GVector): GVector

    --- **INTERNAL**: You probably want to just use a custom render target. See Global.GetRenderTargetEx.
    --- Returns the first render target texture that is used internally for Motion Blur and Frame Blend post processing effects.
    -- @return --- The render target named `s_pMoBlurTex0`.
    GetMoBlurTex0: function(): GITexture

    --- **INTERNAL**: You probably want to just use a custom render target. See Global.GetRenderTargetEx.
    --- Returns the second render target texture that is used internally for Motion Blur and Frame Blend post processing effects.
    -- @return --- The render target named `s_pMoBlurTex1`.
    GetMoBlurTex1: function(): GITexture

    --- **INTERNAL**: You probably want to just use a custom render target. See Global.GetRenderTargetEx.
    --- Returns the first render target texture that was used internally for Morph post processing effect
    --- The post processing effect was removed from the base game at some point during development of Garry's Mod 13, but can still be found as a community mod: https://steamcommunity.com/sharedfiles/filedetails/?id=501088470
    -- @return --- The render target texture named `s_pMorphTexture0`.
    GetMorphTex0: function(): GITexture

    --- **INTERNAL**: You probably want to just use a custom render target. See Global.GetRenderTargetEx.
    --- Returns the second render target texture that was used internally for Morph post processing effect.
    --- See render.GetMorphTex0 for more information..
    -- @return --- The render target texture named `s_pMorphTexture1`.
    GetMorphTex1: function(): GITexture

    --- Returns the Power Of Two Frame Buffer texture.
    -- @return --- The power of two texture, which is `_rt_PowerOfTwoFB` by default.
    GetPowerOfTwoTexture: function(): GITexture

    --- @deprecated
    --- **DEPRECATED**: Alias of render.GetPowerOfTwoTexture.
    --- Alias of render.GetPowerOfTwoTexture.
    -- @return --- The render.GetPowerOfTwoTexture.
    GetRefractTexture: function(): GITexture

    --- Returns the currently active render target.
    --- Instead of saving the current render target using this function and restoring to it later, it is generally better practice to use render.PushRenderTarget and render.PopRenderTarget.
    -- @return --- The currently active Render Target.
    GetRenderTarget: function(): GITexture

    --- Returns the `_rt_ResolvedFullFrameDepth` texture for SSAO depth. It will only be updated if GM:NeedsDepthPass returns true. Depth is written using the Shaders/DepthWrite.
    -- @return --- The depth texture.
    GetResolvedFullFrameDepth: function(): GITexture

    --- Obtain an ITexture of the screen. You must call render.UpdateScreenEffectTexture in order to update this texture with the currently rendered scene.
    --- This texture is mainly used within GM:RenderScreenspaceEffects.
    -- @param textureIndex --- Max index is 3, but engine only creates the first two for you.
    -- @return --- The requested texture.
    GetScreenEffectTexture: function(textureIndex: number): GITexture

    --- Returns the first quarter sized frame buffer texture.
    -- @return --- The render target texture named `_rt_SmallFB0`.
    GetSmallTex0: function(): GITexture

    --- Returns the second quarter sized frame buffer texture.
    -- @return --- The render target texture named `_rt_SmallFB1`.
    GetSmallTex1: function(): GITexture

    --- Returns a floating point texture (RGBA16161616F format) the same resolution as the screen.
    --- **NOTE**: The gmodscreenspace doesn't behave as expected when drawing a floating-point texture to an integer texture (e.g. the default render target). Use an UnlitGeneric material instead
    -- @return --- Render target named `__rt_SuperTexture1`.
    GetSuperFPTex: function(): GITexture

    --- See render.GetSuperFPTex.
    -- @return --- Render target named `__rt_SuperTexture2`.
    GetSuperFPTex2: function(): GITexture

    --- Performs a render trace and returns the color of the surface hit, this uses a low res version of the texture.
    -- @param startPos --- The start position to trace from.
    -- @param endPos --- The end position of the trace.
    -- @return --- The surface color.
    GetSurfaceColor: function(startPos: GVector, endPos: GVector): GVector

    --- Returns a vector representing linear tone mapping scale.
    -- @return --- The vector representing linear tone mapping scale.
    GetToneMappingScaleLinear: function(): GVector

    --- Returns the current view setup.
    -- @param noPlayer --- If `true`, returns the `view->GetViewSetup`, if `false` - returns `view->GetPlayerViewSetup`.
    -- @return --- Current current view setup. See Structures/ViewSetup.
    GetViewSetup: function(noPlayer: boolean): table

    --- Lets you know when a screenshot is being taken during rendering hooks.
    --- This is useful to hide certain visual elements from screenshots, such as debug overlays, helper objects, etc.
    -- @return --- Returns `true` when a screenshot is being taken.
    IsTakingScreenshot: function(): boolean

    --- Sets the render material override for all next calls of Entity:DrawModel. Also overrides render.MaterialOverrideByIndex.
    --- See render.WorldMaterialOverride, render.BrushMaterialOverride and render.ModelMaterialOverride for similar functions.
    --- **WARNING**: In certain scenarios such as during entity's shadow pass, using this function can cause unexpected side effects. See example below on how to deal with this.
    -- @param material --- The material to use as override, use `nil` to disable.
    MaterialOverride: function(material: GIMaterial|nil)

    --- Similar to render.MaterialOverride, but overrides the materials per index. For simple entities you may want to just use Entity:SetSubMaterial.
    --- render.MaterialOverride overrides effects of this function.
    -- @param index --- The index of the material to override, in range of 0 to 31. `nil` will reset all overrides.
    -- @param material --- The material to override with, `nil` will reset the override for given index.
    MaterialOverrideByIndex: function(index: number, material: GIMaterial)

    --- Returns the maximum texture height the renderer can handle.
    -- @return --- The max height.
    MaxTextureHeight: function(): number

    --- Returns the maximum texture width the renderer can handle.
    -- @return --- The max width.
    MaxTextureWidth: function(): number

    --- Creates a new Global.ClientsideModel, renders it at the specified pos/ang, and removes it. Can also be given an existing CSEnt to reuse instead.
    --- **NOTE**: This function is only meant to be used in a single render pass kind of scenario, if you need to render a model continuously, use a cached Global.ClientsideModel and provide it as a second argument.
    --- **BUG**: [Using this with a map model (game.GetWorld():GetModel()) crashes the game.](https://github.com/Facepunch/garrysmod-issues/issues/2688
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L175-L199)
    -- @param settings --- Requires:
    --- * string model - The model to draw.
    --- * Vector pos - The position to draw the model at.
    --- * Angle angle - The angles to draw the model at.
    -- @param ent --- If provided, this entity will be reused instead of creating a new one with Global.ClientsideModel. Note that the ent's model, position and angles will be changed, and Entity:SetNoDraw will be set to true.
    Model: function(settings: table, ent: GCSEnt)

    --- Forces all future draw operations to use a specific IMaterial.
    --- Because this is independent of a specific Entity, it can be used to change materials on static models that are part of maps.
    --- **WARNING**: In certain scenarios such as during entity's shadow pass, using this function can cause unexpected side effects. See example on render.MaterialOverride about dealing with this.
    -- @param material --- The IMaterial that will be used for all upcoming draw operations, or `nil` to stop overriding.
    ModelMaterialOverride: function(material: GIMaterial)

    --- Overrides the write behaviour of all next rendering operations towards the alpha channel of the current render target.
    --- See also render.OverrideBlend.
    --- **NOTE**: Doing surface draw calls with alpha set to 0 is a no-op and will never have any effect.
    -- @param enable --- Enable or disable the override.
    -- @param shouldWrite --- If the previous argument is true, sets whether the next rendering operations should write to the alpha channel or not. Has no effect if the previous argument is false.
    OverrideAlphaWriteEnable: function(enable: boolean, shouldWrite: boolean)

    --- Overrides the way that the final color and alpha is calculated for each pixel affected by upcoming draw operations.
    --- When a draw operation is performed, the rendering system examines each pixel that is affected by the draw operation and determines its new color by combining (or "Blending") the pixel's current color (Called the "Destination" or "Dst" color) with the new color produced by the draw operation (Called the "Source" or "Src" color.)
    --- This function allows you to control the way that those two colors (The Source and Destination) are combined to produce the final pixel color.
    --- It's important to know that while Colors use values in the range `(0-255)`, the color and alpha values used here are normalized to the range `(0-1)` so that they can be multiplied together to produce a value that is still in the range `(0-1)`.
    -- @param enabled --- Set to `true` to enable Blend Overrides.
    -- @param sourceMultiplier --- This determines which value each affected pixel's **Source color and alpha** will be multiplied by before they are sent to the Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param destinationMultiplier --- This determines which value each affected pixel's **Destination color and alpha** will be multiplied by before they are sent to the Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param blendingFunction --- After the Source and Destination color and alpha have been multiplied against their corresponding multipliers, they are passed to the Blending Function which combines them into the final color and alpha for the pixel.
    --- One of the Enums/BLENDFUNC enums.
    OverrideBlend: function(enabled: boolean, sourceMultiplier: E_BLEND, destinationMultiplier: E_BLEND, blendingFunction: E_BLENDFUNC)

    --- Overrides the way that the final color and alpha is calculated for each pixel affected by upcoming draw operations.
    --- When a draw operation is performed, the rendering system examines each pixel that is affected by the draw operation and determines its new color by combining (or "Blending") the pixel's current color (Called the "Destination" or "Dst" color) with the new color produced by the draw operation (Called the "Source" or "Src" color.)
    --- This function allows you to control the way that those two colors (The Source and Destination) are combined to produce the final pixel color.
    --- It's important to know that while Colors use values in the range `(0-255)`, the color and alpha values used here are normalized to the range `(0-1)` so that they can be multiplied together to produce a value that is still in the range `(0-1)`.
    -- @param enabled --- Set to `true` to enable Blend Overrides.
    -- @param sourceColorMultiplier --- This determines which value each affected pixel's **Source color** will be multiplied by before they are sent to the Color Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param destinationColorMultiplier --- This determines which value each affected pixel's **Destination color** will be multiplied by before they are sent to the Color Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param colorBlendingFunction --- After the Source and Destination colors have been multiplied against their corresponding multipliers, they are passed to the Color Blending Function which combines them into the final color and alpha for the pixel.
    --- One of the Enums/BLENDFUNC enums.
    -- @param sourceAlphaMultiplier --- This determines which value each affected pixel's **Source alpha** will be multiplied by before they are sent to the Alpha Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param destinationAlphaMultiplier --- This determines which value each affected pixel's **Destination alpha** will be multiplied by before they are sent to the Alpha Blending Function.
    --- One of the Enums/BLEND enums.
    -- @param alphaBlendingFunction --- After the Source and Destination alphas have been multiplied against their corresponding multipliers, they are passed to the Alpha Blending Function which combines them into the final alpha for the pixel.
    OverrideBlend: function(enabled: boolean, sourceColorMultiplier: E_BLEND, destinationColorMultiplier: E_BLEND, colorBlendingFunction: E_BLENDFUNC, sourceAlphaMultiplier: E_BLEND, destinationAlphaMultiplier: E_BLEND, alphaBlendingFunction: E_BLENDFUNC)

    --- Overrides the way that the final color and alpha is calculated for each pixel affected by upcoming draw operations.
    --- When a draw operation is performed, the rendering system examines each pixel that is affected by the draw operation and determines its new color by combining (or "Blending") the pixel's current color (Called the "Destination" or "Dst" color) with the new color produced by the draw operation (Called the "Source" or "Src" color.)
    --- This function allows you to control the way that those two colors (The Source and Destination) are combined to produce the final pixel color.
    --- It's important to know that while Colors use values in the range `(0-255)`, the color and alpha values used here are normalized to the range `(0-1)` so that they can be multiplied together to produce a value that is still in the range `(0-1)`.
    -- @param enabled --- Set to `false` to disable blend overrides.
    OverrideBlend: function(enabled: boolean)

    --- @deprecated
    --- **DEPRECATED**: Use render.OverrideBlend instead.
    --- Overrides the internal graphical functions used to determine the final color and alpha of a rendered texture.
    --- See also render.OverrideAlphaWriteEnable.
    --- **NOTE**: Doing surface draw calls with alpha set to 0 is a no-op and will never have any effect.
    -- @param enabled --- true to enable, false to disable. No other arguments are required when disabling.
    -- @param srcBlend --- The source color blend function Enums/BLEND. Determines how a rendered texture's final color should be calculated.
    -- @param destBlend ---
    -- @param srcBlendAlpha --- The source alpha blend function Enums/BLEND. Determines how a rendered texture's final alpha should be calculated.
    -- @param destBlendAlpha ---
    OverrideBlendFunc: function(enabled: boolean, srcBlend: number, destBlend: number, srcBlendAlpha: number, destBlendAlpha: number)

    --- Overrides the write behaviour of all next rendering operations towards the color channel of the current render target.
    -- @param enable --- Enable or disable the override.
    -- @param shouldWrite --- If the previous argument is true, sets whether the next rendering operations should write to the color channel or not. Has no effect if the previous argument is false.
    OverrideColorWriteEnable: function(enable: boolean, shouldWrite: boolean)

    --- Overrides the write behaviour of all next rendering operations towards the depth buffer.
    -- @param enable --- Enable or disable the override.
    -- @param shouldWrite --- If the previous argument is true, sets whether the next rendering operations should write to the depth buffer or not. Has no effect if the previous argument is false.
    OverrideDepthEnable: function(enable: boolean, shouldWrite: boolean)

    --- Performs a Stencil operation on every pixel in the active Render Target without performing a draw operation.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    PerformFullScreenStencilOperation: function()

    --- Removes the current active clipping plane from the clip plane stack.
    PopCustomClipPlane: function()

    --- Pops (Removes) the texture filter most recently pushed (Added) onto the magnification texture filter stack.
    --- This function should only be called *after* a magnification filter has been pushed via render.PushFilterMag().
    --- For more detailed information and a usage example, see the texture minification and magnification render reference.
    PopFilterMag: function()

    --- Pops (Removes) the texture filter most recently pushed (Added) onto the minification texture filter stack.
    --- This function should only be called *after* a minification filter has been pushed via render.PushFilterMin().
    --- For more detailed information and a usage example, see the texture minification and magnification render reference.
    PopFilterMin: function()

    --- Pops the current flashlight mode from the flashlight mode stack.
    PopFlashlightMode: function()

    --- Pops the last render target and viewport from the RT stack and sets them as the current render target and viewport.
    --- This is should be called to restore the previous render target and viewport after a call to render.PushRenderTarget.
    PopRenderTarget: function()

    --- Pushes a new clipping plane of the clip plane stack and sets it as active.
    --- **BUG**: [A max of 2 clip planes are supported on Linux/POSIX, and 6 on Windows.](https://github.com/Facepunch/garrysmod-issues/issues/2687
    -- @param normal --- The normal of the clipping plane.
    -- @param distance --- The distance of the plane from the world origin. You can use Vector:Dot between the normal and any point on the plane to find this.
    PushCustomClipPlane: function(normal: GVector, distance: number)

    --- Pushes (Adds) a texture filter onto the magnification texture filter stack.
    --- This will modify how textures are stretched to sizes larger than their native resolution for upcoming rendering and drawing operations.
    --- For a version of this same function that modifies filtering for texture sizes smaller than their native resolution, see render.PushFilterMin
    --- Always be sure to call render.PopFilterMag afterwards to avoid texture filtering problems.
    --- For more detailed information and a usage example, see the texture minification and magnification render reference.
    --- If current texture has more than 1 mipmap, this also sets the mipmap filter.
    -- @param texFilterType --- The texture filter to use. For available options, see Enums/TEXFILTER.
    PushFilterMag: function(texFilterType: number)

    --- Pushes (Adds) a texture filter onto the minification texture filter stack.
    --- This will modify how textures are compressed to a lower resolution than their native resolution for upcoming rendering and drawing operations.
    --- For a version of this same function that modifies filtering for texture sizes larger than their native resolution, see render.PushFilterMag()
    --- Always be sure to call render.PopFilterMin() afterwards to avoid texture filtering problems.
    --- For more detailed information and a usage example, see the texture minification and magnification render reference.
    -- @param texFilterType --- The texture filter to use. For available options, see Enums/TEXFILTER.
    PushFilterMin: function(texFilterType: number)

    --- Enables the flashlight projection for the upcoming rendering.
    --- @deprecated
    --- **DEPRECATED**: This will leave models lit under specific conditions. You should use render.RenderFlashlights which is meant as a direct replacement for this function.
    -- @param enable --- Whether the flashlight mode should be enabled or disabled.
    PushFlashlightMode: function(enable: boolean)

    --- Pushes the current render target and viewport to the RT stack then sets a new current render target and viewport. If the viewport is not specified, the dimensions of the render target are used instead.
    --- This is similar to a call to render.SetRenderTarget and render.SetViewPort where the current render target and viewport have been saved beforehand, except the viewport isn't clipped to screen bounds.
    --- See also render.PopRenderTarget.
    --- **NOTE**: If you want to render to the render target in 2d mode and it is not the same size as the screen, use cam.Start2D and cam.End2D.
    --- **NOTE**: If the render target is bigger than the screen, rendering done with the surface library will be clipped to the screen bounds unless you call Global.DisableClipping
    -- @param texture --- The new render target to be used.
    --- Can be set to `nil` to push the main game frame buffer.
    -- @param x --- X origin of the viewport.
    -- @param y --- Y origin of the viewport.
    -- @param w --- Width of the viewport.
    -- @param h --- Height of the viewport.
    PushRenderTarget: function(texture: GITexture, x: number, y: number, w: number, h: number)

    --- Reads the color of the specified pixel from the RenderTarget sent by render.CapturePixels
    -- @param x --- The x coordinate.
    -- @param y --- The y coordinate.
    -- @return r --- The red channel value.
    -- @return g --- The green channel value.
    -- @return b --- The blue channel value.
    -- @return a --- The alpha channel value or no value if the render target has no alpha channel.
    ReadPixel: function(x: number, y: number): number, number, number, number

    --- This applies the changes made to map lighting using engine.LightStyle.
    -- @param DoStaticProps --- When true, this will also apply lighting changes to static props. This is really slow on large maps.
    -- @param UpdateStaticLighting --- Forces all props to update their static lighting. Can be slow.
    RedownloadAllLightmaps: function(DoStaticProps: boolean, UpdateStaticLighting: boolean)

    --- Renders additive flashlights on an IMesh, a direct replacement for render.PushFlashlightMode.
    -- @param renderFunc --- The function that renders the IMesh, or a model.
    RenderFlashlights: function(renderFunc: function)

    --- Renders the HUD on the screen.
    -- @param x --- X position for the HUD draw origin.
    -- @param y --- Y position for the HUD draw origin.
    -- @param w --- Width of the HUD draw.
    -- @param h --- Height of the HUD draw.
    RenderHUD: function(x: number, y: number, w: number, h: number)

    --- Renders the scene with the specified viewData to the current active render target.
    --- **BUG**: [Static props and LODs are rendered improperly due to incorrectly perceived distance.](https://github.com/Facepunch/garrysmod-issues/issues/1330
    --- **BUG**: Using render.RenderView on a RenderTarget texture in a 3d context like SWEP:PostDrawViewModel() while drawing the RenderTarget texture causes screen flickers.
    -- @param view --- The view data to be used in the rendering. See Structures/ViewData. Any missing value is assumed to be that of the current view. Similarly, you can make a normal render by simply not passing this table at all.
    RenderView: function(view: table)

    --- Resets the model lighting to the specified color.
    --- Calls render.SetModelLighting for every direction with given color.
    -- @param r --- The red part of the color, 0-1.
    -- @param g --- The green part of the color, 0-1.
    -- @param b --- The blue part of the color, 0-1.
    ResetModelLighting: function(r: number, g: number, b: number)

    --- Resets the HDR tone multiplier to the specified value.
    --- This will only work on HDR maps, and the value will automatically fade to what it was ( or whatever render.SetGoalToneMappingScale is ) if called only once.
    -- @param scale --- The value which should be used as multiplier.
    ResetToneMappingScale: function(scale: number)

    --- Sets the ambient lighting for any upcoming render operation.
    -- @param r --- The red part of the color, 0-1.
    -- @param g --- The green part of the color, 0-1.
    -- @param b --- The blue part of the color, 0-1.
    SetAmbientLight: function(r: number, g: number, b: number)

    --- Sets the alpha blending (or transparency) for upcoming render operations.
    --- See render.SetColorModulation for the function to affect RGB color channels.
    --- By itself, this will cause visible overlapping on parts of a model that are in front of other parts of the same model.
    --- For a solution to this, see the examples below.
    --- **BUG**: [This does not affect non-model `render.Draw*` functions.](https://github.com/Facepunch/garrysmod-issues/issues/3166
    --- **NOTE**: If a material has the [$alphatest](https://developer.valvesoftware.com/wiki/$alphatest) flag enabled then this function might not behave as expected because alpha will be binary, this has a default cutoff of `0.7`.
    -- @param blending --- The alpha (transparency) for upcoming draw operations.
    --- A value in the range `(0-1)` where `0` is fully transparent, `0.5` is 50% visible, and `1` is fully opaque.
    SetBlend: function(blending: number)

    --- Sets the current drawing material to "color".
    --- The material is defined as:
    --- ```
    --- "UnlitGeneric"
    --- {
    --- "$basetexture" "color/white"
    --- "$model" 		1
    --- "$translucent" 	1
    --- "$vertexalpha" 	1
    --- "$vertexcolor" 	1
    --- }
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L74-L76)
    SetColorMaterial: function()

    --- Sets the current drawing material to `color_ignorez`.
    --- The material is defined as:
    --- ```
    --- "UnlitGeneric"
    --- {
    --- "$basetexture" "color/white"
    --- "$model" 		1
    --- "$translucent" 	1
    --- "$vertexalpha" 	1
    --- "$vertexcolor" 	1
    --- "$ignorez"		1
    --- }
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L80-L82)
    SetColorMaterialIgnoreZ: function()

    --- Sets the color modulation for upcoming render operations, such as rendering models.
    --- The values can exceed 1 for stronger effect.
    --- See render.SetBlend for the function to affect alpha channel.
    -- @param r --- The red channel multiplier normal ranging from 0-1.
    -- @param g --- The green channel multiplier normal ranging from 0-1.
    -- @param b --- The blue channel multiplier normal ranging from 0-1.
    SetColorModulation: function(r: number, g: number, b: number)

    --- If the fog mode is set to MATERIAL_FOG_LINEAR_BELOW_FOG_Z, the fog will only be rendered below the specified height.
    -- @param fogZ --- The fog Z.
    SetFogZ: function(fogZ: number)

    --- Sets the goal HDR tone mapping scale.
    --- Use this in a rendering/think hook as it is reset every frame.
    -- @param scale --- The target scale.
    SetGoalToneMappingScale: function(scale: number)

    --- Sets lighting mode when rendering something.
    --- **NOTE**: **Do not forget to restore the default value** to avoid unexpected behavior, like the world and the HUD/UI being affected.
    -- @param Mode --- Lighting render mode.
    --- Possible values are:
    --- * 0 - Default.
    --- * 1 - Total fullbright, similar to `mat_fullbright 1` but excluding some weapon view models.
    --- * 2 - Increased brightness(?), models look fullbright.
    SetLightingMode: function(Mode: number)

    --- Sets lighting origin for the current model.
    -- @param lightingOrigin --- The position which will be used to calculate lighting for the current model.
    SetLightingOrigin: function(lightingOrigin: GVector)

    --- Sets the texture to be used as the lightmap in upcoming rendering operations. This is required when rendering meshes using a material with a lightmapped shader such as LightmappedGeneric.
    -- @param tex --- The texture to be used as the lightmap.
    SetLightmapTexture: function(tex: GITexture)

    --- Sets up the local lighting for any upcoming render operation. Up to 4 local lights can be defined, with one of three different types (point, directional, spot).
    --- Disables all local lights if called with no arguments.
    -- @param lights --- A table containing up to 4 tables for each light source that should be set up. Each of these tables should contain the properties of its associated light source, see Structures/LocalLight.
    SetLocalModelLights: function(lights: table)

    --- Sets the material to be used in any upcoming render operation using the render.
    --- Not to be confused with surface.SetMaterial.
    -- @param mat --- The material to be used.
    SetMaterial: function(mat: GIMaterial)

    --- Sets up the ambient lighting for any upcoming render operation. Ambient lighting can be seen as a cube enclosing the object to be drawn, each of its faces representing a directional light source that shines towards the object. Thus, there is a total of six different light sources that can be configured separately.
    --- Light color components are not restricted to a specific range (i.e. 0-255), instead, higher values will result in a brighter light.
    -- @param lightDirection --- The light source to edit, see Enums/BOX.
    -- @param red --- The red component of the light color.
    -- @param green --- The green component of the light color.
    -- @param blue --- The blue component of the light color.
    SetModelLighting: function(lightDirection: E_BOX, red: number, green: number, blue: number)

    --- Sets the render target to the specified rt.
    -- @param texture --- The new render target to be used.
    SetRenderTarget: function(texture: GITexture)

    --- Sets the render target with the specified index of `COLOR[n]` to the specified rt, allowing you to work with [Multiple Render Targets (MRT)](https://learn.microsoft.com/en-us/windows/win32/direct3d9/multiple-render-targets). Since standard shaders don't use MRT, you might find this useful at Shaders/screenspace_general.
    --- **NOTE**: MRT doesn't work with 2D render functions like render.DrawScreenQuad. Instead, you can render a render.DrawQuad using cam.Start2D.
    --- **WARNING**: If you try to render with MSAA and set the main RenderTarget with another RenderTarget, nothing will be rendered.
    --- [Link to Direct3D 9 documentation on MRT](https://learn.microsoft.com/en-us/windows/win32/direct3d9/multiple-render-targets#:~:text=No%20antialiasing%20is%20supported)
    --- `Multiple render targets have the following restrictions:`
    --- * *No antialiasing is supported.*
    -- @param rtIndex --- The index of output `COLOR[n]` [semantics](https://learn.microsoft.com/en-us/windows/win32/direct3dhlsl/dx-graphics-hlsl-semantics) from pixel-shader. Min: `0`, max: `3`.
    -- @param texture --- The new render target to be used.
    SetRenderTargetEx: function(rtIndex: number, texture: GITexture)

    --- Sets a scissoring rectangle which limits the drawing area. (otherwise known as clipping)
    -- @param startX --- X start coordinate of the scissor rectangle in screen-space coordinates.
    -- @param startY --- Y start coordinate of the scissor rectangle in screen-space coordinates.
    -- @param endX --- X end coordinate of the scissor rectangle in screen-space coordinates.
    -- @param endY --- Y end coordinate of the scissor rectangle in screen-space coordinates.
    -- @param enable --- Enable or disable the scissor rect.
    SetScissorRect: function(startX: number, startY: number, endX: number, endY: number, enable: boolean)

    --- Sets the shadow color.
    -- @param red --- The red channel of the shadow color.
    -- @param green --- The green channel of the shadow color.
    -- @param blue --- The blue channel of the shadow color.
    SetShadowColor: function(red: number, green: number, blue: number)

    --- Sets the shadow projection direction.
    -- @param shadowDirections --- The new shadow direction.
    SetShadowDirection: function(shadowDirections: GVector)

    --- Sets the maximum shadow projection range.
    -- @param shadowDistance --- The new maximum shadow distance.
    SetShadowDistance: function(shadowDistance: number)

    --- Sets whether all shadow rendering should be disabled.
    --- Internally sets `r_shadows_gamecontrol` convar, exactly like `shadow_control` does via its `SetShadowsDisabled` input.
    --- **BUG**: Currently broken due to internal bug. Will be fixed in the next update, as of 15 Sept 2025.
    -- @param disable --- `true` to disable shadows, `false` to enable.
    SetShadowsDisabled: function(disable: boolean)

    --- Sets the Compare Function that all pixels affected by a draw operation will have their Stencil Buffer value tested against.
    --- When not set to a static value like NEVER or ALWAYS, the Stencil Buffer value corresponding to each affected pixel will be compared against the current Reference Value.
    --- Pixels that **Pass** the Compare Function check move on to the Depth Test, which determines if the draw operation will ultimately be allowed to overwrite the pixel's Color Channel, Stencil Buffer, and Depth Buffer values.
    --- Pixels that **Fail** the Compare Function check have the Fail Operation performed on their Stencil Buffer value and do **not** have any of their Render Target layers modified by the draw operation.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param compareFunction --- The Compare Function that each affected pixel's Stencil Buffer value will be evaluated against during a draw operation.
    SetStencilCompareFunction: function(compareFunction: E_STENCILCOMPARISONFUNCTION)

    --- Enables or disables the Stencil system for future draw operations.
    --- While enabled, all pixels affected by draw operations will have their corresponding values in the active Render Target's Stencil Buffer compared against the current Reference Value and their current Depth Buffer value compared against the depth of the corresponding pixel from the draw operation.
    --- Depending on the outcomes of these comparisons, one of either the Pass, Fail, or Z-Fail operations is performed on the pixel's Stencil Buffer value.
    --- A pixel will only be updated in the active Render Target if the Pass Operation is performed.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    --- **NOTE**: The Stencil system's configuration does **not** reset automatically.
    --- To prevent unexpected behavior, always manually ensure that the Stencil system is configured appropriately for your use-case after enabling it.
    -- @param newState --- The new state.
    SetStencilEnable: function(newState: boolean)

    --- Sets the Stencil Operation that will be performed on the Stencil Buffer values of pixels affected by draw operations if the Compare Function did **not** Pass the pixel.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param failOperation --- The Stencil Operation to be performed if the Compare Function does not Pass a pixel.
    SetStencilFailOperation: function(failOperation: E_STENCILOPERATION)

    --- Sets the Stencil Operation that will be performed on the Stencil Buffer values of pixels affected by draw operations if the Compare Function Passes the pixel.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param passOperation --- The Stencil Operation to be performed if the Compare Function Passes a pixel.
    SetStencilPassOperation: function(passOperation: E_STENCILOPERATION)

    --- Sets the Stencil system's Reference Value which is compared against each pixel's corresponding Stencil Buffer value in the Compare Function and can be used to modify the Stencil Buffer value of those same pixels in the Pass, Fail, and Z Fail operations.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param referenceValue --- The value that the Compare function and the pass, fail, and z-fail operations will use.
    --- This is an 8-bit (`byte`) unsigned integer value in the range [`0-255`].
    SetStencilReferenceValue: function(referenceValue: number)

    --- Sets the unsigned 8-bit (`byte`) bitflag mask that will be bitwise ANDed with all values as they are read (tested) from the Stencil Buffer
    --- This can be considered a "niche" Stencil function as it is not required for many Stencil use-cases.
    --- This is a companion function to render.SetStencilWriteMask which modifies Stencil Buffer values as they are written.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param bitMask --- The 8-bit (`byte`) mask.
    --- Set to `255` to make no change to read Stencil Buffer values.
    SetStencilTestMask: function(bitMask: number)

    --- Sets the unsigned 8-bit (`byte`) bitflag mask that will be bitwise ANDed with all values as they are written to the Stencil Buffer
    --- This can be considered a "niche" Stencil function as it is not required for many Stencil use-cases.
    --- This is a companion function to render.SetStencilTestMask which modifies Stencil Buffer values as they are read.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param bitMask --- The 8-bit (`byte`) mask.
    --- Set to `255` to make no change to written Stencil Buffer values.
    SetStencilWriteMask: function(bitMask: number)

    --- Sets the Stencil Operation that will be performed on the Stencil Buffer values of pixels affected by draw operations if the Compare Function Passed a given pixel, but it did **not** Pass the Depth Test.
    --- For more detailed information on the Stencil system, including usage examples, see the Stencils Render Reference page.
    -- @param zFailOperation --- The Stencil Operation to be performed if the Compare Function Passes a pixel, but the pixel fails the Depth Test.
    SetStencilZFailOperation: function(zFailOperation: E_STENCILOPERATION)

    --- Sets the tone mapping scale for upcoming rendering operations.
    -- @param scales --- The tonemapping scales.
    --- * X - Output scale.
    --- * Y - Lightmap scale.
    --- * Z - Reflection map scale.
    SetToneMappingScaleLinear: function(scales: GVector)

    --- Changes the view port position and size. The values will be clamped to the game's screen resolution.
    --- If you are looking to render something to a texture (render target), you should use render.PushRenderTarget.
    --- **NOTE**: This function will override values of Global.ScrW and Global.ScrH with the ones you set.
    -- @param x --- X origin of the view port.
    -- @param y --- Y origin of the view port.
    -- @param w --- Width of the view port.
    -- @param h --- Height of the view port.
    SetViewPort: function(x: number, y: number, w: number, h: number)

    --- Sets the internal parameter **INT_RENDERPARM_WRITE_DEPTH_TO_DESTALPHA**.
    -- @param enable ---
    SetWriteDepthToDestAlpha: function(enable: boolean)

    --- Swaps the frame buffers/cycles the frame. In other words, this updates the screen.
    --- If you take a really long time during a single frame render, it is a good idea to use this and let the user know that the game isn't stuck.
    Spin: function()

    --- **NOTE**: Provides a 3D rendering context
    --- Begin drawing a multi-segment Beam.
    --- For more detailed information on Beams, as well as usage examples, see the Beams Render Reference.
    -- @param segmentCount --- The number of Beam Segments that this multi-segment Beam will contain.
    StartBeam: function(segmentCount: number)

    --- Returns whether the player's hardware supports HDR. (High Dynamic Range) HDR can still be disabled by the `mat_hdr_level` console variable or just not be supported by the map.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/render.lua#L47-L53)
    -- @return --- `true` if the player's hardware supports HDR.
    SupportsHDR: function(): boolean

    --- Returns if the current settings and the system allow the usage of pixel shaders 1.4.
    -- @return --- Whether Pixel Shaders 1.4 are supported or not.
    SupportsPixelShaders_1_4: function(): boolean

    --- Returns if the current settings and the system allow the usage of pixel shaders 2.0.
    -- @return --- Whether Pixel Shaders 2.0 are supported or not.
    SupportsPixelShaders_2_0: function(): boolean

    --- Returns if the current settings and the system allow the usage of vertex shaders 2.0.
    -- @return --- Whether Vertex Shaders 2.0 are supported or not.
    SupportsVertexShaders_2_0: function(): boolean

    --- Suppresses or enables any engine lighting for any upcoming render operation.
    --- **BUG**: [This does not affect IMeshes.](https://github.com/Facepunch/garrysmod-issues/issues/4070
    -- @param suppressLighting --- True to suppress false to enable.
    SuppressEngineLighting: function(suppressLighting: boolean)

    --- Enables HDR tone mapping which influences the brightness.
    TurnOnToneMapping: function()

    --- Updates the texture returned by render.GetFullScreenDepthTexture.
    --- Silently fails if render.SupportsPixelShaders_2_0 returns false.
    UpdateFullScreenDepthTexture: function()

    --- Updates the power of two texture.
    -- @return --- The render.GetPowerOfTwoTexture.
    UpdatePowerOfTwoTexture: function(): GITexture

    --- Pretty much alias of render.UpdatePowerOfTwoTexture but does not return the texture.
    UpdateRefractTexture: function()

    --- Copies the entire screen to the screen effect texture, which can be acquired via render.GetScreenEffectTexture. This function is mainly intended to be used in GM:RenderScreenspaceEffects.
    -- @param textureIndex --- Texture index to update. Max index is 3, but engine only creates the first two for you.
    UpdateScreenEffectTexture: function(textureIndex: number)

    --- This function overrides all map materials for one frame.
    -- @param mat ---
    WorldMaterialOverride: function(mat: GIMaterial)
end


--- The resource library is used to control what files are sent to clients who join a server, this includes models, materials, sounds, text files but not Lua files.
global record resource
    --- Adds the specified and all related files to the list of files the client should download from the server.
    --- For convenience, this function will automatically add any other files that are related to the selected one, and throw an error if it can't find them. For example, a `.vmt` file will automatically add the `.vtf` with the same name, and a `.mdl` file will automatically add all `.vvd`, `.ani`, `.dx80.vtx`, `.dx90.vtx` and `.phy` files with the same name, with a separate error for each missing file.
    --- If you do not want it to do this, use resource.AddSingleFile.
    --- See also Serving Content
    --- **WARNING**: There's a 8192 downloadable file limit. If you need more, consider using Workshop addons - resource.AddWorkshop. You should also consider the fact that you have way too many downloads. This limit is shared among all `resource.Add*` functions.
    --- **NOTE**: The file must exist on the server it will not be added to the downloadables list!
    -- @param path --- **Virtual path** of the file to be added, relative to `garrysmod/`.
    --- Do not add `.bz2` to the filepath.
    --- Do not add `gamemodes/*gamemodename*/content/` or `addons/*addonname*/` to the path, since those paths are mounted virtually as if they are in the root `garrysmod/`.
    AddFile: function(path: string)

    --- Adds the specified file to the files the client should download from the server.
    --- If you wish to add textures or models, consider using resource.AddFile to add all the files required for a texture/model.
    --- **WARNING**: There's a 8192 downloadable file limit. If you need more, consider using Workshop addons - resource.AddWorkshop. You should also consider the fact that you have way too many downloads. This limit is shared among all `resource.Add*` functions.
    --- **NOTE**: The file must exist on the server or players will not download it!
    --- See also Serving Content
    -- @param path --- Path of the file to be added, relative to garrysmod/
    AddSingleFile: function(path: string)

    --- Adds a workshop addon for the client to download before entering the server. This will not "install" the addon on your server, see Workshop for Dedicated Servers for installing Steam Workshop addons onto your servers.
    --- Having the raw files from a workshop item does not count as having already downloaded it.
    --- So players who previously downloaded a map through [FastDL](Serving_Content) will have to re-download it if it is part of a workshop addon.
    --- You should try to only add addons that have custom content (models, sounds, etc). Lua files are not considered content, and are handled by a separate system. Adding workshop addons that only have Lua files is a waste, it will do nothing.
    --- Gamemodes that are workshop enabled and the current map are automatically added to this list, if they come from the servers' workshop collection - so there's no need to manually add them.
    --- **WARNING**: There's a 8192 downloadable file limit. If you need more, consider the fact that you have way too many downloads. This limit is shared among all `resource.Add*` functions.
    --- See also Serving Content
    -- @param workshopid --- The workshop id of the file. This cannot be a collection.
    AddWorkshop: function(workshopid: string)
end


--- The saverestore library contains functions relating to the singleplayer save system built into the game.
global record saverestore
    --- Adds a restore/load hook for the Half-Life 2 save system.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L362-L369)
    -- @param identifier --- The unique identifier for this hook.
    -- @param callback --- The function to be called when an engine save is being loaded.
    --- <callback>
    --- <arg type="IRestore" name="save">The restore object to be used to read data from save file that is being loaded.</arg>
    --- </callback>
    --- You can also use those functions to read data:
    --- * saverestore.ReadVar
    --- * saverestore.ReadTable
    --- * saverestore.LoadEntity
    AddRestoreHook: function(identifier: string, callback: function)

    --- Adds a save hook for the Half-Life 2 save system. You can use this to carry data through level transitions in Half-Life 2.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L348-L355)
    -- @param identifier --- The unique identifier for this hook.
    -- @param callback --- The function to be called when an engine save is being saved.
    --- <callback>
    --- <arg type="ISave" name="save">The save object to be used to write data to the save file that is being saved.</arg>
    --- </callback>
    --- You can also use those functions to save data:
    --- * saverestore.WriteVar
    --- * saverestore.WriteTable
    --- * saverestore.SaveEntity
    AddSaveHook: function(identifier: string, callback: function)

    --- Loads Entity:GetTable from the save game file that is being loaded and merges it with the given entitys Entity:GetTable.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L325-L341)
    -- @param ent --- The entity which will receive the loaded values from the save.
    -- @param save --- The restore object to read the Entity:GetTable from.
    LoadEntity: function(ent: GEntity, save: GIRestore)

    --- **INTERNAL**:
    --- Called by engine when a save is being loaded.
    --- This handles loading gamemode and calls all of the hooks added with saverestore.AddRestoreHook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L399-L425)
    -- @param save --- The restore object to read data from the save file with.
    LoadGlobal: function(save: GIRestore)

    --- **INTERNAL**:
    --- Called by the engine just before saverestore.LoadGlobal is.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L55-L60)
    PreRestore: function()

    --- **INTERNAL**:
    --- Called by the engine just before saverestore.SaveGlobal is.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L48-L53)
    PreSave: function()

    --- Reads a table from the save game file that is being loaded.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L264-L304)
    -- @param save --- The restore object to read the table from.
    -- @return --- The table that has been read, if any
    ReadTable: function(save: GIRestore): table

    --- Loads a variable from the save game file that is being loaded.
    --- Variables will be read in the save order you have saved them.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L178-L207)
    -- @param save --- The restore object to read variables from.
    -- @return --- The variable that was read, if any.
    ReadVar: function(save: GIRestore): any

    --- Saves entitys Entity:GetTable to the save game file that is being saved.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L311-L319)
    -- @param ent --- The entity to save Entity:GetTable of.
    -- @param save --- The save object to save Entity:GetTable to.
    SaveEntity: function(ent: GEntity, save: GISave)

    --- **INTERNAL**:
    --- Called by engine when a save is being saved.
    --- This handles saving gamemode and calls all of the hooks added with saverestore.AddSaveHook.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L376-L392)
    -- @param save --- The save object to write data into the save file.
    SaveGlobal: function(save: GISave)

    --- Returns how many writable keys are in the given table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L125-L137)
    -- @param table --- The table to test.
    -- @return --- The number of keys that can be written with saverestore.WriteTable.
    WritableKeysInTable: function(table: table): number

    --- Write a table to a save game file that is being saved.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L213-L258)
    -- @param table --- The table to write
    -- @param save --- The save object to write the table to.
    WriteTable: function(table: table, save: GISave)

    --- Writes a variable to the save game file that is being saved.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/saverestore.lua#L144-L171)
    -- @param value --- The value to save.
    --- It can be one of the following types: number, boolean, string, Entity, Angle, Vector or table.
    -- @param save --- The save object to write the variable to.
    WriteVar: function(value: any, save: GISave)
end


--- The scripted_ents library allows you to access information about any scripted entities loaded into the game, as well as register your own entities.
global record scripted_ents
    --- Defines an alias string that can be used to refer to another classname
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L256-L260)
    -- @param alias --- A new string which can be used to refer to another classname
    -- @param classname --- The classname the alias should refer to
    Alias: function(alias: string, classname: string)

    --- Returns a copy of the ENT table for a class, including functions defined by the base class
    --- **INTERNAL**:
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L159-L193)
    -- @param classname --- The classname of the ENT table to return, can be an alias
    -- @return --- entTable
    Get: function(classname: string): table

    --- Returns a copy of the list of all ENT tables registered
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L228-L236)
    -- @return --- A table of all SENTs where the key is the classname and the value is a table where:
    --- * table **t** — The ENT table associated with the entity
    --- * boolean **isBaseType** — Unused. Always `true`
    --- * string **Base** — The entity base
    --- * string **type** — The entity type
    GetList: function(): {string:table}

    --- Retrieves a member of entity's table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L262-L278)
    -- @param class --- Entity's class name
    -- @param name --- Name of member to retrieve
    -- @return --- The member or nil if failed
    GetMember: function(class: string, name: string): any

    --- Returns a list of all ENT tables which contain ENT.Spawnable
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L238-L254)
    -- @return --- A table of Structures/ENTs
    GetSpawnable: function(): table

    --- Returns the actual ENT table for a class. Modifying functions/variables in this table will change newly spawned entities
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L220-L222)
    -- @param classname --- The classname of the ENT table to return
    -- @return --- entTable
    GetStored: function(classname: string): table

    --- Returns the 'type' of a class, this will one of the following: 'anim', 'ai', 'brush', 'point'.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L195-L214)
    -- @param classname --- The classname to check
    -- @return --- type
    GetType: function(classname: string): string

    --- Checks if name is based on base
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L44-L51)
    -- @param name --- Entity's class name to be checked
    -- @param base --- Base class name to be checked
    -- @return --- Returns true if class name is based on base, else false.
    IsBasedOn: function(name: string, base: string): boolean

    --- **INTERNAL**:
    --- Called after all ENTS have been loaded and runs baseclass.Set on each one.
    --- You can retrieve all the currently registered ENTS with scripted_ents.GetList.
    --- **NOTE**: This is not called after an ENT auto refresh, and thus the inherited baseclass functions retrieved with baseclass.Get will not be updated
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L144-L157)
    OnLoaded: function()

    --- Registers an ENT table with a classname. Reregistering an existing classname will automatically update the functions of all existing entities of that class.
    --- **BUG**: [Sub-tables provided in the first argument will not carry over their metatable, and will receive a BaseClass key if the table was merged with the base's. Userdata references, which includes Vectors, Angles, Entities, etc. will not be copied.](https://github.com/Facepunch/garrysmod/pull/1300
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/scripted_ents.lua#L53-L139)
    -- @param ENT --- The ENT table to register.
    --- For the table's format and available options see the Structures/ENT page.
    -- @param classname --- The classname to register.
    Register: function(ENT: table, classname: string)
end


--- The search library
global record search
    --- Adds a search result provider. For examples, see [gamemodes/sandbox/gamemode/cl_search_models.lua](https://github.com/Facepunch/garrysmod/blob/7c23addd2c35d3d046c80e3d0cb6052055eca3e2/garrysmod/gamemodes/sandbox/gamemode/cl_search_models.lua)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/search.lua#L6-L18)
    -- @param provider --- Provider function.
    --- <callback>
    --- <arg type="string" name="searchQuery">The search query user has inputed.</arg>
    --- <ret type="table" name="data">
    --- You must return a list of tables structured like this:
    --- * string text - Text to "Copy to clipboard"
    --- * function func - Function to use/spawn the item
    --- * Panel icon - A panel to add to spawnmenu
    --- * table words - A table of words?
    --- </ret>
    --- </callback>
    -- @param id --- If provided, ensures that only one provider exists with the given ID at a time.
    AddProvider: function(provider: function, id: string)

    --- Retrieves search results.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/search.lua#L20-L49)
    -- @param query --- Search query
    -- @param types --- If set, only searches given provider type(s), instead of everything. For example `"tool"` will only search tools in Sandbox. Can be a table for multiple types.
    -- @param maxResults --- How many results to stop at
    -- @return --- A table of results
    GetResults: function(query: string, types: string, maxResults: number): table
end


--- Menu state library to query the master server list.
global record serverlist

end


--- Used primarily for adding new soundscript entries.
global record sound
    --- Creates a sound script. It can also override sounds, which seems to only work when set on the server.
    --- You can find a list of common sound scripts that are shipped with the game by default here: Common Sounds.
    --- A list of sound scripts can be retrieved with sound.GetTable.
    -- @param soundData --- The sounds properties. See Structures/SoundData
    Add: function(soundData: S_SoundData)

    --- Overrides sounds defined inside of a txt file; typically used for adding map-specific sounds.
    -- @param filepath --- Path to the script file to load.
    AddSoundOverrides: function(filepath: string)

    --- Emits a sound hint to the game elements to react to, for example to repel or attract antlions.
    -- @param hint --- The hint to emit. This can be a bit flag. See Enums/SOUND
    -- @param pos --- The position to emit the hint at
    -- @param volume --- The volume or radius of the hint
    -- @param duration --- The duration of the hint in seconds
    -- @param owner --- If set, the sound hint will be ignored/deleted when the given entity is destroyed.
    EmitHint: function(hint: number, pos: GVector, volume: number, duration: number, owner: GEntity)

    --- Creates a sound from a function.
    -- @param identifier --- A unique identifier for the sound.
    --- **WARNING**: You cannot override already existing ones.
    -- @param samplerate --- The sample rate of the sound. Must be `11025`, `22050` or `44100`.
    -- @param length --- The length in seconds of the sound to generate.
    -- @param callbackOrData --- A function which will be called to generate every sample on the sound.
    --- <callback>
    --- <arg type="number" name="sampleIndex">The current sample number.</arg>
    --- <ret type="number" name="sampleValue">The return value must be between `-1.0` and `1.0`.
    --- Other values will wrap back to the -1 to 1 range and basically clip.
    --- There are **65535** possible quantifiable values between `-1` and `1`.</ret>
    --- </callback>
    --- This argument can also be given a table of samples, where values must range from `-1` to `1`.
    --- This argument can also be a string of raw 16bit binary data, (each sample is unsigned short).
    -- @param loopStart --- Sample ID of the loop start. If given, the sound will be looping and will restart playing at given position after reaching its end.
    Generate: function(identifier: string, samplerate: number, length: number, callbackOrData: function, loopStart: number)

    --- Returns the most dangerous/closest sound hint based on given location and types of sounds to sense.
    -- @param types --- The types of sounds to choose from. See SOUND_ enums.
    -- @param pos --- The position to sense sounds at.
    -- @return --- A table with SoundHintData structure or `nil` if no sound hints are nearby.
    GetLoudestSoundHint: function(types: number, pos: GVector): table

    --- Returns properties of the soundscript.
    -- @param name --- The name of the sound script
    -- @return --- The properties of the soundscript. See Structures/SoundData
    GetProperties: function(name: string): S_SoundData

    --- Returns a list of all registered sound scripts.
    --- New ones can be registered using sound.Add, and detailed information about each one can be retrieved via sound.GetProperties.
    -- @return --- The list/array of all registered sound scripts ( No other information is provided )
    GetTable: function(): {string}

    --- Plays a sound from the specified position in the world.
    --- If you want to play a sound without a position, such as a UI sound, use surface.PlaySound instead.
    --- This function is similar to Global.EmitSound, but with less options.
    -- @param snd --- The sound to play. This should either be a sound script name (sound.Add) or a file path relative to the `sound/` folder. (Make note that it's not sound**s**)
    -- @param pos --- Where the sound should play.
    -- @param level --- Sound level in decibels. 75 is normal. Ranges from 20 to 180, where 180 is super loud. This affects how far away the sound will be heard, see Enums/SNDLVL.
    -- @param pitch --- The sound pitch. Range is from 0 to 255. 100 is normal pitch.
    -- @param volume --- Output volume of the sound in range 0 to 1.
    -- @param dsp --- The DSP preset for this sound. [List of DSP presets](https://developer.valvesoftware.com/wiki/Dsp_presets)
    Play: function(snd: string, pos: GVector, level: number, pitch: number, volume: number, dsp: number)

    --- Plays a file from GMod directory. You can find a list of all error codes [here](http://www.un4seen.com/doc/#bass/BASS_ErrorGetCode.html)
    --- For external file/stream playback, see sound.PlayURL.
    --- **BUG**: [This fails for looping .wav files in 3D mode.](https://github.com/Facepunch/garrysmod-issues/issues/1752
    --- **BUG**: [This fails with unicode file names.](https://github.com/Facepunch/garrysmod-issues/issues/2304
    -- @param path --- The path to the file to play.
    --- Unlike other sound functions and structures, the path is relative to `garrysmod/` instead of `garrysmod/sound/`
    -- @param flags --- Flags for the sound. Can be one or more of following, separated by a space (" "):
    --- * 3d - Makes the sound 3D, so you can set its position
    --- * mono - Forces the sound to have only one channel
    --- * noplay - Forces the sound not to play as soon as this function is called
    --- * noblock - Disables streaming in blocks. It is more resource-intensive, but it is required for IGModAudioChannel:SetTime.
    --- If you don't want to use any of the above, you can just leave it as "".
    -- @param callback --- Callback function that is called as soon as the the stream is loaded.
    --- <callback>
    --- <arg type="IGModAudioChannel" name="channel">The sound channel. Will be nil if an error occurred.</arg>
    --- <arg type="number" name="errorID">ID of an error if an error has occurred. Will be nil, otherwise.</arg>
    --- <arg type="string" name="errorName">Name of an error if an error has occurred. Will be nil, otherwise.</arg>
    --- </callback>
    PlayFile: function(path: string, flags: string, callback: function)

    --- Allows you to play external sound files, as well as online radio streams.
    --- You can find a list of all error codes [here](http://www.un4seen.com/doc/#bass/BASS_ErrorGetCode.html)
    --- For offline file playback, see sound.PlayFile.
    --- **BUG**: [Due to a bug with [BASS](http://www.un4seen.com/), AAC codec streams cannot be played in 3D mode.](https://github.com/Facepunch/garrysmod-issues/issues/2296
    -- @param url --- The URL of the sound to play
    -- @param flags --- Flags for the sound. Can be one or more of following, separated by a space (`" "`):
    --- * 3d - Makes the sound 3D, so you can set its position
    --- * mono - Forces the sound to have only one channel
    --- * noplay - Forces the sound not to play as soon as this function is called
    --- * noblock - Disables streaming in blocks. It is more resource-intensive, but it is required for IGModAudioChannel:SetTime.
    --- If you don't want to use any of the above, you can just leave it as `""`.
    -- @param callback --- Callback function that is called as soon as the the stream is loaded.
    --- <callback>
    --- <arg type="IGModAudioChannel" name="channel">The sound channel. Will be nil if an error occurred.</arg>
    --- <arg type="number" name="errorID">ID of an error if an error has occurred. Will be nil, otherwise.</arg>
    --- <arg type="string" name="errorName">Name of an error if an error has occurred. Will be nil, otherwise.</arg>
    --- </callback>
    PlayURL: function(url: string, flags: string, callback: function)

    --- Sets the gender of a specific actor (model). This is a system from [base Half-Life 2](https://developer.valvesoftware.com/wiki/Global_actors) - `global_actors.txt`.
    --- This will affect what voice lines `npc_citizen` will use when they have the given model set.
    --- It is not limited to `npc_citizens` - any sound played on any entity with given model can have gender specific sounds playing, including soundscripts, by including `$gender` token in the sound file path.
    --- **WARNING**: Internally the gender is stored by model file name only (i.e. `models/alyx.mdl` would be stored as `alyx`), not the full path! Be aware of potential collisions.
    -- @param modelPath --- Path to the model file to set the gender of.
    -- @param gender --- Gender to set. Only 2 options are permitted: `female` and `male`. Any other option will be ignored.
    SetActorGender: function(modelPath: string, gender: string)
end


--- The spawnmenu library is a set of functions that allow you to control the spawn (Q) menu.
global record spawnmenu
    --- Activates a tool, opens context menu and brings up the tool gun.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L101-L129)
    -- @param tool --- Tool class/file name
    -- @param menu_only --- Should we activate this tool in the menu only or also the toolgun? `true` = menu only,`false` = toolgun aswell
    ActivateTool: function(tool: string, menu_only: boolean)

    --- Activates tools context menu in specified tool tab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L81-L98)
    -- @param tab --- The tabID of the tab to open the context menu in
    -- @param cp --- The control panel to open
    ActivateToolPanel: function(tab: number, cp: GPanel)

    --- Returns currently opened control panel of a tool, post process effect or some other menu in spawnmenu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L24-L26)
    -- @return --- The currently opened control panel, if any.
    ActiveControlPanel: function(): GPanel

    --- Registers a new content type that is saveable into spawnlists.
    --- Created/called by spawnmenu.CreateContentIcon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L285-L287)
    -- @param name --- An unique name of the content type.
    -- @param constructor --- A function that is called whenever we need create a new panel for this content type.
    --- <callback>
    --- <arg type="Panel" name="container">The container/parent of the new panel from spawnmenu.CreateContentIcon</arg>
    --- <arg type="table" name="data">Data for the content type passed from spawnmenu.CreateContentIcon.</arg>
    --- <ret type="Panel" name="pnl">The created panel</ret>
    --- </callback>
    AddContentType: function(name: string, constructor: function)

    --- Inserts a new tab into the CreationMenus table, which will be used by the creation menu to generate its tabs (Spawnlists, Weapons, Entities, etc.)
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L182-L190)
    -- @param name --- What text will appear on the tab (i.e Spawnlists).
    -- @param function --- The function called to generate the content of the tab.
    --- <callback>
    --- <ret type="Panel" name="content">A container panel that holds all of the content for the new tab.</ret>
    --- </callback>
    -- @param material --- Path to the material that will be used as an icon on the tab. Should be a `.png` file. See Silkicons.
    -- @param order --- The order in which this tab should be shown relative to the other tabs on the creation menu.
    -- @param tooltip --- The tooltip to be shown for this tab.
    AddCreationTab: function(name: string, _function: function, material: string, order: number, tooltip: string)

    --- Used to add addon spawnlists to the spawnmenu tree. This function should be called within SANDBOX:PopulatePropMenu.
    --- Addon spawnlists will not save to disk if edited.
    --- **WARNING**: You should never try to modify player customized spawnlists!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L224-L237)
    -- @param classname --- A unique classname of the list.
    -- @param name --- The name of the category displayed to the player, e.g. `Comic Props`.
    -- @param contents --- A table of entries for the spawn menu. It must be numerically indexed.
    --- Each member of the table is a sub-table containing a type member, and other members depending on the type.
    --- New content types can be added via spawnmenu.AddContentType.
    --- | string type | Description | Other members |
    --- | ------------- | ---------- | ----------------- |
    --- | "header" | a simple header for organization | string text - The text that the header will display |
    --- | "model" | spawns a model where the player is looking | string model - The path to the model file
    --- 	 number skin - The skin for the model to use (optional)
    ---  string body - The bodygroups for the model (optional)
    ---  number wide - The width of the spawnicon (optional)
    ---  number tall - The height of the spawnicon (optional) |
    --- | "entity" | spawns an entity where the player is looking
    --- (appears in the Entities tab by default) | string spawnname - The filename of the entity, for example "sent_ball"
    ---  string nicename - The name of the entity to display
    ---  string material - The icon to display, this should be set to `entities/[sent_name].png`
    --- 	boolean admin - Whether the entity is only spawnable by admins (optional) |
    --- | "vehicle" | spawns a vehicle where the player is looking
    ---  (appears in the Vehicles tab by default) | string spawnname - The filename of the vehicle
    ---  string nicename - The name of the vehicle to display
    ---  string material - The icon to display
    ---  boolean admin - Whether the vehicle is only spawnable by admins (optional) |
    --- | "npc" | spawns an NPC where the player is looking
    ---  (appears in the NPCs tab by default) | string spawnname - The spawn name of the NPC
    --- 	string nicename - The name to display
    ---  string material - The icon to display
    ---  table weapon - A table of potential weapons (each a string) to give to the NPC.
    ---  When spawned, one of these will be chosen randomly each time.
    ---  boolean admin - Whether the NPC is only spawnable by admins (optional) |
    --- | "weapon" | When clicked, gives the player a weapon;
    ---  When middle-clicked, spawns a weapon where the player is looking
    ---  (appears in the Weapons tab by default) |string spawnname - The spawn name of the weapon
    ---  string nicename - The name to display
    ---  string material - The icon to display
    ---  boolean admin - Whether the weapon is only spawnable by admins (optional) |
    -- @param icon --- The icon to use in the tree.
    -- @param id --- The unique ID number for the spawnlist category. Used to make sub categories. See "parentID" parameter below. If not set, it will be automatically set to ever increasing number, starting with 1000.
    -- @param parentID --- The unique ID of the parent category. This will make the created category a subcategory of category with given unique ID. `0` makes this a base category (such as `Builder`).
    -- @param needsApp --- The needed game for this prop category, if one is needed. If the specified game is not mounted, the category isn't shown. This uses the shortcut name, e.g. `cstrike`, and not the Steam AppID.
    AddPropCategory: function(classname: string, name: string, contents: table, icon: string, id: number, parentID: number, needsApp: string)

    --- Used to create a new category in the list inside of a spawnmenu Tool Tab.
    --- You must call this function from SANDBOX:AddToolMenuCategories for it to work properly.
    --- See spawnmenu.AddToolTab to add new tool tabs.
    --- See spawnmenu.AddToolMenuOption to add new sub options to a newly created tool category.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L131-L145)
    -- @param tabName --- The internal tool tab name, as created with spawnmenu.AddToolTab.
    --- You can also use the default Tool Tab names `"Main"` and `"Utilities"`.
    -- @param className --- The unique identifier name, which will be used to add tool option to this category.
    -- @param printName --- The nice name to be displayed to the player. See Addon Localization.
    AddToolCategory: function(tabName: string, className: string, printName: string)

    --- Adds an option to the right side of the spawnmenu.
    --- See spawnmenu.AddToolTab to add new right-side tabs. See spawnmenu.AddToolCategory to add new categories.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L147-L175)
    -- @param tab --- The internal name of the spawnmenu tab to add into (for example "Utilities")
    -- @param category --- The internal name of the category within the tab to add into (for example "Admin")
    -- @param class --- Unique internal identifier of the new option. This is used to reference this option by other code.
    -- @param name --- The nice name of item to show to the player. See Addon Localization.
    -- @param cmd --- Console command to execute when the item is selected.
    -- @param config --- Config name, used in older versions to load tool settings UI from a file.
    --- @deprecated
    --- **DEPRECATED**: Legacy argument, no longer works.
    -- @param cpanel --- A function to build the context panel.
    --- <callback>
    --- <arg type="Panel" name="pnl">A DForm that will be shown in the context menu</arg>
    --- </callback>
    -- @param table --- Allows to override the table that will be added to the tool list. Some of the fields will be overwritten by this function.
    AddToolMenuOption: function(tab: string, category: string, class: string, name: string, cmd: string, config: string, cpanel: function, table: table)

    --- Adds a new tool tab to the right side of the spawnmenu. (usually via the SANDBOX:AddToolMenuTabs hook)
    --- See spawnmenu.GetToolMenu for a function to retrieve existing tool tabs.
    --- See spawnmenu.AddCreationTab for tabs on the left side of the spawnmenu.
    --- See spawnmenu.AddToolCategory to add new categories to the newly created tool tab.
    --- See spawnmenu.AddToolMenuOption to add new options to the categories within a tool tab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L66-L70)
    -- @param name --- The internal name of the tab. This is used for sorting, as well as adding categories, so it should be unique.
    -- @param label --- The 'nice' name of the tab that is displayed to the player. See Addon Localization.
    -- @param icon --- The file path to the icon of the tab. Should be a `.png` file. See Silkicons.
    AddToolTab: function(name: string, label: string, icon: string)

    --- Clears all the tools from the different tool categories and the categories itself, if ran at the correct place.
    --- Seems to only work when ran at initialization.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L60-L64)
    ClearToolMenus: function()

    --- Creates a new ContentIcon previously defined via spawnmenu.AddContentType.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L301-L306)
    -- @param type --- The type of the content icon.
    --- Default content types are:
    --- * model
    --- Sandbox only content types:
    --- * tool
    --- * header
    --- * entity
    --- * vehicle
    --- * npc
    --- * weapon
    --- * postprocess
    -- @param parent --- The parent to add the ContentIcon to.
    -- @param data --- The data to send to the content icon in spawnmenu.AddContentType. Data required will depend on the content type.
    -- @return --- The created ContentIcon, if it was returned by spawnmenu.AddContentType.
    CreateContentIcon: function(type: string, parent: GPanel, data: table): GPanel

    --- **INTERNAL**:
    --- Calls spawnmenu.SaveToTextFiles.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L260-L264)
    -- @param spawnlists --- A table containing spawnlists.
    DoSaveToTextFiles: function(spawnlists: table)

    --- Returns the function to create an vgui element for a specified content type, previously defined by spawnmenu.AddContentType.
    --- If a content type doesn't exist, a dummy function will be returned, and a warning printed to the console.
    --- You probably want to use spawnmenu.CreateContentIcon to create icons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L289-L299)
    -- @param contentType --- The content type name.
    -- @return --- The panel creation function.
    --- <callback>
    --- <arg type="Panel" name="container">The container panel to parent the created icon to.</arg>
    --- <arg type="table" name="data">Data for the content type passed from spawnmenu.CreateContentIcon.</arg>
    --- <ret type="Panel" name="pnl">The created panel</ret>
    --- </callback>
    GetContentType: function(contentType: string): function

    --- Returns the list of Creation tabs. Creation tabs are added via spawnmenu.AddCreationTab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L192-L196)
    -- @return --- The list of Creation tabs. See the Structures/CreationMenus.
    GetCreationTabs: function(): table

    --- Similar to spawnmenu.GetPropTable, but only returns spawnlists created by addons via spawnmenu.AddPropCategory.
    --- These spawnlists are shown in a separate menu in-game.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L218-L222)
    -- @return --- See spawnmenu.GetPropTable for table format.
    GetCustomPropTable: function(): table

    --- Returns a table of all prop categories and their props in the spawnmenu.
    --- Note that if the spawnmenu has not been populated, this will return an empty table.
    --- This will not return spawnlists created by addons, see  spawnmenu.GetCustomPropTable for that.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L212-L216)
    -- @return --- Table of all the prop categories and props in the following format:
    --- ```
    --- {
    --- ["settings/spawnlist/001-construction props.txt"] = {
    --- name = "Construction Props",
    --- icon = "icon16/page.png",
    --- id = 1,
    --- parentid = 0,
    --- needsapp = "",
    --- contents = {
    --- {
    --- model = "models/Cranes/crane_frame.mdl",
    --- type = "model"
    --- }
    --- -- etc.
    --- },
    --- }
    --- -- etc.
    --- }
    --- ```
    GetPropTable: function(): table

    --- Returns an existing tool tab by name from the right side of the spawnmenu (usually during the SANDBOX:AddToolMenuTabs hook)
    --- If the requested tooltab does not exist, it will be added. See also spawnmenu.AddToolTab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L32-L58)
    -- @param name --- The internal name of the tab. This is used for sorting.
    -- @param label --- The 'nice' name of the tab
    -- @param icon --- The file path to the icon of the tab. Should be a `.png` file. See Silkicons.
    -- @return --- A table of tables representing categories and items in the left part of the tab. See example below to example structure.
    GetToolMenu: function(name: string, label: string, icon: string): table

    --- Gets a table of tools on the client.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L28-L30)
    -- @return --- A table with groups of tools, along with information on each tool.
    GetTools: function(): table

    --- **INTERNAL**:
    --- Calls spawnmenu.PopulateFromTextFiles.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L240-L257)
    PopulateFromEngineTextFiles: function()

    --- **INTERNAL**:
    --- Loads spawnlists from text files. You probably are looking for spawnmenu.AddPropCategory.
    -- @param callback --- The function to call.
    --- <callback>
    --- <arg type="string" name="strFilename">The file name for the spawnlist.</arg>
    --- <arg type="string" name="strName">The "nice" title for the spawnlist.</arg>
    --- <arg type="table" name="tabContents">The list of contents for this spawnlist.</arg>
    --- <arg type="string" name="icon">Path to an `.png` icon of the spawnlist, should be 16x16 image.</arg>
    --- <arg type="number" name="id">Unique ID of the spawnlist</arg>
    --- <arg type="number" name="parentid">UniqueID of the parents spawnlist ID</arg>
    --- <arg type="string" name="needsapp">If not empty, the internal folder name of an mountable game that is required for this spawnlist to show up.</arg>
    --- </callback>
    PopulateFromTextFiles: function(callback: function)

    --- **INTERNAL**:
    --- Saves a table of spawnlists to files.
    -- @param spawnlists --- A table containing spawnlists.
    SaveToTextFiles: function(spawnlists: table)

    --- **INTERNAL**:
    --- Sets currently active control panel to be returned by spawnmenu.ActiveControlPanel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L20-L22)
    -- @param pnl --- The panel to set.
    SetActiveControlPanel: function(pnl: GPanel)

    --- Switches the creation tab (left side of the spawnmenu) on the spawnmenu to the given tab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L198-L205)
    -- @param id --- The tab ID to open
    SwitchCreationTab: function(id: string)

    --- Opens specified tool tab in spawnmenu.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/spawnmenu.lua#L72-L79)
    -- @param id --- The tab ID to open
    SwitchToolTab: function(id: number)
end


--- The SQL library allows you to access powerful database software included with Garry's Mod. It is the preferred and fastest method of storing large amounts of data. The database is located in sv.db serverside and cl.db clientside, both in the Garry's Mod base folder. SQL is a whole scripting language in itself although relatively simple, it's something you'll need to read up on before using this library.
--- Example of using sql.
--- ```
--- -- Creating a table
--- sql.Query("CREATE TABLE my_db_table( id NUMBER , name TEXT )" )
--- -- Inserting a value to the table
--- sql.Query("INSERT INTO my_db_table( id , name ) VALUES( 1 , 'First') ")
--- -- Printing the tables data
--- PrintTable( sql.Query("SELECT * FROM my_db_table ") )
--- -- Deleting the table
--- sql.Query("DROP TABLE my_db_table")
--- ```
--- Known GMod [SQLite](https://www.sqlite.org/compile.html) settings:
--- * Temp files are stored in memory (`SQLITE_TEMP_STORE = 3`)
--- * No `ATTACH` and `DETACH` operations (`SQLITE_OMIT_ATTACH = 1`)
--- * No Virtual Tables (`SQLITE_OMIT_VIRTUALTABLE = 1`)
--- * No `VACUUM` operation (`SQLITE_OMIT_VACUUM = 1`)
--- * No `LIMIT` and `ORDER BY` clauses in `DELETE` and `UPDATE` statements (`SQLITE_ENABLE_UPDATE_DELETE_LIMIT`)
global record sql
    --- Tells the engine a set of queries is coming. Will wait until sql.Commit is called to run them.
    --- This is most useful when you run more than 100+ queries.
    --- This is equivalent to :
    --- ```
    --- sql.Query( "BEGIN;" )
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L87-L93)
    Begin: function()

    --- Tells the engine to execute a series of queries queued for execution, must be preceded by sql.Begin.
    --- This is equivalent to `sql.Query( "COMMIT;" )`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L96-L101)
    Commit: function()

    --- Returns true if the index with the specified name exists.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L41-L50)
    -- @param indexName --- The name of the index to check.
    -- @return --- exists
    IndexExists: function(indexName: string): boolean

    --- Returns the last error from a SQLite query.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L104-L109)
    -- @return --- Last error from SQLite database.
    LastError: function(): string

    --- Performs a query on the local SQLite database, returns a table as result set, nil if result is empty and false on error.
    --- **WARNING**: To run SQL queries with this function safely, it is crucial to ensure that the concatenated variables in the query string are safe to avoid vulnerabilities like SQL injections. For this, it is recommended to use the sql.SQLStr, which allows arguments to be escaped correctly.
    --- It's best to just use sql.QueryTyped instead if possible.
    -- @param query --- The query to execute.
    -- @return --- `false` is returned if there is an error, `nil` if the query returned no data.
    Query: function(query: string): table|boolean|nil

    --- Performs the sql.Query and returns the n'th row.
    --- This function is equivalent to safely returning
    --- ```lua
    --- sql.Query(query)[row]
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L52-L66)
    -- @param query --- The query as used in sql.Query
    -- @param row --- The row number.
    -- @return --- The returned row.
    QueryRow: function(query: string, row: number): table

    --- Performs a query on the local SQLite database with proper type handling and parameter binding, returns a table as result set, empty table if no results, and false on error. Unlike sql.Query, this function properly handles SQLite data types and allows safe parameter binding to prevent SQL injection attacks.
    --- **WARNING**: * This function only executes a single SQL statement, unlike sql.Query which can execute multiple statements separated by semicolons.
    --- * Large INTEGER values (beyond ±9,007,199,254,740,991) are returned as strings to preserve exact values. This is because Lua represents all numbers as doubles, which lose precision for integers larger than 2⁵³-1. Returning them as strings prevents data corruption from rounding errors.
    -- @param query --- The query to execute with optional `?` parameter placeholders.
    --- **WARNING**: * Always use parameter binding with `?` placeholders instead of string concatenation to prevent SQL injection vulnerabilities.
    -- @param queryParams --- Parameters to bind to the query placeholders. Supports nil, boolean, number, and string types.
    --- The number of query parameters must match the number of `?` placeholders, or the query will fail. See examples.
    -- @return --- `false` is returned if there is an error (See sql.LastError), otherwise a table with properly typed column values (empty table if no results).
    QueryTyped: function(query: string, ...: any): table|boolean

    --- Performs the query like sql.QueryRow, but returns the first value found.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L68-L85)
    -- @param query --- The input query.
    -- @return --- The returned value.
    QueryValue: function(query: string): string

    --- Escapes dangerous characters and symbols from user input used in an SQLite SQL Query.
    --- If possible, it is recommended to use sql.QueryTyped instead.
    --- **WARNING**: Do not use this function with external database engines such as `MySQL`. `MySQL` and `SQLite` use different escape sequences that are incompatible with each other! Escaping strings with inadequate functions is dangerous and will lead to SQL injection vulnerabilities.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L6-L27)
    -- @param string --- The string to be escaped.
    -- @param bNoQuotes --- Set this as `true`, and the function will not wrap the input string in apostrophes.
    -- @return --- The escaped input.
    SQLStr: function(string: string, bNoQuotes: boolean): string

    --- Returns true if the table with the specified name exists.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/sql.lua#L30-L39)
    -- @param tableName --- The name of the table to check.
    -- @return --- exists
    TableExists: function(tableName: string): boolean
end


--- Steamworks related functions.
global record steamworks
    --- **NOTE**: You really should be using steamworks.DownloadUGC when downloading Steam Workshop items. This is a legacy function for preview images.
    --- Downloads a file from the supplied addon and saves it as a `.cache` file in `garrysmod/cache/` folder.
    --- This is mostly used to download the preview image of the addon.
    --- In case the retrieved file is an image and you need the IMaterial, use Global.AddonMaterial with the path supplied from the callback.
    -- @param workshopPreviewID --- The Preview ID of workshop item.
    -- @param uncompress --- Whether to uncompress the file or not, assuming it was compressed with LZMA.
    --- You will usually want to set this to true.
    -- @param resultCallback --- The function to process retrieved data.
    --- <callback>
    --- <arg type="string" name="path">Path to the downloaded file.</arg>
    --- </callback>
    Download: function(workshopPreviewID: string, uncompress: boolean, resultCallback: function)

    ---
    -- @param workshopID --- The ID of workshop item to download. **NOT** a file ID.
    -- @param resultCallback --- The function to process retrieved data.
    --- <callback>
    --- <arg type="string" name="path">Contains a path to the saved file, or nil if the download failed for any reason.</arg>
    --- <arg type="file_class" name="file">A file object pointing to the downloaded .gma file. The file handle will be closed after the function exits.</arg>
    --- </callback>
    DownloadUGC: function(workshopID: string, resultCallback: function)

    --- Retrieves info about supplied Steam Workshop addon.
    -- @param workshopItemID --- The ID of Steam Workshop item.
    -- @param resultCallback --- The function to process retrieved data.
    --- <callback>
    --- <arg type="table" name="data">The data about the item, if the request succeeded, `nil` otherwise. See Structures/UGCFileInfo.</arg>
    --- </callback>
    FileInfo: function(workshopItemID: string, resultCallback: function)

    --- Retrieves a customized list of Steam Workshop addons.
    -- @param type --- The type of items to retrieve. Possible values include:
    --- * popular (All invalid options will equal to this)
    --- * trending
    --- * latest
    --- * friends
    --- * followed - Items of people the player is following on Steam
    --- * friend_favs - Favorites of player's friends
    --- * favorite - Player's favorites
    -- @param tags --- A table of tags to match.
    -- @param offset --- How much of results to skip from first one. This is useful for pagination. Negative values are invalid.
    -- @param numRetrieve --- How many items to retrieve, up to `50` at a time. Negative values are invalid.
    -- @param days --- When getting `popular` or `trending` content from Steam, this determines a time period, in range of days from `0` to `365`. ( `7` = most popular addons in last 7 days, `30` = most popular addons in the last month, etc ). If given a zero, will automatically choose a value, which is `7` for `trending`.
    -- @param userID --- `"0"` to retrieve all addons, `"1"` to retrieve addons only published by you, or a valid SteamID64 of a user to get workshop items of.
    -- @param resultCallback --- The function to process retrieved data.
    --- <callback>
    --- <arg type="table" name="data">The list of items, or nil in case of error.</arg>
    --- </callback>
    GetList: function(type: string, tags: table, offset: number, numRetrieve: number, days: number, userID: string, resultCallback: function)

    --- @deprecated
    --- **DEPRECATED**: You should use the callback of steamworks.RequestPlayerInfo instead.
    --- Retrieves players name by their 64bit SteamID.
    --- You must call steamworks.RequestPlayerInfo a decent amount of time before calling this function.
    -- @param steamID64 --- The 64bit Steam ID ( aka Community ID ) of the player
    -- @return --- The name of that player
    GetPlayerName: function(steamID64: string): string

    --- Returns whenever the client is subscribed to the specified Steam Workshop item.
    -- @param workshopItemID --- The ID of the Steam Workshop item.
    -- @return --- Is the client subscribed to the addon or not.
    IsSubscribed: function(workshopItemID: string): boolean

    --- Opens the workshop website in the steam overlay browser.
    OpenWorkshop: function()



    --- Requests information of the player with SteamID64 for later use with steamworks.GetPlayerName.
    -- @param steamID64 --- The 64bit Steam ID of player.
    -- @param callback --- A callback function with the data when it arrives.
    --- <callback>
    --- <arg type="string" name="name">The player's name.</arg>
    --- </callback>
    RequestPlayerInfo: function(steamID64: string, callback: function)







    --- Returns whenever the specified Steam Workshop addon will be mounted or not.
    -- @param workshopItemID --- The ID of the Steam Workshop
    -- @return --- Will the workshop item be mounted or not
    ShouldMountAddon: function(workshopItemID: string): boolean





    --- Opens the workshop website for specified Steam Workshop item in the Steam overlay browser.
    -- @param workshopItemID --- The ID of workshop item.
    ViewFile: function(workshopItemID: string)



    --- @deprecated
    --- **DEPRECATED**: Use data steamworks.FileInfo instead.
    --- Retrieves vote info of supplied addon.
    -- @param workshopItemID --- The ID of workshop item.
    -- @param resultCallback --- The function to process retrieved data.
    --- <callback>
    --- <arg type="table" name="data">The vote information. See Structures/UGCFileInfo.</arg>
    --- </callback>
    VoteInfo: function(workshopItemID: string, resultCallback: function)
end




--- The surface library allows you to draw text and shapes on the screen. Primarily used for making HUDs & custom GUI panels.
global record surface
    --- Creates a new font.
    --- To prevent the font from displaying incorrectly when using the `outline` setting, set `antialias` to false. This will ensure the text properly fills out the entire outline.
    --- Be sure to check the List of Default Fonts first! Those fonts can be used without using this function.
    --- See Also: Finding the Font Name.
    --- **WARNING**: Due to the static nature of fonts, do **NOT** create the font more than once. You should only be creating them once, it is recommended to create them at the top of your script. Do not use this function within GM:HUDPaint or any other hook!
    --- Define fonts that you will actually use, as fonts are very taxing on performance and will cause crashes! Do not create fonts for every size.
    -- @param fontName --- The new font name.
    -- @param fontData --- The font properties. See the Structures/FontData.
    CreateFont: function(fontName: string, fontData: S_FontData)

    --- @deprecated
    --- **DEPRECATED**:
    --- Alias of Global.DisableClipping so use that instead.
    --- Enables or disables the clipping used by the VGUI that limits the drawing operations to a panels bounds.
    --- Identical to Global.DisableClipping. See also Panel:NoClipping.
    -- @param disable --- True to disable, false to enable the clipping
    -- @return oldState --- Whether the clipping was enabled or not before this function call
    DisableClipping: function(disable: boolean): boolean

    --- Draws a hollow circle, made of lines. For a filled circle, see examples for surface.DrawPoly.
    --- **NOTE**: Provides a 2D rendering context
    -- @param originX --- The center x integer coordinate.
    -- @param originY --- The center y integer coordinate.
    -- @param radius --- The radius of the circle.
    -- @param r --- The red value of the color to draw the circle with.
    -- @param g --- The green value of the color to draw the circle with.
    -- @param b --- The blue value of the color to draw the circle with.
    -- @param a --- The alpha value of the color to draw the circle with.
    DrawCircle: function(originX: number, originY: number, radius: number, r: number, g: number, b: number, a: number)

    --- Draws a hollow circle, made of lines. For a filled circle, see examples for surface.DrawPoly.
    --- **NOTE**: Provides a 2D rendering context
    -- @param originX --- The center x integer coordinate.
    -- @param originY --- The center y integer coordinate.
    -- @param radius --- The radius of the circle.
    -- @param color --- A Color object/table to read the color from.
    DrawCircle: function(originX: number, originY: number, radius: number, color: table)

    --- Draws a line from one point to another.
    --- **NOTE**: Provides a 2D rendering context
    -- @param startX --- The start x float coordinate.
    -- @param startY --- The start y float coordinate.
    -- @param endX --- The end x float coordinate.
    -- @param endY --- The end y float coordinate.
    DrawLine: function(startX: number, startY: number, endX: number, endY: number)

    --- Draws a hollow box with a given border width.
    --- **NOTE**: Provides a 2D rendering context
    -- @param x --- The start x integer coordinate.
    -- @param y --- The start y integer coordinate.
    -- @param w --- The integer width.
    -- @param h --- The integer height.
    -- @param thickness --- The thickness of the outlined box border.
    DrawOutlinedRect: function(x: number, y: number, w: number, h: number, thickness: number)

    --- Draws a textured polygon (secretly a triangle fan) with a maximum of 4096 vertices.
    --- Only works properly with convex polygons. You may try to render concave polygons, but there is no guarantee that things wont get messed up.
    --- Unlike most surface library functions, non-integer coordinates are not rounded.
    --- **WARNING**: You must reset the drawing color and texture before calling the function to ensure consistent results. See examples below.
    --- **NOTE**: Provides a 2D rendering context
    -- @param vertices --- A table containing integer vertices. See the Structures/PolygonVertex.
    --- **The vertices must be in clockwise order.**
    DrawPoly: function(vertices: table)

    --- Draws a solid rectangle on the screen.
    --- **NOTE**: Provides a 2D rendering context
    -- @param x --- The X integer co-ordinate.
    -- @param y --- The Y integer co-ordinate.
    -- @param width --- The integer width of the rectangle.
    -- @param height --- The integer height of the rectangle.
    DrawRect: function(x: number, y: number, width: number, height: number)

    --- Draw the specified text on the screen, using the previously set [position](surface.SetTextPos), [font](surface.SetFont) and [color](surface.SetTextColor). This function does **not** handle newlines.
    --- This function moves the [text position](surface.SetTextPos) by the length of the drawn text - this can be used to change text properties (such as font or color) without having to manually recalculate the text position. See example #2 for example use of this behavior.
    --- **NOTE**: Provides a 2D rendering context
    -- @param text --- The text to be rendered.
    -- @param forceAdditive --- `true` to force text to render additive, `false` to force not additive, `nil` to use font's value.
    --- When additive rendering is enabled, the rendered text pixels will be added to the existing screen pixels, rather than replacing them outright. This means black text will be invisible, and drawing on a pure white background will be impossible.
    --- <upload src="70c/8db6ce804200a43.png" size="21270" name="image.png">
    --- </upload>
    DrawText: function(text: string, forceAdditive: boolean)

    --- Draw a textured rectangle with the given position and dimensions on the screen, using the current active texture set with surface.SetMaterial. It is also affected by surface.SetDrawColor.
    --- See also render.SetMaterial and render.DrawScreenQuadEx.
    --- See also surface.DrawTexturedRectUV and surface.DrawTexturedRectRotated.
    --- **NOTE**: Provides a 2D rendering context
    -- @param x --- The X integer co-ordinate.
    -- @param y --- The Y integer co-ordinate.
    -- @param width --- The integer width of the rectangle.
    -- @param height --- The integer height of the rectangle.
    DrawTexturedRect: function(x: number, y: number, width: number, height: number)

    --- Draw a textured rotated rectangle with the given position and dimensions and angle on the screen, using the current active texture.
    --- See also surface.DrawTexturedRectUV and surface.DrawTexturedRect.
    --- **NOTE**: Provides a 2D rendering context
    -- @param x --- The X integer co-ordinate, representing the center of the rectangle.
    -- @param y --- The Y integer co-ordinate, representing the center of the rectangle.
    -- @param width --- The integer width of the rectangle.
    -- @param height --- The integer height of the rectangle.
    -- @param rotation --- The rotation of the rectangle, in degrees.
    DrawTexturedRectRotated: function(x: number, y: number, width: number, height: number, rotation: number)

    --- Draws a textured rectangle with a repeated or partial texture.
    --- `u` and `v` refer to texture coordinates.
    --- * (u, v) = (0, 0) is the top left
    --- * (u, v) = (1, 0) is the top right
    --- * (u, v) = (1, 1) is the bottom right
    --- * (u, v) = (0, 1) is the bottom left
    --- Using a start point of (1, 0) and an end point to (0, 1), you can draw an image flipped horizontally, same goes with other directions. Going above 1 will tile the texture. Negative values are allowed as well.
    --- Here's a helper image:
    --- <upload src="70c/8d7bba248dc08bd.png" size="183359" name="image.png">
    --- See also surface.DrawTexturedRect and surface.DrawTexturedRectRotated.
    --- **NOTE**: If you are using a .png image, you need supply the "noclamp" flag as second parameter for Global.Material if you intend to use tiling.
    --- **NOTE**: If you find that `surface.DrawTexturedRectUV` is getting your texture coordinates (u0, v0), (u1, v1) wrong and you're rendering with a material created with Global.CreateMaterial, try adjusting them with the following code:
    --- ```
    --- local du = 0.5 / 32 -- half pixel anticorrection
    --- local dv = 0.5 / 32 -- half pixel anticorrection
    --- local u0, v0 = (u0 - du) / (1 - 2 * du), (v0 - dv) / (1 - 2 * dv)
    --- local u1, v1 = (u1 - du) / (1 - 2 * du), (v1 - dv) / (1 - 2 * dv)
    --- ```
    --- **Explanation:**
    --- `surface.DrawTexturedRectUV` tries to correct the texture coordinates by half a pixel (something to do with sampling) and computes the correction using `IMaterial::GetMappingWidth()`/`GetMappingHeight()`. If the material was created without a `$basetexture`, then `GetMappingWidth()`/`GetMappingHeight()` uses the width and height of the error material (which is 32x32).
    --- **NOTE**: Provides a 2D rendering context
    --- **BUG**: [The UV offsets might require (sub-)pixel correction for accurate tiling results.](https://github.com/Facepunch/garrysmod-issues/issues/3173
    --- </upload>
    -- @param x --- The X integer coordinate.
    -- @param y --- The Y integer coordinate.
    -- @param width --- The integer width of the rectangle.
    -- @param height --- The integer height of the rectangle.
    -- @param startU --- The U texture mapping of the rectangle origin.
    -- @param startV --- The V texture mapping of the rectangle origin.
    -- @param endU --- The U texture mapping of the rectangle end.
    -- @param endV --- The V texture mapping of the rectangle end.
    DrawTexturedRectUV: function(x: number, y: number, width: number, height: number, startU: number, startV: number, endU: number, endV: number)

    --- Returns the current alpha multiplier affecting drawing operations. This is set by surface.SetAlphaMultiplier or by the game engine in certain other cases.
    -- @return --- The multiplier ranging from 0 to 1.
    GetAlphaMultiplier: function(): number

    --- Returns the current color affecting draw operations.
    -- @return --- The color that drawing operations will use as a Color.
    GetDrawColor: function(): table

    --- Returns the [HUD icon](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/scripts/hud_textures.txt) TextureID of a texture with the specified name.
    --- You probably want to use Global.Material and surface.SetMaterial.
    -- @param name --- The name of the texture.
    -- @return texID --- The texture ID, for use with surface.SetTexture.
    GetHUDTexture: function(name: string): number

    --- Retrieves the position and ScissorRect information for the Panel that is currently being drawn.
    --- When using the surface library (and, by extension, the draw library) inside of the PANEL:Paint function, the origin (The on-screen position of `(0,0)`) is automatically shifted to the top-left corner of the panel to make it easier to draw the panel's contents.  Additionally, render.SetScissorRect is used to clip (or "mask") all drawn content to within the boundaries of the panel.  This function returns the information used by the surface library about the current panel's origin and ScissorRect.
    -- @return --- A table containing the position and ScissorRect boundaries for the Panel currently being drawn.
    --- For the table's format and available options see the Structures/PanelPaintState page.
    GetPanelPaintState: function(): table

    --- Returns the current color affecting text draw operations.
    -- @return --- The color that text drawing operations will use as a Color.
    GetTextColor: function(): table

    --- Returns the X and Y co-ordinate that has been set with surface.SetTextPos or changed by surface.DrawText.
    -- @return x --- The X integer co-ordinate.
    -- @return y --- The Y integer co-ordinate.
    GetTextPos: function(): number, number

    --- Returns the width and height (in pixels) of the given text with the font that has been set with surface.SetFont.
    --- **VALIDATE**: Does not take into account new lines, the returned height is for the entire font (as specified by the font), not maximum of individual characters.
    -- @param text --- The string to check the size of.
    -- @return --- Width of the provided text.
    -- @return --- Height of the provided text.
    GetTextSize: function(text: string): number, number

    --- Returns the texture id of the material with the given name/path, for use with surface.SetTexture.
    --- Opposite version of this function is surface.GetTextureNameByID.
    --- **NOTE**: This function will not work with .png or .jpg images. For that, see Global.Material. You will probably want to use it regardless.
    -- @param name/path --- Name or path of the texture. The path must be to a `.vmt` file (a material), not to `.vtf` (a texture)!
    -- @return --- The texture ID
    GetTextureID: function(name_or_path: string): number

    --- Returns name/path of texture by ID. Opposite version of this function is surface.GetTextureID.
    -- @param id --- ID of texture.
    -- @return --- Returns name/path of texture.
    GetTextureNameByID: function(id: number): string

    --- Returns the size of the texture with the associated texture ID.
    --- For `.png/.jpg` textures loaded with Global.Material you can use the `$realheight` and `$realwidth` material parameters (IMaterial:GetInt) to get the size of the image.
    -- @param textureID --- The texture ID, returned by surface.GetTextureID.
    -- @return --- The texture width.
    -- @return --- The texture height.
    GetTextureSize: function(textureID: number): number, number

    --- Play a sound file directly on the client (such as UI sounds, etc).
    --- **NOTE**: Valid sample rates: **11025 Hz, 22050 Hz and 44100 Hz**, otherwise you may see this kind of message:
    --- `Unsupported 32-bit wave file your_sound.wav` and
    --- `Invalid sample rate (48000) for sound 'your_sound.wav'`
    -- @param soundfile --- The path to the sound file.
    --- This should either be a sound script name (sound.Add) or a file path relative to the `sound/` folder. (Make note that it's not sound**s**)
    PlaySound: function(soundfile: string)

    --- @deprecated
    --- **DEPRECATED**: You should use Global.ScrH instead.
    --- Returns the height of the current client's screen.
    -- @return --- screenHeight
    ScreenHeight: function(): number

    --- @deprecated
    --- **DEPRECATED**: You should use Global.ScrW instead.
    --- Returns the width of the current client's screen.
    -- @return --- screenWidth
    ScreenWidth: function(): number

    --- Sets the alpha multiplier that will influence all upcoming drawing operations.
    --- See also render.SetBlend.
    -- @param multiplier --- The multiplier ranging from 0 to 1.
    SetAlphaMultiplier: function(multiplier: number)

    --- Set the color of any future shapes to be drawn, can be set by either using R, G, B, A as separate values or by a Color.
    --- **NOTE**: The alpha value may not work properly if you're using a material without `$vertexalpha`.
    --- **NOTE**: Due to post processing and gamma correction the color you set with this function may appear differently when rendered. This problem does not occur on materials drawn with surface.DrawTexturedRect.
    -- @param r --- The red value of color.
    -- @param g --- The green value of color.
    -- @param b --- The blue value of color.
    -- @param a --- The alpha value of color.
    SetDrawColor: function(r: number, g: number, b: number, a: number)

    --- Set the color of any future shapes to be drawn, can be set by either using R, G, B, A as separate values or by a Color.
    --- **NOTE**: The alpha value may not work properly if you're using a material without `$vertexalpha`.
    --- **NOTE**: Due to post processing and gamma correction the color you set with this function may appear differently when rendered. This problem does not occur on materials drawn with surface.DrawTexturedRect.
    -- @param color --- A Color object/table to read the color from. This is slower than providing four numbers. You could use Color:Unpack to address this. You should also cache your color objects if you wish to use them, for performance reasons.
    SetDrawColor: function(color: table)

    --- Set the current font to be used for text operations later.
    --- The fonts must first be created with surface.CreateFont or be one of the Default Fonts.
    -- @param fontName --- The name of the font to use.
    SetFont: function(fontName: string)

    --- Sets the material to be used in all upcoming draw operations using the surface library.
    --- Not to be confused with render.SetMaterial.
    --- If you need to unset the texture, use the draw.NoTexture convenience function.
    --- **WARNING**: Global.Material function calls are expensive to be done inside this function or inside rendering context, you should be caching the results of Global.Material calls
    -- @param material --- The material to be used.
    --- **NOTE**: When using render.PushRenderTarget or render.SetRenderTarget, the material should have the `$ignorez` flag set to make it visible. If the material is not used in 3D rendering, it is probably safe to add it with this code:
    --- ```lua
    --- material:SetInt( "$flags", bit.bor( material:GetInt( "$flags" ), 32768 ) )
    --- ```
    --- If using Global.Material, simply use the `ignorez` parameter.
    SetMaterial: function(material: GIMaterial)

    --- Set the color of any future text to be drawn, can be set by either using R, G, B, A as separate numbers or by providing a Color.
    -- @param r --- The red value of color.
    -- @param g --- The green value of color
    -- @param b --- The blue value of color
    -- @param a --- The alpha value of color
    SetTextColor: function(r: number, g: number, b: number, a: number)

    --- Set the color of any future text to be drawn, can be set by either using R, G, B, A as separate numbers or by providing a Color.
    -- @param color --- A Color object/table to read the color from. This is slower than providing four numbers. You could use Color:Unpack to address this. You should also cache your color objects if you wish to use them, for performance reasons.
    SetTextColor: function(color: table)

    --- Set the top-left position to draw any future text at.
    -- @param x --- The X integer co-ordinate.
    -- @param y --- The Y integer co-ordinate.
    SetTextPos: function(x: number, y: number)

    --- Sets the texture to be used in all upcoming draw operations using the surface library.
    --- This is a legacy method, and should probably not be used, see surface.SetMaterial and IMaterial for a better alternative.
    -- @param textureID --- The ID of the texture to draw with returned by surface.GetTextureID.
    SetTexture: function(textureID: number)
end


--- The system library provides functions that allow you to gather information about the system running the game, such as operating system, uptime and battery level.
global record system
    --- Returns the total uptime of the current application as reported by Steam.
    --- This will return a similar value to Global.SysTime.
    --- **NOTE**: This function does not work on Dedicated Servers and will instead return no value.
    -- @return --- Seconds of game uptime as an integer.
    AppTime: function(): number

    --- Returns the current battery power.
    -- @return --- 0-100 if a battery (laptop, UPS, etc) is present.
    --- Will instead return 255 if plugged in without a battery.
    BatteryPower: function(): number

    --- Flashes the window, turning the border to white briefly
    FlashWindow: function()

    --- Returns the country code of this computer, determined by the IP of the client. Uses the steamworks API function `SteamUtils()->GetIPCountry()`.
    --- **NOTE**: This function does not work on Dedicated Servers and will instead return no value.
    -- @return --- Two-letter country code, using [ISO 3166-1](http://en.wikipedia.org/wiki/ISO_3166-1_alpha-2) standard.
    GetCountry: function(): string

    --- Returns whether or not the game window has focus.
    --- **NOTE**: This function does not work on dedicated servers and will instead return no value.
    -- @return --- Whether or not the game window has focus.
    HasFocus: function(): boolean

    --- Returns whether the current OS is Linux.
    -- @return --- Whether or not the game is running on Linux.
    IsLinux: function(): boolean

    --- Returns whether the current OS is OSX.
    -- @return --- Whether or not the game is running on OSX.
    IsOSX: function(): boolean

    --- Returns whether the game is being run in a window or in fullscreen (you can change this by opening the menu, clicking 'Options', then clicking the 'Video' tab, and changing the Display Mode using the dropdown menu):
    -- @return --- Is the game running in a window?
    IsWindowed: function(): boolean

    --- Returns whether the current OS is Windows.
    -- @return --- Whether the system the game runs on is Windows or not.
    IsWindows: function(): boolean

    --- Returns the synchronized Steam time. This is the number of seconds since the [Unix epoch](http://en.wikipedia.org/wiki/Unix_time).
    --- **NOTE**: This function does not work on Dedicated Servers and will instead return no value.
    -- @return --- Current Steam-synchronized Unix time.
    SteamTime: function(): number

    --- Returns the amount of seconds since the Steam user last moved their mouse.
    --- This is a direct binding to ISteamUtils->GetSecondsSinceComputerActive, and is most likely related to Steam's automatic "Away" online status.
    --- **NOTE**: This function does not work on Dedicated Servers and will instead return no value.
    -- @return --- The amount of seconds since the Steam user last moved their mouse.
    UpTime: function(): number
end


--- The table **type** is an object that can store multiple values.
--- The table **library** is a standard Lua library which provides functions to manipulate tables. In Garry's Mod there are several extra useful functions added to this library.
--- This category lists the functions available in the table `library`.
global record table
    --- Adds all values from `source` table into the `target` table. This is most useful for sequential tables, not "dictionary" or "map" tables. See table.Merge if you want to merge 2 tables into one.
    --- See table.insert for a function that adds a single value, and table.Inherit for a function that inherits keys from one table to another.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L116-L127)
    -- @param target --- The table to insert the new values into.
    -- @param source --- The table to retrieve the values from.
    -- @return --- The target table.
    Add: function(target: table, source: table): table

    --- Changes all keys to sequential integers. This creates a new table object and does not affect the original.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L499-L512)
    -- @param table --- The original table to modify.
    -- @param saveKeys --- Save the keys within each member table. This will insert a new field `__key` into each value, and should not be used if the table contains non-table values.
    -- @return --- Table with integer keys.
    ClearKeys: function(table: table, saveKeys: boolean): table

    --- Collapses a table with keyvalue structure
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L475-L493)
    -- @param input --- Input table
    -- @return --- Output table
    CollapseKeyValue: function(input: table): table

    --- Creates a deep copy and returns that copy.
    --- **WARNING**: This function is very slow! If you know the table structure, it is better to write your own copying mechanism
    --- **WARNING**: This function does NOT copy userdata, such as Vectors and Angles!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L22-L47)
    -- @param originalTable --- The table to be copied.
    -- @return --- A deep copy of the original table
    Copy: function(originalTable: table): table

    --- Empties the target table, and merges all values from the source table into it.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L71-L79)
    -- @param source --- The table to copy from.
    -- @param target --- The table to write to.
    CopyFromTo: function(source: table, target: table)

    --- Counts the amount of keys in a table. This should only be used when a table is not numerically and sequentially indexed. For those tables, consider the length (**#**) operator.
    --- If you only want to test if the table is empty or not, use table.IsEmpty instead as it is a lot faster.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L158-L166)
    -- @param tbl --- The table to count the keys of.
    -- @return --- The number of keyvalue pairs. This includes non-numeric and non-sequential keys, unlike the length (**#**) operator.
    Count: function(tbl: table): number

    --- Converts a table that has been sanitised with table.Sanitise back to its original form
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L344-L391)
    -- @param tbl --- Table to be de-sanitised
    -- @return --- De-sanitised table
    DeSanitise: function(tbl: table): table

    --- Removes all values from a table. If your table is not a metatable, it is almost always better to use `tab = {}` to preserve performance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L53-L57)
    -- @param tbl --- The table to empty.
    Empty: function(tbl: table)

    --- @deprecated
    --- **DEPRECATED**: Instead, iterate the table using ipairs or increment from the previous index using Global.next. Non-numerically indexed tables are not ordered.
    --- Returns the value positioned after the supplied value in a table. If it isn't found then the first element in the table is returned
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L659-L667)
    -- @param tbl --- Table to search
    -- @param value --- Value to return element after
    -- @return --- Found element
    FindNext: function(tbl: table, value: any): any

    --- @deprecated
    --- **DEPRECATED**: Instead, iterate your table with ipairs, storing the previous value and checking for the target. Non-numerically indexed tables are not ordered.
    --- Returns the value positioned before the supplied value in a table. If it isn't found then the last element in the table is returned
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L669-L679)
    -- @param tbl --- Table to search
    -- @param value --- Value to return element before
    -- @return --- Found element
    FindPrev: function(tbl: table, value: any): any

    --- Flips key-value pairs of each element within a table, so that each value becomes the key, and each key becomes the value.
    --- **WARNING**: Take care when using this function, as a Lua table cannot contain multiple instances of the same key. As such, data loss is possible when using this function on tables with duplicate values.
    --- ```
    --- local test = { test = 1, test2 = 1 }
    --- local f = table.Flip( test )
    --- PrintTable( f )
    --- -- Outputs "1	=	test2"
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L766-L776)
    -- @param input --- The table to flip items of.
    -- @return --- The flipped table.
    Flip: function(input: table): table

    --- Inserts a value in to the given table even if the table is non-existent
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L393-L401)
    -- @param tab --- Table to insert value in to
    -- @param value --- Value to insert
    -- @return --- The supplied or created table
    ForceInsert: function(tab: table, value: any): table

    --- @deprecated
    --- **DEPRECATED**: Instead, expect the first key to be 1.
    --- Non-numerically indexed tables are not ordered and do not have a first key.
    --- Returns the first key found in the given table
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L636-L642)
    -- @param tab --- Table to retrieve key from
    -- @return --- Key
    GetFirstKey: function(tab: table): any

    --- @deprecated
    --- **DEPRECATED**: Instead, index the table with a key of 1.
    --- Non-numerically indexed tables are not ordered and do not have a first key.
    --- Returns the first value found in the given table
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L644-L647)
    -- @param tab --- Table to retrieve value from
    -- @return --- Value
    GetFirstValue: function(tab: table): any

    --- Returns all keys of a table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L755-L767)
    -- @param tabl --- The table to get keys of
    -- @return --- Table of keys
    GetKeys: function(tabl: table): table

    --- @deprecated
    --- **DEPRECATED**: Instead, use the result of the length (#) operator, ensuring it is not zero. Non-numerically indexed tables are not ordered and do not have a last key.
    --- Returns the last key found in the given table
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L649-L652)
    -- @param tab --- Table to retrieve key from
    -- @return --- Key
    GetLastKey: function(tab: table): any

    --- @deprecated
    --- **DEPRECATED**: Instead, index the table with the result of the length (#) operator, ensuring it is not zero. Non-numerically indexed tables are not ordered and do not have a last key.
    --- Returns the last value found in the given table
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L651-L654)
    -- @param tab --- Table to retrieve value from
    -- @return --- Value
    GetLastValue: function(tab: table): any

    --- Returns a key of the supplied table with the highest number value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L678-L692)
    -- @param inputTable --- The table to search in.
    -- @return --- winningKey
    GetWinningKey: function(inputTable: table): any

    --- Checks if a table has a value.
    --- **WARNING**: This function is **very inefficient for large tables** (O(n)) and should probably not be called in things that run each frame. Instead, consider a table structure such as example 2 below. Also see: Tables: Bad Habits
    --- **NOTE**: For optimization, functions that look for a value by sorting the table should never be needed if you work on a table that you built yourself.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L105-L110)
    -- @param tbl --- Table to check
    -- @param value --- Value to search for
    -- @return --- Returns true if the table has that value, false otherwise
    HasValue: function(tbl: table, value: any): boolean

    --- Copies any missing data from `base` to `target`, and sets the `target`'s `BaseClass` member to the `base` table's pointer.
    --- See table.Merge, which overrides existing values and doesn't add a BaseClass member.
    --- See also table.Add, which simply adds values of one table to another.
    --- **BUG**: [Sub-tables aren't inherited. The target's table value will take priority.](https://github.com/Facepunch/garrysmod/pull/1304
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L10-L20)
    -- @param target --- Table to copy data to
    -- @param base --- Table to copy data from
    -- @return --- Target
    Inherit: function(target: table, base: table): table

    --- Returns whether or not the given table is empty.
    --- This works on both sequential and non-sequential tables, and is a lot faster for non-sequential tables than `table.Count(tbl) == 0`.
    --- For sequential tables it is better to use `tab[1] == nil`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L63-L65)
    -- @param tab --- Table to check.
    -- @return --- Is empty?
    IsEmpty: function(tab: table): boolean

    --- Returns whether or not the table's keys are sequential
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L196-L203)
    -- @param tab --- Table to check
    -- @return --- Is sequential
    IsSequential: function(tab: table): boolean

    --- Returns the first key found to be containing the supplied value
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L694-L698)
    -- @param tab --- Table to search
    -- @param value --- Value to search for
    -- @return --- Key
    KeyFromValue: function(tab: table, value: any): any

    --- Returns a table of keys containing the supplied value
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L715-L621)
    -- @param tab --- Table to search
    -- @param value --- Value to search for
    -- @return --- Keys
    KeysFromValue: function(tab: table, value: any): table

    --- Returns a copy of the input table with all string keys converted to be lowercase recursively
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L445-L469)
    -- @param tbl --- Table to convert
    -- @return --- New table
    LowerKeyNames: function(tbl: table): table

    --- Returns an array of values of given with given key from each table of given table.
    --- See also table.KeysFromValue.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L723-L729)
    -- @param inputTable --- The table to search in.
    -- @param keyName --- The key to lookup.
    -- @return --- A list of found values, or an empty table.
    MemberValuesFromKey: function(inputTable: table, keyName: any): table

    --- **NOTE**: This function can cause a stack overflow under certain circumstances.
    --- Recursively merges the key-value pairs of the `source` table with the key-value pairs in the `destination` table.
    --- See table.Inherit, which doesn't override existing values.
    --- See also table.Add, which simply adds values of one table to another.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L85-L99)
    -- @param destination --- The table you want the source table to merge with.
    -- @param source --- The table you want to merge with the destination table.
    -- @param forceOverride --- If `true`, does not recursively merge sub-tables, and simply replaces them.
    -- @return --- Destination table
    Merge: function(destination: table, source: table, forceOverride: boolean): table

    --- Packs a set of items into a table and returns the new table. It is meant as an alternative implementation of `table.pack` from newer versions of Lua.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L2-L4)
    -- @param items --- The items to pack into a table.
    -- @return --- A table containing the `items`.
    -- @return --- The amount of items that were added to the table.
    Pack: function(...: any): table, number

    --- Returns a random value from the supplied table.
    --- **WARNING**: This function iterates over the given table **twice**, therefore with sequential tables you should instead use following:
    --- ```
    --- mytable[ math.random( #mytable ) ]
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L166-L177)
    -- @param haystack --- The table to choose from.
    -- @return --- A random value from the table.
    -- @return --- The key associated with the random value.
    Random: function(haystack: table): any, any

    --- Removes the first instance of a given value from the specified table with table.remove, then returns the key that the value was found at.
    --- **WARNING**: Avoid usage of this function. It does not remove all instances of given value in the table, only the first found, and it does not work with non sequential tables!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L700-L713)
    -- @param tbl --- The table that will be searched.
    -- @param val --- The value to find within the table.
    -- @return --- The key at which the value was found, or false if the value was not found.
    RemoveByValue: function(tbl: table, val: any): any

    --- Returns a reversed copy of a sequential table. Any non-sequential and non-numeric keyvalue pairs will not be copied.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L731-L742)
    -- @param tbl --- Table to reverse.
    -- @return --- A reversed copy of the table.
    Reverse: function(tbl: table): table

    --- Converts Vectors, Angles and booleans to be able to be converted to and from key-values via util.TableToKeyValues.
    --- table.DeSanitise performs the opposite transformation.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L284-L338)
    -- @param tab --- Table to sanitise
    -- @return --- Sanitised table
    Sanitise: function(tab: table): table

    --- Performs an inline [Fisher-Yates shuffle](https://en.wikipedia.org/wiki/Fisher%E2%80%93Yates_shuffle) on the table in `O(n)` time
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L183-L189)
    -- @param target --- The table to shuffle.
    Shuffle: function(target: table)

    --- Returns a list of keys sorted based on values of those keys.
    --- For normal sorting see table.sort.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L141-L154)
    -- @param tab --- Table to sort. All values of this table must be of same type.
    -- @param descending --- Should the order be descending?
    -- @return --- A table of keys sorted by values from supplied table.
    SortByKey: function(tab: table, descending: boolean): table

    --- Sorts a table by a named member.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L407-L439)
    -- @param tab --- Table to sort.
    -- @param memberKey --- The key used to identify the member.
    -- @param ascending --- Whether or not the order should be ascending.
    SortByMember: function(tab: table, memberKey: any, ascending: boolean)

    --- Sorts a table in reverse order from table.sort.
    --- **NOTE**: This function modifies the table you give to it. Like table.sort, it does not return anything.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L133-L135)
    -- @param tbl --- The table to sort in descending order.
    SortDesc: function(tbl: table)

    --- Converts a table into a string
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L271-L278)
    -- @param tbl --- The table to iterate over.
    -- @param displayName --- Optional. A name for the table.
    -- @param niceFormatting --- Adds new lines and tabs to the string.
    -- @return --- The table formatted as a string.
    ToString: function(tbl: table, displayName: string, niceFormatting: boolean): string

    --- Concatenates the contents of a table to a string.
    -- @param tbl --- The table to concatenate.
    -- @param concatenator --- A separator to insert between strings
    -- @param startPos --- The key to start at
    -- @param endPos --- The key to end at
    -- @return --- Concatenated values
    concat: function(tbl: table, concatenator: string, startPos: number, endPos: number): string

    --- @deprecated
    --- **DEPRECATED**: This was deprecated in Lua 5.1 and removed in 5.2. You should use Global.pairs instead.
    ---  Iterates for each key-value pair in the table, calling the function with the key and value of the pair. If the function returns anything, the loop is broken.
    --- The GLua interpretation of this is table.ForEach.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L747-L753)
    -- @param tbl --- The table to iterate over.
    -- @param callback --- The function to run for each key and value.
    --- <callback>
    --- <arg name="key" type="any">The key of a key-value pair for this iteration.</arg>
    --- <arg name="val" type="any">The value of a key-value pair for this iteration.</arg>
    --- </callback>
    foreach: function(tbl: table, callback: function)

    --- @deprecated
    --- **DEPRECATED**: This was deprecated in Lua 5.1 and removed in 5.2. You should use Global.ipairs() instead.
    ---  Iterates for each numeric index in the table in order.
    --- This is inherited from the original Lua implementation and is deprecated in Lua as of 5.1; see [here](http://lua-users.org/wiki/TableLibraryTutorial). You should use Global.ipairs() instead.
    -- @param table --- The table to iterate over.
    -- @param func --- The function to run for each index.
    foreachi: function(table: table, func: function)

    --- @deprecated
    --- **DEPRECATED**: This function was deprecated in Lua 5.1 and is removed in 5.2. Use the length (#) operator instead.
    ---  Returns the length of the table.
    -- @param tbl --- The table to check.
    -- @return --- Sequential length.
    getn: function(tbl: table): number

    --- Inserts a value into a table at the end of the table or at the given position.
    --- **NOTE**: This function does not call the `__newindex` [metamethod](Metamethods).
    -- @param tbl --- The table to insert the variable into.
    -- @param position --- The position in the table to insert the variable. If the third argument is nil this argument becomes the value to insert at the end of given table.
    -- @param value --- The variable to insert into the table.
    -- @return --- The index the object was placed at.
    insert: function(tbl: table, position: number, value: any): number

    --- Returns the highest numerical key.
    -- @param tbl --- The table to search.
    -- @return --- The highest numerical key.
    maxn: function(tbl: table): number

    --- Moves elements from one part of a table to another part a given table. This is similar to assigning elements from the source table to the destination table in multiple assignments.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L781-L802)
    -- @param sourceTbl --- The source table from which the elements are to be moved.
    -- @param from --- The start index of the source range from which the elements are to be moved.
    -- @param to --- The end index of the source range until which the elements are to be moved.
    -- @param dest --- The index within the destination table where the moved elements should be inserted.
    -- @param destTbl --- The destination table to which the elements are to be moved. By default, this is the same as the source table.
    -- @return --- The modified destination table.
    move: function(sourceTbl: table, from: number, to: number, dest: number, destTbl: table): table

    --- Removes a value from a table and shifts any other values down to fill the gap.
    --- **NOTE**: Does nothing if index is less than 1 or greater than `#tbl`
    -- @param tbl --- The table to remove the value from.
    -- @param index --- The index of the value to remove.
    -- @return --- The value that was removed.
    remove: function(tbl: table, index: number): any

    --- Sorts a sequential table either ascending or by the given sort function.
    --- **NOTE**: This function modifies the table you give to it and internally uses the [quick sort algorithm](http://www.lua.org/source/5.2/ltablib.c.html#sort).
    -- @param tbl --- The table to sort.
    -- @param sorter --- If specified, the sorting function.
    --- <callback>
    --- <arg name="a" type="any">Item A to test.</arg>
    --- <arg name="b" type="any">Item B to test.</arg>
    --- <ret name="result" type="boolean">Result of the comparison. Return true in this function if you want the first parameter to come first in the sorted array.</ret>
    --- </callback>
    sort: function(tbl: table, sorter: function)
end


--- The team library gives you access to the team system built into the Source engine, and allows you to create custom teams and get information about them.
global record team
    --- Increases the score of the given team
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L184-L188)
    -- @param index --- Index of the team
    -- @param increment --- Amount to increase the team's score by
    AddScore: function(index: number, increment: number)

    --- Returns the team index of the team with the least players. Falls back to TEAM_UNASSIGNED
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L190-L211)
    -- @return --- Team index
    BestAutoJoinTeam: function(): number

    --- Returns the real table consisting of information on every defined team
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L34-L38)
    -- @return --- Team info
    GetAllTeams: function(): table

    --- Returns the selectable classes for the given team. This can be added to with team.SetClass
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L98-L103)
    -- @param index --- Index of the team
    -- @return --- Selectable classes
    GetClass: function(index: number): table

    --- Returns the team's color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L171-L176)
    -- @param teamIndex --- The team index.
    -- @return --- The team's color as a Color.
    GetColor: function(teamIndex: number): table

    --- Returns the name of the team.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L155-L160)
    -- @param teamIndex --- The team index.
    -- @return --- The team name. If the team is not defined, returns an empty string.
    GetName: function(teamIndex: number): string

    --- Returns a table with all player of the specified team.
    --- **NOTE**: This function returns a sequential table, meaning it should be looped with Global.ipairs instead of Global.pairs for efficiency reasons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L135-L147)
    -- @param teamIndex --- The team index.
    -- @return --- A sequential table of Players that belong to the requested team.
    GetPlayers: function(teamIndex: number): table

    --- Returns the score of the team.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L149-L153)
    -- @param teamIndex --- The team index.
    -- @return --- score
    GetScore: function(teamIndex: number): number

    --- Returns a table of valid spawnpoint classes the team can use. These are set with team.SetSpawnPoint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L54-L59)
    -- @param index --- Index of the team
    -- @return --- Valid spawnpoint classes
    GetSpawnPoint: function(index: number): table

    --- Returns a table of valid spawnpoint entities the team can use. These are set with  team.SetSpawnPoint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L61-L78)
    -- @param index --- Index of the team
    -- @return --- Valid spawnpoint entities
    GetSpawnPoints: function(index: number): table

    --- Returns if a team is joinable or not. This is set in team.SetUp.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L47-L52)
    -- @param index --- The index of the team.
    -- @return --- True if the team is joinable. False otherwise.
    Joinable: function(index: number): boolean

    --- Returns the amount of players in a team.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L129-L133)
    -- @param teamIndex --- The team index.
    -- @return --- playerCount
    NumPlayers: function(teamIndex: number): number

    --- Sets valid classes for use by a team. Classes can be created using player_manager.RegisterClass
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L89-L96)
    -- @param index --- Index of the team
    -- @param classes --- A class ID or table of class IDs
    SetClass: function(index: number, classes: any)

    --- Sets the team's color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L162-L169)
    -- @param teamIndex --- The team index.
    -- @param color --- The team's new color as a Color.
    SetColor: function(teamIndex: number, color: table)

    --- Sets the score of the given team
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L178-L182)
    -- @param index --- Index of the team
    -- @param score --- The team's new score
    SetScore: function(index: number, score: number)

    --- Sets valid spawnpoint classes for use by a team.
    --- **NOTE**: GM.TeamBased must be set to true for this to work
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L80-L87)
    -- @param index --- Index of the team
    -- @param classes --- A spawnpoint classname or table of spawnpoint classnames
    SetSpawnPoint: function(index: number, classes: any)

    --- Creates a new team. See GM:CreateTeams for the hook to call this in.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L25-L31)
    -- @param teamIndex --- The team index.
    -- @param teamName --- The team name.
    -- @param teamColor --- The team color. Uses the Color.
    -- @param isJoinable --- Whether the team is joinable or not.
    SetUp: function(teamIndex: number, teamName: string, teamColor: table, isJoinable: boolean)

    --- Returns the total number of deaths of all players in the team.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L105-L115)
    -- @param index --- The team index.
    -- @return --- Total deaths in team.
    TotalDeaths: function(index: number): number

    --- Get's the total frags in a team.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L117-L127)
    -- @param Entity or number --- Entity or number.
    -- @return --- index
    TotalFrags: function(Entity_or_number: GEntity): number

    --- Returns true if the given team index is valid
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/team.lua#L40-L45)
    -- @param index --- Index of the team
    -- @return --- Is valid
    Valid: function(index: number): boolean
end


--- The timer library is a very useful set of functions which allow you to run a function periodically or after a given delay.
global record timer
    --- Adjusts a previously created (timer.Create) timer with the given identifier.
    -- @param identifier --- Identifier of the timer to adjust.
    -- @param delay --- The delay interval in seconds. **Must be specified.**
    -- @param repetitions --- Repetitions. Use `0` for infinite or `nil` to keep previous value.
    -- @param func --- The new function. Use `nil` to keep previous value.
    -- @return --- `true` if succeeded.
    Adjust: function(identifier: any, delay: number, repetitions: number, func: function): boolean

    --- @deprecated
    --- **DEPRECATED**: If you want to check if whether or not a timer exists, use timer.Exists.
    ---  This function does nothing.
    Check: function()

    --- Creates a new timer that will repeat its function given amount of times.
    --- This function also requires the timer to be named, which allows you to control it after it was created via the timer.
    --- For a simple one-time timer with no identifiers, see timer.Simple.
    --- **WARNING**: Timers use Global.CurTime internally. Due to this, they won't advance while the client is timing out from the server or on an empty dedicated server due to hibernation. (unless `sv_hibernate_think` is set to `1` or `delay` is set to `0` ).
    -- @param identifier --- Identifier of the timer to create. Must be unique. If a timer already exists with the same identifier, that timer will be updated to the new settings and reset.
    -- @param delay --- The delay interval in seconds. If the delay is too small, the timer will fire on the next GM:Tick.
    -- @param repetitions --- The number of times to repeat the timer. Enter `0` or any value below `0` for infinite repetitions.
    -- @param func --- Function called when timer has finished the countdown.
    Create: function(identifier: string, delay: number, repetitions: number, func: function)

    --- @deprecated
    --- **DEPRECATED**: You should be using timer.Remove instead.
    ---  Stops and destroys the given timer. Alias of timer.Remove.
    -- @param identifier --- Identifier of the timer to destroy.
    Destroy: function(identifier: string)

    --- Returns whenever the given timer exists or not.
    --- For debugging purposes you can use the following commands:
    --- * `lua_dumptimers_cl`
    --- * `lua_dumptimers_sv`
    --- * `lua_dumptimers_menu`
    --- These will list all active timers in each realm.
    -- @param identifier --- Identifier of the timer.
    -- @return --- Returns true if the timer exists, false if it doesn't
    Exists: function(identifier: string): boolean

    --- Pauses the given timer.
    -- @param identifier --- Identifier of the timer.
    -- @return --- false if the timer didn't exist or was already paused, true otherwise.
    Pause: function(identifier: any): boolean

    --- Stops and removes a timer created by timer.Create.
    --- **WARNING**: The timers are removed in the next frame! Keep this in mind when storing identifiers in variables.
    -- @param identifier --- Identifier of the timer to remove.
    Remove: function(identifier: string)

    --- Returns amount of repetitions/executions left before the timer destroys itself.
    -- @param identifier --- Identifier of the timer.
    -- @return --- The amount of executions left.
    RepsLeft: function(identifier: any): number

    --- Creates a simple timer that runs the given function after a specified delay.
    --- For a more advanced version that you can control after creation, see timer.Create.
    --- **WARNING**: Timers use Global.CurTime internally. Due to this, they won't advance while the client is timing out from the server or on an empty dedicated server due to hibernation. (unless `sv_hibernate_think` is set to `1`).
    --- **WARNING**: A previous message on this page stated that a delay of 0 would run the function on the next tick. This was partially an invalid assumption, and the true behavior is dependent on where `timer.Simple(0, func)` is called relative to `GarrysMod::Lua::Libraries::Timer::DoSimpleTimers`.
    --- - If called *before* `DoSimpleTimers`, the callback will be executed on the same frame.
    --- - If called *during* `DoSimpleTimers`, the callback will be executed on the same frame. **Note that calling timer.Simple(0, func) recursively (ie. a function that calls **`timer.simple(0, itself)`**) can lead to a hang!**
    --- - If called *after* `DoSimpleTimers`, the callback will be executed on the next frame.
    --- For more information on hook execution order, see Lua Hooks Order.
    --- As of a commit on [2026.1.5](https://commits.facepunch.com/574654), simple timers are queued to the next frame, but as it is a recent change, it might only be available on the Dev Branch right now.
    -- @param delay --- How long until the function should be ran (in seconds). A value of `0` differs in behavior, depending on where you're calling this function.
    -- @param func --- The function to run after the specified delay.
    Simple: function(delay: number, func: function)

    --- Restarts the given timer.
    --- **NOTE**: Timers use Global.CurTime for timing.
    --- **WARNING**: Timers won't advance while the client is timing out from the server.
    -- @param identifier --- Identifier of the timer.
    -- @return --- true if the timer exists, false if it doesn't.
    Start: function(identifier: any): boolean

    --- Stops the given timer and rewinds it.
    -- @param identifier --- Identifier of the timer.
    -- @return --- false if the timer didn't exist or was already stopped, true otherwise.
    Stop: function(identifier: any): boolean

    --- Returns amount of time left (in seconds) before the timer executes its function.
    --- **NOTE**: If the timer is paused, the amount will be negative.
    -- @param identifier --- Identifier of the timer.
    -- @return --- The amount of time left (in seconds).
    TimeLeft: function(identifier: any): number

    --- Runs either timer.Pause or timer.UnPause based on the timer's current status.
    -- @param identifier --- Identifier of the timer.
    -- @return --- status of the timer.
    Toggle: function(identifier: any): boolean

    --- Unpauses the timer.
    -- @param identifier --- Identifier of the timer.
    -- @return --- false if the timer didn't exist or was already running, true otherwise.
    UnPause: function(identifier: any): boolean
end


--- @deprecated
--- **DEPRECATED**: You should be using the net library instead
--- The umsg (user message) library was previously the most common way of sending information from the server to the client.
--- **WARNING**: Usermessages have a limit of only 256 bytes!
global record umsg
    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes an angle to the usermessage.
    -- @param angle --- The angle to be sent.
    Angle: function(angle: GAngle)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a bool to the usermessage.
    -- @param bool --- The bool to be sent.
    Bool: function(bool: boolean)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a signed char to the usermessage.
    -- @param char --- The char to be sent.
    Char: function(char: number)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Dispatches the usermessage to the client(s).
    End: function()

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes an entity object to the usermessage.
    -- @param entity --- The entity to be sent.
    Entity: function(entity: GEntity)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a float to the usermessage.
    -- @param float --- The float to be sent.
    Float: function(float: number)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a signed int (32 bit) to the usermessage.
    -- @param int --- The int to be sent.
    Long: function(int: number)

    --- @deprecated
    --- **DEPRECATED**: Inferior version of util.AddNetworkString
    --- The string specified will be networked to the client and receive a identifying number, which will be sent instead of the string to optimize networking.
    -- @param string --- The string to be pooled.
    PoolString: function(string: string)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a signed short (16 bit) to the usermessage.
    -- @param short --- The short to be sent.
    Short: function(short: number)

    --- @deprecated
    --- **DEPRECATED**: You should be using net instead
    --- Starts a new usermessage.
    --- **WARNING**: Usermessages have a limit of only 256 bytes!
    -- @param name --- The name of the message to be sent.
    -- @param filter --- If passed a player object, it will only be sent to the player, if passed a CRecipientFilter of players, it will be sent to all specified players, if passed `nil` (or another invalid value), the message will be sent to all players.
    Start: function(name: string, filter: GPlayer)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a null terminated string to the usermessage.
    -- @param string --- The string to be sent.
    String: function(string: string)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a Vector to the usermessage.
    -- @param vector --- The vector to be sent.
    Vector: function(vector: GVector)

    --- @deprecated
    --- **DEPRECATED**: You should be using the net instead
    --- Writes a vector normal to the usermessage.
    -- @param normal --- The vector normal to be sent.
    VectorNormal: function(normal: GVector)
end


--- The undo library allows you to add custom entities to the undo list, allowing users to "undo" their creation with their undo (default: ``) key.
global record undo
    --- Adds an entity to the current undo block
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L237-L244)
    -- @param ent --- The entity to add
    AddEntity: function(ent: GEntity)

    --- Adds a function to call when the current undo block is undone. Note that if an undo has a function, the player will always be notified when this undo is performed, even if the entity it is meant to undo no longer exists.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L249-L256)
    -- @param func --- The function to call.
    --- <callback>
    --- <arg type="table" name="undo">See Undo Structure.</arg>
    --- <arg type="vararg" name="...">What was passed after the function callback argument.</arg>
    --- <ret type="boolean" name="result" default="nil">Returning `false` will mark execution of this function as "failed", meaning that the undo might be skipped if no other entities are removed by it. This is useful when for example an entity you want to access is removed therefore there's nothing to do.</ret>
    --- </callback>
    -- @param arguments --- Arguments to pass to the function (after the undo info table)
    AddFunction: function(func: function, ...: any)

    --- Begins a new undo entry
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L213-L221)
    -- @param name --- Name of the undo message to show to players
    Create: function(name: string)

    --- Processes an undo block (in table form). This is used internally by the undo manager when a player presses Z.
    --- You should use `gmod_undo` or `gmod_undonum *num*` console commands instead of calling this function directly.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L368-L414)
    -- @param tab --- The undo block to process as an Structures/Undo
    -- @return --- Number of removed entities
    Do_Undo: function(tab: S_Undo): number

    --- Completes an undo entry, and registers it with the player's client
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L329-L363)
    -- @param NiceText --- Text that appears in the player's undo history. If unset, is set to undo's name.
    Finish: function(NiceText: string)

    --- Serverside, returns a table containing all undo blocks of all players. Clientside, returns a table of the local player's undo blocks.
    --- **NOTE**: Serverside, this table's keys use Player:UniqueID to store a player's undo blocks.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L187-L189)
    -- @return --- The undo table.
    GetTable: function(): {S_Undo}

    --- **INTERNAL**:
    --- Makes the UI dirty - it will re-create the controls the next time it is viewed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L116-L120)
    MakeUIDirty: function()

    --- Replaces any instance of the "from" reference with the "to" reference, in any existing undo block.
    --- You very likely want to call cleanup.ReplaceEntity with the same entities as well.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L261-L282)
    -- @param from --- The old entity
    -- @param to --- The new entity to replace the old one. Can also be a `NULL` to remove the entity from the undo system.
    -- @return --- Whether the entity was replaced
    ReplaceEntity: function(from: GEntity, to: GEntity): boolean

    --- Sets a custom undo text for the current undo block
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L226-L232)
    -- @param customText --- The text to display when the undo block is undone
    SetCustomUndoText: function(customText: string)

    --- Sets the player which the current undo block belongs to
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L288-L295)
    -- @param ply --- The player responsible for undoing the block
    SetPlayer: function(ply: GPlayer)

    --- **INTERNAL**:
    --- Adds a hook (CPanelPaint) to the control panel paint function so we can determine when it is being drawn.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/undo.lua#L149-L160)
    SetupUI: function()
end


--- @deprecated
--- **DEPRECATED**: You should be using the net instead
--- The usermessage library is used to receive user messages from the server on the client.
--- **WARNING**: Usermessages have a limit of only 256 bytes!
global record usermessage
    --- @deprecated
    --- **DEPRECATED**: You should be using net instead
    --- Returns a table of every usermessage hook
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/usermessage.lua#L53-L57)
    -- @return --- User message hooks
    GetTable: function(): table

    --- @deprecated
    --- **DEPRECATED**: You should be using net instead
    --- Sets a hook for the specified to be called when a usermessage with the specified name arrives.
    --- **WARNING**: Usermessages have a limit of only 256 bytes!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/usermessage.lua#L63-L70)
    -- @param name --- The message name to hook to.
    -- @param callback --- The function to be called if the specified message was received.
    --- <callback>
    --- <arg type="bf_read" name="msg">The object to read your custom data from.</arg>
    --- <arg type="vararg" name="preArgs"></arg>
    --- </callback>
    -- @param preArgs --- Arguments that are passed to the callback function when the hook is called.
    Hook: function(name: string, callback: function, ...: any)

    --- **INTERNAL**:
    --- Called by the engine when a usermessage arrives, this method calls the hook function specified by usermessage.Hook if any.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/usermessage.lua#L76-L87)
    -- @param name --- The message name.
    -- @param msg --- The message.
    IncomingMessage: function(name: string, msg: Gbf_read)
end


--- The utf8 library provides basic support for UTF-8 encoding. This library does not provide any support for Unicode other than the handling of the encoding. Any operation that needs the meaning of a character, such as character classification, is outside its scope.
--- Unless stated otherwise, all functions that expect a byte position as a parameter assume that the given position is either the start of a byte sequence or one plus the length of the subject string. As in the string library, negative indices count from the end of the string.
global record utf8
    --- A UTF-8 compatible version of string.GetChar.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L352-L362)
    -- @param str --- The string that you will be searching with the supplied index.
    -- @param index --- The index's value of the string to be returned.
    -- @return --- str
    GetChar: function(str: string, index: number): string

    --- Receives zero or more integers, converts each one to its corresponding UTF-8 byte sequence and returns a string with the concatenation of all these sequences.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L95-L144)
    -- @param codepoints --- Unicode code points to be converted in to a UTF-8 string.
    -- @return --- UTF-8 string generated from given arguments.
    char: function(...: any): string

    --- This is NOT a function, it's a pattern (a string, not a function) which matches exactly one UTF-8 byte sequence, assuming that the subject is a valid UTF-8 string.
    charpattern: string

    --- Returns the codepoints (as numbers) from all characters in the given string that start between byte position startPos and endPos. It raises an error if it meets any invalid byte sequence. This functions similarly to string.byte.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L175-L200)
    -- @param string --- The string that you will get the code(s) from.
    -- @param startPos --- The starting byte of the string to get the codepoint of.
    -- @param endPos --- The ending byte of the string to get the codepoint of.
    -- @return --- The codepoint number(s).
    codepoint: function(string: string, startPos: number, endPos: number): any...

    --- Returns an iterator (like string.gmatch) which returns both the position and codepoint of each utf8 character in the string. It raises an error if it meets any invalid byte sequence.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L146-L173)
    -- @param string --- The string that you will get the codes from.
    -- @return --- The iterator (to be used in a for loop).
    codes: function(string: string): function

    --- Forces a string to contain only valid UTF-8 data. Invalid sequences are replaced with U+FFFD (the Unicode replacement character).
    --- This is a lazy way for users to ensure a string contains only valid UTF-8 data.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L303-L338)
    -- @param string --- The string that will become a valid UTF-8 string.
    -- @return --- The UTF-8 string.
    force: function(string: string): string

    --- Returns the number of UTF-8 sequences in the given string between positions startPos and endPos (both inclusive). If it finds any invalid UTF-8 byte sequence, returns false as well as the position of the first invalid byte.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L202-L229)
    -- @param string --- The string to calculate the length of.
    -- @param startPos --- The starting position to get the length from.
    -- @param endPos --- The ending position to get the length from.
    -- @return --- The number of UTF-8 characters in the string. If there are invalid bytes, this will be false.
    -- @return --- The position of the first invalid byte. If there were no invalid bytes, this will be nil.
    len: function(string: string, startPos: number, endPos: number): number, number

    --- Returns the byte-index of the n'th UTF-8-character after the given startPos (nil if none). startPos defaults to 1 when n is positive and -1 when n is negative. If n is zero, this function instead returns the byte-index of the UTF-8-character startPos lies within.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L231-L301)
    -- @param string --- The string that you will get the byte position from.
    -- @param n --- The position to get the beginning byte position from.
    -- @param startPos --- The offset for n.
    -- @return --- Starting byte-index of the given position.
    offset: function(string: string, n: number, startPos: number): number

    --- A UTF-8 compatible version of string.sub.
    --- **WARNING**: Avoid using this function on large strings every tick/frame, as it may cause lags.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/utf8.lua#L364-L377)
    -- @param string --- The string you'll take a sub-string out of.
    -- @param StartPos --- The position of the first character that will be included in the sub-string.
    -- @param EndPos --- The position of the last character to be included in the sub-string. It can be negative to count from the end.
    -- @return --- The substring.
    sub: function(string: string, StartPos: number, EndPos: number): string
end


--- `util.worldpicker` is for picking an entity in the world while [GUI](gui) is open.
global record util
    --- Adds the specified string to a string table, which will cache it and network it to all clients automatically.
    --- Whenever you want to create a net message with net.Start, you must add the name of that message as a networked string via this function.
    --- If the passed string already exists, nothing will happen and the ID of the existing item will be returned.
    --- **NOTE**: Each unique network name needs to be pooled once - do not put this function call into any other functions if you're using a constant string. Preferable place for this function is in a serverside lua file, or in a shared file with the net.Receive function.
    --- The string table used for this function does not interfere with the engine string tables and has 4095 slots.
    --- This limit is shared among all entities, SetNW* and SetGlobal* functions. If you exceed the limit, you cannot create new variables, and you will get the following warning:
    --- ```lua
    --- Warning:  Table networkstring is full, can't add [key]
    --- ```
    --- <warning>Existing variables will still get updated without the warning. You can check the limit by counting up until util.NetworkIDToString returns nil</warning>
    -- @param str --- Adds the specified string to the string table.
    -- @return --- The id of the string that was added to the string table.
    --- Same as calling util.NetworkStringToID.
    AddNetworkString: function(str: string): number

    --- Function used to calculate aim vector from 2D screen position. It is used in SuperDOF calculate Distance.
    --- Essentially a generic version of gui.ScreenToVector.
    -- @param ViewAngles --- View angles
    -- @param ViewFOV --- View Field of View
    -- @param x --- Mouse X position
    -- @param y --- Mouse Y position
    -- @param scrWidth --- Screen width
    -- @param scrHeight --- Screen height
    -- @return --- Calculated aim vector
    AimVector: function(ViewAngles: GAngle, ViewFOV: number, x: number, y: number, scrWidth: number, scrHeight: number): GVector

    --- Decodes the specified string from base64.
    -- @param str --- String to decode.
    -- @return --- The raw bytes of the decoded string.
    Base64Decode: function(str: string): string

    --- Encodes the specified string to base64.
    --- **NOTE**: Unless disabled with the `inline` argument, the Base64 returned is compliant to the RFC 2045 standard. **This means it will have a line break after every 76th character.**
    -- @param str --- String to encode.
    -- @param inline --- `true` to disable RFC 2045 compliance (newline every 76th character)
    -- @return --- Base 64 encoded string.
    Base64Encode: function(str: string, inline: boolean): string

    --- Applies explosion damage to all entities in the specified radius. Performs block checking.
    -- @param inflictor --- The entity that caused the damage.
    -- @param attacker --- The entity that attacked.
    -- @param damageOrigin --- The center of the explosion
    -- @param damageRadius --- The radius in which entities will be damaged.
    -- @param damage --- The amount of damage to be applied.
    BlastDamage: function(inflictor: GEntity, attacker: GEntity, damageOrigin: GVector, damageRadius: number, damage: number)

    --- Applies spherical damage based on damage info to all entities in the specified radius.
    -- @param dmg --- The information about the damage
    -- @param damageOrigin --- Center of the spherical damage
    -- @param damageRadius --- The radius in which entities will be damaged.
    BlastDamageInfo: function(dmg: GCTakeDamageInfo, damageOrigin: GVector, damageRadius: number)

    --- Generates the [CRC Checksum](https://en.wikipedia.org/wiki/Cyclic_redundancy_check) of the specified string.
    --- **WARNING**: This is NOT a hashing function. It is a checksum, typically used for error detection/data corruption detection. It is possible for this function to generate "collisions", where two different strings will produce the same CRC. If you need a hashing function, use util.SHA256.
    -- @param stringToChecksum --- The string to calculate the checksum of.
    -- @return --- The unsigned 32 bit checksum.
    CRC: function(stringToChecksum: string): string

    --- Compresses the given string using the [LZMA](https://en.wikipedia.org/wiki/LZMA) algorithm.
    --- Use with net.WriteData and net.ReadData for networking and  util.Decompress to decompress the data.
    --- **NOTE**: The output of this function will have the uncompressed size of the data prepended to it as an 8-byte little-endian integer. [Source](https://github.com/garrynewman/bootil/blob/beb4cec8ad29533965491b767b177dc549e62d23/src/Bootil/Utility/CompressionLZMA.cpp#L56-L63)
    --- You may therefore experience issues using the output of this function **_outside of Garry's Mod_**. If you need to do this, you will need to manually strip the first 8 bytes from the compressed output, or use third-party tools such as [gmod-lzma](https://github.com/WilliamVenner/gmod-lzma-rs) to decompress the output instead.
    -- @param str --- String to compress.
    -- @return --- The compressed string, or an empty string if the input string was zero length ("").
    Compress: function(str: string): string

    --- Returns the current date formatted like '2012-10-31 18-00-00'
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L98-L106)
    -- @return --- date
    DateStamp: function(): string

    --- Performs a trace and paints a decal to the surface hit.
    -- @param name --- The name of the decal to paint.
    -- @param start --- The start of the trace.
    -- @param end --- The end of the trace.
    -- @param filter --- If set, the decal will not be able to be placed on given entity. Can also be a table of entities.
    Decal: function(name: string, start: GVector, _end: GVector, filter: GEntity)

    --- Performs a trace and paints a decal to the surface hit.
    --- **NOTE**: This function has trouble spanning across multiple brushes on the map.
    -- @param material --- The name of the decal to paint. Can be retrieved with util.DecalMaterial.
    -- @param ent --- The entity to apply the decal to
    -- @param position --- The position of the decal.
    -- @param normal --- The direction of the decal.
    -- @param color --- The color of the decal. Uses the Color.
    --- This only works when used on a brush model and only if the decal material has set `$vertexcolor` to `1`.
    -- @param w --- The width scale of the decal.
    -- @param h --- The height scale of the decal.
    DecalEx: function(material: GIMaterial, ent: GEntity, position: GVector, normal: GVector, color: table, w: number, h: number)

    --- Gets the full material path by the decal name. Used with util.DecalEx.
    --- If decal specifies multiple materials, a random one will be chosen.
    -- @param decalName --- Name of the decal.
    -- @return --- Material path of the decal.
    DecalMaterial: function(decalName: string): string

    --- Decompresses the given string using [LZMA](https://en.wikipedia.org/wiki/LZMA) algorithm. Used to decompress strings previously compressed with util.Compress.
    --- **NOTE**: This function expects the compressed input data to have the uncompressed size of the data prepended to it as an 8-byte little-endian integer. [Source](https://github.com/garrynewman/bootil/blob/beb4cec8ad29533965491b767b177dc549e62d23/src/Bootil/Utility/CompressionLZMA.cpp#L101)
    --- If your compressed input data was compressed by util.Compress, you don't need to worry about this - the uncompressed size of the data is already prepended to its output.
    --- However, if your compressed data was produced using standard tools **_outside of Garry's Mod_**, you will need to manually prepend the length of the uncompressed data to its compressed form as an 8-byte little endian integer.
    -- @param compressedString --- The compressed string to decompress.
    -- @param maxSize --- The maximum size of uncompressed data in bytes, if greater it fails.
    -- @return --- The original, decompressed string or `nil` on failure or invalid input. Also returns empty string if the input string was zero length ("").
    Decompress: function(compressedString: string, maxSize: number): string|nil

    --- Gets the distance between a line and a point in 3d space.
    -- @param lineStart --- Start of the line.
    -- @param lineEnd --- End of the line.
    -- @param pointPos --- The position of the point.
    -- @return --- Distance from line.
    -- @return --- Nearest point on line.
    -- @return --- Distance along line from start.
    DistanceToLine: function(lineStart: GVector, lineEnd: GVector, pointPos: GVector): number, GVector, number

    --- Creates an effect with the specified data.
    --- For Orange Box `.pcf` particles, see Global.ParticleEffect, Global.ParticleEffectAttach and  Global.CreateParticleSystem.
    --- **NOTE**: When dispatching an effect from the server, some values may be clamped for networking optimizations. Visit the Set accessors on CEffectData to see which ones are affected.
    --- You will need to couple this function with Global.IsFirstTimePredicted if you want to use it in a predicted hook.
    -- @param effectName --- The name of the effect to create.
    --- You can find a list of built-in engine effects here. You can create your own, [example effects can be found here](https://github.com/Facepunch/garrysmod/tree/master/garrysmod/gamemodes/sandbox/entities/effects) and [here](https://github.com/Facepunch/garrysmod/tree/master/garrysmod/gamemodes/base/entities/effects).
    -- @param effectData --- The effect data describing the effect.
    -- @param allowOverride --- Whether Lua-defined effects should override engine-defined effects with the same name for this/single function call.
    -- @param ignorePredictionOrRecipientFilter --- Can either be a boolean to ignore the prediction filter or a CRecipientFilter.
    --- Set this to true if you wish to call this function in multiplayer from server.
    Effect: function(effectName: string, effectData: GCEffectData, allowOverride: boolean, ignorePredictionOrRecipientFilter: boolean|GCRecipientFilter)

    --- Filters given text using Steam's filtering system. The function will obey local client's Steam settings for chat filtering:
    --- <upload src="70c/8d9e680b626348b.png" size="50426" name="image.png">
    --- **NOTE**: In some cases, especially in a chatbox, messages from some players may return an empty string if the context argument used for filtering is `TEXT_FILTER_CHAT` and [if the local player has blocked the sender of the message on Steam](https://github.com/Facepunch/garrysmod-issues/issues/5161#issuecomment-1035153941).
    --- </upload>
    -- @param str --- String to filter.
    -- @param context --- Filtering context. See Enums/TEXT_FILTER.
    -- @param player --- Used to determine if the text should be filtered according to local user's Steam chat filtering settings.
    -- @return --- The filtered text based on given settings.
    --- The maximum length of the string is 4095 bytes.
    FilterText: function(str: string, context: number, player: GPlayer): string



    --- Returns the ID of a custom model activity. This is useful for models that define custom ones.
    --- See util.GetActivityNameByID for a function that does the opposite.
    -- @param  --- The name of an activity, as defined in the model's `.qc` at compile time.
    -- @return id --- The ID of the activity. See also Enums/ACT.
    GetActivityIDByName: function(_: string): number

    --- Returns a name for given activity ID. This is useful for models that define custom activities.
    --- See util.GetActivityIDByName for a function that does the opposite.
    -- @param id --- The ID of an activity from some hook. See also Enums/ACT.
    -- @return --- The associated name with given activity ID.
    GetActivityNameByID: function(id: number): string

    --- Returns the ID of a custom model animation event. This is useful for models that define custom animation events.
    --- See util.GetAnimEventNameByID for a function that does the opposite.
    -- @param  --- The name of an model animation event, as defined in the model's `.qc` at compile time.
    -- @return id --- The ID of an animation event, typically for usage with ENTITY:HandleAnimEvent.
    GetAnimEventIDByName: function(_: string): number

    --- Returns a name for given automatically generated numerical animation event ID. This is useful for models that define custom animation events.
    --- See util.GetAnimEventIDByName for a function that does the opposite.
    -- @param id --- The ID of an animation event, typically from ENTITY:HandleAnimEvent.
    -- @return --- The associated name with given event ID.
    GetAnimEventNameByID: function(id: number): string

    --- Returns a table containing the info about the model. The model will be loaded and cached if it was not previously.
    --- See also util.GetModelMeshes
    --- **NOTE**: This function will silently fail if used on models with following strings in them:
    --- * _shared
    --- * _anims
    --- * _gestures
    --- * _anim
    --- * _postures
    --- * _gst
    --- * _pst
    --- * _shd
    --- * _ss
    --- * _anm
    --- * _include
    -- @param mdl --- The model path to retrieve information about.
    -- @return --- The model info. See Structures/ModelInfo for details.
    GetModelInfo: function(mdl: string): S_ModelInfo

    --- Retrieves vertex, triangle, and bone data for the visual meshes of a given model.
    --- **NOTE**: This does not work on brush models (Models with names in the format `*number`)
    -- @param model --- The full path to the model to get the visual meshes of.
    -- @param lod --- Which of the model's Level of Detail (LOD) models to retrieve.
    --- `0` is the best quality with higher numbers progressively lowering the quality.
    -- @param bodygroupMask --- The combination of bodygroups to retrieve meshes for. This can also be a specially formatted bitflag.
    --- For more information, see Entity:SetBodyGroups.
    -- @param skin --- Skin index. Affects the `.material` of Structures/ModelMeshData.
    --- For more information, see Entity:GetSkin.
    -- @return modelMeshes --- Each index in this table corresponds to a mesh within the model passed as an argument to this function.
    --- The mesh data is raw, and is not transformed via bone transformations. That's what the second return value is for.
    -- @return modelBindPoses --- This tables indices are bone IDs for the Structures/BoneBindPose stored at each index.
    GetModelMeshes: function(model: string, lod: number, bodygroupMask: string|number, skin: number): {S_ModelMeshData}, {S_BoneBindPose}

    --- Gets persistent data of an offline player using their SteamID.
    --- See also Player:GetPData for a more convenient version of this function for online players, util.RemovePData and
    --- util.SetPData for the other accompanying functions.
    --- **NOTE**: This function internally uses util.SteamIDTo64, it previously utilized Player:UniqueID which can cause collisions (two or more players sharing the same PData entry). This function now only uses the old method as a fallback if the name isn't found.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L333-L353)
    -- @param steamID --- SteamID of the player, in the `STEAM_0:0:0` format. See Player:SteamID.
    -- @param name --- Variable name to get the value of
    -- @param default --- The default value, in case there's nothing stored
    -- @return --- The stored value
    GetPData: function(steamID: string, name: string, default: any): string

    --- Creates a new PixVis handle. See util.PixelVisible.
    -- @return --- PixVis
    GetPixelVisibleHandle: function(): Gpixelvis_handle_t

    --- Utility function to quickly generate a trace table that starts at the players view position, and ends `32768` units along a specified direction.
    --- For usage with util.TraceLine and similar functions.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L32-L49)
    -- @param ply --- The player the trace should be based on
    -- @param dir --- The direction of the trace. By default falls back to the direction the player is looking in.
    -- @return --- The trace data. See Structures/Trace
    GetPlayerTrace: function(ply: GPlayer, dir: GVector): S_Trace

    --- Gets information about the sun position and obstruction or nil if there is no sun.
    -- @return --- The sun info. See Structures/SunInfo
    GetSunInfo: function(): table

    --- Returns data of a [surface property](https://developer.valvesoftware.com/wiki/Material_surface_properties) at given ID. New surface properties can be added via physenv.AddSurfaceData.
    -- @param id --- Surface property ID. You can get it from Structures/TraceResult or using util.GetSurfaceIndex.
    -- @return --- The data or no value if there is no valid surface property at given index.
    GetSurfaceData: function(id: number): S_SurfacePropertyData

    --- Returns the matching surface property index for the given surface property name.
    --- See also util.GetSurfaceData and util.GetSurfacePropName for opposite function.
    -- @param surfaceName --- The name of the surface.
    -- @return --- The surface property index, or -1 if name doesn't correspond to a valid surface property.
    GetSurfaceIndex: function(surfaceName: string): number

    --- Returns the name of a surface property at given ID.
    --- See also util.GetSurfaceData and util.GetSurfaceIndex for opposite function.
    -- @param id --- Surface property ID. You can get it from Structures/TraceResult.
    -- @return --- The name or an empty string if there is no valid surface property at given index.
    GetSurfacePropName: function(id: number): string

    --- Returns a table of all SteamIDs that have a usergroup.
    --- **NOTE**: This returns the original usergroups table, changes done to this table are not retroactive and will only affect newly connected users
    --- **NOTE**: This returns only groups that are registered in the **settings/users.txt** file of your server.
    --- In order to get the usergroup of a connected player, please use Player:GetUserGroup instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/player_auth.lua#L99-L103)
    -- @return --- A table of users where the key is the SteamID of the user and the value is a table with 2 fields:
    --- * string name - Player Steam name
    --- * string group - Player usergroup name
    GetUserGroups: function(): table

    --- Performs a Ray-OBB (Orientated Bounding Box) intersection and returns position, normal and the fraction if there was an intersection.
    -- @param rayStart --- Origin or start position of the ray.
    -- @param rayDelta --- The ray vector itself, the ray end point relative to the start point. Can be implemented as `direction * distance`
    --- Note that in this implementation, the ray is not infinite - it's only a segment.
    -- @param boxOrigin --- The center of the box.
    -- @param boxAngles --- The angle of the box.
    -- @param boxMins --- The min position of the box.
    -- @param boxMaxs --- The max position of the box.
    -- @return --- Hit position, nil if not hit.
    -- @return --- Normal/direction vector, nil if not hit.
    -- @return --- Fraction of trace used, nil if not hit.
    IntersectRayWithOBB: function(rayStart: GVector, rayDelta: GVector, boxOrigin: GVector, boxAngles: GAngle, boxMins: GVector, boxMaxs: GVector): GVector, GVector, number

    --- Performs a [ray-plane intersection](https://en.wikipedia.org/wiki/Line%E2%80%93plane_intersection) and returns the hit position or nil.
    -- @param rayOrigin --- Origin/start position of the ray.
    -- @param rayDirection --- The direction of the ray.
    -- @param planePosition --- Any position of the plane.
    -- @param planeNormal --- The normal vector of the plane.
    -- @return --- The position of intersection, nil if not hit.
    IntersectRayWithPlane: function(rayOrigin: GVector, rayDirection: GVector, planePosition: GVector, planeNormal: GVector): GVector

    --- Performs a ray-sphere intersection and returns the intersection positions or nil.
    -- @param rayOrigin --- Origin/start position of the ray.
    -- @param rayDelta --- The end position of the ray relative to the start position. Equivalent of `direction * distance`.
    -- @param spherePosition --- Any position of the sphere.
    -- @param sphereRadius --- The radius of the sphere.
    -- @return --- The first intersection position along the ray, or `nil` if there is no intersection.
    -- @return --- The second intersection position along the ray, or `nil` if there is no intersection.
    IntersectRayWithSphere: function(rayOrigin: GVector, rayDelta: GVector, spherePosition: GVector, sphereRadius: number): number, number

    --- Returns whether a binary module is installed and is resolvable by Global.require.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L394-L418)
    -- @param name --- Name of the binary module, exactly the same as you would enter it as the argument to Global.require.
    -- @return --- Whether the binary module is installed and Global.require can resolve it.
    IsBinaryModuleInstalled: function(name: string): boolean

    --- Performs a box-box intersection and returns whether there was an intersection or not.
    -- @param boxMin --- The minimum extents of the Axis-Aligned box.
    -- @param boxMax --- The maximum extents of the Axis-Aligned box.
    -- @param box2Min --- The minimum extents of the second Axis-Aligned box.
    -- @param box2Max --- The maximum extents of the second Axis-Aligned box.
    -- @return --- `true` if there is an intersection, `false` otherwise.
    IsBoxIntersectingBox: function(boxMin: GVector, boxMax: GVector, box2Min: GVector, box2Max: GVector): boolean

    --- Performs a box-sphere intersection and returns whether there was an intersection or not.
    -- @param boxMin --- The minimum extents of the Axis-Aligned box.
    -- @param boxMax --- The maximum extents of the Axis-Aligned box.
    -- @param shpere2Position --- Any position of the sphere.
    -- @param sphere2Radius --- The radius of the sphere.
    -- @return --- `true` if there is an intersection, `false` otherwise.
    IsBoxIntersectingSphere: function(boxMin: GVector, boxMax: GVector, shpere2Position: GVector, sphere2Radius: number): boolean

    --- Checks if a certain position is within the world bounds.
    -- @param position --- Position to check.
    -- @return --- Whether the vector is in world.
    IsInWorld: function(position: GVector): boolean

    --- Checks if the model is loaded in the game.
    -- @param modelName --- Name/Path of the model to check.
    -- @return --- Returns true if the model is loaded in the game; otherwise false.
    IsModelLoaded: function(modelName: string): boolean

    --- Performs OBB on OBB intersection test.
    -- @param box1Origin --- The center of the first box.
    -- @param box1Angles --- The angles of the first box.
    -- @param box1Mins --- The min position of the first box.
    -- @param box1Maxs --- The max position of the first box.
    -- @param box2Origin --- The center of the second box.
    -- @param box2Angles --- The angles of the second box.
    -- @param box2Mins --- The min position of the second box.
    -- @param box2Maxs --- The max position of the second box.
    -- @param tolerance --- Tolerance for error. Leave at 0 if unsure.
    -- @return --- Whether there is an intersection.
    IsOBBIntersectingOBB: function(box1Origin: GVector, box1Angles: GAngle, box1Mins: GVector, box1Maxs: GVector, box2Origin: GVector, box2Angles: GAngle, box2Mins: GVector, box2Maxs: GVector, tolerance: number): boolean

    --- Returns whether a point is within a cone or not.
    -- @param point --- The position of the point to test.
    -- @param coneOrigin --- The position of the cone tip.
    -- @param coneAxis --- The direction of the cone.
    -- @param coneSine --- The sine of the cone's angle.
    -- @param coneLength --- Length of the cone's axis.
    -- @return --- `true` if the point is within the cone, `false` otherwise.
    IsPointInCone: function(point: GVector, coneOrigin: GVector, coneAxis: GVector, coneSine: number, coneLength: number): boolean

    --- Performs a ray-ray intersection and returns whether there was an intersection or not.
    -- @param ray1Start --- Start position of the first ray.
    -- @param ray1End --- End position of the first ray.
    -- @param ray2Start --- Start position of the second ray.
    -- @param ray2End --- End position of the second ray.
    -- @return --- `true` if there is an intersection, `false` otherwise.
    -- @return --- Distance from start of ray 1 to the intersection, if there was one.
    -- @return --- Distance from start of ray 2 to the intersection, if there was one.
    IsRayIntersectingRay: function(ray1Start: GVector, ray1End: GVector, ray2Start: GVector, ray2End: GVector): boolean, number, number

    --- Check whether the skybox is visible from the point specified.
    --- **NOTE**: This will always return true in fullbright maps.
    -- @param position --- The position to check the skybox visibility from.
    -- @return --- Whether the skybox is visible from the position.
    IsSkyboxVisibleFromPoint: function(position: GVector): boolean

    --- Returns whether a sphere is intersecting a cone or not.
    -- @param sphereCenter --- The center position of the sphere to test.
    -- @param sphereRadius --- The radius of the sphere to test.
    -- @param coneOrigin --- The position of the cone tip.
    -- @param coneAxis --- The direction of the cone.
    -- @param coneSine --- The <page test="sine">math.sin</page> of the cone's angle.
    -- @param coneCosine --- The <page test="cosine">math.cos</page> of the cone's angle.
    -- @return --- `true` if the sphere intersects the cone, `false` otherwise.
    IsSphereIntersectingCone: function(sphereCenter: GVector, sphereRadius: number, coneOrigin: GVector, coneAxis: GVector, coneSine: number, coneCosine: number): boolean

    --- Performs a sphere-sphere intersection and returns whether there was an intersection or not.
    -- @param sphere1Position --- Any position of the first sphere.
    -- @param sphere1Radius --- The radius of the first sphere.
    -- @param sphere2Position --- Any position of the second sphere.
    -- @param sphere2Radius --- The radius of the second sphere.
    -- @return --- `true` if there is an intersection, `false` otherwise.
    IsSphereIntersectingSphere: function(sphere1Position: GVector, sphere1Radius: number, sphere2Position: GVector, sphere2Radius: number): boolean

    --- Checks if the specified model is valid.
    --- A model is considered invalid in following cases:
    --- * Starts with a space or **maps**
    --- * Doesn't start with **models**
    --- * Contains any of the following:
    --- * `_gestures`
    --- * `_animations`
    --- * `_postures`
    --- * `_gst`
    --- * `_pst`
    --- * `_shd`
    --- * `_ss`
    --- * `_anm`
    --- * `.bsp`
    --- * `cs_fix`
    --- * If the model isn't precached on the server, AND if the model file doesn't exist on disk
    --- * If precache failed
    --- * Model is the error model
    --- Running this function will also precache the model.
    -- @param modelName --- Name/Path of the model to check.
    -- @return --- Whether the model is valid or not. Returns false clientside if the model is not precached by the server.
    IsValidModel: function(modelName: string): boolean

    --- Checks whether the given numbered physics object of the given entity is valid or not. Most useful for ragdolls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L9-L30)
    -- @param ent --- The entity to take.
    -- @param physobj --- Number of the physics object to test.
    -- @return --- `true` that's valid, `false` otherwise.
    IsValidPhysicsObject: function(ent: GEntity, physobj: number): boolean

    --- Checks if the specified prop is valid (has valid physics object).
    -- @param modelName --- Name/Path of the model to check.
    -- @return --- Returns true if the specified prop is valid; otherwise false.
    IsValidProp: function(modelName: string): boolean

    --- Checks if the specified model name points to a valid ragdoll.
    -- @param ragdollName --- Name/Path of the ragdoll model to check.
    -- @return --- Returns true if the specified model name points to a valid ragdoll; otherwise false.
    IsValidRagdoll: function(ragdollName: string): boolean

    --- Converts a JSON string to a Lua table.
    --- See util.TableToJSON for the opposite function.
    --- **BUG**: [Colors will not have the color metatable.](https://github.com/Facepunch/garrysmod-issues/issues/2407
    -- @param json --- The JSON string to convert.
    -- @param ignoreLimits --- ignore the depth and breadth limits, **use at your own risk!**.
    --- **WARNING**: If this is false, there is a limit of 15,000 keys total.
    -- @param ignoreConversions --- ignore string to number conversions for table keys.
    --- **WARNING**: if this is false, keys are converted to numbers wherever possible. This means using Player:SteamID64 as keys won't work.
    -- @return --- The table containing converted information. Returns `nil` on failure.
    JSONToTable: function(json: string, ignoreLimits: boolean, ignoreConversions: boolean): table|nil

    --- Converts a Valve KeyValue string (typically from util.TableToKeyValues) to a Lua table.
    --- **NOTE**: Due to how tables work in Lua, keys will not repeat within a table. See util.KeyValuesToTablePreserveOrder for alternative.
    -- @param keyValues --- The KeyValue string to convert.
    -- @param usesEscapeSequences --- If set to true, will replace `\t`, `\n`, `\"` and `\\` in the input text with their escaped variants
    -- @param preserveKeyCase --- Whether we should preserve key case (may fail) or not (always lowercase)
    -- @return --- The converted table
    KeyValuesToTable: function(keyValues: string, usesEscapeSequences: boolean, preserveKeyCase: boolean): table

    --- Similar to util.KeyValuesToTable but it also preserves order of keys.
    -- @param keyvals --- The key value string
    -- @param usesEscapeSequences --- If set to true, will replace `\t`, `\n`, `\"` and `\\` in the input text with their escaped variants
    -- @param preserveKeyCase --- Whether we should preserve key case (may fail) or not (always lowercase)
    -- @return --- The output table
    KeyValuesToTablePreserveOrder: function(keyvals: string, usesEscapeSequences: boolean, preserveKeyCase: boolean): table

    --- A convenience function around LocalToWorld-related functions.
    --- **NOTE**: If Entity:EntIndex returns `0`, the function will return the passed `lpos`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L76-L95)
    -- @param ent --- The entity to take.
    -- @param lpos --- A local space vector.
    -- @param bone --- Actually to be treated as the number corresponding to a specific PhysObj of the entity.
    --- If that specific physics object is valid, then PhysObj:LocalToWorld is used.
    --- Otherwise, Entity:LocalToWorld.
    -- @return --- The corresponding worldspace vector.
    LocalToWorld: function(ent: GEntity, lpos: GVector, bone: number): GVector

    --- Generates the [MD5 hash](https://en.wikipedia.org/wiki/MD5) of the specified string.
    --- **WARNING**: MD5 is considered cryptographically broken and is known to be vulnerable to a variety of attacks including duplicate return values. If security or duplicate returns is a concern, use util.SHA256.
    -- @param stringToHash --- The string to calculate the MD5 hash of.
    -- @return --- The MD5 hash of the string in hexadecimal form.
    MD5: function(stringToHash: string): string

    --- Returns the networked string associated with the given ID from the string table.
    -- @param stringTableID --- ID to get the associated string from.
    -- @return --- The networked string, or nil if it wasn't found.
    NetworkIDToString: function(stringTableID: number): string

    --- Returns the networked ID associated with the given string from the string table.
    -- @param networkString --- String to get the associated networked ID from.
    -- @return --- The networked ID of the string, or 0 if it hasn't been networked with util.AddNetworkString.
    NetworkStringToID: function(networkString: string): number

    --- Formats a float by stripping off extra `0's` and `.'s`.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L147-L165)
    -- @param float --- The float to format.
    -- @return --- Formatted float.
    NiceFloat: function(float: number): string

    --- Creates a tracer effect with the given parameters.
    -- @param name --- The name of the tracer effect.
    -- @param startPos --- The start position of the tracer.
    -- @param endPos --- The end position of the tracer.
    -- @param doWhiz --- Play the hit miss(whiz) sound.
    ParticleTracer: function(name: string, startPos: GVector, endPos: GVector, doWhiz: boolean)

    --- Creates a tracer effect with the given parameters.
    -- @param name --- The name of the tracer effect.
    -- @param startPos --- The start position of the tracer.
    -- @param endPos --- The end position of the tracer.
    -- @param doWhiz --- Play the hit miss(whiz) sound.
    -- @param entityIndex --- Entity index of the emitting entity.
    -- @param attachmentIndex --- Attachment index to be used as origin.
    ParticleTracerEx: function(name: string, startPos: GVector, endPos: GVector, doWhiz: boolean, entityIndex: number, attachmentIndex: number)

    --- Returns the visibility of a square that is always pointed at the camera in the world-space.
    --- This is typically used for in-game sprites or "billboards". (render.DrawSprite)
    -- @param position --- The center of the visibility test.
    -- @param size --- The size of the square to check for visibility.
    -- @param PixVis --- The PixVis handle created with util.GetPixelVisibleHandle.
    --- **WARNING**: Don't use the same handle twice per tick or it will give unpredictable results.
    -- @return --- Visibility percentage, in range of `[0-1]`. `0` when none of the area is visible, `0.5` when half the area is visible, `1` when all of it is visible, etc.
    PixelVisible: function(position: GVector, size: number, PixVis: Gpixelvis_handle_t): number

    --- Returns the contents of the position specified.
    --- **NOTE**: This function will sample only the world environments. It can be used to check if Entity:GetPos is underwater for example unlike Entity:WaterLevel which works for players only.
    -- @param position --- Position to get the contents sample from.
    -- @return --- Contents bitflag, see Enums/CONTENTS
    PointContents: function(position: GVector): E_CONTENTS

    --- Precaches a model for later use. Model is cached after being loaded once.
    --- **WARNING**: Modelprecache is limited to 8192 unique models. When it reaches the limit the game will crash.
    --- **NOTE**: Does nothing on the client.
    -- @param modelName --- The model to precache.
    PrecacheModel: function(modelName: string)

    --- Precaches a sound for later use. Sound is cached after being loaded once.
    --- **NOTE**: Soundcache is limited to 16384 unique sounds on the server.
    --- **BUG**: Broken on purpose because hitting the limit above causes the server to shutdown
    --- **BUG**: Ultimately does nothing on client, and only works with sound scripts, not direct paths.
    -- @param soundName --- The sound to precache.
    PrecacheSound: function(soundName: string)

    --- Performs a trace with the given origin, direction, and filter.
    --- **NOTE**: This function will throw an error in the menu realm because it internally uses util.TraceLine which doesn't exist in the menu realm and thus error.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L52-L66)
    -- @param origin --- The origin of the trace.
    -- @param dir --- The direction of the trace times the distance of the trace. This is added to the origin to determine the endpos.
    -- @param filter --- Entity which should be ignored by the trace. Can also be a table of entities or a function - see Structures/Trace.
    -- @return --- Trace result. See Structures/TraceResult.
    QuickTrace: function(origin: GVector, dir: GVector, filter: GEntity|{GEntity}|{string}|function): S_TraceResult





    --- Removes world decals at given position, in given radius. Does not remove decals on models!
    -- @param pos --- The position at which to remove decals.
    -- @param distance --- Radius of the sphere to remove decals in.
    -- @param limit --- If set to above 0, only remove this many decals.
    -- @param permanent --- Whether to remove map-spawned decals (`true`), or only gameplay-spawned decals
    --- such as bullet holes or anything placed by util.Decal and similar(`false`)
    -- @return removed --- How many decals were removed.
    RemoveDecalsAt: function(pos: GVector, distance: number, limit: number, permanent: boolean): number

    --- Removes persistent data of an offline player using their SteamID.
    --- See also Player:RemovePData for a more convenient version of this function for online players, util.SetPData and
    --- util.GetPData for the other accompanying functions.
    --- **NOTE**: This function internally uses util.SteamIDTo64, it previously utilized Player:UniqueID which can cause collisions (two or more players sharing the same PData entry). This function now tries to remove both old and new entries.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L370-L380)
    -- @param steamID --- SteamID of the player to remove data of, in the `STEAM_0:0:0` format. See Player:SteamID.
    -- @param name --- Variable name to remove
    RemovePData: function(steamID: string, name: string)

    --- Generates the [SHA-1 hash](https://en.wikipedia.org/wiki/SHA-1) of the specified string.
    --- **WARNING**: SHA-1 is considered cryptographically broken and is known to be vulnerable to a variety of attacks. If security is a concern, use util.SHA256.
    -- @param stringToHash --- The string to calculate the SHA-1 hash of.
    -- @return --- The SHA-1 hash of the string in hexadecimal form.
    SHA1: function(stringToHash: string): string

    --- Generates the [SHA-256 hash](https://en.wikipedia.org/wiki/SHA-2) of the specified string. This is unique and will never return the same hash for a different string unlike util.CRC or util.MD5 which are both vulnerable to duplicate returns.
    -- @param stringToHash --- The string to calculate the SHA-256 hash of.
    -- @return --- The SHA-256 hash of the string in hexadecimal form.
    SHA256: function(stringToHash: string): string

    --- Makes the screen shake.
    --- **NOTE**: The screen shake effect is rendered by modifying the view origin on the client. If you override the view origin in GM:CalcView you may not be able to see the shake effect.
    -- @param pos --- The origin of the effect.
    --- Used serverside only, to determine which clients the event should be networked to.
    -- @param amplitude --- The strength of the effect. How far away from its origin the camera will move while shaking.
    -- @param frequency --- How many times per second to change the direction of the camera wobble. 40 is generally enough; values higher are hardly distinguishable.
    -- @param duration --- The duration of the effect in seconds.
    -- @param radius --- The range from the origin within which views will be affected, in Hammer units.
    --- This is used when networking the event to clients only.
    -- @param airshake --- Whether players in the air should also be affected.
    --- Used serverside only to determine which clients to send the event to.
    -- @param filter --- If set, will only network the screen shake event to players present in the filter.
    ScreenShake: function(pos: GVector, amplitude: number, frequency: number, duration: number, radius: number, airshake: boolean, filter: GCRecipientFilter)

    --- Sets persistent data for offline player using their SteamID.
    --- See also Player:SetPData for a more convenient version of this function for online players, util.RemovePData and
    --- util.GetPData for the other accompanying functions.
    --- **NOTE**: This function internally uses util.SteamIDTo64, it previously utilized Player:UniqueID which could have caused collisions (two or more players sharing the same PData entry).
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L359-L364)
    -- @param steamID --- SteamID of the player, in the `STEAM_0:0:0` format. See Player:SteamID.
    -- @param name --- Variable name to store the value in.
    -- @param value --- The value to store.
    SetPData: function(steamID: string, name: string, value: any)

    --- Generates a random float value that should be the same on client and server.
    --- **NOTE**: This function is best used in a predicted hook
    -- @param uniqueName --- The seed for the random value
    -- @param min --- The minimum value of the random range
    -- @param max --- The maximum value of the random range
    -- @param additionalSeed --- The additional seed
    -- @return --- The random float value
    SharedRandom: function(uniqueName: string, min: number, max: number, additionalSeed: number): number

    --- Adds a trail to the specified entity.
    -- @param ent --- Entity to attach trail to
    -- @param attachmentID --- Attachment ID of the entities model to attach trail to. If you are not sure, set this to 0
    -- @param color --- Color of the trail, use Global.Color
    -- @param additive --- Should the trail be additive or not
    -- @param startWidth --- Start width of the trail
    -- @param endWidth --- End width of the trail
    -- @param lifetime --- How long it takes to transition from startWidth to endWidth
    -- @param textureRes --- The resolution of trails texture. A good value can be calculated using this formula: 1 / ( startWidth + endWidth ) * 0.5
    -- @param texture --- Path to the texture to use as a trail.
    -- @return --- Entity of created trail ([env_spritetrail](https://developer.valvesoftware.com/wiki/Env_spritetrail))
    SpriteTrail: function(ent: GEntity, attachmentID: number, color: table, additive: boolean, startWidth: number, endWidth: number, lifetime: number, textureRes: number, texture: string): GEntity

    --- Returns a new Stack object.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L324-L326)
    -- @return --- A brand new stack object.
    Stack: function(): GStack

    --- Given a 64bit SteamID will return a STEAM_0:0:0 style Steam ID.
    --- **NOTE**: This operation induces data loss. Not all fields of a [64bit SteamID](https://developer.valvesoftware.com/wiki/SteamID) can be represented using the `STEAM_0:0:0` format, specifically the "account type" and "account instance" fields.
    -- @param id --- The 64 bit Steam ID
    -- @return --- String STEAM_0:0:0 style Steam ID representation.
    SteamIDFrom64: function(id: string): string

    --- Converts a STEAM_0:0:0 style SteamID to a 64bit SteamID.
    -- @param id --- The STEAM_0:0:0 format SteamID
    -- @return --- 64bit SteamID or 0 (as a string) on fail
    SteamIDTo64: function(id: string): string

    --- Converts a string to the specified type.
    --- This can be useful when dealing with ConVars.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L108-L125)
    -- @param str --- The string to convert
    -- @param typename --- The type to attempt to convert the string to. This can be `vector`, `angle`, `float`, `int`, `bool`, or `string` (case insensitive).
    -- @return --- The result of the conversion, or nil if a bad type is specified.
    StringToType: function(str: string, typename: string): any

    --- Converts a table to a JSON string. Keep in mind that not every data type can be stored in the JSON format, notably any entity will not be written, as if it wasn't in the table. Same goes for materials and textures, etc.
    --- See util.JSONToTable for the opposite function.
    --- **WARNING**: All keys are strings in the JSON format, so all keys of other types will be converted to strings!
    --- This can lead to loss of data where a number key could be converted into an already existing string key! (for example in a table like this: `{["5"] = "ok", [5] = "BBB"}`)
    -- @param table --- Table to convert.
    -- @param prettyPrint --- Format and indent the JSON.
    -- @return --- A JSON formatted string containing the serialized data
    TableToJSON: function(table: table, prettyPrint: boolean): string

    --- Converts the given table into a Valve key value string.
    --- Use util.KeyValuesToTable to perform the opposite transformation.
    --- You should consider using util.TableToJSON instead.
    -- @param table --- The table to convert.
    -- @param rootKey --- The root key name for the output KV table.
    -- @return --- The output.
    TableToKeyValues: function(table: table, rootKey: string): string

    --- Creates a timer object. The returned timer will be already started with given duration.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L217-L226)
    -- @param duration --- How long you want the timer to be. `Elapsed()` will return true only after this much time has passed.
    -- @return --- A timer object. It has the following methods:
    --- * `Reset()` - Resets and stops the timer.
    --- * `Start( duration = 0 )` - (Re)starts the timer with given duration
    --- * `Started()` - Returns `true` if the timer has been started. It will continue to return true even after the duration has passed.
    --- * `Elapsed()` - Returns `true` if the timer duration has elapsed since its creation or the call to `Start()`
    --- * `GetElaspedTime()` - Returns amount of time since timer started.
    Timer: function(duration: number): table

    --- Returns the time since this function has been last called
    -- @return --- Time since this function has been last called in ms
    TimerCycle: function(): number

    --- Runs a trace using the entity's collisionmodel between two points. This does not take the entity's angles into account and will trace its unrotated collisionmodel.
    -- @param tracedata --- Trace data. See Structures/Trace
    -- @param ent --- The entity to use
    -- @return --- Trace result. See Structures/TraceResult
    TraceEntity: function(tracedata: S_Trace, ent: GEntity): S_TraceResult

    --- Identical to util.TraceHull but uses an entity's [Axis-Aligned Bounding Box (AABB)](https://en.wikipedia.org/wiki/Minimum_bounding_box) for `mins`/`maxs` inputs. (These 2 keys will be ignored in the provided table)
    -- @param tracedata --- Trace data. See Structures/HullTrace
    -- @param ent --- The entity to use mins/maxs of for the hull trace.
    -- @return --- Trace result. See Structures/TraceResult
    TraceEntityHull: function(tracedata: S_HullTrace, ent: GEntity): S_TraceResult

    --- Performs an AABB hull (axis-aligned bounding box, aka not rotated) trace with the given trace data.
    --- This trace type cannot hit hitboxes.
    --- See util.TraceLine for a simple line ("ray") trace.
    --- **NOTE**: This function may not always give desired results clientside due to certain physics mechanisms not existing on the client. Use it serverside for accurate results.
    -- @param TraceData --- The trace data to use. See Structures/HullTrace
    -- @return --- Trace result. See Structures/TraceResult
    TraceHull: function(TraceData: S_HullTrace): S_TraceResult

    --- Performs an infinitely thin, invisible ray trace (or "trace") in a line based on the input and returns a table that contains information about what, if anything, the trace line hit or intersected.
    --- Traces intersect with the physics meshes of solid, server-side, entities (including the game world) but cannot detect client-side only entities unless hitclientonly is set to true.
    --- See ents.FindAlongRay if you wish for the trace to not stop on first intersection.
    --- See util.TraceHull for a "box" type trace.
    --- Traces do not differentiate between the inside and the outside faces of physics meshes. Because of this, if a trace starts within a solid physics mesh it will hit the inside faces of the physics mesh and may return unexpected values as a result.
    --- You can use `r_visualizetraces` set to `1` (requires `sv_cheats` set to `1`) to visualize traces in real time for debugging purposes.
    -- @param traceConfig --- A table of data that configures the trace. See Structures/Trace for available options.
    -- @return --- A table of information detailing where and what the trace line intersected, or `nil` if the trace is being done before the GM:InitPostEntity hook.
    --- For the table's format and available options see the Structures/TraceResult page.
    TraceLine: function(traceConfig: S_Trace): S_TraceResult

    --- Converts a type to a (nice, but still parsable) string
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L127-L144)
    -- @param input --- What to convert
    -- @return --- Converted string
    TypeToString: function(input: any): string

    --- @deprecated
    --- **DEPRECATED**: You should use Global.tobool instead.
    --- Converts string or a number to a bool, if possible. Alias of Global.tobool.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/util.lua#L73-L73)
    -- @param input --- A string or a number to convert.
    -- @return --- False if the input is equal to the string or boolean "false", if the input is equal to the string or number "0", or if the input is nil. Returns true otherwise.
    tobool: function(input: any): boolean
end


--- The **vgui** library allows you to script and create your own panels using **V**alve's **G**raphical **U**ser **I**nterface (VGUI) system.
--- For an alphabetically ordered list of VGUI panels, see VGUI Element List.
global record vgui
    --- Creates a panel by the specified classname.
    --- **NOTE**: Custom VGUI elements are not loaded instantly. Use GM:OnGamemodeLoaded to create them on startup.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L23-L52)
    -- @param classname --- Classname of the panel to create.
    --- Default panel classnames can be found on the VGUI Element List.
    --- New panels can be registered via vgui.Register
    -- @param parent --- Panel to parent to.
    -- @param name --- Custom name of the created panel for scripting/debugging purposes. Can be retrieved with Panel:GetName.
    -- @return --- The created panel, or `nil` if creation failed for whatever reason.
    Create: function(classname: string, parent: GPanel, name: string): GPanel

    --- Creates a panel from a table, used alongside vgui.RegisterFile and vgui.RegisterTable to efficiently define, register, and instantiate custom panels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L54-L72)
    -- @param metatable --- Your PANEL table.
    -- @param parent --- Which panel to parent the newly created panel to.
    -- @param name --- Custom name of the created panel for scripting/debugging purposes. Can be retrieved with Panel:GetName.
    -- @return --- The created panel, or `nil` if creation failed for whatever reason.
    CreateFromTable: function(metatable: table, parent: GPanel, name: string): GPanel

    --- **INTERNAL**:
    ---  Creates an engine panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L13-L13)
    -- @param class --- Class of the panel to create
    -- @param parent --- If specified, parents created panel to given one
    -- @param name --- Name of the created panel
    -- @return --- Created panel
    CreateX: function(class: string, parent: GPanel, name: string): GPanel

    --- Returns whenever the cursor is currently active and visible.
    -- @return --- Whether the cursor is visible or not.
    CursorVisible: function(): boolean

    --- Returns true if Lua-defined panel exists by name. Uses vgui.GetControlTable internally.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L19-L21)
    -- @param Panelname --- The name of the panel to get test.
    -- @return --- Whether a panel with given name was registered yet or not.
    Exists: function(Panelname: string): boolean

    --- Returns whether the currently focused panel is a child of the given one.
    -- @param parent --- The parent panel to check the currently focused one against. This doesn't need to be a direct parent (focused panel can be a child of a child and so on).
    -- @return --- Whether or not the focused panel is a child of the passed one.
    FocusedHasParent: function(parent: GPanel): boolean

    --- Returns all Lua-created panels.
    --- Used internally for PANEL:PreAutoRefresh and PANEL:PostAutoRefresh.
    -- @return --- List of all Lua created panels.
    GetAll: function(): {GPanel}

    --- Returns the table of a Lua-defined panel by name. Does not return parent members of the table!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L15-L17)
    -- @param Panelname --- The name of the panel to get the table of.
    -- @return --- The `PANEL` table of the a Lua-defined panel with given name.
    GetControlTable: function(Panelname: string): table

    --- Returns the panel the cursor is hovering above.
    --- **WARNING**: This returns a cached value that is only updated after rendering and `before` the next VGUI Think/Layout pass.
    --- ie. it lags one frame behind panel layout and is completely unhelpful for PANEL:Paint if your panels are moving around under the mouse a lot every frame.
    -- @return --- The panel that the user is currently hovering over with their cursor.
    GetHoveredPanel: function(): GPanel

    --- Returns the panel which is currently receiving keyboard input.
    -- @return --- The panel with keyboard focus
    GetKeyboardFocus: function(): GPanel

    --- Returns the global world panel which is the parent to all others, except for the HUD panel.
    --- See also Global.GetHUDPanel.
    -- @return --- The world panel
    GetWorldPanel: function(): GPanel

    --- Returns whenever the cursor is hovering the world panel.
    -- @return --- isHoveringWorld
    IsHoveringWorld: function(): boolean

    --- Registers a panel for later creation via vgui.Create.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L74-L98)
    -- @param classname --- Classname of the panel to register. This is what you will need to pass to vgui.Create's first argument.
    --- This must be unique, including classnames of entities due to internal usage of baseclass.Set.
    -- @param panelTable --- The table containing the panel information.
    -- @param baseName --- Classname of a panel to inherit functionality from. Functions with same names will be overwritten preferring the panel that is being registered.
    -- @return --- The given panel table from second argument
    Register: function(classname: string, panelTable: table, baseName: string): table

    --- Registers a new VGUI panel from a file, to be used with vgui.CreateFromTable.
    --- File file must use the `PANEL` global that is provided just before the file is Global.included, for example:
    --- ```
    --- PANEL.Base = "Panel"
    --- function PANEL:Init()
    --- -- Your code...
    --- end
    --- function PANEL:Think()
    --- -- Your code...
    --- end
    --- ```
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L112-L129)
    -- @param file --- The file to register
    -- @return --- A table containing info about the panel.
    RegisterFile: function(file: string): table

    --- Registers a table to use as a panel, to be used with vgui.CreateFromTable.
    --- All this function does is assigns Base key to your table and returns the table.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/panel/scriptedpanels.lua#L100-L110)
    -- @param panel --- The PANEL table.
    -- @param base --- A base for the panel.
    -- @return --- The PANEL table
    RegisterTable: function(panel: table, base: string): table
end


--- The video library.
global record video
    --- Attempts to create an IVideoWriter.
    -- @param config --- The video config. See Structures/VideoData.
    -- @return --- The video object. (returns **false** if there is an error)
    -- @return --- The error string, if there is an error.
    Record: function(config: table): GIVideoWriter, string
end


--- The weapons library allows you to access information about any scripted weapons loaded into the game, as well as register your own weapons.
global record weapons
    --- Get a `copy` of weapon table by name. This function also inherits fields from the weapon's base class, unlike weapons.GetStored.
    --- **NOTE**: This will only work on SWEP's, this means that this will not return anything for HL2/HL:S weapons.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L132-L163)
    -- @param classname --- Class name of weapon to retrieve
    -- @return --- The retrieved table or nil
    Get: function(classname: string): table

    --- Get a list of all the registered SWEPs. This does not include weapons added to spawnmenu manually.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L177-L185)
    -- @return --- List of all the registered SWEPs
    GetList: function(): table

    --- Gets the REAL weapon table, not a copy. The produced table does *not* inherit fields from the weapon's base class, unlike weapons.Get.
    --- **WARNING**: Modifying this table will modify what is stored by the weapons library. Take a copy or use weapons.Get to avoid this.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L169-L171)
    -- @param weapon_class --- Weapon class to retrieve weapon table of
    -- @return --- The weapon table
    GetStored: function(weapon_class: string): table

    --- Checks if name is based on base
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L32-L39)
    -- @param name --- Entity's class name to be checked
    -- @param base --- Base class name to be checked
    -- @return --- Returns true if class name is based on base, else false.
    IsBasedOn: function(name: string, base: string): boolean

    --- **INTERNAL**:
    --- Called after all SWEPS have been loaded and runs baseclass.Set on each one.
    --- You can retrieve all the currently registered SWEPS with weapons.GetList.
    --- **NOTE**: This is not called after a SWEP auto refresh, and thus the inherited baseclass functions retrieved with baseclass.Get will not be updated
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L113-L126)
    OnLoaded: function()

    --- Registers a Scripted Weapon (SWEP) class manually. When the engine spawns an entity, weapons registered with this function will be created if the class names match.
    --- See also scripted_ents.Register for Scripted Entities (SENTs)
    --- **BUG**: [Sub-tables provided in the first argument will not carry over their metatable, and will receive a BaseClass key if the table was merged with the base's. Userdata references, which includes Vectors, Angles, Entities, etc. will not be copied.](https://github.com/Facepunch/garrysmod/pull/1300
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/weapons.lua#L46-L106)
    -- @param ENT --- The SWEP table to register.
    --- For the table's format and available options see the Structures/SWEP page.
    -- @param classname --- Classname to assign to that swep
    Register: function(ENT: table, classname: string)
end


--- The widgets library.
--- Widgets allow the player to have mouse interaction with entities, such as being able to manipulate the [bones of an NPC](https://www.youtube.com/watch?v=O3gG0t39-pQ).
global record widgets
    --- **INTERNAL**:
    ---  Automatically called to update all widgets.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/widget.lua#L92-L105)
    -- @param ply --- The player
    -- @param mv --- Player move data
    PlayerTick: function(ply: GPlayer, mv: GCMoveData)

    --- Renders a widget. Normally you won't need to call this.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/widget.lua#L114-L130)
    -- @param ent --- Widget entity to render
    RenderMe: function(ent: GEntity)
end





--- List of all possible functions to manipulate angles.
--- Created by Global.Angle.
--- | Type                | Name                                 | Description                      |
--- | ------------------- | ------------------------------------ | -------------------------------- |
--- | number | `p` or `pitch` or `x` or `1` | The pitch component of the angle. |
--- | number | `y` or `yaw` or `2` | The yaw component of the angle. |
--- | number | `r` or `roll`  or `z` or `3` | The roll  component of the angle. |
--- Metamethod | Second Operand | Description
--- ---------- | -------------- | -----------
--- `__add` | Angle | Returns new Angle with the result of addition.
--- `__div` | number | Returns new Angle with the result of division.
--- `__eq` | any | Compares 2 operands, if they both are Angle, compares each individual component.
--- Doesn't normalize the angles (360 is not equal to 0).
--- `__index` | number or string | Gets the component of the Angle. Returns a number.
--- `__mul` | number | Returns new Angle with the result of multiplication.
--- `__newindex` | number or string | Sets the component of the Angle. Accepts number and string.
--- `__sub` | Angle | Returns new Angle with the result of subtraction.
--- `__tostring` | | Returns `p y r`.
--- `__unm` | | Returns new Angle with the result of negation.
global interface GAngle
    where TypeID(self) == TYPE_ANGLE
    --- Adds the values of the argument angle to the orignal angle.
    --- This functions the same as angle1 + angle2 without creating a new angle object, skipping object construction and garbage collection.
    -- @param angle --- The angle to add.
    Add: function(self, angle: GAngle)

    --- Divides all values of the original angle by a scalar. This functions the same as angle1 / num without creating a new angle object, skipping object construction and garbage collection.
    -- @param scalar --- The number to divide by.
    Div: function(self, scalar: number)

    --- Returns a normal vector facing in the direction that the angle points.
    -- @return --- The forward direction of the angle
    Forward: function(self): GVector

    --- Returns if the angle is equal to another angle with the given tolerance.
    -- @param compare --- The angle to compare to.
    -- @param tolerance --- The tolerance range for each component.
    -- @return eq --- Are each of the the angle components equal or not within given tolerance.
    IsEqualTol: function(self, compare: GAngle, tolerance: number): boolean

    --- Returns whether the pitch, yaw and roll are 0 or not.
    -- @return --- Whether the pitch, yaw and roll are 0 or not.
    IsZero: function(self): boolean

    --- Multiplies a scalar to all the values of the orignal angle. This functions the same as num * angle without creating a new angle object, skipping object construction and garbage collection.
    -- @param scalar --- The number to multiply.
    Mul: function(self, scalar: number)

    --- Normalizes the angles by applying a modulo with 360 to pitch, yaw and roll.
    Normalize: function(self)

    --- Randomizes each element of this Angle object.
    -- @param min --- The minimum value for each component.
    -- @param max --- The maximum value for each component.
    Random: function(self, min: number, max: number)

    --- Returns a normal vector facing in the direction that points right relative to the angle's direction.
    -- @return --- The right direction of the angle
    Right: function(self): GVector

    --- Rotates the angle around the specified axis by the specified degrees.
    -- @param axis --- The axis to rotate around as a normalized unit vector. When argument is not a unit vector, you will experience numerical offset errors in the rotated angle.
    -- @param rotation --- The degrees to rotate around the specified axis.
    RotateAroundAxis: function(self, axis: GVector, rotation: number)

    --- Copies pitch, yaw and roll from the second angle to the first.
    -- @param originalAngle --- The angle to copy the values from.
    Set: function(self, originalAngle: GAngle)

    --- Sets the p, y, and r of the angle.
    -- @param p --- The pitch component of the Angle
    -- @param y --- The yaw component of the Angle
    -- @param r --- The roll component of the Angle
    SetUnpacked: function(self, p: number, y: number, r: number)

    --- Snaps the angle to nearest interval of degrees.
    --- **NOTE**: This will modify the original angle too!
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/angle.lua#L5-L18)
    -- @param axis --- The component/axis to snap. Can be either `p`/`pitch`, `y`/`yaw` or `r`/`roll`.
    -- @param target --- The target angle snap interval
    -- @return --- The snapped angle.
    SnapTo: function(self, axis: string, target: number): GAngle

    --- Subtracts the values of the argument angle to the orignal angle. This functions the same as angle1 - angle2 without creating a new angle object, skipping object construction and garbage collection.
    -- @param angle --- The angle to subtract.
    Sub: function(self, angle: GAngle)

    --- Returns the angle as a table with three elements.
    -- @return --- The table with elements 1 = p, 2 = y, 3 = r.
    ToTable: function(self): table

    --- Returns the pitch, yaw, and roll components of the angle.
    -- @return --- p, pitch, x, or Angle[1].
    -- @return --- y, yaw, or Angle[2].
    -- @return --- r, roll, r, or Angle[3].
    Unpack: function(self): number, number, number

    --- Returns a normal vector facing in the direction that points up relative to the angle's direction.
    -- @return --- The up direction of the angle.
    Up: function(self): GVector

    --- Sets pitch, yaw and roll to 0.
    --- This function is faster than doing it manually.
    Zero: function(self)
end


--- This is a list of all available methods for all entities, which includes Players, Weapons, NPCs and Vehicles.
--- For a list of possible members of Scripted Entities see ENT Structure.
global interface GEntity
    where TypeID(self) == TYPE_ENTITY
    --- Activates the entity. This needs to be used on some entities (like constraints) after being spawned.
    --- **NOTE**: For some entity types when this function is used after Entity:SetModelScale, the physics object will be recreated with the new scale. [Source-sdk-2013](https://github.com/ValveSoftware/source-sdk-2013/blob/55ed12f8d1eb6887d348be03aee5573d44177ffb/mp/src/game/server/baseanimating.cpp#L321-L327).
    --- Calling this method after Entity:SetModelScale will recreate a new scaled `SOLID_VPHYSICS` PhysObj on scripted entities. This can be a problem if you made a properly scaled PhysObj of another kind (using Entity:PhysicsInitSphere for instance) or if you edited the PhysObj's properties. This is especially the behavior of the Sandbox spawn menu.
    Activate: function(self)

    --- Add a callback function to a specific event. This is used instead of hooks to avoid calling empty functions unnecessarily.
    --- This also allows you to use certain hooks in engine entities (non-scripted entities).
    --- **WARNING**: This method does not check if the function has already been added to this object before, so if you add the same callback twice, it will be run twice! Make sure to add your callback only once.
    -- @param hook --- The hook name to hook onto. See Entity Callbacks
    -- @param func --- The function to call. It's arguments and return values will depend on the hook specified in the first argument.
    -- @return --- The callback ID that was just added, which can later be used in Entity:RemoveCallback.
    --- Returns nothing if the passed callback function was invalid or when asking for a non-existent hook.
    AddCallback: function(self, hook: string, func: function): number

    --- Adds engine flags.
    -- @param flag --- Engine flag to add, see Enums/EFL
    AddEFlags: function(self, flag: E_EFL)

    --- Applies an engine effect to an entity.
    --- See also Entity:IsEffectActive and  Entity:RemoveEffects.
    -- @param effect --- The effect to apply, see Enums/EF.
    AddEffects: function(self, effect: E_EF)

    --- Adds flags to the entity.
    -- @param flag --- Flag to add, see Enums/FL
    AddFlags: function(self, flag: E_FL)

    --- Adds a gesture animation to the entity and plays it.
    --- See Entity:AddGestureSequence and Entity:AddLayeredSequence for functions that takes sequences instead of Enums/ACT.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entites!
    -- @param activity --- The activity to play as the gesture. See Enums/ACT.
    -- @param autokill --- Automatically remove the gesture when it fully plays (Entity:GetLayerCycle reaches 1).
    -- @return --- Layer ID of the started gesture, used to manipulate the played gesture by other functions.
    --- **NOTE**: If a layer has already been allocated for supplied Enums/ACT, it will return existing layer ID instead of allocating a new layer.
    AddGesture: function(self, activity: number, autokill: boolean): number

    --- Adds a gesture animation to the entity and plays it.
    --- See Entity:AddGesture for a function that takes Enums/ACT.
    --- See also Entity:AddLayeredSequence.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entites!
    -- @param sequence --- The sequence ID to play as the gesture. See Entity:LookupSequence.
    -- @param autokill --- Automatically remove the gesture when it fully plays (Entity:GetLayerCycle reaches 1).
    -- @return --- Layer ID of the started gesture, used to manipulate the played gesture by other functions.
    AddGestureSequence: function(self, sequence: number, autokill: boolean): number

    --- Adds a gesture animation to the entity and plays it.
    --- See Entity:AddGestureSequence for a function that doesn't take priority.
    --- See Entity:AddGesture for a function that takes Enums/ACT.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entites!
    -- @param sequence --- The sequence ID to play as the gesture. See Entity:LookupSequence.
    -- @param priority ---
    -- @return --- Layer ID of created layer
    AddLayeredSequence: function(self, sequence: number, priority: number): number

    --- Adds solid flag(s) to the entity.
    -- @param flags --- The flag(s) to apply, see Enums/FSOLID.
    AddSolidFlags: function(self, flags: number)

    --- Adds onto the current SpawnFlags of an Entity.
    --- SpawnFlags can easily be found on https://developer.valvesoftware.com/wiki/.
    --- **NOTE**: See also Entity:RemoveSpawnFlags, Entity:SetSpawnFlags
    --- Using SF Enumerations won't work, if this function is ran clientside due to the enumerations being defined only Serverside. Use the actual SpawnFlag number.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L11-L13)
    -- @param flag --- The SpawnFlag to add to the Entity
    AddSpawnFlags: function(self, flag: number)

    --- Adds a PhysObject to the entity's motion controller so that ENTITY:PhysicsSimulate will be called for given PhysObject as well.
    --- You must first create a motion controller with Entity:StartMotionController.
    --- You can remove added PhysObjects by using Entity:RemoveFromMotionController.
    --- **NOTE**: Only works on a scripted Entity of anim type
    -- @param physObj --- The PhysObj to add to the motion controller.
    AddToMotionController: function(self, physObj: GPhysObj)

    --- Returns an angle based on the ones inputted that you can use to align an object.
    --- **NOTE**: This function doesn't change the angle of the entity on its own (see example).
    -- @param from --- The angle you want to align from
    -- @param to --- The angle you want to align to
    -- @return --- The resulting aligned angle
    AlignAngles: function(self, from: GAngle, to: GAngle): GAngle

    --- Checks if the entity is considered alive.
    --- Checks entity's internal life state variable. Does not check health, but it is generally expected the health to be 0 or below at the point of an entity being considered dead. This internally looks up the save value `m_lifeState`
    -- @return --- Whether the entity is considered alive.
    Alive: function(self): boolean

    --- Spawns a clientside ragdoll for the entity, positioning it in place of the original entity, and makes the entity invisible. It doesn't preserve flex values (face posing) as CSRagdolls don't support flex.
    --- It does not work on players. Use Player:CreateRagdoll instead.
    --- The original entity is not removed, and neither are any ragdolls previously generated with this function.
    --- To make the entity re-appear, run Entity:SetNoDraw( false )
    -- @return --- The created ragdoll. (`class C_ClientRagdoll`)
    BecomeRagdollOnClient: function(self): GEntity

    --- Returns true if the entity is being looked at by the local player and is within 256 units of distance.
    --- **NOTE**: This function is only available in entities that are based off of sandbox's base_gmodentity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/entities/base_gmodentity.lua#L10-L35)
    -- @return --- Is the entity being looked at by the local player and within 256 units.
    BeingLookedAtByLocalPlayer: function(self): boolean

    --- **INTERNAL**:
    ---  Dispatches blocked events to this entity's blocked handler. This function is only useful when interacting with entities like func_movelinear.
    -- @param entity --- The entity that is blocking us
    Blocked: function(self, entity: GEntity)

    --- Returns a centered vector of this entity, NPCs use this internally to aim at their targets.
    --- **NOTE**: This only works on players and NPCs.
    -- @param origin --- The vector of where the the attack comes from.
    -- @param noisy --- Decides if it should return the centered vector with a random offset to it.
    -- @return --- The centered vector.
    BodyTarget: function(self, origin: GVector, noisy: boolean): GVector

    --- Returns whether the entity's bone has the flag or not.
    -- @param boneID --- Bone ID to test flag of.
    -- @param flag --- The flag to test, see Enums/BONE
    -- @return --- Whether the bone has that flag or not
    BoneHasFlag: function(self, boneID: number, flag: E_BONE): boolean

    --- Returns the length between given bone's position and the position of given bone's parent.
    -- @param boneID --- The ID of the bone you want the length of. You may want to get the length of the next bone ( boneID + 1 ) for decent results
    -- @return --- The length of the bone
    BoneLength: function(self, boneID: number): number

    --- Returns the distance between the center of the bounding box and the furthest bounding box corner.
    -- @return --- The radius of the bounding box.
    BoundingRadius: function(self): number

    --- Calls all Entity:NetworkVarNotify functions with the given new value, but doesn't change the real value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L345-L352)
    -- @param type --- The NetworkVar Type. Supported choices:
    --- * `String` (up to 511 characters)
    --- * `Bool`
    --- * `Float`
    --- * `Int` (32-bit signed integer)
    --- * `Vector`
    --- * `Angle`
    --- * `Entity`
    -- @param slot --- The NetworkVar slot. See Entity:NetworkVar for more detailed explanation.
    -- @param newValue --- The new value.
    CallDTVarProxies: function(self, type: string, slot: number, newValue: any)

    --- Causes a specified function to be run if the entity is removed by any means. This can later be undone by Entity:RemoveCallOnRemove if you need it to not run.
    --- **WARNING**: This hook is called clientside during full updates. See GM:EntityRemoved for more information.
    --- **WARNING**: An error being thrown inside `removeFunc` will stop other `EntityRemoved` hooks from executing.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L120-L132)
    -- @param identifier --- Identifier that can be optionally used with Entity:RemoveCallOnRemove to undo this call on remove.
    -- @param removeFunc --- Function to be called on remove.
    --- <callback>
    --- <arg type="Entity" name="ent">The entity about to be removed.</arg>
    --- <arg type="vararg" name="data">Data passed from the arguments to `CallOnRemove`.</arg>
    --- </callback>
    -- @param args --- Optional arguments to pass to removeFunc. Do note that the first argument passed to the function will always be the entity being removed, and the arguments passed on here start after that.
    CallOnRemove: function(self, identifier: any, removeFunc: function, ...: any)

    --- Clears all registered events for map I/O outputs on this entity. If a string is given, will use the string as a wildcard to limit removed outputs by name matches.
    -- @param outputName --- An optional string that will be used to limit removed outputs by name matches, supports wildcards.
    ClearAllOutputs: function(self, outputName: string)

    --- Resets all pose parameters such as aim_yaw, aim_pitch and rotation.
    ClearPoseParameters: function(self)

    --- Declares that the collision rules of the entity have changed, and subsequent calls for GM:ShouldCollide with this entity may return a different value than they did previously.
    --- **WARNING**: This function must **not** be called inside of GM:ShouldCollide. Instead, it must be called in advance when the condition is known to change.
    --- **WARNING**: Failure to use this function correctly will result in a crash of the physics engine.
    CollisionRulesChanged: function(self)

    --- Same as Entity:GetBoneMatrix, but instead of returning a new matrix object, it copies the data to a given matrix.
    --- This is measurably faster when accessing bone matrices a lot.
    -- @param boneID --- The bone ID to retrieve matrix of, starting at index 0.
    -- @param data --- The matrix to copy the bone matrix to.
    CopyBoneMatrix: function(self, boneID: number, data: GVMatrix)

    --- Creates bone followers based on the current entity model.
    --- Bone followers are Entities whose Physics Object follows a specific bone on another Entity's model.
    --- This is what is used by `prop_dynamic` for things like big combine doors for vehicles with multiple physics objects which follow the visual mesh of the door when it animates.
    --- Be mindful that bone followers create a separate entity (`phys_bone_follower`) for each physics object.
    --- You must call Entity:UpdateBoneFollowers every tick for bone followers to update their positions.
    --- **NOTE**: This function only works on `anim`, `nextbot` and `ai` type entities.
    -- @param bone_whitelist --- If set, a whitelist of bone names to create bone followers for. If a models' bone name is not in this list, a bone follower entity will not be created for it.
    CreateBoneFollowers: function(self, bone_whitelist: table)

    --- Creates a clientside particle system attached to the entity. See also Global.CreateParticleSystem
    --- **NOTE**: The particle effect must be precached with Global.PrecacheParticleSystem and the file its from must be added via game.AddParticles before it can be used!
    -- @param particle --- The particle name to create
    -- @param attachment --- Attachment ID to attach the particle to
    -- @param options --- A table of tables ( IDs 1 to 64 ) having the following structure:
    --- * number attachtype - The particle attach type. See PATTACH. **Default:** PATTACH_ABSORIGIN
    --- * Entity entity - The parent entity? **Default:** NULL
    --- * Vector position - The offset position for given control point. **Default:**  nil
    --- This only affects the control points of the particle effects and will do nothing if the effect doesn't use control points.
    -- @return --- The created particle system.
    CreateParticleEffect: function(self, particle: string, attachment: number, options: table): GCNewParticleEffect

    --- Draws the shadow of an entity.
    CreateShadow: function(self)

    --- Returns whether the entity was created by map or not.
    -- @return --- Is created by map?
    CreatedByMap: function(self): boolean

    --- **INTERNAL**:
    --- You should use Entity:NetworkVar instead
    --- Sets up a self.dt.NAME alias for a Data Table variable.
    -- @param type --- The type of the DTVar being set up. Supported choices:
    --- * `String` (up to 511 characters)
    --- * `Bool`
    --- * `Float`
    --- * `Int` (32-bit signed integer)
    --- * `Vector`
    --- * `Angle`
    --- * `Entity`
    -- @param slot --- The ID of the DTVar. Can be between `0` and `3` for strings, `0` and `31` for everything else.
    --- This can be omitted entirely (arguments will shift) and it will use the next available slot.
    -- @param name --- Name by which you will refer to DTVar. It must be a valid variable name. (No spaces!)
    DTVar: function(self, type: string, slot: number, name: string)

    --- **INTERNAL**:
    --- You should use Entity:NetworkVar instead
    --- Sets up a self.dt.NAME alias for a Data Table variable.
    -- @param type --- The type of the DTVar being set up. Supported choices:
    --- * `String` (up to 511 characters)
    --- * `Bool`
    --- * `Float`
    --- * `Int` (32-bit signed integer)
    --- * `Vector`
    --- * `Angle`
    --- * `Entity`
    -- @param name --- Name by which you will refer to DTVar. It must be a valid variable name. (No spaces!)
    DTVar: function(self, type: string, name: string)

    --- Whenever the entity is removed, entityToRemove will be removed also.
    -- @param entityToRemove --- The entity to be removed
    DeleteOnRemove: function(self, entityToRemove: GEntity)

    --- Destroys bone followers created by Entity:CreateBoneFollowers.
    --- **NOTE**: This function only works on `anim` type entities.
    DestroyBoneFollowers: function(self)

    --- Removes the shadow for the entity.
    --- The shadow will be recreated as soon as the entity wakes.
    --- **NOTE**: Doesn't affect shadows from flashlight/lamps/env_projectedtexture.
    DestroyShadow: function(self)

    --- Disables an active matrix. See Entity:EnableMatrix for more info about active matrixes.
    -- @param matrixType --- The name of the matrix type to disable.
    --- Currently the only matrix type is `"RenderMultiply"`.
    DisableMatrix: function(self, matrixType: string)

    --- Performs a trace attack towards the entity this function is called on, as if an invisible bullet is shot towards it. Visually identical to Entity:TakeDamageInfo.
    --- **WARNING**: Calling this function on the victim entity in ENTITY:OnTakeDamage can cause infinite loops.
    --- **NOTE**: This function correctly applies damage to [func_breakable_surf](https://developer.valvesoftware.com/wiki/Func_breakable_surf) entities, unlike Entity:TakeDamageInfo.
    -- @param damageInfo --- The damage to apply.
    -- @param traceRes --- Trace result to use to deal damage. See Structures/TraceResult
    -- @param dir --- Direction of the attack.
    DispatchTraceAttack: function(self, damageInfo: GCTakeDamageInfo, traceRes: table, dir: GVector)

    --- Dissolves the entity.
    --- This function creates an `env_entity_dissolver` entity internally, which seems to be deleted in the same frame. Calling this function on an entity that is already dissolving will not create another `env_entity_dissolver` entity.
    -- @param type --- Dissolve type. Should be one of the following values:
    --- | ID | Description |
    --- |||
    --- | 0 | ENTITY_DISSOLVE_NORMAL |
    --- | 1 | ELECTRICAL|
    --- | 2 | ELECTRICAL_LIGHT |
    --- | 3 | ENTITY_DISSOLVE_CORE |
    -- @param magnitude --- Magnitude of the dissolve effect, its effect depends on the dissolve type.
    -- @param origin --- The origin for the dissolve effect, its effect depends on the dissolve type. Defaults to entity's origin.
    Dissolve: function(self, type: number, magnitude: number, origin: GVector)

    --- This removes the argument entity from an ent's list of entities to 'delete on remove'
    --- **NOTE**: Also see Entity:DeleteOnRemove
    -- @param entityToUnremove --- The entity to be removed from the list of entities to delete
    DontDeleteOnRemove: function(self, entityToUnremove: GEntity)

    --- Draws the entity or model.
    --- If called inside ENTITY:Draw or ENTITY:DrawTranslucent, it only draws the entity's model itself.
    --- If called outside of those hooks, it will call both of said hooks depending on Entity:GetRenderGroup, drawing the entire entity again.
    --- When drawing an entity more than once per frame in different positions, you should call Entity:SetupBones before each draw; Otherwise, the entity will retain its first drawn position.
    --- **NOTE**: Provides a 3D rendering context
    --- **BUG**: [Calling this on entities with EF_BONEMERGE and EF_NODRAW applied causes a crash.](https://github.com/Facepunch/garrysmod-issues/issues/1558
    --- **BUG**: [Using this with a map model (game.GetWorld():GetModel()) crashes the game.](https://github.com/Facepunch/garrysmod-issues/issues/2688
    --- **BUG**: [Calling this in GM:PrePlayerDraw will cause infinite recursion and crash the game.](https://github.com/Facepunch/garrysmod-issues/issues/4116
    -- @param flags --- The optional STUDIO_ flags, usually taken from ENTITY:Draw and similar hooks.
    DrawModel: function(self, flags: number)

    --- Sets whether an entity's shadow should be drawn.
    -- @param shouldDraw --- True to enable, false to disable shadow drawing.
    DrawShadow: function(self, shouldDraw: boolean)

    --- Move an entity down until it collides with something.
    --- **WARNING**: The entity needs to already have something below it within 256 units.
    -- @param mask --- Trace mask.
    -- @param ignoreEnt --- Trace ignore entity.
    -- @param maxDist --- Max trace dist.
    DropToFloor: function(self, mask: number, ignoreEnt: GEntity, maxDist: number)

    --- Plays a sound on an entity.
    --- If run clientside, the sound will only be heard locally.
    --- If used on a player or NPC character with the mouth rigged, the character will "lip-sync" if the sound file contains lipsync data. See [this page](https://developer.valvesoftware.com/wiki/Choreography_creation/Lip_syncing) for more information.
    --- **NOTE**: When using this function with weapons, use the Weapon itself as the entity, not its owner!
    --- **BUG**: [This does not respond to Global.SuppressHostEvents.](https://github.com/Facepunch/garrysmod-issues/issues/2651
    -- @param soundName --- The name of the sound to be played.
    --- This should either be a sound script name (sound.Add) or a file path relative to the `sound/` folder. (so don't include `sound/`, and make note that it's not sound**s** when moving the sound file itself)
    --- **WARNING**: The string cannot have whitespace at the start or end. You can remove this with string.Trim.
    -- @param soundLevel --- A modifier for the distance this sound will reach, acceptable range is 0 to 511. 100 means no adjustment to the level. See Enums/SNDLVL
    --- Will not work if a [sound script](https://developer.valvesoftware.com/wiki/Soundscripts) is used.
    -- @param pitchPercent --- The pitch applied to the sound. The acceptable range is from 0 to 255. 100 means the pitch is not changed.
    -- @param volume --- The volume, from 0 to 1.
    -- @param channel --- The sound channel, see Enums/CHAN.
    --- Will not work if a [sound script](https://developer.valvesoftware.com/wiki/Soundscripts) is used.
    -- @param soundFlags --- The flags of the sound, see Enums/SND
    -- @param dsp --- The DSP preset for this sound. [List of DSP presets](https://developer.valvesoftware.com/wiki/Dsp_presets)
    -- @param filter --- If set serverside, the sound will only be networked to the clients in the filter.
    EmitSound: function(self, soundName: string, soundLevel: number, pitchPercent: number, volume: number, channel: number, soundFlags: number, dsp: number, filter: GCRecipientFilter)

    --- Toggles the constraints of this ragdoll entity on and off.
    -- @param toggleConstraints --- Set to true to enable the constraints and false to disable them.
    --- Disabling constraints will delete the constraint entities.
    EnableConstraints: function(self, toggleConstraints: boolean)

    --- Flags an entity as using custom lua defined collisions. Fixes entities having spongy player collisions or not hitting traces, such as after Entity:PhysicsFromMesh
    --- Internally identical to `Entity:AddSolidFlags( bit.bor( FSOLID_CUSTOMRAYTEST, FSOLID_CUSTOMBOXTEST ) )`
    --- Do not confuse this function with Entity:SetCustomCollisionCheck, they are not the same.
    EnableCustomCollisions: function(self)

    --- Can be used to apply a custom VMatrix to the entity, mostly used for scaling the model by a Vector.
    --- To disable it, use Entity:DisableMatrix.
    --- If your old scales are wrong due to a recent update, use Entity:SetLegacyTransform as a quick fix.
    --- **NOTE**: The matrix can also be modified to apply a custom rotation and offset via the VMatrix:SetAngles and VMatrix:SetTranslation functions.
    --- **BUG**: [This does not scale procedural bones, and disables inverse kinematics of the entity.](https://github.com/Facepunch/garrysmod-issues/issues/3502
    -- @param matrixType --- The name of the matrix type.
    --- Currently the only matrix type is `"RenderMultiply"`.
    -- @param matrix --- The matrix to apply before drawing the entity.
    EnableMatrix: function(self, matrixType: string, matrix: GVMatrix)

    --- Gets the unique entity index of an entity.
    --- **NOTE**: Entity indices are marked as unused after deletion, and can be reused by newly-created entities
    -- @return --- The index of the entity.
    --- `-1` for clientside-only or `0` for serverside-only and NULL entities.
    EntIndex: function(self): number

    --- Extinguishes the entity if it is on fire.
    --- Has no effect if called inside GM:EntityTakeDamage (and the attacker is the flame that's hurting the entity)
    --- See also Entity:Ignite.
    Extinguish: function(self)

    --- Returns the direction a player, npc or ragdoll is looking as a world-oriented angle.
    --- **BUG**: [This can return an incorrect value in vehicles (like pods, buggy, ...). **This bug has been fixed in the past but was causing many addons being broken, so the fix has been removed but applied to Player:GetAimVector only**.](https://github.com/Facepunch/garrysmod-issues/issues/1150
    --- **BUG**: [This may return local angles in jeeps when used with Player:EnterVehicle. **A workaround is available in the second example.**](https://github.com/Facepunch/garrysmod-issues/issues/2620
    -- @return --- Player's eye angle.
    EyeAngles: function(self): GAngle

    --- Returns the position of an Player/NPC's view.
    -- @return --- View position of the entity.
    EyePos: function(self): GVector

    --- Searches the Entity's model for a Body Group with a given name.
    --- **NOTE**: Weapons will return results from their viewmodels.
    -- @param name --- The name to search for.
    -- @return --- The Body Group's ID or `-1` if no Body Group has the provided name.
    FindBodygroupByName: function(self, name: string): number

    --- Searches the currently active layers for a layer playing animation with given activity.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entites!
    -- @param activity --- The activity to search for.
    -- @return layerID --- A layer ID for given activity, or `-1` if not found.
    FindGestureLayer: function(self, activity: E_ACT): number

    --- Searches the currently active layers for a layer playing animation with given sequence.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entites!
    -- @param sequenceID --- The sequence ID to search for. See Entity:LookupSequence.
    -- @return layerID --- A layer ID for given activity, or `-1` if not found.
    FindGestureLayer: function(self, sequenceID: number): number

    --- Returns a transition from the given start and end sequence.
    --- This function was only used by HL1 entities and NPCs, before the advent of sequence blending and gestures.
    -- @param currentSequence --- The currently playing sequence
    -- @param goalSequence --- The goal sequence.
    -- @return --- The transition sequence, -1 if not available.
    FindTransitionSequence: function(self, currentSequence: number, goalSequence: number): number

    --- Fires an entity's input, conforming to the map IO event queue system. You can find inputs for most entities on the [Valve Developer Wiki](https://developer.valvesoftware.com/wiki/Output)
    --- See also Entity:Input for a function that bypasses the event queue and GM:AcceptInput.
    -- @param input --- The name of the input to fire
    -- @param param --- The value to give to the input, can also be a number or a boolean.
    -- @param delay --- Delay in seconds before firing
    -- @param activator --- The entity that caused this input (i.e. the player who pushed a button)
    -- @param caller --- The entity that is triggering this input (i.e. the button that was pushed)
    Fire: function(self, input: string, param: string|number|boolean, delay: number, activator: GEntity, caller: GEntity)

    --- Fires a bullet.
    --- When used in a  hook such as WEAPON:Think or WEAPON:PrimaryAttack, it will use Player:LagCompensation internally.
    --- Lag compensation will not work if this function is called in a timer, regardless if the timer was made in a predicted hook.
    --- Due to how `Entity:FireBullets` is set up internally, bullet tracers will always originate from attachment 1. This can be avoided by supplying your own tracer effect.
    --- When firing bullets from a Weapon, it is recommended to fire bullets from the weapon owner entity (Player or NPC), not the Weapon itself.
    -- @param bulletInfo --- The bullet data to be used. See the Structures/Bullet.
    -- @param suppressHostEvents --- Has the effect of encasing the FireBullets call in Global.SuppressHostEvents, only works in multiplayer.
    FireBullets: function(self, bulletInfo: S_Bullet, suppressHostEvents: boolean)

    --- Makes an entity follow another entity's bone.
    --- Internally this function calls Entity:SetParent( parent, boneid ), Entity:AddEffects( EF_FOLLOWBONE
    --- ) and sets an internal flag to always rebuild all bones.
    --- **NOTE**: If the entity vibrates or stops following the parent, you probably need to run Entity:SetPredictable( true ) clientside.
    --- **WARNING**: This function will not work if the target bone's parent bone is invalid or if the bone is not used by VERTEX LOD0
    -- @param parent --- The entity to follow the bone of. If unset, removes the FollowBone effect.
    -- @param boneid --- The bone to follow
    FollowBone: function(self, parent: GEntity, boneid: number)

    --- Forces the entity to be dropped, if it is being held by a player's Gravity Gun, Physics Gun or `+use` pickup.
    --- See also Player:DropObject.
    ForcePlayerDrop: function(self)

    --- Advances the cycle of an animated entity.
    --- Animations that loop will automatically reset the cycle so you don't have to - ones that do not will stop animating once you reach the end of their sequence.
    --- **WARNING**: Do not call this function multiple times a frame, as it can cause unexpected results, such as animations playing at increased rate, etc.
    --- NextBot:BodyMoveXY calls this internally, so do not call this function before or after NextBot:BodyMoveXY.
    FrameAdvance: function(self)

    --- Returns the entity's velocity.
    --- **NOTE**: Actually binds to CBaseEntity::GetLocalVelocity() which retrieves the velocity of the entity due to its movement in the world from forces such as gravity. Does not include velocity from entity-on-entity collision.
    -- @return --- The velocity of the entity.
    GetAbsVelocity: function(self): GVector

    --- Gets the angles of given entity.
    --- **BUG**: [This returns incorrect results for the local player clientside.](https://github.com/Facepunch/garrysmod-issues/issues/2764
    --- **BUG**: [This will return the local player's Global.EyeAngles in rendering hooks.](https://github.com/Facepunch/garrysmod-issues/issues/3106
    --- **BUG**: [This will return Global.Angle(0,0,0) in rendering hooks while paused in single-player.](https://github.com/Facepunch/garrysmod-issues/issues/3107
    -- @return --- The angles of the entity.
    GetAngles: function(self): GAngle

    --- Returns the amount of animations (not to be confused with sequences) the entity's model has. A sequence can consist of multiple animations.
    --- See also Entity:GetAnimInfo
    -- @return --- The amount of animations the entity's model has.
    GetAnimCount: function(self): number

    --- Returns a table containing the number of frames, flags, name, and FPS of an entity's animation ID.
    --- **NOTE**: Animation ID is not the same as sequence ID. See Entity:GetAnimCount
    -- @param animIndex --- The animation ID to look up, starting at 0.
    -- @return --- Information about the animation, or `nil` if the index is out of bounds.
    --- A table with the following keys:
    --- * string label - Animation name
    --- * number fps - How many frames per second the animation should be played at
    --- * number flags - [STUDIO_](https://github.com/ZeqMacaw/Crowbar/blob/0d46f3b6a694b74453db407c72c12a9685d8eb1d/Crowbar/Core/GameModel/SourceCommon/SourceMdlFileData/SourceMdlAnimationDesc.vb#L181) flags, such as looping
    --- * number numframes - Number of frames the animation has
    GetAnimInfo: function(self, animIndex: number): table|nil

    --- Returns the last time the entity had an animation update. Returns 0 if the entity doesn't animate.
    -- @return --- The last time the entity had an animation update.
    GetAnimTime: function(self): number

    --- Returns the amount of time since last animation.
    --- Works only on `CBaseAnimating` entities.
    -- @return --- The amount of time since last animation.
    GetAnimTimeInterval: function(self): number

    --- Gets the orientation and position of the attachment by its ID, returns nothing if the attachment does not exist.
    --- **NOTE**: The update rate of this function is limited by the setting of ENT.AutomaticFrameAdvance for Scripted Entities!
    --- **BUG**: [This will return improper values for viewmodels if used in GM:CalcView.](https://github.com/Facepunch/garrysmod-issues/issues/1255
    -- @param attachmentId --- The internal ID of the attachment.
    -- @return --- The table with angle and position of the attachment or `nil` if does not exist. See the Structures/AngPos. Most notably, the table contains the keys `Ang` and `Pos` as well as `Bone`.
    GetAttachment: function(self, attachmentId: number): S_AngPos|nil

    --- Returns a table containing all attachments of the given entity's model.
    --- **BUG**: [This can have inconsistent results in single-player.](https://github.com/Facepunch/garrysmod-issues/issues/3167
    -- @return --- Attachment data. See Structures/AttachmentData.
    --- Returns an empty table in case its model has no attachments or there's a some kind of other issue.
    GetAttachments: function(self): table

    --- Returns the entity's base velocity which is their velocity due to forces applied by other entities. This includes entity-on-entity collision or riding a treadmill.
    -- @return --- The base velocity of the entity.
    GetBaseVelocity: function(self): GVector

    --- Returns the blood color of this entity. This can be set with Entity:SetBloodColor.
    -- @return --- Color from Enums/BLOOD_COLOR or nil
    GetBloodColor: function(self): E_BLOOD_COLOR

    --- Returns a list of information about each Body Group present on the Entity's model.
    --- **NOTE**: Weapons will return results from their viewmodels.
    -- @return --- A table of Body Group information where each value is a Structures/BodyGroupData.
    GetBodyGroups: function(self): table

    --- Returns the Sub Model ID for the currently active Sub Model of the Body Group corresponding to the given Body Group ID.
    --- **NOTE**: Weapons will return results from their viewmodels.
    -- @param bodyGroupId --- The Body Group ID to retrieve the active Sub Model ID for.
    --- Body Group IDs start at `0`.
    -- @return --- The currently active Sub Model ID.
    --- Sub Model IDs start at `0`.
    GetBodygroup: function(self, bodyGroupId: number): number

    --- Returns the number of Sub Models in the Body Group corresponding to a given Body Group ID of the Entity's model.
    --- **NOTE**: Weapons will return results from their viewmodels.
    -- @param bodyGroupId --- The Body Group ID to retrieve the Sub Model count of.
    --- Body Group IDs start at `0`.
    -- @return --- The number of Sub Models in the Body Group.
    GetBodygroupCount: function(self, bodyGroupId: number): number

    --- Retrieves the name of the Body Group corresponding to a given Body Group ID on the Entity's model.
    --- **NOTE**: Weapons will return results from their viewmodels.
    -- @param bodyGroupId --- The Body Group ID to get the name of.
    -- @return --- The name of the Body Group.
    GetBodygroupName: function(self, bodyGroupId: number): string

    --- Returns the contents of the specified bone.
    -- @param bone --- The bone id, starting at index 0. See Entity:LookupBone.
    -- @return --- The contents as a Enums/CONTENTS or 0 on failure.
    GetBoneContents: function(self, bone: number): number

    --- Returns the value of the bone controller with the specified ID.
    --- **NOTE**: This is the precursor of pose parameters, and only works for Half Life 1: Source models supporting it.
    -- @param boneID --- ID of the bone controller. Goes from 0 to 3.
    -- @return --- The value set on the bone controller.
    GetBoneController: function(self, boneID: number): number

    --- Returns the amount of bones in the entity.
    --- **NOTE**: Will return `0` for Global.ClientsideModel or undrawn entities until Entity:SetupBones is called on the entity.
    -- @return --- The amount of bones in given entity, starting at index 0.
    GetBoneCount: function(self): number

    --- Returns the transformation matrix of a given bone on the entity's model. The matrix contains the transformation used to position the bone in the world. It is not relative to the parent bone.
    --- This is equivalent to constructing a VMatrix using Entity:GetBonePosition.
    --- See Entity:CopyBoneMatrix for a more performant version.
    --- **BUG**: [This can return the server's matrix during server lag.](https://github.com/Facepunch/garrysmod-issues/issues/884
    --- **BUG**: [This can return garbage serverside or a 0,0,0 fourth column (represents position) for v49 models.](https://github.com/Facepunch/garrysmod-issues/issues/3285
    -- @param boneID --- The bone ID to retrieve matrix of, starting at index 0.
    --- * Bones clientside and serverside will differ
    -- @return --- The matrix
    --- * Some entities don't update animation every frame such as prop_physics and won't have accurate bone matrix.
    GetBoneMatrix: function(self, boneID: number): GVMatrix

    --- Returns name of given bone id.
    --- See Entity:LookupBone for the inverse of this function.
    -- @param index --- ID of bone to lookup name of, starting at index 0.
    -- @return --- The name of given bone.
    --- * `"__INVALIDBONE__"` in case the name cannot be read or the index is out of range, or we failed or entity doesn't have a model.
    GetBoneName: function(self, index: number): string

    --- Returns parent bone of given bone.
    --- **NOTE**: Will return -1 for Global.ClientsideModel until Entity:SetupBones is called on the entity.
    -- @param bone --- The bone ID of the bone to get parent of, starting at index 0.
    -- @return --- Parent bone ID or -1 if we failed for some reason.
    GetBoneParent: function(self, bone: number): number

    --- Returns the position and angle of the given attachment, relative to the world.
    --- **WARNING**: This function can return entity's `GetPos()` instead if the entity doesn't have it's bone cache set up.
    --- To ensure the bone position is correct use this:
    --- ```lua
    --- local pos = ent:GetBonePosition(0)
    --- if pos == ent:GetPos() then
    --- pos = ent:GetBoneMatrix(0):GetTranslation()
    --- end
    --- ```
    --- **NOTE**: This function returns the bone position from the last tick, so if your framerate is higher than the server's tickrate it may appear to lag behind if used on a fast moving entity. You can fix this by using the bone's matrix instead:
    --- ```lua
    --- local matrix = entity:GetBoneMatrix(0)
    --- local pos = matrix:GetTranslation()
    --- local ang = matrix:GetAngles()
    --- ```
    --- **BUG**: [This can return the server's position during server lag.](https://github.com/Facepunch/garrysmod-issues/issues/884
    --- **BUG**: [This can return garbage serverside or Global.Vector(0,0,0) for v49 models.](https://github.com/Facepunch/garrysmod-issues/issues/3285
    --- **BUG**: [This can return garbage if a trace passed through the target bone during bone matrix access.](https://github.com/Facepunch/garrysmod-issues/issues/3739
    -- @param boneIndex --- The bone index of the bone to get the position of, starting at index 0. See Entity:LookupBone.
    -- @return --- The bone's position relative to the world. It can return nothing if the requested bone is out of bounds, or the entity has no model.
    -- @return --- The bone's angle relative to the world.
    GetBonePosition: function(self, boneIndex: number): GVector, GAngle

    --- Returns the surface property of the specified bone. See util.GetSurfaceData for more details about what they are.
    -- @param bone --- The bone id, starting at index 0. See Entity:LookupBone.
    -- @return --- The surface property of the bone to be used with util.GetSurfaceIndex or an empty string on failure.
    GetBoneSurfaceProp: function(self, bone: number): string

    --- Returns info about given plane of non-nodraw brush model surfaces of the entity's model. Works on worldspawn as well.
    --- **WARNING**: This only works on entities with brush models.
    -- @param id --- The index of the plane to get info of. Starts from 0.
    -- @return --- The origin of the plane.
    --- This will be either the first vertex's position (if available) or the plane's normal multiplied by the plane's distance.
    -- @return --- The normal of the plane.
    -- @return --- The "distance" of the plane.
    --- The distance is the dot product of the plane's normal and the point it was initialized with.
    GetBrushPlane: function(self, id: number): GVector, GVector, number

    --- Returns the amount of planes of non-nodraw brush model surfaces of the entity's model.
    -- @return --- The amount of brush model planes of the entity's model. This will be 0 for any non-brush model.
    GetBrushPlaneCount: function(self): number

    --- Returns a table of brushes surfaces for brush model entities.
    -- @return --- A list of SurfaceInfo elements if the entity has a brush model, or `nil` otherwise.
    GetBrushSurfaces: function(self): {GSurfaceInfo}

    --- Returns the specified hook callbacks for this entity added with Entity:AddCallback
    --- The callbacks can then be removed with Entity:RemoveCallback.
    -- @param hook --- The hook to retrieve the callbacks from, see Entity Callbacks for the possible hooks.
    -- @return --- A table containing the callbackid and function of all the callbacks for the specified hook
    GetCallbacks: function(self, hook: string): table

    --- Returns ids of child bones of given bone.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L196-L210)
    -- @param boneid --- Bone id to lookup children of
    -- @return --- A table of bone ids
    GetChildBones: function(self, boneid: number): table

    --- Gets the children of the entity - that is, every entity whose move parent is this entity.
    --- **NOTE**: This function returns Entity:SetMoveParent children, **NOT** Entity:SetParent!
    --- Entity:SetParent however also calls Entity:SetMoveParent.
    --- This means that some entities in the returned list might have a NULL Entity:GetParent.
    --- This also means that using this function on players will return their weapons on the client but not the server.
    -- @return --- A list of movement children entities
    GetChildren: function(self): {GEntity}

    --- Returns the classname of a entity. This is often the name of the Lua file or folder containing the files for the entity
    -- @return --- The entity's classname
    GetClass: function(self): string

    --- Returns an entity's collision bounding box.
    --- In most cases, this will return the same bounding box as Entity:GetModelBounds unless the entity does not have a physics mesh or it has a PhysObj different from the default.
    --- Collision bounds can be previewed in singleplayer via `ent_bbox` console command, while looking at a desired entity and with `developer 1`. (Will appear as an orange wireframe box)
    -- @return --- The minimum vector of the collision bounds, basically Entity:OBBMins.
    -- @return --- The maximum vector of the collision bounds, basically Entity:OBBMaxs.
    GetCollisionBounds: function(self): GVector, GVector

    --- Returns the entity's collision group
    -- @return --- The collision group. See Enums/COLLISION_GROUP
    GetCollisionGroup: function(self): E_COLLISION_GROUP

    --- Returns the color the entity is set to.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L167-L176)
    -- @return --- The color of the entity as a Color.
    GetColor: function(self): GColor

    --- Returns the color the entity is set to without using a color object.
    --- **INTERNAL**: Internally used to implement Entity:GetColor.
    -- @return r ---
    -- @return g ---
    -- @return b ---
    -- @return a ---
    GetColor4Part: function(self): number, number, number, number

    --- Returns the two entities involved in a constraint ent, or nil if the entity is not a constraint.
    -- @return --- ent1
    -- @return --- ent2
    GetConstrainedEntities: function(self): GEntity, GEntity

    --- Returns the two entities physobjects involved in a constraint ent, or no value if the entity is not a constraint.
    -- @return --- phys1
    -- @return --- phys2
    GetConstrainedPhysObjects: function(self): GPhysObj, GPhysObj

    --- Returns entity's creation ID. Unlike Entity:EntIndex or Entity:MapCreationID.
    --- It will increase up until value of `10 000 000`, at which point it will reset back to `0`.
    -- @return --- The creation ID
    GetCreationID: function(self): number

    --- Returns the time the entity was created on, relative to Global.CurTime.
    -- @return --- The time the entity was created on.
    GetCreationTime: function(self): number

    --- Gets the creator of the SENT.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/entity.lua#L81-L83)
    -- @return --- The creator, NULL for no creator.
    GetCreator: function(self): GPlayer

    --- Returns whether this entity uses custom collision check set by Entity:SetCustomCollisionCheck.
    -- @return --- Whether this entity uses custom collision check or not
    GetCustomCollisionCheck: function(self): boolean

    --- Returns the frame of the currently played sequence. This will be a number between 0 and 1 as a representation of sequence progress.
    -- @return --- The frame of the currently played sequence
    GetCycle: function(self): number

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get an angle stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested angle.
    GetDTAngle: function(self, key: number): GAngle

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get a boolean stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested boolean.
    GetDTBool: function(self, key: number): boolean

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Returns an entity stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested entity.
    GetDTEntity: function(self, key: number): GEntity

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get a float stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested float.
    GetDTFloat: function(self, key: number): number

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get an integer stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- 32-bit signed integer
    GetDTInt: function(self, key: number): number

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get a string stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 3.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested string.
    GetDTString: function(self, key: number): string

    --- **INTERNAL**:
    --- This is called internally by the Entity:NetworkVar system, you can use this in cases where using NetworkVar is not possible.
    --- Get a vector stored in the datatable of the entity.
    -- @param key --- Goes from 0 to 31.
    --- Specifies what key to grab from datatable.
    -- @return --- Requested vector.
    GetDTVector: function(self, key: number): GVector

    --- Returns a bit flag of all engine flags of the entity.
    -- @return --- Engine flags, see Enums/EFL
    GetEFlags: function(self): number

    --- Returns internal data about editable Entity:NetworkVars.
    --- This is used internally by DEntityProperties and Editable Entities system.
    --- **NOTE**: This function will only work on entities which had Entity:InstallDataTable called on them, which is done automatically for players and all Scripted Entities
    -- @return data --- The internal data
    GetEditingData: function(self): table

    --- Returns a bit flag of all engine effect flags of the entity.
    -- @return --- Engine effect flags, see Enums/EF
    GetEffects: function(self): number

    --- Returns the elasticity of this entity, used by some flying entities such as the Helicopter NPC to determine how much it should bounce around when colliding.
    -- @return --- elasticity
    GetElasticity: function(self): number

    --- Returns all flags of given entity.
    -- @return --- Flags of given entity as a bitflag, see Enums/FL
    GetFlags: function(self): number

    --- Returns acceptable value range for the flex controller, as defined by the model.
    --- Used with Entity:SetFlexWeight.
    -- @param flex --- The ID of the flex to look up bounds of
    -- @return --- The minimum value for this flex
    -- @return --- The maximum value for this flex
    GetFlexBounds: function(self, flex: number): number, number

    --- Returns the ID of the flex based on the beginning or the entire name.
    -- @param name --- The name of the flex to get the ID of. Case sensitive.
    -- @return --- The ID of flex
    --- * `nil` if no flex with given name was found
    GetFlexIDByName: function(self, name: string): number

    --- Returns the flex controller name at given index.
    -- @param id --- The flex index to look up name of. The range is between `0` and Entity:GetFlexNum - 1.
    -- @return --- The flex name, or no value if the requested ID is out of bounds.
    GetFlexName: function(self, id: number): string

    --- Returns the number of flex controllers this entity's model has.
    --- **NOTE**: Please note that while this function can return the real number of flex controllers, the game supports only a certain amount due to networking limitations. See Entity:SetFlexWeight.
    -- @return --- The number of flexes.
    GetFlexNum: function(self): number

    --- Returns the flex scale of the entity.
    -- @return --- The flex scale
    GetFlexScale: function(self): number

    --- Returns flex controller type or "category". Used internally by Faceposer to categorize flex controllers.
    -- @param id --- The flex index to look up type of. The range is between `0` and Entity:GetFlexNum - 1.
    -- @return --- The flex type, or no value if the requested ID is out of bounds.
    GetFlexType: function(self, id: number): string

    --- Returns current weight ( value ) of given flex controller. Please see Entity:SetFlexWeight regarding limitations.
    -- @param flex --- The ID of the flex to get weight of
    -- @return --- The current weight of the flex, or 0 if out of bounds.
    GetFlexWeight: function(self, flex: number): number

    --- Returns the forward vector of the entity, as a normalized direction vector
    -- @return --- forwardDir
    GetForward: function(self): GVector

    --- Returns the friction modifier for this entity. Entities default to `1` (100%) and can be higher.
    -- @return --- friction
    GetFriction: function(self): number

    --- Gets the gravity multiplier of the entity.
    -- @return --- gravityMultiplier
    GetGravity: function(self): number

    --- Returns the object the entity is standing on.
    -- @return --- The ground entity.
    GetGroundEntity: function(self): GEntity

    --- Returns the entity's ground speed velocity, which is based on the entity's walk/run speed and/or the ground speed of their sequence ( Entity:GetSequenceGroundSpeed ). Will return an empty Vector if the entity isn't moving on the ground.
    -- @return --- The ground speed velocity.
    GetGroundSpeedVelocity: function(self): GVector

    --- Gets the bone the hit box is attached to.
    -- @param hitbox --- The number of the hit box.
    -- @param hboxset --- The number of the hit box set. This should be 0 in most cases.
    --- Numbering for these sets start from 0. The total amount of sets can be found with Entity:GetHitBoxSetCount.
    -- @return --- The number of the bone. Will be nil if the hit box index was out of range.
    GetHitBoxBone: function(self, hitbox: number, hboxset: number): number

    --- Gets the bounds (min and max corners) of a hit box.
    -- @param hitbox --- The number of the hit box.
    -- @param set --- The hitbox set of the hit box. This should be 0 in most cases.
    -- @return --- Hit box mins. Will be nil if the hit box index was out of range.
    -- @return --- Hit box maxs. Will be nil if the hit box index was out of range.
    GetHitBoxBounds: function(self, hitbox: number, set: number): GVector, GVector

    --- Gets how many hit boxes are in a given hit box set.
    -- @param set --- The number of the hit box set.
    -- @return --- The number of hit boxes.
    GetHitBoxCount: function(self, set: number): number

    --- @deprecated
    --- **DEPRECATED**: You should use Entity:GetHitboxSetCount instead.
    --- Returns the number of hit box sets that an entity has. Functionally identical to Entity:GetHitboxSetCount
    -- @return --- number of hit box sets
    GetHitBoxGroupCount: function(self): number

    --- Gets the hit group of a given hitbox in a given hitbox set.
    -- @param hitbox --- The number of the hit box.
    -- @param hitboxset --- The number of the hit box set. This should be 0 in most cases.
    --- Numbering for these sets start from 0. The total group count can be found with Entity:GetHitBoxSetCount.
    -- @return group --- The hitbox group of given hitbox. See Enums/HITGROUP
    GetHitBoxHitGroup: function(self, hitbox: number, hitboxset: number): number

    --- Returns entity's current hit box set
    -- @return --- The current hit box set id, or no value if the entity doesn't have hit boxes
    -- @return --- The current hit box set name, or no value if the entity doesn't have hit boxes
    GetHitboxSet: function(self): number, string

    --- Returns the amount of hitbox sets in the entity.
    -- @return --- The amount of hitbox sets in the entity.
    GetHitboxSetCount: function(self): number

    --- An interface for accessing internal key values on entities.
    --- See Entity:GetSaveTable for a more detailed explanation. See Entity:SetSaveValue for the opposite of this function.
    -- @param variableName --- Name of variable corresponding to an entity save value.
    -- @return --- The internal variable value.
    GetInternalVariable: function(self, variableName: string): any

    --- Returns a table containing Hammer key values the entity has stored. **Not all key values will be accessible this way.** Use GM:EntityKeyValue or ENTITY:KeyValue to capture and store every key value.
    --- Single key values can usually be retrieved with Entity:GetInternalVariable.
    --- Here's a list of keyvalues that will not appear in this list, as they are not stored/defined as actual keyvalues internally:
    --- * rendercolor - Entity:GetColor (Only RGB)
    --- * rendercolor32 - Entity:GetColor (RGBA)
    --- * renderamt - Entity:GetColor (Alpha)
    --- * disableshadows - EF_NOSHADOW
    --- * mins - Entity:GetCollisionBounds
    --- * maxs - Entity:GetCollisionBounds
    --- * disablereceiveshadows - EF_NORECEIVESHADOW
    --- * nodamageforces - EFL_NO_DAMAGE_FORCES
    --- * angle - Entity:GetAngles
    --- * angles - Entity:GetAngles
    --- * origin - Entity:GetPos
    --- * targetname - Entity:GetName
    -- @return --- A table of key values.
    GetKeyValues: function(self): table

    --- Returns the animation cycle/frame for given layer.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entities.
    -- @param layerID --- The Layer ID
    -- @return --- The animation cycle/frame for given layer.
    GetLayerCycle: function(self, layerID: number): number

    --- Returns the duration of given layer.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entities.
    -- @param layerID --- The Layer ID
    -- @return --- The duration of the layer
    GetLayerDuration: function(self, layerID: number): number

    --- Returns the layer playback rate. See also Entity:GetLayerDuration.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entities.
    -- @param layerID --- The Layer ID
    -- @return rate --- The current playback rate.
    GetLayerPlaybackRate: function(self, layerID: number): number

    --- Returns the sequence id of given layer.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entities.
    -- @param layerID --- The Layer ID.
    -- @return --- The sequenceID of the layer.
    GetLayerSequence: function(self, layerID: number): number

    --- Returns the current weight of the layer. See Entity:SetLayerWeight for more information.
    --- **NOTE**: This function only works on BaseAnimatingOverlay entities.
    -- @param layerID --- The Layer ID
    -- @return --- The current weight of the layer
    GetLayerWeight: function(self, layerID: number): number

    --- Returns the entity that is being used as the light origin position for this entity.
    -- @return --- The lighting entity. This will usually be NULL.
    GetLightingOriginEntity: function(self): GEntity

    --- Returns the rotation of the entity relative to its parent entity.
    -- @return --- Relative angle
    GetLocalAngles: function(self): GAngle

    --- Returns the non-VPhysics angular velocity of the entity relative to its parent entity.
    -- @return --- The velocity
    GetLocalAngularVelocity: function(self): GAngle

    --- Returns entity's position relative to it's Entity:GetParent.
    --- See Entity:GetPos for the absolute position.
    -- @return --- Relative position
    GetLocalPos: function(self): GVector

    --- Gets the entity's angle manipulation of the given bone. This is relative to the default angle, so the angle is zero when unmodified.
    -- @param boneID --- The bone's ID
    -- @return --- The entity's angle manipulation of the given bone.
    GetManipulateBoneAngles: function(self, boneID: number): GAngle

    --- Returns the jiggle amount of the entity's bone.
    --- See Entity:ManipulateBoneJiggle for more info.
    -- @param boneID --- The bone ID
    -- @return --- The jiggle bone type, as set by Entity:ManipulateBoneJiggle.
    GetManipulateBoneJiggle: function(self, boneID: number): number

    --- Gets the entity's position manipulation of the given bone. This is relative to the default position, so it is zero when unmodified.
    -- @param boneId --- The bone's ID
    -- @return --- The entity's position manipulation of the given bone.
    GetManipulateBonePosition: function(self, boneId: number): GVector

    --- Gets the entity's scale manipulation of the given bone. Normal scale is Vector( 1, 1, 1 )
    -- @param boneID --- The bone's ID
    -- @return --- The entity's scale manipulation of the given bone
    GetManipulateBoneScale: function(self, boneID: number): GVector

    --- Returns the material override for this entity.
    --- Returns an empty string if no material override exists. Use Entity:GetMaterials to list its default materials.
    --- **BUG**: [The server's value takes priority on the client.](https://github.com/Facepunch/garrysmod-issues/issues/3362
    -- @return --- material
    GetMaterial: function(self): string

    --- Returns the [surface material type](https://developer.valvesoftware.com/wiki/Material_Types) of this entity.
    --- This can be approximated clientside via util.GetModelInfo.
    --- Internally, all this does is return `gamematerial` of the surface property on the first physics object of the entity. You can do this yourself using PhysObj:GetMaterial and util.GetSurfaceData.
    -- @return --- Surface material type.
    GetMaterialType: function(self): E_MAT

    --- Returns all materials of the entity's model.
    --- This function is unaffected by Entity:SetSubMaterial as it returns the original materials.
    --- **BUG**: The table returned by this function will not contain materials if they are missing from the disk/repository. This means that if you are attempting to find the ID of a material to replace with Entity:SetSubMaterial and there are missing materials on the model, all subsequent materials will be offset in the table, meaning that the ID you are trying to get will be incorrect.
    -- @return --- A table containing full paths to the materials of the model.
    --- For models, it's limited to 128 materials.
    GetMaterials: function(self): table

    --- Returns the max health that the entity was given. It can be set via Entity:SetMaxHealth.
    -- @return --- Max health.
    GetMaxHealth: function(self): number

    --- Gets the model of given entity.
    --- **BUG**: This does not necessarily return the model's path, as is the case for brush and virtual models. This is intentional behaviour, however, there is currently no way to retrieve the actual file path.
    --- This also affects certain models that are edited by 3rd party programs after being compiled.
    -- @return --- The entity's model. Will be a filesystem path for most models.
    --- This is guaranteed to be lower case.
    --- This will be nil for entities which cannot have models, such as point entities.
    GetModel: function(self): string|nil

    --- Returns the entity's model bounds, not scaled by Entity:SetModelScale.
    --- These bounds are affected by all the animations the model has at compile time, if they go outside of the models' render bounds at any point.
    --- See Entity:GetModelRenderBounds for just the render bounds of the model.
    --- This is different than the collision bounds/hull, which are set via Entity:SetCollisionBounds.
    -- @return --- The minimum vector of the bounds
    -- @return --- The maximum vector of the bounds
    GetModelBounds: function(self): GVector, GVector

    --- Returns the contents of the entity's current model.
    -- @return --- The contents of the entity's model. See Enums/CONTENTS.
    GetModelContents: function(self): number

    --- Gets the physics bone count of the entity's model. This is only applicable to `anim` type Scripted Entities with ragdoll models.
    -- @return --- How many physics bones exist on the model.
    GetModelPhysBoneCount: function(self): number

    --- Gets the models radius.
    -- @return --- The radius of the model.
    --- **WARNING**: This can return nil instead of a number in some cases.
    GetModelRadius: function(self): number

    --- Returns the entity's model render bounds. Unlike Entity:GetModelBounds, bounds returning by this function will not be affected by animations (at compile time).
    -- @return --- The minimum vector of the bounds
    -- @return --- The maximum vector of the bounds
    GetModelRenderBounds: function(self): GVector, GVector

    --- Gets the selected entity's model scale.
    -- @return --- Scale of that entity's model.
    GetModelScale: function(self): number

    --- Returns the amount a momentary_rot_button entity is turned based on the given angle. 0 meaning completely turned closed, 1 meaning completely turned open.
    --- **WARNING**: This only works on momentary_rot_button entities.
    -- @param turnAngle --- The angle of rotation to compare - usually should be Entity:GetAngles.
    -- @return --- The amount the momentary_rot_button is turned, ranging from 0 to 1, or nil if the entity is not a momentary_rot_button.
    GetMomentaryRotButtonPos: function(self, turnAngle: GAngle): number

    --- Returns the move collide type of the entity. The move collide is the way a physics object reacts to hitting an object - will it bounce, slide?
    -- @return --- The move collide type, see Enums/MOVECOLLIDE
    GetMoveCollide: function(self): number

    --- Returns the movement parent of this entity.
    --- See Entity:SetMoveParent for more info.
    -- @return --- The movement parent of this entity.
    GetMoveParent: function(self): GEntity

    --- Returns the entity's movetype
    -- @return --- Move type. See Enums/MOVETYPE
    GetMoveType: function(self): number

    --- Gets the NPC classification. Internally gets the `m_iClass` variable which is polled by the engine. This will be equivalent to NPC:Classify.
    --- **NOTE**: This is a helper function only available if your SENT is based on `base_ai`
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/base/entities/entities/base_ai/init.lua#L14)
    -- @return --- See Enums/CLASS
    GetNPCClass: function(self): number


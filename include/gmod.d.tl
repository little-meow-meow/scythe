    -- @return --- Whether a constraint can or should be created.
    CanConstrain: function(ent: GEntity, bone: number): boolean

    --- Creates a rope without any constraint.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/modules/constraint.lua#L296-L346)
    -- @param pos --- Position for the rope entity. Unknown effect, probably none.
    -- @param width --- Width of the rope.
    -- @param material --- Material of the rope. If unset, will be solid black.
    -- @param constraint --- Constraint for the rope. If set, the rope will be deleted when the constraint entity is.
    -- @param ent1 --- First entity.
    -- @param localPos1 --- Position relative to the the first physics object to constrain to.

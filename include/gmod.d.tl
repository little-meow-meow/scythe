global type E_DEATH_NOTICE = number
--- Was the victim friendly?
global DEATH_NOTICE_FRIENDLY_VICTIM: E_DEATH_NOTICE = 1
--- Was the attacker friendly?
global DEATH_NOTICE_FRIENDLY_ATTACKER: E_DEATH_NOTICE = 2

--- Displacement surface flags, used by the Structures/TraceResult.
global type E_DISPSURF = number
global DISPSURF_SURFACE: E_DISPSURF = 1
global DISPSURF_WALKABLE: E_DISPSURF = 2
global DISPSURF_BUILDABLE: E_DISPSURF = 4
global DISPSURF_SURFPROP1: E_DISPSURF = 8
global DISPSURF_SURFPROP2: E_DISPSURF = 16

--- Enumerations used by CTakeDamageInfo:GetDamageType, CTakeDamageInfo:SetDamageType and CTakeDamageInfo:IsDamageType.
--- This enumeration is a bit field/bitflag, which means that you can combine multiple damage types using the bit library. You can use bit.band to test if a specific damage type is set.
global type E_DMG = number
--- Generic damage (used by weapon_fists)
global DMG_GENERIC: E_DMG = 0
--- Caused by physics interaction and ignored by airboat drivers. This is used by the Rollermine and an unused animation attack called 'Fireattack' by the Antlion Guard [ACT_RANGE_ATTACK1](https://wiki.facepunch.com/gmod/Enums/ACT)
global DMG_CRUSH: E_DMG = 1
--- Bullet damage from Ceiling Turrets, the Strider, Turrets and most guns.
global DMG_BULLET: E_DMG = 2
--- Used by the Stunstick, Manhacks, Antlions, Antlion Guards, Headcrabs, Fast Headcrabs, all Zombies types, Hunter, and potentially other NPCs attacks
global DMG_SLASH: E_DMG = 4
--- Damage from fire
global DMG_BURN: E_DMG = 8
--- Hit by a vehicle (This will need to be set for passengers of some vehicle to receive damage)
global DMG_VEHICLE: E_DMG = 16
--- Fall damage
global DMG_FALL: E_DMG = 32
--- Explosion damage like grenades, helicopter bombs, combine mines, Will be ignored by most vehicle passengers.
global DMG_BLAST: E_DMG = 64
--- Blunt attacks such as from the Crowbar, Antlion Guard & Hunter
global DMG_CLUB: E_DMG = 128
--- Electrical damage, shows smoke at the damage position and its used by Stalkers & Vortigaunts
global DMG_SHOCK: E_DMG = 256
--- Sonic damage, used by the Gargantua and Houndeye NPCs
global DMG_SONIC: E_DMG = 512
--- Laser damage
global DMG_ENERGYBEAM: E_DMG = 1024
--- Prevent a physics force.
global DMG_PREVENT_PHYSICS_FORCE: E_DMG = 2048
--- Crossbow damage, never creates gibs.
global DMG_NEVERGIB: E_DMG = 4096
--- Always create gibs
global DMG_ALWAYSGIB: E_DMG = 8192
--- Drown damage
global DMG_DROWN: E_DMG = 16384
--- Same as DMG_POISON
global DMG_PARALYZE: E_DMG = 32768
--- Neurotoxin damage
global DMG_NERVEGAS: E_DMG = 65536
--- Poison damage used by Antlion Workers & Poison Headcrabs.
global DMG_POISON: E_DMG = 131072
--- Radiation damage & it will be ignored by most vehicle passengers
global DMG_RADIATION: E_DMG = 262144
--- Damage applied to the player to restore health after drowning
global DMG_DROWNRECOVER: E_DMG = 524288
--- Toxic chemical or acid burn damage used by the Antlion Workers
global DMG_ACID: E_DMG = 1048576
--- In an oven
global DMG_SLOWBURN: E_DMG = 2097152
--- Don't create a ragdoll on death
global DMG_REMOVENORAGDOLL: E_DMG = 4194304
--- Damage done by the gravity gun.
global DMG_PHYSGUN: E_DMG = 8388608
--- Plasma damage
global DMG_PLASMA: E_DMG = 16777216
--- Airboat gun damage
global DMG_AIRBOAT: E_DMG = 33554432
--- Forces the entity to dissolve on death. This is what the combine ball uses when it hits a target.
global DMG_DISSOLVE: E_DMG = 67108864
--- This won't hurt the player underwater
global DMG_BLAST_SURFACE: E_DMG = 134217728
--- Direct damage to the entity that does not go through any damage value modifications
global DMG_DIRECT: E_DMG = 268435456
--- The pellets fired from a shotgun
global DMG_BUCKSHOT: E_DMG = 536870912
--- Damage from SniperRound/SniperPenetratedRound ammo types
global DMG_SNIPER: E_DMG = 1073741824
--- Damage from npc_missiledefense, npc_combinegunship, or monster_mortar
global DMG_MISSILEDEFENSE: E_DMG = 2147483648

--- Enumerations used by Panel:Dock.
--- **NOTE**: These enumerations doesn't have DOCK_ prefix, this is an exception from all other enumerations.
global type E_DOCK = number
--- Don't dock
global NODOCK: E_DOCK = 0
--- Fill parent
global FILL: E_DOCK = 1
--- Dock to the left
global LEFT: E_DOCK = 2
--- Dock to the right
global RIGHT: E_DOCK = 3
--- Dock to the top
global TOP: E_DOCK = 4
--- Dock to the bottom
global BOTTOM: E_DOCK = 5

--- Internal globals for SimpleDoF.
global type E_DOF = number
global DOF_OFFSET: E_DOF = 256
global DOF_SPACING: E_DOF = 512

--- Enumerations used by Entity:AddEffects,  Entity:RemoveEffects and  Entity:IsEffectActive.
global type E_EF = number
--- Performs bone merge on client side, merging bone positions of child entities (Entity:SetParent) with those of the parent, by bone names. The skeletons should have identical proportions, however it is not a requirement.
global EF_BONEMERGE: E_EF = 1
--- For use with EF_BONEMERGE. If this is set, then it places this ents origin at its parent and uses the parent's bbox + the max extents of the aiment. Otherwise, it sets up the parent's bones every frame to figure out where to place the aiment, which is inefficient because it'll setup the parent's bones even if the parent is not in the PVS.
global EF_BONEMERGE_FASTCULL: E_EF = 128
--- DLIGHT centered at entity origin.
global EF_BRIGHTLIGHT: E_EF = 2
--- Player flashlight.
global EF_DIMLIGHT: E_EF = 4
--- @deprecated
--- **DEPRECATED**: Seems to have no effect. Has been replaced with [C_BaseEntity::IsNoInterpolationFrame()](https://github.com/ValveSoftware/source-sdk-2013/blob/master/src/game/client/c_baseentity.h#L1331-L1332).
--- Don't interpolate the next frame.
global EF_NOINTERP: E_EF = 8
--- Disables shadow.
global EF_NOSHADOW: E_EF = 16
--- Prevents the entity from drawing and networking.
global EF_NODRAW: E_EF = 32
--- Don't receive shadows.
global EF_NORECEIVESHADOW: E_EF = 64
--- Makes the entity blink.
global EF_ITEM_BLINK: E_EF = 256
--- Always assume that the parent entity is animating.
global EF_PARENT_ANIMATES: E_EF = 512
--- Internal flag that is set by Entity:FollowBone.
global EF_FOLLOWBONE: E_EF = 1024
--- GMod-specific. Makes the entity not accept being lit by projected textures, including the player's flashlight.
global EF_NOFLASHLIGHT: E_EF = 8192

--- Enumerations used by Entity:AddEFlags, Entity:RemoveEFlags and Entity:IsEFlagSet.
global type E_EFL = number
--- This entity is marked for death -- This allows the game to actually delete ents at a safe time.
--- **WARNING**: You should never set this flag manually.
global EFL_KILLME: E_EFL = 1
--- Entity is dormant, no updates to client
global EFL_DORMANT: E_EFL = 2
--- Lets us know when the noclip command is active
global EFL_NOCLIP_ACTIVE: E_EFL = 4
--- Set while a model is setting up its bones
global EFL_SETTING_UP_BONES: E_EFL = 8
--- This is a special entity that should not be deleted when we respawn entities via game.CleanUpMap.
global EFL_KEEP_ON_RECREATE_ENTITIES: E_EFL = 16
--- One of the child entities is a player
global EFL_HAS_PLAYER_CHILD: E_EFL = 16
--- (Client only) need shadow manager to update the shadow
global EFL_DIRTY_SHADOWUPDATE: E_EFL = 32
--- Another entity is watching events on this entity (used by teleport)
global EFL_NOTIFY: E_EFL = 64
--- The default behavior in ShouldTransmit is to not send an entity if it doesn't have a model. Certain entities want to be sent anyway because all the drawing logic is in the client DLL. They can set this flag and the engine will transmit them even if they don't have model
global EFL_FORCE_CHECK_TRANSMIT: E_EFL = 128
--- This is set on bots that are frozen
global EFL_BOT_FROZEN: E_EFL = 256
--- Non-networked entity
global EFL_SERVER_ONLY: E_EFL = 512
--- Don't attach the edict
global EFL_NO_AUTO_EDICT_ATTACH: E_EFL = 1024
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute position needs to be recalculated.
global EFL_DIRTY_ABSTRANSFORM: E_EFL = 2048
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute velocity needs to be recalculated.
global EFL_DIRTY_ABSVELOCITY: E_EFL = 4096
--- Some 'dirty' bits with respect to absolute computations. Used internally by the engine when an entity's absolute angular velocity needs to be recalculated.
global EFL_DIRTY_ABSANGVELOCITY: E_EFL = 8192
--- Marks the entity as having a 'dirty' surrounding box. Used internally by the engine to recompute the entity's collision bounds.
global EFL_DIRTY_SURROUNDING_COLLISION_BOUNDS: E_EFL = 16384
--- Used internally by the engine when an entity's "spatial partition" needs to be recalculated.
global EFL_DIRTY_SPATIAL_PARTITION: E_EFL = 32768
--- This is set if the entity detects that it's in the skybox. This forces it to pass the "in PVS" for transmission
global EFL_IN_SKYBOX: E_EFL = 131072
--- Entities with this flag set show up in the partition even when not solid
global EFL_USE_PARTITION_WHEN_NOT_SOLID: E_EFL = 262144
--- Used to determine if an entity is floating
global EFL_TOUCHING_FLUID: E_EFL = 524288
--- The entity is currently being lifted by a Barnacle.
global EFL_IS_BEING_LIFTED_BY_BARNACLE: E_EFL = 1048576
--- The entity is not affected by 'rotorwash push'--the wind-push effect caused by helicopters close to the ground in Half-Life 2.
global EFL_NO_ROTORWASH_PUSH: E_EFL = 2097152
--- Avoid executing the entity's Think
global EFL_NO_THINK_FUNCTION: E_EFL = 4194304
--- The entity is currently not simulating any physics.
global EFL_NO_GAME_PHYSICS_SIMULATION: E_EFL = 8388608
--- The entity is about to have its untouch callback checked, e.g. when this entity stops touching another entity.
global EFL_CHECK_UNTOUCH: E_EFL = 16777216
--- Entity shouldn't block NPC line-of-sight
global EFL_DONTBLOCKLOS: E_EFL = 33554432
--- NPCs should not walk on this entity
global EFL_DONTWALKON: E_EFL = 67108864
--- The entity shouldn't dissolve
global EFL_NO_DISSOLVE: E_EFL = 134217728
--- Mega physcannon can't ragdoll these guys
global EFL_NO_MEGAPHYSCANNON_RAGDOLL: E_EFL = 268435456
--- Don't adjust this entity's velocity when transitioning into water
global EFL_NO_WATER_VELOCITY_CHANGE: E_EFL = 536870912
--- Physcannon can't pick these up or punt them
global EFL_NO_PHYSCANNON_INTERACTION: E_EFL = 1073741824
--- Doesn't accept forces from physics damage
global EFL_NO_DAMAGE_FORCES: E_EFL = -2147483648

--- Enumerations used by Global.AddConsoleCommand, concommand.Add, Global.CreateClientConVar and Global.CreateConVar.
global type E_FCVAR = number
--- Save the ConVar value into either client.vdf or server.vdf
--- Reported as "a" by `cvarlist`, except Lua ConVars
global FCVAR_ARCHIVE: E_FCVAR = 128
--- Save the ConVar value into config.vdf on XBox
global FCVAR_ARCHIVE_XBOX: E_FCVAR = 16777216
--- Requires `sv_cheats` to be enabled to change the ConVar or run the command
--- Reported as "cheat" by `cvarlist`
global FCVAR_CHEAT: E_FCVAR = 16384
--- `IVEngineClient::ClientCmd` is allowed to execute this command
--- Reported as "clientcmd_can_execute" by `cvarlist`
global FCVAR_CLIENTCMD_CAN_EXECUTE: E_FCVAR = 1073741824
--- ConVar is defined by the client DLL.
--- This flag is set automatically
--- Reported as "cl" by `cvarlist`
global FCVAR_CLIENTDLL: E_FCVAR = 8
--- Force the ConVar to be recorded by demo recordings.
--- Reported as "demo" by `cvarlist`
global FCVAR_DEMO: E_FCVAR = 65536
--- Opposite of [FCVAR_DEMO](#FCVAR_DEMO), ensures the ConVar is not recorded in demos
--- Reported as "norecord" by `cvarlist`
global FCVAR_DONTRECORD: E_FCVAR = 131072
--- ConVar is defined by the game DLL.
--- This flag is set automatically
--- Reported as "sv" by `cvarlist`
global FCVAR_GAMEDLL: E_FCVAR = 4
--- Set automatically on all ConVars and console commands created by the client Lua state.
--- Reported as "lua_client" by `cvarlist`
global FCVAR_LUA_CLIENT: E_FCVAR = 262144
--- Set automatically on all ConVars and console commands created by the server Lua state.
--- Reported as "lua_server" by `cvarlist`
global FCVAR_LUA_SERVER: E_FCVAR = 524288
--- Tells the engine to never print this variable as a string. This is used for variables which may contain control characters.
--- Reported as "numeric" by `cvarlist`
global FCVAR_NEVER_AS_STRING: E_FCVAR = 4096
--- No flags
global FCVAR_NONE: E_FCVAR = 0
--- For serverside ConVars, notifies all players with blue chat text when the value gets changed, also makes the convar appear in [A2S_RULES](https://developer.valvesoftware.com/wiki/Server_queries#A2S_RULES)
--- Reported as "nf" by `cvarlist`
global FCVAR_NOTIFY: E_FCVAR = 256
--- Makes the ConVar not changeable while connected to a server or in singleplayer
global FCVAR_NOT_CONNECTED: E_FCVAR = 4194304
--- Forces the ConVar to only have printable characters (No control characters)
--- Reported as "print" by `cvarlist`
global FCVAR_PRINTABLEONLY: E_FCVAR = 1024
--- Makes the ConVar value hidden from all clients (For example `sv_password`)
--- Reported as "prot" by `cvarlist`
global FCVAR_PROTECTED: E_FCVAR = 32
--- For serverside ConVars, it will enforce its value on all clients. The ConVar with the same name must also exist on the client!
--- Reported as "rep" by `cvarlist`
global FCVAR_REPLICATED: E_FCVAR = 8192
--- Prevents the server from querying value of this ConVar
global FCVAR_SERVER_CANNOT_QUERY: E_FCVAR = 536870912
--- The server is allowed to execute this command on clients.
--- Reported as "server_can_execute" by `cvarlist`
global FCVAR_SERVER_CAN_EXECUTE: E_FCVAR = 268435456
--- Executing the command or changing the ConVar is only allowed in singleplayer
--- Reported as "sp" by `cvarlist`
global FCVAR_SPONLY: E_FCVAR = 64
--- Don't log the ConVar changes to console/log files/users
--- Reported as "log" by `cvarlist`
global FCVAR_UNLOGGED: E_FCVAR = 2048
--- If this is set, the convar will become anonymous and won't show up in the `find` results.
global FCVAR_UNREGISTERED: E_FCVAR = 1
--- For clientside commands, sends the value to the server
--- Reported as "user" by `cvarlist`
global FCVAR_USERINFO: E_FCVAR = 512


-- @param angleSize --- Angle size of the effect
-- @param radialSteps --- Amount of radial steps to render the effect with
-- @param passes --- Amount of render passes
-- @param spin --- Whether to cycle the frame or not
-- @param inView --- Table of view data
-- @param fov --- FOV to render the effect with
global function RenderDoF(origin: GVector, angle: GAngle, usableFocusPoint: GVector, angleSize: number, radialSteps: number, passes: number, spin: boolean, inView: table, fov: number)
end

--- Renders the stereoscopic post-process effect
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/postprocess/stereoscopy.lua#L11-L37)
-- @param viewOrigin --- Origin to render the effect at
-- @param viewAngles --- Angles to render the effect at
global function RenderStereoscopy(viewOrigin: GVector, viewAngles: GAngle)
end

--- Renders the Super Depth of Field post-process effect
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/postprocess/super_dof.lua#L281-L329)
-- @param viewOrigin --- Origin to render the effect at
-- @param viewAngles --- Angles to render the effect at
-- @param viewFOV --- Field of View to render the effect at
global function RenderSuperDoF(viewOrigin: GVector, viewAngles: GAngle, viewFOV: number)
end

--- Restores position of your cursor on screen. You can save it by using Global.RememberCursorPosition.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L476-L481)
global function RestoreCursorPosition()
end

--- Executes the given console command with the parameters.
--- **NOTE**: Some commands/convars are blocked from being ran/changed using this function, usually to prevent harm/annoyance to clients. For a list of blocked commands, see Blocked ConCommands.
-- @param command --- The command to be executed.
-- @param arguments --- The arguments. Note, that unlike Player:ConCommand, you must pass each argument as a new string, not separating them with a space.
global function RunConsoleCommand(command: string, ...: any)
end

--- Evaluates and executes the given code, will throw an error on failure.
--- **NOTE**: Local variables are not passed to the given code.
-- @param code --- The code to execute.
-- @param identifier --- The name that should appear in any error messages caused by this code.
-- @param handleError --- If false, this function will return a string containing any error messages instead of throwing an error.
-- @return --- If handleError is false, the error message (if any).
global function RunString(code: string, identifier: string, handleError: boolean): string
end

--- Alias of Global.RunString.
--- @deprecated
--- **DEPRECATED**: Use Global.RunString instead.
-- @param code --- The code to execute.
-- @param identifier --- The name that should appear in any error messages caused by this code.
-- @param handleError --- If false, this function will return a string containing any error messages instead of throwing an error.
-- @return --- If handleError is false, the error message (if any).
global function RunStringEx(code: string, identifier: string, handleError: boolean): string
end

--- Removes the given entity unless it is a player or the world entity.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L270-L279)
-- @param ent --- Entity to safely remove.
global function SafeRemoveEntity(ent: GEntity)
end

--- Removes entity after delay using Global.SafeRemoveEntity.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L281-L290)
-- @param entity --- Entity to be removed.
-- @param delay --- Delay for entity removal in seconds.
global function SafeRemoveEntityDelayed(entity: GEntity, delay: number)
end

--- Overwrites all presets with the supplied table. Used by the presets for preset saving
-- @param presets --- Presets to be saved
global function SavePresets(presets: table)
end

--- Returns a number based on the `size` argument and the players' screen width. This is used to scale user interface (UI) elements to be consistently sized and positioned across all screen resolutions.
--- The width is scaled in relation to `640x480` resolution, and does **not** take into account non the aspect ratio. See example below for how to adjust or that.
--- This function can also be used for scaling font sizes.
--- See Global.ScreenScaleH for a function that scales from height.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/globals.lua#L6-L8)
-- @param size --- The position or size you want to scale within 640 pixel wide screen.
-- @return --- The scaled number based on the player's screen width.
global function ScreenScale(size: number): number
end

--- Returns a number based on the `size` argument and players' screen height. The height is scaled in relation to `640x480` resolution.  This function is primarily used for scaling font sizes.
--- See Global.ScreenScale for a function that scales from width.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/client/globals.lua#L10-L12)
-- @param size --- The number you want to scale.
-- @return --- The scaled number based on your screen's height.
global function ScreenScaleH(size: number): number
end

--- Gets the height of the game's window (in pixels).
--- **NOTE**: ScrH() returns the height from the current viewport, this can be changed via render.SetViewPort, inside Render Targets and cam.Start contexts.
-- @return --- The height of the game's window in pixels
global function ScrH(): number
end

--- Gets the width of the game's window (in pixels).
--- **NOTE**: ScrW() returns the width from the current viewport, this can be changed via render.SetViewPort, inside Render Targets and cam.Start contexts.
-- @return --- The width of the game's window in pixels
global function ScrW(): number
end


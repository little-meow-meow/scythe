--- Used by the context menu in sandbox.
global interface VControlPanel is DForm
    --- @deprecated
    --- **DEPRECATED**: It is recommended to use DForm's members instead.
    --- Adds a control to the control panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L148-L431)
    -- @param type --- The control type to add. The complete list is:
    --- * header
    --- * textbox
    --- * label
    --- * checkbox/toggle
    --- * slider
    --- * propselect
    --- * matselect
    --- * ropematerial
    --- * button
    --- * numpad
    --- * color
    --- * combobox
    --- * listbox
    --- * materialgallery
    -- @param controlinfo --- Each control takes their own table structure. You may search "AddControl" on GitHub for examples.
    --- Here is a full list of each type and the table members it requires:
    --- * header
    --- * description
    --- * textbox:
    --- * label (def: "Untitled")
    --- * command
    --- * label:
    --- * text
    --- * checkbox, toggle (same thing):
    --- * label (def: "Untitled")
    --- * command
    --- * help (boolean, if true assumes label is a language string (`#tool.toolname.stuff`) and adds `.help` at the end)
    --- * slider: (DForm:NumSlider)
    --- * type (optional string, if equals `float` then 2 digits after the decimal will be used, otherwise 0)
    --- * label (def: `Untitled`)
    --- * command
    --- * min (def: `0`)
    --- * max (def: `100`)
    --- * help (boolean, see above)
    --- * propselect:
    --- * (data goes directly to PropSelect's :ControlValues(data))
    --- * matselect:
    --- * (data goes directly to MatSelect's :ControlValues(data))
    --- * ropematerial:
    --- * convar (notice: NOT called command this time!)
    --- * button:
    --- * label / text (if label is missing will use text. Def: `No Label`)
    --- * command
    --- * numpad:
    --- * command
    --- * command2
    --- * label
    --- * label2
    --- * color:
    --- * label
    --- * red (convar)
    --- * green (convar)
    --- * blue (convar)
    --- * alpha (convar)
    --- * combobox:
    --- * menubutton (if doesn't equal "1", becomes a listbox)
    --- * folder
    --- * options (optional, ha)
    --- * cvars (optional)
    --- * listbox:
    --- * height (if set, becomes DListView, otherwise is CtrlListBox)
    --- * label (def: `unknown`)
    --- * options (optional)
    --- * materialgallery:
    --- * width (def: `32`)
    --- * height (def: `32`)
    --- * rows (def: `4`)
    --- * convar
    --- * options
    -- @return --- Returns created control
    AddControl: function(self, type: string, controlinfo: table): GPanel

    --- Adds an item by calling DForm:AddItem.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L29-L34)
    -- @param panel --- Panel to add as an item to the control panel.
    AddPanel: function(self, panel: GPanel)

    --- @deprecated
    --- **DEPRECATED**:
    --- Alias of Panel:Clear.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L19-L21)
    ClearControls: function(self)

    --- Creates a CtrlColor (a color picker) panel and adds it as an item.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L94-L113)
    -- @param label --- The label for this color picker.
    -- @param convarR --- Name of the convar that will store the R component of the selected color.
    -- @param convarG --- Name of the convar that will store the G component of the selected color.
    -- @param convarB --- Name of the convar that will store the B component of the selected color.
    -- @param convarA --- Name of the convar that will store the A component of the selected color.
    -- @return --- The created CtrlColor panel.
    ColorPicker: function(self, label: string, convarR: string, convarG: string, convarB: string, convarA: string): GPanel

    --- Sets control values of the control panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L138-L145)
    -- @param data --- A two-membered table:
    --- * boolean closed - Sets if the control panel should be unexpanded.
    --- * string label - The text to display inside the control's label.
    ControlValues: function(self, data: table)

    --- Calls the given function with this panel as the only argument. Used by the spawnmenu to populate the control panel.
    --- @deprecated
    --- **DEPRECATED**: This is dumb. Just call the builder function directly.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L132-L136)
    -- @param func --- The builder function.
    --- <callback>
    --- <arg type="ControlPanel" name="panelToPopulate"></arg>
    --- </callback>
    FillViaFunction: function(self, func: function)

    --- Returns this control panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L23-L27)
    -- @return --- The same control panel the function is being called on.
    GetEmbeddedPanel: function(self): VControlPanel

    --- Creates a CtrlNumPad (a Sandbox key binder) panel and adds it as an item.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L117-L133)
    -- @param label1 --- The label for the left key binder.
    -- @param convar1 --- The name of the convar that will store the key code for player selected key of the left key binder.
    -- @param label2 --- If set and `convar2` is set, the label for the right key binder.
    -- @param convar2 --- If set and `label2` is set, the name of the convar that will store the key code for player selected key of the right key binder.
    -- @return --- The created CtrlNumPad panel.
    KeyBinder: function(self, label1: string, convar1: string, label2: string, convar2: string): GPanel

    --- Creates a MatSelect panel and adds it as an item.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L36-L57)
    -- @param convar --- Calls MatSelect:SetConVar with this value.
    -- @param options --- If specified, calls MatSelect:AddMaterial(key, value) for each table entry. If the table key is a number, the function will instead be called with the value as both arguments.
    -- @param autostretch --- If specified, calls MatSelect:SetAutoHeight with this value.
    -- @param width --- If specified, calls MatSelect:SetItemWidth with this value.
    -- @param height --- If specified, calls MatSelect:SetItemHeight with this value.
    -- @return --- The created MatSelect panel.
    MatSelect: function(self, convar: string, options: table, autostretch: boolean, width: number, height: number): VMatSelect

    --- Creates a ControlPresets panel and adds it as an item.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/controlpanel.lua#L59-L74)
    -- @param group --- The preset group. Must be unique.
    -- @param cvarList --- A table of convar names as keys and their defaults as the values. Typically the output of Tool:BuildConVarList.
    -- @return --- The created ControlPresets panel.
    ToolPresets: function(self, group: string, cvarList: table): GPanel
end

--- **INTERNAL**:
--- The ContentSidebarToolbox is internally used by the ContentSidebar and is used to change the icon of a category.
--- It internally consists of a DTextEntry, DPanel, DImageButton, Panel, ContentHeader and a DIconBrowser
global interface VContentSidebarToolbox is DDrawer

end

--- **INTERNAL**:
--- The ContentSidebar is internally used by the spawnmenu and manages things like the Spawnmenu Toolbar.
--- It internally uses a DTree which is accessible with ContentSidebar .Tree.
--- When ContentSidebar:EnableModify has been called ContentSidebar.Toolbox will return a ContentSidebarToolbox
global interface VContentSidebar is DPanel
    --- Creates a Save Notification which will be shown when SANDBOX:SpawnlistContentChanged has been called.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contentsidebar.lua#L42-L84)
    -- @param style ---
    -- @param hookname --- A Populate Hook like PopulateEntities
    CreateSaveNotification: function(self, style: string, hookname: string)

    --- Internally calls ContentSidebar:EnableSearch, ContentSidebar:CreateSaveNotification and creates a ContentSidebarToolbox which is accessible under ContentSidebar.Toolbox. Call the Hook SANDBOX:OpenToolbox to open the created Toolbox
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contentsidebar.lua#L25-L40)
    EnableModify: function(self)

    --- Creates a search bar which will be displayed over the Nodes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contentsidebar.lua#L20-L23)
    -- @param style ---
    -- @param hookname --- A Populate Hook like PopulateEntities
    EnableSearch: function(self, style: string, hookname: string)
end

--- The spawn icon used for SWEPs and other SENTs, commonly featured as part of the spawn menu.
--- Do note that at least one of your ContentIcon's parents must either be an EditablePanel or derived from it
--- (like a DFrame, for example), else it won't be able to focus and thus be unclickable.
--- This control only exists in Sandbox derived gamemodes.
global interface VContentIcon is DButton
    --- An Global.AccessorFunc that returns the color set by ContentIcon:SetColor
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L13)
    -- @return --- See Color
    GetColor: function(self): table

    --- An Global.AccessorFunc that returns the content type used to save and restore the content icon in a spawnlist.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L14)
    -- @return --- The content type, for example "entity" or "weapon".
    GetContentType: function(self): string

    --- An Global.AccessorFunc that returns a table of weapon classes for the content icon with "NPC" content type to be randomly chosen from when user tries to spawn the NPC.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L16)
    -- @return --- A table of weapon classes to be chosen from when user tries to spawn the NPC.
    GetNPCWeapon: function(self): table

    --- An Global.AccessorFunc that returns the internal "name" for the content icon, usually a class name for an entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L15)
    -- @return --- Internal "name" to be used when user left clicks the icon.
    GetSpawnName: function(self): string

    --- A hook for override, by default does nothing. Called when user right clicks on the content icon, you are supposed to open a Global.DermaMenu here with additional options.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L104-L105)
    OpenMenu: function(self)

    --- An Global.AccessorFunc that sets whether the content item is admin only. This makes the icon to display a admin icon in the top left corner of the icon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L17)
    -- @param adminOnly --- Whether this content should be admin only or not
    SetAdminOnly: function(self, adminOnly: boolean)

    --- An Global.AccessorFunc that sets the color for the content icon. Currently is not used by the content icon panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L13)
    -- @param clr --- The color to set. See Color
    SetColor: function(self, clr: table)

    --- An Global.AccessorFunc that sets the content type used to save and restore the content icon in a spawnlist.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L14)
    -- @param type --- The content type, for example "entity" or "weapon"
    SetContentType: function(self, type: string)

    --- Sets the material to be displayed as the content icon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L66-L88)
    -- @param path --- Path to the icon to use.
    --SetMaterial: function(self, path: string)

    --- An Global.AccessorFunc that sets a table of weapon classes for the content icon with "NPC" content type to be randomly chosen from when user tries to spawn the NPC.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L16)
    -- @param weapons --- A table of weapon classes to be chosen from when user tries to spawn the NPC.
    SetNPCWeapon: function(self, weapons: table)

    --- Sets the tool tip and the "nice" name to be displayed by the content icon.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L58-L64)
    -- @param name --- "Nice" name to display.
    SetName: function(self, name: string)

    --- An Global.AccessorFunc that sets the internal "name" for the content icon, usually a class name for an entity.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contenticon.lua#L15)
    -- @param name --- Internal "name" to be used when user left clicks the icon.
    SetSpawnName: function(self, name: string)
end

--- **INTERNAL**:
--- The ContentHeader is used internally by the Spawnmenu and only use this if you know
--- what you're doing because you can break a few things with it.
global interface VContentHeader is DLabelEditable
    --- Creates a Global.DermaMenu and adds a delete option before opening the menu
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contentheader.lua#L96-L105)
    -- @param style ---
    -- @param hookname --- A Populate Hook like PopulateEntities
    OpenMenu: function(self, style: string, hookname: string)

    ---
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/gamemode/spawnmenu/creationmenu/content/contentheader.lua#L44-L53)
    -- @param bigtable ---
    ToTable: function(self, bigtable: table)
end

--- **INTERNAL**: Use DCheckBoxLabel instead.
--- @deprecated
--- **DEPRECATED**: Use DCheckBoxLabel instead.
--- Engine checkbox
global interface VCheckButton

end

--- @deprecated
--- **DEPRECATED**: You should be using HTML panel, which this is an alias of.
--- Base panel for elements using the [Awesomium](http://www.awesomium.com) UI engine.
--- **NOTE**: On the `x86-64` beta this panel isn't actually Awesomium, its the same as `HTML` (`HtmlPanel`)
global interface VAwesomium is GPanel

end

--- Used to show a player's Steam avatar. You are recommended but not limited to pick one of the following sizes: 16, 32, 64, 84, 128, 184.
global interface VAvatarImage is GPanel

end

--- Used to show an icon for any of the [Garry's Mod Steam achievements](http://steamcommunity.com/stats/GarrysMod/achievements).
--- If the viewer has not unlocked the achievement on Steam, the icon will be grayed out.
global interface VAchievementIcon is GPanel

end





global MATERIAL_FOG_NONE: E_MATERIAL_FOG = 0
--- Linear fog
global MATERIAL_FOG_LINEAR: E_MATERIAL_FOG = 1
--- For use in conjunction with render.SetFogZ. Does not work if start distance is bigger than end distance. Ignores density setting. Seems to be broken? Used for underwater fog by the engine.
global MATERIAL_FOG_LINEAR_BELOW_FOG_Z: E_MATERIAL_FOG = 2

--- Enumerations used by render.SetLocalModelLights. Clientside only.
global type E_MATERIAL_LIGHT = number
--- No light
global MATERIAL_LIGHT_DISABLE: E_MATERIAL_LIGHT = 0
--- Point light
global MATERIAL_LIGHT_POINT: E_MATERIAL_LIGHT = 1
--- Directional light
global MATERIAL_LIGHT_DIRECTIONAL: E_MATERIAL_LIGHT = 2
--- Spot light
global MATERIAL_LIGHT_SPOT: E_MATERIAL_LIGHT = 3

--- Enumerations used by Global.GetRenderTargetEx. Clientside only.
--- **WARNING**: When Anti Aliasing is enabled then `MATERIAL_RT_DEPTH_SHARED` and `MATERIAL_RT_DEPTH_SEPARATE` will always create a new depth-stencil buffer because Render Targets do not have Anti Aliasing.
global type E_MATERIAL_RT_DEPTH = number
--- Do not create a depth-stencil buffer.
--- Use the default depth-stencil buffer if used as render target 0.
global MATERIAL_RT_DEPTH_SHARED: E_MATERIAL_RT_DEPTH = 0
--- Create a depth-stencil buffer.
--- Use the created depth-stencil buffer if used as render target 0.
global MATERIAL_RT_DEPTH_SEPARATE: E_MATERIAL_RT_DEPTH = 1
--- Do not create a depth-stencil buffer.
--- Disable depth and stencil buffer usage if used as render target 0.
global MATERIAL_RT_DEPTH_NONE: E_MATERIAL_RT_DEPTH = 2
--- Create a depth-stencil buffer.
--- Use the created depth-stencil buffer if used as render target 0.
--- Creates a color texture despite the name.
--- Seems to behave the same as MATERIAL_RT_DEPTH_SEPARATE.
global MATERIAL_RT_DEPTH_ONLY: E_MATERIAL_RT_DEPTH = 3

--- Enumerations used by:
--- * input.IsMouseDown
--- * input.WasMousePressed
--- * input.WasMouseDoublePressed
--- It's also part of the Enums/BUTTON_CODE.
--- # Catch mouse wheel
--- You can catch the mouse wheel's value by:
--- ```
--- local testVal = 0
--- hook.Add("InputMouseApply", "testMouseWheel", function(cmd, x, y, ang)
--- testVal = testVal + cmd:GetMouseWheel() * 2 --any scale number you want to use
--- print(testVal)
--- end)
--- ```
global type E_MOUSE = number
--- First mouse button
global MOUSE_FIRST: E_MOUSE = 107
--- Left mouse button
global MOUSE_LEFT: E_MOUSE = 107
--- Right mouse button
global MOUSE_RIGHT: E_MOUSE = 108
--- Middle mouse button, aka the wheel press
global MOUSE_MIDDLE: E_MOUSE = 109
--- Mouse 4 button ( Sometimes, mouse wheel tilt left )
global MOUSE_4: E_MOUSE = 110
--- Mouse 5 button ( Sometimes, mouse wheel tilt right )
global MOUSE_5: E_MOUSE = 111
--- Mouse wheel scroll up
global MOUSE_WHEEL_UP: E_MOUSE = 112
--- Mouse wheel scroll down
global MOUSE_WHEEL_DOWN: E_MOUSE = 113
--- Last mouse button
global MOUSE_LAST: E_MOUSE = 113
--- Mouse button count
global MOUSE_COUNT: E_MOUSE = 7

--- Enumerations used by Entity:SetMoveCollide and Entity:GetMoveCollide.
global type E_MOVECOLLIDE = number
--- Default behavior
global MOVECOLLIDE_DEFAULT: E_MOVECOLLIDE = 0
--- Entity bounces, reflects, based on elasticity of surface and object - applies friction (adjust velocity)
global MOVECOLLIDE_FLY_BOUNCE: E_MOVECOLLIDE = 1
--- ENTITY:Touch will modify the velocity however it likes
global MOVECOLLIDE_FLY_CUSTOM: E_MOVECOLLIDE = 2
--- Entity slides along surfaces (no bounce) - applies friciton (adjusts velocity)
global MOVECOLLIDE_FLY_SLIDE: E_MOVECOLLIDE = 3
--- Number of different movecollides
global MOVECOLLIDE_COUNT: E_MOVECOLLIDE = 4

--- Enumerations used by Entity:SetMoveType and Entity:GetMoveType.
global type E_MOVETYPE = number
--- Don't move
global MOVETYPE_NONE: E_MOVETYPE = 0
--- For players, in TF2 commander view, etc
global MOVETYPE_ISOMETRIC: E_MOVETYPE = 1
--- Player only, moving on the ground
global MOVETYPE_WALK: E_MOVETYPE = 2
--- Monster/NPC movement
global MOVETYPE_STEP: E_MOVETYPE = 3
--- Fly, no gravity
global MOVETYPE_FLY: E_MOVETYPE = 4
--- Fly, with gravity
global MOVETYPE_FLYGRAVITY: E_MOVETYPE = 5
--- Physics movetype
global MOVETYPE_VPHYSICS: E_MOVETYPE = 6
--- Doesn't collide with the world, but does push and crush entities.
--- This is what is used by the engine for elevators, trains, doors, moving water, etc.
--- In order to work properly, the entity needs to have specific Save Values/Internal Variables set which tell it how long it should be moving for.
--- **Note:** This same process can be done for both position and angle.
--- 1. You'll need to Get an existing Save Value called `ltime`
--- 2. Calculate how long (in seconds) the entity will be moving before it reaches its destination.
--- As a simple example, this can be done via `duration = distance / speed`
--- 3. Set the Save Value for `m_flMoveDoneTime` to the value you retrieved for `ltime` plus the duration calculated in step 2.
--- Put more simply: `m_flMoveDoneTime = ltime + duration`
--- 4. Set the entity's velocity to move it to the destination at the speed used in step 2.
--- Once the duration of the move has elapsed, the entity will stop moving.  If you have done your calculations correctly, it should stop exactly at the desired destination.
--- **NOTE**: MOVETYPE_PUSH entities only move during Entity:Think so if you want smooth movement, you need to set Entity:NextThink to Global.CurTime, which instructs the entity to execute Entity:Think as quickly as possible.
global MOVETYPE_PUSH: E_MOVETYPE = 7
--- Noclip
global MOVETYPE_NOCLIP: E_MOVETYPE = 8
--- For players, when moving on a ladder
global MOVETYPE_LADDER: E_MOVETYPE = 9
--- Spectator movetype. DO **NOT** use this to make player spectate
global MOVETYPE_OBSERVER: E_MOVETYPE = 10
--- Custom movetype, can be applied to the player to prevent the default movement code from running, while still calling the related hooks
global MOVETYPE_CUSTOM: E_MOVETYPE = 11

--- Used by NPC:SetNavType and NPC:GetNavType.
global type E_NAV = number
--- Error condition.
global NAV_NONE: E_NAV = -1
--- walk/run
global NAV_GROUND: E_NAV = 0
--- jump/leap
global NAV_JUMP: E_NAV = 1
--- can fly, move all around
global NAV_FLY: E_NAV = 2
--- climb ladders
global NAV_CLIMB: E_NAV = 3

--- Enumerations used by CNavArea:GetAttributes and CNavArea:HasAttributes.
global type E_NAV_MESH = number
--- The nav area is invalid.
global NAV_MESH_INVALID: E_NAV_MESH = 0
--- Must crouch to use this node/area
global NAV_MESH_CROUCH: E_NAV_MESH = 1
--- Must jump to traverse this area (only used during generation)
global NAV_MESH_JUMP: E_NAV_MESH = 2
--- Do not adjust for obstacles, just move along area
global NAV_MESH_PRECISE: E_NAV_MESH = 4
--- Inhibit discontinuity jumping
global NAV_MESH_NO_JUMP: E_NAV_MESH = 8
--- Must stop when entering this area
global NAV_MESH_STOP: E_NAV_MESH = 16
--- Must run to traverse this area
global NAV_MESH_RUN: E_NAV_MESH = 32
--- Must walk to traverse this area
global NAV_MESH_WALK: E_NAV_MESH = 64
--- Avoid this area unless alternatives are too dangerous
global NAV_MESH_AVOID: E_NAV_MESH = 128
--- Area may become blocked, and should be periodically checked
global NAV_MESH_TRANSIENT: E_NAV_MESH = 256
--- Area should not be considered for hiding spot generation
global NAV_MESH_DONT_HIDE: E_NAV_MESH = 512
--- Bots hiding in this area should stand
global NAV_MESH_STAND: E_NAV_MESH = 1024
--- Hostages shouldn't use this area
global NAV_MESH_NO_HOSTAGES: E_NAV_MESH = 2048
--- This area represents stairs, do not attempt to climb or jump them - just walk up
global NAV_MESH_STAIRS: E_NAV_MESH = 4096
--- Don't merge this area with adjacent areas
global NAV_MESH_NO_MERGE: E_NAV_MESH = 8192
--- This nav area is the climb point on the tip of an obstacle
global NAV_MESH_OBSTACLE_TOP: E_NAV_MESH = 16384
--- This nav area is adjacent to a drop of at least `CliffHeight` (300 hammer units). Unused by base game.
global NAV_MESH_CLIFF: E_NAV_MESH = 32768
--- Whether the area is blocked via CNavArea:MarkAsBlocked.
global NAV_MESH_BLOCKED_LUA: E_NAV_MESH = 65536
--- Whether the area has a `prop_door_rotating` that is blocking it (because the door is closed)
global NAV_MESH_BLOCKED_PROPDOOR: E_NAV_MESH = 268435456

    --- **INTERNAL**:
    --- Used internally, called from DPanPanel:ScrollToChild.
    -- @param x ---
    -- @param y ---
    OnScroll: function(self, x: number, y: number)

    --- Scroll to a specific child panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dpanpanel.lua#L123-L135)
    -- @param pnl --- The panel to scroll to.
    ScrollToChild: function(self, pnl: GPanel)

    --- **INTERNAL**:
    --- Used internally.
    -- @param pnl --- The canvas panel.
    SetCanvas: function(self, pnl: GPanel)
end

--- Adds curved corners.
global interface DPanelOverlay is DPanel
    --- Returns the border color of the DPanelOverlay set by DPanelOverlay:SetColor.
    -- @return --- The set color. Uses the Color.
    GetColor: function(self): table

    --- Returns the type of the DPanelOverlay set by DPanelOverlay:SetType.
    -- @return --- The set type.
    GetType: function(self): number

    --- **INTERNAL**:
    --- Used internally by the panel for type 3.
    -- @param cola ---
    -- @param colb ---
    -- @param colc ---
    -- @param cold ---
    -- @param size ---
    PaintDifferentColours: function(self, cola: table, colb: table, colc: table, cold: table, size: number)

    --- **INTERNAL**:
    --- Used internally by the panel for types 1 and 2.
    -- @param size ---
    PaintInnerCorners: function(self, size: number)

    --- Sets the border color of the DPanelOverlay.
    -- @param color --- The color to set. Uses the Color.
    SetColor: function(self, color: table)

    --- Sets the type of the DPanelOverlay.
    -- @param type --- The type to set.
    --- Possible value are:
    --- * 1 - 8px corners of given color
    --- * 2 - 4px corners of given type
    --- * 3 - 2 top? corners of hardcoded color, 2 other corners of given color
    SetType: function(self, type: number)
end

--- The **DNumSlider** allows you to create a slider, allowing the user to slide it to set a value, or changing the value in the box.
global interface DNumSlider is GPanel
    --- Returns the amount of numbers after the decimal point.
    -- @return --- 0 for whole numbers only, 1 for one number after the decimal point, etc.
    GetDecimals: function(self): number

    --- Returns the default value of the slider, if one was set by DNumSlider:SetDefaultValue
    -- @return --- The default value of the slider
    GetDefaultValue: function(self): number

    --- Returns the maximum value of the slider
    -- @return --- The maximum value of the slider
    GetMax: function(self): number

    --- Returns the minimum value of the slider
    -- @return --- The minimum value of the slider
    GetMin: function(self): number

    --- Returns the range of the slider, basically maximum value - minimum value.
    -- @return --- The range of the slider
    GetRange: function(self): number

    --- Returns the DTextEntry component of the slider.
    -- @return --- The DTextEntry.
    GetTextArea: function(self): GPanel

    --- Returns the value of the DNumSlider
    -- @return --- The value of the slider.
    GetValue: function(self): number

    --- Returns true if either the DTextEntry, the DSlider or the DNumberScratch are being edited.
    -- @return --- Whether or not the DNumSlider is being edited by the player.
    IsEditing: function(self): boolean

    --- Called when the value of the slider is changed, through code or changing the slider.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dnumslider.lua#L193-L197)
    -- @param value --- The new value of the DNumSlider.
    OnValueChanged: function(self, value: number)

    --- Resets the slider to the default value, if one was set by DNumSlider:SetDefaultValue.
    --- This function is called by the DNumSlider when user middle mouse clicks on the draggable knob of the slider.
    ResetToDefaultValue: function(self)

    --- Sets the console variable to be updated when the value of the slider is changed.
    -- @param cvar --- The name of the ConVar to be updated.
    SetConVar: function(self, cvar: string)

    --- Calls DLabel:SetDark on the DLabel part of the DNumSlider.
    -- @param dark ---
    SetDark: function(self, dark: boolean)

    --- Sets the desired amount of numbers after the decimal point.
    --- **NOTE**: This doesn't affect values passed to DNumSlider:OnValueChanged.
    --- **NOTE**: To get right values passed to DNumSlider:OnValueChanged use math.Round.
    -- @param decimals --- 0 for whole numbers only, 1 for one number after the decimal point, etc.
    SetDecimals: function(self, decimals: number)

    --- Sets the default value of the slider, to be used by DNumSlider:ResetToDefaultValue or by middle mouse clicking the draggable knob of the slider.
    -- @param default --- The new default value of the slider to set
    SetDefaultValue: function(self, default: number)

    --- Sets the maximum value for the slider.
    -- @param max --- The value to set as maximum for the slider.
    SetMax: function(self, max: number)

    --- Sets the minimum value for the slider
    -- @param min --- The value to set as minimum for the slider.
    SetMin: function(self, min: number)

    --- Sets the minimum and the maximum value of the slider.
    -- @param min --- The minimum value of the slider.
    -- @param max --- The maximum value of the slider.
    SetMinMax: function(self, min: number, max: number)

    --- Sets the value of the DNumSlider.
    -- @param val --- The value to set.
    SetValue: function(self, val: number)

    --- **INTERNAL**:
    -- @param x ---
    -- @param y ---
    -- @return ---
    -- @return --- The second passed argument.
    TranslateSliderValues: function(self, x: number, y: number): number, number

    --- **INTERNAL**:
    --- Updates visual notches on the slider.
    UpdateNotches: function(self)

    --- **INTERNAL**:
    ---  Called when the value has been changed. This will also be called when the user manually changes the value through the text panel.
    --- This is an internal function. Override DNumSlider:OnValueChanged instead.
    -- @param value --- The value the slider has been changed to.
    ValueChanged: function(self, value: number)
end

--- @deprecated
--- **DEPRECATED**: You should use DBinder instead.
--- GMod 12 style "number pad" panel used by tools for binding keys to tool actions. Deprecated in favor of DBinder.
global interface DNumPad is DPanel

end

--- DNumberWang is a VGUI element that allows you to input a numeric value using up and down arrows or direct entry.
global interface DNumberWang is DTextEntry
    --- Returns the amount of decimal places allowed in the number selector, set by DNumberWang:SetDecimals
    -- @return --- The amount of decimal places allowed in the number selector.
    GetDecimals: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns whatever is set by DNumberWang:SetFloatValue or 0.
    -- @return ---
    GetFloatValue: function(self): number

    --- Returns a fraction representing the current number selector value to number selector min/max range ratio. If argument `val` is supplied, that number will be computed instead.
    -- @param val --- The fraction numerator.
    GetFraction: function(self, val: number)

    --- Returns interval at which the up and down buttons change the current value.
    -- @return min --- The current interval.
    GetInterval: function(self): number

    --- Returns the maximum numeric value allowed by the number selector.
    -- @return --- The maximum value.
    GetMax: function(self): number

    --- Returns the minimum numeric value allowed by the number selector.
    -- @return --- The minimum number.
    GetMin: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- This function returns the panel it is used on.
    -- @return --- self
    GetTextArea: function(self): GPanel

    --- Returns the numeric value inside the number selector.
    -- @return --- The numeric value.
    GetValue: function(self): number

    --- Hides the number selector arrows.
    HideWang: function(self)

    --- Called when the number selector value is changed.
    -- @param val --- The new value of the number selector.
    OnValueChanged: function(self, val: number)

    --- Sets the amount of decimal places allowed in the number selector.
    -- @param num --- The amount of decimal places.
    SetDecimals: function(self, num: number)

    --- @deprecated
    --- **DEPRECATED**:
    --- Appears to do nothing.
    -- @param val ---
    SetFloatValue: function(self, val: number)

    --- Sets the value of the number selector based on the given fraction number.
    -- @param val --- The fraction of the number selector's range.
    SetFraction: function(self, val: number)

    --- Sets interval at which the up and down buttons change the current value.
    -- @param min --- The new interval.
    SetInterval: function(self, min: number)

    --- Sets the maximum numeric value allowed by the number selector.
    -- @param max --- The maximum value.
    SetMax: function(self, max: number)

    --- Sets the minimum numeric value allowed by the number selector.
    -- @param min --- The minimum value.
    SetMin: function(self, min: number)

    --- Sets the minimum and maximum value allowed by the number selector.
    -- @param min --- The minimum value.
    -- @param max --- The maximum value.
    SetMinMax: function(self, min: number, max: number)

    --- Sets the value of the DNumberWang and triggers DNumberWang:OnValueChanged
    -- @param val --- The value to set.
    --SetValue: function(self, val: number)
end

--- Choose a number from a number line, with zooming for precision.
--- Zoom in by moving your mouse forward and moving back does the opposite. Looks like a blue circle until you click and hold on it
global interface DNumberScratch is DImageButton
    --- **INTERNAL**:
    --- Used by DNumberScratch:DrawScreen.
    -- @param level ---
    -- @param x ---
    -- @param y ---
    -- @param w ---
    -- @param h ---
    -- @param range ---
    -- @param value ---
    -- @param min ---
    -- @param max ---
    DrawNotches: function(self, level: number, x: number, y: number, w: number, h: number, range: number, value: number, min: number, max: number)

    --- **INTERNAL**:
    --- Used by DNumberScratch:PaintScratchWindow.
    -- @param x ---
    -- @param y ---
    -- @param w ---
    -- @param h ---
    DrawScreen: function(self, x: number, y: number, w: number, h: number)

    --- Returns whether this panel is active or not, i.e. if the player is currently changing its value.
    -- @return ---
    GetActive: function(self): boolean

    --- Returns the desired amount of numbers after the decimal point.
    -- @return --- 0 for whole numbers only, 1 for one number after the decimal point, etc.
    GetDecimals: function(self): number

    --- Returns the real value of the DNumberScratch as a number.
    --- See also DNumberScratch:GetTextValue and DNumberScratch:GetFraction.
    -- @return --- The real value of the DNumberScratch
    GetFloatValue: function(self): number

    --- Returns the value of the DNumberScratch as a fraction, a value between 0 and 1 where 0 is the minimum and 1 is the maximum value of the DNumberScratch.
    --- See also:
    --- * DNumberScratch:GetTextValue
    --- * DNumberScratch:GetFloatValue
    --- * DNumberScratch:SetFraction
    -- @return --- A value between 0 and 1
    GetFraction: function(self): number

    --- Returns the maximum value that can be selected on the number scratch
    -- @return --- The maximum value that can be selected on the number scratch
    GetMax: function(self): number

    --- Returns the minimum value that can be selected on the number scratch
    -- @return --- The minimum value that can be selected on the number scratch
    GetMin: function(self): number

    --- Returns the range of the DNumberScratch. Basically max value - min value.
    -- @return --- The range of the DNumberScratch
    GetRange: function(self): number

    --- Returns whether the scratch window should be visible or not.
    -- @return ---
    GetShouldDrawScreen: function(self): boolean

    --- Returns the real value of the DNumberScratch as a string.
    --- See also DNumberScratch:GetFloatValue and DNumberScratch:GetFraction.
    -- @return --- The real value of the DNumberScratch
    GetTextValue: function(self): string

    --- Returns the zoom level of the scratch window
    -- @return ---
    GetZoom: function(self): number

    --- Returns the ideal zoom level for the panel based on the DNumberScratch:GetRange.
    -- @return --- The ideal zoom level for the panel based on the panels range.
    IdealZoom: function(self): number

    --- Returns whether the player is currently editing the value of the DNumberScratch.
    -- @return ---
    IsEditing: function(self): boolean

    --- **INTERNAL**:
    --- Used to lock the cursor in place.
    LockCursor: function(self)

    --- Called when the value of the DNumberScratch is changed.
    -- @param newValue --- The new value
    OnValueChanged: function(self, newValue: number)

    --- **INTERNAL**:
    --- Used to paint the 'scratch' window.
    PaintScratchWindow: function(self)

    --- **INTERNAL**:
    --- Sets whether or not the panel is 'active'.
    --- Forcing this panel to be active may not work.
    -- @param active --- true to activate, false to deactivate.
    SetActive: function(self, active: boolean)

    --- Sets the desired amount of numbers after the decimal point.
    -- @param decimals --- 0 for whole numbers only, 1 for one number after the decimal point, etc.
    SetDecimals: function(self, decimals: number)

    --- **INTERNAL**:
    --- Does not trigger DNumberScratch:OnValueChanged
    --- Use DNumberScratch:SetValue instead.
    -- @param val --- The value to set
    SetFloatValue: function(self, val: number)

    --- Sets the value of the DNumberScratch as a fraction, a value between 0 and 1 where 0 is the minimum and 1 is the maximum value of the DNumberScratch
    -- @param frac --- A value between 0 and 1
    SetFraction: function(self, frac: number)

    --- Sets the max value that can be selected on the number scratch
    -- @param max --- The maximum number
    SetMax: function(self, max: number)

    --- Sets the minimum value that can be selected on the number scratch.
    -- @param min --- The minimum number
    SetMin: function(self, min: number)

    --- **INTERNAL**:
    --- Sets if the scratch window should be drawn or not. Cannot be used to force it to draw, only to hide it, which will not stop the panel from working with invisible window.
    -- @param shouldDraw ---
    SetShouldDrawScreen: function(self, shouldDraw: boolean)

    --- Sets the value of the DNumberScratch and triggers DNumberScratch:OnValueChanged
    -- @param val --- The value to set.
    SetValue: function(self, val: number)

    --- Sets the zoom level of the scratch panel.
    -- @param zoom ---
    SetZoom: function(self, zoom: number)

    --- **INTERNAL**:
    --- Forces the assigned ConVar to be updated to the value of this DNumberScratch
    UpdateConVar: function(self)
end

--- A panel that fades its contents in and out once, like a notification.
global interface DNotify is GPanel
    --- Adds a panel to the notification
    -- @param pnl --- The panel to add
    -- @param lifeLength --- If set, overrides DNotify:SetLife for when the given panel should be removed.
    AddItem: function(self, pnl: GPanel, lifeLength: number)

    --- Returns the current alignment of this notification panel. Set by DNotify:SetAlignment.
    -- @return --- The numpad alignment
    GetAlignment: function(self): number

    --- Returns all the items added with DNotify:AddItem.
    -- @return --- A table of Panels.
    GetItems: function(self): table

    --- Returns the display time in seconds of the DNotify. This is set with
    --- DNotify:SetLife.
    -- @return --- The display time in seconds.
    GetLife: function(self): number

    --- Returns the spacing between items set by DNotify:SetSpacing.
    -- @return ---
    GetSpacing: function(self): number

    --- Sets the alignment of the child panels in the notification
    -- @param alignment --- It's the Numpad alignment, 6 is right, 9 is top left, etc.
    SetAlignment: function(self, alignment: number)

    --- Sets the display time in seconds for the DNotify.
    -- @param time --- The time in seconds.
    SetLife: function(self, time: number)

    --- Sets the spacing between child elements of the notification panel.
    -- @param spacing ---
    SetSpacing: function(self, spacing: number)

    --- **INTERNAL**:
    --- Used internally to position and fade in/out its DNotify:GetItems.
    Shuffle: function(self)
end

--- @deprecated
--- **DEPRECATED**:
--- A combination of DModelSelect and DPropertySheet.
global interface DModelSelectMulti is DPropertySheet
    --- Adds a new tab of models.
    -- @param name --- Name of the tab to add.
    -- @param models --- Models list for this tab. See DModelSelect:SetModelList.
    -- @param convar --- ConVar to set when a model from this list is selected.
    -- @param dontSort --- Do not sort the list. (by the `Model` member)
    -- @param dontCallListConVars --- If set, only the `convar` from the 2nd argument will be set, not individual convars from the models list.
    AddModelList: function(self, name: string, models: table, convar: string, dontSort: boolean, dontCallListConVars: boolean)
end

--- @deprecated
--- **DEPRECATED**: This is derived from the deprecated DPanelList.
--- A vertical list of models.
global interface DModelSelect is DPanelSelect
    --- Sets the height of the panel **in the amount of 64px spawnicons**.
    --- Overrides Panel:SetHeight.
    -- @param num --- Basically how many rows of 64x64 px spawnicons should fit in this DModelSelect
    SetHeight: function(self, num: number)

    --- Called to set the list of models within the panel element.
    -- @param models --- Each key is a model path, the value is a kay-value table where they key is a convar name and value is the value to set to that convar.
    -- @param convar --- ConVar to set when a model from this list is selected.
    -- @param dontSort --- Do not sort the list. (by the `Model` member)
    -- @param dontCallListConVars --- If set, only the `convar` from the 2nd argument will be set, not individual convars from the models list.
    SetModelList: function(self, models: table, convar: string, dontSort: boolean, dontCallListConVars: boolean)
end

--- **INTERNAL**:
--- An internal panel used by DMenu.
--- It acts as a menu option that can be checked.
--- It automatically sets and reads the given console variable.
--- It can be right clicked to toggle without closing the DMenu.
--- Use DMenu:AddCVar instead.
global interface DMenuOptionCVar is DMenuOption
    --- Returns the console variable used by the DMenuOptionCVar.
    -- @return --- The console variable used
    GetConVar: function(self): string

    --- Returns the value of the console variable when the DMenuOptionCVar is not checked.
    -- @return --- The value
    GetValueOff: function(self): string

    --- Return the value of the console variable when the DMenuOptionCVar is checked.
    -- @return --- The value
    GetValueOn: function(self): string

    --- Sets the console variable to be used by DMenuOptionCVar.
    -- @param cvar --- The console variable name to set
    SetConVar: function(self, cvar: string)

    --- Sets the value of the console variable when the DMenuOptionCVar is not checked.
    -- @param value --- The value
    SetValueOff: function(self, value: string)

    --- Sets the value of the console variable when the DMenuOptionCVar is checked.
    -- @param value --- The value
    SetValueOn: function(self, value: string)
end

--- A simple menu bar.
global interface DMenuBar is DPanel
    --- Creates a new DMenu object tied to a DButton with the given label on the menu bar.
    --- This will create a new menu regardless of whether or not one with the same label exists. To add **or** get a menu, use DMenuBar:AddOrGetMenu.
    -- @param label --- The name (label) of the derma menu to create.
    -- @return --- The new DMenu which will be opened when the button is clicked.
    AddMenu: function(self, label: string): GPanel

    --- Retrieves a DMenu object from the menu bar. If one with the given label doesn't exist, a new one is created.
    --- To add a DMenu without checking, use DMenuBar:AddMenu.
    -- @param label --- The name (label) of the derma menu to get or create.
    -- @return --- The DMenu with the given label.
    AddOrGetMenu: function(self, label: string): GPanel

    --- @deprecated
    --- **DEPRECATED**: Use DMenuBar:GetPaintBackground instead.
    --- Returns whether or not the background should be painted. Is the same as DMenuBar:GetPaintBackground
    -- @return --- Should the background be painted
    GetDrawBackground: function(self): boolean

    --- Returns whether or not the panel is a menu. Used for closing menus when another panel is selected.
    -- @return --- Is a menu
    GetIsMenu: function(self): boolean

    --- If a menu is visible/opened, then the menu is returned.
    -- @return --- Returns the visible/open menu or nil.
    GetOpenMenu: function(self): GPanel

    --- Returns whether or not the background should be painted. Is the same as DMenuBar:GetDrawBackground
    -- @return --- Should the background be painted
    GetPaintBackground: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**: Use DMenuBar:SetPaintBackground
    --- Sets whether or not the background should be painted. Is the same as DMenuBar:SetPaintBackground
    -- @param shouldPaint --- Should the background be painted
    SetDrawBackground: function(self, shouldPaint: boolean)

    --- Sets whether or not the panel is part of a DMenu.
    --- If this is set to `true`, Global.CloseDermaMenus will not be called when the panel is clicked, and thus any open menus will remain open.
    -- @param isMenu --- Is this a menu
    SetIsMenu: function(self, isMenu: boolean)

    --- Sets whether or not the background should be painted. Is the same as DMenuBar:SetDrawBackground
    -- @param shouldPaint --- Should the background be painted
    SetPaintBackground: function(self, shouldPaint: boolean)
end

--- A simple menu with sub menu, icon and convar support.
global interface DMenu is DScrollPanel
    --- Creates a DMenuOptionCVar and adds it as an option into the menu. Checking and unchecking the option will alter the given console variable's value.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dmenu.lua#L49-L64)
    -- @param strText --- The text of the button
    -- @param convar --- The console variable to change
    -- @param on --- The value of the console variable to set when the option is checked
    -- @param off --- The value of the console variable to set when the option is unchecked
    -- @param funcFunction --- If set, the function will be called every time the option is pressed/clicked/selected.
    --- <callback>
    --- <arg type="Panel" name="pnl">The DMenuOptionCVar that was clicked.</arg>
    --- </callback>
    -- @return --- The created DMenuOptionCVar
    AddCVar: function(self, strText: string, convar: string, on: string, off: string, funcFunction: function): GPanel

    --- Add an option to the DMenu
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dmenu.lua#L36)
    -- @param name --- Name of the option.
    -- @param func --- Function to execute when this option is clicked.
    --- <callback>
    --- <arg type="Panel" name="pnl">The DMenuOption that was clicked.</arg>
    --- </callback>
    -- @return --- Returns the created DMenuOption panel.
    AddOption: function(self, name: string, func: function): GPanel

    --- Adds a panel to the DMenu as if it were an option.
    --- This invokes DScrollPanel:AddItem and will not create a new panel if a class name is passed, unlike Panel:Add.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dmenu.lua#L29)
    -- @param pnl --- The panel that you want to add.
    AddPanel: function(self, pnl: GPanel)

    --- Adds a horizontal line spacer.
    AddSpacer: function(self)

    --- Add a sub menu to the DMenu
    -- @param Name --- Name of the sub menu.
    -- @param func --- Function to execute when this sub menu is clicked.
    --- <callback>
    --- <arg type="Panel" name="pnl">The DMenuOption that was clicked.</arg>
    --- </callback>
    -- @return --- The created sub DMenu
    -- @return --- The created DMenuOption
    AddSubMenu: function(self, Name: string, func: function): GPanel, GPanel

    --- Returns the number of child elements of DMenu's DScrollPanel:GetCanvas.
    -- @return --- The number of child elements
    ChildCount: function(self): number

    --- @deprecated
    --- **DEPRECATED**:
    --- Clears all highlights made by DMenu:HighlightItem.
    --- Doesn't appear to be used or do anything.
    ClearHighlights: function(self)

    --- **INTERNAL**:
    --- Used internally by DMenu:OpenSubMenu.
    -- @param menu --- The menu to close
    CloseSubMenu: function(self, menu: GPanel)

    --- Gets a child by its index.
    -- @param childIndex --- The index of the child to get.
    --- **NOTE**: Unlike Panel:GetChild, this index starts at 1.
    GetChild: function(self, childIndex: number)

    --- @deprecated
    --- **DEPRECATED**:
    --- Set by DMenu:SetDeleteSelf
    -- @return ---
    GetDeleteSelf: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**:
    --- Returns the value set by DMenu:SetDrawBorder.
    -- @return ---
    GetDrawBorder: function(self): boolean

    --- Returns whether the DMenu should draw the icon column with a different color or not.
    --- See DMenu:SetDrawColumn
    -- @return --- Whether to draw the column or not
    GetDrawColumn: function(self): boolean

    --- Returns the maximum height of the DMenu.
    -- @return --- The maximum height in pixels
    GetMaxHeight: function(self): number

    --- Returns the minimum width of the DMenu in pixels
    -- @return --- the minimum width of the DMenu
    GetMinimumWidth: function(self): number

    --- **INTERNAL**:
    --- Returns the currently opened submenu.
    --- Used internally to store the open submenu by DMenu:Hide, DMenu:OpenSubMenu.
    -- @return --- The currently opened submenu, if any.
    GetOpenSubMenu: function(self): GPanel

    --- Used to safely hide (not remove) the menu. This will also hide any opened submenues recursively.
    Hide: function(self)

    --- @deprecated
    --- **DEPRECATED**:
    --- Highlights selected item in the DMenu by setting the item's key "Highlight" to true.
    --- Doesn't appear to be working or used.
    -- @param item --- The item to highlight.
    HighlightItem: function(self, item: GPanel)

    --- Opens the DMenu at given position.
    -- @param x --- Position (X coordinate) to open the menu at.
    -- @param y --- Position (Y coordinate) to open the menu at.
    -- @param skipanimation --- This argument does nothing.
    -- @param ownerpanel --- If `x` and `y` are not set manually, setting this argument will offset the `y` position of the opened menu by the height of given panel.
    Open: function(self, x: number, y: number, skipanimation: any, ownerpanel: GPanel)

    --- Closes any active sub menus, and opens a new one.
    -- @param item --- The DMenuOption to open the submenu at
    -- @param menu --- The submenu to open. If set to nil, the function just closes existing submenus.
    OpenSubMenu: function(self, item: GPanel, menu: GPanel)

    --- Called when a option has been selected
    -- @param option --- The DMenuOption that was selected
    -- @param optionText --- The options text
    OptionSelected: function(self, option: GPanel, optionText: string)

    --- **INTERNAL**:
    --- Called by DMenuOption. Calls DMenu:OptionSelected.
    -- @param option --- The DMenuOption that called this function
    OptionSelectedInternal: function(self, option: GPanel)

    --- Set to true by default. IF set to true, the menu will be deleted when it is closed, not simply hidden.
    --- This is used by DMenuBar
    -- @param newState --- true to delete menu on close, false to simply hide.
    SetDeleteSelf: function(self, newState: boolean)

    --- @deprecated
    --- **DEPRECATED**:
    --- Does nothing.
    -- @param bool ---
    SetDrawBorder: function(self, bool: boolean)

    --- Sets whether the DMenu should draw the icon column with a different color.
    -- @param draw --- Whether to draw the column or not
    SetDrawColumn: function(self, draw: boolean)

    --- Sets the maximum height the DMenu can have. If the height of all menu items exceed this value, a scroll bar will be automatically added.
    -- @param maxHeight --- The maximum height of the DMenu to set, in pixels
    SetMaxHeight: function(self, maxHeight: number)

    --- Sets the minimum width of the DMenu. The menu will be stretched to match the given value.
    -- @param minWidth --- The minimum width of the DMenu in pixels
    SetMinimumWidth: function(self, minWidth: number)

    --- **INTERNAL**:
    --- Used internally to store the open submenu by DMenu:Hide, DMenu:OpenSubMenu, DMenu:CloseSubMenu
    -- @param item --- The menu to store
    SetOpenSubMenu: function(self, item: GPanel)
end

--- **INTERNAL**: Alias of DListView_Line.
global interface DListViewLine is GPanel

end

--- **INTERNAL**: Used by DListView_Line.
global interface DListViewLabel is DLabel

end

--- **INTERNAL**: Used by DListView_ColumnPlain.
global interface DListViewHeaderLabel is DLabel

end

--- **INTERNAL**:
--- A panel used by DListView
global interface DListView_Line is GPanel
    --- **INTERNAL**:
    --- Called by DListView:DataLayout
    -- @param pnl --- The list view.
    DataLayout: function(self, pnl: DListView)

    --- Returns whether this line is odd or even in the list. This is internally used (and set) to change the looks of every other line.
    -- @return alt --- Whether this line is 'alternative'.
    GetAltLine: function(self): boolean

    --- Gets the string held in the specified column of a DListView_Line panel.
    --- This is the same thing as doing DListView_Line:GetValue( column_number ).
    -- @param column --- The number of the column to retrieve the text from, starts with 1.
    -- @return --- The contents of the specified column.
    GetColumnText: function(self, column: number): string

    --- Returns the ID of this line, set automatically in DListView:AddLine.
    -- @return --- The ID of this line.
    GetID: function(self): number

    --- Returns the parent DListView of this line.
    -- @return pnl --- The parent DListView of this line.
    GetListView: function(self): DListView

    --- Returns the data stored on given cell of this line.
    --- Used in the DListView:SortByColumn function in case you want to sort with something else than the text.
    -- @param column --- The number of the column to write the text from, starts with 1.
    -- @return data --- The data that is set for given column of this line, if any.
    GetSortValue: function(self, column: number): any

    --- Alias of DListView_Line:GetColumnText. Overrides Panel:GetValue.
    -- @param column --- The number of the column to retrieve the text from, starts with 1.
    -- @return --- The contents of the specified column.
    --GetValue: function(self, column: number): string

    --- Returns whether this line is selected.
    -- @return selected --- Whether this line is selected.
    IsLineSelected: function(self): boolean

    --- Called when the player right clicks this line.
    OnRightClick: function(self)

    --- Called when the player selects this line.
    OnSelect: function(self)

    --- **INTERNAL**:
    --- Sets whether this line is odd or even in the list. This is internally used (and set automatically) to change the looks of every other line.
    -- @param alt --- Whether this line is 'alternative'.
    SetAltLine: function(self, alt: boolean)

    --- Sets the string held in the specified column of a DListView_Line panel.
    -- @param column --- The number of the column to write the text from, starts with 1.
    -- @param value --- Column text you want to set
    -- @return label --- The DLabel in which the text was set.
    SetColumnText: function(self, column: number, value: string): DLabel

    --- **INTERNAL**:
    --- Sets the ID of this line, used internally by DListView:AddLine.
    -- @param id --- The ID for this line.
    SetID: function(self, id: number)

    --- **INTERNAL**:
    --- Sets the parent DListView for this line. Used internally by DListView:AddLine.
    -- @param pnl --- The new parent DListView for this line.
    SetListView: function(self, pnl: DListView)

    --- Sets whether this line is selected or not.
    -- @param selected --- Whether this line is selected.
    SetSelected: function(self, selected: boolean)

    --- Allows you to store data per column.
    --- Used in the DListView:SortByColumn function in case you want to sort with something else than the text.
    -- @param column --- The number of the column to write the text from, starts with 1.
    -- @param data --- Data for given column on the line you wish to set.
    SetSortValue: function(self, column: number, data: any)

    --- Alias of DListView_Line:SetColumnText.
    -- @param column --- The number of the column to write the text from, starts with 1.
    -- @param value --- Column text you want to set
    -- @return label --- The DLabel in which the text was set.
    SetValue: function(self, column: number, value: string): DLabel
end

--- **INTERNAL**: Used by DListView.
global interface DListView_DraggerBar is DButton

end

--- **INTERNAL**: Used by DListView.
global interface DListView_ColumnPlain is DListView_Column

end

--- A data view with rows and columns.
global interface DListView is DPanel
    --- Adds a column to the listview.
    -- @param column --- The name of the column to add.
    -- @param position --- At which position to insert the new column compared to the other columns. Set to 1 to add the new column before all other columns.
    --- By default the column will be placed after all columns.
    -- @return --- The newly created DListView_Column.
    AddColumn: function(self, column: string, position: number): GPanel

    --- Adds a line to the list view.
    -- @param text --- Values for a new row in the DListView, If several arguments are supplied, each argument will correspond to a respective column in the DListView.
    -- @return --- The newly created DListView_Line.
    AddLine: function(self, ...: any): GPanel

    --- Clears the current selection in the DListView.
    ClearSelection: function(self)

    --- Gets the width of a column.
    -- @param column --- The column to get the width of.
    -- @return --- Width of the column.
    ColumnWidth: function(self, column: number): number

    --- Creates the lines and gets the height of the contents, in a DListView.
    -- @return --- The height of the contents
    DataLayout: function(self): number

    --- Removes the scrollbar.
    DisableScrollbar: function(self)

    --- Called when a line in the DListView is double clicked.
    -- @param lineID --- The line number of the double clicked line.
    -- @param line --- The double clicked DListView_Line.
    DoDoubleClick: function(self, lineID: number, line: GPanel)

    --- **INTERNAL**:
    --- Internal helper function called from the PANEL:PerformLayout of DListView.
    FixColumnsLayout: function(self)

    --- Gets the canvas.
    -- @return --- The canvas.
    GetCanvas: function(self): GPanel

    --- Returns the height of the data of the DListView.
    --- See also DListView:SetDataHeight.
    -- @return --- The height of the data of the DListView.
    GetDataHeight: function(self): number

    --- **INTERNAL**:
    --- See DListView:SetDirty.
    -- @return ---
    GetDirty: function(self): boolean

    --- Returns the height of the header of the DListView.
    --- See also DListView:SetHeaderHeight.
    -- @return --- The height of the header of the DListView.
    GetHeaderHeight: function(self): number

    --- Returns whether the header line should be visible on not.
    -- @return --- Whether the header line should be visible on not.
    GetHideHeaders: function(self): boolean

    --- Returns the height of DListView:GetCanvas.
    --- Intended to represent the height of all data lines.
    -- @return --- The height of DListView:GetCanvas.
    GetInnerTall: function(self): number

    --- Gets the DListView_Line at the given index.
    -- @param id --- The index of the line to get.
    -- @return --- The DListView_Line at the given index.
    GetLine: function(self, id: number): GPanel

    --- Gets all of the lines added to the DListView.
    -- @return --- The lines added to the DListView.
    GetLines: function(self): table

    --- Returns whether multiple lines can be selected or not.
    --- See DListView:SetMultiSelect.
    -- @return --- Whether multiple lines can be selected or not.
    GetMultiSelect: function(self): boolean

    --- Gets all of the lines that are currently selected.
    -- @return --- A table of DListView_Lines.
    GetSelected: function(self): table

    --- Gets the currently selected DListView_Line index.
    --- If DListView:SetMultiSelect is set to true, only the first line of all selected lines will be returned. Use DListView:GetSelected instead to get all of the selected lines.
    -- @return --- The index of the currently selected line.
    -- @return --- The currently selected DListView_Line.
    GetSelectedLine: function(self): number, GPanel

    --- Returns whether sorting of columns by clicking their headers is allowed or not.
    --- See also DListView:SetSortable.
    -- @return --- Whether sorting of columns by clicking their headers is allowed or not
    GetSortable: function(self): boolean

    --- **INTERNAL**:
    --- Converts LineID to SortedID
    -- @param lineId --- The DListView_Line:GetID of a line to look up
    -- @return ---
    GetSortedID: function(self, lineId: number): number

    --- **INTERNAL**: Use DListView:OnRowSelected instead!
    --- Called whenever a line is clicked.
    -- @param line --- The selected line.
    -- @param isSelected --- Boolean indicating whether the line is selected.
    OnClickLine: function(self, line: GPanel, isSelected: boolean)

    --- **INTERNAL**:
    --- Called from DListView_Column.
    -- @param column --- The column which initialized the resize
    -- @param size ---
    OnRequestResize: function(self, column: GPanel, size: number)

    --- Called when a row is right-clicked
    -- @param lineID --- The line ID of the right clicked line
    -- @param line --- The line panel itself, a DListView_Line.
    OnRowRightClick: function(self, lineID: number, line: GPanel)

    --- Called internally by DListView:OnClickLine when a line is selected. This is the function you should override to define the behavior when a line is selected.
    -- @param rowIndex --- The index of the row/line that the user clicked on.
    -- @param row --- The DListView_Line that the user clicked on.
    OnRowSelected: function(self, rowIndex: number, row: GPanel)

    --- Removes a line from the list view.
    -- @param line --- Removes the given row, by row id (same number as DListView:GetLine).
    RemoveLine: function(self, line: number)

    --- Selects the line at the first index of the DListView if one has been added.
    SelectFirstItem: function(self)

    --- Selects a line in the listview.
    -- @param Line --- The line to select.
    SelectItem: function(self, Line: GPanel)

    --- Sets the height of all lines of the DListView except for the header line.
    --- See also DListView:SetHeaderHeight.
    -- @param height --- The new height to set. Default value is 17.
    SetDataHeight: function(self, height: number)

    --- **INTERNAL**:
    --- Used internally to signify if the DListView needs a rebuild.
    -- @param isDirty ---
    SetDirty: function(self, isDirty: boolean)

    --- Sets the height of the header line of the DListView.
    --- See also DListView:SetDataHeight.
    -- @param height --- The new height to set. Default value is 16.
    SetHeaderHeight: function(self, height: number)

    --- Sets whether the header line should be visible on not.
    -- @param hide --- Whether the header line should be visible on not.
    SetHideHeaders: function(self, hide: boolean)

    --- Sets whether multiple lines can be selected by the user by using the `` or `` keys. When set to false, only one line can be selected.
    -- @param allowMultiSelect --- Whether multiple lines can be selected or not
    SetMultiSelect: function(self, allowMultiSelect: boolean)

    --- Enables/disables the sorting of columns by clicking.
    --- **NOTE**: This will only affect columns that are created after this function is called. Existing columns will be unaffected.
    -- @param isSortable --- Whether sorting columns with clicking is allowed or not.
    SetSortable: function(self, isSortable: boolean)

    --- Sorts the items in the specified column.
    -- @param columnIndex --- The index of the column that should be sorted.
    -- @param descending --- Whether the items should be sorted in descending order or not.
    SortByColumn: function(self, columnIndex: number, descending: boolean)

    --- Sorts the list based on given columns.
    --- All arguments are optional
    -- @param column1 ---
    -- @param descrending1 ---
    -- @param column2 ---
    -- @param descrending2 ---
    -- @param column3 ---
    -- @param descrending3 ---
    -- @param column4 ---
    -- @param descrending4 ---
    SortByColumns: function(self, column1: number, descrending1: boolean, column2: number, descrending2: boolean, column3: number, descrending3: boolean, column4: number, descrending4: boolean)
end

--- A vertical list of panels that optionally allows child elements to be rearranged with the mouse cursor.
--- Child panels' widths are set to the width of the DListLayout, and it resizes vertically to accommodate the heights of all children. You can place this inside a DScrollPanel when adding many panels.
--- To enable the drag & drop rearrangement functionality, call DDragBase:MakeDroppable on the DListLayout with a unique identifier. All panels added following this will be moveable.
global interface DListLayout is DDragBase

end

--- @deprecated
--- **DEPRECATED**: Used Internally by DListBox.
global interface DListBoxItem is DLabel
    --- Returns the parent "mother" of this **DListBoxItem** set by DListBoxItem:SetMother.
    -- @return --- The "mother" DListBox.
    GetMother: function(self): GPanel

    --- Selects this item.
    -- @param onlyMe --- Whether to deselect other items.
    Select: function(self, onlyMe: boolean)

    --- **INTERNAL**:
    --- Sets the "mother" (parent) panel for this item. Done internally by DListBox:AddItem
    -- @param parent --- The "mother" panel to set.
    SetMother: function(self, parent: GPanel)
end

--- @deprecated
--- **DEPRECATED**: Derived from the deprecated DPanelList.
--- A simple list box with optional multi-select.
--- As this is deprecated, it is recommended that you use DListView, which contains the same functionality with multi-column options.
global interface DListBox is DPanelList
    --- Returns whether the list box can select multiple items.
    -- @return multiple --- Whether the list box can select multiple items.
    GetMultiple: function(self): boolean

    --- Returns selected items.
    -- @return --- The selected items. A list of DListBoxItem.
    GetSelectedItems: function(self): table

    --- Returns selected item values.
    -- @return --- The selected item values. A list of Panel:GetValue of each selected DListBoxItem.
    GetSelectedValues: function(self): table

    --- Select a DListBoxItem based on its value.
    -- @param val --- Panel:GetValue of a DListBoxItem to select.
    SelectByName: function(self, val: string)

    --- **INTERNAL**:
    --- Used internally to select a specific panel.
    -- @param item --- DListBox to select.
    -- @param onlyme --- Whether to deselect other selected items.
    SelectItem: function(self, item: GPanel, onlyme: boolean)

    --- Sets whether the list box can select multiple items.
    -- @param multiple --- Whether the list box can select multiple items.
    SetMultiple: function(self, multiple: boolean)

    --- **INTERNAL**:
    --- Sets selected items.
    -- @param items --- The items to select. A list of DListBoxItem.
    SetSelectedItems: function(self, items: table)
end

--- Underlined link label without a DoClick function. When a valid URL is set and the label is clicked, it will open a browser window and navigate to the address.
--- This panel uses gui.OpenURL internally and its restrictions apply.
global interface DLabelURL is VURLLabel
    --- @deprecated
    --- **DEPRECATED**:
    --- Does absolutely nothing at all.
    -- @return draw --- Does nothing.
    GetAutoStretchVertical: function(self): boolean

    --- Gets the current text color of the DLabelURL. Returns either DLabelURL:GetTextColor or if that is unset -  DLabelURL:GetTextStyleColor.
    -- @return --- The current text Global.Color.
    GetColor: function(self): table

    --- Gets the current text color of the DLabelURL set by DLabelURL:SetTextColor.
    -- @return --- The current text Global.Color.
    GetTextColor: function(self): table

    --- Returns the color set by DLabelURL:SetTextStyleColor.
    -- @return --- The Color
    GetTextStyleColor: function(self): table

    --- @deprecated
    --- **DEPRECATED**:
    --- Does absolutely nothing at all.
    -- @param draw --- Does nothing.
    SetAutoStretchVertical: function(self, draw: boolean)

    --- Alias of DLabelURL:SetTextColor.
    -- @param col --- The Global.Color to use.
    SetColor: function(self, col: table)

    --- Sets the text color of the DLabelURL. Overrides DLabelURL:SetTextStyleColor.
    --- This should only be used immediately after it is created, and otherwise Panel:SetFGColor.
    -- @param col --- The Global.Color to use.
    SetTextColor: function(self, col: table)

    --- Sets the base text color of the DLabelURL. This is overridden by DLabelURL:SetTextColor.
    -- @param color --- The Global.Color to set
    SetTextStyleColor: function(self, color: table)

    --- **INTERNAL**:
    --- Used internally to set correct text color via Panel:SetFGColor and DLabelURL:GetColor.
    UpdateFGColor: function(self)
end

--- Uses the killicon to persistently draw a killicon.
global interface DKillIcon is GPanel
    --- Gets the killicon being shown.
    -- @return --- The name of the killicon currently being displayed.
    GetName: function(self): string

    --- Sets the killicon to be displayed. You should call Panel:SizeToContents following this.
    --- Killicons can be added with killicon.Add and killicon.AddFont.
    -- @param iconName --- The name of the killicon to be displayed.
    SetName: function(self, iconName: string)
end

--- DImage is an advanced, more robust version of the Material panel.
--- See DImageButton for a click-able version of this panel.
global interface DImage is DPanel
    --- **INTERNAL**:
    --- Actually loads the IMaterial to render it. Called from DImage:LoadMaterial.
    DoLoadMaterial: function(self)

    --- **INTERNAL**:
    --- "Fixes" the current material of the DImage if it has VertexLit shader by creating a new one with the same name and a prefix of "_DImage" and automatically calling DImage:SetMaterial with the new material.
    --- This fixes the problem where using materials using shaders that expect lighting information causing "weird" flickering when displayed in 2D/Unlit environment.
    FixVertexLitMaterial: function(self)

    --- **INTERNAL**:
    --- Returns the texture path set by DImage:SetFailsafeMatName.
    -- @return ---
    GetFailsafeMatName: function(self): string

    --- Returns the image loaded in the image panel.
    -- @return --- The path to the image that is loaded.
    GetImage: function(self): string

    --- Returns the color override of the image panel.
    -- @return col --- The color override of the image. Uses the Color.
    GetImageColor: function(self): table

    --- Returns whether the DImage should keep the aspect ratio of its image when being resized.
    --- See DImage:SetKeepAspect for more info on how it works.
    -- @return --- Whether the DImage should keep the aspect ratio of its image when being resized.
    GetKeepAspect: function(self): boolean

    --- **INTERNAL**:
    --- Returns the texture path set by DImage:SetMatName.
    -- @return ---
    GetMatName: function(self): string

    --- Returns the current Global.Material of the DImage.
    -- @return ---
    GetMaterial: function(self): GIMaterial

    --- **INTERNAL**:
    --- Initializes the loading process of the material to render if it is not loaded yet.
    --- You do not need to call this function. It is done for you automatically.
    LoadMaterial: function(self)

    --- Paints a ghost copy of the DImage panel at the given position and dimensions. This function overrides Panel:PaintAt.
    -- @param posX --- The x coordinate to draw the panel from.
    -- @param posY --- The y coordinate to draw the panel from.
    -- @param width --- The width of the panel image to be drawn.
    -- @param height --- The height of the panel image to be drawn.
    --PaintAt: function(self, posX: number, posY: number, width: number, height: number)

    --- **INTERNAL**:
    --- Sets the backup material to be loaded when the image is first rendered. Used by DImage:SetOnViewMaterial.
    -- @param backupMat ---
    SetFailsafeMatName: function(self, backupMat: string)

    --- Sets the image to load into the frame. If the first image can't be loaded and `strBackup` is set, that image will be loaded instead.
    --- This eventually calls DImage:SetMaterial.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dimage.lua#L91)
    -- @param strImage --- The path of the image to load, relative to the `materials/` folder. When no file extension is supplied the `.vmt` file extension is assumed.
    -- @param strBackup --- The path of the backup image.
    SetImage: function(self, strImage: string, strBackup: string)

    --- Sets the image's color override.
    -- @param col --- The color override of the image. Uses the Color.
    SetImageColor: function(self, col: table)

    --- Sets whether the DImage should keep the aspect ratio of its image when being resized.
    --- Note that this will not try to fit the image inside the button, but instead it will fill the button with the image.
    -- @param keep --- true to keep the aspect ratio, false not to
    SetKeepAspect: function(self, keep: boolean)

    --- **INTERNAL**:
    --- Sets the material to be loaded when the image is first rendered. Used by DImage:SetOnViewMaterial.
    -- @param mat ---
    SetMatName: function(self, mat: string)

    --- Sets a Global.Material directly as an image.
    -- @param mat --- The material to set
    SetMaterial: function(self, mat: GIMaterial)

    --- Similar to DImage:SetImage, but will only do the expensive part of actually loading the textures/material if the material is about to be rendered/viewed.
    --- Useful for cases like DIconBrowser, where there are hundreds of small icons in 1 panel in a list that do not need all to be loaded at the same time.
    -- @param mat ---
    -- @param backupMat ---
    SetOnViewMaterial: function(self, mat: string, backupMat: string)

    --- Returns true if the image is **not** yet loaded.
    -- @return ---
    Unloaded: function(self): boolean
end

--- Simply a DIconLayout which automatically displays all of the Silkicons.
--- Used as a way to get the user to select an icon.
global interface DIconBrowser is DScrollPanel
    --- **INTERNAL**:
    --- Automatically called to fill the browser with icons. Will not work if DIconBrowser:SetManual is set to true.
    Fill: function(self)

    --- A simple unused search feature, hides all icons that do not contain given text in their file path.
    -- @param text --- The text to search for
    FilterByText: function(self, text: string)

    --- Returns whether or not the browser should fill itself with icons.
    -- @return ---
    GetManual: function(self): boolean

    --- Returns the currently selected icon's file path.
    -- @return --- The currently selected icon's file path.
    GetSelectedIcon: function(self): string

    --- Called when the selected icon was changed. Use DIconBrowser:GetSelectedIcon to get the selected icon's filepath.
    OnChange: function(self)

    --- **INTERNAL**:
    --- Use DIconBrowser:OnChange instead
    OnChangeInternal: function(self)

    --- Scrolls the browser to the selected icon
    ScrollToSelected: function(self)

    --- Selects an icon from file path
    -- @param icon --- The file path of the icon to select. Do not include the "materials/" part.
    SelectIcon: function(self, icon: string)

    --- Sets whether or not the browser should automatically fill itself with icons.
    -- @param manual ---
    SetManual: function(self, manual: boolean)

    --- **INTERNAL**:
    --- Set the currently selected file path. Do not use. Use DIconBrowser:SelectIcon instead.
    -- @param str ---
    SetSelectedIcon: function(self, str: string)
end

--- An element providing navigation controls for a DHTML window.
global interface DHTMLControls is GPanel
    --- **INTERNAL**:
    FinishedLoading: function(self)

    --- Sets the color of the navigation buttons.
    -- @param clr --- A Color
    SetButtonColor: function(self, clr: table)

    --- Sets the DHTML element to control with these DHTMLControls.
    -- @param dhtml --- The HTML panel
    --SetHTML: function(self, dhtml: GPanel)

    --- **INTERNAL**:
    StartedLoading: function(self)

    --- **INTERNAL**:
    --- Basically adds an URL to the history.
    -- @param url ---
    UpdateHistory: function(self, url: string)

    --- **INTERNAL**:
    UpdateNavButtonStatus: function(self)
end

--- The DHTML control wraps the internal web engine, supports calling Javascript functions from Lua,
--- as well as running Lua from within the HTML. Running Lua code is disabled by default.
global interface DHTML is VHTML
    --- Defines a Javascript function that when called will call a Lua callback.
    --- **NOTE**: Must be called after the HTML document has fully loaded.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dhtml.lua#L123-L146)
    -- @param library --- Library name of the JS function you are defining.
    -- @param name --- Name of the JS function you are defining.
    -- @param callback --- Function called when the JS function is called. Arguments passed to the JS function will be passed here.
    AddFunction: function(self, library: string, name: string, callback: function)

    --- Runs/Executes a string as JavaScript code in a panel.
    --- **NOTE**: This function does **NOT** evaluate expression (i.e. allow you to pass variables from JavaScript (JS) to Lua context).
    --- Because a return value is nil/no value (a.k.a. void).
    --- If you wish to pass/return values from JS to Lua, you may want to use DHTML:AddFunction function to accomplish that job.
    --- **NOTE**: This function is an alias of DHTML:QueueJavascript ([source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dhtml.lua#L62)).
    -- @param js --- Specify JavaScript code to be executed.
    Call: function(self, js: string)

    --- Returns if the loaded page can run Lua code, set by DHTML:SetAllowLua
    -- @return --- Whether or not Lua code can be called from the loaded page.
    GetAllowLua: function(self): boolean

    --- @deprecated
    --- **DEPRECATED**: Broken. Use the CSS `overflow` rule instead.
    --- Returns the value set by DHTML:SetScrollbars.
    -- @return show --- True if scrollbars should be visible.
    GetScrollbars: function(self): boolean

    --- Runs/Executes a string as JavaScript code in a panel.
    --- **NOTE**: This function does **NOT** evaluate expression (i.e. allow you to pass variables from JavaScript (JS) to Lua context).
    --- Because a return value is nil/no value (a.k.a. void).
    --- If you wish to pass/return values from JS to Lua, you may want to use DHTML:AddFunction function to accomplish that job.
    --- **NOTE**: If Panel:IsVisible is `false`, PANEL:Think will **NOT** run, meaning the Javascript Queue will not be processed.
    --- Consider overriding PANEL:Paint to stop the panel from drawing instead.
    -- @param js --- Specify JavaScript code to be executed.
    QueueJavascript: function(self, js: string)

    --- Determines whether the loaded page can run Lua code or not. See DHTML for how to run Lua from a DHTML window.
    -- @param allow --- Whether or not to allow Lua.
    SetAllowLua: function(self, allow: boolean)

    --- @deprecated
    --- **DEPRECATED**: Broken. Use the CSS `overflow` rule instead.
    ---  Sets if the loaded window should display scrollbars when the webpage is larger than the viewing window. This is similar to the CSS `overflow` rule.
    -- @param show --- True if scrollbars should be visible.
    SetScrollbars: function(self, show: boolean)
end

--- A generic horizontal scrollbar. See the vertical alternative [here](DVScrollBar).
--- The scrollbar notably contains `DHScrollBar.btnLeft`, `DHScrollBar.btnRight`, and `DHScrollBar.btnGrip` which are the left button, right button, and grip respectively. Editing the paint functions of these allows custom scrollbar styling, although it is a better idea to use [Derma Skins](Derma_Skin_Creation).
global interface DHScrollBar is GPanel
    --- Adds specified amount of scroll in pixels.
    -- @param add --- How much to scroll rightwards. Can be negative for leftwards scroll
    -- @return --- True if the scroll level was changed (i.e. if we did or did not scroll)
    AddScroll: function(self, add: number): boolean

    --- Smoothly scrolls to given level.
    -- @param scroll --- The scroll level to animate to. In pixels from the left ( from 0 )
    -- @param length --- Length of the animation in seconds
    -- @param delay --- Delay of the animation in seconds
    -- @param ease --- See Panel:NewAnimation for explanation.
    AnimateTo: function(self, scroll: number, length: number, delay: number, ease: number)

    --- Returns the scale of the scroll bar based on the difference in size between the visible "window" into the canvas that is being scrolled. Should be used after DHScrollBar:SetUp.
    -- @return --- The scale of the scrollbar.
    BarScale: function(self): number

    --- Returns whether or not the manual left/right scroll buttons are visible or not. Set by DHScrollBar:SetHideButtons.
    -- @return --- Whether or not the manual left/right scroll buttons are visible or not.
    GetHideButtons: function(self): boolean

    --- Returns the negative of DHScrollBar:GetScroll.
    -- @return --- The scroll offset.
    GetOffset: function(self): number

    --- Returns the amount of scroll level from the left in pixels.
    -- @return --- The amount of scroll level from the left edge.
    GetScroll: function(self): number

    --- **INTERNAL**:
    --- Called from within DScrollBarGrip
    Grip: function(self)

    --- Allows hiding the left and right buttons for better visual stylisation.
    -- @param hide --- True to hide
    SetHideButtons: function(self, hide: boolean)

    --- Sets the scroll level in pixels.
    -- @param scroll --- The new scroll value.
    SetScroll: function(self, scroll: number)

    --- Sets up the scrollbar for use.
    --- The scrollbar will automatically disable itself if the total width of the canvas is lower than the width of the panel that holds the canvas during this function call.
    -- @param barSize --- The size of the panel that holds the canvas, basically size of "1 page".
    -- @param canvasSize --- The total size of the canvas, this typically is the bigger number.
    SetUp: function(self, barSize: number, canvasSize: number)
end

--- A very basic horizontal scrollable panel, similar to DScrollPanel.
--- Used internally in DPropertySheet.
global interface DHorizontalScroller is GPanel
    --- Adds a panel to the DHorizontalScroller.
    -- @param pnl --- The panel to add. It will be automatically parented.
    AddPanel: function(self, pnl: GPanel)

    --- Returns the internal canvas panel where the content of DHorizontalScroller are placed on.
    -- @return --- The DDragBase panel.
    GetCanvas: function(self): GPanel

    --- Returns the overlap set by DHorizontalScroller:SetOverlap.
    -- @return --- The overlap.
    GetOverlap: function(self): number

    --- Returns whether this panel should show drop targets.
    -- @return ---
    GetShowDropTargets: function(self): boolean

    --- Same as DDragBase:MakeDroppable.
    --- TODO: Transclude or whatever to here?
    -- @param name ---
    MakeDroppable: function(self, name: string)

    --- Called when the panel is scrolled.
    OnDragModified: function(self)

    --- Scrolls the DHorizontalScroller to given child panel.
    -- @param target --- The target child panel. Must be a child of DHorizontalScroller:GetCanvas
    ScrollToChild: function(self, target: GPanel)

    --- Controls the spacing between elements of the horizontal scroller.
    -- @param overlap --- Overlap in pixels. Positive numbers will make elements `overlap` each other, negative will add spacing.
    SetOverlap: function(self, overlap: number)

    --- Sets the scroll amount, automatically clamping the value.
    -- @param scroll --- The new scroll amount
    SetScroll: function(self, scroll: number)

    --- Sets whether this panel should show drop targets.
    -- @param newState ---
    SetShowDropTargets: function(self, newState: boolean)

    --- Same as DDragBase:SetUseLiveDrag
    -- @param newState ---
    SetUseLiveDrag: function(self, newState: boolean)
end

--- Creates an invisible vertical divider between two GUI elements.
global interface DHorizontalDivider is DPanel
    --- Returns the width of the horizontal divider bar, set by DHorizontalDivider:SetDividerWidth.
    -- @return --- The width of the horizontal divider bar
    GetDividerWidth: function(self): number

    --- Returns whether or not the player is currently dragging the middle divider bar.
    -- @return --- Whether or not the player is currently dragging the middle divider bar.
    GetDragging: function(self): boolean

    --- **INTERNAL**:
    --- Returns the local X coordinate of where the player started dragging the thing
    -- @return ---
    GetHoldPos: function(self): number

    --- Returns the left side content of the DHorizontalDivider
    -- @return --- The content on the left side
    GetLeft: function(self): GPanel

    --- Returns the minimum width of the left side, set by DHorizontalDivider:SetLeftMin.
    -- @return --- The minimum width of the left side
    GetLeftMin: function(self): number

    --- Returns the current width of the left side, set by DHorizontalDivider:SetLeftWidth or by the user.
    -- @return --- The current width of the left side
    GetLeftWidth: function(self): number

    --- Returns the middle content, set by DHorizontalDivider:SetMiddle.
    -- @return --- The middle content
    GetMiddle: function(self): GPanel

    --- Returns the right side content
    -- @return --- The right side content
    GetRight: function(self): GPanel

    --- Returns the minimum width of the right side, set by DHorizontalDivider:SetRightMin.
    -- @return --- The minimum width of the right side
    GetRightMin: function(self): number

    --- Sets the width of the horizontal divider bar.
    -- @param width --- The width of the horizontal divider bar.
    SetDividerWidth: function(self, width: number)

    --- **INTERNAL**:
    --- Sets whether the player is dragging the divider or not
    -- @param dragonot ---
    SetDragging: function(self, dragonot: boolean)

    --- **INTERNAL**:
    --- Sets the local X coordinate of where the player started dragging the thing
    -- @param x ---
    SetHoldPos: function(self, x: number)

    --- Sets the left side content of the DHorizontalDivider.
    -- @param pnl --- The panel to set as the left side
    SetLeft: function(self, pnl: GPanel)

    --- Sets the minimum width of the left side
    -- @param minWidth --- The minimum width of the left side
    SetLeftMin: function(self, minWidth: number)

    --- Sets the current/starting width of the left side.
    --- The width of the right side is automatically calculated by subtracting this from the total width of the DHorizontalDivider.
    -- @param width --- The current/starting width of the left side
    SetLeftWidth: function(self, width: number)

    --- Sets the middle content, over the draggable divider bar panel.
    -- @param middle --- The middle content
    SetMiddle: function(self, middle: GPanel)

    --- Sets the right side content
    -- @param pnl --- The right side content
    SetRight: function(self, pnl: GPanel)

    --- Sets the minimum width of the right side
    -- @param minWidth --- The minimum width of the right side
    SetRightMin: function(self, minWidth: number)

    --- **INTERNAL**:
    --- **VALIDATE**: TODO Document me
    StartGrab: function(self)
end

--- A really simple grid layout panel.
--- **NOTE**: This panel will set its size automatically based on set column count.
--- This makes it play badly with Panel:Dock and cause a PANEL:PerformLayout call every frame.
global interface DGrid is GPanel
    --- Adds a new item to the grid.
    -- @param item --- The item to add. It will be forced visible and parented to the DGrid.
    AddItem: function(self, item: GPanel)

    --- Returns the width of each column of the DGrid, which is set by DGrid:SetColWide.
    -- @return --- The width of each column
    GetColWide: function(self): number

    --- Returns the number of columns of this DGrid. Set by DGrid:SetCols.
    -- @return --- The number of columns of this DGrid
    GetCols: function(self): number

    --- Returns a list of panels in the grid.
    -- @return --- A list of Panels.
    GetItems: function(self): table

    --- Returns the height of each row of the DGrid, which is set by DGrid:SetRowHeight.
    -- @return --- The height of each row
    GetRowHeight: function(self): number

    --- Removes given panel from the DGrid:GetItems.
    -- @param item --- Item to remove from the grid
    -- @param bDontDelete --- If set to true, the actual panel will not be removed via Panel:Remove.
    RemoveItem: function(self, item: GPanel, bDontDelete: boolean)

    --- Sets the width of each column.
    --- The cell panels (grid items) will not be resized or centered.
    -- @param colWidth --- The width of each column.
    SetColWide: function(self, colWidth: number)

    --- Sets the number of columns this panel should have.
    --- The DGrid will resize its width to match this value.
    -- @param cols --- The desired number of columns
    SetCols: function(self, cols: number)

    --- Sets the height of each row.
    --- The cell panels (grid items) will not be resized or centered.
    -- @param rowHeight --- The height of each row
    SetRowHeight: function(self, rowHeight: number)

    --- Sorts the items in the grid. Does not visually update the grid, use Panel:InvalidateLayout for that.
    -- @param key --- A key in the panel from DGrid:GetItems. The key's value must be numeric.
    -- @param desc --- True for descending order, false for ascending.
    SortByMember: function(self, key: string, desc: boolean)
end

--- A tree and list-based file browser.
--- It allows filtering by folder (directory) name and file extension, and can display models as SpawnIcons.
global interface DFileBrowser is DPanel
    --- Clears the file tree and list, and resets all values.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L273-L283)
    Clear: function(self)

    --- An Global.AccessorFunc that returns the root directory/folder of the file tree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L7)
    -- @return --- The path to the root folder.
    GetBaseFolder: function(self): string

    --- An Global.AccessorFunc that returns the current directory/folder being displayed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L8)
    -- @return --- The directory the file list is currently displaying.
    GetCurrentFolder: function(self): string

    --- An Global.AccessorFunc that returns the current file type filter on the file list.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L6)
    -- @return --- The current filter applied to the file list.
    GetFileTypes: function(self): string

    --- Returns the DTree Node that the file tree stems from.
    --- This is a child of the root node of the DTree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L267-L271)
    -- @return --- The DTree_Node used for the tree.
    GetFolderNode: function(self): GPanel

    --- An Global.AccessorFunc that returns whether or not the model viewer mode is enabled. In this mode, files are displayed as SpawnIcons instead of a list.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L10)
    -- @return --- Whether or not files will be displayed using SpawnIcons.
    GetModels: function(self): boolean

    --- An Global.AccessorFunc that returns the name being used for the file tree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L4)
    -- @return --- The name used for the root of the file tree.
    GetName: function(self): string

    --- An Global.AccessorFunc that returns whether or not the file tree is open.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L11)
    -- @return --- Whether or not the file tree is open.
    GetOpen: function(self): boolean

    --- An Global.AccessorFunc that returns the access path of the file tree. This is `GAME` unless changed with DFileBrowser:SetPath.
    --- See file.Read for how paths work.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L5)
    -- @return --- The current access path i.e. "GAME", "LUA", "DATA" etc.
    GetPath: function(self): string

    --- An Global.AccessorFunc that returns the current search filter on the file tree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L9)
    -- @return --- The filter in use on the file tree.
    GetSearch: function(self): string

    --- Called when a file is double-clicked.
    --- **NOTE**: Double-clicking a file or icon will trigger **both** this and DFileBrowser:OnSelect.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L297-L301)
    -- @param selectedPanel --- The panel that was double-clicked to select this file.
    --- This will either be a DListView_Line or SpawnIcon depending on whether the model viewer mode is enabled. See DFileBrowser:SetModels.
    -- @param filePath --- The path to the file that was double-clicked.
    OnDoubleClick: function(self, selectedPanel: GPanel, filePath: string)

    --- Called when a file is right-clicked.
    --- **NOTE**: When not in model viewer mode, DFileBrowser:OnSelect will also be called if the file is not already selected.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L303-L307)
    -- @param filePath --- The path to the file that was right-clicked.
    -- @param selectedPanel --- The panel that was right-clicked to select this file.
    --- This will either be a DListView_Line or SpawnIcon depending on whether the model viewer mode is enabled.
    --- See DFileBrowser:SetModels.
    OnRightClick: function(self, filePath: string, selectedPanel: GPanel)

    --- Called when a file is selected.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L291-L295)
    -- @param selectedPanel --- The panel that was clicked to select this file.
    --- This will either be a DListView_Line or SpawnIcon depending on whether the model viewer mode is enabled. See DFileBrowser:SetModels.
    -- @param filePath --- The path to the file that was selected.
    OnSelect: function(self, selectedPanel: GPanel, filePath: string)

    --- An Global.AccessorFunc that sets the root directory/folder of the file tree.
    --- This needs to be set for the file tree to be displayed.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L50-L57)
    -- @param baseDir --- The path to the folder to use as the root.
    SetBaseFolder: function(self, baseDir: string)

    --- An Global.AccessorFunc that sets the directory/folder from which to display the file list.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L104-L118)
    -- @param currentDir --- The directory to display files from.
    SetCurrentFolder: function(self, currentDir: string)

    --- An Global.AccessorFunc that sets the file type filter for the file list.
    --- This accepts the same file extension wildcards as file.Find.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L81-L90)
    -- @param fileTypes --- A list of file types to display, separated by spaces e.g.
    --- ```
    --- "*.lua *.txt *.mdl"
    --- ```
    SetFileTypes: function(self, fileTypes: string)

    --- Enables or disables the model viewer mode. In this mode, files are displayed as SpawnIcons instead of a list.
    --- **NOTE**: This should only be used for `.mdl` files; the spawn icons will display error models for others. See DFileBrowser:SetFileTypes
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L92-L102)
    -- @param showModels --- Whether or not to display files using SpawnIcons.
    SetModels: function(self, showModels: boolean)

    --- An Global.AccessorFunc that sets the name to use for the file tree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L36-L48)
    -- @param treeName --- The name for the root of the file tree. Passing no value causes this to be the base folder name. See DFileBrowser:SetBaseFolder.
    SetName: function(self, treeName: string)

    --- An Global.AccessorFunc that opens or closes the file tree.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L120-L131)
    -- @param open --- `true` to open the tree, `false` to close it.
    -- @param useAnim --- If `true`, the DTree's open/close animation is used.
    SetOpen: function(self, open: boolean, useAnim: boolean)

    --- An Global.AccessorFunc that sets the access path for the file tree. This is set to `GAME` by default.
    --- See file.Read for how paths work.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L59-L66)
    -- @param path --- The access path i.e. "GAME", "LUA", "DATA" etc.
    SetPath: function(self, path: string)

    --- An Global.AccessorFunc that sets the search filter for the file tree.
    --- This accepts the same wildcards as file.Find.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L68-L79)
    -- @param filter --- The filter to use on the file tree.
    SetSearch: function(self, filter: string)

    --- **INTERNAL**:
    ---  Called to set up the DTree and file viewer when a base path has been set.
    --- Calls DFileBrowser:SetupTree and DFileBrowser:SetupFiles.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L202-L208)
    -- @return --- Whether or not the variables needed to set up have been defined.
    Setup: function(self): boolean

    --- **INTERNAL**:
    ---  Called to set up the DListView or DIconBrowser by DFileBrowser:Setup.
    --- The icon browser is used when in models mode. See DFileBrowser:SetModels.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L169-L200)
    -- @return --- Whether or not the files pane was set up successfully.
    SetupFiles: function(self): boolean

    --- **INTERNAL**:
    ---  Called to set up the DTree by DFileBrowser:Setup.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L143-L167)
    -- @return --- Whether or not the tree was set up successfully.
    SetupTree: function(self): boolean

    --- **INTERNAL**:
    --- Builds the file or icon list for the current directory.
    --- You should use DFileBrowser:SetCurrentFolder to change the directory.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dfilebrowser.lua#L210-L257)
    -- @param currentDir --- The directory to populate the list from.
    ShowFolder: function(self, currentDir: string)

    --- Sorts the file list.
    --- **NOTE**: This is only functional when not using the model viewer. See DFileBrowser:SetModels
    -- @param descending --- The sort order. `true` for descending (z-a), `false` for ascending (a-z).
    SortFiles: function(self, descending: boolean)
end

--- **INTERNAL**:
--- The little "+" button used by DProperties and DTree_Node.
global interface DExpandButton is DButton
    --- Returns whether this DExpandButton is expanded or not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dexpandbutton.lua#L4)
    -- @return --- True if expanded, false otherwise
    GetExpanded: function(self): boolean

    --- Sets whether this DExpandButton should be expanded or not. Only changes appearance.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dexpandbutton.lua#L4)
    -- @param expanded --- True to expand ( visually will show a "-" )
    SetExpanded: function(self, expanded: boolean)
end

--- **INTERNAL**: Unless you know what you are doing and you benefit from this panel, you should be using the DProperties instead.
--- A panel used by the Editable Entities system.
global interface DEntityProperties is DProperties
    --- **INTERNAL**:
    --- Called internally by DEntityProperties:RebuildControls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dentityproperties.lua#L59-L94)
    -- @param varname ---
    -- @param editdata ---
    EditVariable: function(self, varname: string, editdata: table)

    --- **INTERNAL**:
    --- Called internally when an entity being edited became invalid.
    --- You should use DEntityProperties:OnEntityLost instead.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dentityproperties.lua#L99-L104)
    EntityLost: function(self)

    --- Called when we were editing an entity and then it became invalid (probably removed). For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dentityproperties.lua#L106-L110)
    OnEntityLost: function(self)

    --- **INTERNAL**:
    --- Called internally by DEntityProperties:SetEntity to rebuild the controls.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dentityproperties.lua#L26-L54)
    RebuildControls: function(self)

    --- Sets the entity to be edited by this panel. The entity must support the Editable Entities system or nothing will happen.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dentityproperties.lua#L14-L21)
    -- @param ent --- The entity to edit
    SetEntity: function(self, ent: GEntity)
end

--- Similar to DPropertySheet, but with tabs on the left.
global interface DColumnSheet is GPanel
    --- Adds a new column/tab.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolumnsheet.lua#L24-L62)
    -- @param name --- Name of the column/tab
    -- @param pnl --- Panel to be used as contents of the tab. This normally would be a DPanel
    -- @param icon --- Icon for the tab. This will ideally be a silkicon, but any material name can be used.
    -- @return --- A table containing the following keys:
    --- * DButton / DImageButton Button - The created tab button that will switch to the given panel.
    --- * Panel Panel - The given panel to switch to when the button is pressed.
    AddSheet: function(self, name: string, pnl: GPanel, icon: string): table

    --- An Global.AccessorFunc that returns the active button of this DColumnSheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolumnsheet.lua#L4)
    -- @return --- The active button
    GetActiveButton: function(self): GPanel

    --- **INTERNAL**:
    --- An Global.AccessorFunc that makes a button an active button for this DColumnSheet.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolumnsheet.lua#L64-L83)
    -- @param active --- The button to make active button
    SetActiveButton: function(self, active: GPanel)

    --- Makes the tabs/buttons show only the image and no text.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolumnsheet.lua#L20-L22)
    UseButtonOnlyStyle: function(self)
end

--- The **DColorPalette** allows the player to select a color from a list of given colors.
--- This panel supports saving across sessions via the panel cookie system.
--- Use Panel:SetCookieName to change "save files".
global interface DColorPalette is DIconLayout
    --- @deprecated
    --- **DEPRECATED**:
    --- Basically the same functionality as DColorPalette:OnValueChanged, you should use that instead!
    --- For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L121-L125)
    -- @param clr --- The new color via the Color
    -- @param btn --- The DColorButton that was pressed.
    DoClick: function(self, clr: table, btn: GPanel)

    --- An Global.AccessorFunc that returns the size of each palette button. Set by DColorPalette:SetButtonSize.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L11)
    -- @return --- The size of each palette button
    GetButtonSize: function(self): number

    --- An Global.AccessorFunc that returns the ConVar name for the alpha channel of the color.
    --- See also:
    --- * DColorPalette:GetConVarR - For the red channel
    --- * DColorPalette:GetConVarG - For the green channel
    --- * DColorPalette:GetConVarB - For the blue channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L9)
    -- @return --- The ConVar name for the alpha channel of the color
    GetConVarA: function(self): string

    --- An Global.AccessorFunc that returns the ConVar name for the blue channel of the color.
    --- See also:
    --- * DColorPalette:GetConVarR - For the red channel
    --- * DColorPalette:GetConVarG - For the green channel
    --- * DColorPalette:GetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L8)
    -- @return --- The ConVar name for the blue channel of the color
    GetConVarB: function(self): string

    --- An Global.AccessorFunc that returns the ConVar name for the green channel of the color.
    --- See also:
    --- * DColorPalette:GetConVarR - For the red channel
    --- * DColorPalette:GetConVarB - For the blue channel
    --- * DColorPalette:GetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L7)
    -- @return --- The ConVar name for the green channel of the color
    GetConVarG: function(self): string

    --- An Global.AccessorFunc that returns the ConVar name for the red channel of the color.
    --- See also:
    --- * DColorPalette:GetConVarG - For the green channel
    --- * DColorPalette:GetConVarB - For the blue channel
    --- * DColorPalette:GetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L6)
    -- @return --- The ConVar name for the red channel of the color
    GetConVarR: function(self): string

    --- An Global.AccessorFunc that returns the number of rows of the palette, provided 6 colors fill each row. This value is equal to the number of colors in the DColorPalette divided by 6.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L13)
    -- @return --- Number of rows of the DColorPalette.
    GetNumRows: function(self): number

    --- **INTERNAL**:
    --- Used internally to make sure changes on one palette affect other palettes with same name.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L103-L119)
    NetworkColorChange: function(self)

    --- Called when a palette button has been pressed. For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L232-L234)
    -- @param pnl --- The DColorButton that was pressed.
    OnRightClickButton: function(self, pnl: GPanel)

    --- Called when the color is changed after clicking a new value. For Override
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L228-L230)
    -- @param newcol --- The new color of the DColorPalette
    OnValueChanged: function(self, newcol: table)

    --- Resets this entire color palette to a default preset one, without saving.
    --- See DColorPalette:ResetSavedColors for version that also saves the changes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L127-L131)
    Reset: function(self)

    --- Resets this entire color palette to a default preset one and saves the changes.
    --- See DColorPalette:Reset for version that does not save the changes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L133-L148)
    ResetSavedColors: function(self)

    --- Saves the color of given button across sessions.
    --- The color is saved as a panel cookie, see Panel:SetCookie and Panel:SetCookieName.
    --- It is expected that the amount of colors per palette (Panel:SetCookieName) is the same every time.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L210-L222)
    -- @param btn --- The button to save the color of. Used to get the ID of the button.
    -- @param clr --- The color to save to this button's index
    SaveColor: function(self, btn: GPanel, clr: table)

    --- Sets the size of each palette button.
    --- This is best kept to such a number, where this equation would return a whole number:
    --- `WidthOfColorPalette / ButtonSize= WholeNumber`
    --- If not, there will be ugly whitespace on the right side of the panel.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L181-L191)
    -- @param size --- Sets the new size
    SetButtonSize: function(self, size: number)

    --- @deprecated
    --- **DEPRECATED**:
    --- Currently does nothing. Intended to "select" the color.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L224-L226)
    -- @param clr ---
    SetColor: function(self, clr: table)

    --- Clears the palette and adds new buttons with given colors.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L164-L179)
    -- @param tab --- A number indexed table where each value is a Color
    SetColorButtons: function(self, tab: table)

    --- An Global.AccessorFunc that sets the ConVar name for the alpha channel of the color.
    --- See also:
    --- * DColorPalette:SetConVarR - For the red channel
    --- * DColorPalette:SetConVarG - For the green channel
    --- * DColorPalette:SetConVarB - For the blue channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L9)
    -- @param convar --- The ConVar name for the alpha channel of the color
    SetConVarA: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the blue channel of the color.
    --- See also:
    --- * DColorPalette:SetConVarR - For the red channel
    --- * DColorPalette:SetConVarG - For the green channel
    --- * DColorPalette:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L8)
    -- @param convar --- The ConVar name for the blue channel of the color
    SetConVarB: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the green channel of the color.
    --- See also:
    --- * DColorPalette:SetConVarR - For the red channel
    --- * DColorPalette:SetConVarB - For the blue channel
    --- * DColorPalette:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L7)
    -- @param convar --- The ConVar name for the green channel of the color
    SetConVarG: function(self, convar: string)

    --- An Global.AccessorFunc that sets the ConVar name for the red channel of the color.
    --- See also:
    --- * DColorPalette:SetConVarG - For the green channel
    --- * DColorPalette:SetConVarB - For the blue channel
    --- * DColorPalette:SetConVarA - For the alpha channel
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L6)
    -- @param convar --- The ConVar name for the red channel of the color
    SetConVarR: function(self, convar: string)

    --- Roughly sets the number of colors that can be picked by the user. If the DColorPalette is exactly 6 rows tall, this function will set the number of colors shown per row in the palette. This is an Global.AccessorFunc
    --- **NOTE**: DColorPalette:Reset or DColorPalette:ResetSavedColors must be called after this function to apply changes.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L13)
    -- @param rows --- Scale for the range of colors that the user can pick. Default is 8.
    SetNumRows: function(self, rows: number)

    --- **INTERNAL**:
    --- Internal helper function for DColorPalette:UpdateConVars.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L193-L199)
    -- @param name --- The name of the console variable to set
    -- @param key --- The key of the 3rd argument to set the convar to
    --- Possible values: "r", "g", "b", "a"
    -- @param clr --- The Color to retrieve the info from.
    UpdateConVar: function(self, name: string, key: string, clr: table)

    --- **INTERNAL**:
    --- Updates all the console variables set by DColorPalette:SetConVarR and so on with given color.
    --- Called internally when a palette color is clicked.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolorpalette.lua#L201-L208)
    -- @param clr --- A Color
    UpdateConVars: function(self, clr: table)
end

--- A standard Derma color mixer
global interface DColorMixer is DPanel
    --- **INTERNAL**:
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L341-L360)
    ConVarThink: function(self)

    --- **INTERNAL**:
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L362-L374)
    -- @param cvar ---
    DoConVarThink: function(self, cvar: string)

    --- An Global.AccessorFunc that returns true if alpha bar is shown, false if not.
    -- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dcolormixer.lua#L10)
    -- @return --- Return true if shown, false if not.

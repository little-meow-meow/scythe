--- Returns whether or not a model is useless by checking that the file path is that of a proper model.
--- If the string ".mdl" is not found in the model name, the function will return true.
--- The function will also return true if any of the following strings are found in the given model name:
--- * "_gesture"
--- * "_anim"
--- * "_gst"
--- * "_pst"
--- * "_shd"
--- * "_ss"
--- * "_posture"
--- * "_anm"
--- * "ghostanim"
--- * "_paths"
--- * "_shared"
--- * "anim_"
--- * "gestures_"
--- * "shared_ragdoll_"
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L312-L334)
-- @param modelName --- The model name to be checked
-- @return --- Whether or not the model is useless
global function IsUselessModel(modelName: string): boolean
end

--- Returns whether an object is valid or not. (Such as entities, Panels, custom table objects and more).
--- Checks that an object is not nil, has an `IsValid` method and if this method returns `true`. If the object has no `IsValid` method, it will return `false`.
--- **NOTE**: If you are sure that the object you are about to check is not `nil` and has the `IsValid` method, it would be more faster to call it directly rather than using `IsValid`.
--- **NOTE**: Due to vehicles being technically valid the moment they're spawned, also use Vehicle:IsValidVehicle to make sure they're fully initialized.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L256-L268)
-- @param toBeValidated --- The table or object to be validated.
-- @return --- True if the object is valid.
global function IsValid(toBeValidated: any): boolean
end

--- Returns if the passed object is a Vector.
-- @param variable --- The variable to perform the type check for.
-- @return --- True if the variable is a Vector.
global function isvector(variable: any): boolean
end

--- Adds javascript function 'language.Update' to an HTML panel as a method to call Lua's language.GetPhrase function.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/javascript_util.lua#L2-L9)
-- @param htmlPanel --- Panel to add javascript function 'language.Update' to.
global function JS_Language(htmlPanel: GPanel)
end

--- Adds javascript function 'util.MotionSensorAvailable' to an HTML panel as a method to call Lua's motionsensor.IsAvailable function.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/javascript_util.lua#L11-L17)
-- @param htmlPanel --- Panel to add javascript function 'util.MotionSensorAvailable' to.
global function JS_Utility(htmlPanel: GPanel)
end

--- Adds workshop related javascript functions to an HTML panel, used by the "Dupes" and "Saves" tabs in the spawnmenu.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/javascript_util.lua#L19-L40)
-- @param htmlPanel --- Panel to add javascript functions to.
global function JS_Workshop(htmlPanel: GPanel)
end

--- Convenience function that creates a DLabel, sets the text, and returns it
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/vgui/dlabel.lua#L307-L314)
-- @param text --- The string to set the label's text to
-- @param parent --- Optional. The panel to parent the DLabel to
-- @return --- The created DLabel
global function Label(text: string, parent: GPanel): GPanel
end

--- Performs a linear interpolation from the start number to the end number.
--- This function provides a very efficient and easy way to smooth out movements.
--- See also math.ease for functions that allow to have non linear animations using linear interpolation.
--- **NOTE**: This function is not meant to be used with constant value in the first argument if you're dealing with animation! Use a value that changes over time. See example for **proper** usage of Lerp for animations.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L292-L302)
-- @param t --- The fraction for finding the result. This number is clamped between 0 and 1. Shouldn't be a constant.
-- @param from --- The starting number. The result will be equal to this if delta is 0.
-- @param to --- The ending number. The result will be equal to this if delta is 1.
-- @return --- The result of the linear interpolation, `from + (to - from) * t`.
global function Lerp(t: number, from: number, to: number): number
end

--- Returns point between first and second angle using given fraction and linear interpolation
--- **NOTE**: This function is not meant to be used with constant value in the first argument, if you're dealing with animation! Use a value that changes over time
-- @param ratio --- Ratio of progress through values
-- @param angleStart --- Angle to begin from
-- @param angleEnd --- Angle to end at
-- @return --- angle
global function LerpAngle(ratio: number, angleStart: GAngle, angleEnd: GAngle): GAngle
end

--- Linear interpolation between two vectors. It is commonly used to smooth movement between two vectors
--- **NOTE**: This function is not meant to be used with constant value in the first argument, if you're dealing with animation! Use a value that changes over time
-- @param fraction --- Fraction ranging from 0 to 1
-- @param from --- The initial Vector
-- @param to --- The desired Vector
-- @return --- The lerped vector.
global function LerpVector(fraction: number, from: GVector, to: GVector): GVector
end

--- Loads all preset settings for the presets and returns them in a table
-- @return --- Preset data
global function LoadPresets(): table
end

--- Returns a localisation for the given token, if none is found it will return the default (second) parameter.
--- @deprecated
--- **DEPRECATED**: Use language.GetPhrase instead.
-- @param localisationToken --- The token to find a translation for.
-- @param default --- The default value to be returned if no translation was found.
-- @return --- The localized string, 128 char limit.
global function Localize(localisationToken: string, default: string): string
end

--- Returns the player object of the current client.
--- **NOTE**: LocalPlayer() will return NULL until all entities have been initialized. See GM:InitPostEntity.
-- @return --- The player object representing the client.
global function LocalPlayer(): GPlayer
end

--- Translates a vector and angle from a local coordinate system into a global coordinate system.
--- For the reverse of this function see Global.WorldToLocal.
--- For working with an entity's local space vectors/angles you might consider using Entity:LocalToWorld/Entity:LocalToWorldAngles instead.
-- @param localPos --- A vector from a local coordinate system.
-- @param localAng --- An angle from a local coordinate system.
--- Pass a zero angle if you don't need to translate an angle.
-- @param originPos --- The origin of a global coordinate system, in worldspace coordinates.
-- @param originAngle --- The angles of a global coordinate system, as a worldspace angle.
-- @return --- The corresponding worldspace vector to `localPos`.
-- @return --- The corresponding worldspace angle to `localAng`.
global function LocalToWorld(localPos: GVector, localAng: GAngle, originPos: GVector, originAngle: GAngle): GVector, GAngle
end

--- Returns the main view angles, as they were at the start of the latest main view render.
--- This is a good alternative to Global.EyeAngles which is affected by other rendering operations, including render.RenderView.
-- @return --- The angles of the main view.
global function MainEyeAngles(): GAngle
end

--- Returns the origin of the main view, as it was at the start of the latest main view render.
--- This is a good alternative to Global.EyePos which is affected by other rendering operations, including render.RenderView.
-- @return --- Main camera position.
global function MainEyePos(): GVector
end

--- **INTERNAL**:
--- This function makes a balloon appear, similar to the one from the Toolgun.
--- **WARNING**: This function doesn't make the rope attached to the balloon appear.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/gamemodes/sandbox/entities/weapons/gmod_tool/stools/balloon.lua#L135)
-- @param ply --- The player who spawns the balloon. This argument can be nil
-- @param r --- Balloon color (red)
-- @param g --- Balloon color (green)
-- @param b --- Balloon color (blue).
-- @param force --- The lift force applied to the balloon.
-- @param data --- Data applied to the balloon. This data is required for correctly spawning the balloon.
--- For more information, please see: Structures/BalloonData
-- @return balloon --- Returns the created balloon entity.
global function MakeBalloon(ply: player, r: number, g: number, b: number, force: number, data: S_BalloonData): GEntity
end

--- Either returns the material with the given name, or loads the material interpreting the first argument as the path.
--- ## .png, .jpg and other image formats
--- This function is capable to loading `.png` or `.jpg` images, generating a texture and material for them on the fly.
--- PNG, JPEG, GIF, and TGA files will work, but only if they have the `.png` or `.jpg` file extensions (even if the actual image format doesn't match the file extension)
--- Use Global.AddonMaterial for image files with the `.cache` file extension. (from steamworks.Download)
--- While images are no longer scaled to Power of 2 (sizes of 8, 16, 32, 64, 128, etc.) sizes since February 2019, it is still a good practice for things like icons, etc.
--- **WARNING**: Server-side, this function can consistently return an invalid material (with '__error') depending on the file type loaded.
--- **WARNING**: This function is very expensive when used in rendering hooks or in operations requiring very frequent calls. It is a good idea to cache the material in a variable (like in the examples).
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L34-L49)
-- @param materialName --- The material name or path relative to the `materials/` folder.
--- Paths outside the `materials/` folder like `data/MyImage.jpg` or `maps/thumb/gm_construct.png` will also work for when generating materials.
--- To retrieve a Lua material created with Global.CreateMaterial, just prepend a `!` to the material name.
-- @param pngParameters --- A string containing space separated keywords which will be used to add material parameters.
--- See Material Parameters for more information.
--- **NOTE**: This feature only works when importing `.png` or `.jpg` image files.
-- @return --- Generated material.
-- @return --- How long it took for the function to run.
global function Material(materialName: string, pngParameters?: string): GIMaterial, number
end

--- Returns a VMatrix object, a 4x4 matrix.
-- @param data --- Initial data to initialize the matrix with. Leave empty to initialize an identity matrix. See examples for usage.
--- Can be a VMatrix to copy its data.
-- @return --- New matrix.
global function Matrix(data: table): GVMatrix
end

--- Returns a new static mesh object.
-- @param mat --- The material the mesh is intended to be rendered with. It's merely a hint that tells that mesh what vertex format it should use.
-- @return --- The created object.
global function Mesh(mat: GIMaterial): GIMesh
end

--- Runs util.PrecacheModel and returns the string.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L166-L172)
-- @param model --- The model to precache.
-- @return --- The same string entered as an argument.
global function Model(model: string): string
end

--- Creates a table with the specified module name and sets the function environment for said table.
--- Any passed loaders are called with the table as an argument. An example of this is package.seeall.
-- @param name --- The name of the module. This will be used to access the module table in the runtime environment.
-- @param loaders --- Calls each function passed with the new table as an argument.
global function module(name: string, ...: any)
end

--- Writes every given argument to the console. Limitations of Global.print apply.
--- Automatically attempts to convert each argument to a string. (See Global.tostring)
--- Unlike Global.print, arguments are not separated by anything. They are simply concatenated.
--- Additionally, a newline isn't added automatically to the end, so subsequent Msg or print operations will continue the same line of text in the console. See Global.MsgN for a version that does add a newline.
--- The text is blue on the server, orange on the client, and green on the menu:
-- @param args --- List of values to print.
global function Msg(...: any)
end

--- Works exactly like Global.Msg except that, if called on the server, will print to all players consoles plus the server console. Limitations of Global.print apply.
-- @param args --- List of values to print.
global function MsgAll(...: any)
end

--- Just like Global.Msg, except it can also print colored text, just like chat.AddText.
-- @param args --- Values to print. If you put in a color, all text after that color will be printed in that color.
global function MsgC(...: any)
end

--- Same as Global.print, except it concatinates the arguments without inserting any whitespace in between them.
--- See also Global.Msg, which doesn't add a newline (`"\n"`) at the end.
-- @param args --- List of values to print. They can be of any type and will be converted to strings with Global.tostring.
global function MsgN(...: any)
end

--- Returns named color defined in `resource/ClientScheme.res`.
-- @param name --- Name of color
-- @return --- A Color or nil
global function NamedColor(name: string): table
end

--- **BUG**: [Fails under certain conditions when called in coroutines](https://github.com/Facepunch/garrysmod-issues/issues/5299
--- Creates a new userdata object.
-- @param addMetatable --- If true, the created userdata will be given its own metatable.
-- @return --- The newly created userdata.
global function newproxy(addMetatable: boolean): userdata
end

--- Returns the amount of skins the specified model has.
--- See also Entity:SkinCount if you have an entity.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/model_database.lua#L80-L93)
-- @param modelName --- Model to return amount of skins of
-- @return --- Amount of skins
global function NumModelSkins(modelName: string): number
end

--- **INTERNAL**:
---  Called by the engine when a model has been loaded. Caches model information with the sql.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/model_database.lua#L23-L78)
-- @param modelName --- Name of the model.
-- @param numPostParams --- Number of pose parameters the model has.
-- @param numSeq --- Number of sequences the model has.
-- @param numAttachments --- Number of attachments the model has.
-- @param numBoneControllers --- Number of bone controllers the model has.
-- @param numSkins --- Number of skins that the model has.
-- @param size --- Size of the model.
global function OnModelLoaded(modelName: string, numPostParams: number, numSeq: number, numAttachments: number, numBoneControllers: number, numSkins: number, size: number)
end

--- Modifies the given vectors so that all of vector2's axis are larger than vector1's by switching them around. Also known as ordering vectors.
--- **NOTE**: This function will irreversibly modify the given vectors
-- @param vector1 --- Bounding box min resultant
-- @param vector2 --- Bounding box max resultant
global function OrderVectors(vector1: GVector, vector2: GVector)
end

--- Calls game.AddParticles and returns given string.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L174-L182)
-- @param file --- The particle file.
-- @return --- The particle file.
global function Particle(file: string): string
end

--- Creates a particle effect. See also Global.CreateParticleSystem.
--- **NOTE**: The particle effect must be precached **serverside** with Global.PrecacheParticleSystem and the file its from must be added via game.AddParticles before it can be used!
-- @param particleName --- The name of the particle effect.
-- @param position --- The start position of Control Point 0 for the particle system.
-- @param angles --- The orientation of Control Point 0 for the particle system.
--- You must provide the entity argument for the angles to take effect.
-- @param parent --- If set, the particle will be parented to the entity.
global function ParticleEffect(particleName: string, position: GVector, angles: GAngle, parent: GEntity)
end

--- Creates a particle effect with specialized parameters. See also Entity:CreateParticleEffect and Global.CreateParticleSystem.
--- **NOTE**: The particle effect must be precached **serverside** with Global.PrecacheParticleSystem and the file its from must be added via game.AddParticles before it can be used!
-- @param particleName --- The name of the particle effect.
-- @param attachType --- Attachment type using Enums/PATTACH.
-- @param entity --- The entity to be used in the way specified by the attachType.
-- @param attachmentID --- The id of the attachment to be used in the way specified by the attachType.
global function ParticleEffectAttach(particleName: string, attachType: number, entity: GEntity, attachmentID: number)
end

--- Creates a new CLuaEmitter.
--- **NOTE**: Do not forget to delete the emitter with CLuaEmitter:Finish once you are done with it
--- **WARNING**: There is a limit of 4097 emitters that can be active at once, exceeding this limit will throw a non-halting error in console!
-- @param position --- The start position of the emitter.
--- This is only used to determine particle drawing order for translucent particles.
-- @param use3D --- Whenever to render the particles in 2D or 3D mode. Supplying "true" will enable 3D (non-billboarded), otherwise it will default to 2D.
-- @return --- The new particle emitter.
global function ParticleEmitter(position: GVector, use3D: boolean): GCLuaEmitter
end

--- Creates a path for the bot to follow using one of two types (`Follow` or `Chase`)
--- `Follow` is a general purpose path. Best used for static or infrequently updated locations. The path will only be updated once PathFollower:Update is called. This needs to be done manually (typically inside the bots `BehaveThread` coroutine.
--- `Chase` is a specifically optimized for chasing a moving entity. Paths of this type will use PathFollower:Chase
-- @param type --- The type of the path to create, must be `"Follow"` or `"Chase"`
-- @return --- The path
global function Path(type: string): GPathFollower
end

--- Returns the player with the matching Player:UserID.
--- For a function that returns a player based on their Entity:EntIndex, see Global.Entity.
--- For a function that returns a player based on their connection ID, see player.GetByID.
-- @param playerIndex --- The player index.
-- @return --- The retrieved player.
global function Player(playerIndex: number): GPlayer
end

--- Moves the given model to the given position and calculates appropriate camera parameters for rendering the model to an icon.
--- The output table interacts nicely with Panel:RebuildSpawnIconEx with a few key renames.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/client.lua#L208-L249)
-- @param model --- Model that is being rendered to the spawn icon
-- @param position --- Position that the model is being rendered at
-- @param noAngles --- If true the function won't reset the angles to 0 for the model.
-- @return --- Table of information of the view which can be used for rendering
global function PositionSpawnIcon(model: GEntity, position: GVector, noAngles: boolean): table
end

--- Precaches a particle system with the specified name. The particle system must come from a file that is loaded with game.AddParticles beforehand.
--- When used on the server, it automatically precaches the particle on client.
--- **WARNING**: There is a limit of 4096 precached particles on the server. So only precache particles that are actually going to be used.
-- @param particleSystemName --- The name of the particle system.
global function PrecacheParticleSystem(particleSystemName: string)
end

--- Precaches a scene file.
-- @param scene --- Path to the scene file to precache.
global function PrecacheScene(scene: string)
end

--- Load and precache a custom sentence file.
-- @param filename --- The path to the custom sentences.txt.
global function PrecacheSentenceFile(filename: string)
end

--- Precache a sentence group in a sentences.txt definition file.
-- @param group --- The group to precache.
global function PrecacheSentenceGroup(group: string)
end

--- Displays a message in the chat, console, or center of screen of every player.
--- This uses the archaic user message system (umsg) and hence is limited to 255 characters.
-- @param type --- Which type of message should be sent to the players (see Enums/HUD)
-- @param message --- Message to be sent to the players
global function PrintMessage(type: number, message: string)
end

--- Recursively prints the contents of a table to the console.
--- The table keys will be sorted alphabetically or numerically when printed to the console.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L90-L128)
-- @param tableToPrint --- The table to be printed
-- @param indent --- Number of tabs to start indenting at. Increases by 2 when entering another table.
-- @param done --- Internal argument, you shouldn't normally change this. Used to check if a nested table has already been printed so it doesn't get caught in a loop.
global function PrintTable(tableToPrint: table, indent?: number, done?: table)
end

--- Creates a new ProjectedTexture.
-- @return --- Newly created projected texture.
global function ProjectedTexture(): GProjectedTexture
end

--- Runs a function without stopping the whole script on error.
--- This function is similar to Global.pcall and Global.xpcall except the errors are still printed and sent to the error handler (i.e. sent to server console if clientside and GM:OnLuaError called).
-- @param func --- Function to run
-- @param arguments --- Arguments to call the function with.
-- @return --- Whether the function executed successfully or not
global function ProtectedCall(func: function, ...: any): boolean
end

--- Returns an iterator function that can be used to loop through a table in random order
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/extensions/table.lua#L614-L634)
-- @param table --- Table to create iterator for
-- @param descending --- Whether the iterator should iterate descending or not
-- @return --- Iterator function
global function RandomPairs(table: table, descending: boolean): function
end

--- Returns the real frame-time which is unaffected by host_timescale. To be used for GUI effects (for example)
--- **NOTE**: The returned number is clamped between `0` and `0.1`.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/client.lua#L10-L19)
-- @return --- Real frame time
global function RealFrameTime(): number
end

--- Returns the uptime of the game/server in seconds (to at least **4** decimal places). This value updates itself once every time the realm thinks. For servers, this is the server tickrate. For clients, its their current FPS.
--- **NOTE**: This is **not** synchronised or affected by the game.
--- This will be affected by precision loss if the uptime is more than 30+(?) days, and effectively cease to be functional after 50+(?) days.
--- Changing the map will **not** fix it like it does with Global.CurTime. A server restart is necessary.
--- You should use this function (or Global.SysTime) for timing real-world events such as user interaction, but not for timing game events such as animations.
--- See also: Global.CurTime, Global.SysTime
-- @return --- Uptime of the game/server.
global function RealTime(): number
end

--- Creates a new CRecipientFilter.
-- @param unreliable --- If set to true, makes the filter unreliable.
--- This means, when sending over the network in cases like Global.CreateSound (and its subsequent updates), the message is not guaranteed to reach all clients.
-- @return --- The new created recipient filter.
global function RecipientFilter(unreliable: boolean): GCRecipientFilter
end

--- Registers a Derma element to be closed the next time Global.CloseDermaMenus is called
-- @param menu --- Menu to be registered for closure
global function RegisterDermaMenuForClose(menu: GPanel)
end

--- Registers a given table as a metatable. It can then be accessed by other code/addons via Global.FindMetaTable.
-- @param metaName --- The new metatable name. Cannot override existing types.
-- @param metaTable --- The new metatable table. It will be given a `MetaID` and `MetaName` fields.
global function RegisterMetaTable(metaName: string, metaTable: table)
end

--- Saves position of your cursor on screen. You can restore it by using Global.RestoreCursorPosition. This is used internally by the spawn menu/context menu
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util.lua#L454-L474)
global function RememberCursorPosition()
end

--- Does the removing of the tooltip panel. Called by Global.EndTooltip.
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/includes/util/tooltips.lua#L5-L18)
global function RemoveTooltip()
end

--- Returns the angle that the clients view is being rendered at. Returns `angles` from the return value of render.GetViewSetup.
--- See also Global.EyeAngles.
-- @return --- Render Angles
global function RenderAngles(): GAngle
end

--- Renders a Depth of Field effect
-- [View source](https://github.com/Facepunch/garrysmod/blob/master/garrysmod/lua/postprocess/super_dof.lua#L174-L279)
